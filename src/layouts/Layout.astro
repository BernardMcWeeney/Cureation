---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Nav from '../components/nav/Nav.astro';
import MobileMenu from '../components/nav/MobileMenu.astro';
import SearchOverlay from '../components/nav/SearchOverlay.astro';
import Footer from '../components/nav/Footer.astro';
import TweaksPanel from '../components/nav/TweaksPanel.astro';
import Fog from '../components/atmosphere/Fog.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  theme?: 'dark' | 'midnight' | 'papers';
}

const {
  title = 'Cureation — an archive of The Cure',
  description = 'An editorial archive documenting The Cure: albums, live shows, lyrics, members, photos, news.',
  ogImage = '/hero-image1.jpg',
  theme = 'midnight',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
---
<!doctype html>
<html lang="en" data-theme={theme}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" type="application/rss+xml" title="Cureation — all dispatches & shows" href="/rss.xml" />
  <link rel="alternate" type="application/rss+xml" title="Cureation — dispatches only" href="/news/rss.xml" />
  <link rel="alternate" type="text/calendar" title="The Cure — tour dates" href="/calendar.ics" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />

  <ClientRouter />

  <script is:inline>
    // Restore stored tweaks before paint to avoid flash.
    (function () {
      var html = document.documentElement;
      var ACC = { plum: '#7746B0', wine: '#B8354A', oxblood: '#8C2638', navy: '#3A4A6B', gold: '#A88344', rust: '#A6462A' };
      var defaults = { theme: 'midnight', accent: 'plum', display: 'cormorant', atmos: 'soft', grain: false, density: 'balanced', headline: 'italic' };
      var t = defaults;
      try {
        var raw = localStorage.getItem('cureation:tweaks');
        if (raw) t = Object.assign({}, defaults, JSON.parse(raw));
        else {
          var legacy = localStorage.getItem('cureation:theme');
          if (legacy === 'dark' || legacy === 'midnight' || legacy === 'papers') t.theme = legacy;
        }
      } catch (e) {}
      html.setAttribute('data-theme', t.theme);
      html.setAttribute('data-display', t.display);
      html.setAttribute('data-atmos', t.atmos);
      html.setAttribute('data-grain', t.grain ? 'on' : 'off');
      html.setAttribute('data-density', t.density);
      html.setAttribute('data-headline', t.headline);
      var c = ACC[t.accent] || ACC.plum;
      html.style.setProperty('--accent', c);
      html.style.setProperty('--accent-tint', c + '1A');
      html.style.setProperty('--accent-tint-2', c + '33');
    })();
  </script>
</head>
<body>
  <Fog />
  <a class="sr-only" href="#main">Skip to content</a>

  <Nav />
  <MobileMenu />
  <SearchOverlay />

  <main id="main" style="position:relative; z-index:1;">
    <slot />
  </main>

  <Footer />
  <TweaksPanel />
</body>
</html>
