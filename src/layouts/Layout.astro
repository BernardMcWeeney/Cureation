---
import { ViewTransitions } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import siteConfig from '../config/site.config';
import '../styles/global.css';
import SearchEnhancer from '../components/SearchEnhancer.astro';

import { getDefaultTheme } from '../config/theme.config';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  pageClass?: string;
  theme?: string;
}

const {
  title,
  description,
  ogImage,
  pageClass = '',
  theme = getDefaultTheme()
} = Astro.props;

// Generate full URLs for social sharing
const siteUrl = import.meta.env.SITE || siteConfig.url;
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const socialImageURL = new URL(ogImage || siteConfig.meta.ogImage, siteUrl);
---

<!DOCTYPE html>
<html lang="en" style="color-scheme: dark;" data-theme={theme}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="canonical" href={canonicalURL} />
  <meta name="generator" content={Astro.generator} />

  <!-- Primary Meta Tags -->
  <title>
    {title
      ? `${title} | ${siteConfig.name}`
      : `${siteConfig.name} - ${siteConfig.description}`}
  </title>
  <meta
    name="title"
    content={
      title
        ? `${title} | ${siteConfig.name}`
        : `${siteConfig.name} - ${siteConfig.description}`
    }
  />
  <meta name="description" content={description || siteConfig.description} />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta
    property="og:title"
    content={
      title
        ? `${title} | ${siteConfig.name}`
        : `${siteConfig.name} - ${siteConfig.description}`
    }
  />
  <meta property="og:description" content={description || siteConfig.description} />
  <meta property="og:image" content={socialImageURL} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content={siteConfig.meta.twitterHandle} />
  <meta
    name="twitter:title"
    content={
      title
        ? `${title} | ${siteConfig.name}`
        : `${siteConfig.name} - ${siteConfig.description}`
    }
  />
  <meta name="twitter:description" content={description || siteConfig.description} />
  <meta name="twitter:image" content={socialImageURL} />

  <!-- Preconnect & Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- View transitions -->
  <ViewTransitions />

  <!-- Browser theme color -->
  <meta name="theme-color" content="#000000" />

  <!-- Additional head -->
  <slot name="head" />
</head>
<body class="min-h-screen flex flex-col noise-overlay">
  <!-- Enhanced theme-aware background -->
  <div class="fixed inset-0 -z-50 theme-gradient-bg">
    <div class="absolute inset-0" style="background: radial-gradient(ellipse at top left, rgba(var(--color-primary-rgb), 0.12) 0%, transparent 50%);"></div>
    <div class="absolute inset-0" style="background: radial-gradient(ellipse at bottom right, rgba(var(--color-primary-rgb), 0.08) 0%, transparent 50%);"></div>
    <div class="absolute inset-0" style="background: radial-gradient(circle at 30% 70%, rgba(var(--color-primary-rgb), 0.05) 0%, transparent 40%);"></div>
  </div>

  <Header />

  <main class="grow">
    <slot />
  </main>

  <Footer />

  <slot name="after-footer" />
  <!-- Include our search enhancer component -->
  <SearchEnhancer />

  <script>
    function setupSmoothScroll() {
      document.addEventListener('click', (e) => {
        const target = e.target.closest('a');
        if (target && target.getAttribute('href')?.startsWith('#')) {
          e.preventDefault();
          const id = target.getAttribute('href').slice(1);
          document.getElementById(id)?.scrollIntoView({ behavior: 'smooth' });
        }
      });
    }
    setupSmoothScroll();
    document.addEventListener('astro:page-load', setupSmoothScroll);
  </script>
</body>
</html>
