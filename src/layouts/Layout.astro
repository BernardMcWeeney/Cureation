---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Nav from '../components/nav/Nav.astro';
import MobileMenu from '../components/nav/MobileMenu.astro';
import SearchOverlay from '../components/nav/SearchOverlay.astro';
import Footer from '../components/nav/Footer.astro';
import Fog from '../components/atmosphere/Fog.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  theme?: 'dark' | 'midnight' | 'papers';
}

const {
  title = 'Cureation — an archive of The Cure',
  description = 'An editorial archive documenting The Cure: albums, live shows, lyrics, members, photos, news.',
  ogImage = '/hero-image1.jpg',
  theme = 'midnight',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
---
<!doctype html>
<html lang="en" data-theme={theme}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" type="application/rss+xml" title="Cureation — all dispatches & shows" href="/rss.xml" />
  <link rel="alternate" type="application/rss+xml" title="Cureation — dispatches only" href="/news/rss.xml" />
  <link rel="alternate" type="text/calendar" title="The Cure — tour dates" href="/calendar.ics" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />

  <ClientRouter />

  <script is:inline>
    // Restore stored theme before paint to avoid flash.
    (function () {
      try {
        var t = localStorage.getItem('cureation:theme');
        if (t === 'midnight' || t === 'papers' || t === 'dark') {
          document.documentElement.setAttribute('data-theme', t);
        }
      } catch (e) {}
    })();
  </script>
</head>
<body>
  <Fog />
  <a class="sr-only" href="#main">Skip to content</a>

  <Nav />
  <MobileMenu />
  <SearchOverlay />

  <main id="main" style="position:relative; z-index:1;">
    <slot />
  </main>

  <Footer />

  <script>
    function wireTheme() {
      const btns = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
      if (!btns.length) return;
      const order: Array<'dark' | 'midnight' | 'papers'> = ['dark', 'midnight', 'papers'];
      btns.forEach((btn) => {
        if ((btn as any).__wired) return;
        (btn as any).__wired = true;
        btn.addEventListener('click', () => {
          const current = (document.documentElement.getAttribute('data-theme') as any) || 'dark';
          const next = order[(order.indexOf(current) + 1) % order.length];
          document.documentElement.setAttribute('data-theme', next);
          try { localStorage.setItem('cureation:theme', next); } catch (e) {}
        });
      });
    }
    wireTheme();
    document.addEventListener('astro:page-load', wireTheme);
  </script>
</body>
</html>
