---
import { editable, copyText, copyAttr } from '../lib/visual-editing';
import { pageSeo, jsonLd, SITE_URL } from '../lib/seo';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Nav from '../components/nav/Nav.astro';
import MobileMenu from '../components/nav/MobileMenu.astro';
import SearchOverlay from '../components/nav/SearchOverlay.astro';
import Footer from '../components/nav/Footer.astro';

interface Props {
  editRecord?: unknown;
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  theme?: 'dark' | 'papers';
}

const {
  editRecord,
  title = 'Cureation | An archive of The Cure',
  description,
  ogImage = '/og-editorial-v2.png',
  ogType = 'website',
  theme = 'dark',
} = Astro.props;

const seo = pageSeo(Astro.url.pathname, editRecord, description);
const canonical = seo.canonical;
const ogImageUrl = new URL(ogImage, Astro.site ?? Astro.url).toString();
---
<!doctype html>
<html lang="en" data-theme={theme} data-colour-theme="bloodflowers">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <link rel="icon" type="image/png" href="/favicon-64.png" />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" type="application/rss+xml" title="Cureation | News and shows" href="/rss.xml" />
  <link rel="alternate" type="application/rss+xml" title="Cureation | Articles" href="/publication/rss.xml" />
  <link rel="alternate" type="text/calendar" title="The Cure | Tour dates" href="/calendar.ics" />

  <title>{title}</title>
  <meta name="description" content={seo.description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={seo.description} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Cureation" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={seo.description} />
  <meta name="twitter:image" content={ogImageUrl} />
  {(Astro.url.searchParams.get("visual-editing") === "true" || Astro.url.pathname === "/my-archive") && <meta name="robots" content="noindex, follow" />}
  {seo.entity && <script type="application/ld+json" set:html={jsonLd(seo.entity)} />}
  {Astro.url.pathname === "/" && <script type="application/ld+json" set:html={jsonLd({ "@context": "https://schema.org", "@graph": [{ "@type": "WebSite", "@id": `${SITE_URL}/#website`, url: SITE_URL, name: "Cureation", publisher: { "@id": `${SITE_URL}/#organization` } }, { "@type": "Organization", "@id": `${SITE_URL}/#organization`, name: "Cureation", url: SITE_URL, description: "Independent, non-commercial fan archive dedicated to The Cure" }] })} />}
  <meta property="og:type" content={ogType} />
  <meta name="twitter:card" content="summary_large_image" />

  <ClientRouter />
  <script>
    import '../lib/visual-editing-client';
    import '../lib/archive-links';
    import '../lib/navigation';
  </script>
  <script is:inline>
    (function () {
      try {
        var saved = localStorage.getItem('cureation:theme');
        if (saved === 'dark' || saved === 'papers') document.documentElement.setAttribute('data-theme', saved);
        var colourTheme = localStorage.getItem('cureation:colour-theme');
        var colourThemes = ['wish', 'disintegration', 'pornography', 'faith', 'head-on-the-door', 'bloodflowers'];
        if (colourThemes.indexOf(colourTheme) !== -1) document.documentElement.setAttribute('data-colour-theme', colourTheme);
      } catch (error) {}
    })();
  </script>
</head>
<body>
  {editable(editRecord) && <button class="visual-edit-record" data-directus={editable(editRecord)} type="button">Edit this record</button>}
  <style>
    .visual-edit-record { position: fixed; right: 16px; bottom: 16px; z-index: 10000; padding: 10px 16px; border: 1px solid currentColor; border-radius: 4px; background: var(--bg); color: var(--ink); font: var(--text-label) sans-serif; }
  </style>
  <a data-directus={copyAttr("layouts_Layout_c9ba8eb6d6bd")} set:html={copyText("layouts_Layout_c9ba8eb6d6bd", "Skip to content")} class="sr-only skip-link" href="#main"></a>

  <Nav />
  <MobileMenu />
  <SearchOverlay />

  <main id="main" tabindex="-1" style="position:relative; z-index:1;">
    <slot />
  </main>

  <Footer />

  <script>
    type CureationTheme = 'dark' | 'papers';
    type CureationColourTheme = 'wish' | 'disintegration' | 'pornography' | 'faith' | 'head-on-the-door' | 'bloodflowers';
    const themeKey = 'cureation:theme';
    const colourThemeKey = 'cureation:colour-theme';
    const colourThemeLabels: Record<CureationColourTheme, string> = {
      wish: 'Wish',
      disintegration: 'Disintegration',
      pornography: 'Pornography',
      faith: 'Faith',
      'head-on-the-door': 'The Head on the Door',
      bloodflowers: 'Bloodflowers',
    };

    function savedTheme(): CureationTheme {
      try {
        return localStorage.getItem(themeKey) === 'papers' ? 'papers' : 'dark';
      } catch (error) {
        return 'dark';
      }
    }

    function paintTheme(theme: CureationTheme) {
      document.documentElement.setAttribute('data-theme', theme);
      document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
        const nextLabel = theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode';
        button.setAttribute('aria-label', nextLabel);
        button.setAttribute('title', nextLabel);
        button.setAttribute('aria-pressed', String(theme === 'papers'));
      });
      document.dispatchEvent(new CustomEvent('cureation:theme-change', { detail: { theme } }));
    }

    function savedColourTheme(): CureationColourTheme {
      try {
        const saved = localStorage.getItem(colourThemeKey) as CureationColourTheme | null;
        return saved && saved in colourThemeLabels ? saved : 'bloodflowers';
      } catch (error) {
        return 'bloodflowers';
      }
    }

    function paintColourTheme(colourTheme: CureationColourTheme) {
      document.documentElement.setAttribute('data-colour-theme', colourTheme);
      document.querySelectorAll<HTMLButtonElement>('button[data-colour-theme]').forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.colourTheme === colourTheme));
      });
      document.querySelectorAll<HTMLElement>('[data-colour-theme-current]').forEach((label) => {
        label.textContent = colourThemeLabels[colourTheme];
      });
      document.dispatchEvent(new CustomEvent('cureation:colour-theme-change', { detail: { colourTheme } }));
    }

    function wireThemeSwitcher() {
      paintTheme(savedTheme());
      paintColourTheme(savedColourTheme());
      document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
        if (button.dataset.themeWired) return;
        button.dataset.themeWired = 'true';
        button.addEventListener('click', () => {
          const currentTheme = document.documentElement.getAttribute('data-theme') === 'papers' ? 'papers' : 'dark';
          const nextTheme: CureationTheme = currentTheme === 'dark' ? 'papers' : 'dark';
          try { localStorage.setItem(themeKey, nextTheme); } catch (error) {}
          paintTheme(nextTheme);
        });
      });
      document.querySelectorAll<HTMLButtonElement>('button[data-colour-theme]').forEach((button) => {
        if (button.dataset.colourThemeWired) return;
        button.dataset.colourThemeWired = 'true';
        button.addEventListener('click', () => {
          const colourTheme = button.dataset.colourTheme as CureationColourTheme | undefined;
          if (!colourTheme || !(colourTheme in colourThemeLabels)) return;
          try { localStorage.setItem(colourThemeKey, colourTheme); } catch (error) {}
          paintColourTheme(colourTheme);
          button.closest('details')?.removeAttribute('open');
        });
      });
    }

    function wireResponsiveTables() {
      document.querySelectorAll<HTMLTableElement>('table.data:not(.gear-ledger)').forEach((table) => {
        if (table.dataset.responsiveWired) return;
        table.dataset.responsiveWired = 'true';
        const labels = Array.from(table.querySelectorAll<HTMLTableCellElement>('thead th'))
          .map((heading) => heading.textContent?.trim() || '');

        table.querySelectorAll<HTMLTableRowElement>('tbody tr').forEach((row) => {
          Array.from(row.cells).forEach((cell, index) => {
            const label = labels[index];
            if (label && !cell.hasAttribute('data-label')) cell.setAttribute('data-label', label);
          });
        });
      });
    }

    wireThemeSwitcher();
    wireResponsiveTables();
    document.addEventListener('astro:page-load', wireThemeSwitcher);
    document.addEventListener('astro:page-load', wireResponsiveTables);
  </script>
</body>
</html>
