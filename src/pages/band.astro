---
import Layout from '../layouts/Layout.astro';
import IssueSection from '../components/ui/IssueSection.astro';
import Crumbs from '../components/ui/Crumbs.astro';
import { listMembers, listTimeline } from '../lib/directus';
import { asset } from '../lib/assets';

const [members, timeline] = await Promise.all([listMembers(), listTimeline({ limit: 40 })]);
const current = members.filter((m) => m.is_current_member);
const former = members.filter((m) => !m.is_current_member);

const facts: Array<[string, string]> = [
  ['Total members', String(members.length)],
  ['Current lineup', String(current.length)],
  ['Former members', String(former.length)],
  ['Founded', '1978'],
];
---
<Layout title="The band · Cureation">
  <div class="container" style="padding-top: clamp(24px, 3vw, 40px);">
    <Crumbs items={[{ label: 'Home', href: '/' }, { label: 'The band' }]} />
    <div class="stack" style="--gap: 1rem; margin-top: 1rem;">
      <div class="mono-sm muted">SECTION · THE BAND</div>
      <h1 class="serif" style="font-size: clamp(48px, 7.5vw, 96px); line-height:.95; font-style: italic; margin: 0;">The band</h1>
      <p class="deck" style="max-width: 62ch;">Members past and present — their instruments, their tenures, and the shape of the lineup across forty-plus years.</p>
      <div class="facts">
        {facts.map(([k, v]) => (
          <div class="facts__item">
            <div class="facts__k">{k}</div>
            <div class="facts__v">{v}</div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <IssueSection kicker="Current lineup" title="On stage now" meta={`${current.length} members`}>
    <div class="member-grid">
      {current.map((m) => (
        <a href={`/band/members/${m.slug}`} class="member-card">
          <figure class="member-card__art">
            {m.photo_file ? (
              <img src={asset(m.photo_file, 'card')} alt={m.name} loading="lazy" />
            ) : (
              <div class="placeholder">No photo</div>
            )}
          </figure>
          <div class="mono-sm muted" style="margin-top:.5rem;">{m.tenure || '—'}</div>
          <h3 class="serif" style="font-size: 22px; font-style: italic; margin: .2rem 0 0;">{m.name}</h3>
          <div class="mono-sm" style="color: var(--accent-3);">{Array.isArray(m.instruments) ? m.instruments.slice(0, 3).join(' · ').toUpperCase() : ''}</div>
        </a>
      ))}
    </div>
  </IssueSection>

  {former.length > 0 && (
    <IssueSection kicker="Former members" title="Alumni" meta={`${former.length} past`}>
      <div class="table-wrap">
      <table class="data">
        <thead><tr><th style="width:50px;">№</th><th>Name</th><th>Instruments</th><th>Tenure</th></tr></thead>
        <tbody>
          {former.map((m, i) => (
            <tr data-clickable onclick={`location.href='/band/members/${m.slug}'`}>
              <td class="idx">{String(i + 1).padStart(2, '0')}</td>
              <td><span class="serif" style="font-size: 18px; font-style: italic;">{m.name}</span></td>
              <td class="mono-sm muted">{Array.isArray(m.instruments) ? m.instruments.join(' · ') : ''}</td>
              <td class="mono-sm" style="color: var(--accent-3);">{m.tenure || `${m.tenure_start || ''}–${m.tenure_end || ''}`}</td>
            </tr>
          ))}
        </tbody>
      </table>
      </div>
    </IssueSection>
  )}

  {timeline.length > 0 && (
    <IssueSection kicker="Recent history" title="Timeline" href="/band/history" meta={`${timeline.length} entries`}>
      <div class="table-wrap">
      <table class="data">
        <thead><tr><th style="width:80px;">Date</th><th style="width:110px;">Kind</th><th>Event</th></tr></thead>
        <tbody>
          {timeline.slice(-15).reverse().map((t) => (
            <tr>
              <td class="mono-sm" style="color: var(--ink);">{t.formatted_date || t.date || t.year || '—'}</td>
              <td class="mono-sm muted">{(t.type || '').toUpperCase()}</td>
              <td>
                <span class="serif" style="font-size: 17px; font-style: italic;">{t.title}</span>
                {t.description && <div class="muted" style="font-family: var(--f-serif); font-size: 14px; margin-top: .2rem;">{t.description}</div>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      </div>
    </IssueSection>
  )}
</Layout>

<style>
  .member-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: clamp(20px, 2.4vw, 36px); }
  .member-card { display: flex; flex-direction: column; border: none; }
  .member-card__art { aspect-ratio: 1 / 1; margin: 0; overflow: hidden; background: var(--bg-2); border: 1px solid var(--rule); }
  .member-card__art img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.9) contrast(1.05); transition: transform .6s ease, filter .3s; }
  .member-card:hover .member-card__art img { transform: scale(1.03); filter: saturate(1) contrast(1.1); }
</style>