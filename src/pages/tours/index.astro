---
import MainLayout from '../../layouts/MainLayout.astro';
import PageFilter from '../../components/PageFilter.astro';
import { getTours } from '../../lib/directus';

const tours = await getTours();

// Group tours by decade
const toursByDecade = tours.reduce((acc, tour) => {
  if (!tour.startDate) return acc;
  const decade = Math.floor(new Date(tour.startDate).getFullYear() / 10) * 10;
  const key = `${decade}s`;
  if (!acc[key]) acc[key] = [];
  acc[key].push(tour);
  return acc;
}, {} as Record<string, typeof tours>);

// Sort decades descending
const decades = Object.keys(toursByDecade).sort((a, b) => parseInt(b) - parseInt(a));

// Stats
const totalTours = tours.length;
const totalShows = tours.reduce((sum, t) => sum + t.totalShows, 0);
const firstYear = tours.length > 0 ? Math.min(...tours.filter(t => t.year > 0).map(t => t.year)) : 1979;
const latestYear = tours.length > 0 ? Math.max(...tours.filter(t => t.year > 0).map(t => t.year)) : new Date().getFullYear();

function formatTourDates(start?: string, end?: string): string {
  if (!start) return '';
  const s = new Date(start);
  const startStr = s.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
  if (!end) return startStr;
  const e = new Date(end);
  const endStr = e.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
  return `${startStr} \u2013 ${endStr}`;
}
---

<MainLayout
  title="Tours"
  description="Every tour by The Cure from 1979 to the present day. Browse tour dates, setlists, and statistics."
  showSidebar={false}
  pageClass="bg-black"
>
  <!-- Hero -->
  <section class="mb-10">
    <div class="glass-panel overflow-hidden relative">
      <div class="absolute -top-20 -left-20 w-64 h-64 rounded-full bg-white/[0.06] blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-10 -right-10 w-48 h-48 rounded-full bg-accent/[0.06] blur-2xl pointer-events-none"></div>

      <div class="relative p-8 md:p-12">
        <h1 class="font-display text-5xl md:text-6xl lg:text-7xl text-white mb-4 text-glow">
          Tours
        </h1>
        <p class="text-white/75 text-lg md:text-xl max-w-3xl leading-relaxed">
          From intimate club shows to stadium spectacles, every tour The Cure has undertaken across nearly five decades.
        </p>

        <div class="flex flex-wrap gap-8 mt-8 pt-6 border-t border-white/[0.08]">
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-white text-glow">{totalTours}</span>
            <span class="text-white/85 text-base font-medium">Tours</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-white text-glow">{totalShows.toLocaleString()}</span>
            <span class="text-white/85 text-base font-medium">Shows</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-white text-glow">{firstYear}&ndash;{latestYear}</span>
            <span class="text-white/85 text-base font-medium">Span</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Search -->
  <section class="mb-8">
    <PageFilter id="tours" placeholder="Search tours..." />
  </section>

  <!-- Tours by decade -->
  {decades.map(decade => {
    const decadeTours = toursByDecade[decade];
    return (
      <section class="mb-12">
        <div class="flex items-center gap-4 mb-6">
          <h2 class="font-heading text-2xl text-primary tracking-wider">{decade}</h2>
          <div class="flex-1 h-px bg-gradient-to-r from-white/15 to-transparent"></div>
          <span class="text-white/50 text-sm">{decadeTours.length} tours</span>
        </div>

        <div class="space-y-3">
          {decadeTours.map((tour, index) => (
            <a
              href={`/tours/${tour.slug}`}
              class="group block"
              style={`--index: ${index}`}
              data-filter-item
              data-filter-text={`${tour.name} ${tour.associatedAlbumTitle || ''} ${tour.year}`}
            >
              <div class="flex items-center gap-4 p-4 glass-card rounded-xl border border-white/10 hover:border-white/20 transition-all animate-fade-in">
                <!-- Album cover (if linked) -->
                {tour.associatedAlbumCover ? (
                  <img
                    src={tour.associatedAlbumCover}
                    alt={tour.associatedAlbumTitle || ''}
                    class="w-14 h-14 rounded-lg object-cover shrink-0 border border-white/10"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-14 h-14 rounded-lg bg-white/5 shrink-0 flex items-center justify-center border border-white/10">
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-6 text-white/20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <path d="M9 19V6l12-2v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z" />
                    </svg>
                  </div>
                )}

                <!-- Tour info -->
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-3 flex-wrap">
                    <h3 class="font-heading text-lg text-white group-hover:text-primary transition-colors truncate">
                      {tour.name}
                    </h3>
                    {tour.associatedAlbumTitle && (
                      <span class="px-2 py-0.5 rounded bg-white/5 border border-white/10 text-white/50 text-xs shrink-0">
                        {tour.associatedAlbumTitle}
                      </span>
                    )}
                  </div>
                  <div class="flex items-center gap-4 mt-1">
                    <span class="text-white/50 text-sm">{formatTourDates(tour.startDate, tour.endDate)}</span>
                  </div>
                </div>

                <!-- Stats -->
                <div class="flex items-center gap-6 shrink-0">
                  {tour.totalShows > 0 && (
                    <div class="text-center hidden sm:block">
                      <div class="text-white font-display text-lg">{tour.totalShows}</div>
                      <div class="text-white/40 text-xs">shows</div>
                    </div>
                  )}
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-primary opacity-60 group-hover:opacity-100 transition-opacity" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m9 18 6-6-6-6" />
                  </svg>
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>
    );
  })}

  {tours.length === 0 && (
    <div class="glass-card rounded-2xl p-12 text-center">
      <p class="text-white/60">Tour information coming soon.</p>
    </div>
  )}
</MainLayout>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fadeIn 0.4s ease forwards;
    animation-delay: calc(var(--index, 0) * 40ms);
    opacity: 0;
  }
</style>
