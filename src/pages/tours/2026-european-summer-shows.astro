---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import Crumbs from '../../components/ui/Crumbs.astro';
import Bookmark from '../../components/ui/Bookmark.astro';
import Button from '../../components/ui/Button.astro';
import { fetchRaw, getSetlistSongs, getTourBySlug, listAlbums, listSongs } from '../../lib/directus';
import { countryCentroid } from '../../lib/geo';

const TOUR_SLUG = '2026-european-summer-shows';

type TourShow = {
  id: number;
  slug: string;
  date: string | null;
  venue: string | null;
  city: string | null;
  state_province: string | null;
  country: string | null;
  country_code: string | null;
  tour_name: string | null;
  song_count: number | null;
  start_time?: string | null;
  end_time?: string | null;
  concert_duration_minutes?: number | null;
  notes?: string | null;
  facts?: string | null;
  credits?: string | null;
  performing_musicians?: unknown;
  support_acts?: unknown;
  soundcheck?: unknown;
  stage_banter?: unknown;
  photo_assets?: unknown;
  video_links?: unknown;
  audio_links?: unknown;
  recordings?: unknown;
  additional_links?: unknown;
  ticket_assets?: unknown;
  ticket_status?: string | null;
  sales_status?: string | null;
  show_type?: string | null;
  setlistfm_url?: string | null;
  cure_concerts_url?: string | null;
  [key: string]: unknown;
};

const tour = await getTourBySlug(TOUR_SLUG);
if (!tour) return new Response('Not found', { status: 404 });

const [rawShows, albums] = await Promise.all([
  fetchRaw<TourShow>('setlists', {
    limit: -1,
    fields: '*',
    'filter[tour][_eq]': tour.id,
    sort: 'date',
  }).catch(() => []),
  listAlbums({ type: 'studio' }).catch(() => []),
]);

const lostWorld = albums.find((album) => /songs of a lost world/i.test(album.title || '')) || null;
const lostWorldSongs = lostWorld ? await listSongs({ album: lostWorld.id }).catch(() => []) : [];
const shows = rawShows.slice().sort((a, b) => (a.date || '').localeCompare(b.date || ''));

const now = new Date();
const todayIso = now.toISOString().slice(0, 10);
const dateFmt = new Intl.DateTimeFormat('en-GB', { weekday: 'short', day: '2-digit', month: 'short' });
const longDateFmt = new Intl.DateTimeFormat('en-GB', { weekday: 'long', day: '2-digit', month: 'long', year: 'numeric' });

const cityKey = (city?: string | null, countryCode?: string | null) =>
  `${countryCode || ''}:${String(city || '')
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()}`;

const CITY_COORDS: Record<string, { lat: number; lon: number }> = {
  'ES:barcelona': { lat: 41.3851, lon: 2.1734 },
  'PT:maia': { lat: 41.2357, lon: -8.6199 },
  'AT:nickelsdorf': { lat: 47.9406, lon: 17.0697 },
  'IT:florence': { lat: 43.7696, lon: 11.2558 },
  'NL:landgraaf': { lat: 50.8876, lon: 6.0116 },
  'GB:newport': { lat: 50.7015, lon: -1.2912 },
  'GB:cardiff': { lat: 51.4816, lon: -3.1791 },
  'IE:dublin': { lat: 53.3498, lon: -6.2603 },
  'GB:belfast': { lat: 54.5973, lon: -5.9301 },
  'DK:roskilde': { lat: 55.6419, lon: 12.0878 },
  'PL:gdynia': { lat: 54.5189, lon: 18.5305 },
  'BE:werchter': { lat: 50.9692, lon: 4.7012 },
  'SK:trencin': { lat: 48.8945, lon: 18.0444 },
  'DE:berlin': { lat: 52.52, lon: 13.405 },
  'GR:athens': { lat: 37.9838, lon: 23.7275 },
  'RO:cluj': { lat: 46.7712, lon: 23.6236 },
  'BG:plovdiv': { lat: 42.1354, lon: 24.7453 },
  'CH:nyon': { lat: 46.3833, lon: 6.2396 },
  'FR:nimes': { lat: 43.8367, lon: 4.3601 },
  'LT:vilnius': { lat: 54.6872, lon: 25.2797 },
  'EE:tallinn': { lat: 59.437, lon: 24.7536 },
  'NO:oslo': { lat: 59.9139, lon: 10.7522 },
  'SE:gothenburg': { lat: 57.7089, lon: 11.9746 },
  'GB:manchester': { lat: 53.4808, lon: -2.2426 },
  'GB:ingliston': { lat: 55.94, lon: -3.364 },
  'FR:bordeaux': { lat: 44.8378, lon: -0.5792 },
  'FR:saint-cloud': { lat: 48.8459, lon: 2.219 },
};

const parseDate = (value?: string | null) => (value ? new Date(`${value}T00:00:00Z`) : null);
const formatDate = (value?: string | null) => {
  const parsed = parseDate(value);
  return parsed ? dateFmt.format(parsed) : 'Date TBC';
};
const formatLongDate = (value?: string | null) => {
  const parsed = parseDate(value);
  return parsed ? longDateFmt.format(parsed) : 'Date TBC';
};
const dayDiff = (a?: string | null, b?: string | null) => {
  const da = parseDate(a);
  const db = parseDate(b);
  if (!da || !db) return 0;
  return Math.round((db.getTime() - da.getTime()) / 86400000);
};
const isPast = (show: TourShow) => !!show.date && show.date < todayIso;
const normalizeList = (value: unknown): unknown[] => {
  if (Array.isArray(value)) return value;
  if (!value) return [];
  if (typeof value === 'string') {
    const trimmed = value.trim();
    if (!trimmed) return [];
    try {
      const parsed = JSON.parse(trimmed);
      return Array.isArray(parsed) ? parsed : [parsed];
    } catch {
      return trimmed.split(/\n|,/).map((item) => item.trim()).filter(Boolean);
    }
  }
  return [value];
};
const formatClock = (value?: string | null) => {
  if (!value) return null;
  const match = String(value).match(/^(\d{1,2}):(\d{2})/);
  if (!match) return String(value);
  return `${match[1].padStart(2, '0')}:${match[2]}`;
};
const timeToMinutes = (value?: string | null) => {
  const match = String(value || '').match(/^(\d{1,2}):(\d{2})/);
  if (!match) return null;
  const h = Number(match[1]);
  const m = Number(match[2]);
  if (!Number.isFinite(h) || !Number.isFinite(m)) return null;
  return h * 60 + m;
};
const formatRuntime = (minutes?: number | null) => {
  if (!minutes || !Number.isFinite(minutes) || minutes <= 0) return null;
  const h = Math.floor(minutes / 60);
  const m = Math.round(minutes % 60);
  return h ? `${h}h ${String(m).padStart(2, '0')}m` : `${m}m`;
};
const showRuntimeMinutes = (show?: TourShow | null) => {
  if (!show) return null;
  const explicit = Number(show.concert_duration_minutes);
  if (Number.isFinite(explicit) && explicit > 0) return explicit;
  const start = timeToMinutes(show.start_time);
  const end = timeToMinutes(show.end_time);
  if (start === null || end === null) return null;
  return end >= start ? end - start : end + 1440 - start;
};
const durationToSeconds = (value?: string | null) => {
  if (!value) return 0;
  const parts = String(value).split(':').map((part) => Number(part));
  if (parts.some((part) => !Number.isFinite(part))) return 0;
  if (parts.length === 2) return (parts[0] * 60) + parts[1];
  if (parts.length === 3) return (parts[0] * 3600) + (parts[1] * 60) + parts[2];
  return 0;
};
const formatSongRuntime = (rows: any[]) => {
  const seconds = rows.reduce((sum, row) => sum + durationToSeconds(row?.song?.duration), 0);
  return formatRuntime(Math.round(seconds / 60));
};
const describeDetail = (item: unknown): string => {
  if (item === null || item === undefined) return '';
  if (typeof item === 'string') return item.trim();
  if (typeof item === 'number' || typeof item === 'boolean') return String(item);
  if (Array.isArray(item)) return item.map(describeDetail).filter(Boolean).join(', ');
  if (typeof item === 'object') {
    const entries = Object.entries(item as Record<string, unknown>)
      .filter(([, value]) => value !== null && value !== undefined && value !== '')
      .map(([key, value]) => {
        const label = key.replace(/_/g, ' ');
        const text = Array.isArray(value)
          ? value.map(describeDetail).filter(Boolean).join(', ')
          : typeof value === 'object'
            ? describeDetail(value)
            : String(value);
        return text ? `${label}: ${text}` : '';
      })
      .filter(Boolean);
    return entries.join(' · ');
  }
  return '';
};
const detailTitle = (item: unknown, fallback: string) => {
  if (item && typeof item === 'object' && !Array.isArray(item)) {
    const record = item as Record<string, unknown>;
    return String(record.title || record.name || record.artist || record.song || record.source || fallback);
  }
  return fallback;
};
const archiveNotesForShow = (show?: TourShow | null) => {
  if (!show) return [] as Array<{ label: string; title: string; body: string }>;
  const blocks: Array<{ label: string; title: string; body: string }> = [];
  const addText = (label: string, value: unknown, title = label) => {
    const body = describeDetail(value);
    if (body) blocks.push({ label, title, body });
  };
  const addList = (label: string, value: unknown) => {
    normalizeList(value).forEach((item, index) => {
      const body = describeDetail(item);
      if (body) blocks.push({ label, title: detailTitle(item, `${label} ${index + 1}`), body });
    });
  };
  addText('Show notes', show.notes);
  addText('Facts', show.facts);
  addText('Credits', show.credits);
  addList('Lineup', show.performing_musicians);
  addList('Support', show.support_acts);
  addList('Soundcheck', show.soundcheck);
  addList('Banter', show.stage_banter);
  addList('Recording', show.recordings);
  return blocks;
};
const mediaCountForShow = (show?: TourShow | null) => show
  ? normalizeList(show.photo_assets).length
    + normalizeList(show.video_links).length
    + normalizeList(show.audio_links).length
    + normalizeList(show.recordings).length
    + normalizeList(show.additional_links).length
  : 0;

const FESTIVAL_RE = /festival|primavera|north music|nova rock|firenze rocks|pinkpop|isle of wight|belsonic|roskilde|open'?er|werchter|pohoda|ejekt|electric castle|phillgood|paleo|pal[eé]o|nimes|nîmes|oyafestivalen|way out west|summer sessions|pagaille|rock en seine/i;
const showKind = (show: TourShow) => {
  const explicit = String(show.show_type || '').toLowerCase();
  if (explicit.includes('festival')) return 'festival';
  if (explicit.includes('headline')) return 'headline';
  return FESTIVAL_RE.test(`${show.venue || ''} ${show.notes || ''}`) ? 'festival' : 'headline';
};
const ticketLabel = (show: TourShow) => {
  const explicit = String(show.ticket_status || show.sales_status || '').trim();
  if (explicit) return explicit;
  if (isPast(show)) return (show.song_count || 0) > 0 ? 'Completed' : 'Setlist pending';
  return 'Ticket TBC';
};
const ticketTone = (label: string) => {
  const value = label.toLowerCase();
  if (value.includes('sold')) return 'blood';
  if (value.includes('available') || value.includes('on sale')) return 'cool';
  if (value.includes('completed')) return 'gold';
  return 'default';
};

const upcomingShows = shows.filter((show) => !isPast(show));
const completedShows = shows.filter(isPast);
const firstUpcoming = upcomingShows[0] || null;
const lastCompleted = completedShows.length ? completedShows[completedShows.length - 1] : null;
const lastCompletedIndex = lastCompleted ? completedShows.findIndex((show) => show.id === lastCompleted.id) : -1;
const previousCompleted = lastCompletedIndex > 0 ? completedShows[lastCompletedIndex - 1] : null;

const [lastSongs, previousSongs] = await Promise.all([
  lastCompleted ? getSetlistSongs(lastCompleted.id).catch(() => []) : Promise.resolve([]),
  previousCompleted ? getSetlistSongs(previousCompleted.id).catch(() => []) : Promise.resolve([]),
]);

const songTitle = (row: any) => row?.song?.title || row?.song_title || 'Unknown song';
const lastSongTitles = lastSongs.map(songTitle).filter(Boolean);
const previousTitleSet = new Set(previousSongs.map(songTitle).filter(Boolean));
const lastTitleSet = new Set(lastSongTitles);
const addedSongs = lastSongTitles.filter((title) => !previousTitleSet.has(title));
const droppedSongs = previousSongs.map(songTitle).filter((title) => !lastTitleSet.has(title));
const opener = lastSongTitles[0] || null;
const closer = lastSongTitles[lastSongTitles.length - 1] || null;
const encoreTypes = new Set(
  lastSongs
    .filter((row: any) => /encore/i.test(String(row?.set_type || '')))
    .map((row: any) => String(row?.set_type || 'encore'))
);
const encoreCount = encoreTypes.size;
const lostWorldInLastShow = lostWorld
  ? lastSongs.filter((row: any) => Number(row?.song?.album) === Number(lostWorld.id)).length
  : 0;
const debutCount = lastSongs.filter((row: any) => row?.is_debut).length;
const fanMediaCount = mediaCountForShow(lastCompleted);
const lastShowRuntime = showRuntimeMinutes(lastCompleted);
const lastShowStart = formatClock(lastCompleted?.start_time);
const lastShowEnd = formatClock(lastCompleted?.end_time);
const lastSongRuntime = formatSongRuntime(lastSongs);
const lastShowArchiveNotes = archiveNotesForShow(lastCompleted);
const lastSongNotes = lastSongs
  .filter((row: any) => row?.notes)
  .map((row: any) => ({
    position: row.position,
    title: songTitle(row),
    setType: row.set_type || 'main',
    note: String(row.notes),
  }));
const annotatedSongCount = lastSongNotes.length;

const countries = Array.from(
  new Map(
    shows
      .map((show) => {
        const code = show.country_code || show.country || '';
        return [code, { code, label: show.country || code }];
      })
      .filter(([, value]) => value.code)
  ).values()
).sort((a, b) => a.label.localeCompare(b.label));

const festivalCount = shows.filter((show) => showKind(show) === 'festival').length;
const headlineCount = shows.length - festivalCount;
const averageSongCount = completedShows.length
  ? Math.round(completedShows.reduce((sum, show) => sum + (show.song_count || 0), 0) / completedShows.length)
  : 0;

const gaps = shows.slice(1).map((show, index) => {
  const previous = shows[index];
  const days = Math.max(0, dayDiff(previous.date, show.date) - 1);
  return { from: previous, to: show, days };
});
const notableGaps = gaps.filter((gap) => gap.days >= 4).sort((a, b) => b.days - a.days);
const longestGap = notableGaps[0] || gaps.slice().sort((a, b) => b.days - a.days)[0] || null;

const multiNightRuns: Array<{ venue: string; city: string; country: string; shows: TourShow[] }> = [];
let run: TourShow[] = [];
const flushRun = () => {
  if (run.length > 1) {
    multiNightRuns.push({
      venue: run[0].venue || 'Venue TBC',
      city: run[0].city || 'City TBC',
      country: run[0].country || '',
      shows: run.slice(),
    });
  }
};
for (const show of shows) {
  const previous = run[run.length - 1];
  const sameRoom = previous
    && previous.venue === show.venue
    && previous.city === show.city
    && previous.country === show.country
    && dayDiff(previous.date, show.date) <= 1;
  if (sameRoom) {
    run.push(show);
  } else {
    flushRun();
    run = [show];
  }
}
flushRun();

const tourRoutePoints = shows
  .map((show, index) => {
    const coords = CITY_COORDS[cityKey(show.city, show.country_code)];
    const fallback = coords ? null : countryCentroid(show.country_code, show.country);
    if (!coords && !fallback) return null;
    const lat = coords ? coords.lat : fallback![0];
    const lng = coords ? coords.lon : fallback![1];
    return {
      id: String(show.id),
      sequence: index + 1,
      date: show.date,
      slug: show.slug,
      name: show.venue || show.city || 'Show',
      place: [show.city, show.state_province, show.country].filter(Boolean).join(', '),
      lat,
      lng,
      country: show.country_code || show.country || '',
      kind: showKind(show),
      coordinateKind: coords ? 'city' : 'country',
    };
  })
  .filter(Boolean);
const cityRouteCount = tourRoutePoints.filter((point: any) => point.coordinateKind === 'city').length;
const tourCountryLabels = countries
  .map((country) => {
    const coords = countryCentroid(country.code, country.label);
    if (!coords) return null;
    return {
      id: country.code || country.label,
      name: country.label,
      lat: coords[0],
      lng: coords[1],
    };
  })
  .filter(Boolean);

const facts = [
  { k: 'Shows', v: shows.length || tour.total_shows || 0, sub: `${completedShows.length} played` },
  { k: 'Countries', v: countries.length, sub: 'summer route' },
  { k: 'Next', v: firstUpcoming ? formatDate(firstUpcoming.date) : 'Complete', sub: firstUpcoming?.city || '' },
  { k: 'Format', v: `${festivalCount}/${headlineCount}`, sub: 'festival/headline' },
  { k: 'Last runtime', v: formatRuntime(lastShowRuntime) || 'Pending', sub: lastCompleted?.city || 'clock file' },
  { k: 'Notes', v: lastShowArchiveNotes.length + annotatedSongCount, sub: 'latest show file' },
];

const calendarFeedUrl = new URL('/calendar.ics', Astro.site ?? Astro.url).toString();
const webcalUrl = calendarFeedUrl.replace(/^https?:/, 'webcal:');
const completionPct = shows.length ? Math.round((completedShows.length / shows.length) * 100) : 0;
---

<Layout
  title="2026 European Summer Shows - Cureation"
  description="A live dashboard for The Cure's 2026 European Summer Shows: dates, map, country filters, setlist watch, calendar feed and fan archive actions."
>
  <main data-tour-tracker>
    <section class="tracker-hero">
      <div class="container tracker-hero__inner">
        <Crumbs items={[{ label: 'Home', href: '/' }, { label: 'Tours', href: '/tours' }, { label: '2026 European Summer Shows' }]} />
        <div class="tracker-hero__grid">
          <div class="tracker-hero__copy">
            <div class="mono-sm tracker-eyebrow">2026 Tour Tracker</div>
            <h1 class="tracker-title">2026 European Summer Shows</h1>
            <p class="tracker-deck">
              One dashboard for the full run: dates, countries, festival/headline split, gaps between shows,
              multi-night stands, saved shows, map view and setlist watch.
            </p>
            <div class="tracker-actions">
              <Button href={webcalUrl} variant="accent">Add all dates to calendar</Button>
              <Button href="/calendar.ics" variant="ghost">Open calendar feed</Button>
              <button type="button" class="btn btn--ghost" data-near-me>Near me</button>
            </div>
            <div class="near-result mono-sm" data-near-result hidden></div>
          </div>
          <div class="tracker-facts" aria-label="Tour summary">
            {facts.map((fact) => (
              <div class="tracker-fact">
                <div class="tracker-fact__k mono-sm">{fact.k}</div>
                <div class="tracker-fact__v">{fact.v}</div>
                {fact.sub && <div class="tracker-fact__sub mono-sm">{fact.sub}</div>}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="container tracker-watch">
      <article class="watch-card watch-card--primary">
        <div class="panel-head">
          <span>Setlist Watch</span>
          <span>{completedShows.length} played - {upcomingShows.length} pending</span>
        </div>
        <div class="watch-card__body">
          <div>
            <div class="mono-sm muted">Current state</div>
            <h2 class="watch-title">
              {completedShows.length > 0
                ? lastCompleted
                  ? `Tracking ${lastCompleted.city || lastCompleted.venue || 'the last show'}`
                  : 'Tour in motion'
                : firstUpcoming
                  ? `Waiting for ${firstUpcoming.city || firstUpcoming.venue || 'the first show'}`
                  : 'Run complete'}
            </h2>
            <p class="watch-copy">
              {completedShows.length > 0
                ? 'Confirmed songs, changes and fan media will surface here as each show page fills in.'
                : 'Track opener predictions, latest album watch and tour stats before Barcelona opens the run.'}
            </p>
          </div>
          <div class="watch-meter" aria-label={`${completionPct}% complete`}>
            <span style={`width: ${completionPct}%;`}></span>
          </div>
          <div class="watch-pills">
            <span>Tour average: {averageSongCount || 'pending'}</span>
            <span>{lostWorldSongs.length || 'Latest album'} songs watched</span>
            <span>{longestGap ? `${longestGap.days} day longest gap` : 'Gaps pending'}</span>
            <span>{formatRuntime(lastShowRuntime) || 'Runtime pending'}</span>
            <span>{annotatedSongCount || 'No'} song note{annotatedSongCount === 1 ? '' : 's'}</span>
          </div>
        </div>
      </article>

      <article class="watch-card">
        <div class="panel-head">
          <span>{lastCompleted ? 'Last show' : 'First show'}</span>
          <span>{lastCompleted ? formatDate(lastCompleted.date) : firstUpcoming ? formatDate(firstUpcoming.date) : 'TBC'}</span>
        </div>
        <div class="watch-card__body">
          {lastCompleted ? (
            <>
              <h2 class="last-show-title">{lastCompleted.venue || 'Venue TBC'}</h2>
              <div class="mono-sm muted">{[lastCompleted.city, lastCompleted.country].filter(Boolean).join(', ')}</div>
              <div class="last-show-grid">
                <div><span>Start</span><strong>{lastShowStart || 'Pending'}</strong></div>
                <div><span>End</span><strong>{lastShowEnd || 'Pending'}</strong></div>
                <div><span>Total time</span><strong>{formatRuntime(lastShowRuntime) || 'Pending'}</strong></div>
                <div><span>Song runtime</span><strong>{lastSongRuntime || 'Pending'}</strong></div>
                <div><span>Songs</span><strong>{lastSongs.length || lastCompleted.song_count || 'Pending'}</strong></div>
                <div><span>Opener</span><strong>{opener || 'Pending'}</strong></div>
                <div><span>Closer</span><strong>{closer || 'Pending'}</strong></div>
                <div><span>Encore</span><strong>{encoreCount || 'Pending'}</strong></div>
                <div><span>Lost World</span><strong>{lostWorldInLastShow || 'Pending'}</strong></div>
                <div><span>Fan media</span><strong>{fanMediaCount || 'Open'}</strong></div>
                <div><span>Show notes</span><strong>{lastShowArchiveNotes.length || 'Open'}</strong></div>
                <div><span>Song notes</span><strong>{annotatedSongCount || 'None'}</strong></div>
              </div>
              <div class="change-strip">
                <div><span class="mono-sm muted">Added</span>{addedSongs.slice(0, 4).join(', ') || 'Pending previous-show comparison'}</div>
                <div><span class="mono-sm muted">Dropped</span>{droppedSongs.slice(0, 4).join(', ') || 'Pending previous-show comparison'}</div>
                <div><span class="mono-sm muted">Debuts</span>{debutCount || 'None confirmed'}</div>
              </div>
            </>
          ) : firstUpcoming ? (
            <>
              <h2 class="last-show-title">{firstUpcoming.venue || 'Venue TBC'}</h2>
              <div class="mono-sm muted">{formatLongDate(firstUpcoming.date)} - {[firstUpcoming.city, firstUpcoming.country].filter(Boolean).join(', ')}</div>
              <div class="pending-callout">
                <span class="tag tag--gold">Opening night</span>
                <span class="tag">Setlist pending</span>
                <span class="tag tag--cool">{showKind(firstUpcoming)}</span>
              </div>
            </>
          ) : (
            <p class="watch-copy">The run is complete.</p>
          )}
        </div>
      </article>
    </section>

    {lastCompleted && (
      <section class="container tracker-file">
        <div class="tracker-section-head">
          <div>
            <div class="kicker">Latest show file</div>
            <h2 class="section-title">{lastCompleted.venue || lastCompleted.city || 'Last show'}</h2>
          </div>
          <div class="tracker-route-meta mono-sm">
            <span>{formatLongDate(lastCompleted.date)}</span>
            <span>{[lastCompleted.city, lastCompleted.country].filter(Boolean).join(', ')}</span>
          </div>
        </div>

        <div class="file-grid">
          <article class="file-card">
            <div class="panel-head"><span>Clock</span><span>{formatRuntime(lastShowRuntime) || 'pending'}</span></div>
            <div class="file-card__body">
              <div class="clock-grid">
                <div><span>Start time</span><strong>{lastShowStart || 'Pending'}</strong></div>
                <div><span>End time</span><strong>{lastShowEnd || 'Pending'}</strong></div>
                <div><span>Concert total</span><strong>{formatRuntime(lastShowRuntime) || 'Pending'}</strong></div>
                <div><span>Song-file runtime</span><strong>{lastSongRuntime || 'Pending'}</strong></div>
              </div>
              <div class="source-links">
                {lastCompleted.cure_concerts_url && <a href={lastCompleted.cure_concerts_url} target="_blank" rel="noopener">Cure Concerts</a>}
                {lastCompleted.setlistfm_url && <a href={lastCompleted.setlistfm_url} target="_blank" rel="noopener">setlist.fm</a>}
                <a href={`/setlists/${lastCompleted.slug}`}>Open show page</a>
              </div>
            </div>
          </article>

          <article class="file-card">
            <div class="panel-head"><span>Show notes</span><span>{lastShowArchiveNotes.length}</span></div>
            <div class="file-card__body note-stack">
              {lastShowArchiveNotes.length > 0 ? lastShowArchiveNotes.map((note) => (
                <div class="note-block">
                  <div class="mono-sm muted">{note.label}</div>
                  <h3>{note.title}</h3>
                  <p>{note.body}</p>
                </div>
              )) : (
                <p class="muted">No show-level notes filed yet.</p>
              )}
            </div>
          </article>

          <article class="file-card">
            <div class="panel-head"><span>Song notes</span><span>{annotatedSongCount}</span></div>
            <div class="file-card__body note-stack">
              {lastSongNotes.length > 0 ? lastSongNotes.map((note) => (
                <div class="song-note">
                  <div class="song-note__pos mono-sm">{String(note.position || '–').padStart(2, '0')}</div>
                  <div>
                    <div class="serif song-note__title">{note.title}</div>
                    <div class="mono-sm muted">{note.setType}</div>
                    <p>{note.note}</p>
                  </div>
                </div>
              )) : (
                <p class="muted">No song-level notes filed for this set yet.</p>
              )}
            </div>
          </article>
        </div>

        {lastSongs.length > 0 && (
          <article class="file-card setlist-ledger">
            <div class="panel-head"><span>Full latest setlist</span><span>{lastSongs.length} songs</span></div>
            <ol class="setlist-ledger__list">
              {lastSongs.map((row: any) => {
                const title = songTitle(row);
                const SongTitle = row.song?.slug ? (
                  <a href={`/songs/${row.song.slug}`}>{title}</a>
                ) : (
                  <span>{title}</span>
                );
                return (
                  <li class={row.notes ? 'has-note' : ''}>
                    <div class="setlist-ledger__pos mono-sm">{String(row.position || '').padStart(2, '0')}</div>
                    <div class="setlist-ledger__main">
                      <div class="setlist-ledger__line">
                        <span class="serif setlist-ledger__title">{SongTitle}</span>
                        <span class="tag">{row.set_type || 'main'}</span>
                        {row.is_debut && <span class="tag tag--gold">debut</span>}
                        {row.is_cover && <span class="tag tag--cool">cover{row.cover_artist ? ` · ${row.cover_artist}` : ''}</span>}
                      </div>
                      {row.notes && <p>{row.notes}</p>}
                    </div>
                    <div class="mono-sm muted setlist-ledger__dur">{row.song?.duration || '–'}</div>
                  </li>
                );
              })}
            </ol>
          </article>
        )}
      </section>
    )}

    {tourRoutePoints.length > 0 && (
      <>
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
        <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
        <section class="container tracker-map-section">
          <div class="tracker-section-head">
            <div>
              <div class="kicker">Routes</div>
              <h2 class="section-title">Tour route</h2>
            </div>
            <div class="tracker-route-meta mono-sm">
              <span>{tourRoutePoints.length} mapped stops</span>
              <span>{cityRouteCount} city coordinates</span>
            </div>
          </div>
          <div
            id="tracker-route-map"
            class="tracker-route-map"
            data-tracker-route-map
            data-route-points={JSON.stringify(tourRoutePoints)}
            data-country-labels={JSON.stringify(tourCountryLabels)}
            aria-label="Map of 2026 European Summer Shows"
          >
            <div class="tracker-route-map__loading mono-sm">LOADING OPENSTREETMAP</div>
          </div>
        </section>
      </>
    )}

    <section class="container tracker-board">
      <div class="tracker-section-head">
        <div>
          <div class="kicker">Date list</div>
          <h2 class="section-title">Full itinerary</h2>
        </div>
        <div class="mono-sm muted" data-visible-count>{shows.length} shows</div>
      </div>

      <div class="country-filters" data-country-filters aria-label="Country filters">
        <button type="button" class="chip is-active" aria-pressed="true" data-country="all">All countries</button>
        {countries.map((country) => (
          <button type="button" class="chip" aria-pressed="false" data-country={country.code}>{country.label}</button>
        ))}
      </div>

      <div class="schedule-grid">
        <div class="schedule-list">
          {[
            { key: 'upcoming', title: 'Upcoming', items: upcomingShows },
            { key: 'completed', title: 'Completed', items: completedShows.slice().reverse() },
          ].map((group) => group.items.length > 0 && (
            <section class="schedule-group" data-group={group.key}>
              <div class="schedule-group__head">
                <h3>{group.title}</h3>
                <span class="mono-sm">{group.items.length}</span>
              </div>
              <div class="show-list">
                {group.items.map((show) => {
                  const coords = CITY_COORDS[cityKey(show.city, show.country_code)];
                  const kind = showKind(show);
                  const label = ticketLabel(show);
                  const tone = ticketTone(label);
                  const runtime = formatRuntime(showRuntimeMinutes(show));
                  const showNotes = archiveNotesForShow(show);
                  return (
                    <article
                      class="show-row"
                      data-show-card
                      data-country={show.country_code || show.country || ''}
                      data-lat={coords?.lat ?? ''}
                      data-lon={coords?.lon ?? ''}
                      data-venue={show.venue || show.city || 'Show'}
                      data-when={formatDate(show.date)}
                    >
                      <time class="show-row__date" datetime={show.date || undefined}>
                        <span>{formatDate(show.date).split(' ').slice(1).join(' ') || 'TBC'}</span>
                        <small>{show.date?.slice(0, 4) || '2026'}</small>
                      </time>
                      <div class="show-row__main">
                        <a class="show-row__title" href={`/setlists/${show.slug}`}>{show.venue || 'Venue TBC'}</a>
                        <div class="show-row__place mono-sm">
                          {[show.city, show.state_province, show.country].filter(Boolean).join(', ')}
                        </div>
                        <div class="show-row__badges">
                          <span class={`tag ${kind === 'festival' ? 'tag--hot' : 'tag--cool'}`}>{kind}</span>
                          <span class={`tag ${tone === 'blood' ? 'tag--blood' : tone === 'gold' ? 'tag--gold' : tone === 'cool' ? 'tag--cool' : ''}`}>{label}</span>
                          {(show.song_count || 0) > 0 && <span class="tag tag--gold">{show.song_count} songs</span>}
                          {formatClock(show.start_time) && <span class="tag">starts {formatClock(show.start_time)}</span>}
                          {formatClock(show.end_time) && <span class="tag">ends {formatClock(show.end_time)}</span>}
                          {runtime && <span class="tag tag--cool">{runtime}</span>}
                        </div>
                        {showNotes.length > 0 && (
                          <details class="show-row__notes">
                            <summary class="mono-sm">Notes ({showNotes.length})</summary>
                            <div class="show-row__notes-body">
                              {showNotes.map((note) => (
                                <div>
                                  <span class="mono-sm muted">{note.label}</span>
                                  <p>{note.body}</p>
                                </div>
                              ))}
                            </div>
                          </details>
                        )}
                      </div>
                      <div class="show-row__actions">
                        <Bookmark
                          kind="setlist"
                          id={show.id}
                          label={`${show.venue || show.city || 'Show'} - ${show.date || '2026'}`}
                          href={`/setlists/${show.slug}`}
                          actionLabel={isPast(show) ? 'I was there' : "I'm going"}
                        />
                        <a class="mini-action" href="/calendar.ics">Reminder</a>
                        <a class="mini-action" href="/community">{isPast(show) ? 'Memory' : 'Tips'}</a>
                      </div>
                    </article>
                  );
                })}
              </div>
            </section>
          ))}
        </div>

        <aside class="run-panel">
          <div class="panel-head"><span>Gaps</span><span>between shows</span></div>
          <div class="run-panel__body">
            {notableGaps.length > 0 ? notableGaps.slice(0, 5).map((gap) => (
              <div class="run-line">
                <strong>{gap.days} days</strong>
                <span>{gap.from.city || gap.from.venue} to {gap.to.city || gap.to.venue}</span>
                <small>{formatDate(gap.from.date)} - {formatDate(gap.to.date)}</small>
              </div>
            )) : (
              <p class="muted">No large gaps yet.</p>
            )}
          </div>

          <div class="panel-head"><span>Multi-night runs</span><span>{multiNightRuns.length}</span></div>
          <div class="run-panel__body">
            {multiNightRuns.length > 0 ? multiNightRuns.map((item) => (
              <div class="run-line">
                <strong>{item.shows.length} nights</strong>
                <span>{item.venue} - {item.city}</span>
                <small>{formatDate(item.shows[0].date)} - {formatDate(item.shows[item.shows.length - 1].date)}</small>
              </div>
            )) : (
              <p class="muted">No multi-night stands on file.</p>
            )}
          </div>
        </aside>
      </div>
    </section>

    <section class="container tracker-setlist-detail">
      <div class="tracker-section-head">
        <div>
          <div class="kicker">Setlist watch</div>
          <h2 class="section-title">What changes once the tour starts</h2>
        </div>
        <div class="mono-sm muted">{lostWorld?.title || 'Latest album'} watch</div>
      </div>
      <div class="setlist-cards">
        <article class="setlist-card">
          <div class="mono-sm muted">Songs of a Lost World</div>
          <h3>{lostWorldSongs.filter((song) => (song.times_played_live || 0) === 0).length} never played live</h3>
          <div class="song-bars">
            {lostWorldSongs.slice(0, 8).map((song) => {
              const plays = song.times_played_live || 0;
              const width = Math.min(100, Math.max(8, plays * 3));
              return (
                <div class="song-bar">
                  <span>{song.title}</span>
                  <i style={`width: ${width}%;`}></i>
                  <b>{plays}</b>
                </div>
              );
            })}
          </div>
        </article>
        <article class="setlist-card">
          <div class="mono-sm muted">Changes from previous show</div>
          <h3>{lastSongs.length ? `${addedSongs.length} added / ${droppedSongs.length} dropped` : 'Waiting for Barcelona'}</h3>
          <p>{lastSongs.length ? `Latest comparison is ${lastCompleted?.city || 'the last show'} against ${previousCompleted?.city || 'the previous show'}.` : 'The comparison module will light up after two confirmed setlists.'}</p>
        </article>
        <article class="setlist-card">
          <div class="mono-sm muted">Fan archive</div>
          <h3>Going, went, remembered</h3>
          <p>Each date has local saves for "I'm going" before the show and "I was there" after it, plus quick routes for reminders, tips and memories.</p>
        </article>
      </div>
    </section>
  </main>
</Layout>

<script>
  function readTrackerRoutePoints(el: HTMLElement) {
    try {
      const raw = el.getAttribute('data-route-points') || '[]';
      return JSON.parse(raw).filter((point: any) => Number.isFinite(point.lat) && Number.isFinite(point.lng));
    } catch {
      return [];
    }
  }

  function readTrackerCountryLabels(el: HTMLElement) {
    try {
      const raw = el.getAttribute('data-country-labels') || '[]';
      const labels = JSON.parse(raw);
      return Array.isArray(labels)
        ? labels.filter((label: any) => Number.isFinite(label.lat) && Number.isFinite(label.lng) && label.name)
        : [];
    } catch {
      return [];
    }
  }

  function trackerMapEsc(value: unknown) {
    return String(value ?? '').replace(/[&<>"']/g, (char) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;',
    }[char] || char));
  }

  async function waitForTrackerLeaflet() {
    for (let i = 0; i < 80; i += 1) {
      const L = (window as any).L;
      if (L) return L;
      await new Promise((resolve) => window.setTimeout(resolve, 50));
    }
    return null;
  }

  function addTrackerCountryLabels(L: any, map: any, labels: any[]) {
    const layer = L.layerGroup().addTo(map);
    labels.forEach((label) => {
      L.marker([label.lat, label.lng], {
        interactive: false,
        keyboard: false,
        icon: L.divIcon({
          className: 'english-country-label',
          html: `<span>${trackerMapEsc(label.name)}</span>`,
          iconSize: [0, 0],
        }),
      }).addTo(layer);
    });
    return layer;
  }

  function trackerRoutePopup(point: any) {
    const source = point.coordinateKind === 'city' ? 'CITY COORDINATES' : 'COUNTRY-CENTRE FALLBACK';
    const href = point.slug ? `/setlists/${trackerMapEsc(point.slug)}` : '';
    return `
      <div class="tracker-route-popup">
        <div class="tracker-route-popup__eyebrow">SHOW ${String(point.sequence).padStart(2, '0')} · ${source}</div>
        <div class="tracker-route-popup__title">${trackerMapEsc(point.name)}</div>
        <div class="tracker-route-popup__place">${trackerMapEsc(point.place || '')}</div>
        ${point.date ? `<div class="tracker-route-popup__date">${trackerMapEsc(point.date)}</div>` : ''}
        ${href ? `<a class="tracker-route-popup__link" href="${href}">Open show</a>` : ''}
      </div>
    `;
  }

  async function bootTrackerRouteMap() {
    const el = document.querySelector<HTMLElement>('[data-tracker-route-map]');
    if (!el || el.dataset.booted === 'true') return;
    el.dataset.booted = 'true';

    const routePoints = readTrackerRoutePoints(el);
    const L = await waitForTrackerLeaflet();
    if (!L || routePoints.length === 0) {
      el.innerHTML = '<div class="tracker-route-map__loading mono-sm">MAP UNAVAILABLE</div>';
      return;
    }

    const rootStyles = getComputedStyle(document.documentElement);
    const accent = rootStyles.getPropertyValue('--accent').trim() || '#F70D1A';
    const accent2 = rootStyles.getPropertyValue('--accent-2').trim() || '#B60710';
    const hot = rootStyles.getPropertyValue('--hot').trim() || '#C85C46';
    const muted = rootStyles.getPropertyValue('--muted').trim() || '#888';

    const map = L.map(el, {
      worldCopyJump: true,
      minZoom: 2,
      scrollWheelZoom: false,
      zoomControl: true,
      attributionControl: true,
    });

    L.tileLayer('https://{s}.basemaps.cartocdn.com/light_nolabels/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
      maxZoom: 20,
      subdomains: 'abcd',
    }).addTo(map);
    addTrackerCountryLabels(L, map, readTrackerCountryLabels(el));

    const linePoints = routePoints.map((point: any) => [point.lat, point.lng]);
    const routeLine = linePoints.length > 1
      ? L.polyline(linePoints, {
        color: accent,
        weight: 2,
        opacity: 0.72,
        dashArray: '7 9',
        lineCap: 'round',
      }).addTo(map)
      : null;

    const markerLayer = L.layerGroup().addTo(map);
    const markers = routePoints.map((point: any, index: number) => {
      const cityPoint = point.coordinateKind === 'city';
      const festival = point.kind === 'festival';
      const firstOrLast = index === 0 || index === routePoints.length - 1;
      const marker = L.circleMarker([point.lat, point.lng], {
        radius: firstOrLast ? 8 : festival ? 6 : cityPoint ? 5 : 4,
        color: festival ? hot : cityPoint ? accent2 : muted,
        weight: firstOrLast ? 2 : 1.2,
        fillColor: festival ? hot : cityPoint ? accent : muted,
        fillOpacity: festival ? 0.72 : cityPoint ? 0.78 : 0.42,
        opacity: festival || cityPoint ? 0.95 : 0.62,
      }).bindPopup(trackerRoutePopup(point));
      marker.addTo(markerLayer);
      return { country: point.country || '', marker, cityPoint, festival };
    });

    (el as any)._trackerRouteMapState = { map, markerLayer, markers, routeLine };

    const bounds = L.latLngBounds(linePoints);
    if (bounds.isValid()) {
      map.fitBounds(bounds.pad(0.18), { maxZoom: routePoints.length > 1 ? 6 : 4 });
    } else {
      map.setView([52, 8], 4);
    }
    window.setTimeout(() => map.invalidateSize(), 120);
  }

  function repaintTrackerRouteTheme() {
    const el = document.querySelector<HTMLElement>('[data-tracker-route-map]');
    const state = el ? (el as any)._trackerRouteMapState : null;
    if (!state) return;
    const rootStyles = getComputedStyle(document.documentElement);
    const accent = rootStyles.getPropertyValue('--accent').trim() || '#F70D1A';
    const accent2 = rootStyles.getPropertyValue('--accent-2').trim() || '#B60710';
    const hot = rootStyles.getPropertyValue('--hot').trim() || '#C85C46';
    const muted = rootStyles.getPropertyValue('--muted').trim() || '#888';
    state.routeLine?.setStyle({ color: accent });
    state.markers.forEach(({ marker, cityPoint, festival }: any) => {
      marker.setStyle({
        color: festival ? hot : cityPoint ? accent2 : muted,
        fillColor: festival ? hot : cityPoint ? accent : muted,
      });
    });
  }

  function wireTourTracker() {
    const root = document.querySelector<HTMLElement>('[data-tour-tracker]');
    if (!root || root.dataset.wired === 'true') return;
    root.dataset.wired = 'true';

    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-country-filters] [data-country]'));
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-show-card]'));
    const mapEl = root.querySelector<HTMLElement>('[data-tracker-route-map]');
    const counter = root.querySelector<HTMLElement>('[data-visible-count]');

    const applyCountry = (country: string) => {
      let shown = 0;
      cards.forEach((card) => {
        const ok = country === 'all' || card.dataset.country === country;
        card.hidden = !ok;
        if (ok) shown++;
      });
      const mapState = mapEl ? (mapEl as any)._trackerRouteMapState : null;
      if (mapState) {
        mapState.markerLayer.clearLayers();
        mapState.markers.forEach(({ country: markerCountry, marker }: any) => {
          if (country === 'all' || markerCountry === country) marker.addTo(mapState.markerLayer);
        });
      }
      chips.forEach((chip) => {
        const active = chip.dataset.country === country;
        chip.classList.toggle('is-active', active);
        chip.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
      if (counter) counter.textContent = `${shown} show${shown === 1 ? '' : 's'}`;
    };

    chips.forEach((chip) => {
      chip.addEventListener('click', () => applyCountry(chip.dataset.country || 'all'));
    });

    const nearButton = root.querySelector<HTMLButtonElement>('[data-near-me]');
    const nearResult = root.querySelector<HTMLElement>('[data-near-result]');
    const distanceKm = (aLat: number, aLon: number, bLat: number, bLon: number) => {
      const toRad = (value: number) => (value * Math.PI) / 180;
      const earth = 6371;
      const dLat = toRad(bLat - aLat);
      const dLon = toRad(bLon - aLon);
      const s1 = Math.sin(dLat / 2) ** 2;
      const s2 = Math.cos(toRad(aLat)) * Math.cos(toRad(bLat)) * Math.sin(dLon / 2) ** 2;
      return 2 * earth * Math.asin(Math.sqrt(s1 + s2));
    };

    nearButton?.addEventListener('click', () => {
      if (!nearResult) return;
      if (!('geolocation' in navigator)) {
        nearResult.hidden = false;
        nearResult.textContent = 'Location is not available in this browser.';
        return;
      }
      nearResult.hidden = false;
      nearResult.textContent = 'Checking nearest show...';
      navigator.geolocation.getCurrentPosition(
        (position) => {
          const ranked = cards
            .map((card) => {
              const lat = Number(card.dataset.lat);
              const lon = Number(card.dataset.lon);
              if (!Number.isFinite(lat) || !Number.isFinite(lon)) return null;
              return {
                card,
                km: distanceKm(position.coords.latitude, position.coords.longitude, lat, lon),
              };
            })
            .filter(Boolean) as Array<{ card: HTMLElement; km: number }>;
          ranked.sort((a, b) => a.km - b.km);
          const nearest = ranked[0];
          if (!nearest) {
            nearResult.textContent = 'No mapped shows are available yet.';
            return;
          }
          nearResult.textContent = `Nearest show: ${nearest.card.dataset.venue || 'show'} - ${nearest.card.dataset.when || 'date TBC'} - ${Math.round(nearest.km)} km away.`;
          nearest.card.scrollIntoView({ behavior: 'smooth', block: 'center' });
        },
        () => {
          nearResult.textContent = 'Location permission was not granted.';
        },
        { enableHighAccuracy: false, timeout: 10000, maximumAge: 600000 }
      );
    });
  }

  wireTourTracker();
  bootTrackerRouteMap();
  document.addEventListener('astro:page-load', wireTourTracker);
  document.addEventListener('astro:page-load', bootTrackerRouteMap);
  document.addEventListener('cureation:theme-change', repaintTrackerRouteTheme);
  document.addEventListener('cureation:colour-theme-change', repaintTrackerRouteTheme);
</script>

<style>
  .tracker-hero {
    border-bottom: 1px solid var(--rule-strong);
    background:
      linear-gradient(135deg, color-mix(in oklab, var(--accent), transparent 86%), transparent 42%),
      var(--bg);
  }
  .tracker-hero__inner { padding-top: clamp(28px, 4vw, 56px); padding-bottom: clamp(36px, 5vw, 72px); }
  .tracker-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(320px, 0.8fr);
    gap: clamp(24px, 4vw, 60px);
    align-items: end;
    margin-top: clamp(20px, 3vw, 40px);
  }
  .tracker-eyebrow { color: var(--accent-3); margin-bottom: 12px; }
  .tracker-title {
    font-family: var(--f-display);
    font-style: italic;
    font-size: clamp(48px, 7vw, 104px);
    line-height: .92;
    letter-spacing: -0.015em;
    margin: 0;
    max-width: 10ch;
  }
  .tracker-deck {
    font-family: var(--f-serif);
    font-style: italic;
    font-size: clamp(18px, 1.6vw, 22px);
    color: var(--ink-2);
    max-width: 58ch;
    margin: clamp(18px, 2vw, 26px) 0 0;
  }
  .tracker-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: clamp(20px, 3vw, 32px); }
  .near-result {
    margin-top: 12px;
    color: var(--accent-3);
    border-left: 2px solid var(--accent);
    padding-left: 12px;
  }
  .tracker-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--ink);
