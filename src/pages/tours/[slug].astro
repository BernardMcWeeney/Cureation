---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import Crumbs from '../../components/ui/Crumbs.astro';
import Tag from '../../components/ui/Tag.astro';
import Bookmark from '../../components/ui/Bookmark.astro';
import DossierNav from '../../components/ui/DossierNav.astro';
import TourStrip from '../../components/viz/TourStrip.astro';
import { getTourBySlug, listSetlists, listAlbums, listVenues } from '../../lib/directus';
import { asset } from '../../lib/assets';
import { cityCentroid } from '../../lib/city-centroids';
import { countryCentroid, isValidCoordinate } from '../../lib/geo';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/tours');
const tour = await getTourBySlug(slug);
if (!tour) return new Response('Not found', { status: 404 });

const [setlists, albums, venues] = await Promise.all([
  listSetlists({ tour: tour.id, limit: 400 }),
  listAlbums(),
  listVenues(),
]);

const sortedByDate = [...setlists].sort((a, b) => (a.date || '').localeCompare(b.date || ''));
const venueById = new Map(venues.map((v) => [v.id, v]));
const tourRoutePoints = sortedByDate
  .map((s, index) => {
    const venue = s.venue_link ? venueById.get(s.venue_link) : null;
    if (venue && isValidCoordinate(venue.latitude, venue.longitude)) {
      return {
        id: String(s.id),
        sequence: index + 1,
        date: s.date,
        slug: s.slug,
        name: s.venue || venue.name || 'Show',
        place: [s.city, s.state_province, s.country].filter(Boolean).join(', '),
        lat: Number(venue.latitude),
        lng: Number(venue.longitude),
        coordinateKind: 'venue',
      };
    }
    const cityFallback = cityCentroid(s.country_code, s.country, s.city, s.state_province);
    const countryFallback = cityFallback ? null : countryCentroid(s.country_code, s.country);
    const fallback = cityFallback || countryFallback;
    if (!fallback) return null;
    return {
      id: String(s.id),
      sequence: index + 1,
      date: s.date,
      slug: s.slug,
      name: s.venue || s.city || 'Show',
      place: [s.city, s.state_province, s.country].filter(Boolean).join(', '),
      lat: fallback[0],
      lng: fallback[1],
      coordinateKind: cityFallback ? 'city' : 'country',
    };
  })
  .filter(Boolean);
const preciseRouteCount = tourRoutePoints.filter((p: any) => p.coordinateKind === 'venue').length;
const album = tour.associated_album ? albums.find((a) => a.id === tour.associated_album) : null;

const startY = tour.start_date?.slice(0, 4);
const endY = tour.end_date?.slice(0, 4);
const years = startY && endY ? (startY === endY ? startY : `${startY}–${endY}`) : (startY || '–');
const countries = Array.from(new Set(setlists.map((s) => s.country).filter(Boolean))).sort();
const tourCountryLabelByKey = new Map<string, { id: string; name: string; lat: number; lng: number }>();
for (const s of sortedByDate) {
  const name = s.country || s.country_code || '';
  const coords = countryCentroid(s.country_code, s.country);
  if (!name || !coords) continue;
  const id = s.country_code || name;
  if (!tourCountryLabelByKey.has(id)) {
    tourCountryLabelByKey.set(id, { id, name, lat: coords[0], lng: coords[1] });
  }
}
const tourCountryLabels = Array.from(tourCountryLabelByKey.values()).sort((a, b) => a.name.localeCompare(b.name));
const countryFilters = Array.from(
  new Map(
    sortedByDate
      .map((s) => {
        const code = s.country_code || s.country || '';
        return [code, { code, label: s.country || code }] as const;
      })
      .filter(([, value]) => Boolean(value.code))
  ).values()
).sort((a, b) => a.label.localeCompare(b.label));

const now = new Date();
const todayIso = now.toISOString().slice(0, 10);
const dateFmt = new Intl.DateTimeFormat('en-GB', { weekday: 'short', day: '2-digit', month: 'short' });
const parseDate = (value?: string | null) => (value ? new Date(`${value}T00:00:00Z`) : null);
const formatDate = (value?: string | null) => {
  const parsed = parseDate(value);
  return parsed ? dateFmt.format(parsed) : 'Date TBC';
};
const dayDiff = (a?: string | null, b?: string | null) => {
  const da = parseDate(a);
  const db = parseDate(b);
  if (!da || !db) return 0;
  return Math.round((db.getTime() - da.getTime()) / 86400000);
};
const isPastShow = (s: typeof sortedByDate[number]) => !!s.date && s.date < todayIso;
const FESTIVAL_RE = /festival|fest|glastonbury|reading|leeds|pinkpop|werchter|roskilde|coachella|lollapalooza|primavera|fuji rock|rock am ring|rock im park|exit|sziget|paleo|pal[eé]o|hurricane|southside|benicassim|isle of wight|hyde park|summer sonic/i;
const showKind = (s: typeof sortedByDate[number]) =>
  FESTIVAL_RE.test(`${s.venue || ''} ${s.city || ''} ${s.tour_name || ''}`) ? 'festival' : 'headline';
const statusLabel = (s: typeof sortedByDate[number]) => {
  if (isPastShow(s)) return (s.song_count || 0) > 0 ? 'Completed' : 'Setlist pending';
  return 'Upcoming';
};
const statusTone = (label: string) => label === 'Completed' ? 'tag--gold' : label === 'Upcoming' ? 'tag--cool' : '';

const upcomingSetlists = sortedByDate.filter((s) => !isPastShow(s));
const completedSetlists = sortedByDate.filter(isPastShow);
const scheduleGroups = [
  { key: 'upcoming', title: 'Upcoming', items: upcomingSetlists },
  { key: 'completed', title: 'Completed', items: completedSetlists },
].filter((group) => group.items.length > 0);

const gaps = sortedByDate.slice(1).map((s, index) => {
  const previous = sortedByDate[index];
  const days = Math.max(0, dayDiff(previous.date, s.date) - 1);
  return { from: previous, to: s, days };
});
const notableGaps = gaps.filter((gap) => gap.days >= 4).sort((a, b) => b.days - a.days);

const multiNightRuns: Array<{ venue: string; city: string; country: string; shows: typeof sortedByDate }> = [];
let run: typeof sortedByDate = [];
const flushRun = () => {
  if (run.length > 1) {
    multiNightRuns.push({
      venue: run[0].venue || 'Venue TBD',
      city: run[0].city || 'City TBD',
      country: run[0].country || '',
      shows: run.slice(),
    });
  }
};
for (const s of sortedByDate) {
  const previous = run[run.length - 1];
  const sameRoom = previous
    && previous.venue === s.venue
    && previous.city === s.city
    && previous.country === s.country
    && dayDiff(previous.date, s.date) <= 1;
  if (sameRoom) {
    run.push(s);
  } else {
    flushRun();
    run = [s];
  }
}
flushRun();

const lineup: string[] = Array.isArray(tour.lineup)
  ? tour.lineup.map((m: any) => typeof m === 'string' ? m : (m.name || m.member)).filter(Boolean)
  : [];

const supportActs: string[] = Array.isArray(tour.support_acts)
  ? tour.support_acts.map((a: any) => typeof a === 'string' ? a : (a.name || a.artist)).filter(Boolean)
  : [];

const facts: Array<[string, string]> = [
  ['Years', years],
  ['Start', tour.start_date || '–'],
  ['End', tour.end_date || '–'],
  ['Shows on file', String(setlists.length)],
  ['Total shows', String(tour.total_shows || setlists.length || '–')],
  ['Countries', String(countries.length)],
  ['Associated record', album?.title || '–'],
  ['Lineup size', String(lineup.length || '–')],
];

const heroSrc = tour.image_file ? asset(tour.image_file, 'hero') : (tour.image || null);
---
<Layout title={`${tour.name} · Tours · Cureation`} description={tour.description || undefined} ogImage={(tour.image_file || album?.cover_art) ? asset(tour.image_file || album!.cover_art, 'og') : undefined}>
  <div class="container" style="padding-top: clamp(24px, 3vw, 40px);">
    <Crumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Tours', href: '/tours' },
      { label: tour.name },
    ]} />
  </div>

  {heroSrc && (
    <section class="container" style="padding-block: clamp(16px, 3vw, 32px);">
      <figure style="position: relative; aspect-ratio: 21/9; overflow:hidden; border: 1px solid var(--rule); background: var(--bg-2);">
        <img src={heroSrc} alt={tour.name} style="width:100%; height:100%; object-fit:cover; filter: saturate(.85) contrast(1.1);" />
        <div class="cover-plate__corner cover-plate__corner--tl"><span>TOUR · {years}</span></div>
        <div class="cover-plate__corner cover-plate__corner--tr"><span>{setlists.length} ON FILE</span></div>
      </figure>
    </section>
  )}

  <section id="tour-overview" class="container tour-head detail-anchor" style="margin-top: 1rem;">
    {!heroSrc && <div class="mono-sm muted">TOUR · {years}</div>}
    <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:1rem; margin-top:.6rem; flex-wrap:wrap;">
      <div class="cluster" style="gap:.4rem;">
        {album && <Tag>{album.title.toUpperCase()}</Tag>}
        {tour.total_shows && <span class="tag tag--gold">{tour.total_shows} SHOWS</span>}
        {countries.length > 3 && <span class="tag tag--cool">{countries.length} COUNTRIES</span>}
      </div>
      <Bookmark kind="tour" id={tour.id} label={tour.name} href={`/tours/${tour.slug}`} />
    </div>
    <h1 class="tour-head__title serif">{tour.name}</h1>
    {tour.description && <p class="tour-head__lede">{tour.description}</p>}
    <div class="facts" style="margin-top: 1.4rem;">
      {facts.map(([k, v]) => (
        <div class="facts__item">
          <div class="facts__k">{k}</div>
          <div class="facts__v">{v}</div>
        </div>
      ))}
    </div>
  </section>

  <div class="container">
    <DossierNav items={[
      { label: 'Overview', href: '#tour-overview', meta: years },
      ...(setlists.length > 1 ? [{ label: 'The run', href: '#tour-run', meta: `${setlists.length} shows` }] : []),
      ...(tourRoutePoints.length ? [{ label: 'Route', href: '#tour-route', meta: `${tourRoutePoints.length} stops` }] : []),
      { label: 'Itinerary', href: '#tour-itinerary', meta: `${setlists.length} dates` },
      { label: 'Tour file', href: '#tour-file', meta: 'Context' },
    ]} />
  </div>

  {setlists.length > 1 && (
    <section id="tour-run" class="container detail-anchor" style="padding-block: clamp(16px, 3vw, 32px); border-top: 1px solid var(--rule);">
      <div class="mono-sm muted" style="margin-bottom:.5rem;">THE RUN · SHOW BY SHOW</div>
      <TourStrip total={setlists.length} height={42} />
      <div class="mono-sm muted" style="margin-top:.5rem;">
        {setlists.length} shows on file · {tour.start_date || '?'} → {tour.end_date || '?'}
      </div>
    </section>
  )}

  {tourRoutePoints.length > 0 && (
    <>
      <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
      <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
      <section id="tour-route" class="container tour-route-section detail-anchor">
        <div class="tour-route-head">
          <div>
            <div class="kicker">Routes</div>
            <h2 class="tour-route-title">Tour route</h2>
          </div>
          <div class="tour-route-meta mono-sm">
            <span>{tourRoutePoints.length} mapped stops</span>
            <span>{preciseRouteCount} venue coordinates</span>
          </div>
        </div>
        <div
          id="tour-route-map"
          class="tour-route-map"
          data-tour-route-map
          data-route-points={JSON.stringify(tourRoutePoints)}
          data-country-labels={JSON.stringify(tourCountryLabels)}
        >
          <div class="tour-route-map__loading mono-sm">LOADING OPENSTREETMAP</div>
        </div>
      </section>
    </>
  )}

  <section id="tour-itinerary" class="container tour-board detail-anchor" data-tour-itinerary>
    <div class="tour-grid">
      <div>
        <div class="tour-board__head">
          <div>
            <div class="kicker">Date list</div>
            <h2 class="tour-board__title">Full itinerary</h2>
          </div>
          <div class="mono-sm muted" data-visible-count>{setlists.length} shows</div>
        </div>

        {countryFilters.length > 1 && (
          <div class="country-filters" data-country-filters aria-label="Country filters">
            <button type="button" class="chip is-active" aria-pressed="true" data-country="all">All countries</button>
            {countryFilters.map((country) => (
              <button type="button" class="chip" aria-pressed="false" data-country={country.code}>{country.label}</button>
            ))}
          </div>
        )}

        <div class="schedule-list">
          {scheduleGroups.map((group) => (
            <section class="schedule-group" data-group={group.key}>
              <div class="schedule-group__head">
                <h3>{group.title}</h3>
                <span class="mono-sm">{group.items.length}</span>
              </div>
              <div class="show-list">
                {group.items.map((s, i) => {
                  const kind = showKind(s);
                  const label = statusLabel(s);
                  const sequence = sortedByDate.findIndex((item) => item.id === s.id) + 1;
                  return (
                    <article
                      class="show-row"
                      data-show-card
                      data-country={s.country_code || s.country || ''}
                    >
                      <time class="show-row__date" datetime={s.date || undefined}>
                        <span>{formatDate(s.date)}</span>
                        <small>Show {String(sequence || i + 1).padStart(2, '0')}</small>
                      </time>
                      <div class="show-row__main">
                        <a class="show-row__title" href={`/setlists/${s.slug}`}>{s.venue || 'Venue TBD'}</a>
                        <div class="show-row__place mono-sm">
                          {[s.city, s.state_province, s.country].filter(Boolean).join(', ') || 'Location TBD'}
                        </div>
                        <div class="show-row__badges">
                          <span class={`tag ${kind === 'festival' ? 'tag--hot' : 'tag--cool'}`}>{kind}</span>
                          <span class={`tag ${statusTone(label)}`}>{label}</span>
                          {(s.song_count || 0) > 0 && <span class="tag tag--gold">{s.song_count} songs</span>}
                        </div>
                      </div>
                      <div class="show-row__actions">
                        <Bookmark
                          kind="setlist"
                          id={s.id}
                          label={`${s.venue || s.city || 'Show'} - ${s.date || years}`}
                          href={`/setlists/${s.slug}`}
                          actionLabel={isPastShow(s) ? 'I was there' : "I'm going"}
                        />
                      </div>
                    </article>
                  );
                })}
              </div>
            </section>
          ))}
        </div>
      </div>

      <aside id="tour-file" class="tour-side stack detail-anchor" style="--gap: 1.4rem;">
        {(notableGaps.length > 0 || multiNightRuns.length > 0) && (
          <div class="run-panel">
            <div class="panel-head"><span>Gaps</span><span>between shows</span></div>
            <div class="run-panel__body">
              {notableGaps.length > 0 ? notableGaps.slice(0, 5).map((gap) => (
                <div class="run-line">
                  <strong>{gap.days} days</strong>
                  <span>{gap.from.city || gap.from.venue} to {gap.to.city || gap.to.venue}</span>
                  <small>{formatDate(gap.from.date)} - {formatDate(gap.to.date)}</small>
                </div>
              )) : (
                <p class="muted">No large gaps on file.</p>
              )}
            </div>

            <div class="panel-head"><span>Multi-night runs</span><span>{multiNightRuns.length}</span></div>
            <div class="run-panel__body">
              {multiNightRuns.length > 0 ? multiNightRuns.map((item) => (
                <div class="run-line">
                  <strong>{item.shows.length} nights</strong>
                  <span>{item.venue} - {item.city}</span>
                  <small>{formatDate(item.shows[0].date)} - {formatDate(item.shows[item.shows.length - 1].date)}</small>
                </div>
              )) : (
                <p class="muted">No multi-night stands on file.</p>
              )}
            </div>
          </div>
        )}

        {lineup.length > 0 && (
          <div class="panel--bare">
            <div class="panel-head"><span>Lineup</span><span>ON THE ROAD</span></div>
            <ul style="list-style:none; margin:0; padding: 8px 16px 14px;">
              {lineup.map((m) => <li class="serif" style="font-size:17px; font-style:italic; padding: 4px 0;"><span class="pip pip--cool"></span>{m}</li>)}
            </ul>
          </div>
        )}
        {supportActs.length > 0 && (
          <div class="panel--bare">
            <div class="panel-head"><span>Support acts</span><span>ROTATING BILL</span></div>
            <ul style="list-style:none; margin:0; padding: 8px 16px 14px;">
              {supportActs.map((a) => <li class="serif" style="font-size:16px; font-style:italic; padding: 4px 0;">{a}</li>)}
            </ul>
          </div>
        )}
        {countries.length > 0 && (
          <div class="panel--bare">
            <div class="panel-head"><span>Countries</span><span>{countries.length}</span></div>
            <div class="cluster" style="gap:.3rem; padding: 12px 16px 16px;">
              {countries.map(c => <span class="tag">{c}</span>)}
            </div>
          </div>
        )}
        {album && (
          <a href={`/discography/${album.slug}`} style="display:block; border: 1px solid var(--rule); background: var(--bg-2); text-decoration: none;">
            <div class="panel-head"><span>Supporting record</span><span>{album.release_date?.slice(0,4)}</span></div>
            <div style="padding: 12px;">
              <div style="display:grid; grid-template-columns: 72px 1fr; gap: 12px; align-items:center;">
                {album.cover_art && <img src={asset(album.cover_art, 'card')} alt={album.title} style="width:72px; height:72px; object-fit:cover; border:1px solid var(--rule);" />}
                <div>
                  <div class="serif" style="font-size:22px; font-style:italic; line-height:1.1;">{album.title}</div>
                  <div class="mono-sm" style="color: var(--accent-3); margin-top:.3rem;">{(album.type || '').toUpperCase()}</div>
                </div>
              </div>
            </div>
          </a>
        )}
      </aside>
    </div>
  </section>
</Layout>

<script>
  function readTourRoutePoints(el: HTMLElement) {
    try {
      const raw = el.getAttribute('data-route-points') || '[]';
      return JSON.parse(raw).filter((point: any) => Number.isFinite(point.lat) && Number.isFinite(point.lng));
    } catch {
      return [];
    }
  }

  function readTourCountryLabels(el: HTMLElement) {
    try {
      const raw = el.getAttribute('data-country-labels') || '[]';
      const labels = JSON.parse(raw);
      return Array.isArray(labels)
        ? labels.filter((label: any) => Number.isFinite(label.lat) && Number.isFinite(label.lng) && label.name)
        : [];
    } catch {
      return [];
    }
  }

  function mapEsc(value: unknown) {
    return String(value ?? '').replace(/[&<>"']/g, (char) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;',
    }[char] || char));
  }

  async function waitForTourLeaflet() {
    for (let i = 0; i < 80; i += 1) {
      const L = (window as any).L;
      if (L) return L;
      await new Promise((resolve) => window.setTimeout(resolve, 50));
    }
    return null;
  }

  function addEnglishCountryLabels(L: any, map: any, labels: any[]) {
    const layer = L.layerGroup().addTo(map);
    labels
      .filter((label) => Number.isFinite(label.lat) && Number.isFinite(label.lng) && label.name)
      .forEach((label) => {
        L.marker([label.lat, label.lng], {
          interactive: false,
          keyboard: false,
          icon: L.divIcon({
            className: 'english-country-label',
            html: `<span>${mapEsc(label.name)}</span>`,
            iconSize: [0, 0],
          }),
        }).addTo(layer);
      });
    return layer;
  }

  function routePopup(point: any) {
    const source = point.coordinateKind === 'venue'
      ? 'VENUE COORDINATES'
      : point.coordinateKind === 'city'
        ? 'CITY COORDINATES'
        : 'COUNTRY-CENTRE FALLBACK';
    const href = point.slug ? `/setlists/${mapEsc(point.slug)}` : '';
    return `
      <div class="tour-route-popup">
        <div class="tour-route-popup__eyebrow">SHOW ${String(point.sequence).padStart(2, '0')} · ${source}</div>
        <div class="tour-route-popup__title">${mapEsc(point.name)}</div>
        <div class="tour-route-popup__place">${mapEsc(point.place || '')}</div>
        ${point.date ? `<div class="tour-route-popup__date">${mapEsc(point.date)}</div>` : ''}
        ${href ? `<a class="tour-route-popup__link" href="${href}">Open show</a>` : ''}
      </div>
    `;
  }

  async function bootTourRouteMap() {
    const el = document.querySelector<HTMLElement>('[data-tour-route-map]');
    if (!el || el.dataset.booted === 'true') return;
    el.dataset.booted = 'true';

    const routePoints = readTourRoutePoints(el);
    const L = await waitForTourLeaflet();
    if (!L || routePoints.length === 0) {
      el.innerHTML = '<div class="tour-route-map__loading mono-sm">MAP UNAVAILABLE</div>';
      return;
    }

    const rootStyles = getComputedStyle(document.documentElement);
    const accent = rootStyles.getPropertyValue('--accent').trim() || '#F70D1A';
    const accent2 = rootStyles.getPropertyValue('--accent-2').trim() || '#B60710';
    const muted = rootStyles.getPropertyValue('--muted').trim() || '#888';

    const map = L.map(el, {
      worldCopyJump: true,
      minZoom: 2,
      scrollWheelZoom: false,
      zoomControl: true,
      attributionControl: true,
    });

    L.tileLayer('https://{s}.basemaps.cartocdn.com/light_nolabels/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
      maxZoom: 20,
      subdomains: 'abcd',
    }).addTo(map);
    addEnglishCountryLabels(L, map, readTourCountryLabels(el));

    const linePoints = routePoints.map((point: any) => [point.lat, point.lng]);
    const routeLine = linePoints.length > 1
      ? L.polyline(linePoints, {
        color: accent,
        weight: 2,
        opacity: 0.72,
        dashArray: '7 9',
        lineCap: 'round',
      }).addTo(map)
      : null;

    const markers = routePoints.map((point: any, index: number) => {
      const precise = point.coordinateKind === 'venue';
      const firstOrLast = index === 0 || index === routePoints.length - 1;
      const marker = L.circleMarker([point.lat, point.lng], {
        radius: firstOrLast ? 8 : precise ? 5 : 4,
        color: precise ? accent2 : muted,
        weight: firstOrLast ? 2 : 1.2,
        fillColor: precise ? accent : muted,
        fillOpacity: precise ? 0.78 : 0.42,
        opacity: precise ? 0.95 : 0.62,
      }).bindPopup(routePopup(point)).addTo(map);
      return { marker, precise };
    });
    (el as any)._tourRouteMapThemeState = { markers, routeLine };

    const bounds = L.latLngBounds(linePoints);
    if (bounds.isValid()) {
      map.fitBounds(bounds.pad(0.18), { maxZoom: routePoints.length > 1 ? 6 : 4 });
    } else {
      map.setView([24, 0], 2);
    }
    window.setTimeout(() => map.invalidateSize(), 120);
  }

  function repaintTourRouteTheme() {
    const el = document.querySelector<HTMLElement>('[data-tour-route-map]');
    const state = el ? (el as any)._tourRouteMapThemeState : null;
    if (!state) return;
    const rootStyles = getComputedStyle(document.documentElement);
    const accent = rootStyles.getPropertyValue('--accent').trim() || '#F70D1A';
    const accent2 = rootStyles.getPropertyValue('--accent-2').trim() || '#B60710';
    const muted = rootStyles.getPropertyValue('--muted').trim() || '#888';
    state.routeLine?.setStyle({ color: accent });
    state.markers.forEach(({ marker, precise }: any) => {
      marker.setStyle({ color: precise ? accent2 : muted, fillColor: precise ? accent : muted });
    });
  }

  function wireTourItinerary() {
    const root = document.querySelector<HTMLElement>('[data-tour-itinerary]');
    if (!root || root.dataset.wired === 'true') return;
    root.dataset.wired = 'true';

    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-country-filters] [data-country]'));
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-show-card]'));
    const groups = Array.from(root.querySelectorAll<HTMLElement>('[data-group]'));
    const counter = root.querySelector<HTMLElement>('[data-visible-count]');

    const applyCountry = (country: string) => {
      let shown = 0;
      cards.forEach((card) => {
        const ok = country === 'all' || card.dataset.country === country;
        card.hidden = !ok;
        if (ok) shown++;
      });
      groups.forEach((group) => {
        const visible = Array.from(group.querySelectorAll<HTMLElement>('[data-show-card]')).some((card) => !card.hidden);
        group.hidden = !visible;
      });
      chips.forEach((chip) => {
        const active = chip.dataset.country === country;
        chip.classList.toggle('is-active', active);
        chip.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
      if (counter) counter.textContent = `${shown} show${shown === 1 ? '' : 's'}`;
    };

    chips.forEach((chip) => {
      chip.addEventListener('click', () => applyCountry(chip.dataset.country || 'all'));
    });
  }

  wireTourItinerary();
  bootTourRouteMap();
  document.addEventListener('astro:page-load', wireTourItinerary);
  document.addEventListener('astro:page-load', bootTourRouteMap);
  document.addEventListener('cureation:theme-change', repaintTourRouteTheme);
  document.addEventListener('cureation:colour-theme-change', repaintTourRouteTheme);
</script>

