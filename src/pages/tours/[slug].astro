---
import MainLayout from "../../layouts/MainLayout.astro";
import { countryCodeToFlag } from '../../types/directus';

interface TourData {
  id: number;
  name: string;
  slug: string;
  startDate?: string;
  endDate?: string;
  description?: string;
  associatedAlbumId?: number;
  associatedAlbumTitle?: string;
  associatedAlbumSlug?: string;
  associatedAlbumCover?: string;
  totalShows: number;
  countriesVisited: string[];
  supportActs: string[];
  lineup: string[];
}

interface TourSetlist {
  slug: string;
  date: string;
  formattedDate: string;
  venue: string;
  city: string;
  country: string;
  countryCode?: string;
  songCount: number;
}

export async function getStaticPaths() {
  const DIRECTUS_URL = 'https://dash.cureation.net';

  const toursRes = await fetch(`${DIRECTUS_URL}/items/tours?limit=-1`);
  const toursData = await toursRes.json();

  const albumsRes = await fetch(`${DIRECTUS_URL}/items/discography?limit=-1&fields=id,title,slug,cover_art`);
  const albumsData = await albumsRes.json();

  const setlistsRes = await fetch(`${DIRECTUS_URL}/items/setlists?limit=-1&fields=id,tour,venue,city,country,country_code,date,slug,song_count,tour_name&sort=-date`);
  const setlistsData = await setlistsRes.json();

  if (!toursData.data) return [];

  // Album lookup
  const albumMap = new Map<number, any>();
  if (albumsData.data) {
    for (const a of albumsData.data) albumMap.set(a.id, a);
  }

  // Setlists by tour ID
  const setlistsByTour = new Map<number, any[]>();
  if (setlistsData.data) {
    for (const s of setlistsData.data) {
      if (s.tour) {
        const existing = setlistsByTour.get(s.tour) || [];
        existing.push(s);
        setlistsByTour.set(s.tour, existing);
      }
    }
  }

  return toursData.data
    .filter((t: any) => t.slug)
    .map((t: any) => {
      const album = t.associated_album ? albumMap.get(t.associated_album) : null;
      const tourSetlists = (setlistsByTour.get(t.id) || [])
        .sort((a: any, b: any) => new Date(a.date).getTime() - new Date(b.date).getTime())
        .map((s: any) => ({
          slug: s.slug,
          date: s.date,
          formattedDate: s.date ? new Date(s.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) : 'Unknown',
          venue: s.venue || 'Unknown Venue',
          city: s.city || '',
          country: s.country || '',
          countryCode: s.country_code,
          songCount: s.song_count || 0,
        }));

      // Count unique countries from setlists
      const countryCodes = [...new Set(tourSetlists.map((s: any) => s.countryCode).filter(Boolean))];

      return {
        params: { slug: t.slug },
        props: {
          tour: {
            id: t.id,
            name: t.name,
            slug: t.slug,
            startDate: t.start_date,
            endDate: t.end_date,
            description: t.description,
            associatedAlbumId: t.associated_album,
            associatedAlbumTitle: album?.title,
            associatedAlbumSlug: album?.slug,
            associatedAlbumCover: album?.cover_art ? `https://dash.cureation.net/assets/${album.cover_art}` : undefined,
            totalShows: t.total_shows || tourSetlists.length,
            countriesVisited: t.countries_visited || countryCodes,
            supportActs: t.support_acts || [],
            lineup: t.lineup || [],
          },
          setlists: tourSetlists,
        }
      };
    });
}

const { tour, setlists } = Astro.props as { tour: TourData; setlists: TourSetlist[] };
const todayIso = new Date().toISOString().split('T')[0];

function formatTourDate(dateStr?: string): string {
  if (!dateStr) return 'Unknown';
  return new Date(dateStr).toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
}

const uniqueCountries = [...new Set(setlists.map(s => s.countryCode).filter(Boolean))];
const uniqueCities = [...new Set(setlists.map(s => s.city).filter(Boolean))];
const totalSongs = setlists.reduce((sum, s) => sum + s.songCount, 0);
---

<MainLayout
  title={`${tour.name} - Tour`}
  description={`The Cure's ${tour.name}. ${tour.totalShows} shows across ${uniqueCountries.length} countries.`}
  showSidebar={false}
  pageClass="bg-black"
  albumImage={tour.associatedAlbumCover}
>
  <!-- Breadcrumb -->
  <nav class="mb-8" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-white/85">
      <li><a href="/setlists" class="hover:text-white transition-colors">Setlists</a></li>
      <li aria-hidden="true">/</li>
      <li><span class="text-white/80">Tours</span></li>
      <li aria-hidden="true">/</li>
      <li class="text-white truncate max-w-[200px]">{tour.name}</li>
    </ol>
  </nav>

  <!-- Tour Header -->
  <section class="mb-12">
    <div class="glass-panel overflow-hidden relative">
      <div class="absolute -top-20 -left-20 w-64 h-64 rounded-full bg-white/[0.06] blur-3xl pointer-events-none"></div>

      <div class="relative p-8 md:p-12">
        <!-- Associated album badge -->
        {tour.associatedAlbumTitle && (
          <div class="inline-flex items-center gap-3 mb-4">
            {tour.associatedAlbumCover && (
              <img src={tour.associatedAlbumCover} alt={tour.associatedAlbumTitle} class="w-10 h-10 rounded object-cover" />
            )}
            <a href={`/discography/${tour.associatedAlbumSlug}`} class="badge bg-white/10 text-primary border-primary/40 hover:bg-primary/30 transition-colors">
              {tour.associatedAlbumTitle} era
            </a>
          </div>
        )}

        <h1 class="font-display text-5xl md:text-6xl lg:text-7xl text-white mb-4 text-glow">
          {tour.name}
        </h1>

        <div class="flex flex-wrap items-center gap-4 text-white/90 mb-6">
          {tour.startDate && (
            <div class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                <line x1="16" x2="16" y1="2" y2="6"></line>
                <line x1="8" x2="8" y1="2" y2="6"></line>
                <line x1="3" x2="21" y1="10" y2="10"></line>
              </svg>
              <span>{formatTourDate(tour.startDate)} — {formatTourDate(tour.endDate)}</span>
            </div>
          )}
        </div>

        <!-- Stats row -->
        <div class="flex flex-wrap gap-8 pt-6 border-t border-white/8">
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-white text-glow">{setlists.length || tour.totalShows}</span>
            <span class="text-white/85 text-base font-medium">Shows</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-white text-glow">{uniqueCountries.length}</span>
            <span class="text-white/85 text-base font-medium">Countries</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-white text-glow">{uniqueCities.length}</span>
            <span class="text-white/85 text-base font-medium">Cities</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-white text-glow">{totalSongs.toLocaleString()}</span>
            <span class="text-white/85 text-base font-medium">Performances</span>
          </div>
        </div>

        <!-- Countries visited with flags -->
        {uniqueCountries.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-6 pt-6 border-t border-white/8">
            {uniqueCountries.map(code => (
              <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-sm">
                <span class="text-base">{countryCodeToFlag[code as string] || ''}</span>
                <span class="text-white/90">{code}</span>
              </span>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Lineup -->
  {tour.lineup && tour.lineup.length > 0 && (
    <section class="mb-12">
      <div class="glass-card rounded-2xl p-6 md:p-8 border border-white/20">
        <h2 class="font-heading text-2xl text-primary mb-4">Lineup</h2>
        <div class="flex flex-wrap gap-3">
          {tour.lineup.map(member => (
            <span class="px-4 py-2 rounded-lg bg-white/5 border border-white/10 text-white/80">{member}</span>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Support Acts -->
  {tour.supportActs && tour.supportActs.length > 0 && (
    <section class="mb-12">
      <div class="glass-card rounded-2xl p-6 md:p-8 border border-white/20">
        <h2 class="font-heading text-2xl text-primary mb-4">Support Acts</h2>
        <div class="flex flex-wrap gap-3">
          {tour.supportActs.map(act => (
            <span class="px-4 py-2 rounded-lg bg-white/5 border border-white/10 text-white/80">{act}</span>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- All shows on this tour -->
  <section class="mb-12">
    <h2 class="font-heading text-2xl text-primary mb-6">
      All Shows
      <span class="text-white/80 text-lg ml-2">({setlists.length})</span>
    </h2>

    {setlists.length > 0 ? (
      <div class="space-y-2">
        {setlists.map((show, index) => (
          <a
            href={`/setlists/${show.slug}`}
            class="flex items-center justify-between p-4 glass-card rounded-xl border border-white/10 hover:border-white/20/40 transition-all group"
          >
            <div class="flex items-center gap-4">
              <div class="text-white/75 text-sm font-mono min-w-[24px] text-right">{index + 1}</div>
              <div class="text-center min-w-[50px]">
                <div class="text-xl font-display text-white">{new Date(show.date).getDate()}</div>
                <div class="text-white/80 text-[10px] uppercase">{new Date(show.date).toLocaleDateString('en-US', { month: 'short' })}</div>
              </div>
              <div>
                <div class="text-white group-hover:text-white transition-colors flex items-center gap-2">
                  {show.countryCode && countryCodeToFlag[show.countryCode] && (
                    <span>{countryCodeToFlag[show.countryCode]}</span>
                  )}
                  {show.venue}
                </div>
                <div class="text-white/80 text-sm">{show.city}, {show.country}</div>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <span class="text-white/80 text-sm hidden sm:inline">{show.date > todayIso && show.songCount === 0 ? 'Setlist pending' : `${show.songCount} songs`}</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-primary opacity-80 group-hover:opacity-100 transition-opacity" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m9 18 6-6-6-6"></path>
              </svg>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="glass-card rounded-2xl p-8 text-center">
        <p class="text-white/85">No setlists linked to this tour yet. Check the <a href="/setlists" class="text-primary hover:underline">setlists page</a> for more.</p>
      </div>
    )}
  </section>

  <!-- Back -->
  <div class="text-center">
    <a href="/setlists" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-white/10 border border-primary/40 text-white hover:bg-primary/30 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m15 18-6-6 6-6"></path>
      </svg>
      Back to Setlists
    </a>
  </div>
</MainLayout>
