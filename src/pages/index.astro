<script>
  function wireCountdown() {
    const nodes = document.querySelectorAll<HTMLElement>('[data-countdown]');
    nodes.forEach((n) => {
      const target = new Date(n.getAttribute('data-countdown') || '').getTime();
      if (!target) return;
      const tick = () => {
        const ms = target - Date.now();
        if (ms <= 0) { n.querySelectorAll('[data-cd]').forEach(e => e.textContent = '0'); return; }
        const d = Math.floor(ms / 86400000);
        const h = Math.floor((ms % 86400000) / 3600000);
        const m = Math.floor((ms % 3600000) / 60000);
        const s = Math.floor((ms % 60000) / 1000);
        const set = (k: string, v: number) => { const el = n.querySelector(`[data-cd="${k}"]`); if (el) el.textContent = String(v).padStart(2, '0'); };
        set('d', d); set('h', h); set('m', m); set('s', s);
      };
      tick();
      const id = setInterval(tick, 1000);
      document.addEventListener('astro:before-swap', () => clearInterval(id), { once: true });
    });
  }
  wireCountdown();
  document.addEventListener('astro:page-load', wireCountdown);
</script>
