---
import Layout from '../layouts/Layout.astro';
import BarChart from '../components/ui/BarChart.astro';
import IssueSection from '../components/ui/IssueSection.astro';
import PullQuote from '../components/ui/PullQuote.astro';
import Tag from '../components/ui/Tag.astro';
import Button from '../components/ui/Button.astro';
import {
  getAlbumOfMonth,
  listAlbums,
  listEras,
  topLivePlayedSongs,
  getRunningFigures,
  getOnThisDay,
  listNews,
  listEditorial,
  listQuotes,
  getSongOfDay,
  getLyricOfDay,
  getPhotoOfDay,
  getNextConcert,
  getLatestConcert,
  fetchRaw,
} from '../lib/directus';
import { asset } from '../lib/assets';

const [issue, albums, eras, topSongs, figures, otd, news, editorial, quotes, songOfDay, lyricOfDay, photoOfDay, nextConcert, latestConcert] = await Promise.all([
  getAlbumOfMonth(),
  listAlbums({ type: 'studio' }),
  listEras(),
  topLivePlayedSongs(10).catch(() => []),
  getRunningFigures(),
  getOnThisDay(),
  listNews(7),
  listEditorial(1),
  listQuotes(4),
  getSongOfDay().catch(() => null),
  getLyricOfDay().catch(() => null),
  getPhotoOfDay().catch(() => null),
  getNextConcert().catch(() => null),
  getLatestConcert().catch(() => null),
]);

const songAlbum = songOfDay?.album ? albums.find((a) => a.id === songOfDay.album) : null;

const now = new Date();
const today = now.toLocaleDateString(undefined, { month: 'long', day: 'numeric', year: 'numeric' });
const todayShort = now.toLocaleDateString(undefined, { month: 'long', day: 'numeric' });
const mastYear = now.getFullYear();
const toRoman = (n: number): string => {
  const map: Array<[number, string]> = [[1000,'M'],[900,'CM'],[500,'D'],[400,'CD'],[100,'C'],[90,'XC'],[50,'L'],[40,'XL'],[10,'X'],[9,'IX'],[5,'V'],[4,'IV'],[1,'I']];
  let out = '', r = n;
  for (const [v, s] of map) { while (r >= v) { out += s; r -= v; } }
  return out;
};
const volume = toRoman(Math.max(1, mastYear - 2018));
const issueNumber = Math.floor((Date.now() - Date.UTC(mastYear, 0, 0)) / 86400000);
const monthName = now.toLocaleDateString(undefined, { month: 'long' }).toUpperCase();

const issueYear = issue?.release_date?.slice(0, 4);
const issueEra = issue && eras.find((e) => e.id === issue.era_id);
const issueFirstSentence = issue?.critical_reception
  ? issue.critical_reception.split(/(?<=[\.\!\?])\s/)[0]?.trim().replace(/^["""]|["""]$/g, '')
  : null;
const issueFacts = issue ? [
  ['Released', issue.release_date || '—'],
  ['Label', issue.label || '—'],
  ['Era', issueEra?.name || '—'],
  ['Type', (issue.type || '—').toString().toUpperCase()],
] : [];

const concert = nextConcert || latestConcert;
const concertIsFuture = !!nextConcert;
const concertTarget = concert?.date ? new Date(concert.date).toISOString() : null;

const mm = String(now.getMonth() + 1).padStart(2, '0');
const monthSetlists = await fetchRaw('setlists', {
  fields: 'id,slug,date,venue,city,country,tour_name',
  'filter[date][_contains]': `-${mm}-`,
  sort: 'date',
  limit: 400,
}).catch(() => []);
const anniversariesShows = (monthSetlists as any[])
  .map((s) => ({ ...s, yearsAgo: mastYear - Number((s.date || '').slice(0, 4) || 0) }))
  .filter((s) => s.yearsAgo >= 1 && (s.yearsAgo % 5 === 0 || s.yearsAgo % 10 === 0))
  .sort((a, b) => b.yearsAgo - a.yearsAgo)
  .slice(0, 6);

const anniversariesAlbums = albums
  .filter((a: any) => a.release_date && a.release_date.slice(5, 7) === mm)
  .map((a: any) => ({ ...a, yearsAgo: mastYear - Number(a.release_date.slice(0, 4)) }))
  .sort((a: any, b: any) => b.yearsAgo - a.yearsAgo)
  .slice(0, 8);

// "By the numbers, today" — derived live counters for the right-hand column.
const mostPlayed = topSongs[0] || null;

const studiosByDate = [...albums]
  .filter((a) => a.release_date)
  .sort((a, b) => (a.release_date || '').localeCompare(b.release_date || ''));
let longestGap: { a: typeof studiosByDate[number]; b: typeof studiosByDate[number]; days: number } | null = null;
for (let i = 1; i < studiosByDate.length; i++) {
  const prev = studiosByDate[i - 1];
  const curr = studiosByDate[i];
  const days = Math.round(
    (new Date(curr.release_date!).getTime() - new Date(prev.release_date!).getTime()) / 86400000
  );
  if (!longestGap || days > longestGap.days) longestGap = { a: prev, b: curr, days };
}
const gapYears = longestGap ? Math.round(longestGap.days / 365) : null;

const newestAlbum = studiosByDate[studiosByDate.length - 1] || null;

const rarestPlayed = topSongs
  .filter((s: any) => typeof s.times_played_live === 'number' && s.times_played_live > 0)
  .sort((a: any, b: any) => (a.times_played_live || 0) - (b.times_played_live || 0))[0] || null;
const rarestPlayedAlbum = rarestPlayed?.album ? albums.find((a) => a.id === rarestPlayed.album) : null;

type Counter = { k: string; v: string; sub: string; href?: string | null };
const counters: Counter[] = [];
if (mostPlayed) counters.push({
  k: 'Most-played song',
  v: mostPlayed.title,
  sub: `${(mostPlayed.times_played_live || 0).toLocaleString()} performances`,
  href: mostPlayed.slug ? `/songs/${mostPlayed.slug}` : null,
});
if (newestAlbum) counters.push({
  k: 'Newest studio record',
  v: newestAlbum.title,
  sub: newestAlbum.release_date?.slice(0, 4) || '',
  href: newestAlbum.slug ? `/discography/${newestAlbum.slug}` : null,
});
if (longestGap && gapYears && gapYears > 0) counters.push({
  k: 'Longest gap between releases',
  v: `${gapYears} year${gapYears === 1 ? '' : 's'}`,
  sub: `${longestGap.a.title} → ${longestGap.b.title}`,
});
if (rarestPlayed) counters.push({
  k: 'Rarest in rotation',
  v: rarestPlayed.title,
  sub: `${(rarestPlayed.times_played_live || 0).toLocaleString()} plays on file${rarestPlayedAlbum ? ` · ${rarestPlayedAlbum.title}` : ''}`,
  href: rarestPlayed.slug ? `/songs/${rarestPlayed.slug}` : null,
});

// "Running figures" cells — derive from counts with editorial sub-captions.
const firstReleaseYear = studiosByDate[0]?.release_date?.slice(0, 4);
type FigureCell = { v: string | number; lb: string; sub?: string | null };
const figureCells: FigureCell[] = [
  { v: figures.setlists, lb: 'Shows indexed', sub: firstReleaseYear ? `since ${firstReleaseYear}` : null },
  { v: figures.songs,    lb: 'Distinct songs', sub: `${figures.albums} studio albums` },
  { v: figures.venues,   lb: 'Rooms played', sub: null },
  { v: figures.photos,   lb: 'Photos on file', sub: `${figures.members} members catalogued` },
];
---
<Layout title="Cureation · An editorial archive of The Cure">

  <section class="masthead">
    <div class="container">
      <div class="masthead-rule">
        <span>Vol. {volume} · №{issueNumber}</span>
        <span>{today}</span>
      </div>
      <h1 class="masthead-wordmark">Cureation</h1>
      <div class="masthead-rule">
        <span class="hide-mobile">An editorial archive of The Cure</span>
        <span>Preserved with care · since 2019</span>
      </div>
    </div>
  </section>

  {concert && concertTarget && (
    <section class="container" style="padding: clamp(24px, 4vw, 48px) 0; border-bottom: 1px solid var(--rule);">
      <div class="panel-head" style="border: 1px solid var(--accent); border-bottom-color: var(--accent);">
        <span><span class="pip"></span>{concertIsFuture ? 'Next concert' : 'Most recent concert'}</span>
        <span>{concert.city || ''}{concert.country ? ` · ${concert.country}` : ''}</span>
      </div>
      <div class="panel" style="border: 1px solid var(--accent); border-top: 0; padding: clamp(20px, 3vw, 36px); background: var(--bg-2);">
        <div class="concert-head">
          <div>
            <div class="mono-sm muted">{concert.tour_name || 'Live'}</div>
            <h3 class="serif" style="font-size: clamp(28px, 4.4vw, 56px); line-height: 1.02; margin: .4rem 0; font-style: italic;">
              {concert.venue_link ? (
                <a href={`/setlists/${concert.slug}`} style="border:none;">{concert.venue || 'TBA'}</a>
              ) : concert.venue || 'TBA'}
            </h3>
            <div class="mono-sm muted">
              {concert.date} · {[concert.city, concert.state_province, concert.country].filter(Boolean).join(', ')}
            </div>
          </div>
          {concertIsFuture && (
            <div class="countdown" data-countdown={concertTarget}>
              <div class="countdown__cell"><div class="countdown__value" data-cd="d">—</div><div class="countdown__label">Days</div></div>
              <div class="countdown__cell"><div class="countdown__value" data-cd="h">—</div><div class="countdown__label">Hours</div></div>
              <div class="countdown__cell"><div class="countdown__value" data-cd="m">—</div><div class="countdown__label">Minutes</div></div>
              <div class="countdown__cell"><div class="countdown__value" data-cd="s">—</div><div class="countdown__label">Seconds</div></div>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  {issue && (
    <section class="container issue">
      <div class="issue__grid">
        <figure class="cover-plate" style={`view-transition-name: album-${issue.slug}`}>
          <div class="cover-plate__corner cover-plate__corner--tl">
            <span class="mono-sm muted">{monthName} · RECORD OF THE MONTH</span>
          </div>
          <div class="cover-plate__corner cover-plate__corner--tr">
            <span class="mono-sm muted">FIX · {issue.catalog_number || '—'}</span>
          </div>
          {issue.cover_art ? (
            <a href={`/discography/${issue.slug}`}>
              <img src={asset(issue.cover_art, 'card')} alt={`${issue.title} cover`} />
            </a>
          ) : (
            <div class="placeholder">No cover</div>
          )}
          <div class="cover-plate__corner cover-plate__corner--bl">
            <span class="mono-sm muted">{issue.label ? issue.label.split(/[\/]/)[0].trim().toUpperCase() : '—'}</span>
          </div>
        </figure>

        <div class="issue__body stack" style="--gap: 1rem;">
          <div class="cluster" style="gap:.4rem;">
            <Tag>ALBUM OF THE MONTH</Tag>
            {issueEra?.short_name && <Tag>{issueEra.short_name.toUpperCase()}</Tag>}
            <span class="tag tag--gold">CRITIC'S PICK</span>
          </div>
          <h2 class="issue__title serif" style={`view-transition-name: album-title-${issue.slug}`}>
            {issue.title}
          </h2>
          <div class="mono-sm muted">
            {issueYear} · {issue.label || 'Fiction'} · {(issue.type || '').toUpperCase()}
          </div>
          {issue.description && <p class="issue__lede">{issue.description}</p>}
          {issueFirstSentence && (
            <div class="voices">
              <div class="mono-sm muted" style="margin-bottom:.3rem;">CRITICAL VOICES</div>
              <div class="voices__quote">"{issueFirstSentence}"</div>
            </div>
          )}
          <div class="facts">
            {issueFacts.map(([k, v]) => (
              <div class="facts__item">
                <div class="facts__k">{k}</div>
                <div class="facts__v">{v}</div>
              </div>
            ))}
          </div>
          <div class="cluster" style="gap:.6rem;">
            <Button href={`/discography/${issue.slug}`} variant="accent">Read the dossier →</Button>
            {issue.spotify_url && <Button href={issue.spotify_url} variant="ghost" target="_blank" rel="noopener">Listen</Button>}
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="container figures">
    <div class="figures__head">
      <div class="issue-label">The archive, measured</div>
      <div class="mono-sm muted">Updated live</div>
    </div>
    <div class="figures__grid">
      {figureCells.map((c) => (
        <div class="figures__cell">
          <div class="figures__val">{typeof c.v === 'number' ? c.v.toLocaleString() : c.v}</div>
          <div class="figures__lb">{c.lb}</div>
          {c.sub && <div class="figures__sub mono-sm">{c.sub}</div>}
        </div>
      ))}
    </div>
  </section>

  {(otd.length > 0 || counters.length > 0) && (
    <section class="issue-section container otd-wrap">
      <div class="otd-wrap__grid">
        <div class="otd-col">
          <div class="issue-label">On this day · {todayShort}</div>
          <h2 class="issue-hed">
            <em>{otd.length || 'No'} entr{otd.length === 1 ? 'y' : 'ies'}, across the archive.</em>
          </h2>
          {otd.length > 0 && (
            <ol class="otd__list">
              {otd.slice(0, 5).map((e: any) => {
                const href = e.link_collection && e.link_slug ? `/${e.link_collection}/${e.link_slug}` : null;
                const Inner = (
                  <>
                    <div class="otd__year mono">{e.year}</div>
                    <div class="otd__kind"><span class="tag">{(e.kind || 'entry').toUpperCase()}</span></div>
                    <div class="otd__body">
                      <div class="serif otd__title">{e.title}</div>
                      {e.subtitle && <div class="otd__sub">{e.subtitle}</div>}
                    </div>
                  </>
                );
                return (
                  <li class="otd__row">
                    {href ? <a href={href}>{Inner}</a> : <div>{Inner}</div>}
                  </li>
                );
              })}
            </ol>
          )}
        </div>

        {counters.length > 0 && (
          <aside class="otd-col">
            <div class="issue-label">By the numbers, today</div>
            <div class="counters">
              <div class="counters__head">
                <span class="mono"><span class="pip"></span>Live counters</span>
                <span class="mono muted">{today}</span>
              </div>
              <ul class="counters__list">
                {counters.map((c) => {
                  const inner = (
                    <>
                      <div class="counters__row-main">
                        <div class="mono-sm muted counters__k">{c.k}</div>
                        <div class="serif counters__v">{c.v}</div>
                      </div>
                      <div class="mono counters__sub">{c.sub}</div>
                    </>
                  );
                  return (
                    <li class="counters__row">
                      {c.href ? <a href={c.href}>{inner}</a> : <div>{inner}</div>}
                    </li>
                  );
                })}
              </ul>
            </div>
            <a class="btn btn--ghost counters__cta" href="/stats">Enter the figures →</a>
          </aside>
        )}
      </div>
    </section>
  )}

  {(lyricOfDay || photoOfDay || songOfDay) && (
    <section class="issue-section container daily">
      <div class="daily__head">
        <div class="issue-label">Today's pages</div>
        <div class="mono-sm muted">{today}</div>
      </div>
      <div class="daily__grid">
        {photoOfDay && (
          <a class="daily__photo" href={photoOfDay.album_slug ? `/discography/${photoOfDay.album_slug}` : '#'}>
            <img src={photoOfDay.image_file ? asset(photoOfDay.image_file, 'hero') : photoOfDay.image_url} alt={photoOfDay.title || 'Photo of the day'} />
            <div class="daily__photo-over">
              <div class="mono-sm daily__photo-kind">Photo of the day</div>
              <div class="serif daily__photo-title">{photoOfDay.title || 'Untitled'}</div>
              <div class="mono-sm daily__photo-meta">
                {[photoOfDay.formatted_date || photoOfDay.date_taken, photoOfDay.location, photoOfDay.photographer].filter(Boolean).join(' · ').toUpperCase()}
              </div>
            </div>
          </a>
        )}
        <div class="daily__words">
          {lyricOfDay && (
            <a class="daily__lyric" href={lyricOfDay.song.slug ? `/songs/${lyricOfDay.song.slug}` : '#'}>
              <div class="mono-sm muted">Lyric of the day</div>
              <blockquote class="daily__lyric-body">
                <span class="daily__lyric-mark">&ldquo;</span>{lyricOfDay.line}<span class="daily__lyric-mark">&rdquo;</span>
              </blockquote>
              <div class="mono-sm muted">— {lyricOfDay.song.title}{songAlbum ? `, ${songAlbum.title}` : ''}</div>
            </a>
          )}
          {songOfDay && (
            <a class="daily__song" href={songOfDay.slug ? `/songs/${songOfDay.slug}` : '#'}>
              {songAlbum?.cover_art ? (
                <img src={asset(songAlbum.cover_art, 'card')} alt={songAlbum.title} />
              ) : <div class="placeholder daily__song-ph">—</div>}
              <div class="daily__song-meta">
                <div class="mono-sm muted">Song of the day</div>
                <div class="serif daily__song-title">{songOfDay.title}</div>
                <div class="mono-sm muted">{songAlbum ? songAlbum.title.toUpperCase() : ''}</div>
              </div>
              {songOfDay.times_played_live ? (
                <div class="daily__song-count">
                  <div class="serif daily__song-n">{songOfDay.times_played_live.toLocaleString()}</div>
                  <div class="mono-sm muted">plays live</div>
                </div>
              ) : null}
            </a>
          )}
        </div>
      </div>
    </section>
  )}

  {(anniversariesAlbums.length > 0 || anniversariesShows.length > 0) && (
    <IssueSection kicker={`This month · ${monthName}`} title="Anniversaries" meta="Records & shows, this month in Cure history">
      <div class="anniv">
        {anniversariesAlbums.length > 0 && (
          <div class="anniv__col">
            <div class="mono-sm muted" style="margin-bottom:.6rem;">Records released</div>
            <ul class="anniv__list">
              {anniversariesAlbums.map((a: any) => (
                <li>
                  <a href={`/discography/${a.slug}`}>
                    {a.cover_art && <img src={asset(a.cover_art, 'thumb')} alt={a.title} />}
                    <div>
                      <div class="serif anniv__t">{a.title}</div>
                      <div class="mono-sm muted">{a.release_date?.slice(0, 10)} · {a.yearsAgo} year{a.yearsAgo === 1 ? '' : 's'} ago</div>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
        {anniversariesShows.length > 0 && (
          <div class="anniv__col">
            <div class="mono-sm muted" style="margin-bottom:.6rem;">Shows, milestone years</div>
            <ul class="anniv__list">
              {anniversariesShows.map((s: any) => (
                <li>
                  <a href={`/setlists/${s.slug}`}>
                    <div class="anniv__badge mono-sm">{s.yearsAgo}y</div>
                    <div>
                      <div class="serif anniv__t">{s.venue || s.city || '—'}</div>
                      <div class="mono-sm muted">{s.date} · {[s.city, s.country].filter(Boolean).join(', ')}{s.tour_name ? ` · ${s.tour_name}` : ''}</div>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </IssueSection>
  )}

  {topSongs.length > 0 && (
    <IssueSection kicker="A taxonomy of the setlist" title="Ten songs, a thousand nights" href="/stats/songs" meta="All-time frequency">
      <BarChart
        bars={topSongs.slice(0, 10).map((s: any) => {
          const a = albums.find(al => al.id === s.album);
          return {
            label: s.title,
            sub: a?.title || '',
            value: s.times_played_live || 0,
            href: s.slug ? `/songs/${s.slug}` : undefined,
          };
        })}
        unit="plays"
      />
    </IssueSection>
  )}

  <IssueSection kicker="The records" title="The discography" href="/discography" meta={`${albums.length} studio albums`}>
    <div class="cover-wall">
      {albums.map((a) => (
        <a href={`/discography/${a.slug}`} class="cover-wall__cell" style={`view-transition-name: album-${a.slug};`}>
          {a.cover_art ? <img src={asset(a.cover_art, 'card')} alt={a.title} /> : <div class="placeholder">No cover</div>}
          <div class="cover-wall__cap">{a.title} · {a.release_date?.slice(0,4)}</div>
        </a>
      ))}
    </div>
  </IssueSection>

  {editorial[0] && (() => {
    const e = editorial[0];
    const href = e.slug ? `/news/${e.slug}` : '/news';
    // Strip HTML to plain paragraphs — take the first 2 for the home page excerpt.
    const stripTags = (s: string) => s.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
    const raw = e.excerpt || (e.content ? stripTags(e.content) : '') || e.subtitle || '';
    const paraSplit = new RegExp('\\n\\n+|(?<=\\.)\\s\\s+');
    const paragraphs = raw
      .split(paraSplit)
      .map(stripTags)
      .filter(Boolean)
      .slice(0, 2);
    const firstPara = paragraphs[0] || '';
    const firstChar = firstPara.charAt(0);
    const restFirst = firstPara.slice(1);
    const tags = Array.isArray(e.tags) ? e.tags : [];
    const filedUnder = tags.length ? tags.slice(0, 6).join(' · ') : (e.category ? e.category.toUpperCase() : null);
    const essayNum = String(e.id).padStart(3, '0');
    return (
      <section class="issue-section container essay">
        <div class="essay__grid">
          <aside class="essay__meta">
            <div class="issue-label">Essay № {essayNum}</div>
            <div class="mono-sm muted">{e.author_name ? `By ${e.author_name}` : 'By the archive editors'}</div>
            <div class="mono-sm muted">
              {e.reading_time ? `${e.reading_time} min` : '—'}
              {(e.published_date || e.date_created) && ` · ${(e.published_date || e.date_created).slice(0, 10)}`}
            </div>
            {filedUnder && (
              <div class="essay__filed">
                <div class="mono-sm muted">Filed under</div>
                <div class="essay__filed-body">{filedUnder}</div>
              </div>
            )}
          </aside>
          <div class="essay__body">
            <h2 class="essay__head serif">{e.title || 'From the editor'}</h2>
            {firstPara && (
              <p class="essay__p">
                <span class="essay__drop">{firstChar}</span>{restFirst}
              </p>
            )}
            {paragraphs[1] && <p class="essay__p">{paragraphs[1]}</p>}
            <a class="btn btn--ghost essay__cta" href={href}>Continue reading →</a>
          </div>
        </div>
      </section>
    );
  })()}

  {quotes.length > 0 && (
    <IssueSection kicker="In their words" title="Epigraphs">
      <div class="quotes-grid">
        {quotes.map((q: any) => (
          <PullQuote cite={q.attribution || q.source || undefined}>{q.text}</PullQuote>
        ))}
      </div>
    </IssueSection>
  )}

  {eras.length > 0 && (
    <IssueSection kicker={`${eras.length} eras`} title="A catalog, divided." href="/band/history">
      <div class="era-cards">
        {eras.map((e: any) => {
          const hue = typeof e.hue === 'number' ? e.hue : 320;
          const range = e.year_end && e.year_end < 2099 ? `${e.year_start}–${e.year_end}` : `${e.year_start}–present`;
          return (
            <a class="era-card" href={`/band/history#${e.slug}`}>
              <span class="era-card__dot" style={`background: oklch(0.6 0.15 ${hue});`}></span>
              <div class="serif era-card__title">{e.name}</div>
              <div class="mono-sm muted era-card__range">{range}</div>
              {e.description && <p class="era-card__body">{e.description}</p>}
              <div class="mono-sm era-card__cue">
                <span>Read →</span>
              </div>
            </a>
          );
        })}
      </div>
    </IssueSection>
  )}

  {news.length > 0 && (
    <section class="issue-section container dispatches">
      <div class="dispatches__head">
        <div class="issue-label">Dispatches from the archive</div>
        <a class="mono-sm dispatches__all" href="/news">All {news.length} dispatches →</a>
      </div>
      <div class="dispatches__grid">
        {news.slice(0, 6).map((n: any) => (
