<script>
  function wireCountdown() {
    document.querySelectorAll<HTMLElement>('[data-countdown]').forEach((node) => {
      const target = new Date(node.dataset.countdown || '').getTime();
      if (!target || node.dataset.wired) return;
      node.dataset.wired = 'true';
      const tick = () => {
        const remaining = Math.max(0, target - Date.now());
        const values = {
          d: Math.floor(remaining / 86400000),
          h: Math.floor((remaining % 86400000) / 3600000),
          m: Math.floor((remaining % 3600000) / 60000),
        };
        Object.entries(values).forEach(([key, value]) => {
          const element = node.querySelector(`[data-cd="${key}"]`);
          if (element) element.textContent = String(value).padStart(2, '0');
        });
      };
      tick();
      const interval = window.setInterval(tick, 30000);
      document.addEventListener('astro:before-swap', () => window.clearInterval(interval), { once: true });
    });
  }
  wireCountdown();
  document.addEventListener('astro:page-load', () => {
      wireCountdown();
  });
</script>
