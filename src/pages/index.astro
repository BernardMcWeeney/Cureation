---
import Layout from '../layouts/Layout.astro';
import {
  getAlbumOfMonth,
  listAlbums,
  getRunningFigures,
  getOnThisDay,
  listNews,
  getSongOfDay,
  getPhotoOfDay,
  getNextConcert,
  fetchRaw,
} from '../lib/directus';
import { asset } from '../lib/assets';

export const prerender = false;

Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=300, s-maxage=3600, stale-while-revalidate=86400'
);

const emptyFigures = { albums: 0, songs: 0, setlists: 0, venues: 0, photos: 0, members: 0 };
const [albumOfMonth, releases, figures, otd, journal, songOfDay, photoOfDay, nextConcert, singles] = await Promise.all([
  getAlbumOfMonth().catch(() => null),
  listAlbums().catch(() => []),
  getRunningFigures().catch(() => emptyFigures),
  getOnThisDay().catch(() => []),
  listNews(24).catch(() => []),
  getSongOfDay().catch(() => null),
  getPhotoOfDay().catch(() => null),
  getNextConcert().catch(() => null),
  fetchRaw('singles', {
    limit: -1,
    fields: 'id,title,release_date,album,chart_position',
    sort: 'release_date',
  }).catch(() => []),
]);

const now = new Date();
const year = now.getFullYear();
const month = String(now.getMonth() + 1).padStart(2, '0');
const monthName = now.toLocaleDateString('en-GB', { month: 'long' });
const today = now.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const todayShort = now.toLocaleDateString('en-GB', { day: 'numeric', month: 'long' });
const formatDate = (value?: string | null, includeYear = true) => value
  ? new Date(`${value.slice(0, 10)}T12:00:00`).toLocaleDateString('en-GB', includeYear
    ? { day: 'numeric', month: 'long', year: 'numeric' }
    : { day: 'numeric', month: 'long' })
  : '';
const stripHtml = (value = '') => value.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();

const studioAlbums = releases.filter((release: any) => release.type === 'studio');
const releaseById = new Map(releases.map((release: any) => [Number(release.id), release]));
const songAlbumId = typeof songOfDay?.album === 'object' ? (songOfDay.album as any)?.id : songOfDay?.album;
const songAlbum: any = songAlbumId ? releaseById.get(Number(songAlbumId)) : null;

const editorialCategories = new Set(['blog', 'editorial', 'editorials', 'feature', 'features', 'interview', 'interviews', 'review', 'reviews']);
const featureStory: any = journal.find((story: any) => String(story.category || '').toLowerCase() === 'blog' && Boolean(story.featured))
  || journal.find((story: any) => String(story.category || '').toLowerCase() === 'blog')
  || journal.find((story: any) => Boolean(story.is_editorial) && String(story.category || '').toLowerCase() !== 'wiki')
  || journal.find((story: any) => editorialCategories.has(String(story.category || '').toLowerCase()))
  || journal.find((story: any) => Boolean(story.featured))
  || journal[0]
  || null;
const latestNews: any = journal.find((story: any) => String(story.category || '').toLowerCase() === 'news') || journal[0] || null;
const featureExcerpt = featureStory ? stripHtml(featureStory.excerpt || '').slice(0, 330) : '';
const featureImage = featureStory?.featured_image_file
  ? asset(featureStory.featured_image_file, 'hero')
  : (typeof featureStory?.featured_image === 'string' && featureStory.featured_image.startsWith('http')
    ? featureStory.featured_image
    : '/thecure-troxyimage.jpg');

const lyricLines: string[] = [];
const structuredLyrics = songOfDay?.lyrics_structured;
if (Array.isArray(structuredLyrics)) {
  for (const section of structuredLyrics) {
    if (Array.isArray(section?.lines)) {
      for (const line of section.lines) if (line?.text) lyricLines.push(String(line.text));
    }
  }
}
if (!lyricLines.length && songOfDay?.lyrics) {
  lyricLines.push(...String(songOfDay.lyrics).split(/\n+/).map((line) => line.trim()).filter(Boolean));
}
const dayStart = Date.UTC(now.getUTCFullYear(), 0, 0);
const dayNumber = Math.floor((Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()) - dayStart) / 86400000);
const toRoman = (value: number) => {
  const numerals: Array<[number, string]> = [
    [1000, 'M'], [900, 'CM'], [500, 'D'], [400, 'CD'], [100, 'C'], [90, 'XC'],
    [50, 'L'], [40, 'XL'], [10, 'X'], [9, 'IX'], [5, 'V'], [4, 'IV'], [1, 'I'],
  ];
  let remaining = Math.max(1, Math.floor(value));
  let result = '';
  for (const [amount, numeral] of numerals) {
    while (remaining >= amount) {
      result += numeral;
      remaining -= amount;
    }
  }
  return result;
};
const publishedRomanDate = [now.getDate(), now.getMonth() + 1, year].map(toRoman).join('.');
const dailyRomanVersion = `${toRoman(year)}.${toRoman(dayNumber)}`;
const publicationMark = `PUBLISHED · ${publishedRomanDate} · VERSION ${dailyRomanVersion}`;
const lyricLine = lyricLines.length ? lyricLines[dayNumber % lyricLines.length] : null;
const songArtwork = songAlbum?.cover_art ? asset(songAlbum.cover_art, 'hero') : '/images/albums/disintegration.jpg';
const songArtworkStyle = `--song-artwork: url("${songArtwork.replace(/"/g, '%22')}")`;

const concertHref = nextConcert?.slug ? `/setlists/${nextConcert.slug}` : '/tours/2026-european-summer-shows';
const concertTarget = nextConcert?.date ? new Date(`${nextConcert.date.slice(0, 10)}T12:00:00`).toISOString() : null;
const concertImage = nextConcert?.hero_image || nextConcert?.venue_image
  ? asset(nextConcert.hero_image || nextConcert.venue_image, 'hero')
  : '/hero-image1.jpg';

const isThisMonth = (date?: string | null) => Boolean(date && date.slice(5, 7) === month);
const yearsAgo = (date?: string | null) => date ? year - Number(date.slice(0, 4)) : 0;
const releaseTypeLabel = (type?: string | null) => String(type || 'release').replace(/[_-]/g, ' ');
const monthlyAnniversaries = [
  ...releases
    .filter((release: any) => release.type !== 'single' && isThisMonth(release.release_date))
    .map((release: any) => ({
      key: `release-${release.id}`,
      title: release.title,
      date: release.release_date,
      type: releaseTypeLabel(release.type),
      years: yearsAgo(release.release_date),
      href: release.slug ? `/discography/${release.slug}` : '/discography',
      cover: release.cover_art,
    })),
  ...(singles as any[])
    .filter((single: any) => isThisMonth(single.release_date))
    .map((single: any) => {
      const albumId = typeof single.album === 'object' ? single.album?.id : single.album;
      const parent: any = albumId ? releaseById.get(Number(albumId)) : null;
      return {
        key: `single-${single.id}`,
        title: single.title || 'Untitled single',
        date: single.release_date,
        type: 'single',
        years: yearsAgo(single.release_date),
        href: parent?.slug ? `/discography/${parent.slug}` : '/discography?type=single',
        cover: parent?.cover_art || null,
      };
    }),
]
  .filter((item) => item.years > 0)
  .sort((a, b) => b.years - a.years || String(a.date).localeCompare(String(b.date)))
  .slice(0, 8);

const dailyImage = photoOfDay?.image_file
  ? asset(photoOfDay.image_file, 'hero')
  : (photoOfDay?.image_url || '/The-Cure-Live-2.avif');
const albumCopy = stripHtml(albumOfMonth?.description || albumOfMonth?.critical_reception || albumOfMonth?.background_text || 'Open the complete record dossier: songs, credits, dates and context.').slice(0, 420);

const figureCells: Array<[string, number]> = [
  ['Records', figures.albums],
  ['Songs', figures.songs],
  ['Shows', figures.setlists],
  ['Venues', figures.venues],
];

const archiveLinks = [
  { href: '/discography', number: figures.albums, label: 'Records', text: 'Albums, singles, artwork, tracklists and release notes.' },
  { href: '/setlists', number: figures.setlists, label: 'Live shows', text: 'Setlists, tours, venues and performance history.' },
  { href: '/songs', number: figures.songs, label: 'Songs', text: 'Lyrics, credits, notes and live play counts.' },
  { href: '/band', number: figures.members, label: 'People', text: 'Members, lineups, instruments and the band history.' },
];
---
<Layout
  title="Cureation | The Cure, in obsessive detail"
  description="The Cure now and then: tour updates, stories, reviews, songs, records, photographs and a living fan archive."
  ogImage="/og-editorial-v2.png"
>
  <section class="hero">
    <img class="hero__image" src="/The-Cure-Live-2.avif" alt="The Cure performing live" width="1600" height="1000" fetchpriority="high" decoding="async" />
    <div class="hero__wash"></div>
    <div
      class="hero__scribble"
      data-daily-edition
      aria-label={`Published ${today}; daily site version ${year}.${dayNumber}`}
    >{publicationMark}</div>
    <div class="container hero__inner">
      <div class="hero__intro">
        <span>Independent archive · Updated daily</span>
      </div>
      <div class="hero__copy">
        <h1>The Cure,<br /><em>all of it.</em></h1>
        <p>What they are doing now, what they did then, and every strange, perfect detail in between.</p>
        <div class="hero__actions">
          <a class="button button--hot" href="/tours/2026-european-summer-shows">Follow the 2026 tour <span>→</span></a>
          <a class="button" href="/publication">Open the publication</a>
        </div>
      </div>
      <div class="hero__figures" aria-label="Archive figures">
        {figureCells.map(([label, value]) => <div><strong>{value.toLocaleString()}</strong><span>{label}</span></div>)}
      </div>
    </div>
  </section>

  <aside class="pulse" aria-label="Cureation now">
    <div class="container pulse__grid">
      <a href="/tours/2026-european-summer-shows"><small><i></i> On tour now</small><strong>{nextConcert ? `${nextConcert.city || nextConcert.venue} · ${formatDate(nextConcert.date, false)}` : '2026 European Summer Shows'}</strong><span>→</span></a>
      {latestNews && <a href={latestNews.slug ? `/publication/${latestNews.slug}` : '/news'}><small>Latest news</small><strong>{latestNews.title}</strong><span>→</span></a>}
      <a href="/reviews"><small>Album reviews</small><strong>Every studio album, closely listened to.</strong><span>→</span></a>
    </div>
  </aside>

  {featureStory && (
    <section class="section story-section">
      <div class="container">
        <header class="section-head section-head--row">
          <div><span>From the archive</span><h2>One story,<br />properly told.</h2></div>
          <a href="/publication">Open the publication →</a>
        </header>
        <a class="feature-story" href={featureStory.slug ? `/publication/${featureStory.slug}` : '/publication'}>
          <span class="feature-story__image">
            <img src={featureImage} alt="" width="1600" height="1000" loading="lazy" decoding="async" />
            <small>{featureStory.category || 'Feature'} · {featureStory.reading_time ? `${featureStory.reading_time} min read` : 'Archive read'}</small>
          </span>
          <span class="feature-story__copy">
            <small>Featured article · {formatDate(featureStory.published_date)}</small>
            <strong>{featureStory.title}</strong>
            {featureExcerpt && <p>{featureExcerpt}{featureExcerpt.length >= 330 ? '…' : ''}</p>}
            <b>Read the feature <i>→</i></b>
          </span>
        </a>
      </div>
    </section>
  )}

  <section class="section live-section">
    <div class="container">
      <header class="section-head"><span>Live · Summer 2026</span><h2>The Cure are<br /><em>out there now.</em></h2></header>
      <div class="live-card">
        <a class="live-card__image" href={concertHref}>
          <img src={concertImage} alt="The Cure live" width="1600" height="1000" loading="lazy" decoding="async" />
          <span>Tour signal / live</span>
        </a>
        <div class="live-card__copy">
          <span class="kicker">{nextConcert ? 'Next show' : 'Tour tracker'}</span>
          <h3>{nextConcert?.venue || '2026 European Summer Shows'}</h3>
          <p>{nextConcert ? [nextConcert.city, nextConcert.country].filter(Boolean).join(', ') : 'Dates, maps, setlists, gaps and updates from the European summer run.'}</p>
          {nextConcert?.date && <time datetime={nextConcert.date}>{formatDate(nextConcert.date)}</time>}
          {concertTarget && (
            <div class="countdown" data-countdown={concertTarget} aria-label="Countdown to the next show">
              <div><strong data-cd="d">–</strong><span>days</span></div>
              <div><strong data-cd="h">–</strong><span>hours</span></div>
              <div><strong data-cd="m">–</strong><span>mins</span></div>
            </div>
          )}
          <div class="live-card__actions">
            <a class="button button--hot" href="/tours/2026-european-summer-shows">Open tour tracker <span>→</span></a>
            <a class="text-link" href="/setlists">Live archive</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section history-section">
    <div class="container">
      <header class="section-head section-head--row">
        <div><span>{today}</span><h2>Today in<br />Cure history.</h2></div>
        <a href="/on-this-day">Open the full timeline →</a>
      </header>
      <div class="history-grid">
        <a class="history-photo" href="/photos">
          <img src={dailyImage} alt={photoOfDay?.title || 'From the Cureation photo archive'} width="1600" height="1100" loading="lazy" decoding="async" />
          <span class="history-photo__shade"></span>
          <span class="history-photo__copy"><small>Image of the day</small><strong>{photoOfDay?.title || 'From the live archive'}</strong>{photoOfDay?.location && <em>{photoOfDay.location}</em>}</span>
        </a>
        <div class="history-events">
          <span class="kicker">On this day · {todayShort}</span>
          {otd.length > 0 ? otd.slice(0, 5).map((event: any) => {
            const href = event.link_collection && event.link_slug ? `/${event.link_collection}/${event.link_slug}` : '/on-this-day';
            return (
              <a href={href}>
                <span>{event.year}</span>
                <strong>{event.title}</strong>
                {event.subtitle && <small>{event.subtitle}</small>}
              </a>
            );
          }) : (
            <div class="history-empty"><strong>A quiet date in the files.</strong><p>The archive still has plenty to say. Browse every release, show and milestone tied to this month.</p><a href="/on-this-day">Explore all dates →</a></div>
          )}
        </div>
      </div>

      {monthlyAnniversaries.length > 0 && (
        <div class="anniversaries">
          <div class="anniversaries__head"><span class="kicker">{monthName} anniversaries</span><strong>The years fold together.</strong></div>
          <div class="anniversaries__rail">
            {monthlyAnniversaries.map((item: any) => (
              <a href={item.href}>
                <span class="anniversaries__art">
                  {item.cover ? <img src={asset(item.cover, 'card')} alt={`${item.title} artwork`} width="480" height="480" loading="lazy" decoding="async" /> : <b>{item.years}</b>}
                  <i>{item.years} years</i>
                </span>
                <strong>{item.title}</strong>
                <small>{item.type} · {formatDate(item.date)}</small>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  {songOfDay && (
    <section class="section song-section" style={songArtworkStyle}>
      <div class="container song-grid">
        <a class="song-art" href={songOfDay.slug ? `/songs/${songOfDay.slug}` : '/songs'}>
          <img src={songArtwork} alt={songAlbum ? `${songAlbum.title} artwork` : ''} width="1000" height="1000" loading="lazy" decoding="async" />
          <span>{songAlbum?.title || 'Song archive'}</span>
        </a>
        <div class="song-copy">
          <span class="kicker">Song of the day · {todayShort}</span>
          <h2>{songOfDay.title}</h2>
          {lyricLine && <blockquote>“{lyricLine}”</blockquote>}
          <div class="song-meta">
            {songAlbum && <span><small>Appears on</small><strong>{songAlbum.title}</strong></span>}
            {songAlbum?.release_date && <span><small>Released</small><strong>{songAlbum.release_date.slice(0, 4)}</strong></span>}
          </div>
          <a class="button button--ink" href={songOfDay.slug ? `/songs/${songOfDay.slug}` : '/songs'}>Lyrics, credits & live history <span>→</span></a>
        </div>
      </div>
    </section>
  )}

  {albumOfMonth && (
    <section class="section album-section">
      <div class="container album-grid">
        <div class="album-copy">
          <span class="kicker">Album of the month · {monthName}</span>
          <h2>{albumOfMonth.title}</h2>
          <p>{albumCopy}{albumCopy.length >= 420 ? '…' : ''}</p>
          <dl>
            {albumOfMonth.release_date && <div><dt>Released</dt><dd>{formatDate(albumOfMonth.release_date)}</dd></div>}
            {albumOfMonth.producer && <div><dt>Produced by</dt><dd>{albumOfMonth.producer}</dd></div>}
            {albumOfMonth.label && <div><dt>Label</dt><dd>{albumOfMonth.label}</dd></div>}
          </dl>
          <a class="button button--hot" href={albumOfMonth.slug ? `/discography/${albumOfMonth.slug}` : '/discography'}>Open the album dossier <span>→</span></a>
        </div>
        <a class="album-art" href={albumOfMonth.slug ? `/discography/${albumOfMonth.slug}` : '/discography'}>
          {albumOfMonth.cover_art
            ? <img src={asset(albumOfMonth.cover_art, 'hero')} alt={`${albumOfMonth.title} artwork`} width="1000" height="1000" loading="lazy" decoding="async" />
            : <span></span>}
          <b aria-hidden="true">{String(albumOfMonth.release_date || '').slice(0, 4)}</b>
        </a>
      </div>
    </section>
  )}

  <section class="section explore-section">
    <div class="container">
      <header class="section-head"><h2>A place for<br />every detail.</h2></header>
      <div class="archive-grid">
        {archiveLinks.map((item, index) => (
          <a href={item.href}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div><small>{item.number.toLocaleString()} filed</small><h3>{item.label}</h3><p>{item.text}</p></div>
            <b>↗</b>
          </a>
        ))}
      </div>

      {studioAlbums.length > 0 && (
        <div class="album-rail">
          <div class="album-rail__head"><span class="kicker">Fourteen studio albums</span><a href="/discography">Full discography →</a></div>
          <div class="album-rail__grid">
            {studioAlbums.map((album: any) => (
              <a href={album.slug ? `/discography/${album.slug}` : '/discography'}>
                {album.cover_art && <img src={asset(album.cover_art, 'card')} alt={`${album.title} cover`} width="480" height="480" loading="lazy" decoding="async" />}
                <span>{album.title}</span><small>{String(album.release_date || '').slice(0, 4)}</small>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  :global(body) { background: var(--bg); }
  .hero { position: relative; min-height: min(890px, calc(100svh - 72px)); isolation: isolate; overflow: hidden; background: #040404; }
  .hero__image, .hero__wash { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero__image { object-fit: cover; object-position: 58% center; filter: saturate(1.15) contrast(1.12) brightness(.68); }
  .hero__wash { z-index: 1; background: linear-gradient(90deg, rgba(5,4,7,.96) 0%, rgba(5,4,7,.79) 42%, rgba(5,4,7,.12) 82%), linear-gradient(0deg, #080808 0%, transparent 43%), radial-gradient(circle at 78% 28%, color-mix(in srgb, var(--accent) 21%, transparent), transparent 35%); }
  .hero__scribble { position: absolute; z-index: 2; right: -116px; top: 38%; width: 360px; transform: rotate(90deg); transform-origin: center; color: rgba(255,255,255,.58); font-family: var(--f-mono); font-size: 8px; font-weight: 700; letter-spacing: .2em; text-align: center; white-space: nowrap; }
  .hero__inner { position: relative; z-index: 3; min-height: inherit; display: flex; flex-direction: column; padding-top: clamp(42px, 7vh, 82px); }
  .hero__intro { display: flex; align-items: center; gap: 12px; color: var(--accent); font-family: var(--f-sans); font-size: 9px; font-weight: 750; letter-spacing: .2em; text-transform: uppercase; }
  .hero__intro::before { width: 34px; height: 1px; content: ''; background: var(--accent); box-shadow: 0 0 18px color-mix(in srgb, var(--accent) 50%, transparent); }
  .hero__copy { max-width: 780px; margin-block: auto; padding-block: 48px; }
  .hero h1 { margin: 0; color: #f0eee8; font-family: var(--f-display); font-size: clamp(76px, 12vw, 158px); font-weight: 400; letter-spacing: -.07em; line-height: .7; }
  .hero h1 em { color: var(--accent); font-weight: 400; text-shadow: 0 0 50px color-mix(in srgb, var(--accent) 25%, transparent); }
  .hero__copy > p { max-width: 46ch; margin: clamp(32px, 5vw, 54px) 0 0; color: #c5c1b7; font-size: clamp(18px, 2vw, 23px); line-height: 1.52; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
  .button { min-height: 49px; display: inline-flex; align-items: center; justify-content: center; gap: 22px; padding: 0 18px; border: 1px solid var(--rule-strong); color: var(--ink); font-family: var(--f-sans); font-size: 9px; font-weight: 800; letter-spacing: .15em; text-transform: uppercase; }
  .hero .button:not(.button--hot) { border-color: rgba(255,255,255,.28); color: #f0eee8; }
  .hero .button:not(.button--hot):hover { border-color: var(--accent); background: var(--accent); color: var(--accent-ink); }
  .button:hover { border-color: var(--accent); background: var(--accent); color: var(--accent-ink); box-shadow: var(--glow); }
  .button--hot { border-color: var(--accent); background: var(--accent); color: var(--accent-ink); }
  .button--hot:hover { border-color: var(--accent); background: var(--accent); color: var(--accent-ink); box-shadow: var(--glow); }
  .button--ink { border-color: rgba(255,255,255,.28); background: rgba(7,7,7,.9); color: #fff; }
  .button--ink:hover { border-color: var(--accent); background: var(--accent); color: var(--accent-ink); }
  .hero__figures { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid rgba(255,255,255,.2); }
  .hero__figures div { padding: 20px 8px 23px 0; }
  .hero__figures strong { display: block; color: #f0eee8; font-family: var(--f-display); font-size: clamp(26px, 3vw, 40px); font-weight: 400; line-height: 1; }
  .hero__figures span { color: #8d8980; font-family: var(--f-sans); font-size: 8px; font-weight: 750; letter-spacing: .16em; text-transform: uppercase; }
  .pulse { border-bottom: 1px solid var(--rule); background: var(--bg-2); }
  .pulse__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .pulse a { min-width: 0; min-height: 116px; display: grid; grid-template-columns: 1fr auto; align-content: center; gap: 8px 16px; padding: 20px clamp(18px, 2.5vw, 34px); border: 0; border-right: 1px solid var(--rule); color: inherit; }
  .pulse a:last-child { border-right: 0; }
  .pulse small { grid-column: 1 / -1; color: var(--accent-3); font-family: var(--f-sans); font-size: var(--micro-sm); font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  .pulse small i { width: 6px; height: 6px; display: inline-block; margin-right: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 12px var(--accent); }
  .pulse strong { min-width: 0; display: -webkit-box; overflow: hidden; color: var(--ink); font-family: var(--f-display); font-size: 18px; font-weight: 400; line-height: 1.15; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
