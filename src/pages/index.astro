---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import NewsCard from '../components/NewsCard.astro';

// Homepage sections
import HeroSlider from '../components/home/HeroSlider.astro';
import DiscographyStripSection from '../components/home/DiscographyStripSection.astro';
import CompactStatsStrip from '../components/home/CompactStatsStrip.astro';
import NewsletterCTASection from '../components/home/NewsletterCTASection.astro';

// Data fetching
import {
  getFeaturedNews,
  getSetlistsWithSongs,
  getSongsWithAlbums,
  getSongOfTheDay,
  getNewsPosts,
  getOverallStats,
  getTimelineEvents,
  getRandomFact,
  fetchAlbums,
  formatAlbum,
} from '../lib/directus';

import {
  getMockSongOfTheDay,
  mockSongsWithAlbums,
  mockNewsPosts,
} from '../lib/mockData';

import siteConfig from '../config/site.config';
import type { SongWithAlbum, NewsPost, Album } from '../types/directus';

// Fetch all data for homepage in parallel
const [
  featuredNews,
  setlists,
  songs,
  allNewsPosts,
  overallStats,
  timelineEvents,
  randomFact,
  rawAlbums,
] = await Promise.all([
  getFeaturedNews(),
  getSetlistsWithSongs(),
  getSongsWithAlbums(),
  getNewsPosts(),
  getOverallStats(),
  getTimelineEvents(),
  getRandomFact(),
  fetchAlbums(),
]);

// --- Derived values ---

// Song of the Day
const songOfTheDay: SongWithAlbum = getSongOfTheDay(songs) || getMockSongOfTheDay() || mockSongsWithAlbums[0];

// News
const newsPostsForGrid: NewsPost[] = allNewsPosts && allNewsPosts.length > 1
  ? allNewsPosts
  : mockNewsPosts;

// Archive stats
const archiveTotals = {
  albums: overallStats.totalAlbums || 14,
  songs: overallStats.totalSongs || songs.length || 200,
  shows: overallStats.totalShows || setlists.length || 1000,
  countries: overallStats.countriesVisited || 5,
};

// --- On This Day computation (lifted from OnThisDaySection) ---
const today = new Date();
const currentMonth = today.getMonth() + 1;
const currentDay = today.getDate();
const dateString = today.toLocaleDateString('en-US', { month: 'long', day: 'numeric' });

const uniqueShows = new Map<string, (typeof setlists)[number]>();
setlists
  .filter((setlist) => {
    if (!setlist.date) return false;
    const eventDate = new Date(setlist.date);
    return eventDate.getMonth() + 1 === currentMonth && eventDate.getDate() === currentDay;
  })
  .forEach((setlist) => {
    const key = `${setlist.year}-${setlist.venue}-${setlist.city}-${setlist.country}`.toLowerCase();
    const existing = uniqueShows.get(key);
    if (!existing || (setlist.songCount || 0) > (existing.songCount || 0)) {
      uniqueShows.set(key, setlist);
    }
  });

const todaySetlists = Array.from(uniqueShows.values()).sort((a, b) => b.year - a.year);

const uniqueEvents = new Map<string, (typeof timelineEvents)[number]>();
timelineEvents
  .filter((event) => {
    if (!event.date) return false;
    const eventDate = new Date(event.date);
    return eventDate.getMonth() + 1 === currentMonth && eventDate.getDate() === currentDay;
  })
  .forEach((event) => {
    const key = `${event.year}-${event.title}`.toLowerCase();
    if (!uniqueEvents.has(key)) uniqueEvents.set(key, event);
  });

const todayEvents = Array.from(uniqueEvents.values()).sort((a, b) => b.year - a.year);
const otdHasEntries = todaySetlists.length > 0 || todayEvents.length > 0;

const otdShows = todaySetlists.slice(0, 3).map(s => ({
  venue: s.venue,
  city: s.city || '',
  country: s.country || '',
  year: s.year,
}));

// --- Album spotlight ---
const featuredSlug = siteConfig.featured?.album || 'disintegration';
const allAlbums = rawAlbums.map(formatAlbum);
const spotlightAlbum: Album =
  allAlbums.find(a => a.slug === featuredSlug) ||
  allAlbums.filter(a => (a.type || 'studio') === 'studio').sort((a, b) => parseInt(b.year || '0') - parseInt(a.year || '0'))[0] ||
  allAlbums[0];

const albumTypeLabel = (() => {
  switch (spotlightAlbum?.type) {
    case 'studio': return 'Studio Album';
    case 'live': return 'Live Album';
    case 'compilation': return 'Compilation';
    case 'ep': return 'EP';
    default: return 'Release';
  }
})();

// --- Build slider slides ---
const navigationTiles = [
  { title: 'News', path: '/news', icon: 'newspaper' },
  { title: 'Discography', path: '/discography', icon: 'music' },
  { title: 'Setlists', path: '/setlists', icon: 'list-music' },
  { title: 'Lyrics', path: '/lyrics', icon: 'text' },
  { title: 'Videos', path: '/videos', icon: 'video' },
  { title: 'Stats', path: '/stats', icon: 'stats' },
];

const slides: Array<{
  id: string;
  type: 'welcome' | 'news' | 'song' | 'on-this-day' | 'album';
  backgroundImage?: string;
  backgroundGradient?: string;
  label: string;
}> = [
  {
    id: 'welcome',
    type: 'welcome',
    backgroundImage: '/images/hero-background.jpg',
    label: 'Welcome to Cureation',
  },
];

// News slide
if (featuredNews) {
  slides.push({
    id: 'news',
    type: 'news',
    backgroundImage: featuredNews.featuredImage || '/images/hero-background.jpg',
    label: `Latest News: ${featuredNews.title}`,
  });
}

// Song of the Day slide
slides.push({
  id: 'song',
  type: 'song',
  backgroundImage: songOfTheDay.albumCover || '/images/hero-background.jpg',
  label: `Song of the Day: ${songOfTheDay.title}`,
});

// On This Day slide — include if we have entries or a fallback fact
if (otdHasEntries || randomFact) {
  slides.push({
    id: 'on-this-day',
    type: 'on-this-day',
    backgroundGradient: 'linear-gradient(135deg, rgba(var(--color-primary-rgb), 0.12) 0%, #060608 60%)',
    label: `On This Day: ${dateString}`,
  });
}

// Album spotlight slide
if (spotlightAlbum) {
  slides.push({
    id: 'album',
    type: 'album',
    backgroundImage: spotlightAlbum.coverImage || '/images/hero-background.jpg',
    label: `Album Spotlight: ${spotlightAlbum.title}`,
  });
}
---

<Layout>
  <!-- BLOCK 1: Hero Slider -->
  <HeroSlider
    slides={slides}
    welcomeData={{ navigationTiles }}
    newsData={featuredNews ? { post: featuredNews } : undefined}
    songData={{ song: songOfTheDay }}
    onThisDayData={{
      dateString,
      showCount: todaySetlists.length,
      milestoneCount: todayEvents.length,
      shows: otdShows,
      hasEntries: otdHasEntries,
      fallbackFact: randomFact?.fact || undefined,
    }}
    albumData={spotlightAlbum ? { album: spotlightAlbum, albumTypeLabel } : undefined}
  />

  <div class="relative z-10">
    <!-- BLOCK 2: Latest Content -->
    <section class="py-12">
      <div class="responsive-container">
        <div class="gothic-heading mb-6">
          <h2 class="font-heading text-xl md:text-2xl text-white tracking-wider">Latest</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {newsPostsForGrid.slice(1, 4).map(post => (
            <NewsCard post={post} compact={true} />
          ))}
        </div>
      </div>
    </section>

    <!-- BLOCK 3: Discography Strip -->
    <DiscographyStripSection />

    <!-- BLOCK 4: Stats + Community -->
    <CompactStatsStrip stats={archiveTotals} />

    <!-- BLOCK 5: Newsletter + Contribute -->
    <NewsletterCTASection />
  </div>
</Layout>
