---
import { editable, copyText, copyAttr, copySource, copyTuple } from '../lib/visual-editing';
import Layout from '../layouts/Layout.astro';
import {
  getAlbumOfMonth,
  listAlbums,
  getRunningFigures,
  getOnThisDay,
  listNews,
  getSongOfDay,
  getPhotoOfDay,
  getNextConcert,
  getTourBySlug,
  fetchRaw,
} from '../lib/directus';
import { tourStatus } from '../lib/archive-dates';
import { asset } from '../lib/assets';

export const prerender = false;



const emptyFigures = { albums: null, songs: null, setlists: null, venues: null, photos: null, members: null };
const [albumOfMonth, releases, figures, otd, journal, songOfDay, photoOfDay, nextConcert, singles, featuredTour] = await Promise.all([
  getAlbumOfMonth().catch(() => null),
  listAlbums().catch(() => []),
  getRunningFigures().catch(() => emptyFigures),
  getOnThisDay().catch(() => []),
  listNews(24).catch(() => []),
  getSongOfDay().catch(() => null),
  getPhotoOfDay().catch(() => null),
  getNextConcert().catch(() => null),
  fetchRaw('singles', {
    limit: -1,
    fields: 'id,title,release_date,album,chart_position',
    sort: 'release_date',
  }).catch(() => []),
  getTourBySlug('2026-european-summer-shows').catch(() => null),
]);

const now = new Date();
const tourState = tourStatus(featuredTour?.start_date, featuredTour?.end_date);
const tourLabel = tourState === 'current' ? 'On tour now' : tourState === 'upcoming' ? 'Upcoming tour' : 'Tour archive';
const heroImage = copyText('pages_index_asset-36da02cc693b', '/The-Cure-Live-2.avif');
const responsiveHero = heroImage === '/The-Cure-Live-2.avif';
const year = now.getFullYear();
const month = String(now.getMonth() + 1).padStart(2, '0');
const monthName = now.toLocaleDateString('en-GB', { month: 'long' });
const today = now.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const todayShort = now.toLocaleDateString('en-GB', { day: 'numeric', month: 'long' });
const formatDate = (value?: string | null, includeYear = true) => value
  ? new Date(`${value.slice(0, 10)}T12:00:00`).toLocaleDateString('en-GB', includeYear
    ? { day: 'numeric', month: 'long', year: 'numeric' }
    : { day: 'numeric', month: 'long' })
  : '';
const stripHtml = (value = '') => value.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();

const studioAlbums = releases.filter((release: any) => release.type === 'studio');
const releaseById = new Map(releases.map((release: any) => [Number(release.id), release]));
const songAlbumId = typeof songOfDay?.album === 'object' ? (songOfDay.album as any)?.id : songOfDay?.album;
const songAlbum: any = songAlbumId ? releaseById.get(Number(songAlbumId)) : null;

const editorialCategories = new Set(['blog', 'editorial', 'editorials', 'feature', 'features', 'interview', 'interviews', 'review', 'reviews']);
const featureStory: any = journal.find((story: any) => String(story.category || '').toLowerCase() === 'blog' && Boolean(story.featured))
  || journal.find((story: any) => String(story.category || '').toLowerCase() === 'blog')
  || journal.find((story: any) => Boolean(story.is_editorial) && String(story.category || '').toLowerCase() !== 'wiki')
  || journal.find((story: any) => editorialCategories.has(String(story.category || '').toLowerCase()))
  || journal.find((story: any) => Boolean(story.featured))
  || journal[0]
  || null;
const latestNews: any = journal.find((story: any) => String(story.category || '').toLowerCase() === 'news') || journal[0] || null;
const featureExcerpt = featureStory ? stripHtml(featureStory.excerpt || '').slice(0, 330) : '';
const featureImage = featureStory?.featured_image_file
  ? asset(featureStory.featured_image_file, 'hero')
  : (typeof featureStory?.featured_image === 'string' && featureStory.featured_image.startsWith('http')
    ? featureStory.featured_image
    : '/thecure-troxyimage.jpg');

const lyricLines: string[] = [];
const structuredLyrics = songOfDay?.lyrics_structured;
if (Array.isArray(structuredLyrics)) {
  for (const section of structuredLyrics) {
    if (Array.isArray(section?.lines)) {
      for (const line of section.lines) if (line?.text) lyricLines.push(String(line.text));
    }
  }
}
if (!lyricLines.length && songOfDay?.lyrics) {
  lyricLines.push(...String(songOfDay.lyrics).split(/\n+/).map((line) => line.trim()).filter(Boolean));
}
const dayStart = Date.UTC(now.getUTCFullYear(), 0, 0);
const dayNumber = Math.floor((Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()) - dayStart) / 86400000);
const lyricLine = lyricLines.length ? lyricLines[dayNumber % lyricLines.length] : null;
const songArtwork = songAlbum?.cover_art ? asset(songAlbum.cover_art, 'hero') : '/images/albums/disintegration.jpg';
const songArtworkStyle = `--song-artwork: url("${songArtwork.replace(/"/g, '%22')}")`;

const concertHref = nextConcert?.slug ? `/setlists/${nextConcert.slug}` : '/tours/2026-european-summer-shows';
const concertTarget = nextConcert?.date ? new Date(`${nextConcert.date.slice(0, 10)}T12:00:00`).toISOString() : null;
const concertImage = nextConcert?.hero_image || nextConcert?.venue_image
  ? asset(nextConcert.hero_image || nextConcert.venue_image, 'hero')
  : '/hero-image1.jpg';

const isThisMonth = (date?: string | null) => Boolean(date && date.slice(5, 7) === month);
const yearsAgo = (date?: string | null) => date ? year - Number(date.slice(0, 4)) : 0;
const releaseTypeLabel = (type?: string | null) => String(type || 'release').replace(/[_-]/g, ' ');
const monthlyAnniversaries = [
  ...releases
    .filter((release: any) => release.type !== 'single' && isThisMonth(release.release_date))
    .map((release: any) => ({
      key: `release-${release.id}`,
      title: release.title,
      date: release.release_date,
      type: releaseTypeLabel(release.type),
      years: yearsAgo(release.release_date),
      href: release.slug ? `/discography/${release.slug}` : '/discography',
      cover: release.cover_art,
    })),
  ...(singles as any[])
    .filter((single: any) => isThisMonth(single.release_date))
    .map((single: any) => {
      const albumId = typeof single.album === 'object' ? single.album?.id : single.album;
      const parent: any = albumId ? releaseById.get(Number(albumId)) : null;
      return {
        key: `single-${single.id}`,
        title: single.title || 'Untitled single',
        date: single.release_date,
        type: 'single',
        years: yearsAgo(single.release_date),
        href: parent?.slug ? `/discography/${parent.slug}` : '/discography?type=single',
        cover: parent?.cover_art || null,
      };
    }),
]
  .filter((item) => item.years > 0)
  .sort((a, b) => b.years - a.years || String(a.date).localeCompare(String(b.date)))
  .slice(0, 8);

const dailyImage = photoOfDay?.image_file
  ? asset(photoOfDay.image_file, 'hero')
  : (photoOfDay?.image_url || '/The-Cure-Live-2.avif');
const albumCopy = stripHtml(albumOfMonth?.description || albumOfMonth?.critical_reception || albumOfMonth?.background_text || 'Open the complete record dossier: songs, credits, dates and context.').slice(0, 420);

const figureCells: Array<[string, number | null]> = [
  copyTuple([copyText("pages_index_tuple-f1cf6d85d4e1", "Albums"), figures.albums], {"0":"pages_index_tuple-f1cf6d85d4e1"}),
  copyTuple([copyText("pages_index_tuple-c8896cf6d112", "Songs"), figures.songs], {"0":"pages_index_tuple-c8896cf6d112"}),
  copyTuple([copyText("pages_index_tuple-afe58dd0babc", "Shows"), figures.setlists], {"0":"pages_index_tuple-afe58dd0babc"}),
  copyTuple([copyText("pages_index_tuple-f6a89562be86", "Venues"), figures.venues], {"0":"pages_index_tuple-f6a89562be86"}),
];

const archiveLinks = [
  { ...copySource({"label":"pages_index_data-19978bc85b18","text":"pages_index_data-2d07dbd1b047"}),  href: '/discography', number: figures.albums, label: copyText("pages_index_data-19978bc85b18", "Albums"), text: copyText("pages_index_data-2d07dbd1b047", "Albums, singles, artwork, tracklists and release notes.") },
  { ...copySource({"label":"pages_index_data-d25a1f41032e","text":"pages_index_data-2cb714c25f5a"}),  href: '/setlists', number: figures.setlists, label: copyText("pages_index_data-d25a1f41032e", "Live shows"), text: copyText("pages_index_data-2cb714c25f5a", "Setlists, tours, venues and performance history.") },
  { ...copySource({"label":"pages_index_data-2f8611c95eec","text":"pages_index_data-32aba5f1066e"}),  href: '/songs', number: figures.songs, label: copyText("pages_index_data-2f8611c95eec", "Songs"), text: copyText("pages_index_data-32aba5f1066e", "Lyrics, credits, notes and live play counts.") },
  { ...copySource({"label":"pages_index_data-ebb291d20435","text":"pages_index_data-b8d3cb600232"}),  href: '/band', number: figures.members, label: copyText("pages_index_data-ebb291d20435", "People"), text: copyText("pages_index_data-b8d3cb600232", "Members, lineups, instruments and the band history.") },
];
---
<Layout
  title="Cureation | The Cure, in obsessive detail"
  description="The Cure now and then: tour updates, stories, reviews, songs, records, photographs and a living fan archive."
  ogImage="/og-editorial-v2.png"
>
  <section class="hero">
    <img data-directus={copyAttr("pages_index_asset-36da02cc693b")} class="hero__image" src={responsiveHero ? "/images/cure-live-1440.avif" : heroImage} srcset={responsiveHero ? "/images/cure-live-800.avif 800w, /images/cure-live-1200.avif 1200w, /images/cure-live-1440.avif 1440w" : undefined} sizes="100vw" alt="The Cure performing live" width="1440" height="811" fetchpriority="high" decoding="async" />
    <div class="hero__wash"></div>
    <div class="container hero__inner">
      <div class="hero__copy">
        <h1 data-directus={copyAttr("pages_index_5eeff95555f4")} set:html={copyText("pages_index_5eeff95555f4", "The Cure,<br /><em>all of it.</em>")}></h1>
        <p data-directus={copyAttr("pages_index_6ba37993e06f")} set:html={copyText("pages_index_6ba37993e06f", "News, music, live shows and the history of The Cure.")}></p>
        <div class="hero__actions">
          <a class="button button--hot" href="/tours/2026-european-summer-shows">{tourState === 'completed' ? 'Explore the 2026 tour' : 'Follow the 2026 tour'} <span>→</span></a>
          <a data-directus={copyAttr("pages_index_2b8c11a3c748")} set:html={copyText("pages_index_2b8c11a3c748", "Read articles")} class="button" href="/publication"></a>
        </div>
      </div>
      <div class="hero__figures" aria-label="Archive figures">
        {figureCells.map((__copyRow10554) => { const [label, value] = __copyRow10554; return <div><strong>{value?.toLocaleString() ?? 'Unavailable'}</strong><span data-directus={editable(__copyRow10554, ["0"])}>{label}</span></div>; })}
      </div>
    </div>
  </section>

  <aside class="pulse" aria-label="Cureation now">
    <div class="container pulse__grid">
      <a href="/tours/2026-european-summer-shows"><small set:html={`<i></i> ${tourLabel}`}></small><strong data-directus={editable(nextConcert, ["city","venue","date"])}>{nextConcert ? `${nextConcert.city || nextConcert.venue} · ${nextConcert.country || 'Tour dates'}` : '2026 European Summer Shows'}</strong><span>→</span></a>
      {latestNews && <a href={latestNews.slug ? `/publication/${latestNews.slug}` : '/news'}><small data-directus={copyAttr("pages_index_0232a3ea3791")} set:html={copyText("pages_index_0232a3ea3791", "Latest news")}></small><strong data-directus={editable(latestNews, ["title"])}>{latestNews.title}</strong><span>→</span></a>}
      <a href="/reviews"><small data-directus={copyAttr("pages_index_210ff4db9681")} set:html={copyText("pages_index_210ff4db9681", "Album reviews")}></small><strong data-directus={copyAttr("pages_index_39927fc141f6")} set:html={copyText("pages_index_39927fc141f6", "Every studio album, closely listened to.")}></strong><span>→</span></a>
    </div>
  </aside>

  {featureStory && (
    <section class="section story-section">
      <div class="container">
        <header class="section-head section-head--row">
          <div><span data-directus={copyAttr("pages_index_8f43a2b39e05")} set:html={copyText("pages_index_8f43a2b39e05", "From the archive")}></span><h2>Featured story</h2></div>
          <a data-directus={copyAttr("pages_index_74eb96f00ebf")} set:html={copyText("pages_index_74eb96f00ebf", "All articles →")} href="/publication"></a>
        </header>
        <a class="feature-story" href={featureStory.slug ? `/publication/${featureStory.slug}` : '/publication'}>
          <span class="feature-story__image">
            <img data-directus={editable(featureStory, ["featured_image_file", "featured_image"])} src={featureImage} alt="" width="1600" height="1000" loading="lazy" decoding="async" />
            <small data-directus={editable(featureStory, ["category","reading_time"])}>{featureStory.category || 'Feature'} · {featureStory.reading_time ? `${featureStory.reading_time} min read` : 'Archive read'}</small>
          </span>
          <span class="feature-story__copy">
            <small data-directus={editable(featureStory, ["published_date"])}>Featured article · {formatDate(featureStory.published_date)}</small>
            <strong data-directus={editable(featureStory, ["title"])}>{featureStory.title}</strong>
            {featureExcerpt && <p>{featureExcerpt}{featureExcerpt.length >= 330 ? '…' : ''}</p>}
            <b data-directus={copyAttr("pages_index_59013f73a003")} set:html={copyText("pages_index_59013f73a003", "Read the feature <i>→</i>")}></b>
          </span>
        </a>
      </div>
    </section>
  )}

  <section class="section live-section">
    <div class="container">
      <header class="section-head"><span data-directus={copyAttr("pages_index_3a4c50060218")} set:html={copyText("pages_index_3a4c50060218", "Live · Summer 2026")}></span><h2>{tourState === "current" ? "Current tour" : "Live archive"}</h2></header>
      <div class="live-card">
        <a class="live-card__image" href={concertHref}>
          <img src={concertImage} alt="The Cure live" width="1600" height="1000" loading="lazy" decoding="async" />
          <span data-directus={copyAttr("pages_index_25c8e07db2f7")} set:html={tourLabel}></span>
        </a>
        <div  class="live-card__copy">
          <span class="kicker">{nextConcert ? 'Next show' : 'Tour tracker'}</span>
          <h3 data-directus={editable(nextConcert, ["venue"])}>{nextConcert?.venue || '2026 European Summer Shows'}</h3>
          <p data-directus={editable(nextConcert, ["city","country"])}>{nextConcert ? [nextConcert.city, nextConcert.country].filter(Boolean).join(', ') : 'Dates, maps, setlists, gaps and updates from the European summer run.'}</p>
          {nextConcert?.date && <time data-directus={editable(nextConcert, ["date"])} datetime={nextConcert.date}>{formatDate(nextConcert.date)}</time>}
          {concertTarget && (
            <div class="countdown" data-countdown={concertTarget} aria-label="Countdown to the next show">
              <div><strong data-cd="d">–</strong><span data-directus={copyAttr("pages_index_75a3775050f1")} set:html={copyText("pages_index_75a3775050f1", "days")}></span></div>
              <div><strong data-cd="h">–</strong><span data-directus={copyAttr("pages_index_773349c0f162")} set:html={copyText("pages_index_773349c0f162", "hours")}></span></div>
              <div><strong data-cd="m">–</strong><span data-directus={copyAttr("pages_index_900b0fad12b0")} set:html={copyText("pages_index_900b0fad12b0", "mins")}></span></div>
            </div>
          )}
          <div class="live-card__actions">
            <a class="button button--hot" href="/tours/2026-european-summer-shows">Open tour tracker <span>→</span></a>
            <a data-directus={copyAttr("pages_index_4a3186259bca")} set:html={copyText("pages_index_4a3186259bca", "Live archive")} class="text-link" href="/setlists"></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section history-section">
    <div class="container">
      <header class="section-head section-head--row">
        <div><span>{today}</span><h2>On this day</h2></div>
        <a data-directus={copyAttr("pages_index_409f20082e01")} set:html={copyText("pages_index_409f20082e01", "Open the full timeline →")} href="/on-this-day"></a>
      </header>
      <div class="history-grid">
        <a class="history-photo" href="/photos">
          <img src={dailyImage} alt={photoOfDay?.title || 'From the Cureation photo archive'} width="1600" height="1100" loading="lazy" decoding="async" />
          <span class="history-photo__shade"></span>
          <span  class="history-photo__copy"><small data-directus={copyAttr("pages_index_ca9bc7dbc00b")} set:html={copyText("pages_index_ca9bc7dbc00b", "Image of the day")}></small><strong data-directus={editable(photoOfDay, ["title"])}>{photoOfDay?.title || 'From the live archive'}</strong>{photoOfDay?.location && <em data-directus={editable(photoOfDay, ["location"])}>{photoOfDay.location}</em>}</span>
        </a>
        <div class="history-events">
          <span class="kicker">From the archive</span>
          {otd.length > 0 ? otd.slice(0, 5).map((event: any) => {
            const href = event.link_collection && event.link_slug ? `/${event.link_collection}/${event.link_slug}` : '/on-this-day';
            return (
              <a  href={href}>
                <span data-directus={editable(event, ["year"])}>{event.year}</span>
                <strong data-directus={editable(event, ["title"])}>{event.title}</strong>
                {event.subtitle && <small data-directus={editable(event, ["subtitle"])}>{event.subtitle}</small>}
              </a>
            );
          }) : (
            <div class="history-empty"><strong data-directus={copyAttr("pages_index_e82bda044c2f")} set:html={copyText("pages_index_e82bda044c2f", "No events for today.")}></strong><p data-directus={copyAttr("pages_index_c6397b3f9c08")} set:html={copyText("pages_index_c6397b3f9c08", "The archive still has plenty to say. Browse every release, show and milestone tied to this month.")}></p><a data-directus={copyAttr("pages_index_56f62a781649")} set:html={copyText("pages_index_56f62a781649", "Explore all dates →")} href="/on-this-day"></a></div>
          )}
        </div>
      </div>

      {monthlyAnniversaries.length > 0 && (
        <div class="anniversaries">
          <div class="anniversaries__head"><span class="kicker">{monthName} anniversaries</span><strong data-directus={copyAttr("pages_index_3fd879e8ff3f")} set:html={copyText("pages_index_3fd879e8ff3f", "The years fold together.")}></strong></div>
          <div class="anniversaries__rail">
            {monthlyAnniversaries.map((item: any) => (
              <a href={item.href}>
                <span  class="anniversaries__art">
                  {item.cover ? <img data-directus={editable(item, ["cover"])} src={asset(item.cover, 'card')} alt={`${item.title} artwork`} width="480" height="480" loading="lazy" decoding="async" /> : <b data-directus={editable(item, ["years"])}>{item.years}</b>}
                  <i data-directus={editable(item, ["years"])}>{item.years} years</i>
                </span>
                <strong data-directus={editable(item, ["title"])}>{item.title}</strong>
                <small data-directus={editable(item, ["type","date"])}>{item.type} · {formatDate(item.date)}</small>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  {songOfDay && (
    <section class="section song-section" style={songArtworkStyle}>
      <div class="container song-grid">
        <a class="song-art" href={songOfDay.slug ? `/songs/${songOfDay.slug}` : '/songs'}>
          <img src={songArtwork} alt={songAlbum ? `${songAlbum.title} artwork` : ''} width="1000" height="1000" loading="lazy" decoding="async" />
          <span data-directus={editable(songAlbum, ["title"])}>{songAlbum?.title || 'Song archive'}</span>
        </a>
        <div class="song-copy">
          <span class="kicker">Song of the day · {todayShort}</span>
          <h2 data-directus={editable(songOfDay, ["title"])}>{songOfDay.title}</h2>
          {lyricLine && <blockquote>“{lyricLine}”</blockquote>}
          <div  class="song-meta">
            {songAlbum && <span><small data-directus={copyAttr("pages_index_c478dad771a6")} set:html={copyText("pages_index_c478dad771a6", "Appears on")}></small><strong data-directus={editable(songAlbum, ["title"])}>{songAlbum.title}</strong></span>}
            {songAlbum?.release_date && <span><small data-directus={copyAttr("pages_index_2ea3aca51d06")} set:html={copyText("pages_index_2ea3aca51d06", "Released")}></small><strong data-directus={editable(songAlbum, ["release_date"])}>{songAlbum.release_date.slice(0, 4)}</strong></span>}
          </div>
          <a class="button button--ink" href={songOfDay.slug ? `/songs/${songOfDay.slug}` : '/songs'}>Lyrics, credits & live history <span>→</span></a>
        </div>
      </div>
    </section>
  )}

  {albumOfMonth && (
    <section class="section album-section">
      <div class="container album-grid">
        <div class="album-copy">
          <span class="kicker">Album of the month · {monthName}</span>
          <h2 data-directus={editable(albumOfMonth, ["title"])}>{albumOfMonth.title}</h2>
          <p>{albumCopy}{albumCopy.length >= 420 ? '…' : ''}</p>
          <dl>
            {albumOfMonth.release_date && <div><dt data-directus={copyAttr("pages_index_b77b48ed25a1")} set:html={copyText("pages_index_b77b48ed25a1", "Released")}></dt><dd data-directus={editable(albumOfMonth, ["release_date"])}>{formatDate(albumOfMonth.release_date)}</dd></div>}
            {albumOfMonth.producer && <div><dt data-directus={copyAttr("pages_index_aeb16e09be89")} set:html={copyText("pages_index_aeb16e09be89", "Produced by")}></dt><dd data-directus={editable(albumOfMonth, ["producer"])}>{albumOfMonth.producer}</dd></div>}
            {albumOfMonth.label && <div><dt data-directus={copyAttr("pages_index_04721e7fff98")} set:html={copyText("pages_index_04721e7fff98", "Label")}></dt><dd data-directus={editable(albumOfMonth, ["label"])}>{albumOfMonth.label}</dd></div>}
          </dl>
          <a class="button button--hot" href={albumOfMonth.slug ? `/discography/${albumOfMonth.slug}` : '/discography'}>Open the album dossier <span>→</span></a>
        </div>
        <a  class="album-art" href={albumOfMonth.slug ? `/discography/${albumOfMonth.slug}` : '/discography'}>
          {albumOfMonth.cover_art
            ? <img data-directus={editable(albumOfMonth, ["cover_art"])} src={asset(albumOfMonth.cover_art, 'hero')} alt={`${albumOfMonth.title} artwork`} width="1000" height="1000" loading="lazy" decoding="async" />
            : <span></span>}
          <b data-directus={editable(albumOfMonth, ["release_date"])} aria-hidden="true">{String(albumOfMonth.release_date || '').slice(0, 4)}</b>
        </a>
      </div>
    </section>
  )}

  <section class="section explore-section">
    <div class="container">
      <header class="section-head"><h2>Explore the archive</h2></header>
      <div class="archive-grid">
        {archiveLinks.map((item, index) => (
          <a href={item.href}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div><small data-directus={editable(item, ["number"])}>{item.number?.toLocaleString() ?? 'Unavailable'} filed</small><h3 data-directus={editable(item, ["label"])}>{item.label}</h3><p data-directus={editable(item, ["text"])}>{item.text}</p></div>
            <span class="archive-grid__arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M5 12h13M14 8l4 4-4 4" />
              </svg>
