---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Select from '../components/ui/Select.astro';
import SearchField from '../components/ui/SearchField.astro';
import { fetchRaw } from '../lib/directus';
import { asset } from '../lib/assets';

const videos: any[] = await fetchRaw('videos', { limit: -1, sort: '-date,-date_created' }).catch(() => []);
const types = Array.from(new Set(videos.map((v) => v.type).filter(Boolean))).sort();
const years = Array.from(new Set(videos.map((v) => (v.release_date || v.date || '').slice(0, 4)).filter(Boolean))).sort().reverse();

const ytId = (url: string): string | null => {
  if (!url) return null;
  const m = url.match(/(?:youtube\.com\/(?:watch\?v=|embed\/)|youtu\.be\/)([\w-]{11})/);
  return m && m[1] ? m[1] : null;
};
---
<Layout title="Videos · Cureation">
  <PageHero
    section="Moving image"
    title="The video archive"
    deck="Promos, performances, interviews and concert films, catalogued with director, year and source."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Videos' }]}
    facts={[
      { k: 'On file', v: videos.length },
      { k: 'Types', v: types.length },
      { k: 'Years', v: years.length },
    ]}
    flush
  />

  {videos.length === 0 ? (
    <section class="video-index"><div class="container"><div class="video-empty"><span>Archive in progress</span><h2>The pictures will<br />start moving soon.</h2><p>The video index is being compiled, starting with promos, then live films and interviews.</p></div></div>
    </section>
  ) : (
    <section class="video-index">
      <div class="container">
        <header class="video-heading"><div><span>Moving image catalogue</span><h2>Watch the archive<br /><em>come alive.</em></h2></div><small>{videos.length} films</small></header>
        <div class="video-filters" aria-label="Video catalogue filters">
          <div class="table-controls__grid table-controls__grid--3">
            <Select
              name="type"
              label="Type"
              options={[{ value: 'all', label: 'All types' }, ...types.map((t) => ({ value: t!, label: String(t).toUpperCase() }))]}
            />
            <Select
              name="year"
              label="Year"
              options={[{ value: 'all', label: 'All years' }, ...years.map((y) => ({ value: y!, label: y! }))]}
            />
            <SearchField placeholder="Title, director..." />
          </div>
        </div>
        <div class="table-results-bar video-results">
          <span data-match-count>{videos.length} videos</span>
        </div>
        <div class="video-grid" data-video-grid>
          {videos.map((v, i) => {
            const url = v.url || v.video_url || '';
            const videoDate = v.release_date || v.date || '';
            const yid = ytId(url);
            const thumb = yid ? `https://i.ytimg.com/vi/${yid}/hqdefault.jpg` : (v.thumbnail_url || (v.thumbnail ? asset(v.thumbnail, 'card') : ''));
            return (
              <a class={`video-card${i === 0 ? ' video-card--lead' : ''}`}
                 href={url || '#'}
                 target={url ? '_blank' : undefined}
                 rel={url ? 'noopener' : undefined}
                 data-type={v.type || ''}
                 data-year={videoDate.slice(0, 4)}
                 data-search={`${v.title || ''} ${v.director || ''} ${v.album_title || ''}`.toLowerCase()}>
                <div class="video-card__thumb">
                  {thumb ? <img src={thumb} alt={v.title || ''} loading="lazy" /> : <div class="video-card__ph" />}
                  <div class="video-card__play">▶</div>
                </div>
                <div class="video-card__meta">
                  <small>{(v.type || 'VIDEO').toUpperCase()} · {videoDate.slice(0, 4) || '–'}</small>
                  <h3>{v.title}</h3>
                  {v.director && <span>Directed by {v.director}</span>}
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}
</Layout>

<script>
  function wire() {
    const state: Record<string, string> = { type: 'all', year: 'all', search: '' };
    const grid = document.querySelector<HTMLElement>('[data-video-grid]');
    if (!grid || grid.dataset.filtersWired === 'true') return;
    grid.dataset.filtersWired = 'true';
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.video-card'));
    const counter = document.querySelector<HTMLElement>('[data-match-count]');
    const apply = () => {
      let m = 0;
      cards.forEach((r) => {
        const t = r.getAttribute('data-type') || '';
        const y = r.getAttribute('data-year') || '';
        const s = r.getAttribute('data-search') || '';
        const ok = (state.type === 'all' || t === state.type) && (state.year === 'all' || y === state.year) && (!state.search || s.includes(state.search));
        r.style.display = ok ? '' : 'none';
        if (ok) m++;
      });
      if (counter) counter.textContent = `${m} videos`;
    };
    document.querySelectorAll<HTMLSelectElement>('[data-filter-select]').forEach((sel) => {
      const key = sel.getAttribute('data-filter-select') || '';
      sel.addEventListener('change', () => { state[key] = sel.value || 'all'; apply(); });
    });
    const search = document.querySelector<HTMLInputElement>('[data-filter-search]');
    if (search) search.addEventListener('input', () => { state.search = search.value.trim().toLowerCase(); apply(); });
    apply();
  }
  wire();
  document.addEventListener('astro:page-load', wire);
</script>

<style is:global>
  .video-index { padding-block: clamp(82px, 10vw, 148px); background: var(--bg-2); }
  .video-heading { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 32px; margin-bottom: clamp(42px, 6vw, 76px); }
  .video-heading span, .video-card__meta small, .video-card__meta > span, .video-results, .video-empty > span { color: var(--accent); font-family: var(--f-sans); font-size: 9px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
  .video-heading h2, .video-empty h2 { max-width: 11ch; margin: 10px 0 0; color: var(--ink); font-family: var(--f-display); font-size: clamp(54px, 7.5vw, 102px); font-weight: 400; letter-spacing: -.06em; line-height: .8; }
  .video-heading h2 em { color: var(--accent); font-weight: inherit; }
  .video-heading > small { padding: 11px 14px; background: var(--accent); color: var(--accent-ink); font-family: var(--f-sans); font-size: 9px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  .video-filters { padding: clamp(18px, 2.5vw, 30px); background: var(--bg); }
  .video-results { padding: 20px 0; }
  .video-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(24px, 4vw, 58px); }
  .video-card { min-width: 0; display: block; border: 0; color: inherit; }
  .video-card--lead { grid-column: 1 / -1; }
  .video-card__thumb { position: relative; aspect-ratio: 16/9; overflow: hidden; background: var(--bg); }
  .video-card--lead .video-card__thumb { aspect-ratio: 2.25 / 1; }
  .video-card__thumb::after { position: absolute; inset: 0; content: ''; background: linear-gradient(0deg, rgba(0,0,0,.4), transparent 52%); }
  .video-card__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; filter: saturate(1.08) contrast(1.04); transition: transform .55s ease; }
  .video-card__ph { position: absolute; inset: 0; background: repeating-linear-gradient(45deg, var(--bg-2), var(--bg-2) 10px, var(--bg-3) 10px, var(--bg-3) 20px); }
  .video-card__play { position: absolute; z-index: 2; right: 18px; bottom: 18px; width: 58px; height: 58px; display: grid; place-items: center; background: var(--accent); color: var(--accent-ink); font-size: 18px; box-shadow: var(--glow); }
  .video-card__meta { position: relative; padding: 20px 0 22px; }
  .video-card__meta::after { position: absolute; right: 0; bottom: 0; left: 0; height: 3px; content: ''; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform .22s ease; }
  .video-card h3 { max-width: 20ch; margin: 8px 0 0; color: var(--ink); font-family: var(--f-display); font-size: clamp(29px, 3vw, 46px); font-style: italic; font-weight: 400; line-height: .96; }
  .video-card--lead h3 { font-size: clamp(42px, 5vw, 72px); }
  .video-card__meta > span { display: block; margin-top: 10px; color: var(--muted); }
  .video-card:hover img { transform: scale(1.02); }
  .video-card:hover h3 { color: var(--accent); }
  .video-card:hover .video-card__meta::after { transform: scaleX(1); }
  .video-empty { max-width: 1040px; padding: clamp(36px, 6vw, 80px); background: linear-gradient(135deg, var(--accent-tint-2), transparent 60%), var(--bg); }
  .video-empty p { max-width: 46ch; color: var(--ink-2); font-size: 18px; line-height: 1.6; }
  @media (max-width: 720px) { .video-heading { grid-template-columns: 1fr; align-items: start; } .video-heading > small { justify-self: start; } .video-grid { grid-template-columns: 1fr; } .video-card--lead { grid-column: auto; } .video-card--lead .video-card__thumb { aspect-ratio: 16/9; } }
</style>
