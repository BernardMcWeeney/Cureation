---
import MainLayout from '../../layouts/MainLayout.astro';
import { getTourStatistics, getSetlistsWithSongs } from '../../lib/directus';

const tourStats = await getTourStatistics();
const setlists = await getSetlistsWithSongs();

// Shows by year
const showsByYear: Record<number, number> = {};
const countriesByYear: Record<number, Set<string>> = {};
setlists.forEach(s => {
  if (s.year > 0) {
    showsByYear[s.year] = (showsByYear[s.year] || 0) + 1;
    if (!countriesByYear[s.year]) countriesByYear[s.year] = new Set();
    if (s.country) countriesByYear[s.year].add(s.country);
  }
});

const yearlyData = Object.entries(showsByYear)
  .map(([year, count]) => ({
    year: parseInt(year),
    shows: count,
    countries: countriesByYear[parseInt(year)]?.size || 0
  }))
  .sort((a, b) => a.year - b.year);

const maxShowsInYear = Math.max(...yearlyData.map(y => y.shows), 1);

// All countries played
const allCountries = new Set<string>();
setlists.forEach(s => { if (s.country) allCountries.add(s.country); });
const countriesSorted = Array.from(allCountries).sort();

// Top venues
const venueCounts: Record<string, { count: number; city: string; country: string }> = {};
setlists.forEach(s => {
  const key = `${s.venue}|${s.city}`;
  if (!venueCounts[key]) venueCounts[key] = { count: 0, city: s.city, country: s.country };
  venueCounts[key].count++;
});
const topVenues = Object.entries(venueCounts)
  .map(([key, data]) => ({ venue: key.split('|')[0], ...data }))
  .sort((a, b) => b.count - a.count)
  .slice(0, 20);

// Shows per decade
const showsByDecade: Record<string, number> = {};
yearlyData.forEach(y => {
  const decade = `${Math.floor(y.year / 10) * 10}s`;
  showsByDecade[decade] = (showsByDecade[decade] || 0) + y.shows;
});

const totalShows = setlists.length;
const totalTours = tourStats.length;
const maxTourShows = tourStats[0]?.totalShows || 1;
---

<MainLayout
  title="Tour Statistics"
  description="The Cure tour statistics - concerts, venues, countries, and decades of touring"
>
  <!-- Breadcrumb -->
  <nav class="mb-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-white/85">
      <li><a href="/stats" class="hover:text-white transition-colors">Statistics</a></li>
      <li aria-hidden="true">/</li>
      <li class="text-white">Tour Stats</li>
    </ol>
  </nav>

  <!-- Hero -->
  <section class="mb-12">
    <div class="glass-panel overflow-hidden relative">
      <div class="absolute -top-20 -left-20 w-64 h-64 rounded-full bg-white/[0.06] blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-10 -right-10 w-48 h-48 rounded-full bg-accent/[0.06] blur-2xl pointer-events-none"></div>

      <div class="relative p-8 md:p-12">
        <h1 class="font-display text-5xl md:text-6xl lg:text-7xl text-white mb-4 text-glow">Tour Statistics</h1>
        <p class="text-white/75 text-lg md:text-xl max-w-3xl leading-relaxed">
          Decades of touring the world — every tour, every venue, every country The Cure has visited.
        </p>

        <div class="flex flex-wrap gap-8 mt-8 pt-6 border-t border-white/[0.08]">
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-white text-glow">{totalShows.toLocaleString()}</span>
            <span class="text-white/85 text-base font-medium">Total Shows</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-white text-glow">{totalTours}</span>
            <span class="text-white/85 text-base font-medium">Tours</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-white text-glow">{allCountries.size}</span>
            <span class="text-white/85 text-base font-medium">Countries</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-white text-glow">{Object.keys(venueCounts).length}</span>
            <span class="text-white/85 text-base font-medium">Unique Venues</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- All Tours Table -->
  <section class="mb-12">
    <div class="glass-panel p-6 md:p-8">
      <h2 class="text-2xl text-white mb-6 gothic-heading">All Tours</h2>
      {tourStats.length > 0 ? (
        <div class="space-y-3">
          {tourStats.map((tour, idx) => (
            <div class="flex items-center gap-4 p-4 rounded-lg bg-white/[0.03] hover:bg-white/[0.06] transition-colors cure-rose-border">
              <span class={`w-10 h-10 rounded-lg flex items-center justify-center text-sm font-bold shrink-0 ${
                idx < 3 ? 'bg-blue-500/20 text-blue-400' : 'bg-white/5 text-white/80'
              }`}>{idx + 1}</span>
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between mb-1">
                  <h3 class="text-white font-medium truncate">{tour.name}</h3>
                  <span class="text-white/80 text-sm ml-4 shrink-0">{tour.year}</span>
                </div>
                <div class="h-1.5 bg-white/5 rounded-full overflow-hidden mb-2">
                  <div
                    class="h-full bg-gradient-to-r from-blue-500 to-cyan-400 rounded-full stat-bar-animated"
                    style={`width: ${(tour.totalShows / maxTourShows) * 100}%`}
                  ></div>
                </div>
                <div class="flex flex-wrap gap-4 text-xs text-white/80">
                  <span>{tour.totalShows} shows</span>
                  <span>{tour.countries.length} countries</span>
                  <span>{tour.uniqueSongs} unique songs</span>
                  <span>{tour.averageSongsPerShow} avg songs/show</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <p class="text-white/85 text-center py-8">No tour data available.</p>
      )}
    </div>
  </section>

  <!-- Shows by Year -->
  <section class="mb-12">
    <div class="glass-panel p-6 md:p-8">
      <h2 class="text-2xl text-white mb-6 gothic-heading">Shows by Year</h2>
      <div class="space-y-2">
        {yearlyData.map(year => (
          <div class="flex items-center gap-3">
            <span class="text-white/85 text-sm w-12 shrink-0 font-mono">{year.year}</span>
            <div class="flex-1 h-6 bg-white/5 rounded overflow-hidden relative">
              <div
                class="h-full bg-gradient-to-r from-primary/80 to-accent/60 rounded stat-bar-animated"
                style={`width: ${(year.shows / maxShowsInYear) * 100}%`}
              ></div>
              <span class="absolute right-2 top-1/2 -translate-y-1/2 text-xs text-white/90 font-mono">{year.shows}</span>
            </div>
            <span class="text-white/80 text-xs w-20 text-right shrink-0">{year.countries} countries</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Shows by Decade + Top Venues side by side -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-12">
    <!-- Shows by Decade -->
    <section>
      <div class="glass-panel p-6 h-full">
        <h2 class="text-2xl text-white mb-6 gothic-heading">Shows by Decade</h2>
        <div class="space-y-4">
          {Object.entries(showsByDecade).sort(([a], [b]) => a.localeCompare(b)).map(([decade, count]) => (
            <div class="flex items-center justify-between p-4 rounded-lg bg-white/[0.03]">
              <span class="text-white font-heading text-lg">{decade}</span>
              <div class="flex items-center gap-3">
                <div class="w-32 h-2 bg-white/5 rounded-full overflow-hidden">
                  <div
                    class="h-full bg-gradient-to-r from-primary to-accent rounded-full"
                    style={`width: ${(count / Math.max(...Object.values(showsByDecade))) * 100}%`}
                  ></div>
                </div>
                <span class="text-primary font-bold w-16 text-right">{count}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Top Venues -->
    <section>
      <div class="glass-panel p-6 h-full">
        <h2 class="text-2xl text-white mb-6 gothic-heading">Most Visited Venues</h2>
        <div class="space-y-2">
          {topVenues.map((venue, idx) => (
            <div class="flex items-center justify-between p-3 rounded-lg bg-white/[0.03] hover:bg-white/[0.06] transition-colors">
              <div class="flex items-center gap-3 min-w-0">
                <span class="text-white/80 text-sm w-5 shrink-0">{idx + 1}.</span>
                <div class="min-w-0">
                  <p class="text-white truncate text-sm">{venue.venue}</p>
                  <p class="text-white/80 text-xs">{venue.city}, {venue.country}</p>
                </div>
              </div>
              <span class="text-primary font-bold shrink-0 ml-3">{venue.count}</span>
            </div>
          ))}
        </div>
      </div>
    </section>
  </div>

  <!-- Countries -->
  <section class="mb-12">
    <div class="glass-panel p-6 md:p-8">
      <h2 class="text-2xl text-white mb-6 gothic-heading">Countries Visited ({allCountries.size})</h2>
      <div class="flex flex-wrap gap-2">
        {countriesSorted.map(country => (
          <span class="px-3 py-1.5 rounded bg-white/[0.04] border border-white/[0.08] text-white/90 text-sm hover:bg-white/[0.08] hover:text-white transition-colors">
            {country}
          </span>
        ))}
      </div>
    </div>
  </section>

  <div class="text-center">
    <a href="/stats" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-white/10 border border-primary/40 text-white hover:bg-primary/30 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
      Back to Statistics
    </a>
  </div>
</MainLayout>
