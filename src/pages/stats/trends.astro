---
import MainLayout from '../../layouts/MainLayout.astro';
import {
  getSongStatistics,
  getSetlistsWithSongs,
  getTourStatistics,
  fetchAlbums,
  formatAlbum,
  getAlbumEra,
  eraMetadata
} from '../../lib/directus';
import type { AlbumEra } from '../../types/directus';

const [allStats, setlists, tourStats, rawAlbums] = await Promise.all([
  getSongStatistics(),
  getSetlistsWithSongs(),
  getTourStatistics(),
  fetchAlbums(),
]);

const albums = rawAlbums.map(formatAlbum);
const playedSongs = allStats.filter(s => s.totalPlays > 0);

// Setlist length trends over time (avg songs per show per year)
const yearlySetlistLength: Record<number, { totalSongs: number; shows: number }> = {};
setlists.forEach(s => {
  if (s.year > 0) {
    if (!yearlySetlistLength[s.year]) yearlySetlistLength[s.year] = { totalSongs: 0, shows: 0 };
    yearlySetlistLength[s.year].totalSongs += s.songCount || s.songs.length;
    yearlySetlistLength[s.year].shows++;
  }
});

const setlistLengthTrend = Object.entries(yearlySetlistLength)
  .map(([year, data]) => ({
    year: parseInt(year),
    avgSongs: Math.round(data.totalSongs / data.shows),
    shows: data.shows
  }))
  .sort((a, b) => a.year - b.year);

const maxAvgSongs = Math.max(...setlistLengthTrend.map(y => y.avgSongs), 1);

// Songs introduced per year (first time played)
const songsIntroduced: Record<number, string[]> = {};
playedSongs.forEach(song => {
  if (song.firstPlayed) {
    const year = new Date(song.firstPlayed).getFullYear();
    if (!songsIntroduced[year]) songsIntroduced[year] = [];
    songsIntroduced[year].push(song.songTitle);
  }
});

const introductionTrend = Object.entries(songsIntroduced)
  .map(([year, songs]) => ({ year: parseInt(year), count: songs.length, songs }))
  .sort((a, b) => a.year - b.year);

const maxIntroduced = Math.max(...introductionTrend.map(y => y.count), 1);

// Songs retired (last played before a certain year but never again)
const currentYear = new Date().getFullYear();
const recentlyRetired = playedSongs
  .filter(s => s.lastPlayed && new Date(s.lastPlayed).getFullYear() < currentYear - 5 && s.totalPlays > 10)
  .sort((a, b) => {
    const lastA = a.lastPlayed ? new Date(a.lastPlayed).getTime() : 0;
    const lastB = b.lastPlayed ? new Date(b.lastPlayed).getTime() : 0;
    return lastB - lastA;
  })
  .slice(0, 20);

// Era representation in setlists over time
const eraInSetlists: Record<number, Record<string, number>> = {};
const albumEraMap = new Map<string, AlbumEra>();
albums.forEach(a => {
  albumEraMap.set(a.title, getAlbumEra(a.releaseDate !== 'Unknown' ? a.releaseDate : undefined));
});

setlists.forEach(s => {
  if (s.year > 0) {
    if (!eraInSetlists[s.year]) eraInSetlists[s.year] = {};
    s.songs.forEach(song => {
      const songStat = allStats.find(st => st.songTitle === song.title);
      if (songStat) {
        const era = albumEraMap.get(songStat.albumTitle) || 'modern';
        eraInSetlists[s.year][era] = (eraInSetlists[s.year][era] || 0) + 1;
      }
    });
  }
});

// Longest and shortest setlists
const sortedByLength = [...setlists].sort((a, b) => {
  const lenA = a.songCount || a.songs.length;
  const lenB = b.songCount || b.songs.length;
  return lenB - lenA;
});
const longestSetlists = sortedByLength.slice(0, 10);
const shortestSetlists = sortedByLength.filter(s => (s.songCount || s.songs.length) > 0).reverse().slice(0, 10);

// Consistency score - songs that appear in most years
const songYearSpan = playedSongs
  .filter(s => s.yearsPlayed.length > 0)
  .map(s => ({
    title: s.songTitle,
    album: s.albumTitle,
    yearsActive: s.yearsPlayed.length,
    totalPlays: s.totalPlays,
    firstYear: Math.min(...s.yearsPlayed.map(y => y.year)),
    lastYear: Math.max(...s.yearsPlayed.map(y => y.year)),
  }))
  .sort((a, b) => b.yearsActive - a.yearsActive)
  .slice(0, 15);
---

<MainLayout
  title="Trends & Analysis"
  description="Historical trends and analysis of The Cure's live performances over the decades"
>
  <!-- Breadcrumb -->
  <nav class="mb-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-white/85">
      <li><a href="/stats" class="hover:text-white transition-colors">Statistics</a></li>
      <li aria-hidden="true">/</li>
      <li class="text-white">Trends</li>
    </ol>
  </nav>

  <!-- Hero -->
  <section class="mb-12">
    <div class="glass-panel overflow-hidden relative">
      <div class="absolute -top-20 -left-20 w-64 h-64 rounded-full bg-white/[0.06] blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-10 -right-10 w-48 h-48 rounded-full bg-accent/[0.06] blur-2xl pointer-events-none"></div>

      <div class="relative p-8 md:p-12">
        <h1 class="font-display text-5xl md:text-6xl lg:text-7xl text-white mb-4 text-glow">Trends & Analysis</h1>
        <p class="text-white/75 text-lg md:text-xl max-w-3xl leading-relaxed">
          How The Cure's live show has evolved over the decades — setlist length, song selection, and era representation.
        </p>
      </div>
    </div>
  </section>

  <!-- Setlist Length Trend -->
  <section class="mb-12">
    <div class="glass-panel p-6 md:p-8">
      <h2 class="text-2xl text-white mb-2 gothic-heading">Average Setlist Length by Year</h2>
      <p class="text-white/80 text-sm mb-6">How many songs per show on average</p>
      <div class="space-y-2">
        {setlistLengthTrend.map(year => (
          <div class="flex items-center gap-3">
            <span class="text-white/85 text-sm w-12 shrink-0 font-mono">{year.year}</span>
            <div class="flex-1 h-7 bg-white/5 rounded overflow-hidden relative">
              <div
                class="h-full bg-gradient-to-r from-green-500/70 to-emerald-400/50 rounded stat-bar-animated"
                style={`width: ${(year.avgSongs / maxAvgSongs) * 100}%`}
              ></div>
              <span class="absolute left-3 top-1/2 -translate-y-1/2 text-xs text-white font-mono font-bold">{year.avgSongs} songs</span>
            </div>
            <span class="text-white/75 text-xs w-16 text-right shrink-0">{year.shows} shows</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Most Consistent Songs -->
  <section class="mb-12">
    <div class="glass-panel p-6 md:p-8">
      <h2 class="text-2xl text-white mb-2 gothic-heading">Most Enduring Songs</h2>
      <p class="text-white/80 text-sm mb-6">Songs performed across the most years</p>
      <div class="space-y-3">
        {songYearSpan.map((song, idx) => (
          <div class="flex items-center gap-4 p-3 rounded-lg bg-white/[0.03] hover:bg-white/[0.06] transition-colors">
            <span class={`w-8 h-8 rounded-lg flex items-center justify-center text-sm font-bold shrink-0 ${
              idx < 3 ? 'bg-amber-500/20 text-amber-400' : 'bg-white/5 text-white/80'
            }`}>{idx + 1}</span>
            <div class="flex-1 min-w-0">
              <p class="text-white font-medium truncate">{song.title}</p>
              <p class="text-white/80 text-xs">{song.album}</p>
            </div>
            <div class="text-right shrink-0">
              <p class="text-amber-400 font-bold">{song.yearsActive} years</p>
              <p class="text-white/75 text-xs">{song.firstYear}-{song.lastYear}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Songs Introduced per Year + Retired Songs -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-12">
    <!-- New Songs per Year -->
    <section>
      <div class="glass-panel p-6 h-full">
        <h2 class="text-2xl text-white mb-2 gothic-heading">New Songs Debuted per Year</h2>
        <p class="text-white/80 text-sm mb-6">First-time live performances</p>
        <div class="space-y-2">
          {introductionTrend.map(year => (
            <div class="flex items-center gap-3">
              <span class="text-white/85 text-xs w-10 shrink-0 font-mono">{year.year}</span>
              <div class="flex-1 h-5 bg-white/5 rounded overflow-hidden relative">
                <div
                  class="h-full bg-gradient-to-r from-purple-500/70 to-pink-400/50 rounded"
                  style={`width: ${(year.count / maxIntroduced) * 100}%`}
                ></div>
              </div>
              <span class="text-purple-400 text-xs w-8 text-right shrink-0 font-bold">{year.count}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Recently Retired Songs -->
    <section>
      <div class="glass-panel p-6 h-full">
        <h2 class="text-2xl text-white mb-2 gothic-heading">Retired Setlist Staples</h2>
        <p class="text-white/80 text-sm mb-6">Popular songs not played in 5+ years</p>
        {recentlyRetired.length > 0 ? (
          <div class="space-y-2">
            {recentlyRetired.map(song => (
              <div class="flex items-center justify-between p-3 rounded-lg bg-white/[0.03]">
                <div class="min-w-0">
                  <p class="text-white truncate text-sm">{song.songTitle}</p>
                  <p class="text-white/80 text-xs">{song.albumTitle}</p>
                </div>
                <div class="text-right shrink-0 ml-3">
                  <p class="text-red-400/80 text-xs">Last: {song.lastPlayed ? new Date(song.lastPlayed).getFullYear() : '?'}</p>
                  <p class="text-white/75 text-xs">{song.totalPlays} plays total</p>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <p class="text-white/80 text-center py-8">No retired songs data available</p>
        )}
      </div>
    </section>
  </div>

  <!-- Longest/Shortest Setlists -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-12">
    <section>
      <div class="glass-panel p-6 h-full">
        <h2 class="text-2xl text-white mb-6 gothic-heading">Longest Setlists</h2>
        <div class="space-y-2">
          {longestSetlists.map((setlist, idx) => (
            <a href={`/setlists/${setlist.slug}`} class="flex items-center justify-between p-3 rounded-lg bg-white/[0.03] hover:bg-white/[0.06] transition-colors block">
              <div class="flex items-center gap-3 min-w-0">
                <span class="text-green-400/60 text-sm w-5 shrink-0">{idx + 1}.</span>
                <div class="min-w-0">
                  <p class="text-white truncate text-sm">{setlist.venue}</p>
                  <p class="text-white/80 text-xs">{setlist.location} · {setlist.formattedDate}</p>
                </div>
              </div>
              <span class="text-green-400 font-bold shrink-0 ml-3">{setlist.songCount || setlist.songs.length} songs</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section>
      <div class="glass-panel p-6 h-full">
        <h2 class="text-2xl text-white mb-6 gothic-heading">Shortest Setlists</h2>
        <div class="space-y-2">
          {shortestSetlists.map((setlist, idx) => (
            <a href={`/setlists/${setlist.slug}`} class="flex items-center justify-between p-3 rounded-lg bg-white/[0.03] hover:bg-white/[0.06] transition-colors block">
              <div class="flex items-center gap-3 min-w-0">
                <span class="text-red-400/60 text-sm w-5 shrink-0">{idx + 1}.</span>
                <div class="min-w-0">
                  <p class="text-white truncate text-sm">{setlist.venue}</p>
                  <p class="text-white/80 text-xs">{setlist.location} · {setlist.formattedDate}</p>
                </div>
              </div>
              <span class="text-red-400 font-bold shrink-0 ml-3">{setlist.songCount || setlist.songs.length} songs</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </div>

  <div class="text-center">
    <a href="/stats" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-white/10 border border-primary/40 text-white hover:bg-primary/30 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
      Back to Statistics
    </a>
  </div>
</MainLayout>
