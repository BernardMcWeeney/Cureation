---
import MainLayout from '../../layouts/MainLayout.astro';
import PageFilter from '../../components/PageFilter.astro';
import {
  getOverallStats,
  getMostPlayedSongs,
  getRarestSongs,
  getTourStatistics,
  getSetlistsWithSongs,
  getSongStatistics,
  fetchAlbums,
  formatAlbum,
} from '../../lib/directus';

// Fetch all stats data
const [overallStats, mostPlayed, rarestSongs, tourStats, setlists, songStats, rawAlbums] = await Promise.all([
  getOverallStats(),
  getMostPlayedSongs(15),
  getRarestSongs(10),
  getTourStatistics(),
  getSetlistsWithSongs(),
  getSongStatistics(),
  fetchAlbums(),
]);

const albums = rawAlbums.map(formatAlbum);
const maxPlays = mostPlayed[0]?.totalPlays || 1;

// Recently played songs (from latest setlists)
const recentSetlists = setlists.slice(0, 5);

// Year with most shows
const showsByYear: Record<number, number> = {};
setlists.forEach(s => { if (s.year > 0) showsByYear[s.year] = (showsByYear[s.year] || 0) + 1; });
const busiestYear = Object.entries(showsByYear).sort(([,a], [,b]) => b - a)[0];

// Song stats insights
const playedSongs = songStats.filter(s => s.totalPlays > 0);
const neverPlayed = songStats.filter(s => s.totalPlays === 0);
const totalPerformances = playedSongs.reduce((sum, s) => sum + s.totalPlays, 0);

// Albums by type
const studioCount = albums.filter(a => a.type === 'studio').length;
const liveCount = albums.filter(a => a.type === 'live').length;
const compCount = albums.filter(a => a.type === 'compilation').length;
---

<MainLayout
  title="Statistics"
  description="Data and insights about The Cure - most played songs, tour statistics, and more"
>
  {/* Hero section */}
  <section class="mb-10">
    <div class="glass-panel overflow-hidden relative">
      <div class="absolute -top-20 -left-20 w-64 h-64 rounded-full bg-primary/10 blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-10 -right-10 w-48 h-48 rounded-full bg-accent/[0.06] blur-2xl pointer-events-none"></div>

      <div class="relative p-8 md:p-12">
        <h1 class="font-display text-5xl md:text-6xl lg:text-7xl text-white mb-4 text-glow">Statistics</h1>
        <p class="text-white/75 text-lg md:text-xl max-w-3xl leading-relaxed">
          Dive into the data behind The Cure's legendary career — song frequencies,
          tour statistics, chart performance, and more.
        </p>

        <div class="flex flex-wrap gap-8 mt-8 pt-6 border-t border-white/[0.08]">
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-primary text-glow">{overallStats.yearsActive}</span>
            <span class="text-white/60 text-base font-medium">Years Active</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-primary text-glow">{overallStats.totalShows.toLocaleString()}</span>
            <span class="text-white/60 text-base font-medium">Live Shows</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-primary text-glow">{overallStats.totalSongs}</span>
            <span class="text-white/60 text-base font-medium">Songs</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-primary text-glow">{overallStats.countriesVisited}</span>
            <span class="text-white/60 text-base font-medium">Countries</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Search & Filters -->
  <section class="mb-8">
    <div class="mb-4">
      <PageFilter id="stats" placeholder="Search statistics..." />
    </div>

    <!-- Type Tabs -->
    <nav class="overflow-x-auto scrollbar-hide">
      <div class="flex gap-2 min-w-max pb-2">
      <a href="/stats" class="type-tab flex items-center gap-2 px-4 py-2.5 rounded-sm text-sm font-medium transition-all whitespace-nowrap tracking-wide active">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 6h16M4 10h16M4 14h16M4 18h16" />
        </svg>
        Overview
      </a>
      <a href="/stats/songs" class="type-tab flex items-center gap-2 px-4 py-2.5 rounded-sm text-sm font-medium transition-all whitespace-nowrap tracking-wide">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 19V6l12-3v12M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
        </svg>
        Song Stats
      </a>
      <a href="/stats/tours" class="type-tab flex items-center gap-2 px-4 py-2.5 rounded-sm text-sm font-medium transition-all whitespace-nowrap tracking-wide">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Tour Stats
      </a>
      <a href="/stats/charts" class="type-tab flex items-center gap-2 px-4 py-2.5 rounded-sm text-sm font-medium transition-all whitespace-nowrap tracking-wide">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
        Charts
      </a>
      <a href="/stats/trends" class="type-tab flex items-center gap-2 px-4 py-2.5 rounded-sm text-sm font-medium transition-all whitespace-nowrap tracking-wide">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
        </svg>
        Trends
      </a>
    </div>
    </nav>
  </section>

  {/* Key Insights Row */}
  <section class="mb-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {/* Most Played */}
      <div class="glass-tile p-6 gothic-corners">
        <div class="flex items-center gap-2 mb-3">
          <div class="w-2 h-2 bg-yellow-400 rounded-full"></div>
          <span class="text-white/50 text-xs uppercase tracking-wider">Most Played Song</span>
        </div>
        <h3 class="text-white text-lg font-heading mb-1">{overallStats.mostPlayedSong.songTitle}</h3>
        <p class="text-primary font-bold text-2xl">{overallStats.mostPlayedSong.totalPlays.toLocaleString()} plays</p>
        <p class="text-white/40 text-xs mt-1">{overallStats.mostPlayedSong.albumTitle}</p>
      </div>

      {/* Rarest Played */}
      <div class="glass-tile p-6 gothic-corners">
        <div class="flex items-center gap-2 mb-3">
          <div class="w-2 h-2 bg-purple-400 rounded-full"></div>
          <span class="text-white/50 text-xs uppercase tracking-wider">Rarest Song Played</span>
        </div>
        <h3 class="text-white text-lg font-heading mb-1">{overallStats.rarestSong.songTitle}</h3>
        <p class="text-purple-400 font-bold text-2xl">{overallStats.rarestSong.totalPlays} plays</p>
        <p class="text-white/40 text-xs mt-1">{overallStats.rarestSong.albumTitle}</p>
      </div>

      {/* Busiest Year */}
      {busiestYear && (
        <div class="glass-tile p-6 gothic-corners">
          <div class="flex items-center gap-2 mb-3">
            <div class="w-2 h-2 bg-green-400 rounded-full"></div>
            <span class="text-white/50 text-xs uppercase tracking-wider">Busiest Year</span>
          </div>
          <h3 class="text-white text-lg font-heading mb-1">{busiestYear[0]}</h3>
          <p class="text-green-400 font-bold text-2xl">{busiestYear[1]} shows</p>
          <p class="text-white/40 text-xs mt-1">Most concerts in a single year</p>
        </div>
      )}
    </div>
  </section>

  {/* More Key Numbers */}
  <section class="mb-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="glass-stat p-5 text-center stained-glass">
        <p class="text-2xl font-bold text-white">{totalPerformances.toLocaleString()}</p>
        <p class="text-xs text-white/50 mt-1">Total Song Performances</p>
      </div>
      <div class="glass-stat p-5 text-center stained-glass">
        <p class="text-2xl font-bold text-white">{playedSongs.length}</p>
        <p class="text-xs text-white/50 mt-1">Songs Played Live</p>
      </div>
      <div class="glass-stat p-5 text-center stained-glass">
        <p class="text-2xl font-bold text-white">{neverPlayed.length}</p>
        <p class="text-xs text-white/50 mt-1">Never Played Live</p>
      </div>
      <div class="glass-stat p-5 text-center stained-glass">
        <p class="text-2xl font-bold text-white">{studioCount} / {liveCount} / {compCount}</p>
        <p class="text-xs text-white/50 mt-1">Studio / Live / Compilations</p>
      </div>
    </div>
  </section>

  {/* Most played songs */}
  <section class="mb-12">
    <div class="glass-panel p-6 md:p-8 relative overflow-hidden">
      <h2 class="text-2xl text-white mb-6 flex items-center gap-3 gothic-heading">
        Most Played Songs
      </h2>

      {mostPlayed.length > 0 ? (
        <div class="space-y-4">
          {mostPlayed.map((song, index) => (
            <div class="flex items-center gap-4" data-filter-item data-filter-text={`${song.songTitle} ${song.albumTitle}`}>
              <span class={`w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold ${
                index === 0 ? 'bg-yellow-500/20 text-yellow-400' :
                index === 1 ? 'bg-gray-400/20 text-gray-300' :
                index === 2 ? 'bg-amber-600/20 text-amber-500' :
                'bg-white/5 text-white/40'
              }`}>
                {index + 1}
              </span>
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between mb-1">
                  <a
                    href={`/lyrics/search?q=${encodeURIComponent(song.songTitle)}`}
                    class="text-white hover:text-primary transition-colors truncate"
                  >
                    {song.songTitle}
                  </a>
                  <span class="text-white/60 text-sm ml-4 shrink-0">
                    {song.totalPlays.toLocaleString()} plays
                  </span>
                </div>
                <div class="h-2 bg-white/5 rounded-full overflow-hidden">
                  <div
                    class="h-full bg-gradient-to-r from-primary to-accent rounded-full stat-bar-animated"
                    style={`width: ${(song.totalPlays / maxPlays) * 100}%`}
                  ></div>
                </div>
                <p class="text-white/40 text-xs mt-1">{song.albumTitle}</p>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <p class="text-white/60 text-center py-8">No play statistics available yet.</p>
      )}

      <div class="mt-6 pt-4 border-t border-white/10 text-center">
        <a href="/stats/songs" class="text-primary hover:text-primary/80 text-sm font-medium transition-colors">
          View all song statistics &rarr;
        </a>
      </div>
    </div>
  </section>

  {/* Rarest songs and Tour stats side by side */}
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-12">
    {/* Rarest songs */}
    <section>
      <div class="glass-panel p-6 h-full relative overflow-hidden">
        <h2 class="text-2xl text-white mb-6 flex items-center gap-3 gothic-heading">
          Rarest Songs
        </h2>

        {rarestSongs.length > 0 ? (
          <ul class="space-y-3">
            {rarestSongs.map((song, index) => (
              <li class="flex items-center justify-between p-3 rounded-lg bg-white/5 hover:bg-white/10 transition-colors" data-filter-item data-filter-text={`${song.songTitle} ${song.albumTitle}`}>
                <div class="flex items-center gap-3 min-w-0">
                  <span class="text-white/40 text-sm w-5">{index + 1}.</span>
                  <div class="min-w-0">
                    <p class="text-white truncate">{song.songTitle}</p>
                    <p class="text-white/40 text-xs">{song.albumTitle}</p>
                  </div>
                </div>
                <div class="text-right shrink-0 ml-4">
                  <p class="text-purple-400 font-medium">{song.totalPlays}</p>
                  <p class="text-white/40 text-xs">plays</p>
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-white/60 text-center py-8">No rarest songs data available.</p>
        )}

        <div class="mt-6 pt-4 border-t border-white/10 text-center">
          <a href="/stats/songs" class="text-primary hover:text-primary/80 text-sm font-medium transition-colors">
            View full song analysis &rarr;
          </a>
        </div>
      </div>
    </section>

    {/* Tour statistics */}
    <section>
      <div class="glass-panel p-6 h-full">
        <h2 class="text-2xl text-white mb-6 flex items-center gap-3 gothic-heading">
          Tour Statistics
        </h2>

        {tourStats.length > 0 ? (
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-white/10">
                  <th class="text-left py-2 text-white/50 font-medium">Tour</th>
                  <th class="text-right py-2 text-white/50 font-medium">Year</th>
                  <th class="text-right py-2 text-white/50 font-medium">Shows</th>
                  <th class="text-right py-2 text-white/50 font-medium">Countries</th>
                </tr>
              </thead>
              <tbody>
                {tourStats.slice(0, 10).map(tour => (
                  <tr class="border-b border-white/5 hover:bg-white/5 transition-colors">
                    <td class="py-3 text-white">{tour.name}</td>
                    <td class="py-3 text-white/60 text-right">{tour.year}</td>
                    <td class="py-3 text-white/60 text-right">{tour.totalShows}</td>
                    <td class="py-3 text-white/60 text-right">{tour.countries.length}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p class="text-white/60 text-center py-8">No tour statistics available.</p>
        )}

        <div class="mt-6 pt-4 border-t border-white/10 text-center">
          <a href="/stats/tours" class="text-primary hover:text-primary/80 text-sm font-medium transition-colors">
            View all tour statistics &rarr;
          </a>
        </div>
      </div>
    </section>
  </div>

</MainLayout>

<style>
  section li {
    transition: all 0.3s ease;
  }

  .type-tab {
    color: rgba(255, 255, 255, 0.45);
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }
  .type-tab:hover {
    color: rgba(255, 255, 255, 0.85);
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.1);
  }
  .type-tab.active {
    background: rgba(var(--color-primary-rgb, 137, 176, 201), 0.12);
    color: var(--color-primary);
    border-color: rgba(var(--color-primary-rgb, 137, 176, 201), 0.25);
  }

  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
  .scrollbar-hide::-webkit-scrollbar { display: none; }
</style>
