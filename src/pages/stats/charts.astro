---
import MainLayout from '../../layouts/MainLayout.astro';
import GothicCobweb from '../../components/GothicCobweb.astro';
import GothicSwirls from '../../components/GothicSwirls.astro';
import { fetchAlbums, formatAlbum, fetchSingles, formatSingle } from '../../lib/directus';

const albums = await fetchAlbums();
const singles = await fetchSingles();

const formattedAlbums = albums.map(formatAlbum).sort((a, b) => {
  if (!a.year) return 1;
  if (!b.year) return -1;
  return parseInt(a.year) - parseInt(b.year);
});

// Singles with chart data
const singlesWithCharts = singles
  .filter(s => s.chart_position && s.chart_position.length > 0)
  .map(s => ({
    ...formatSingle(s),
    albumId: s.album,
    albumTitle: albums.find(a => a.id === s.album)?.title || 'Unknown',
  }))
  .sort((a, b) => {
    // Sort by best chart position
    const bestA = Math.min(...a.chartPositions.map(p => p.chart_position));
    const bestB = Math.min(...b.chartPositions.map(p => p.chart_position));
    return bestA - bestB;
  });

// Album timeline data
const studioAlbums = formattedAlbums.filter(a => a.type === 'studio');

// Chart positions by country
const countryCharts: Record<string, { title: string; position: number }[]> = {};
singlesWithCharts.forEach(single => {
  single.chartPositions.forEach(pos => {
    const country = pos.country || 'Unknown';
    if (!countryCharts[country]) countryCharts[country] = [];
    countryCharts[country].push({ title: single.title, position: pos.chart_position });
  });
});

// Sort countries by number of entries
const sortedCountries = Object.entries(countryCharts)
  .sort(([, a], [, b]) => b.length - a.length);

// UK #1 singles
const ukNumberOnes = singlesWithCharts.filter(s =>
  s.chartPositions.some(p => p.country === 'UK' && p.chart_position === 1)
);

// Top 10 hits across all countries
const top10Hits = singlesWithCharts.filter(s =>
  s.chartPositions.some(p => p.chart_position <= 10)
);
---

<MainLayout
  title="Chart History"
  description="The Cure chart history - UK, US, and worldwide chart positions for singles and albums"
>
  <div class="relative">
    <GothicCobweb position="top-right" size="lg" opacity={0.08} />
  </div>

  <!-- Breadcrumb -->
  <nav class="mb-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-white/60">
      <li><a href="/stats" class="hover:text-primary transition-colors">Statistics</a></li>
      <li aria-hidden="true">/</li>
      <li class="text-white">Chart History</li>
    </ol>
  </nav>

  <!-- Hero -->
  <section class="mb-12">
    <div class="glass-panel p-8 md:p-10 relative overflow-hidden gothic-corners bg-cobweb">
      <GothicCobweb position="top-left" size="md" opacity={0.1} />
      <h1 class="text-4xl md:text-5xl text-white mb-4 section-header">Chart History</h1>
      <p class="text-white/60 text-lg max-w-2xl mb-8 mt-6">
        The Cure's chart journey - from post-punk obscurity to global hit-makers.
      </p>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="glass-stat p-4 text-center">
          <p class="text-3xl font-bold text-primary">{singlesWithCharts.length}</p>
          <p class="text-sm text-white/50 mt-1">Charting Singles</p>
        </div>
        <div class="glass-stat p-4 text-center">
          <p class="text-3xl font-bold text-yellow-400">{ukNumberOnes.length}</p>
          <p class="text-sm text-white/50 mt-1">UK #1 Singles</p>
        </div>
        <div class="glass-stat p-4 text-center">
          <p class="text-3xl font-bold text-green-400">{top10Hits.length}</p>
          <p class="text-sm text-white/50 mt-1">Top 10 Hits</p>
        </div>
        <div class="glass-stat p-4 text-center">
          <p class="text-3xl font-bold text-blue-400">{sortedCountries.length}</p>
          <p class="text-sm text-white/50 mt-1">Countries Charted</p>
        </div>
      </div>
    </div>
  </section>

  <GothicSwirls position="divider" />

  <!-- Singles Chart Performance -->
  <section class="mb-12">
    <div class="glass-panel p-6 md:p-8">
      <h2 class="text-2xl text-white mb-6 gothic-heading">Singles - Best Chart Positions</h2>
      {singlesWithCharts.length > 0 ? (
        <div class="space-y-3">
          {singlesWithCharts.map((single, idx) => {
            const bestPosition = Math.min(...single.chartPositions.map(p => p.chart_position));
            return (
              <div class="flex items-center gap-4 p-4 rounded-lg bg-white/[0.03] hover:bg-white/[0.06] transition-colors cure-rose-border">
                <div class={`w-12 h-12 rounded-lg flex items-center justify-center text-lg font-bold shrink-0 ${
                  bestPosition === 1 ? 'bg-yellow-500/20 text-yellow-400 ring-1 ring-yellow-500/30' :
                  bestPosition <= 5 ? 'bg-green-500/20 text-green-400' :
                  bestPosition <= 10 ? 'bg-blue-500/20 text-blue-400' :
                  bestPosition <= 20 ? 'bg-purple-500/20 text-purple-400' :
                  'bg-white/5 text-white/50'
                }`}>
                  #{bestPosition}
                </div>
                <div class="flex-1 min-w-0">
                  <h3 class="text-white font-medium truncate">{single.title}</h3>
                  <p class="text-white/50 text-xs mt-0.5">{single.releaseDate} · {single.albumTitle}</p>
                  <div class="flex flex-wrap gap-1.5 mt-2">
                    {single.chartPositions.map(pos => (
                      <span class={`text-xs px-2 py-0.5 rounded-full ${
                        pos.chart_position <= 5 ? 'bg-green-500/15 text-green-400 border border-green-500/20' :
                        pos.chart_position <= 10 ? 'bg-blue-500/15 text-blue-400 border border-blue-500/20' :
                        pos.chart_position <= 20 ? 'bg-purple-500/15 text-purple-400 border border-purple-500/20' :
                        'bg-white/5 text-white/50 border border-white/10'
                      }`}>
                        #{pos.chart_position} {pos.country}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      ) : (
        <div class="text-center py-12">
          <p class="text-white/50 text-lg mb-2">Chart data not yet available</p>
          <p class="text-white/30 text-sm">Chart positions will appear here once added to the database</p>
        </div>
      )}
    </div>
  </section>

  <!-- Albums Timeline -->
  <section class="mb-12">
    <div class="glass-panel p-6 md:p-8">
      <h2 class="text-2xl text-white mb-6 gothic-heading">Studio Albums Timeline</h2>
      <div class="relative">
        <!-- Timeline line -->
        <div class="absolute left-6 top-0 bottom-0 w-px bg-white/10"></div>

        <div class="space-y-6">
          {studioAlbums.map((album, idx) => (
            <div class="flex gap-6 items-start relative">
              <div class="w-12 h-12 rounded-lg bg-primary/20 border border-primary/30 flex items-center justify-center shrink-0 z-10">
                <span class="text-primary font-bold text-sm">{album.year}</span>
              </div>
              <div class="glass-stat p-4 flex-1">
                <a href={`/discography/${album.slug}`} class="text-white font-medium hover:text-primary transition-colors">
                  {album.title}
                </a>
                <p class="text-white/50 text-xs mt-1">{album.releaseDate} · {album.recordLabel}</p>
                {album.genreTags.length > 0 && (
                  <div class="flex flex-wrap gap-1 mt-2">
                    {album.genreTags.slice(0, 4).map(tag => (
                      <span class="text-xs px-2 py-0.5 rounded bg-white/5 text-white/50">{tag}</span>
                    ))}
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Charts by Country -->
  {sortedCountries.length > 0 && (
    <section class="mb-12">
      <div class="glass-panel p-6 md:p-8">
        <h2 class="text-2xl text-white mb-6 gothic-heading">Chart Entries by Country</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {sortedCountries.map(([country, entries]) => (
            <div class="glass-stat p-4">
              <div class="flex items-center justify-between mb-3">
                <h3 class="text-white font-medium">{country}</h3>
                <span class="text-primary font-bold">{entries.length} entries</span>
              </div>
              <div class="space-y-1">
                {entries.sort((a, b) => a.position - b.position).slice(0, 5).map(entry => (
                  <div class="flex items-center justify-between text-sm">
                    <span class="text-white/60 truncate">{entry.title}</span>
                    <span class={`shrink-0 ml-2 font-mono ${
                      entry.position <= 5 ? 'text-green-400' :
                      entry.position <= 10 ? 'text-blue-400' :
                      'text-white/40'
                    }`}>#{entry.position}</span>
                  </div>
                ))}
                {entries.length > 5 && (
                  <p class="text-white/30 text-xs mt-1">+{entries.length - 5} more</p>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <div class="text-center">
    <a href="/stats" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-primary/20 border border-primary/40 text-white hover:bg-primary/30 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
      Back to Statistics
    </a>
  </div>
</MainLayout>
