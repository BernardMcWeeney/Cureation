---
import MainLayout from '../../layouts/MainLayout.astro';
import { getSongStatistics, fetchAlbums, formatAlbum } from '../../lib/directus';

const allStats = await getSongStatistics();
const albums = await fetchAlbums();
const formattedAlbums = albums.map(formatAlbum);

// Songs that have been played
const playedSongs = allStats.filter(s => s.totalPlays > 0);
const neverPlayed = allStats.filter(s => s.totalPlays === 0);

// Top 50 most played
const top50 = playedSongs.slice(0, 50);
const maxPlays = top50[0]?.totalPlays || 1;

// Songs by album
const songsByAlbum: Record<string, typeof allStats> = {};
allStats.forEach(song => {
  const album = song.albumTitle || 'Unknown';
  if (!songsByAlbum[album]) songsByAlbum[album] = [];
  songsByAlbum[album].push(song);
});

// Sort albums by total plays
const albumPlayCounts = Object.entries(songsByAlbum).map(([album, songs]) => ({
  album,
  totalPlays: songs.reduce((sum, s) => sum + s.totalPlays, 0),
  songCount: songs.length,
  playedCount: songs.filter(s => s.totalPlays > 0).length,
})).sort((a, b) => b.totalPlays - a.totalPlays);

// Most played by decade
const songsByDecade: Record<string, typeof allStats> = {};
playedSongs.forEach(song => {
  if (song.firstPlayed) {
    const decade = `${Math.floor(new Date(song.firstPlayed).getFullYear() / 10) * 10}s`;
    if (!songsByDecade[decade]) songsByDecade[decade] = [];
    songsByDecade[decade].push(song);
  }
});

const totalPlays = playedSongs.reduce((sum, s) => sum + s.totalPlays, 0);
const avgPlays = playedSongs.length > 0 ? Math.round(totalPlays / playedSongs.length) : 0;
---

<MainLayout
  title="Song Statistics"
  description="Detailed song statistics for The Cure - most played, rarest, and never played songs"
>
  <!-- Breadcrumb -->
  <nav class="mb-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-white/60">
      <li><a href="/stats" class="hover:text-primary transition-colors">Statistics</a></li>
      <li aria-hidden="true">/</li>
      <li class="text-white">Song Stats</li>
    </ol>
  </nav>

  <!-- Hero -->
  <section class="mb-12">
    <div class="glass-panel overflow-hidden relative">
      <div class="absolute -top-20 -left-20 w-64 h-64 rounded-full bg-primary/10 blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-10 -right-10 w-48 h-48 rounded-full bg-accent/[0.06] blur-2xl pointer-events-none"></div>

      <div class="relative p-8 md:p-12">
        <h1 class="font-display text-5xl md:text-6xl lg:text-7xl text-white mb-4 text-glow">Song Statistics</h1>
        <p class="text-white/75 text-lg md:text-xl max-w-3xl leading-relaxed">
          Deep dive into every song The Cure has performed live — play counts, rarity, and more.
        </p>

        <div class="flex flex-wrap gap-8 mt-8 pt-6 border-t border-white/[0.08]">
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-primary text-glow">{allStats.length}</span>
            <span class="text-white/60 text-base font-medium">Total Songs</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-primary text-glow">{playedSongs.length}</span>
            <span class="text-white/60 text-base font-medium">Played Live</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-primary text-glow">{neverPlayed.length}</span>
            <span class="text-white/60 text-base font-medium">Never Played</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-primary text-glow">{totalPlays.toLocaleString()}</span>
            <span class="text-white/60 text-base font-medium">Total Performances</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-primary text-glow">{avgPlays}</span>
            <span class="text-white/60 text-base font-medium">Avg Plays/Song</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Top 50 Most Played -->
  <section class="mb-12">
    <div class="glass-panel p-6 md:p-8 relative overflow-hidden">
      <h2 class="text-2xl text-white mb-6 flex items-center gap-3 gothic-heading">
        Top 50 Most Played Songs
      </h2>

      <div class="space-y-3">
        {top50.map((song, index) => (
          <div class="flex items-center gap-4 p-3 rounded-lg bg-white/[0.03] hover:bg-white/[0.06] transition-colors cure-rose-border">
            <span class={`w-10 h-10 rounded-lg flex items-center justify-center text-sm font-bold shrink-0 ${
              index === 0 ? 'bg-yellow-500/20 text-yellow-400 ring-1 ring-yellow-500/30' :
              index === 1 ? 'bg-gray-400/20 text-gray-300 ring-1 ring-gray-400/30' :
              index === 2 ? 'bg-amber-600/20 text-amber-500 ring-1 ring-amber-600/30' :
              index < 10 ? 'bg-primary/10 text-primary' :
              'bg-white/5 text-white/40'
            }`}>
              {index + 1}
            </span>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between mb-1">
                <a href={`/lyrics/search?q=${encodeURIComponent(song.songTitle)}`} class="text-white hover:text-primary transition-colors truncate font-medium">
                  {song.songTitle}
                </a>
                <span class="text-white/60 text-sm ml-4 shrink-0 font-mono">
                  {song.totalPlays.toLocaleString()}
                </span>
              </div>
              <div class="h-1.5 bg-white/5 rounded-full overflow-hidden">
                <div
                  class="h-full bg-gradient-to-r from-primary to-accent rounded-full stat-bar-animated"
                  style={`width: ${(song.totalPlays / maxPlays) * 100}%`}
                ></div>
              </div>
              <div class="flex items-center gap-4 mt-1">
                <p class="text-white/40 text-xs">{song.albumTitle}</p>
                {song.firstPlayed && (
                  <p class="text-white/30 text-xs">First: {new Date(song.firstPlayed).getFullYear()}</p>
                )}
                {song.lastPlayed && (
                  <p class="text-white/30 text-xs">Last: {new Date(song.lastPlayed).getFullYear()}</p>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Album Play Counts -->
  <section class="mb-12">
    <div class="glass-panel p-6 md:p-8">
      <h2 class="text-2xl text-white mb-6 gothic-heading">Songs by Album - Play Counts</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {albumPlayCounts.filter(a => a.totalPlays > 0).map((album, idx) => (
          <div class="glass-stat p-4 flex items-center gap-4">
            <span class={`w-8 h-8 rounded-lg flex items-center justify-center text-xs font-bold shrink-0 ${
              idx < 3 ? 'bg-primary/20 text-primary' : 'bg-white/5 text-white/40'
            }`}>{idx + 1}</span>
            <div class="flex-1 min-w-0">
              <p class="text-white font-medium truncate">{album.album}</p>
              <div class="flex items-center gap-3 text-xs text-white/50 mt-1">
                <span>{album.totalPlays.toLocaleString()} total plays</span>
                <span>{album.playedCount}/{album.songCount} songs played</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Rarest Songs (full list) -->
  <section class="mb-12">
    <div class="glass-panel p-6 md:p-8">
      <h2 class="text-2xl text-white mb-6 gothic-heading">25 Rarest Songs (Played at Least Once)</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
        {playedSongs.sort((a, b) => a.totalPlays - b.totalPlays).slice(0, 25).map((song, index) => (
          <div class="flex items-center justify-between p-3 rounded-lg bg-white/[0.03] hover:bg-white/[0.06] transition-colors">
            <div class="flex items-center gap-3 min-w-0">
              <span class="text-purple-400/60 text-sm w-5 shrink-0">{index + 1}.</span>
              <div class="min-w-0">
                <p class="text-white truncate text-sm">{song.songTitle}</p>
                <p class="text-white/40 text-xs">{song.albumTitle}</p>
              </div>
            </div>
            <div class="text-right shrink-0 ml-3">
              <p class="text-purple-400 font-bold">{song.totalPlays}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Never Played -->
  {neverPlayed.length > 0 && (
    <section class="mb-12">
      <div class="glass-panel p-6 md:p-8">
        <h2 class="text-2xl text-white mb-2 gothic-heading">Never Played Live</h2>
        <p class="text-white/50 text-sm mb-6">{neverPlayed.length} songs from the catalog have never been performed live</p>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2">
          {neverPlayed.map(song => (
            <div class="p-2 rounded bg-white/[0.02] text-sm">
              <p class="text-white/60 truncate">{song.songTitle}</p>
              <p class="text-white/30 text-xs truncate">{song.albumTitle}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Back navigation -->
  <div class="text-center">
    <a href="/stats" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-primary/20 border border-primary/40 text-white hover:bg-primary/30 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
      Back to Statistics
    </a>
  </div>
</MainLayout>
