---
import MainLayout from '../../layouts/MainLayout.astro';
import { getForumCategories, getForumThreads } from '../../lib/directus';

// Fetch forum data
const [categories, recentThreads] = await Promise.all([
  getForumCategories(),
  getForumThreads()
]);

// Calculate total stats
const totalThreads = categories.reduce((sum, cat) => sum + cat.threadCount, 0);
const totalPosts = categories.reduce((sum, cat) => sum + cat.postCount, 0);

// Category icons
const categoryIcons: Record<string, string> = {
  general: `<svg xmlns="http://www.w3.org/2000/svg" class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z" /></svg>`,
  albums: `<svg xmlns="http://www.w3.org/2000/svg" class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v12M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" /></svg>`,
  concerts: `<svg xmlns="http://www.w3.org/2000/svg" class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" /></svg>`,
  collecting: `<svg xmlns="http://www.w3.org/2000/svg" class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>`,
  'off-topic': `<svg xmlns="http://www.w3.org/2000/svg" class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>`,
  'site-feedback': `<svg xmlns="http://www.w3.org/2000/svg" class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" /></svg>`
};
---

<MainLayout
  title="Community Forums"
  description="Join the Cureation community - discuss albums, share concert experiences, and connect with fellow fans"
>
  {/* Hero section */}
  <section class="mb-12">
    <div class="glass-panel p-8 md:p-10">
      <h1 class="text-4xl md:text-5xl text-white mb-4 section-header">Community Forums</h1>
      <p class="text-white/60 text-lg max-w-2xl mb-8">
        Join fellow fans in discussing The Cure's music, sharing concert experiences,
        trading collectibles, and connecting with the community.
      </p>

      <div class="flex flex-wrap gap-6 mb-8">
        <div class="text-center">
          <p class="text-3xl font-bold text-primary">{categories.length}</p>
          <p class="text-sm text-white/50">Categories</p>
        </div>
        <div class="text-center">
          <p class="text-3xl font-bold text-primary">{totalThreads.toLocaleString()}</p>
          <p class="text-sm text-white/50">Threads</p>
        </div>
        <div class="text-center">
          <p class="text-3xl font-bold text-primary">{totalPosts.toLocaleString()}</p>
          <p class="text-sm text-white/50">Posts</p>
        </div>
      </div>

      {/* CTA buttons */}
      <div class="flex flex-wrap gap-4">
        <a
          href="/community/forums/new"
          class="glass-button px-6 py-3 rounded-xl text-white hover:text-primary transition-colors inline-flex items-center gap-2"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
          </svg>
          New Thread
        </a>
        <a
          href="/community/guidelines"
          class="text-white/60 hover:text-white transition-colors inline-flex items-center gap-2 px-4"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Community Guidelines
        </a>
      </div>
    </div>
  </section>

  {/* Forum categories */}
  <section class="mb-12">
    <h2 class="text-2xl text-white mb-6">Forum Categories</h2>

    {categories.length > 0 ? (
      <div class="space-y-4">
        {categories.map(category => (
          <a href={`/community/forums/${category.slug}`} class="group block">
            <div class="glass-tile p-5">
              <div class="flex items-center gap-5">
                {/* Icon */}
                <div class="p-3 rounded-xl bg-primary/20 text-primary shrink-0 group-hover:bg-primary/30 transition-colors">
                  <span set:html={categoryIcons[category.slug] || categoryIcons.general} />
                </div>

                {/* Content */}
                <div class="flex-1 min-w-0">
                  <h3 class="text-lg font-heading text-white group-hover:text-primary transition-colors">
                    {category.name}
                  </h3>
                  <p class="text-white/60 text-sm mt-1 line-clamp-1">
                    {category.description || 'Discuss topics related to ' + category.name.toLowerCase()}
                  </p>
                </div>

                {/* Stats */}
                <div class="hidden md:flex items-center gap-8 text-center shrink-0">
                  <div>
                    <p class="text-white font-medium">{category.threadCount}</p>
                    <p class="text-white/40 text-xs">Threads</p>
                  </div>
                  <div>
                    <p class="text-white font-medium">{category.postCount}</p>
                    <p class="text-white/40 text-xs">Posts</p>
                  </div>
                </div>

                {/* Arrow */}
                <svg xmlns="http://www.w3.org/2000/svg" class="size-5 text-white/30 group-hover:text-primary transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="glass-tile p-12 text-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-16 text-white/20 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z" />
        </svg>
        <p class="text-white/60 mb-4">Forums are being set up.</p>
        <p class="text-white/40 text-sm">Check back soon to join the conversation!</p>
      </div>
    )}
  </section>

  {/* Recent threads */}
  {recentThreads.length > 0 && (
    <section>
      <h2 class="text-2xl text-white mb-6">Recent Discussions</h2>
      <div class="space-y-3">
        {recentThreads.slice(0, 10).map(thread => (
          <a href={`/community/forums/thread/${thread.id}`} class="group block">
            <div class="glass-tile p-4 hover:bg-white/5 transition-colors">
              <div class="flex items-start gap-4">
                {/* Author avatar */}
                {thread.author.avatar ? (
                  <img
                    src={thread.author.avatar}
                    alt={thread.author.displayName}
                    class="w-10 h-10 rounded-full object-cover shrink-0"
                  />
                ) : (
                  <div class="w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center shrink-0">
                    <span class="text-primary text-sm font-medium">
                      {thread.author.displayName.charAt(0)}
                    </span>
                  </div>
                )}

                {/* Thread info */}
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2">
                    {thread.isPinned && (
                      <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                      </svg>
                    )}
                    <h3 class="text-white group-hover:text-primary transition-colors truncate">
                      {thread.title}
                    </h3>
                  </div>
                  <div class="flex flex-wrap items-center gap-2 mt-1 text-white/50 text-xs">
                    <span>{thread.author.displayName}</span>
                    <span aria-hidden="true">·</span>
                    <span>{thread.categoryName}</span>
                    <span aria-hidden="true">·</span>
                    <time datetime={thread.createdAt}>{thread.formattedDate}</time>
                  </div>
                </div>

                {/* Reply count */}
                <div class="text-center shrink-0">
                  <p class="text-white font-medium">{thread.replyCount}</p>
                  <p class="text-white/40 text-xs">replies</p>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}
</MainLayout>

<style>
  .line-clamp-1 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
  }
</style>
