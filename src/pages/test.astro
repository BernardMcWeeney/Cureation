---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Theme Switcher Test Page">
  <div class="responsive-container my-24">
    <header class="text-center mb-16">
      <h1 class="text-6xl font-bold mb-4 text-primary text-shadow-lg">Theme Switching Test</h1>
      <p class="text-xl text-white/80 max-w-2xl mx-auto">
        This page showcases various UI components with different theme colors applied to help test the theme switching functionality.
      </p>
      <div class="mt-4 flex justify-center gap-2">
        <span class="badge badge-primary">Current theme colors</span>
        <span id="current-theme-name" class="badge badge-outline"></span>
      </div>
    </header>

    <!-- Theme color showcase -->
    <section class="mb-16">
      <h2 class="text-3xl font-bold mb-6 border-b border-white/20 pb-2">Theme Color Palette</h2>
      <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
        <div class="flex flex-col items-center">
          <div class="w-24 h-24 rounded-full bg-primary mb-2 shadow-lg"></div>
          <span class="text-sm font-medium">Primary</span>
        </div>
        <div class="flex flex-col items-center">
          <div class="w-24 h-24 rounded-full bg-primary-content mb-2 shadow-lg"></div>
          <span class="text-sm font-medium">Primary Content</span>
        </div>
        <div class="flex flex-col items-center">
          <div class="w-24 h-24 rounded-full bg-secondary mb-2 shadow-lg"></div>
          <span class="text-sm font-medium">Secondary</span>
        </div>
        <div class="flex flex-col items-center">
          <div class="w-24 h-24 rounded-full bg-accent mb-2 shadow-lg"></div>
          <span class="text-sm font-medium">Accent</span>
        </div>
        <div class="flex flex-col items-center">
          <div class="w-24 h-24 rounded-full bg-theme-tint mb-2 shadow-lg"></div>
          <span class="text-sm font-medium">Theme Tint</span>
        </div>
      </div>
    </section>

    <!-- Buttons showcase -->
    <section class="mb-16 glass-card p-6">
      <h2 class="text-3xl font-bold mb-6 text-primary">Buttons</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="space-y-4">
          <h3 class="text-xl font-medium mb-4">Standard Buttons</h3>
          <div class="flex flex-wrap gap-2">
            <button class="btn btn-primary">Primary</button>
            <button class="btn btn-secondary">Secondary</button>
            <button class="btn btn-accent">Accent</button>
            <button class="btn">Neutral</button>
            <button class="btn btn-ghost">Ghost</button>
            <button class="btn btn-link">Link</button>
          </div>
        </div>
        <div class="space-y-4">
          <h3 class="text-xl font-medium mb-4">Outlined Buttons</h3>
          <div class="flex flex-wrap gap-2">
            <button class="btn btn-outline btn-primary">Primary</button>
            <button class="btn btn-outline btn-secondary">Secondary</button>
            <button class="btn btn-outline btn-accent">Accent</button>
            <button class="btn btn-outline">Neutral</button>
          </div>
        </div>
        <div class="space-y-4">
          <h3 class="text-xl font-medium mb-4">Custom Buttons</h3>
          <div class="flex flex-wrap gap-2">
            <button class="glass-button px-4 py-2 rounded-lg">Glass Button</button>
            <button class="bg-themed px-4 py-2 rounded-lg">Themed BG</button>
            <button class="hover-lift border border-primary px-4 py-2 rounded-lg">Hover Lift</button>
          </div>
        </div>
        <div class="space-y-4">
          <h3 class="text-xl font-medium mb-4">Text Colors</h3>
          <div class="space-y-2">
            <p class="text-primary">This text uses primary color</p>
            <p class="text-secondary">This text uses secondary color</p>
            <p class="text-accent">This text uses accent color</p>
            <p class="text-primary-content">This text uses primary content color</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Cards showcase -->
    <section class="mb-16">
      <h2 class="text-3xl font-bold mb-6 text-primary">Cards</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Primary card -->
        <div class="card bg-primary text-primary-content">
          <div class="card-body">
            <h2 class="card-title">Primary Card</h2>
            <p>This card uses primary color as background.</p>
            <div class="card-actions justify-end">
              <button class="btn bg-primary-content text-primary">Action</button>
            </div>
          </div>
        </div>
        
        <!-- Secondary card -->
        <div class="card bg-secondary text-white">
          <div class="card-body">
            <h2 class="card-title">Secondary Card</h2>
            <p>This card uses secondary color as background.</p>
            <div class="card-actions justify-end">
              <button class="btn bg-white text-secondary">Action</button>
            </div>
          </div>
        </div>
        
        <!-- Glass card -->
        <div class="glass-card p-6 rounded-lg">
          <h2 class="text-xl font-bold mb-2 text-primary">Glass Card</h2>
          <p class="mb-4">This card uses the glass-card utility class.</p>
          <div class="flex justify-end">
            <button class="btn btn-sm btn-primary">Action</button>
          </div>
        </div>
      </div>
    </section>

    <!-- Alerts showcase -->
    <section class="mb-16">
      <h2 class="text-3xl font-bold mb-6 text-primary">Alerts</h2>
      <div class="space-y-4">
        <div class="alert alert-info">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          <span>Information message with default styling</span>
        </div>
        
        <div class="alert bg-primary text-primary-content">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          <span>Alert with primary color background</span>
        </div>
        
        <div class="alert bg-secondary text-white">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
          <span>Alert with secondary color background</span>
        </div>
        
        <div class="alert bg-accent text-white">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          <span>Alert with accent color background</span>
        </div>
      </div>
    </section>

    <!-- Forms & Inputs showcase -->
    <section class="mb-16 glass-card p-6">
      <h2 class="text-3xl font-bold mb-6 text-primary">Forms & Inputs</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div>
          <div class="form-control w-full max-w-xs mb-4">
            <label class="label">
              <span class="label-text text-primary">Regular input</span>
            </label>
            <input type="text" placeholder="Type here" class="input input-bordered w-full max-w-xs" />
          </div>
          
          <div class="form-control w-full max-w-xs mb-4">
            <label class="label">
              <span class="label-text text-primary">Primary input</span>
            </label>
            <input type="text" placeholder="Type here" class="input input-bordered input-primary w-full max-w-xs" />
          </div>
          
          <div class="form-control w-full max-w-xs">
            <label class="label">
              <span class="label-text text-primary">Secondary input</span>
            </label>
            <input type="text" placeholder="Type here" class="input input-bordered input-secondary w-full max-w-xs" />
          </div>
        </div>
        
        <div>
          <div class="form-control mb-4">
            <label class="label cursor-pointer">
              <span class="label-text text-primary">Primary checkbox</span>
              <input type="checkbox" checked class="checkbox checkbox-primary" />
            </label>
          </div>
          
          <div class="form-control mb-4">
            <label class="label cursor-pointer">
              <span class="label-text text-primary">Secondary checkbox</span>
              <input type="checkbox" checked class="checkbox checkbox-secondary" />
            </label>
          </div>
          
          <div class="form-control mb-4">
            <label class="label cursor-pointer">
              <span class="label-text text-primary">Primary toggle</span>
              <input type="checkbox" class="toggle toggle-primary" checked />
            </label>
          </div>
          
          <div class="form-control">
            <label class="label cursor-pointer">
              <span class="label-text text-primary">Secondary toggle</span>
              <input type="checkbox" class="toggle toggle-secondary" checked />
            </label>
          </div>
        </div>
      </div>
    </section>

    <!-- Badges & Tags showcase -->
    <section class="mb-16">
      <h2 class="text-3xl font-bold mb-6 text-primary">Badges & Tags</h2>
      <div class="flex flex-wrap gap-2 mb-6">
        <span class="badge">Default</span>
        <span class="badge badge-primary">Primary</span>
        <span class="badge badge-secondary">Secondary</span>
        <span class="badge badge-accent">Accent</span>
        <span class="badge badge-outline">Outline</span>
        <span class="badge badge-outline badge-primary">Primary Outline</span>
        <span class="badge badge-outline badge-secondary">Secondary Outline</span>
      </div>
      
      <div class="flex flex-wrap gap-2">
        <div class="badge badge-lg">Large</div>
        <div class="badge badge-md">Medium</div>
        <div class="badge badge-sm">Small</div>
        <div class="badge badge-xs">Tiny</div>
      </div>
    </section>

    <!-- Custom utilities showcase -->
    <section class="mb-16">
      <h2 class="text-3xl font-bold mb-6 text-primary">Custom Utilities</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-lg bg-theme-tint">
          <h3 class="text-xl font-bold mb-2">Theme Tint</h3>
          <p>This box uses the bg-theme-tint utility</p>
        </div>
        
        <div class="p-6 rounded-lg bg-theme-tint-strong">
          <h3 class="text-xl font-bold mb-2">Theme Tint Strong</h3>
          <p>This box uses the bg-theme-tint-strong utility</p>
        </div>
        
        <div class="p-6 rounded-lg border-2 border-theme">
          <h3 class="text-xl font-bold mb-2">Theme Border</h3>
          <p>This box uses the border-theme utility</p>
        </div>
        
        <div class="p-6 rounded-lg">
          <h3 class="text-xl font-bold mb-2 text-shadow">Text Shadow</h3>
          <p>This heading uses the text-shadow utility</p>
        </div>
        
        <div class="p-6 rounded-lg">
          <h3 class="text-xl font-bold mb-2 text-shadow-lg">Text Shadow Large</h3>
          <p>This heading uses the text-shadow-lg utility</p>
        </div>
      </div>
    </section>

    <!-- Typography showcase -->
    <section class="mb-16 glass-card p-6">
      <h2 class="text-3xl font-bold mb-6 text-primary">Typography</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div>
          <h3 class="text-xl mb-4 text-primary">Headings</h3>
          <h1 class="text-2xl mb-1">Heading 1</h1>
          <h2 class="text-xl mb-1">Heading 2</h2>
          <h3 class="text-lg mb-1">Heading 3</h3>
          <h4 class="text-base mb-1">Heading 4</h4>
          <h5 class="text-sm mb-1">Heading 5</h5>
          <h6 class="text-xs">Heading 6</h6>
        </div>
        
        <div>
          <h3 class="text-xl mb-4 text-primary">Special Fonts</h3>
          <p class="font-brand text-4xl mb-2">Tangerine Display Font</p>
          <p class="text-xl mb-1">Normal Text in System Font</p>
          <p class="text-xl font-heading">Cinzel Heading Font</p>
        </div>
      </div>
    </section>

    <!-- Progress & Loading -->
    <section class="mb-16">
      <h2 class="text-3xl font-bold mb-6 text-primary">Progress & Loading</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div>
          <h3 class="text-xl mb-4 text-primary">Progress Bars</h3>
          <progress class="progress w-full mb-2" value="0" max="100"></progress>
          <progress class="progress progress-primary w-full mb-2" value="40" max="100"></progress>
          <progress class="progress progress-secondary w-full mb-2" value="70" max="100"></progress>
          <progress class="progress progress-accent w-full" value="90" max="100"></progress>
        </div>
        
        <div>
          <h3 class="text-xl mb-4 text-primary">Loading Spinners</h3>
          <div class="flex gap-4">
            <span class="loading loading-spinner loading-md"></span>
            <span class="loading loading-spinner loading-md text-primary"></span>
            <span class="loading loading-spinner loading-md text-secondary"></span>
            <span class="loading loading-spinner loading-md text-accent"></span>
          </div>
        </div>
      </div>
    </section>

    <!-- Gradient & Effects showcase -->
    <section class="mb-16">
      <h2 class="text-3xl font-bold mb-6 text-primary">Gradients & Effects</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="h-32 rounded-lg" style="background: linear-gradient(to right, var(--color-primary), var(--color-secondary));">
          <div class="flex items-center justify-center h-full">
            <span class="text-white font-bold">Primary to Secondary Gradient</span>
          </div>
        </div>
        
        <div class="h-32 rounded-lg" style="background: linear-gradient(to right, var(--color-secondary), var(--color-accent));">
          <div class="flex items-center justify-center h-full">
            <span class="text-white font-bold">Secondary to Accent Gradient</span>
          </div>
        </div>
        
        <div class="h-32 rounded-lg bg-noise">
          <div class="flex items-center justify-center h-full">
            <span class="text-white font-bold">Noise Texture</span>
          </div>
        </div>
        
        <div class="h-32 rounded-lg backdrop-blur-md bg-primary/30 border border-white/20">
          <div class="flex items-center justify-center h-full">
            <span class="text-white font-bold">Blur & Transparency</span>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  // Display current theme name
  function updateThemeName() {
    const currentTheme = document.documentElement.getAttribute('data-theme') || 'default';
    const themeNameElement = document.getElementById('current-theme-name');
    if (themeNameElement) {
      themeNameElement.textContent = currentTheme;
    }
  }
  
  // Run on initial load
  document.addEventListener('DOMContentLoaded', updateThemeName);
  
  // Run after theme changes
  document.addEventListener('astro:page-load', updateThemeName);
  
  // Also set up a mutation observer to detect theme changes
  const observer = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      if (mutation.attributeName === 'data-theme') {
        updateThemeName();
      }
    });
  });
  
  observer.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme']
  });
</script>