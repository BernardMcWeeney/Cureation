---
import MainLayout from '../../layouts/MainLayout.astro';
import NewsSidebar from '../../components/sidebar/NewsSidebar.astro';
import { getNewsPosts, getNewsCategories } from '../../lib/directus';

export async function getStaticPaths() {
  const posts = await getNewsPosts();
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const [allPosts, categories] = await Promise.all([
  getNewsPosts(),
  getNewsCategories()
]);

// Get related posts (same category, excluding current)
const relatedPosts = allPosts
  .filter(p => p.category === post.category && p.id !== post.id)
  .slice(0, 3);

// Category colors
const categoryColors: Record<string, string> = {
  news: 'bg-blue-500/20 text-blue-400 border-blue-500/40',
  reviews: 'bg-green-500/20 text-green-400 border-green-500/40',
  interviews: 'bg-pink-500/20 text-pink-400 border-pink-500/40',
  rumors: 'bg-amber-500/20 text-amber-400 border-amber-500/40',
  editorials: 'bg-purple-500/20 text-purple-400 border-purple-500/40'
};

const categoryClass = categoryColors[post.category] || 'bg-primary/20 text-primary border-primary/40';
---

<MainLayout
  title={post.title}
  description={post.excerpt}
  ogImage={post.featuredImage}
  showSidebar={true}
  customSidebar={true}
>
  <Fragment slot="sidebar">
    <NewsSidebar
      categories={categories}
      activeCategory={post.category}
      recentPosts={allPosts.filter(p => p.id !== post.id).slice(0, 5)}
      totalPosts={allPosts.length}
    />
  </Fragment>

  <article class="max-w-4xl">
    {/* Breadcrumb */}
    <nav class="mb-6" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2 text-sm text-white/50">
        <li><a href="/news" class="hover:text-primary transition-colors">News</a></li>
        <li aria-hidden="true">/</li>
        <li>
          <a href={`/news/category/${post.category}`} class="hover:text-primary transition-colors">
            {post.category.charAt(0).toUpperCase() + post.category.slice(1)}
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li class="text-white truncate max-w-[200px]">{post.title}</li>
      </ol>
    </nav>

    {/* Article header */}
    <header class="mb-8">
      {/* Category badge */}
      <div class="mb-4">
        <a
          href={`/news/category/${post.category}`}
          class={`inline-flex items-center px-3 py-1 rounded-md text-xs font-medium border backdrop-blur-sm ${categoryClass} hover:opacity-80 transition-opacity`}
        >
          {post.category.charAt(0).toUpperCase() + post.category.slice(1)}
        </a>
      </div>

      <h1 class="text-3xl md:text-4xl lg:text-5xl text-white mb-4 leading-tight">
        {post.title}
      </h1>

      {/* Meta info */}
      <div class="flex flex-wrap items-center gap-4 text-white/60 text-sm mb-6">
        <time datetime={post.publishedDate} class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          {post.formattedDate}
        </time>
        <span class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          {post.readingTime} min read
        </span>
        {post.authorName && (
          <span class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            {post.authorName}
          </span>
        )}
      </div>

      {/* Rating for reviews */}
      {post.category === 'reviews' && post.rating && (
        <div class="flex items-center gap-2 mb-6">
          <span class="text-white/60 text-sm">Rating:</span>
          <div class="flex items-center gap-1">
            {Array.from({ length: 5 }).map((_, i) => (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class={`size-6 ${i < post.rating! ? 'text-yellow-400 fill-yellow-400' : 'text-white/20'}`}
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
              </svg>
            ))}
          </div>
          <span class="text-white/60 text-sm">({post.rating}/5)</span>
        </div>
      )}

      {/* Featured image */}
      {post.featuredImage && (
        <div class="glass-tile overflow-hidden mb-8">
          <img
            src={post.featuredImage}
            alt=""
            class="w-full aspect-[21/9] object-cover"
          />
        </div>
      )}

      {/* Excerpt */}
      {post.excerpt && (
        <p class="text-xl text-white/80 leading-relaxed border-l-4 border-primary/40 pl-4">
          {post.excerpt}
        </p>
      )}
    </header>

    {/* Article content */}
    <div class="glass-tile p-8 md:p-10 mb-8">
      <div class="prose prose-invert prose-lg max-w-none">
        <Fragment set:html={post.content} />
      </div>
    </div>

    {/* Tags */}
    {post.tags && post.tags.length > 0 && (
      <div class="mt-12 pt-6 border-t border-white/10">
        <h3 class="text-sm text-white/50 mb-3">Tags</h3>
        <div class="flex flex-wrap gap-2">
          {post.tags.map(tag => (
            <span class="badge-outline">{tag}</span>
          ))}
        </div>
      </div>
    )}

    {/* Share buttons */}
    <div class="mt-8 pt-6 border-t border-white/10">
      <h3 class="text-sm text-white/50 mb-3">Share this article</h3>
      <div class="flex gap-3">
        <a
          href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.title)}&url=${encodeURIComponent(`https://cureation.net/news/${post.slug}`)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="glass-button p-3 rounded-lg hover:text-primary transition-colors"
          aria-label="Share on Twitter"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>
        <a
          href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(`https://cureation.net/news/${post.slug}`)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="glass-button p-3 rounded-lg hover:text-primary transition-colors"
          aria-label="Share on Facebook"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a>
        <button
          onclick={`navigator.clipboard.writeText('https://cureation.net/news/${post.slug}')`}
          class="glass-button p-3 rounded-lg hover:text-primary transition-colors"
          aria-label="Copy link"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
          </svg>
        </button>
      </div>
    </div>

    {/* Related posts */}
    {relatedPosts.length > 0 && (
      <section class="mt-12 pt-8 border-t border-white/10">
        <h2 class="font-heading text-2xl text-primary mb-6">Related Articles</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {relatedPosts.map(related => (
            <a href={`/news/${related.slug}`} class="group block">
              <div class="glass-tile overflow-hidden">
                {related.featuredImage && (
                  <div class="aspect-[16/10] overflow-hidden">
                    <img
                      src={related.featuredImage}
                      alt=""
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                      loading="lazy"
                    />
                  </div>
                )}
                <div class="p-4">
                  <h3 class="text-white group-hover:text-primary transition-colors line-clamp-2">
                    {related.title}
                  </h3>
                  <p class="text-white/50 text-sm mt-2">{related.formattedDate}</p>
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</MainLayout>

<style>
  .prose {
    color: rgba(255, 255, 255, 0.85);
  }

  .prose h2 {
    color: white;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose h3 {
    color: white;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .prose p {
    margin-bottom: 1.25rem;
  }

  .prose a {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .prose blockquote {
    border-left: 4px solid rgba(var(--color-primary-rgb), 0.4);
    padding-left: 1rem;
    font-style: italic;
    color: rgba(255, 255, 255, 0.7);
  }

  .prose ul, .prose ol {
    margin-left: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
  }

  .line-clamp-2 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
</style>
