---
import MainLayout from '../../layouts/MainLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import NewsSidebar from '../../components/sidebar/NewsSidebar.astro';
import { getNewsPosts, getNewsCategories } from '../../lib/directus';

// Fetch all news posts and categories
const [posts, categories] = await Promise.all([
  getNewsPosts(),
  getNewsCategories()
]);

// Separate featured and regular posts
const featuredPosts = posts.filter(p => p.featured).slice(0, 2);
const regularPosts = posts.filter(p => !p.featured || !featuredPosts.includes(p));
---

<MainLayout
  title="News & Articles"
  description="The latest news, reviews, interviews, and editorials about The Cure"
  showSidebar={true}
  customSidebar={true}
>
  <Fragment slot="sidebar">
    <NewsSidebar
      categories={categories}
      recentPosts={posts.slice(0, 5)}
      totalPosts={posts.length}
    />
  </Fragment>

  {/* Hero section (full width, in hero slot) */}
  <section class="mb-10" slot="hero">
    <div class="glass-panel overflow-hidden relative">
      <div class="absolute -top-20 -left-20 w-64 h-64 rounded-full bg-white/[0.06] blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-10 -right-10 w-48 h-48 rounded-full bg-accent/[0.06] blur-2xl pointer-events-none"></div>

      <div class="relative p-8 md:p-12">
        <h1 class="font-display text-5xl md:text-6xl lg:text-7xl text-white mb-4 text-glow">News & Articles</h1>
        <p class="text-white/75 text-lg md:text-xl max-w-3xl leading-relaxed">
          The latest news, in-depth reviews, exclusive interviews, and thoughtful editorials about The Cure.
        </p>

        <div class="flex flex-wrap gap-8 mt-8 pt-6 border-t border-white/[0.08]">
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-white text-glow">{posts.length}</span>
            <span class="text-white/85 text-base font-medium">Articles</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-white text-glow">{categories.length}</span>
            <span class="text-white/85 text-base font-medium">Categories</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Featured posts */}
  {featuredPosts.length > 0 && (
    <section class="mb-12">
      <h2 class="text-2xl text-white mb-6 section-header flex items-center gap-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
        </svg>
        Featured
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {featuredPosts.map(post => (
          <NewsCard post={post} featured={true} />
        ))}
      </div>
    </section>
  )}

  {/* All posts */}
  <section>
    <h2 class="text-2xl text-white mb-6 section-header">All Articles</h2>
    {regularPosts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {regularPosts.map((post, index) => (
          <div style={`--index: ${index}`} class="animate-fade-in">
            <NewsCard post={post} />
          </div>
        ))}
      </div>
    ) : (
      <div class="glass-panel p-12 text-center">
        <p class="text-white/85">No articles available yet.</p>
      </div>
    )}
  </section>
</MainLayout>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fadeIn 0.5s ease forwards;
    animation-delay: calc(var(--index, 0) * 75ms);
    opacity: 0;
  }
</style>
