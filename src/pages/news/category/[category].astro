---
import MainLayout from '../../../layouts/MainLayout.astro';
import NewsCard from '../../../components/NewsCard.astro';
import NewsSidebar from '../../../components/sidebar/NewsSidebar.astro';
import { getNewsPosts, getNewsCategories } from '../../../lib/directus';
import type { NewsCategory } from '../../../types/directus';

export async function getStaticPaths() {
  const categories = await getNewsCategories();
  return categories.map(cat => ({
    params: { category: cat.slug },
    props: { categoryName: cat.name }
  }));
}

const { category } = Astro.params;
const { categoryName } = Astro.props;

// Fetch posts for this category and all categories for sidebar
const [posts, allCategories, allPosts] = await Promise.all([
  getNewsPosts(category as NewsCategory),
  getNewsCategories(),
  getNewsPosts()
]);

// Category descriptions
const categoryDescriptions: Record<string, string> = {
  news: 'The latest announcements, updates, and breaking news about The Cure.',
  reviews: 'In-depth album reviews, concert reviews, and critical analysis.',
  interviews: 'Exclusive interviews with band members and people close to The Cure.',
  rumors: 'Unconfirmed reports and speculation about upcoming releases and tours.',
  editorials: 'Opinion pieces, retrospectives, and thoughtful commentary on The Cure\'s legacy.'
};
---

<MainLayout
  title={`${categoryName} - News`}
  description={categoryDescriptions[category as string] || `${categoryName} articles about The Cure`}
  showSidebar={true}
  customSidebar={true}
>
  <Fragment slot="sidebar">
    <NewsSidebar
      categories={allCategories}
      activeCategory={category as NewsCategory}
      recentPosts={allPosts.slice(0, 5)}
      totalPosts={allPosts.length}
    />
  </Fragment>

  {/* Hero section */}
  <section class="mb-12">
    <div class="glass-card p-8 md:p-10">
      <nav class="mb-4" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 text-sm text-white/50">
          <li><a href="/news" class="hover:text-primary transition-colors">News</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-white">{categoryName}</li>
        </ol>
      </nav>
      <h1 class="text-4xl md:text-5xl text-white mb-3">{categoryName}</h1>
      <p class="text-white/60 text-lg max-w-2xl">
        {categoryDescriptions[category as string] || `Browse all ${categoryName.toLowerCase()} articles.`}
      </p>
      <div class="mt-6 flex items-center gap-4">
        <span class="badge">{posts.length} {posts.length === 1 ? 'article' : 'articles'}</span>
      </div>
    </div>
  </section>

  {/* Posts grid */}
  <section>
    {posts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post, index) => (
          <div style={`--index: ${index}`} class="animate-fade-in">
            <NewsCard post={post} />
          </div>
        ))}
      </div>
    ) : (
      <div class="glass-card p-12 text-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-16 text-white/20 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
        </svg>
        <p class="text-white/60 mb-4">No {categoryName.toLowerCase()} articles available yet.</p>
        <a href="/news" class="text-primary hover:underline">Browse all articles</a>
      </div>
    )}
  </section>
</MainLayout>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fadeIn 0.5s ease forwards;
    animation-delay: calc(var(--index, 0) * 75ms);
    opacity: 0;
  }
</style>
