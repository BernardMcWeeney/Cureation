---
import MainLayout from '../../layouts/MainLayout.astro';
import SiteConfig from '../../config/site.config.js';

const sidebarItems = [
  { title: 'About Cureation', path: '/about' },
  { title: 'Contributors', path: '/about/contributors' },
  { title: 'Terms', path: '/about/terms' },
  { title: 'Privacy Policy', path: '/about/privacy' },
  { title: 'Disclaimer', path: '/about/disclaimer' }
];
---

<MainLayout 
  title="Terms of Use"
  description="The rules and conditions that govern use of Cureation.net."
  showSidebar={true}
  sidebarActiveItem="Terms"
  sidebarItems={sidebarItems}
>
  <section class="pb-24">
    <div class="mb-12">
      <h1 class="font-display text-5xl md:text-6xl text-white mb-6">Terms of Use</h1>
      <p class="text-white/80 max-w-3xl">
        By accessing or using Cureation.net, you agree to the following terms and conditions. These terms are intended to protect the integrity of the archive and the rights of both users and content owners.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-8">
      <div class="bg-black/30 backdrop-blur-md p-6 md:p-8 rounded-xl border border-white/10 shadow-xl">
        
        <h2 class="font-display text-4xl text-primary mb-4 mt-2">1. Non-Commercial Use Only</h2>
        <p class="text-white/90 mb-4">
          Cureation is offered solely for personal, non-commercial use. You may not sell, reproduce, redistribute, or exploit any part of this website for commercial purposes without express written permission.
        </p>

        <h2 class="font-display text-4xl text-primary mb-4 mt-10">2. Intellectual Property</h2>
        <p class="text-white/90 mb-4">
          All copyrighted material—such as lyrics, images, trademarks, and media—remains the property of the respective copyright holders. Cureation does not claim ownership over third-party intellectual property.
        </p>
        <p class="text-white/90 mb-4">
          You may not copy, repost, or reuse content from this site without permission from the copyright owner, unless your use is covered under fair use or similar exemptions.
        </p>

        <h2 class="font-display text-4xl text-primary mb-4 mt-10">3. User Contributions</h2>
        <p class="text-white/90 mb-4">
          If you contribute content (e.g., corrections, setlists, commentary, or archival material), you grant Cureation permission to display and store your contributions publicly. We reserve the right to edit or remove contributions for accuracy, clarity, or legal compliance.
        </p>

        <h2 class="font-display text-4xl text-primary mb-4 mt-10">4. Prohibited Conduct</h2>
        <p class="text-white/90 mb-4">
          You agree not to use Cureation.net for any unlawful purpose or to violate any applicable laws. Specifically, you may not:
        </p>
        <ul class="list-disc pl-6 text-white/90 mb-4">
          <li>Upload or distribute malicious code or spam</li>
          <li>Attempt to access unauthorized areas or services</li>
          <li>Scrape, crawl, or systematically extract data from the site</li>
          <li>Harass, impersonate, or abuse other users or contributors</li>
        </ul>

        <h2 class="font-display text-4xl text-primary mb-4 mt-10">5. Limitation of Liability</h2>
        <p class="text-white/90 mb-4">
          Cureation is provided “as is” without warranties of any kind. We do not guarantee that the site will be error-free or uninterrupted. We are not liable for any loss or damage arising from your use of the site or reliance on its content.
        </p>

        <h2 class="font-display text-4xl text-primary mb-4 mt-10">6. External Links</h2>
        <p class="text-white/90 mb-4">
          This website may contain links to third-party websites. Cureation is not responsible for the content or policies of those external sites.
        </p>

        <h2 class="font-display text-4xl text-primary mb-4 mt-10">7. Changes to These Terms</h2>
        <p class="text-white/90 mb-4">
          These Terms of Use may be updated from time to time. Any changes will be reflected on this page with a revised effective date. Continued use of the site after updates implies your acceptance of the changes.
        </p>

        <h2 class="font-display text-4xl text-primary mb-4 mt-10">8. Contact</h2>
        <p class="text-white/90 mb-4">
          If you have any questions about these terms, please contact us at <a href="mailto:hello@cureation.net" class="text-primary underline">hello@cureation.net</a>.
        </p>

        <p class="text-white/70 text-sm mt-12">
          Last updated: April 2025
        </p>
      </div>
    </div>
  </section>
</MainLayout>
