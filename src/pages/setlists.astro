---
import Layout from '../layouts/Layout.astro';
import IssueSection from '../components/ui/IssueSection.astro';
import PageHero from '../components/ui/PageHero.astro';
import Select from '../components/ui/Select.astro';
import SearchField from '../components/ui/SearchField.astro';
import { listSetlists } from '../lib/directus';

const setlists = await listSetlists({ limit: 1000 });
const years = Array.from(new Set(setlists.map((s) => s.date?.slice(0, 4)).filter(Boolean))).sort().reverse();
const countries = Array.from(new Set(setlists.map((s) => s.country).filter(Boolean))).sort();
const tours = Array.from(new Set(setlists.map((s) => s.tour_name).filter(Boolean))).sort();
const byDecade: Record<string, number> = {};
setlists.forEach((s) => { const y = s.date?.slice(0, 4); if (!y) return; const d = `${y.slice(0, 3)}0s`; byDecade[d] = (byDecade[d] || 0) + 1; });
const decadeEntries = Object.entries(byDecade).sort((a, b) => a[0].localeCompare(b[0]));

const facts: Array<[string, string]> = [
  ['Shows on file', String(setlists.length)],
  ['Years covered', years.length ? `${years[years.length - 1]}–${years[0]}` : '—'],
  ['Countries', String(countries.length)],
  ['Tours', String(tours.length)],
];
---
<Layout title="Setlists · Cureation">
  <PageHero
    section="Live archive"
    title="Setlists"
    deck="Every documented performance — date, city, venue — cross-referenced to tours, songs, and contemporaneous press."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Setlists' }]}
    facts={facts.map(([k, v]) => ({ k, v }))}
    flush
  />

  <IssueSection kicker="The ledger" title="Every show" meta={`${setlists.length} entries`}>
    <div class="table-controls" aria-label="Setlist table filters">
      <div class="table-controls__grid table-controls__grid--5">
        <Select
          name="decade"
          label="Decade"
          options={[{ value: 'all', label: 'All decades' }, ...decadeEntries.map(([d]) => ({ value: d, label: d }))]}
        />
        <Select
          name="year"
          label="Year"
          options={[{ value: 'all', label: 'All years' }, ...years.map((y) => ({ value: y!, label: y! }))]}
        />
        <Select
          name="country"
          label="Country"
          options={[{ value: 'all', label: 'All countries' }, ...countries.map((c) => ({ value: c!, label: c! }))]}
        />
        <Select
          name="tour"
          label="Tour"
          options={[{ value: 'all', label: 'All tours' }, ...tours.map((t) => ({ value: t!, label: t! }))]}
        />
        <SearchField placeholder="Venue, city, tour..." />
      </div>
    </div>
    <div class="table-results-bar">
      <span data-match-count>{setlists.length} shows</span>
    </div>
    <div class="table-wrap">
      <table class="data data--airy" data-setlist-table>
        <thead><tr><th style="width:120px;">Date</th><th>Venue</th><th>City</th><th>Country</th><th>Tour</th><th class="num" style="text-align:right; width:80px;">Songs</th></tr></thead>
        <tbody>
          {setlists.map((s) => (
            <tr data-clickable
                data-year={s.date?.slice(0, 4) || ''}
                data-decade={s.date ? `${s.date.slice(0, 3)}0s` : ''}
                data-country={s.country || ''}
                data-tour={s.tour_name || ''}
                data-search={`${s.venue || ''} ${s.city || ''} ${s.country || ''} ${s.tour_name || ''}`.toLowerCase()}
                onclick={`location.href='/setlists/${s.slug}'`}>
              <td class="mono-sm" style="color: var(--ink);">{s.date || '—'}</td>
              <td><span class="serif" style="font-size:19px; font-style:italic; line-height:1.3;">{s.venue || '—'}</span></td>
              <td class="mono-sm muted">{[s.city, s.state_province].filter(Boolean).join(', ') || '—'}</td>
              <td class="mono-sm muted">{s.country || '—'}</td>
              <td class="mono-sm" style="color: var(--accent-3);">{s.tour_name || '—'}</td>
              <td class="num">{s.song_count || '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </IssueSection>
</Layout>

<script>
  function wire() {
    const state: Record<string, string> = { year: 'all', decade: 'all', country: 'all', tour: 'all', search: '' };
    const table = document.querySelector<HTMLElement>('[data-setlist-table]');
    if (!table || table.dataset.filtersWired === 'true') return;
    table.dataset.filtersWired = 'true';
    const rows = Array.from(table.querySelectorAll<HTMLElement>('tbody tr'));
    const counter = document.querySelector<HTMLElement>('[data-match-count]');
    const apply = () => {
      let matched = 0;
      rows.forEach((r) => {
        const y = r.getAttribute('data-year') || '';
        const d = r.getAttribute('data-decade') || '';
        const c = r.getAttribute('data-country') || '';
        const t = r.getAttribute('data-tour') || '';
        const s = r.getAttribute('data-search') || '';
        const ok =
          (state.year === 'all' || y === state.year) &&
          (state.decade === 'all' || d === state.decade) &&
          (state.country === 'all' || c === state.country) &&
          (state.tour === 'all' || t === state.tour) &&
          (!state.search || s.includes(state.search));
        r.style.display = ok ? '' : 'none';
        if (ok) matched++;
      });
      if (counter) counter.textContent = `${matched} shows`;
    };
    document.querySelectorAll<HTMLSelectElement>('[data-filter-select]').forEach((sel) => {
      const key = sel.getAttribute('data-filter-select') || '';
      sel.addEventListener('change', () => {
        state[key] = sel.value || 'all';
        apply();
      });
    });
    const search = document.querySelector<HTMLInputElement>('[data-filter-search]');
    if (search) search.addEventListener('input', () => { state.search = search.value.trim().toLowerCase(); apply(); });
    apply();
  }
  wire();
  document.addEventListener('astro:page-load', wire);
</script>
