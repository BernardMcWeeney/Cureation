---
import { editable, copyText, copyAttr, copySource, copyTuple, copyTupleSource } from '../lib/visual-editing';
import Layout from '../layouts/Layout.astro';
import IssueSection from '../components/ui/IssueSection.astro';
import PageHero from '../components/ui/PageHero.astro';
import Select from '../components/ui/Select.astro';
import SearchField from '../components/ui/SearchField.astro';
import Pagination from '../components/ui/Pagination.astro';
import { listSetlists } from '../lib/directus';

const setlists = await listSetlists({ limit: -1 });
const years = Array.from(new Set(setlists.map((s) => s.date?.slice(0, 4)).filter(Boolean))).sort().reverse();
const countries = Array.from(new Set(setlists.map((s) => s.country).filter(Boolean))).sort();
const tours = Array.from(new Set(setlists.map((s) => s.tour_name).filter(Boolean))).sort();
const byDecade: Record<string, number> = {};
setlists.forEach((s) => { const y = s.date?.slice(0, 4); if (!y) return; const d = `${y.slice(0, 3)}0s`; byDecade[d] = (byDecade[d] || 0) + 1; });
const decadeEntries = Object.entries(byDecade).sort((a, b) => a[0].localeCompare(b[0]));

const facts: Array<[string, string]> = [
  copyTuple([copyText("pages_setlists_tuple-70b206f66e00", "Shows"), String(setlists.length)], {"0":"pages_setlists_tuple-70b206f66e00"}),
  copyTuple([copyText("pages_setlists_tuple-6137443c3a6f", "Years covered"), years.length ? `${years[years.length - 1]}–${years[0]}` : '–'], {"0":"pages_setlists_tuple-6137443c3a6f"}),
  copyTuple([copyText("pages_setlists_tuple-b66cf12450de", "Countries"), String(countries.length)], {"0":"pages_setlists_tuple-b66cf12450de"}),
  copyTuple([copyText("pages_setlists_tuple-ad72a7e73c0f", "Tours"), String(tours.length)], {"0":"pages_setlists_tuple-ad72a7e73c0f"}),
];
---
<Layout title="Setlists · Cureation">
  <PageHero copyKeys={{"section":"pages_setlists_1736f07fd152","title":"pages_setlists_1fab0856c9b3","deck":"pages_setlists_784452930850"}}
    section={copyText("pages_setlists_1736f07fd152", "Live archive")}
    title={copyText("pages_setlists_1fab0856c9b3", "Setlists")}

    crumbs={[{ ...copySource({"label":"pages_setlists_data-c72f4d906a04"}),  label: copyText("pages_setlists_data-c72f4d906a04", "Home"), href: '/' }, { ...copySource({"label":"pages_setlists_data-6ed0974ce6a1"}),  label: copyText("pages_setlists_data-6ed0974ce6a1", "Setlists") }]}
    facts={facts.map((fact) => ({ ...copyTupleSource(fact, ["k", "v"]), k: fact[0], v: fact[1] }))}
    flush
  />

  <div data-setlist-archive>
    <IssueSection title="Setlists" hideHeader>
      <div class="table-controls" aria-label="Setlist table filters">
        <div class="table-controls__grid table-controls__grid--5">
          <Select
            name="decade"
            label="Decade"
            options={[{ value: 'all', label: 'All decades' }, ...decadeEntries.map(([d]) => ({ value: d, label: d }))]}
          />
          <Select
            name="year"
            label="Year"
            options={[{ value: 'all', label: 'All years' }, ...years.map((y) => ({ value: y!, label: y! }))]}
          />
          <Select
            name="country"
            label="Country"
            options={[{ value: 'all', label: 'All countries' }, ...countries.map((c) => ({ value: c!, label: c! }))]}
          />
          <Select
            name="tour"
            label="Tour"
            options={[{ value: 'all', label: 'All tours' }, ...tours.map((t) => ({ value: t!, label: t! }))]}
          />
          <SearchField placeholder="Venue, city, tour..." />
        </div>
      </div>
      <div class="table-results-bar">
        <span data-match-count>{setlists.length} shows</span>
        <span data-page-range aria-live="polite"></span>
      </div>
      <div class="table-wrap">
        <table class="data data--airy" data-setlist-table>
          <thead><tr><th data-directus={copyAttr("pages_setlists_15c7ca96fac5")} set:html={copyText("pages_setlists_15c7ca96fac5", "Date")} style="width:120px;"></th><th data-directus={copyAttr("pages_setlists_e283d547c011")} set:html={copyText("pages_setlists_e283d547c011", "Venue")}></th><th data-directus={copyAttr("pages_setlists_3d146cf8b7f4")} set:html={copyText("pages_setlists_3d146cf8b7f4", "City")}></th><th data-directus={copyAttr("pages_setlists_a6a7e8303133")} set:html={copyText("pages_setlists_a6a7e8303133", "Country")}></th><th data-directus={copyAttr("pages_setlists_688bc4f64505")} set:html={copyText("pages_setlists_688bc4f64505", "Tour")}></th><th data-directus={copyAttr("pages_setlists_7cbc0f0e817f")} set:html={copyText("pages_setlists_7cbc0f0e817f", "Songs")} class="num" style="text-align:right; width:80px;"></th></tr></thead>
          <tbody>
            {setlists.map((s) => (
              <tr data-clickable
                  data-year={s.date?.slice(0, 4) || ''}
                  data-decade={s.date ? `${s.date.slice(0, 3)}0s` : ''}
                  data-country={s.country || ''}
                  data-tour={s.tour_name || ''}
                  data-search={`${s.venue || ''} ${s.city || ''} ${s.country || ''} ${s.tour_name || ''}`.toLowerCase()}
                  data-row-href={`/setlists/${s.slug}`}>
                <td data-directus={editable(s, ["date"])} class="mono-sm" style="color: var(--ink);">{s.date || '–'}</td>
                <td><a data-directus={editable(s, ["venue"])} href={s.slug ? `/setlists/${encodeURIComponent(s.slug)}` : undefined} class="serif" style="font-size:19px; font-style:italic; line-height:1.3;">{s.venue || '–'}</a></td>
                <td data-directus={editable(s, ["city","state_province"])} class="mono-sm muted">{[s.city, s.state_province].filter(Boolean).join(', ') || '–'}</td>
                <td data-directus={editable(s, ["country"])} class="mono-sm muted">{s.country || '–'}</td>
                <td data-directus={editable(s, ["tour_name"])} class="mono-sm" style="color: var(--accent-3);">{s.tour_name || '–'}</td>
                <td data-directus={editable(s, ["song_count"])} class="num">{s.song_count || '–'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <Pagination label="Setlist pages" />
    </IssueSection>
  </div>
</Layout>

<script>
  function wire() {
    const archive = document.querySelector<HTMLElement>('[data-setlist-archive]');
    const table = archive?.querySelector<HTMLElement>('[data-setlist-table]');
    if (!archive || !table || archive.dataset.filtersWired === 'true') return;
    archive.dataset.filtersWired = 'true';

    const params = new URLSearchParams(window.location.search);
    const state: Record<string, string> = {
      year: params.get('year') || 'all',
      decade: params.get('decade') || 'all',
      country: params.get('country') || 'all',
      tour: params.get('tour') || 'all',
      search: params.get('q') || '',
    };
    const pageSize = 50;
    let currentPage = Math.max(1, Number.parseInt(params.get('page') || '1', 10) || 1);
    const rows = Array.from(table.querySelectorAll<HTMLElement>('tbody tr'));
    const counter = archive.querySelector<HTMLElement>('[data-match-count]');
    const range = archive.querySelector<HTMLElement>('[data-page-range]');
    const pagination = archive.querySelector<HTMLElement>('[data-pagination]');
    const pageList = archive.querySelector<HTMLElement>('[data-page-list]');
    const previous = archive.querySelector<HTMLButtonElement>('[data-page-action="previous"]');
    const next = archive.querySelector<HTMLButtonElement>('[data-page-action="next"]');
    const selects = Array.from(archive.querySelectorAll<HTMLSelectElement>('[data-filter-select]'));
    const search = archive.querySelector<HTMLInputElement>('[data-filter-search]');

    selects.forEach((select) => {
      const key = select.dataset.filterSelect || '';
      const requested = state[key] || 'all';
      const hasOption = Array.from(select.options).some((option) => option.value === requested);
      state[key] = hasOption ? requested : 'all';
      select.value = state[key];
    });
    if (search) search.value = state.search;

    const matches = (row: HTMLElement) => {
        const r = row;
        const y = r.getAttribute('data-year') || '';
        const d = r.getAttribute('data-decade') || '';
        const c = r.getAttribute('data-country') || '';
        const t = r.getAttribute('data-tour') || '';
        const s = r.getAttribute('data-search') || '';
        const ok =
          (state.year === 'all' || y === state.year) &&
          (state.decade === 'all' || d === state.decade) &&
          (state.country === 'all' || c === state.country) &&
          (state.tour === 'all' || t === state.tour) &&
          (!state.search || s.includes(state.search));
        return ok;
    };

    const syncUrl = () => {
      const url = new URL(window.location.href);
      ['year', 'decade', 'country', 'tour', 'q', 'page'].forEach((key) => url.searchParams.delete(key));
      if (state.year !== 'all') url.searchParams.set('year', state.year);
      if (state.decade !== 'all') url.searchParams.set('decade', state.decade);
      if (state.country !== 'all') url.searchParams.set('country', state.country);
      if (state.tour !== 'all') url.searchParams.set('tour', state.tour);
      if (state.search) url.searchParams.set('q', state.search);
      if (currentPage > 1) url.searchParams.set('page', String(currentPage));
      window.history.replaceState({}, '', `${url.pathname}${url.search}`);
    };

    const renderPageList = (totalPages: number) => {
      if (!pageList) return;
      pageList.replaceChildren();
      const pages = new Set([1, totalPages, currentPage - 1, currentPage, currentPage + 1]);
      const anchors = [...pages].filter((page) => page >= 1 && page <= totalPages).sort((a, b) => a - b);
      const visible: number[] = [];
      let last = 0;
      anchors.forEach((page) => {
        if (last && page - last === 2) visible.push(last + 1);
        visible.push(page);
        last = page;
      });
      last = 0;
      visible.forEach((page) => {
        if (last && page - last > 1) {
          const ellipsis = document.createElement('span');
          ellipsis.className = 'archive-pagination__ellipsis';
          ellipsis.textContent = '…';
          ellipsis.setAttribute('aria-hidden', 'true');
          pageList.appendChild(ellipsis);
        }
        const button = document.createElement('button');
        button.type = 'button';
        button.dataset.page = String(page);
        button.textContent = String(page);
        button.setAttribute('aria-label', `Page ${page}`);
        if (page === currentPage) button.setAttribute('aria-current', 'page');
        pageList.appendChild(button);
        last = page;
      });
    };

    const apply = (updateUrl = false) => {
      const matchedRows = rows.filter(matches);
      const matched = matchedRows.length;
      const totalPages = Math.max(1, Math.ceil(matched / pageSize));
      currentPage = Math.min(currentPage, totalPages);
      const start = (currentPage - 1) * pageSize;
      const end = Math.min(start + pageSize, matched);

      rows.forEach((row) => { row.style.display = 'none'; });
      matchedRows.slice(start, end).forEach((row) => { row.style.display = ''; });

      if (counter) counter.textContent = `${matched} show${matched === 1 ? '' : 's'}`;
      if (range) range.textContent = matched ? `Showing ${start + 1}–${end}` : 'No shows to display';
      if (pagination) pagination.hidden = matched <= pageSize;
      if (previous) previous.disabled = currentPage === 1;
      if (next) next.disabled = currentPage === totalPages;
      renderPageList(totalPages);
      if (updateUrl) syncUrl();
    };

    selects.forEach((sel) => {
      const key = sel.getAttribute('data-filter-select') || '';
      sel.addEventListener('change', () => {
        state[key] = sel.value || 'all';
        currentPage = 1;
        apply(true);
      });
    });
    if (search) search.addEventListener('input', () => {
      state.search = search.value.trim().toLowerCase();
      currentPage = 1;
      apply(true);
    });
    pagination?.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button');
      if (!button || button.disabled) return;
      if (button.dataset.pageAction === 'previous') currentPage--;
      else if (button.dataset.pageAction === 'next') currentPage++;
      else if (button.dataset.page) currentPage = Number(button.dataset.page);
      else return;
      apply(true);
      archive.querySelector('.table-results-bar')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    apply(false);
  }
  wire();
  document.addEventListener('astro:page-load', wire);
</script>
