---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import Crumbs from '../../components/ui/Crumbs.astro';
import Tag from '../../components/ui/Tag.astro';
import { getVenueBySlug, listSetlists } from '../../lib/directus';
import { asset } from '../../lib/assets';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/venues');
const venue = await getVenueBySlug(slug);
if (!venue) return new Response('Not found', { status: 404 });

const shows = await listSetlists({ venue: venue.id, limit: 400 });
const showsByDecade = new Map<string, typeof shows>();
for (const s of shows) {
  const y = s.date?.slice(0, 4);
  if (!y) continue;
  const decade = `${y.slice(0, 3)}0s`;
  if (!showsByDecade.has(decade)) showsByDecade.set(decade, [] as any);
  showsByDecade.get(decade)!.push(s);
}
const decades = Array.from(showsByDecade.keys()).sort().reverse();

const firstY = venue.first_cure_show?.slice(0, 4);
const lastY = venue.latest_cure_show?.slice(0, 4);
const span = firstY && lastY ? (firstY === lastY ? firstY : `${firstY}–${lastY}`) : '—';

const facts: Array<[string, string]> = [
  ['Location', [venue.city, venue.state_province, venue.country].filter(Boolean).join(', ') || '—'],
  ['Capacity', venue.capacity ? venue.capacity.toLocaleString() : '—'],
  ['Opened', venue.opened_year ? String(venue.opened_year) : '—'],
  ['Type', venue.venue_type || '—'],
  ['Cure shows', String(venue.cure_show_count || shows.length || '—')],
  ['First appearance', venue.first_cure_show || '—'],
  ['Latest appearance', venue.latest_cure_show || '—'],
  ['Span', span],
];

const heroSrc = venue.photo_file ? asset(venue.photo_file, 'hero') : null;
const country = (venue.country || 'ROOM').toUpperCase();
---
<Layout title={`${venue.name} · Venues · Cureation`}>
  <div class="container" style="padding-top: clamp(24px, 3vw, 40px);">
    <Crumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Venues', href: '/venues' },
      { label: venue.name },
    ]} />
  </div>

  <section class="container dossier">
    <figure class="dossier__portrait">
      {heroSrc ? (
        <img src={heroSrc} alt={`${venue.name} photograph`} />
      ) : (
        <div class="placeholder" style="aspect-ratio: 3/4;">No photograph</div>
      )}
      <div class="cover-plate__corner cover-plate__corner--tl">
        <span>VENUE · {country}</span>
      </div>
      {venue.cure_show_count ? (
        <div class="cover-plate__corner cover-plate__corner--br" style="border-color: var(--gold); color: var(--gold);">
          <span>{venue.cure_show_count} CURE SHOWS</span>
        </div>
      ) : null}
    </figure>

    <div class="dossier__body stack" style="--gap: 1rem;">
      <div class="cluster" style="gap:.4rem;">
        {venue.venue_type && <Tag>{venue.venue_type.toUpperCase()}</Tag>}
        {(venue.cure_show_count || 0) >= 5 && <span class="tag tag--gold">MARQUEE ROOM</span>}
        {firstY && Number(firstY) < 1985 && <span class="tag tag--cool">VINTAGE · {firstY}</span>}
      </div>
      <h1 class="serif" style="font-size: clamp(44px, 7vw, 96px); line-height:.95; font-style: italic; margin: 0;">{venue.name}</h1>
      <div class="mono-sm muted">
        {[venue.city, venue.state_province, venue.country].filter(Boolean).join(', ')}
        {venue.latitude && venue.longitude && <> · {venue.latitude.toFixed(3)}, {venue.longitude.toFixed(3)}</>}
      </div>

      {venue.description && <p style="font-family: var(--f-serif); font-size: 18px; line-height:1.55; color: var(--ink-2); max-width: 58ch;">{venue.description}</p>}

      {venue.famous_moment && (
        <div class="voices">
          <div class="mono-sm muted" style="margin-bottom:.3rem;"><span class="pip pip--gold"></span>FAMOUS MOMENT</div>
          <div class="voices__quote">{venue.famous_moment}</div>
        </div>
      )}

      <div class="facts">
        {facts.map(([k, v]) => (
          <div class="facts__item">
            <div class="facts__k">{k}</div>
            <div class="facts__v">{v}</div>
          </div>
        ))}
      </div>

      {(venue.wikipedia_url || venue.official_website) && (
        <div class="cluster" style="gap: 1rem; margin-top: .6rem;">
          {venue.wikipedia_url && <a href={venue.wikipedia_url} target="_blank" rel="noopener" class="mono-sm" style="color: var(--accent-3);">WIKIPEDIA →</a>}
          {venue.official_website && <a href={venue.official_website} target="_blank" rel="noopener" class="mono-sm" style="color: var(--accent-3);">OFFICIAL SITE →</a>}
        </div>
      )}
    </div>
  </section>

  {shows.length > 0 && (
    <section class="container" style="padding: clamp(32px, 5vw, 64px) 0;">
      <div class="panel-head" style="border: 1px solid var(--rule);">
        <span>A chronology</span>
        <span>{shows.length} APPEARANCES</span>
      </div>

      <div style="padding: clamp(20px, 3vw, 32px) 0;">
        <div class="rail">
          {decades.map(decade => (
            <>
              <div class="rail__item" style="padding-bottom:12px;">
                <div class="rail__date rule-accent" style="padding-top:.4rem;">THE {decade.toUpperCase()}</div>
              </div>
              {(showsByDecade.get(decade) || []).map((s, i) => {
                const isFirst = s.date === venue.first_cure_show;
                const isLast = s.date === venue.latest_cure_show;
                return (
                  <div class={`rail__item${isFirst ? ' rail__item--gold' : isLast ? ' rail__item--hot' : ''}`}>
                    <div class="rail__date">{s.date}{isFirst ? ' · FIRST APPEARANCE' : isLast ? ' · LATEST' : ''}</div>
                    <a href={`/setlists/${s.slug}`} style="border:none;">
                      <div class="rail__title">{s.tour_name || 'Live'}</div>
                    </a>
                    <div class="rail__body mono-sm">{s.song_count ? `${s.song_count} songs performed` : 'Setlist on file'}</div>
                  </div>
                );
              })}
            </>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>
