---
import MainLayout from '../../layouts/MainLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import BlogSidebar from '../../components/sidebar/BlogSidebar.astro';

// Types for blog data
interface DirectusBlog {
  id: number | string;
  title: string;
  slug?: string;
  excerpt: string;
  content?: string;
  featured_image?: string;
  featured?: boolean;
  category: string;
  tags?: string[];
  author_name?: string;
  date_published?: string;
  reading_time?: number;
  status?: string;
}

interface BlogPost {
  id: string;
  title: string;
  slug: string;
  excerpt: string;
  featuredImage?: string;
  featured: boolean;
  category: string;
  tags: string[];
  authorName?: string;
  publishedDate: string;
  formattedDate: string;
  readingTime: number;
}

// Helper functions
function formatDate(dateString: string): string {
  return new Date(dateString).toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric'
  });
}

function generateSlug(title: string): string {
  return title
    .toLowerCase()
    .replace(/[^\w\s]/gi, '')
    .replace(/\s+/g, '-');
}

function estimateReadingTime(content: string): number {
  const wordsPerMinute = 200;
  const wordCount = content?.split(/\s+/).length || 0;
  return Math.max(1, Math.ceil(wordCount / wordsPerMinute));
}

// Fetch blog data from the CMS
let posts: BlogPost[] = [];
let categories: { name: string; slug: string; count: number }[] = [];

try {
  const response = await fetch('https://dash.cureation.net/items/blogs?filter[status][_eq]=published&sort=-date_published');
  const blogData = await response.json();

  if (blogData.data && Array.isArray(blogData.data)) {
    posts = blogData.data.map((post: DirectusBlog) => {
      const publishedDate = post.date_published || new Date().toISOString();

      return {
        id: post.id.toString(),
        title: post.title || 'Untitled',
        slug: post.slug || generateSlug(post.title || 'untitled'),
        excerpt: post.excerpt || '',
        featuredImage: post.featured_image
          ? `https://dash.cureation.net/assets/${post.featured_image}`
          : undefined,
        featured: post.featured || false,
        category: post.category || 'News',
        tags: post.tags || [],
        authorName: post.author_name,
        publishedDate,
        formattedDate: formatDate(publishedDate),
        readingTime: post.reading_time || estimateReadingTime(post.content || post.excerpt || '')
      };
    });

    // Extract and count categories
    const categoryCounts: Record<string, number> = {};
    posts.forEach((post: BlogPost) => {
      const cat = post.category.toLowerCase();
      categoryCounts[cat] = (categoryCounts[cat] || 0) + 1;
    });
    categories = Object.entries(categoryCounts)
      .map(([name, count]) => ({
        name: name.charAt(0).toUpperCase() + name.slice(1),
        slug: name,
        count
      }))
      .sort((a, b) => b.count - a.count);
  }
} catch (error) {
  console.error('Error fetching blog posts:', error);
}

const featuredPosts = posts.filter((p: BlogPost) => p.featured);
const regularPosts = posts.filter((p: BlogPost) => !p.featured);
const recentPosts = posts.slice(0, 5).map((p: BlogPost) => ({
  title: p.title,
  slug: p.slug,
  formattedDate: p.formattedDate,
  category: p.category
}));
---

<MainLayout
  title="Blog"
  description="News, history, analysis, and articles about The Cure."
  showSidebar={true}
  customSidebar={true}
  pageClass="bg-black"
>
  <BlogSidebar
    slot="sidebar"
    categories={categories}
    recentPosts={recentPosts}
    totalPosts={posts.length}
  />

  <!-- Hero Section -->
  <section class="mb-16">
    <div class="glass-card-glow rounded-2xl overflow-hidden relative">
      <!-- Decorative gradient orbs -->
      <div class="absolute -top-20 -left-20 w-64 h-64 rounded-full bg-primary/15 blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-10 -right-10 w-48 h-48 rounded-full bg-accent/10 blur-2xl pointer-events-none"></div>

      <div class="relative p-8 md:p-12">
        <div class="flex items-center gap-3 mb-4">
          <span class="badge">Latest Updates</span>
          <div class="divider-gradient flex-1 max-w-24"></div>
        </div>

        <h1 class="font-display text-6xl md:text-7xl lg:text-8xl text-white mb-4 text-glow" transition:animate="slide">
          Blog
        </h1>
        <p class="text-white/70 text-lg md:text-xl max-w-3xl leading-relaxed" transition:animate="fade">
          News, history, deep dives, and analysis about The Cure. From album retrospectives to tour announcements.
        </p>

        <!-- Quick stats -->
        <div class="flex flex-wrap gap-6 mt-8 pt-6 border-t border-white/10">
          <div class="flex items-center gap-2">
            <span class="text-2xl font-display text-primary">{posts.length}</span>
            <span class="text-white/50 text-sm">Articles</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-2xl font-display text-primary">{categories.length}</span>
            <span class="text-white/50 text-sm">Categories</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Posts -->
  {featuredPosts.length > 0 && (
    <section class="mb-16">
      <div class="flex items-center gap-4 mb-8">
        <h2 class="font-heading text-2xl text-primary">Featured</h2>
        <div class="divider-gradient flex-1"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {featuredPosts.map((post) => (
          <BlogCard
            title={post.title}
            excerpt={post.excerpt}
            slug={post.slug}
            featuredImage={post.featuredImage}
            category={post.category}
            publishedDate={post.publishedDate}
            formattedDate={post.formattedDate}
            readingTime={post.readingTime}
            featured={true}
            authorName={post.authorName}
          />
        ))}
      </div>
    </section>
  )}

  <!-- All Posts -->
  <section class="mb-12">
    <div class="flex items-center gap-4 mb-8">
      <h2 class="font-heading text-2xl text-primary">All Articles</h2>
      <div class="divider-gradient flex-1"></div>
    </div>

    {posts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {regularPosts.map((post, index) => (
          <div style={`--index: ${index + 1}`}>
            <BlogCard
              title={post.title}
              excerpt={post.excerpt}
              slug={post.slug}
              featuredImage={post.featuredImage}
              category={post.category}
              publishedDate={post.publishedDate}
              formattedDate={post.formattedDate}
              readingTime={post.readingTime}
              authorName={post.authorName}
            />
          </div>
        ))}
      </div>
    ) : (
      <div class="glass-card rounded-2xl p-12 text-center">
        <div class="text-6xl mb-4">📝</div>
        <h3 class="font-heading text-2xl text-white mb-2">No Posts Yet</h3>
        <p class="text-white/60 max-w-md mx-auto">
          The blog is being set up. Check back soon for news, articles, and deep dives about The Cure.
        </p>
      </div>
    )}
  </section>
</MainLayout>

<style>
  /* Blog grid animations */
  .grid {
    --stagger-delay: 75ms;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  :global(.grid > div) {
    animation: fadeIn 0.5s ease forwards;
    opacity: 0;
    animation-delay: calc(var(--stagger-delay) * var(--index, 1));
  }
</style>
