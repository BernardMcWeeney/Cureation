---
import MainLayout from "../../layouts/MainLayout.astro";

// Types
interface DirectusBlog {
  id: number | string;
  title: string;
  slug?: string;
  excerpt: string;
  content: string;
  featured_image?: string;
  featured?: boolean;
  category: string;
  tags?: string[];
  author_name?: string;
  author_avatar?: string;
  date_published?: string;
  reading_time?: number;
  status?: string;
  related_album?: number;
}

import { generateSlug, estimateReadingTime } from '../../lib/directus';

function formatDate(dateString: string): string {
  return new Date(dateString).toLocaleDateString('en-US', {
    weekday: 'long',
    month: 'long',
    day: 'numeric',
    year: 'numeric'
  });
}

// Category colors
const categoryColors: Record<string, string> = {
  news: 'bg-blue-500/20 text-blue-400 border-blue-500/40',
  history: 'bg-amber-500/20 text-amber-400 border-amber-500/40',
  analysis: 'bg-purple-500/20 text-purple-400 border-purple-500/40',
  reviews: 'bg-green-500/20 text-green-400 border-green-500/40',
  interviews: 'bg-pink-500/20 text-pink-400 border-pink-500/40'
};

export async function getStaticPaths() {
  try {
    const response = await fetch('https://dash.cureation.net/items/blogs?filter[status][_eq]=published');
    const blogData = await response.json();

    if (!blogData.data || !Array.isArray(blogData.data)) {
      console.log('No blog data found');
      return [];
    }

    // Process all posts
    const allPosts = blogData.data.map((post: DirectusBlog) => {
      const publishedDate = post.date_published || new Date().toISOString();

      return {
        id: post.id.toString(),
        title: post.title || 'Untitled',
        slug: post.slug || generateSlug(post.title || 'untitled'),
        excerpt: post.excerpt || '',
        content: post.content || '',
        featuredImage: post.featured_image
          ? `https://dash.cureation.net/assets/${post.featured_image}`
          : undefined,
        featured: post.featured || false,
        category: post.category || 'News',
        tags: post.tags || [],
        authorName: post.author_name,
        authorAvatar: post.author_avatar
          ? `https://dash.cureation.net/assets/${post.author_avatar}`
          : undefined,
        publishedDate,
        formattedDate: formatDate(publishedDate),
        readingTime: post.reading_time || estimateReadingTime(post.content || post.excerpt || ''),
        relatedAlbum: post.related_album
      };
    }).sort((a: { publishedDate: string }, b: { publishedDate: string }) => {
      return new Date(b.publishedDate).getTime() - new Date(a.publishedDate).getTime();
    });

    // Generate paths with related posts
    return allPosts.map((post: typeof allPosts[0]) => {
      // Find related posts (same category or has shared tags)
      const relatedPosts = allPosts
        .filter((p: typeof post) => p.slug !== post.slug)
        .filter((p: typeof post) =>
          p.category === post.category ||
          p.tags.some((t: string) => post.tags.includes(t))
        )
        .slice(0, 3);

      return {
        params: { slug: post.slug },
        props: { post, relatedPosts }
      };
    });
  } catch (error) {
    console.error('Error in getStaticPaths for blog:', error);
    return [];
  }
}

const { post, relatedPosts } = Astro.props;

const categoryClass = categoryColors[post.category.toLowerCase()] || 'bg-white/10 text-primary border-primary/40';
---

<MainLayout
  title={post.title}
  description={post.excerpt}
  ogImage={post.featuredImage}
  showSidebar={false}
  pageClass="bg-black"
>

  <!-- Background image layer -->
  {post.featuredImage && (
    <div class="fixed inset-0 z-[-1]">
      <div class="absolute inset-0 bg-black opacity-80"></div>
      <div
        class="absolute inset-0 bg-cover bg-center opacity-20 blur-xl"
        style={`background-image: url(${post.featuredImage})`}
      ></div>
    </div>
  )}

  <article class="max-w-4xl mx-auto">
    <!-- Breadcrumb -->
    <nav class="mb-8" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2 text-sm text-white/85">
        <li><a href="/blog" class="hover:text-white transition-colors">Blog</a></li>
        <li aria-hidden="true">/</li>
        <li>
          <a href={`/blog/category/${post.category.toLowerCase()}`} class="hover:text-white transition-colors capitalize">
            {post.category}
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li class="text-white truncate max-w-[200px]">{post.title}</li>
      </ol>
    </nav>

    <!-- Article Header -->
    <header class="mb-12">
      <!-- Category badge -->
      <div class="mb-4">
        <a
          href={`/blog/category/${post.category.toLowerCase()}`}
          class={`inline-block px-4 py-1 rounded-md text-sm font-medium border backdrop-blur-sm ${categoryClass} hover:opacity-80 transition-opacity`}
        >
          {post.category}
        </a>
      </div>

      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-white mb-6 text-glow">
        {post.title}
      </h1>

      <!-- Meta info -->
      <div class="flex flex-wrap items-center gap-4 text-white/85 mb-8">
        {post.authorName && (
          <div class="flex items-center gap-2">
            {post.authorAvatar ? (
              <img
                src={post.authorAvatar}
                alt={post.authorName}
                class="w-8 h-8 rounded-full object-cover"
              />
            ) : (
              <div class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center">
                <span class="text-primary text-sm font-medium">
                  {post.authorName.charAt(0).toUpperCase()}
                </span>
              </div>
            )}
            <span>{post.authorName}</span>
          </div>
        )}

        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
            <line x1="16" x2="16" y1="2" y2="6"></line>
            <line x1="8" x2="8" y1="2" y2="6"></line>
            <line x1="3" x2="21" y1="10" y2="10"></line>
          </svg>
          <time datetime={post.publishedDate}>{post.formattedDate}</time>
        </div>

        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          <span>{post.readingTime} min read</span>
        </div>
      </div>

      <!-- Featured image -->
      {post.featuredImage && (
        <div class="glass-tile overflow-hidden">
          <img
            src={post.featuredImage}
            alt=""
            class="w-full aspect-[21/9] object-cover"
          />
        </div>
      )}
    </header>

    <!-- Article Content -->
    <div class="glass-tile p-8 md:p-12 mb-12">
      <div class="prose prose-invert prose-lg max-w-none" set:html={post.content} />
    </div>

    <!-- Tags -->
    {post.tags && post.tags.length > 0 && (
      <div class="mb-12">
        <h3 class="text-white/85 text-sm uppercase tracking-wider mb-4">Tags</h3>
        <div class="flex flex-wrap gap-2">
          {post.tags.map((tag: string) => (
            <span class="px-3 py-1 rounded-md bg-white/15 border border-white/20 text-white/80 text-sm hover:bg-white/20 hover:border-white/30 transition-colors">
              #{tag}
            </span>
          ))}
        </div>
      </div>
    )}

    <!-- Share -->
    <div class="mb-12 flex items-center gap-4">
      <span class="text-white/85 text-sm">Share:</span>
      <a
        href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.title)}&url=${encodeURIComponent(`https://cureation.net/blog/${post.slug}`)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="p-2 rounded-lg bg-white/10 hover:bg-white/20 transition-colors"
        aria-label="Share on Twitter"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="size-5 text-white" viewBox="0 0 24 24" fill="currentColor">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
      </a>
    </div>

    <!-- Related Posts -->
    {relatedPosts && relatedPosts.length > 0 && (
      <section class="mb-12">
        <h2 class="font-heading text-2xl text-primary mb-6">Related Articles</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {relatedPosts.map((related: { slug: string; title: string; category: string; formattedDate: string; featuredImage?: string }) => (
            <a
              href={`/blog/${related.slug}`}
              class="glass-tile overflow-hidden group"
            >
              {related.featuredImage && (
                <div class="aspect-[16/9] overflow-hidden">
                  <img
                    src={related.featuredImage}
                    alt=""
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="p-4">
                <span class="text-xs text-primary uppercase tracking-wider">{related.category}</span>
                <h3 class="text-white group-hover:text-white transition-colors line-clamp-2 mt-1">
                  {related.title}
                </h3>
                <span class="text-white/80 text-xs mt-2 block">{related.formattedDate}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Back to blog -->
    <div class="text-center">
      <a
        href="/blog"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-white/10 border border-primary/40 text-white hover:bg-primary/30 transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m15 18-6-6 6-6"></path>
        </svg>
        Back to Blog
      </a>
    </div>
  </article>
</MainLayout>

<style>
  /* Prose styling enhancements */
  .prose {
    --tw-prose-body: rgba(255, 255, 255, 0.8);
    --tw-prose-headings: white;
    --tw-prose-links: var(--color-primary);
    --tw-prose-bold: white;
    --tw-prose-quotes: rgba(255, 255, 255, 0.7);
    --tw-prose-quote-borders: var(--color-primary);
  }

  .prose :where(a):not(:where([class~="not-prose"] *)) {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose :where(a):not(:where([class~="not-prose"] *)):hover {
    opacity: 0.8;
  }

  .prose :where(blockquote):not(:where([class~="not-prose"] *)) {
    border-left-width: 4px;
    padding-left: 1.5rem;
    font-style: italic;
  }

  .prose :where(img):not(:where([class~="not-prose"] *)) {
    border-radius: 0.75rem;
  }

  .line-clamp-2 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
</style>
