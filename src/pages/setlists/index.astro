---
import MainLayout from '../../layouts/MainLayout.astro';
import SetlistCard from '../../components/SetlistCard.astro';
import SetlistsSidebar from '../../components/sidebar/SetlistsSidebar.astro';

// Types for setlist data
interface DirectusSetlist {
  id: number | string;
  event_date: string;
  venue: string;
  city: string;
  country: string;
  tour_name?: string;
  slug?: string;
  notes?: string;
  featured?: boolean;
  cover_image?: string;
  songs?: SetlistSong[];
}

interface SetlistSong {
  song_id: number;
  position: number;
  set_type: string;
  notes?: string;
  is_cover?: boolean;
}

interface Setlist {
  id: string;
  date: string;
  formattedDate: string;
  year: number;
  venue: string;
  city: string;
  country: string;
  tourName?: string;
  slug: string;
  featured: boolean;
  coverImage?: string;
  songCount: number;
}

// Format date helper
function formatDate(dateString: string): string {
  return new Date(dateString).toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric'
  });
}

// Generate slug from venue, city, and date
function generateSlug(venue: string, city: string, date: string): string {
  const dateSlug = date.split('T')[0];
  return `${venue}-${city}-${dateSlug}`
    .toLowerCase()
    .replace(/[^\w\s-]/gi, '')
    .replace(/\s+/g, '-');
}

// Fetch setlist data from the CMS
let setlists: Setlist[] = [];
let tours: { name: string; slug: string; count: number }[] = [];
let years: number[] = [];
let totalCountries = 0;

try {
  const response = await fetch('https://dash.cureation.net/items/setlists?filter[status][_eq]=published&sort=-event_date');
  const setlistData = await response.json();

  if (setlistData.data && Array.isArray(setlistData.data)) {
    setlists = setlistData.data.map((setlist: DirectusSetlist) => {
      const eventDate = setlist.event_date || '';
      const year = eventDate ? new Date(eventDate).getFullYear() : 0;

      return {
        id: setlist.id.toString(),
        date: eventDate,
        formattedDate: eventDate ? formatDate(eventDate) : 'Date TBA',
        year,
        venue: setlist.venue || 'Unknown Venue',
        city: setlist.city || 'Unknown City',
        country: setlist.country || '',
        tourName: setlist.tour_name,
        slug: setlist.slug || generateSlug(setlist.venue || '', setlist.city || '', eventDate),
        featured: setlist.featured || false,
        coverImage: setlist.cover_image
          ? `https://dash.cureation.net/assets/${setlist.cover_image}`
          : undefined,
        songCount: setlist.songs?.length || 0
      };
    }).sort((a: Setlist, b: Setlist) => {
      // Sort by date (newest first)
      return new Date(b.date).getTime() - new Date(a.date).getTime();
    });

    // Extract unique years
    years = [...new Set(setlists.map((s: Setlist) => s.year).filter((y: number) => y > 0))].sort((a, b) => b - a);

    // Extract unique countries
    const countries = [...new Set(setlists.map((s: Setlist) => s.country).filter(Boolean))];
    totalCountries = countries.length;

    // Extract and count tours
    const tourCounts: Record<string, number> = {};
    setlists.forEach((s: Setlist) => {
      if (s.tourName) {
        tourCounts[s.tourName] = (tourCounts[s.tourName] || 0) + 1;
      }
    });
    tours = Object.entries(tourCounts)
      .map(([name, count]) => ({
        name,
        slug: name.toLowerCase().replace(/[^\w\s]/gi, '').replace(/\s+/g, '-'),
        count
      }))
      .sort((a, b) => b.count - a.count);
  }
} catch (error) {
  console.error('Error fetching setlists:', error);
}

const featuredSetlists = setlists.filter((s: Setlist) => s.featured);
const regularSetlists = setlists.filter((s: Setlist) => !s.featured);
---

<MainLayout
  title="Setlists"
  description="Browse the complete archive of The Cure's live setlists from concerts around the world."
  showSidebar={true}
  customSidebar={true}
  pageClass="bg-black"
>
  <SetlistsSidebar
    slot="sidebar"
    tours={tours}
    years={years}
    totalShows={setlists.length}
    totalCountries={totalCountries}
  />

  <!-- Hero Section -->
  <section class="mb-16">
    <div class="glass-card-glow rounded-2xl overflow-hidden relative">
      <!-- Decorative gradient orbs -->
      <div class="absolute -top-20 -left-20 w-64 h-64 rounded-full bg-primary/15 blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-10 -right-10 w-48 h-48 rounded-full bg-accent/10 blur-2xl pointer-events-none"></div>

      <div class="relative p-8 md:p-12">
        <div class="flex items-center gap-3 mb-4">
          <span class="badge">Live Archive</span>
          <div class="divider-gradient flex-1 max-w-24"></div>
        </div>

        <h1 class="font-display text-6xl md:text-7xl lg:text-8xl text-white mb-4 text-glow" transition:animate="slide">
          Setlist Archive
        </h1>
        <p class="text-white/70 text-lg md:text-xl max-w-3xl leading-relaxed" transition:animate="fade">
          Explore the complete collection of The Cure's live performances, from intimate club shows to massive arena tours spanning over four decades.
        </p>

        <!-- Quick stats -->
        <div class="flex flex-wrap gap-6 mt-8 pt-6 border-t border-white/10">
          <div class="flex items-center gap-2">
            <span class="text-2xl font-display text-primary">{setlists.length}</span>
            <span class="text-white/50 text-sm">Shows</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-2xl font-display text-primary">{totalCountries}</span>
            <span class="text-white/50 text-sm">Countries</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-2xl font-display text-primary">{tours.length}</span>
            <span class="text-white/50 text-sm">Tours</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Setlists -->
  {featuredSetlists.length > 0 && (
    <section class="mb-16">
      <div class="flex items-center gap-4 mb-8">
        <h2 class="font-heading text-2xl text-primary">Notable Shows</h2>
        <div class="divider-gradient flex-1"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {featuredSetlists.map((setlist) => (
          <div data-setlist-year={setlist.year}>
            <SetlistCard
              date={setlist.date}
              formattedDate={setlist.formattedDate}
              venue={setlist.venue}
              city={setlist.city}
              country={setlist.country}
              tourName={setlist.tourName}
              slug={setlist.slug}
              songCount={setlist.songCount}
              featured={true}
              coverImage={setlist.coverImage}
            />
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- All Setlists -->
  <section class="mb-12">
    <div class="flex items-center gap-4 mb-8">
      <h2 class="font-heading text-2xl text-primary">All Shows</h2>
      <div class="divider-gradient flex-1"></div>
    </div>

    {setlists.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {regularSetlists.map((setlist, index) => (
          <div data-setlist-year={setlist.year} style={`--index: ${index + 1}`}>
            <SetlistCard
              date={setlist.date}
              formattedDate={setlist.formattedDate}
              venue={setlist.venue}
              city={setlist.city}
              country={setlist.country}
              tourName={setlist.tourName}
              slug={setlist.slug}
              songCount={setlist.songCount}
              coverImage={setlist.coverImage}
            />
          </div>
        ))}
      </div>
    ) : (
      <div class="glass-card rounded-2xl p-12 text-center">
        <div class="text-6xl mb-4">🎤</div>
        <h3 class="font-heading text-2xl text-white mb-2">No Setlists Yet</h3>
        <p class="text-white/60 max-w-md mx-auto">
          The setlist archive is being built. Check back soon for concert data from The Cure's legendary live performances.
        </p>
      </div>
    )}
  </section>
</MainLayout>

<style>
  /* Setlist grid animations */
  .grid {
    --stagger-delay: 75ms;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  :global(.grid > div) {
    animation: fadeIn 0.5s ease forwards;
    opacity: 0;
    animation-delay: calc(var(--stagger-delay) * var(--index, 1));
  }
</style>
