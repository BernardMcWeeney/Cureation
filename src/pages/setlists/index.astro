---
import MainLayout from '../../layouts/MainLayout.astro';
import SetlistCard from '../../components/SetlistCard.astro';

import { filterPastSetlists, formatDate, generateSetlistSlug } from '../../lib/directus';

const DIRECTUS_URL = 'https://dash.cureation.net';
const PER_PAGE = 36;

interface SetlistItem {
  id: string;
  date: string;
  formattedDate: string;
  year: number;
  venue: string;
  city: string;
  country: string;
  countryCode?: string;
  tourName?: string;
  slug: string;
  songCount: number;
  coverImage?: string;
}

const generateSlug = generateSetlistSlug;

// Fetch all setlists
let setlists: SetlistItem[] = [];
let tours: { name: string; slug: string; count: number }[] = [];
let years: number[] = [];
let countries: string[] = [];
let totalCountries = 0;

try {
  const response = await fetch(`${DIRECTUS_URL}/items/setlists?sort=-date&limit=-1&fields=id,date,venue,city,country,country_code,tour_name,slug,song_count,venue_image,state_province`);
  const data = await response.json();

  if (data.data && Array.isArray(data.data)) {
    setlists = data.data.map((s: any) => {
      const date = s.date || '';
      const year = date ? new Date(date).getFullYear() : 0;
      const coverImage = s.venue_image
        ? (s.venue_image.startsWith('http') ? s.venue_image : `${DIRECTUS_URL}/assets/${s.venue_image}`)
        : undefined;

      return {
        id: s.id.toString(),
        date,
        formattedDate: date ? formatDate(date) : 'Date TBA',
        year,
        venue: s.venue || 'Unknown Venue',
        city: s.city || 'Unknown City',
        country: s.country || '',
        countryCode: s.country_code || undefined,
        tourName: s.tour_name || undefined,
        slug: s.slug || generateSlug(s.venue || '', s.city || '', date),
        songCount: s.song_count || 0,
        coverImage,
      };
    }).sort((a: SetlistItem, b: SetlistItem) =>
      new Date(b.date).getTime() - new Date(a.date).getTime()
    );

    years = [...new Set(setlists.map(s => s.year).filter(y => y > 0))].sort((a, b) => b - a);
    countries = [...new Set(setlists.map(s => s.country).filter(Boolean))].sort();
    totalCountries = countries.length;

    const tourCounts: Record<string, number> = {};
    setlists.forEach(s => {
      if (s.tourName) {
        tourCounts[s.tourName] = (tourCounts[s.tourName] || 0) + 1;
      }
    });
    tours = Object.entries(tourCounts)
      .map(([name, count]) => ({
        name,
        slug: name.toLowerCase().replace(/[^\w\s]/gi, '').replace(/\s+/g, '-'),
        count
      }))
      .sort((a, b) => b.count - a.count);
  }
} catch (error) {
  console.error('Error fetching setlists:', error);
}

const decades = [...new Set(years.map(y => Math.floor(y / 10) * 10))].sort((a, b) => b - a);
const historicalSetlists = filterPastSetlists(setlists);
const historicalCountries = [...new Set(historicalSetlists.map(s => s.country).filter(Boolean))];
const totalSongs = historicalSetlists.reduce((sum, s) => sum + s.songCount, 0);

// Bento widget data
const latestShow = historicalSetlists[0];
const historicalYears = [...new Set(historicalSetlists.map(s => s.year).filter(y => y > 0))].sort((a, b) => b - a);
const firstYear = historicalYears.length > 0 ? historicalYears[historicalYears.length - 1] : 1976;
const latestYear = historicalYears.length > 0 ? historicalYears[0] : new Date().getFullYear();

// Most visited country
const countryCounts: Record<string, number> = {};
historicalSetlists.forEach(s => { if (s.country) countryCounts[s.country] = (countryCounts[s.country] || 0) + 1; });
const topCountry = Object.entries(countryCounts).sort(([,a], [,b]) => b - a)[0];

// Biggest tour
const biggestTour = tours[0];
---

<MainLayout
  title="Setlists"
  description="Browse 748+ complete setlists from The Cure's live concerts spanning over four decades."
  showSidebar={false}
  pageClass="bg-black"
>
  <!-- Hero Section -->
  <section class="mb-10">
    <div class="glass-panel overflow-hidden relative">
      <div class="absolute -top-20 -left-20 w-64 h-64 rounded-full bg-white/[0.06] blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-10 -right-10 w-48 h-48 rounded-full bg-accent/[0.06] blur-2xl pointer-events-none"></div>

      <div class="relative p-8 md:p-12">
        <h1 class="font-display text-5xl md:text-6xl lg:text-7xl text-white mb-4 text-glow">
          Setlists
        </h1>
        <p class="text-white/75 text-lg md:text-xl max-w-3xl leading-relaxed">
          The definitive collection of The Cure's live performances — every song, every show, every tour.
        </p>

        <div class="flex flex-wrap gap-8 mt-8 pt-6 border-t border-white/[0.08]">
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-white text-glow">{historicalSetlists.length.toLocaleString()}</span>
            <span class="text-white/85 text-base font-medium">Shows</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-white text-glow">{totalSongs.toLocaleString()}</span>
            <span class="text-white/85 text-base font-medium">Performances</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-white text-glow">{historicalCountries.length}</span>
            <span class="text-white/85 text-base font-medium">Countries</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-white text-glow">{tours.length}</span>
            <span class="text-white/85 text-base font-medium">Tours</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick Insights Bento -->
  <section class="mb-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
      {latestShow && (
        <a href={`/setlists/${latestShow.slug}`} class="glass-tile p-4 group block">
          <p class="text-white/50 text-[11px] uppercase tracking-[0.15em] mb-1">Latest Show</p>
          <p class="text-white font-heading text-sm group-hover:text-primary transition-colors truncate">{latestShow.venue}</p>
          <p class="text-white/60 text-xs">{latestShow.formattedDate}</p>
        </a>
      )}
      {topCountry && (
        <div class="glass-tile p-4">
          <p class="text-white/50 text-[11px] uppercase tracking-[0.15em] mb-1">Most Visited</p>
          <p class="text-white font-heading text-sm">{topCountry[0]}</p>
          <p class="text-primary text-xs font-medium">{topCountry[1]} shows</p>
        </div>
      )}
      {biggestTour && (
        <div class="glass-tile p-4">
          <p class="text-white/50 text-[11px] uppercase tracking-[0.15em] mb-1">Biggest Tour</p>
          <p class="text-white font-heading text-sm truncate">{biggestTour.name}</p>
          <p class="text-primary text-xs font-medium">{biggestTour.count} shows</p>
        </div>
      )}
      <div class="glass-tile p-4">
        <p class="text-white/50 text-[11px] uppercase tracking-[0.15em] mb-1">Spanning</p>
        <p class="text-white font-heading text-sm">{firstYear} — {latestYear}</p>
        <p class="text-primary text-xs font-medium">{latestYear - firstYear} years of touring</p>
      </div>
    </div>
  </section>

  <!-- Search & Filters -->
  <section class="mb-8">
    <!-- Search bar - matching lyrics page -->
    <div class="relative mb-4">
      <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-4 top-1/2 -translate-y-1/2 size-4 text-white/80 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
      <input
        type="text"
        id="setlist-search"
        placeholder="Search venues, cities, countries..."
        class="w-full pl-12 pr-4 py-2.5 rounded-sm bg-white/5 border border-white/10 text-white placeholder-white/40 focus:border-primary/50 focus:outline-none focus:ring-1 focus:ring-primary/30 transition-colors text-sm font-medium tracking-wide"
      />
    </div>

    <!-- Filter dropdowns - matching type-tab sizing -->
    <div class="flex flex-wrap items-center gap-2">
      <div class="filter-select-wrap">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <select id="filter-decade" class="filter-select">
          <option value="">All Decades</option>
          {decades.map(d => (
            <option value={d}>{d}s</option>
          ))}
        </select>
      </div>

      <div class="filter-select-wrap">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
          <line x1="16" x2="16" y1="2" y2="6"></line>
          <line x1="8" x2="8" y1="2" y2="6"></line>
          <line x1="3" x2="21" y1="10" y2="10"></line>
        </svg>
        <select id="filter-year" class="filter-select">
          <option value="">All Years</option>
          {years.map(y => (
            <option value={y}>{y}</option>
          ))}
        </select>
      </div>

      <div class="filter-select-wrap">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 18V5l12-2v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
        </svg>
        <select id="filter-tour" class="filter-select">
          <option value="">All Tours</option>
          {tours.map(t => (
            <option value={t.name}>{t.name} ({t.count})</option>
          ))}
        </select>
      </div>

      <div class="filter-select-wrap">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"></path>
        </svg>
        <select id="filter-country" class="filter-select">
          <option value="">All Countries</option>
          {countries.map(c => (
            <option value={c}>{c}</option>
          ))}
        </select>
      </div>

      <button id="clear-filters" class="type-tab items-center gap-2 px-4 py-2.5 rounded-sm text-sm font-medium transition-all whitespace-nowrap tracking-wide text-primary" style="display:none">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6L6 18M6 6l12 12" />
        </svg>
        Clear Filters
      </button>
    </div>

    <!-- Results count + View Toggle -->
    <div class="mt-4 flex items-center justify-between">
      <div id="results-count" class="text-white/80 text-sm">
        Showing {Math.min(PER_PAGE, setlists.length)} of {setlists.length} shows
      </div>
      <div class="flex items-center gap-1 p-1 rounded-sm bg-black/40 border border-white/[0.08]">
        <button type="button" id="view-grid-btn" class="view-btn px-3 py-1.5 rounded-sm text-xs font-medium tracking-wide transition-all active flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
          Grid
        </button>
        <button type="button" id="view-timeline-btn" class="view-btn px-3 py-1.5 rounded-sm text-xs font-medium tracking-wide transition-all flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="2" x2="12" y2="22"/><circle cx="12" cy="6" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="12" cy="18" r="2"/></svg>
          Timeline
        </button>
      </div>
    </div>
  </section>

  <!-- Setlist Grid -->
  <section class="mb-12">
    {setlists.length > 0 ? (
      <div id="setlist-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {setlists.map((setlist, index) => (
          <div
            class="setlist-item"
            data-venue={setlist.venue.toLowerCase()}
            data-city={setlist.city.toLowerCase()}
            data-country={setlist.country.toLowerCase()}
            data-year={setlist.year}
            data-tour={setlist.tourName?.toLowerCase() || ''}
            data-index={index}
            style={index >= PER_PAGE ? 'display:none' : ''}
          >
            <SetlistCard
              date={setlist.date}
              formattedDate={setlist.formattedDate}
              venue={setlist.venue}
              city={setlist.city}
              country={setlist.country}
              countryCode={setlist.countryCode}
              tourName={setlist.tourName}
              slug={setlist.slug}
              songCount={setlist.songCount}
              coverImage={setlist.coverImage}
            />
          </div>
        ))}
      </div>
    ) : (
      <div class="glass-card rounded-2xl p-12 text-center">
        <h3 class="font-heading text-2xl text-white mb-2">No Setlists Yet</h3>
        <p class="text-white/85 max-w-md mx-auto">
          The setlist archive is being built. Check back soon for concert data.
        </p>
      </div>
    )}

    <!-- Timeline View (hidden by default) -->
    <div id="timeline-view" class="hidden">
      {years.map(year => {
        const yearSetlists = setlists.filter(s => s.year === year);
        if (yearSetlists.length === 0) return null;
        return (
          <div class="timeline-year mb-8" data-timeline-year={year}>
            <div class="flex items-center gap-4 mb-4 sticky top-0 z-10 py-2 bg-black/80 backdrop-blur-sm">
              <span class="font-display text-2xl text-primary">{year}</span>
              <div class="flex-1 h-px bg-gradient-to-r from-primary/30 to-transparent"></div>
              <span class="text-white/40 text-sm">{yearSetlists.length} shows</span>
            </div>
            <div class="relative pl-8 border-l-2 border-white/10 ml-4 space-y-1">
              {yearSetlists.map(show => (
                <a
                  href={`/setlists/${show.slug}`}
                  class="timeline-item group flex items-center gap-4 p-3 rounded-lg hover:bg-white/[0.03] transition-colors relative"
                  data-venue={show.venue.toLowerCase()}
                  data-city={show.city.toLowerCase()}
                  data-country={show.country.toLowerCase()}
                  data-year={show.year}
                  data-tour={show.tourName?.toLowerCase() || ''}
                >
                  {/* Dot on timeline */}
                  <div class="absolute -left-[calc(2rem+5px)] w-2.5 h-2.5 rounded-full bg-primary/60 border-2 border-black group-hover:bg-primary transition-colors"></div>

                  {/* Date */}
                  <div class="text-center min-w-[50px] shrink-0">
                    <div class="text-lg font-display text-white leading-tight">
                      {new Date(show.date).getDate()}
                    </div>
                    <div class="text-white/50 text-[10px] uppercase">
                      {new Date(show.date).toLocaleDateString('en-US', { month: 'short' })}
                    </div>
                  </div>

                  {/* Venue image */}
                  {show.coverImage && (
                    <img
                      src={show.coverImage}
                      alt={show.venue}
                      class="w-12 h-12 rounded-lg object-cover shrink-0 border border-white/10 hidden sm:block"
                      loading="lazy"
                    />
                  )}

                  {/* Info */}
                  <div class="flex-1 min-w-0">
                    <div class="text-white text-sm font-medium group-hover:text-primary transition-colors truncate">
                      {show.venue}
                    </div>
                    <div class="text-white/50 text-xs truncate">
                      {show.city}{show.country ? `, ${show.country}` : ''}
                      {show.tourName && <span class="text-white/30"> &middot; {show.tourName}</span>}
                    </div>
                  </div>

                  {/* Song count */}
                  {show.songCount > 0 && (
                    <span class="text-white/30 text-xs shrink-0 hidden sm:inline">{show.songCount} songs</span>
                  )}

                  <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5 text-primary opacity-0 group-hover:opacity-70 transition-opacity shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
                </a>
              ))}
            </div>
          </div>
        );
      })}
    </div>

    <!-- No results message -->
    <div id="no-results" class="hidden glass-card rounded-2xl p-12 text-center">
      <h3 class="font-heading text-2xl text-white mb-2">No Matching Shows</h3>
      <p class="text-white/85 max-w-md mx-auto">
        Try adjusting your search or filters.
      </p>
    </div>

    <!-- Pagination / Load More -->
    <div id="pagination" class="mt-10 flex flex-col items-center gap-4">
      <button
        id="load-more"
        class="px-8 py-3 rounded-xl bg-white/10 border border-primary/40 text-white hover:bg-primary/30 transition-colors font-medium"
      >
        Load More Shows
      </button>
      <div id="page-info" class="text-white/80 text-sm"></div>
    </div>
  </section>
</MainLayout>

<style>
  /* Filter select wrapper - matching type-tab pattern */
  .filter-select-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    border-radius: 2px;
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    letter-spacing: 0.025em;
    color: rgba(255, 255, 255, 0.45);
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .filter-select-wrap:hover,
  .filter-select-wrap:focus-within {
    color: rgba(255, 255, 255, 0.85);
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.1);
  }

  .filter-select {
    appearance: none;
    background: transparent;
    border: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    cursor: pointer;
    outline: none;
    padding-right: 0.5rem;
  }

  select option {
    background: #1a1a2e;
    color: white;
  }

  /* Type tab styling for clear button */
  .type-tab {
    color: rgba(255, 255, 255, 0.45);
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }
  .type-tab:hover {
    color: rgba(255, 255, 255, 0.85);
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.1);
  }

  /* View toggle */
  .view-btn {
    color: rgba(255, 255, 255, 0.45);
  }
  .view-btn:hover {
    color: rgba(255, 255, 255, 0.8);
    background: rgba(255, 255, 255, 0.04);
  }
  .view-btn.active {
    background: rgba(var(--color-primary-rgb, 137, 176, 201), 0.15);
    color: var(--color-primary);
  }

  .setlist-item {
    animation: fadeSlideIn 0.4s ease forwards;
    opacity: 0;
  }

  @keyframes fadeSlideIn {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script is:inline define:vars={{ PER_PAGE }}>
  function initSetlistFilters() {
    const searchInput = document.getElementById('setlist-search');
    const filterDecade = document.getElementById('filter-decade');
    const filterYear = document.getElementById('filter-year');
    const filterTour = document.getElementById('filter-tour');
    const filterCountry = document.getElementById('filter-country');
    const clearBtn = document.getElementById('clear-filters');
    const resultsCount = document.getElementById('results-count');
    const noResults = document.getElementById('no-results');
    const grid = document.getElementById('setlist-grid');
    const loadMoreBtn = document.getElementById('load-more');
    const pageInfo = document.getElementById('page-info');
    const items = document.querySelectorAll('.setlist-item');

    if (!grid || !items.length) return;

    let currentPage = 1;
    let matchingItems = [];

    function getFilters() {
      return {
        search: (searchInput?.value || '').toLowerCase().trim(),
        decade: filterDecade?.value || '',
        year: filterYear?.value || '',
        tour: (filterTour?.value || '').toLowerCase(),
        country: (filterCountry?.value || '').toLowerCase(),
      };
    }

    function applyFilters() {
      const filters = getFilters();
      const hasFilters = filters.search || filters.decade || filters.year || filters.tour || filters.country;

      matchingItems = [];

      items.forEach((item) => {
        const venue = item.dataset.venue || '';
        const city = item.dataset.city || '';
        const country = item.dataset.country || '';
        const year = parseInt(item.dataset.year || '0');
        const tour = item.dataset.tour || '';

        let matches = true;

        if (filters.search) {
          const haystack = `${venue} ${city} ${country} ${tour}`;
          matches = haystack.includes(filters.search);
        }

        if (matches && filters.decade) {
          const decadeStart = parseInt(filters.decade);
          matches = year >= decadeStart && year <= decadeStart + 9;
        }

        if (matches && filters.year) {
          matches = year === parseInt(filters.year);
        }

        if (matches && filters.tour) {
          matches = tour === filters.tour;
        }

        if (matches && filters.country) {
          matches = country === filters.country;
        }

        if (matches) {
          matchingItems.push(item);
        }
      });

      // Reset page
      currentPage = 1;
      renderPage();

      // Show/hide clear button
      if (clearBtn) {
        clearBtn.style.display = hasFilters ? 'flex' : 'none';
      }

      // Show/hide no results
      if (noResults) {
        noResults.classList.toggle('hidden', matchingItems.length > 0);
      }
      if (grid && !grid.classList.contains('hidden')) {
        // Grid view is active - don't re-hide
      }

      // Also update timeline view
      updateTimelineFilters(filters);
    }

    function updateTimelineFilters(filters) {
      const tv = document.getElementById('timeline-view');
      if (!tv) return;
      const tItems = tv.querySelectorAll('.timeline-item');
      let count = 0;
      tItems.forEach((item) => {
        const venue = item.dataset.venue || '';
        const city = item.dataset.city || '';
        const country = item.dataset.country || '';
        const year = parseInt(item.dataset.year || '0');
        const tour = item.dataset.tour || '';
        let ok = true;
        if (filters.search) { ok = `${venue} ${city} ${country} ${tour}`.includes(filters.search); }
        if (ok && filters.decade) { const d = parseInt(filters.decade); ok = year >= d && year <= d + 9; }
        if (ok && filters.year) ok = year === parseInt(filters.year);
        if (ok && filters.tour) ok = tour === filters.tour;
        if (ok && filters.country) ok = country === filters.country;
        item.style.display = ok ? '' : 'none';
        if (ok) count++;
      });
      tv.querySelectorAll('.timeline-year').forEach((yg) => {
        yg.style.display = yg.querySelectorAll('.timeline-item:not([style*="display: none"])').length > 0 ? '' : 'none';
      });
    }

    function renderPage() {
      const totalVisible = currentPage * PER_PAGE;

      // Hide all items first
      items.forEach((item) => {
        item.style.display = 'none';
      });

      // Show matching items up to current page
      matchingItems.forEach((item, idx) => {
        if (idx < totalVisible) {
          item.style.display = '';
        }
      });

      // Update results count
      const showing = Math.min(totalVisible, matchingItems.length);
      if (resultsCount) {
        resultsCount.textContent = `Showing ${showing} of ${matchingItems.length} shows`;
      }

      // Update load more button
      if (loadMoreBtn) {
        loadMoreBtn.style.display = totalVisible >= matchingItems.length ? 'none' : '';
      }

      // Update page info
      if (pageInfo) {
        const remaining = matchingItems.length - showing;
        pageInfo.textContent = remaining > 0 ? `${remaining} more shows` : '';
      }
    }

    // Initialize matching items (all by default)
    matchingItems = Array.from(items);
    renderPage();

    // Event listeners
    let searchTimeout;
    searchInput?.addEventListener('input', () => {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(applyFilters, 200);
    });

    filterDecade?.addEventListener('change', () => {
      // When decade changes, clear year filter if it's outside the decade
      if (filterDecade.value && filterYear) {
        const decadeStart = parseInt(filterDecade.value);
        const selectedYear = parseInt(filterYear.value);
        if (selectedYear && (selectedYear < decadeStart || selectedYear > decadeStart + 9)) {
          filterYear.value = '';
        }
      }
      applyFilters();
    });

    filterYear?.addEventListener('change', applyFilters);
    filterTour?.addEventListener('change', applyFilters);
    filterCountry?.addEventListener('change', applyFilters);

    clearBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      if (filterDecade) filterDecade.value = '';
      if (filterYear) filterYear.value = '';
      if (filterTour) filterTour.value = '';
      if (filterCountry) filterCountry.value = '';
      applyFilters();
    });

    loadMoreBtn?.addEventListener('click', () => {
      currentPage++;
      renderPage();
    });

    // View toggle (Grid vs Timeline)
    const gridBtn = document.getElementById('view-grid-btn');
    const timelineBtn = document.getElementById('view-timeline-btn');
    const timelineView = document.getElementById('timeline-view');
    const pagination = document.getElementById('pagination');

    gridBtn?.addEventListener('click', () => {
      gridBtn.classList.add('active');
      timelineBtn?.classList.remove('active');
      grid?.classList.remove('hidden');
      timelineView?.classList.add('hidden');
      if (pagination) pagination.style.display = '';
      renderPage();
    });

    timelineBtn?.addEventListener('click', () => {
      timelineBtn.classList.add('active');
      gridBtn?.classList.remove('active');
      grid?.classList.add('hidden');
      timelineView?.classList.remove('hidden');
      if (pagination) pagination.style.display = 'none';
      updateTimelineFilters(getFilters());
    });
  }

  document.addEventListener('DOMContentLoaded', initSetlistFilters);
  document.addEventListener('astro:page-load', initSetlistFilters);
</script>
