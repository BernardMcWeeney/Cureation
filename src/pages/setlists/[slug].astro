---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import Crumbs from '../../components/ui/Crumbs.astro';
import Bookmark from '../../components/ui/Bookmark.astro';
import DossierNav from '../../components/ui/DossierNav.astro';
import TourStrip from '../../components/viz/TourStrip.astro';
import EraBreakdown from '../../components/viz/EraBreakdown.astro';
import { getSetlistBySlug, getSetlistSongs, getVenueById, listAlbums, listEras, listSetlists } from '../../lib/directus';
import { asset } from '../../lib/assets';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/setlists');
const setlist = await getSetlistBySlug(slug);
if (!setlist) return new Response('Not found', { status: 404 });

const [songs, venue, albums, eras, tourSetlists] = await Promise.all([
  getSetlistSongs(setlist.id),
  setlist.venue_link ? getVenueById(setlist.venue_link) : Promise.resolve(null),
  listAlbums(),
  listEras(),
  setlist.tour ? listSetlists({ tour: setlist.tour, limit: 400 }) : Promise.resolve([]),
]);

// Build era breakdown from songs -> album -> era
const albumById = new Map(albums.map((a) => [a.id, a]));
const eraById = new Map(eras.map((e) => [e.id, e]));
const eraCounts = new Map<string, { name: string; hue: number | null; count: number }>();
for (const row of songs) {
  const albumId = row.song?.album;
  const album = albumId ? albumById.get(albumId) : null;
  const eraId = album?.era_id;
  const era = eraId ? eraById.get(eraId) : null;
  const key = era?.id || 'other';
  const prev = eraCounts.get(key) || { name: era?.short_name || era?.name || 'Other', hue: era?.hue ?? null, count: 0 };
  prev.count += 1;
  eraCounts.set(key, prev);
}
const eraSegments = Array.from(eraCounts.values()).map((e) => ({
  label: e.name, count: e.count, hue: e.hue,
}));

// Tour position – keep null when this show can't be located in the tour
// sequence, so we don't render "Show 0 of N".
let tourIndex: number | null = null;
let tourTotal = 0;
let nearbyShows: Array<any> = [];
if (tourSetlists.length > 0) {
  const sorted = [...tourSetlists].sort((a, b) => (a.date || '').localeCompare(b.date || ''));
  tourTotal = sorted.length;
  const idx = sorted.findIndex((s) => s.id === setlist.id);
  if (idx >= 0) {
    tourIndex = idx;
    const from = Math.max(0, idx - 2);
    const to = Math.min(sorted.length, idx + 3);
    nearbyShows = sorted.slice(from, to).filter((s) => s.id !== setlist.id);
  }
}

// First sentence of facts as editorial commentary
const commentary: string | null = setlist.facts
  ? String(setlist.facts).split(/(?<=[\.\!\?])\s/).slice(0, 2).join(' ').trim()
  : null;

const year = setlist.date?.slice(0, 4) || '–';
const readableDate = setlist.date
  ? new Date(setlist.date).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric', weekday: 'long' })
  : '–';
const locationLabel = [setlist.city, setlist.state_province, setlist.country].filter(Boolean).join(', ') || 'Location not on file';
const heroImage = setlist.hero_image || venue?.photo_file || null;

const sets = songs.reduce((acc: Record<string, any[]>, s: any) => {
  const k = s.set_type || 'main';
  (acc[k] = acc[k] || []).push(s);
  return acc;
}, {});
const setOrder = ['main', 'encore_1', 'encore_2', 'encore_3', 'encore'];
const orderedSets = [
  ...setOrder.filter((k) => sets[k]).map((k) => [k, sets[k]] as const),
  ...Object.entries(sets).filter(([k]) => !setOrder.includes(k)),
];
const labelFor = (k: string) => k === 'main' ? 'Main set' : k.replace('_', ' ').replace(/\b\w/g, (c) => c.toUpperCase());

const covers = songs.filter((s) => s.is_cover).length;
const debuts = songs.filter((s) => s.is_debut).length;
const uniqueAlbums = new Set(songs.map((s) => s.song?.album).filter(Boolean)).size;

// The header already carries the event date, venue, location and tour context.
// Keep this strip for performance-derived information only.
const hasSongs = songs.length > 0;
const performanceFacts: Array<[string, string]> = hasSongs ? [
  ['Songs', String(songs.length)],
  ['Covers', String(covers)],
  ['Debuts', String(debuts)],
  ['Albums represented', String(uniqueAlbums)],
] : [];
const isUpcoming = Boolean(setlist.date && new Date(`${String(setlist.date).slice(0, 10)}T23:59:59`).getTime() >= Date.now());

const supportActs: string[] = Array.isArray(setlist.support_acts)
  ? setlist.support_acts.map((a: any) => typeof a === 'string' ? a : (a?.name || a?.artist)).filter(Boolean)
  : [];

const audioLinks: any[] = Array.isArray(setlist.audio_links) ? setlist.audio_links : [];
const videoLinks: any[] = Array.isArray(setlist.video_links) ? setlist.video_links : [];
const recordings: any[] = Array.isArray(setlist.recordings) ? setlist.recordings : [];
const additional: any[] = Array.isArray(setlist.additional_links) ? setlist.additional_links : [];
const hasShowFile = Boolean(
  eraSegments.length
  || (tourTotal > 1 && tourIndex !== null)
  || nearbyShows.length
  || venue
  || supportActs.length
  || recordings.length
  || audioLinks.length
  || videoLinks.length
  || additional.length
  || setlist.cure_concerts_url
);
---
<Layout title={`${setlist.venue || 'Setlist'} · ${setlist.date} · Cureation`} description={setlist.notes || `${songs.length} songs performed at ${setlist.venue || 'this show'} on ${setlist.date}.`} ogImage={(setlist.hero_image || venue?.photo_file) ? asset(setlist.hero_image || venue!.photo_file, 'og') : undefined}>

  <div class="container show-crumbs">
    <Crumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Setlists', href: '/setlists' },
      ...(setlist.tour_name ? [{ label: setlist.tour_name, href: '/tours' }] : []),
      { label: `${setlist.venue} · ${setlist.date}` },
    ]} />
  </div>

  {heroImage && (
    <section class="container show-hero">
      <figure>
        <img src={asset(heroImage, 'hero')} alt={setlist.venue || 'Concert'} />
        <div class="cover-plate__corner cover-plate__corner--tl"><span>LIVE ARCHIVE</span></div>
      </figure>
    </section>
  )}

  <section id="show-overview" class:list={['container', 'show-head', 'detail-anchor', { 'show-head--after-image': Boolean(heroImage) }]}>
    <div class="show-head__topline">
      <span>Concert · {year}</span>
      <Bookmark kind="setlist" id={setlist.id} label={`${setlist.venue || 'Show'} · ${setlist.date || ''}`} href={`/setlists/${setlist.slug}`} actionLabel="Save show" />
    </div>
    <h1 class="show-head__title serif">{setlist.venue || '–'}</h1>
    <div class="show-head__meta">
      <time datetime={setlist.date || undefined}>{readableDate}</time>
      <span>{locationLabel}</span>
    </div>

    {setlist.notes && (
      <p class="show-head__lede">{setlist.notes}</p>
    )}
    {commentary && (
      <aside class="commentary" aria-label="Archivist commentary">
        <div class="commentary__lead">
          <div class="mono-sm muted">Commentary track</div>
          <div class="serif commentary__title">The Record</div>
          <div class="mono-sm muted commentary__cite">Archive notes · entry {String(setlist.id).padStart(3, '0')}</div>
        </div>
        <p class="commentary__body">{commentary}</p>
      </aside>
    )}

    {performanceFacts.length > 0 && (
      <div class="facts show-head__facts">
        {performanceFacts.map(([k, v]) => (
          <div class="facts__item">
            <div class="facts__k">{k}</div>
            <div class="facts__v">{v}</div>
          </div>
        ))}
      </div>
    )}
  </section>

  <div class="container">
    <DossierNav items={[
      { label: 'Overview', href: '#show-overview', meta: year },
      { label: 'Setlist', href: '#show-setlist', meta: hasSongs ? `${songs.length} songs` : 'Pending' },
      ...(hasShowFile ? [{ label: 'Show file', href: '#show-file', meta: 'Context' }] : []),
    ]} />
  </div>

  <section id="show-setlist" class="container show-content detail-anchor">
    <div class="show-grid">
      <div class="show-grid__main stack" style="--gap: 2rem;">
        {!hasSongs && (
          <div class="setlist-empty">
            <span>{isUpcoming ? 'Upcoming performance' : 'Archive gap'}</span>
            <strong>{isUpcoming ? 'Song order to follow.' : 'Setlist not yet filed.'}</strong>
            <p>{isUpcoming ? 'The song order will appear here after the show.' : 'This concert is documented, but its song order is still being researched.'}</p>
          </div>
        )}
        {orderedSets.map(([k, items]) => {
          const includesNotes = items.some((row: any) => Boolean(row.notes));
          const includesLengths = items.some((row: any) => Boolean(row.song?.duration));
          return (
            <div>
              <div class="panel-head setlist-head">
                <span>{labelFor(k)}</span>
                <span>{items.length} SONGS</span>
              </div>
              <table class="data setlist-table">
                <thead><tr><th style="width:50px;">№</th><th>Title</th>{includesNotes && <th>Notes</th>}{includesLengths && <th class="num" style="text-align:right; width:80px;">Length</th>}</tr></thead>
                <tbody>
                  {items.map((row: any) => {
                    const songTitle = row.song?.title || row.song_title;
                    return (
                      <tr>
                        <td class="idx setlist-track__position">{String(row.position).padStart(2, '0')}</td>
                        <td class="setlist-track__title">
                          {row.song?.slug
                            ? <a class="setlist-track__link" href={`/songs/${row.song.slug}`}>{songTitle}</a>
                            : <span class="setlist-track__name">{songTitle}</span>}
                          {(Boolean(row.is_cover) || Boolean(row.is_debut)) && (
                            <span class="setlist-track__flags">
                              {Boolean(row.is_cover) && <span>COVER{row.cover_artist ? ` · ${row.cover_artist.toUpperCase()}` : ''}</span>}
                              {Boolean(row.is_debut) && <span>DEBUT</span>}
                            </span>
                          )}
                        </td>
                        {includesNotes && <td class:list={['mono-sm', 'muted', 'setlist-track__notes', { 'is-empty': !row.notes }]}>{row.notes || ''}</td>}
                        {includesLengths && <td class:list={['num', 'setlist-track__length', { 'is-empty': !row.song?.duration }]}>{row.song?.duration || '–'}</td>}
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          );
        })}

        {setlist.stage_banter && (Array.isArray(setlist.stage_banter) ? setlist.stage_banter.length : 0) > 0 && (
          <div>
            <div class="panel-head" style="border: 1px solid var(--rule);">
              <span>Stage banter</span>
              <span>OVERHEARD</span>
            </div>
            <div class="voices" style="max-width: none; margin: 0; border: 1px solid var(--rule); border-top: none;">
              {setlist.stage_banter.map((b: any) => (
                <div class="voices__quote" style="margin-bottom:.8rem;">"{typeof b === 'string' ? b : (b.quote || b.text)}"</div>
              ))}
            </div>
          </div>
        )}
      </div>

      <aside id="show-file" class="show-grid__aside stack detail-anchor" style="--gap: 1.4rem;">
        {eraSegments.length > 0 && (
          <div class="panel--bare">
            <div class="panel-head"><span>Setlist by era</span><span>{songs.length} SONGS</span></div>
            <div style="padding: 14px 16px 18px;">
              <EraBreakdown segments={eraSegments} total={songs.length} />
            </div>
          </div>
        )}

        {tourTotal > 1 && tourIndex !== null && (
          <div class="panel--bare">
            <div class="panel-head"><span>Tour progress</span><span>{tourTotal} SHOWS</span></div>
            <div class="show-tour">
              <a href="/tours">{setlist.tour_name || 'Tour archive'} <span>→</span></a>
              <TourStrip total={tourTotal} current={tourIndex} height={36} />
            </div>
          </div>
        )}

        {nearbyShows.length > 0 && (
          <div class="panel--bare">
            <div class="panel-head"><span>Nearby on the tour</span><span>{nearbyShows.length}</span></div>
            <div>
              {nearbyShows.map((s) => (
                <a class="nearby-show" href={`/setlists/${s.slug}`}>
                  <time>{s.date || '–'}</time>
                  <strong>{s.venue || '–'}</strong>
                  <span>{s.country_code || ''}</span>
                </a>
              ))}
            </div>
          </div>
        )}

        {venue && (
          <div class="panel--bare">
            <div class="panel-head">
              <span>The venue</span>
              <span>DOSSIER</span>
            </div>
            <div style="padding: 14px 16px;">
              <a href={`/venues/${venue.slug}`} class="serif" style="font-size:22px; font-style:italic; color: var(--ink); border:none; display:block;">{venue.name}</a>
              <div class="mono-sm muted" style="margin-top:.3rem;">
                {[venue.city, venue.country].filter(Boolean).join(', ')}
                {venue.capacity ? ` · CAP ${venue.capacity.toLocaleString()}` : ''}
              </div>
              {venue.cure_show_count && (
                <div class="mono-sm" style="color: var(--accent-3); margin-top:.4rem;">{venue.cure_show_count} CURE SHOWS ON FILE</div>
              )}
            </div>
          </div>
        )}

        {supportActs.length > 0 && (
          <div class="panel--bare">
            <div class="panel-head"><span>Support acts</span><span>BILL</span></div>
            <ul style="list-style:none; margin:0; padding: 8px 16px 14px;">
              {supportActs.map((a) => <li class="serif" style="font-size:17px; font-style:italic; padding: 4px 0;">{a}</li>)}
            </ul>
          </div>
        )}

        {recordings.length > 0 && (
          <div class="panel--bare">
            <div class="panel-head"><span>Recordings</span><span>TAPE TRADE</span></div>
            <ul style="list-style:none; margin:0; padding: 8px 16px 14px;">
              {recordings.map((r: any) => (
                <li style="padding: 6px 0; border-bottom: 1px solid var(--rule-2);">
                  <div class="mono-sm" style="color: var(--ink);">{(r.type || r.source || 'RECORDING').toUpperCase()}</div>
                  <div class="mono-sm muted">{r.lineage || r.notes || ''}</div>
                </li>
              ))}
            </ul>
          </div>
        )}

        {(audioLinks.length + videoLinks.length + additional.length) > 0 && (
          <div class="panel--bare">
            <div class="panel-head"><span>Listen & watch</span><span>LINKS</span></div>
            <ul style="list-style:none; margin:0; padding: 8px 16px 14px;">
              {[...audioLinks.map((l: any) => ({ ...l, _kind: 'AUDIO' })),
                ...videoLinks.map((l: any) => ({ ...l, _kind: 'VIDEO' })),
                ...additional.map((l: any) => ({ ...l, _kind: 'LINK' }))].map((l: any) => (
                <li style="padding: 6px 0;">
                  <a href={l.url || l.href || l} target="_blank" rel="noopener" class="mono-sm" style="color: var(--accent-3); border:none;">
                    {l._kind} → {l.label || l.title || l.source || new URL(l.url || l.href || l).hostname}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {setlist.cure_concerts_url && (
          <div class="mono-sm muted">
            Source · <a href={setlist.cure_concerts_url} target="_blank" rel="noopener" style="color: var(--accent-3);">cureconcerts.com →</a>
          </div>
        )}
      </aside>
    </div>
  </section>
</Layout>

<style>
  .show-crumbs { padding-top: clamp(22px, 3vw, 38px); }
  .show-hero { padding-block: clamp(18px, 3vw, 32px); }
  .show-hero figure { position: relative; aspect-ratio: 21 / 9; margin: 0; overflow: hidden; border: 1px solid var(--rule); background: var(--bg-2); }
  .show-hero img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.85) contrast(1.08); }

  .show-head { display: flex; flex-direction: column; margin-top: clamp(34px, 5vw, 68px); }
  .show-head--after-image { margin-top: clamp(12px, 2vw, 26px); }
  .show-head__topline { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding-bottom: 14px; border-bottom: 1px solid var(--rule); }
  .show-head__topline > span { color: var(--muted); font-family: var(--f-mono); font-size: var(--micro); font-weight: 600; letter-spacing: .18em; text-transform: uppercase; }
  .show-head__topline :global(.bookmark) { min-height: 38px; padding-inline: 12px; }
  .show-head__title { max-width: 15ch; margin: clamp(22px, 3vw, 36px) 0 0; color: var(--ink); font-size: clamp(48px, 7vw, 96px); line-height: .88; font-style: italic; font-weight: 400; letter-spacing: -.035em; text-wrap: balance; }
  .show-head__meta { display: flex; flex-wrap: wrap; gap: 6px 20px; margin-top: clamp(18px, 2vw, 26px); color: var(--muted); font-family: var(--f-mono); font-size: 10px; letter-spacing: .13em; line-height: 1.55; text-transform: uppercase; }
  .show-head__meta span::before { content: '·'; margin-right: 20px; color: var(--accent); }
  .show-head__lede { max-width: 58ch; margin: clamp(24px, 3vw, 34px) 0 0; color: var(--ink-2); font-family: var(--f-serif); font-size: clamp(18px, 1.8vw, 22px); line-height: 1.55; text-wrap: pretty; }
  .show-head__facts { margin-top: clamp(28px, 4vw, 44px); }
  .show-head__facts .facts__v { font-family: var(--f-display); font-size: clamp(22px, 2vw, 30px); line-height: 1; }

  .show-content { padding-block: clamp(38px, 6vw, 76px); }
  .show-grid { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: clamp(24px, 3vw, 48px); align-items: start; }
  .setlist-head { border: 1px solid var(--rule); }
  .setlist-empty { min-height: 270px; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; padding: clamp(28px, 5vw, 58px); border: 1px solid var(--rule); background: linear-gradient(145deg, var(--accent-tint), transparent 58%), var(--bg-2); }
  .setlist-empty > span { color: var(--accent); font-family: var(--f-mono); font-size: var(--micro); font-weight: 700; letter-spacing: .17em; text-transform: uppercase; }
  .setlist-empty > strong { margin-top: 15px; color: var(--ink); font-family: var(--f-display); font-size: clamp(34px, 4vw, 52px); font-style: italic; font-weight: 400; line-height: .95; }
  .setlist-empty > p { max-width: 42ch; margin: 18px 0 0; color: var(--muted); font-size: 16px; line-height: 1.55; }
  .setlist-track__link, .setlist-track__name { border: 0; color: var(--ink); font-family: var(--f-display); font-size: 19px; font-style: italic; line-height: 1.2; }
  .setlist-track__link:hover { color: var(--accent); }
  .setlist-track__flags { display: flex; flex-wrap: wrap; gap: 5px 10px; margin-top: 4px; color: var(--accent-3); font-family: var(--f-mono); font-size: 8px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .setlist-track__title { min-width: 0; }
  .show-tour { padding: 16px 16px 18px; }
  .show-tour > a { display: flex; justify-content: space-between; gap: 12px; margin-bottom: 18px; border: 0; color: var(--ink); font-family: var(--f-display); font-size: 21px; font-style: italic; line-height: 1.1; }
  .show-tour > a span { color: var(--accent); font-family: var(--f-sans); font-size: 14px; font-style: normal; }
  .show-tour > a:hover { color: var(--accent); }
  .nearby-show { min-width: 0; display: grid; grid-template-columns: 88px minmax(0, 1fr) auto; gap: 10px; align-items: center; padding: 11px 16px; border: 0; border-bottom: 1px solid var(--rule-2); color: var(--ink); }
  .nearby-show time, .nearby-show > span { color: var(--muted); font-family: var(--f-mono); font-size: var(--micro); letter-spacing: .12em; text-transform: uppercase; }
  .nearby-show strong { min-width: 0; overflow: hidden; color: var(--ink); font-family: var(--f-display); font-size: 15px; font-style: italic; font-weight: 400; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }
  .nearby-show:hover strong { color: var(--accent); }

  .commentary {
    margin-top: 1.6rem;
    display: grid; grid-template-columns: 180px 1fr; gap: clamp(16px, 3vw, 32px);
    padding: 20px 24px;
    background: var(--bg-2);
    border-top: 1px solid var(--ink-2);
    border-bottom: 1px solid var(--ink-2);
  }
  @media (max-width: 640px) { .commentary { grid-template-columns: 1fr; padding: 18px 20px; } }
  .commentary__lead { display: flex; flex-direction: column; gap: .4rem; }
  .commentary__title { font-size: 22px; font-style: italic; line-height: 1.1; color: var(--ink); }
  .commentary__cite { margin-top: .2rem; }
  .commentary__body { font-family: var(--f-serif); font-size: 17px; line-height: 1.6; color: var(--ink-2); margin: 0; text-wrap: pretty; }

  @media (max-width: 900px) {
    .show-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 800px) {
    table.data.setlist-table tbody { display: grid; gap: 0; }
    table.data.setlist-table tbody tr {
      display: grid;
      grid-template-columns: 42px minmax(0, 1fr) auto;
      grid-auto-flow: row;
      padding: 0;
      border: 1px solid var(--rule);
      border-top: 0;
      background: transparent;
    }
    table.data.setlist-table tbody td,
    table.data.setlist-table tbody td:first-child,
    table.data.setlist-table tbody td.mono-sm,
    table.data.setlist-table tbody td.idx,
    table.data.setlist-table tbody td.num {
      display: block;
      min-width: 0;
      padding: 15px 12px;
      border: 0;
      text-align: left;
      white-space: normal;
    }
    table.data.setlist-table tbody td[data-label]::before { display: none; }
    table.data.setlist-table tbody td.setlist-track__position {
      grid-column: 1;
      grid-row: 1 / span 2;
      padding-right: 0;
      color: var(--accent);
    }
    table.data.setlist-table tbody td.setlist-track__title {
      grid-column: 2;
      grid-row: 1;
    }
    table.data.setlist-table tbody td.setlist-track__notes {
      grid-column: 2 / -1;
      grid-row: 2;
      padding-top: 0;
      color: var(--muted);
      font-size: 9px;
    }
    table.data.setlist-table tbody td.setlist-track__notes.is-empty { display: none; }
    table.data.setlist-table tbody td.setlist-track__length {
      grid-column: 3;
      grid-row: 1;
      padding-left: 6px;
      color: var(--muted);
      text-align: right;
      white-space: nowrap;
    }
    table.data.setlist-table tbody td.setlist-track__length.is-empty { color: transparent; }
    .setlist-track__link, .setlist-track__name { font-size: 21px; }
  }

  @media (max-width: 640px) {
    .show-crumbs { padding-top: 18px; }
    .show-hero { padding-block: 16px 8px; }
    .show-hero figure { aspect-ratio: 16 / 9; }
