---
import MainLayout from "../../layouts/MainLayout.astro";
import SetlistSongItem from "../../components/SetlistSongItem.astro";

import { createSongSlug } from '../../lib/lyrics-helpers';

interface SongDisplay {
  position: number;
  title: string;
  songSlug?: string;
  setType: string;
  notes?: string;
  isCover: boolean;
  duration?: string;
}

interface SetlistData {
  id: string;
  date: string;
  formattedDate: string;
  year: number;
  venue: string;
  city: string;
  country: string;
  stateProvince?: string;
  tourName?: string;
  slug: string;
  notes?: string;
  source?: string;
  coverImage?: string;
  songs: SongDisplay[];
  songCount: number;
}

interface Props {
  setlist: SetlistData;
  prevSetlist: SetlistData | null;
  nextSetlist: SetlistData | null;
  relatedShows: SetlistData[];
}

export async function getStaticPaths() {
  const DIRECTUS_URL = 'https://dash.cureation.net';

  function formatDate(dateString: string): string {
    return new Date(dateString).toLocaleDateString('en-US', {
      weekday: 'long', month: 'long', day: 'numeric', year: 'numeric'
    });
  }

  function generateSlug(venue: string, city: string, date: string): string {
    const dateSlug = date.split('T')[0];
    return `${venue}-${city}-${dateSlug}`
      .toLowerCase()
      .replace(/[^\w\s-]/gi, '')
      .replace(/\s+/g, '-');
  }

  try {
    // Fetch all setlists
    const setlistsResponse = await fetch(`${DIRECTUS_URL}/items/setlists?sort=-date&limit=-1&fields=id,date,venue,city,country,state_province,tour_name,slug,song_count,venue_image,notes,source`);
    const setlistsData = await setlistsResponse.json();

    if (!setlistsData.data || !Array.isArray(setlistsData.data)) {
      console.log('No setlists data found');
      return [];
    }

    // Fetch all setlist_songs from the junction table
    const songsResponse = await fetch(`${DIRECTUS_URL}/items/setlist_songs?limit=-1&fields=setlist,song,song_title,position,set_type,notes,is_cover,cover_artist&sort=position`);
    const songsData = await songsResponse.json();

    // Build a map of setlist_id -> songs
    const songsBySetlist = new Map<string, any[]>();
    if (songsData.data) {
      for (const row of songsData.data) {
        const slId = row.setlist?.toString() || '';
        if (!songsBySetlist.has(slId)) songsBySetlist.set(slId, []);
        songsBySetlist.get(slId)!.push(row);
      }
    }

    // Fetch songs collection for linking to lyrics pages
    const songsCollResponse = await fetch(`${DIRECTUS_URL}/items/songs?limit=-1&fields=id,title`);
    const songsCollData = await songsCollResponse.json();
    const knownSongSlugs = new Set<string>();
    if (songsCollData.data) {
      for (const s of songsCollData.data) {
        if (s.title) knownSongSlugs.add(createSongSlug(s.title));
      }
    }

    // Process setlists
    const allSetlists = setlistsData.data.map((setlist: any) => {
      const eventDate = setlist.date || '';
      const slug = setlist.slug || generateSlug(setlist.venue || '', setlist.city || '', eventDate);
      const slId = setlist.id.toString();

      // Get songs for this setlist from junction table
      const rawSongs = songsBySetlist.get(slId) || [];
      const songs: SongDisplay[] = rawSongs.map((row: any) => {
        const title = row.song_title || `Song #${row.position}`;
        const songSlug = createSongSlug(title);
        return {
          position: row.position || 0,
          title,
          songSlug: knownSongSlugs.has(songSlug) ? songSlug : undefined,
          setType: row.set_type || 'main',
          notes: row.notes || undefined,
          isCover: row.is_cover || false,
        };
      }).sort((a: SongDisplay, b: SongDisplay) => a.position - b.position);

      const coverImage = setlist.venue_image
        ? (setlist.venue_image.startsWith('http') ? setlist.venue_image : `${DIRECTUS_URL}/assets/${setlist.venue_image}`)
        : undefined;

      return {
        id: slId,
        date: eventDate,
        formattedDate: eventDate ? formatDate(eventDate) : 'Date TBA',
        year: eventDate ? new Date(eventDate).getFullYear() : 0,
        venue: setlist.venue || 'Unknown Venue',
        city: setlist.city || 'Unknown City',
        country: setlist.country || '',
        stateProvince: setlist.state_province,
        tourName: setlist.tour_name,
        slug,
        notes: setlist.notes,
        source: setlist.source,
        coverImage,
        songs,
        songCount: setlist.song_count || songs.length,
      };
    }).sort((a: any, b: any) =>
      new Date(b.date).getTime() - new Date(a.date).getTime()
    );

    // Generate paths with prev/next navigation
    return allSetlists.map((setlist: any, index: number) => {
      const prevSetlist = index < allSetlists.length - 1 ? allSetlists[index + 1] : null;
      const nextSetlist = index > 0 ? allSetlists[index - 1] : null;

      // Find related shows (same tour, limit 4)
      const relatedShows = allSetlists
        .filter((s: any) => s.slug !== setlist.slug && s.tourName && s.tourName === setlist.tourName)
        .slice(0, 4);

      return {
        params: { slug: setlist.slug },
        props: { setlist, prevSetlist, nextSetlist, relatedShows }
      };
    });
  } catch (error) {
    console.error('Error in getStaticPaths for setlists:', error);
    return [];
  }
}

const { setlist, prevSetlist, nextSetlist, relatedShows } = Astro.props;

interface SongSetGroup {
  type: string;
  label: string;
  badgeClass: string;
  songs: SongDisplay[];
}

function normalizeSetType(value?: string): string {
  return (value || 'main').toLowerCase().trim();
}

function formatSetLabel(setType: string): string {
  if (setType === 'main') return 'Main Set';
  if (setType === 'acoustic') return 'Acoustic Set';
  if (setType === 'encore') return 'Encore';

  const encoreMatch = setType.match(/^encore(\d+)$/);
  if (encoreMatch) return `Encore ${parseInt(encoreMatch[1], 10)}`;

  const setMatch = setType.match(/^set(\d+)$/);
  if (setMatch) return `Set ${parseInt(setMatch[1], 10)}`;

  return setType
    .replace(/[_-]+/g, ' ')
    .replace(/\b\w/g, (ch) => ch.toUpperCase());
}

function setBadgeClass(setType: string): string {
  if (setType === 'main') return 'bg-white/10 text-white/60';
  if (setType === 'acoustic') return 'bg-green-500/20 text-green-400';
  if (setType === 'encore') return 'bg-primary/20 text-primary';
  if (setType === 'encore2') return 'bg-accent/20 text-accent';
  if (setType.startsWith('encore')) return 'bg-amber-500/20 text-amber-400';
  return 'bg-blue-500/20 text-blue-300';
}

const setGroupsMap = new Map<string, SongDisplay[]>();
for (const song of setlist.songs) {
  const type = normalizeSetType(song.setType);
  if (!setGroupsMap.has(type)) {
    setGroupsMap.set(type, []);
  }
  setGroupsMap.get(type)!.push(song);
}

const setGroups: SongSetGroup[] = Array.from(setGroupsMap.entries()).map(([type, songs]) => ({
  type,
  label: formatSetLabel(type),
  badgeClass: setBadgeClass(type),
  songs
}));

const mainSet = setGroups.find((group) => group.type === 'main')?.songs || [];
const encoreSongCount = setGroups
  .filter((group) => group.type.startsWith('encore'))
  .reduce((count, group) => count + group.songs.length, 0);

const location = setlist.stateProvince
  ? `${setlist.city}, ${setlist.stateProvince}, ${setlist.country}`
  : `${setlist.city}, ${setlist.country}`;

interface SourceLink {
  href: string;
  label: string;
}

function buildSourceLinks(rawSource?: string): SourceLink[] {
  if (!rawSource) return [];

  const chunks = rawSource
    .replace(/\r\n/g, '\n')
    .split(/\n|,/)
    .map((entry) => entry.trim())
    .filter(Boolean);

  const links: SourceLink[] = [];
  const seen = new Set<string>();

  for (const chunk of chunks) {
    const match = chunk.match(/https?:\/\/\S+/i);
    const normalized = (match ? match[0] : chunk)
      .replace(/[),.;]+$/g, '');
    const href = /^https?:\/\//i.test(normalized)
      ? normalized
      : /^[\w.-]+\.[a-z]{2,}/i.test(normalized)
        ? `https://${normalized}`
        : '';

    if (!href || seen.has(href)) continue;
    seen.add(href);

    links.push({
      href,
      label: href
    });
  }

  return links;
}

const sourceLinks = buildSourceLinks(setlist.source);
---

<MainLayout
  title={`${setlist.venue} - ${setlist.formattedDate}`}
  description={`The Cure setlist from ${setlist.venue} in ${location} on ${setlist.formattedDate}. ${setlist.songCount} songs performed.`}
  ogImage={setlist.coverImage}
  showSidebar={false}
  pageClass="bg-black"
>

  <!-- Background image layer -->
  {setlist.coverImage && (
    <div class="fixed inset-0 z-[-1]">
      <div class="absolute inset-0 bg-black opacity-70"></div>
      <div
        class="absolute inset-0 bg-cover bg-center opacity-30 blur-xl"
        style={`background-image: url(${setlist.coverImage})`}
      ></div>
    </div>
  )}

  <!-- Breadcrumb -->
  <nav class="mb-8" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-white/60">
      <li><a href="/setlists" class="hover:text-primary transition-colors">Setlists</a></li>
      <li aria-hidden="true">/</li>
      {setlist.year > 0 && (
        <li><span class="text-white/40">{setlist.year}</span></li>
        <li aria-hidden="true">/</li>
      )}
      <li class="text-white truncate max-w-[200px]">{setlist.venue}</li>
    </ol>
  </nav>

  <!-- Event Header -->
  <section class="mb-12">
    <div class="glass-panel overflow-hidden relative">
      <div class="absolute -top-20 -left-20 w-64 h-64 rounded-full bg-primary/10 blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-10 -right-10 w-48 h-48 rounded-full bg-accent/[0.06] blur-2xl pointer-events-none"></div>

      <div class="relative p-8 md:p-12">
        <!-- Tour badge -->
        {setlist.tourName && (
          <div class="inline-flex items-center gap-2 mb-4">
            <span class="badge bg-primary/20 text-primary border-primary/40">{setlist.tourName}</span>
          </div>
        )}

        <h1 class="font-display text-5xl md:text-6xl lg:text-7xl text-white mb-4 text-glow">
          {setlist.venue}
        </h1>

        <div class="flex flex-wrap items-center gap-4 text-white/70 mb-6">
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>{location}</span>
          </div>
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
              <line x1="16" x2="16" y1="2" y2="6"></line>
              <line x1="8" x2="8" y1="2" y2="6"></line>
              <line x1="3" x2="21" y1="10" y2="10"></line>
            </svg>
            <time datetime={setlist.date}>{setlist.formattedDate}</time>
          </div>
        </div>

        <!-- Stats -->
        <div class="flex flex-wrap gap-8 pt-6 border-t border-white/[0.08]">
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-primary text-glow">{setlist.songs.length || setlist.songCount}</span>
            <span class="text-white/60 text-base font-medium">Songs</span>
          </div>
          {mainSet.length > 0 && (
            <div class="flex items-center gap-3">
              <span class="text-3xl font-display text-primary text-glow">{mainSet.length}</span>
              <span class="text-white/60 text-base font-medium">Main Set</span>
            </div>
          )}
          {encoreSongCount > 0 && (
            <div class="flex items-center gap-3">
              <span class="text-3xl font-display text-primary text-glow">{encoreSongCount}</span>
              <span class="text-white/60 text-base font-medium">Encore</span>
            </div>
          )}
        </div>

        {(setlist.notes || sourceLinks.length > 0) && (
          <div class="mt-6 pt-6 border-t border-white/[0.08]">
            {setlist.notes && <p class="text-white/70">{setlist.notes}</p>}
            {sourceLinks.length > 0 && (
              <div class={setlist.notes ? 'mt-4' : ''}>
                <p class="text-white/50 text-sm uppercase tracking-wider mb-2">Source</p>
                <div class="space-y-1.5">
                  {sourceLinks.map((link) => (
                    <a
                      href={link.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 text-primary hover:text-primary/80 transition-colors break-all text-sm"
                    >
                      <span>{link.label}</span>
                      <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M7 17 17 7"></path>
                        <path d="M7 7h10v10"></path>
                      </svg>
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Setlist -->
  <section class="mb-12">
    <div class="glass-card rounded-2xl p-6 md:p-8 border border-white/20">
      <h2 class="font-heading text-2xl text-primary mb-6">Setlist</h2>

      {setGroups.map((group, index) => (
        <div class={index < setGroups.length - 1 ? 'mb-8' : ''}>
          <h3 class="text-white/60 text-sm uppercase tracking-wider mb-4 flex items-center gap-2">
            <span>{group.label}</span>
            <span class={`px-2 py-0.5 text-xs rounded ${group.badgeClass}`}>{group.songs.length} songs</span>
          </h3>
          <ol class="space-y-1" aria-label={`${group.label} songs`}>
            {group.songs.map((song: SongDisplay) => (
              <SetlistSongItem
                position={song.position}
                title={song.title}
                songSlug={song.songSlug}
                setType={song.setType}
                notes={song.notes}
                isCover={song.isCover}
                duration={song.duration}
              />
            ))}
          </ol>
        </div>
      ))}

      {setlist.songs.length === 0 && (
        <p class="text-white/60 text-center py-8">
          Setlist details not available for this show.
        </p>
      )}
    </div>
  </section>

  <!-- Navigation -->
  <section class="mb-12">
    <div class="flex flex-col sm:flex-row gap-4">
      {prevSetlist && (
        <a
          href={`/setlists/${prevSetlist.slug}`}
          class="flex-1 glass-card rounded-xl p-4 border border-white/20 hover:border-primary/40 transition-colors group"
        >
          <span class="text-white/50 text-sm">Previous Show</span>
          <div class="flex items-center gap-2 mt-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m15 18-6-6 6-6"></path>
            </svg>
            <span class="text-white group-hover:text-primary transition-colors truncate">{prevSetlist.venue}</span>
          </div>
          <span class="text-white/40 text-xs">{prevSetlist.formattedDate}</span>
        </a>
      )}
      {nextSetlist && (
        <a
          href={`/setlists/${nextSetlist.slug}`}
          class="flex-1 glass-card rounded-xl p-4 border border-white/20 hover:border-primary/40 transition-colors group text-right"
        >
          <span class="text-white/50 text-sm">Next Show</span>
          <div class="flex items-center justify-end gap-2 mt-1">
            <span class="text-white group-hover:text-primary transition-colors truncate">{nextSetlist.venue}</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m9 18 6-6-6-6"></path>
            </svg>
          </div>
          <span class="text-white/40 text-xs">{nextSetlist.formattedDate}</span>
        </a>
      )}
    </div>
  </section>

  <!-- Related Shows (same tour) -->
  {relatedShows && relatedShows.length > 0 && (
    <section class="mb-12">
      <h2 class="font-heading text-2xl text-primary mb-6">
        {setlist.tourName ? `More from ${setlist.tourName}` : 'Related Shows'}
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        {relatedShows.map((show: any) => (
          <a
            href={`/setlists/${show.slug}`}
            class="glass-card rounded-xl p-4 border border-white/20 hover:border-primary/40 transition-colors group"
          >
            <h3 class="text-white group-hover:text-primary transition-colors truncate">{show.venue}</h3>
            <p class="text-white/60 text-sm">{show.city}, {show.country}</p>
            <p class="text-white/40 text-xs mt-1">{show.formattedDate}</p>
            <div class="flex items-center justify-between mt-2">
              <span class="text-white/30 text-xs">{show.songCount} songs</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Back to all setlists -->
  <div class="text-center">
    <a
      href="/setlists"
      class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-primary/20 border border-primary/40 text-white hover:bg-primary/30 transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m15 18-6-6 6-6"></path>
      </svg>
      Back to All Setlists
    </a>
  </div>
</MainLayout>
