---
import Layout from '../layouts/Layout.astro';
import IssueSection from '../components/ui/IssueSection.astro';
import PageHero from '../components/ui/PageHero.astro';
import Select from '../components/ui/Select.astro';
import SearchField from '../components/ui/SearchField.astro';
import { listVenues } from '../lib/directus';

const venues = await listVenues();
const byCountry = Array.from(new Set(venues.map((v) => v.country).filter(Boolean))).sort();
const withCoords = venues.filter((v) => v.latitude && v.longitude).length;

const countryCounts: Record<string, number> = {};
venues.forEach((v) => { if (v.country) countryCounts[v.country] = (countryCounts[v.country] || 0) + (v.cure_show_count || 1); });
const topCountries = Object.entries(countryCounts).sort((a, b) => b[1] - a[1]).slice(0, 10);
const maxCountry = Math.max(1, ...topCountries.map(([, c]) => c));

const facts: Array<[string, string]> = [
  ['Venues on file', String(venues.length)],
  ['Countries', String(byCountry.length)],
  ['With coordinates', String(withCoords)],
  ['Sorted by', 'SHOW COUNT'],
];
---
<Layout title="Venues · Cureation">
  <PageHero
    section="Venues"
    title="Venues"
    deck="Every room the band has played — ranked by repeat visits, annotated with capacity and first/last Cure appearance."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Venues' }]}
    facts={facts.map(([k, v]) => ({ k, v }))}
    flush
  />

  <section class="container" style="padding: clamp(36px, 4.5vw, 64px) 0; border-top: 1px solid var(--rule);">
    <div class="mono-sm muted" style="margin-bottom: 1rem; letter-spacing: 0.22em;">TOP 10 COUNTRIES BY SHOWS</div>
    <div class="decade-bars">
      {topCountries.map(([c, count]) => (
        <button class="decade-bar" data-country-jump={c} style={`--h: ${Math.round((count / maxCountry) * 100)}%;`}>
          <div class="decade-bar__val">{count}</div>
          <div class="decade-bar__fill"></div>
          <div class="decade-bar__label">{c}</div>
        </button>
      ))}
    </div>
  </section>

  <section class="container filter-strip">
    <div class="filter-grid filter-grid--3">
      <Select
        name="country"
        label="Country"
        options={[{ value: 'all', label: 'All countries' }, ...byCountry.map((c) => ({ value: c!, label: c! }))]}
      />
      <Select
        name="cap"
        label="Capacity"
        options={[
          { value: 'all', label: 'Any capacity' },
          { value: 'small', label: 'Under 1,000' },
          { value: 'mid', label: '1,000 – 5,000' },
          { value: 'large', label: '5,000 – 20,000' },
          { value: 'huge', label: '20,000+' },
        ]}
      />
      <SearchField placeholder="Venue, city…" />
    </div>
  </section>

  <IssueSection kicker="Ranked ledger" title="Rooms" meta="Most-visited first">
    <div class="mono-sm muted" data-match-count style="margin-bottom:.8rem;">{venues.length} venues</div>
    <div class="table-wrap">
    <table class="data data--airy" data-venue-table>
      <thead><tr><th style="width:50px;">№</th><th>Venue</th><th>City</th><th>Country</th><th class="num" style="text-align:right;">Capacity</th><th class="num" style="text-align:right;">Cure shows</th></tr></thead>
      <tbody>
        {venues.map((v, i) => {
          const cap = v.capacity || 0;
          const bucket = cap === 0 ? 'all' : cap < 1000 ? 'small' : cap < 5000 ? 'mid' : cap < 20000 ? 'large' : 'huge';
          const search = `${v.name || ''} ${v.city || ''} ${v.country || ''}`.toLowerCase();
          return (
            <tr data-clickable data-country={v.country || ''} data-cap={bucket} data-search={search} onclick={`location.href='/venues/${v.slug}'`}>
              <td class="idx">{String(i + 1).padStart(2, '0')}</td>
              <td><span class="serif" style="font-size:19px; font-style:italic; line-height:1.3;">{v.name}</span></td>
              <td class="mono-sm muted">{[v.city, v.state_province].filter(Boolean).join(', ')}</td>
              <td class="mono-sm muted">{v.country || '—'}</td>
              <td class="num">{v.capacity ? v.capacity.toLocaleString() : '—'}</td>
              <td class="num" style="color: var(--accent-3);">{v.cure_show_count || '—'}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
    </div>
  </IssueSection>
</Layout>

<script>
  function wire() {
    const state: Record<string, string> = { country: 'all', cap: 'all', search: '' };
    const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-venue-table] tbody tr'));
    const counter = document.querySelector<HTMLElement>('[data-match-count]');
    const apply = () => {
      let m = 0;
      rows.forEach((r) => {
        const c = r.getAttribute('data-country') || '';
        const cap = r.getAttribute('data-cap') || '';
        const s = r.getAttribute('data-search') || '';
        const ok = (state.country === 'all' || c === state.country) &&
                   (state.cap === 'all' || cap === state.cap) &&
                   (!state.search || s.includes(state.search));
        r.style.display = ok ? '' : 'none';
        if (ok) m++;
      });
      if (counter) counter.textContent = `${m} venues`;
    };
    document.querySelectorAll<HTMLSelectElement>('[data-filter-select]').forEach((sel) => {
      const key = sel.getAttribute('data-filter-select') || '';
      sel.addEventListener('change', () => { state[key] = sel.value || 'all'; apply(); });
    });
    const search = document.querySelector<HTMLInputElement>('[data-filter-search]');
    if (search) search.addEventListener('input', () => { state.search = search.value.trim().toLowerCase(); apply(); });
    document.querySelectorAll<HTMLElement>('[data-country-jump]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const c = btn.getAttribute('data-country-jump') || '';
        const sel = document.querySelector<HTMLSelectElement>('[data-filter-select="country"]');
        if (sel) { sel.value = c; sel.dispatchEvent(new Event('change')); }
      });
    });
  }
  wire();
  document.addEventListener('astro:page-load', wire);
</script>

