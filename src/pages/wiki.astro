---
import { editable, copyText, copyAttr, copySource } from '../lib/visual-editing';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/ui/PageHero.astro';
import { listNews } from '../lib/directus';

const entries: any[] = await listNews(-1).catch(() => []);
const articles = entries
  .filter((entry) => String(entry.category || '').toLowerCase() === 'wiki')
  .sort((a, b) => String(a.title || '').localeCompare(String(b.title || '')));
---
<Layout title="The wiki · Cureation">
  <PageHero copyKeys={{"section":"pages_wiki_91187f396593","title":"pages_wiki_b343cacad48a","deck":"pages_wiki_4723fda44314"}}
    section={copyText("pages_wiki_91187f396593", "Wiki")}
    title={copyText("pages_wiki_b343cacad48a", "Wiki")}

    crumbs={[{ ...copySource({"label":"pages_wiki_data-7809de61cbf6"}),  label: copyText("pages_wiki_data-7809de61cbf6", "Home"), href: '/' }, { ...copySource({"label":"pages_wiki_data-c2ef2a1d8ade"}),  label: copyText("pages_wiki_data-c2ef2a1d8ade", "Wiki") }]}
    facts={[{ ...copySource({"k":"pages_wiki_data-726abffced74"}),  k: copyText("pages_wiki_data-726abffced74", "Articles"), v: articles.length || '–' }, { ...copySource({"k":"pages_wiki_data-e69282c4d9b3"}),  k: copyText("pages_wiki_data-e69282c4d9b3", "Sort"), v: 'A–Z' }]}
  />

  <section class="wiki-section">
    <div class="container">
      {articles.length === 0 ? (
        <div class="wiki-empty"><p>No wiki articles yet.</p></div>
      ) : (
        <div class="wiki-grid">
          {articles.map((a, i) => (
            <a class="wiki-card" href={`/wiki/${a.slug}`}>
              <span class="wiki-card__index">{String(i + 1).padStart(2, '0')}</span>
              <div  class="wiki-card__body">
                <small data-directus={editable(a, ["tags"])}>{Array.isArray(a.tags) && a.tags.length ? a.tags.slice(0, 3).join(' · ') : 'Reference article'}</small>
                <h3 data-directus={editable(a, ["title"])}>{a.title}</h3>
                {a.excerpt && <p data-directus={editable(a, ["excerpt"])}>{a.excerpt}</p>}
              </div>
              <b data-directus={editable(a, ["reading_time"])}>{a.reading_time ? `${a.reading_time} min read` : 'Open article'} <i>↗</i></b>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  .wiki-section { padding-block: clamp(28px, 4vw, 48px); background: var(--bg-2); }
  .wiki-heading span, .wiki-card small, .wiki-card > :global(b), .wiki-empty > span { color: var(--accent); font-family: var(--f-ui); font-size: var(--text-label); font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
  .wiki-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: var(--rule); }
  .wiki-card { position: relative; min-height: 240px; display: flex; flex-direction: column; padding: clamp(24px, 3vw, 42px); border: 0; background: var(--bg); color: inherit; overflow: hidden; }
  .wiki-card::after { position: absolute; right: 0; bottom: 0; left: 0; height: 5px; content: ''; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform .22s ease; }
  .wiki-card--lead { grid-column: span 2; background: linear-gradient(135deg, var(--accent-tint-2), transparent 58%), var(--bg); }
  .wiki-card__index { color: var(--accent); font-family: var(--f-ui); font-size: var(--text-label); font-weight: 600; letter-spacing: .1em; }
  .wiki-card__body { margin-top: 24px; }
  .wiki-card h3 { max-width: 16ch; margin: 12px 0 0; color: var(--ink); font-family: var(--f-display); font-size: clamp(28px, 3vw, 38px); font-style: italic; font-weight: 400; letter-spacing: -.04em; line-height: 1.1; }
  .wiki-card p { max-width: 45ch; margin: 18px 0 0; color: var(--ink-2); font-size: var(--text-small); line-height: 1.58; }
  .wiki-card > :global(b) { display: flex; justify-content: space-between; gap: 16px; margin-top: 28px; font-weight: 600; }
  .wiki-card > :global(b) :global(i) { font-style: normal; }
  .wiki-card:hover { background: var(--accent-tint); }
  .wiki-card:hover::after { transform: scaleX(1); }
  .wiki-card:hover h3 { color: var(--accent); }
  .wiki-empty { max-width: 900px; padding: clamp(34px, 6vw, 76px); background: linear-gradient(135deg, var(--accent-tint-2), transparent 62%), var(--bg); }
  .wiki-empty h3 { max-width: 14ch; margin: 54px 0 18px; color: var(--ink); font-family: var(--f-display); font-size: clamp(42px, 6vw, 78px); font-style: italic; font-weight: 400; line-height: .92; }
  .wiki-empty p { max-width: 48ch; color: var(--ink-2); font-size: var(--text-small); line-height: 1.6; }
  @media (max-width: 900px) { .wiki-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 720px) { .wiki-heading { grid-template-columns: 1fr; } .wiki-grid { grid-template-columns: 1fr; } .wiki-card--lead { grid-column: auto; } }
</style>
