---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/ui/PageHero.astro';
import { listNews } from '../lib/directus';

const entries: any[] = await listNews(-1).catch(() => []);
const articles = entries
  .filter((entry) => String(entry.category || '').toLowerCase() === 'wiki')
  .sort((a, b) => String(a.title || '').localeCompare(String(b.title || '')));
---
<Layout title="The wiki · Cureation">
  <PageHero
    section="Wiki"
    title="The wiki"
    deck="Long-form reference articles, deeper than a liner note and shorter than a biography, cross-referenced to everything else in the archive."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'The wiki' }]}
    facts={[{ k: 'Articles', v: articles.length || '–' }, { k: 'Sort', v: 'A–Z' }]}
  />

  <section class="wiki-section">
    <div class="container">
      <header class="wiki-heading">
        <div><span>{articles.length > 0 ? `${articles.length} articles` : 'In progress'}</span><h2>A living reference,<br /><em>not a filing cabinet.</em></h2></div>
        <p>Stories, people, places and ideas are connected back to the records, songs and shows they belong to.</p>
      </header>
      {articles.length === 0 ? (
        <div class="wiki-empty"><span>01</span><h3>The first entries are being written.</h3><p>Long-form reference articles will land here as they are researched, checked and connected to the wider archive.</p></div>
      ) : (
        <div class="wiki-grid">
          {articles.map((a, i) => (
            <a class={`wiki-card${i === 0 ? ' wiki-card--lead' : ''}`} href={`/wiki/${a.slug}`}>
              <span class="wiki-card__index">{String(i + 1).padStart(2, '0')}</span>
              <div class="wiki-card__body">
                <small>{Array.isArray(a.tags) && a.tags.length ? a.tags.slice(0, 3).join(' · ') : 'Reference article'}</small>
                <h3>{a.title}</h3>
                {a.excerpt && <p>{a.excerpt}</p>}
              </div>
              <b>{a.reading_time ? `${a.reading_time} min read` : 'Open article'} <i>↗</i></b>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  .wiki-section { padding-block: clamp(82px, 10vw, 148px); background: var(--bg-2); }
  .wiki-heading { display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, .46fr); gap: clamp(32px, 7vw, 100px); align-items: end; margin-bottom: clamp(44px, 7vw, 88px); }
  .wiki-heading span, .wiki-card small, .wiki-card > b, .wiki-empty > span { color: var(--accent); font-family: var(--f-sans); font-size: 9px; font-weight: 800; letter-spacing: .17em; text-transform: uppercase; }
  .wiki-heading h2 { max-width: 11ch; margin: 10px 0 0; color: var(--ink); font-family: var(--f-display); font-size: clamp(54px, 7.5vw, 102px); font-weight: 400; letter-spacing: -.06em; line-height: .8; }
  .wiki-heading h2 em { color: var(--accent); font-weight: inherit; }
  .wiki-heading > p { max-width: 38ch; margin: 0; color: var(--ink-2); font-size: 18px; line-height: 1.6; }
  .wiki-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: var(--rule); }
  .wiki-card { position: relative; min-height: 380px; display: flex; flex-direction: column; padding: clamp(24px, 3vw, 42px); border: 0; background: var(--bg); color: inherit; overflow: hidden; }
  .wiki-card::after { position: absolute; right: 0; bottom: 0; left: 0; height: 5px; content: ''; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform .22s ease; }
  .wiki-card--lead { grid-column: span 2; background: linear-gradient(135deg, var(--accent-tint-2), transparent 58%), var(--bg); }
  .wiki-card__index { color: var(--accent); font-family: var(--f-sans); font-size: 10px; font-weight: 800; letter-spacing: .15em; }
  .wiki-card__body { margin-top: auto; }
  .wiki-card h3 { max-width: 16ch; margin: 12px 0 0; color: var(--ink); font-family: var(--f-display); font-size: clamp(34px, 4vw, 58px); font-style: italic; font-weight: 400; letter-spacing: -.04em; line-height: .9; }
  .wiki-card p { max-width: 45ch; margin: 18px 0 0; color: var(--ink-2); font-size: 15px; line-height: 1.58; }
  .wiki-card > b { display: flex; justify-content: space-between; gap: 16px; margin-top: 28px; font-weight: 800; }
  .wiki-card > b i { font-style: normal; }
  .wiki-card:hover { background: var(--accent-tint); }
  .wiki-card:hover::after { transform: scaleX(1); }
  .wiki-card:hover h3 { color: var(--accent); }
  .wiki-empty { max-width: 900px; padding: clamp(34px, 6vw, 76px); background: linear-gradient(135deg, var(--accent-tint-2), transparent 62%), var(--bg); }
  .wiki-empty h3 { max-width: 14ch; margin: 54px 0 18px; color: var(--ink); font-family: var(--f-display); font-size: clamp(42px, 6vw, 78px); font-style: italic; font-weight: 400; line-height: .92; }
  .wiki-empty p { max-width: 48ch; color: var(--ink-2); font-size: 17px; line-height: 1.6; }
  @media (max-width: 900px) { .wiki-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 720px) { .wiki-heading { grid-template-columns: 1fr; } .wiki-grid { grid-template-columns: 1fr; } .wiki-card--lead { grid-column: auto; } }
</style>
