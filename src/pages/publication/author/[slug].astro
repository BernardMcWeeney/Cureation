---
import { editable, copyText, copyAttr, copySource } from '../../../lib/visual-editing';
import Layout from '../../../layouts/Layout.astro';
import IssueSection from '../../../components/ui/IssueSection.astro';
import Crumbs from '../../../components/ui/Crumbs.astro';
import { fetchRaw } from '../../../lib/directus';

export const prerender = false;

const { slug } = Astro.params;
const decoded = decodeURIComponent(slug || '');

const all: any[] = await fetchRaw('news', {
  limit: -1,
  fields: 'id,title,slug,excerpt,category,published_date,reading_time,author_name',
  sort: '-published_date',
}).catch(() => []);

const slugify = (s: string) => s.toLowerCase().replace(/[^\w]+/g, '-').replace(/^-+|-+$/g, '');
const byThisAuthor = all.filter((n) => (n.author_slug || slugify(n.author_name || '')) === decoded);
if (byThisAuthor.length === 0) return Astro.redirect('/publication');

const first = byThisAuthor[0];
const authorName = first.author_name || decoded;
const categories = Array.from(new Set(byThisAuthor.map((n) => n.category).filter(Boolean))).sort();
---
<Layout title={`${authorName} · Articles · Cureation`} description={`Read ${byThisAuthor.length} articles by ${authorName} about The Cure.`}>
  <div class="container" style="padding-top: clamp(24px, 3vw, 40px);">
    <Crumbs items={[{ ...copySource({"label":"pages_publication_author__slug__data-4cd3b57992c6"}),  label: copyText("pages_publication_author__slug__data-4cd3b57992c6", "Home"), href: '/' }, { ...copySource({"label":"pages_publication_author__slug__data-02994f678412"}),  label: copyText("pages_publication_author__slug__data-02994f678412", "Articles"), href: '/publication' }, { label: authorName }]} />

    <section style="padding: clamp(20px, 3vw, 40px) 0;">
      <div class="mono-sm muted">AUTHOR · BY-LINE</div>
      <h1 class="serif" style="font-size: clamp(44px, 7vw, 96px); line-height:.95; font-style: italic; margin: .4rem 0;">{authorName}</h1>
      <p class="deck" style="max-width: 62ch;">{byThisAuthor.length} {byThisAuthor.length === 1 ? 'entry' : 'entries'} filed under this byline, most recent first.</p>
      <div class="facts" style="margin-top: 1rem;">
        <div class="facts__item"><div class="facts__k">Pieces</div><div class="facts__v">{byThisAuthor.length}</div></div>
        <div class="facts__item"><div class="facts__k">Categories</div><div class="facts__v">{categories.length}</div></div>
        <div class="facts__item"><div class="facts__k">First entry</div><div data-directus={editable(byThisAuthor[byThisAuthor.length - 1], ["published_date"])} class="facts__v">{(byThisAuthor[byThisAuthor.length - 1]?.published_date || '').slice(0, 10) || '–'}</div></div>
        <div class="facts__item"><div class="facts__k">Most recent</div><div data-directus={editable(byThisAuthor[0], ["published_date"])} class="facts__v">{(byThisAuthor[0]?.published_date || '').slice(0, 10) || '–'}</div></div>
      </div>
    </section>
  </div>

  <IssueSection kicker="Author" title="Articles" meta={`${byThisAuthor.length} on file`}>
    <table class="data data--airy">
      <thead><tr><th data-directus={copyAttr("pages_publication_author_slug_4434fbdb9f41")} set:html={copyText("pages_publication_author_slug_4434fbdb9f41", "Date")} style="width:110px;"></th><th data-directus={copyAttr("pages_publication_author_slug_c9ba8eb6d6bd")} set:html={copyText("pages_publication_author_slug_c9ba8eb6d6bd", "Category")} style="width:140px;"></th><th data-directus={copyAttr("pages_publication_author_slug_3483e9f55f7c")} set:html={copyText("pages_publication_author_slug_3483e9f55f7c", "Title")}></th><th data-directus={copyAttr("pages_publication_author_slug_30975b8eb715")} set:html={copyText("pages_publication_author_slug_30975b8eb715", "Read")} class="num" style="text-align:right; width:80px;"></th></tr></thead>
      <tbody>
        {byThisAuthor.map((n) => (
          <tr data-clickable data-row-href={`/${String(n.category).toLowerCase() === 'wiki' ? 'wiki' : 'publication'}/${n.slug}`}>
            <td data-directus={editable(n, ["published_date","date_created"])} class="mono-sm" style="color: var(--ink);">{(n.published_date || n.date_created || '').slice(0, 10)}</td>
            <td data-directus={editable(n, ["category"])} class="mono-sm" style="color: var(--accent-3);">{(n.category || '–').toUpperCase()}</td>
            <td >
              <span data-directus={editable(n, ["title"])} class="serif" style="font-size:19px; font-style:italic; line-height:1.3;"><a href={`/${String(n.category).toLowerCase() === 'wiki' ? 'wiki' : 'publication'}/${n.slug}`}>{n.title}</a></span>
              {n.excerpt && <div data-directus={editable(n, ["excerpt"])} class="muted" style="font-family:var(--f-serif); font-size:var(--text-small); margin-top:.2rem;">{n.excerpt}</div>}
            </td>
            <td data-directus={editable(n, ["reading_time"])} class="num">{n.reading_time ? `${n.reading_time}m` : '–'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </IssueSection>
</Layout>
