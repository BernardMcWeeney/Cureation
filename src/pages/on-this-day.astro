---
import Layout from '../layouts/Layout.astro';
import IssueSection from '../components/ui/IssueSection.astro';
import Crumbs from '../components/ui/Crumbs.astro';
import { getOnThisDay } from '../lib/directus';

const today = new Date();
const entries = await getOnThisDay(today);
const todayLabel = today.toLocaleDateString(undefined, { month: 'long', day: 'numeric' });

const byDecade = entries.reduce((acc: Record<string, any[]>, e: any) => {
  const dec = e.year ? `${Math.floor(e.year / 10) * 10}s` : 'Undated';
  (acc[dec] = acc[dec] || []).push(e);
  return acc;
}, {});
const decades = Object.keys(byDecade).sort().reverse();

const facts: Array<[string, string]> = [
  ['Date', todayLabel],
  ['Entries', String(entries.length)],
  ['Decades touched', String(decades.filter((d) => d !== 'Undated').length)],
  ['Rolling archive', 'Live'],
];
---
<Layout title="On this day · Cureation">
  <div class="container" style="padding-top: clamp(24px, 3vw, 40px);">
    <Crumbs items={[{ label: 'Home', href: '/' }, { label: 'On this day' }]} />
    <div class="stack" style="--gap: 1rem; margin-top: 1rem;">
      <div class="mono-sm muted">SECTION · ANNIVERSARIES</div>
      <h1 class="serif" style="font-size: clamp(48px, 7.5vw, 96px); line-height:.95; font-style: italic; margin: 0;">On {todayLabel}</h1>
      <p class="deck" style="max-width: 62ch;">Every release, concert, and documented milestone that happened on this day — aggregated across every year of the band's history.</p>
      <div class="facts">
        {facts.map(([k, v]) => (
          <div class="facts__item">
            <div class="facts__k">{k}</div>
            <div class="facts__v">{v}</div>
          </div>
        ))}
      </div>
    </div>
  </div>

  {entries.length === 0 ? (
    <IssueSection kicker="Quiet day" title="Nothing on file">
      <p class="deck">No documented events for this date yet — check back tomorrow, or browse the full timeline.</p>
    </IssueSection>
  ) : decades.map((dec) => (
    <IssueSection kicker={dec} title={`${dec} · ${byDecade[dec].length} entries`}>
      <div class="table-wrap">
      <table class="data">
        <thead><tr><th style="width:80px;">Year</th><th style="width:140px;">Kind</th><th>Entry</th><th></th></tr></thead>
        <tbody>
          {byDecade[dec].sort((a: any, b: any) => (b.year || 0) - (a.year || 0)).map((e: any) => (
            <tr data-clickable={e.link_slug ? '' : undefined} onclick={e.link_slug && e.link_collection ? `location.href='/${e.link_collection}/${e.link_slug}'` : undefined}>
              <td class="num" style="text-align:left; color: var(--accent-3); font-size: 14px;">{e.year || '—'}</td>
              <td class="mono-sm muted">{(e.kind || '').toUpperCase()}</td>
              <td>
                <span class="serif" style="font-size: 18px; font-style: italic;">{e.title}</span>
                {e.subtitle && <div class="muted" style="font-family: var(--f-serif); font-style: italic; font-size: 14px;">{e.subtitle}</div>}
              </td>
              <td class="num">{e.link_slug ? <span style="color: var(--accent-3);">→</span> : ''}</td>
            </tr>
          ))}
        </tbody>
      </table>
      </div>
    </IssueSection>
  ))}
</Layout>