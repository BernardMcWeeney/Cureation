---
import MainLayout from '../layouts/MainLayout.astro';
import {
  getSetlistsWithSongs,
  getTimelineEvents,
  formatDate,
} from '../lib/directus';

const today = new Date();
const currentMonth = today.getMonth() + 1;
const currentDay = today.getDate();

// Fetch data
const [setlists, timelineEvents] = await Promise.all([
  getSetlistsWithSongs(),
  getTimelineEvents(),
]);

// Find setlists on this day in history
const onThisDaySetlists = setlists.filter(s => {
  if (!s.date) return false;
  const d = new Date(s.date);
  return d.getMonth() + 1 === currentMonth && d.getDate() === currentDay;
}).sort((a, b) => b.year - a.year);

// Find timeline events near this day (same month/day or within a week)
const onThisDayEvents = timelineEvents.filter(e => {
  if (!e.date) return false;
  const d = new Date(e.date);
  return d.getMonth() + 1 === currentMonth && d.getDate() === currentDay;
});

// Also find events in this month
const thisMonthEvents = timelineEvents.filter(e => {
  if (!e.date) return false;
  const d = new Date(e.date);
  return d.getMonth() + 1 === currentMonth;
}).sort((a, b) => {
  const dayA = new Date(a.date).getDate();
  const dayB = new Date(b.date).getDate();
  return dayA - dayB;
});

// Also find setlists this month (for the "this month in history" section)
const thisMonthSetlists = setlists.filter(s => {
  if (!s.date) return false;
  const d = new Date(s.date);
  return d.getMonth() + 1 === currentMonth;
}).sort((a, b) => {
  const dayA = new Date(a.date).getDate();
  const dayB = new Date(b.date).getDate();
  return dayA - dayB;
});

const monthName = today.toLocaleDateString('en-US', { month: 'long' });
const dateString = today.toLocaleDateString('en-US', { month: 'long', day: 'numeric' });
---

<MainLayout
  title={`On This Day - ${dateString}`}
  description={`What happened in The Cure's history on ${dateString}? Shows, events, and milestones.`}
>
  <!-- Hero -->
  <section class="mb-12">
    <div class="glass-panel overflow-hidden relative">
      <div class="absolute -top-20 -left-20 w-64 h-64 rounded-full bg-white/[0.06] blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-10 -right-10 w-48 h-48 rounded-full bg-accent/[0.06] blur-2xl pointer-events-none"></div>

      <div class="relative p-8 md:p-12">
        <h1 class="font-display text-5xl md:text-6xl lg:text-7xl text-white mb-4 text-glow">
          On This Day
        </h1>
        <p class="text-white/75 text-lg md:text-xl max-w-3xl leading-relaxed">
          {dateString} — What happened in The Cure's history on this date?
        </p>

        <div class="flex flex-wrap gap-8 mt-8 pt-6 border-t border-white/[0.08]">
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-white text-glow">{onThisDaySetlists.length}</span>
            <span class="text-white/85 text-base font-medium">Shows on This Day</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-white text-glow">{onThisDayEvents.length}</span>
            <span class="text-white/85 text-base font-medium">Events on This Day</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-white text-glow">{thisMonthSetlists.length}</span>
            <span class="text-white/85 text-base font-medium">Shows in {monthName}</span>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- Shows on This Day -->
  {onThisDaySetlists.length > 0 && (
    <section class="mb-12">
      <div class="glass-panel p-6 md:p-8">
        <h2 class="text-2xl text-white mb-6 gothic-heading">
          Shows on {dateString}
        </h2>
        <div class="space-y-4">
          {onThisDaySetlists.map(setlist => (
            <a href={`/setlists/${setlist.slug}`} class="block p-4 rounded-lg bg-white/[0.03] hover:bg-white/[0.06] transition-colors cure-rose-border">
              <div class="flex items-center justify-between mb-2">
                <h3 class="text-white font-medium">{setlist.venue}</h3>
                <span class="text-primary font-bold">{setlist.year}</span>
              </div>
              <p class="text-white/85 text-sm">{setlist.location}</p>
              {setlist.tourName && (
                <p class="text-white/80 text-xs mt-1">{setlist.tourName} · {setlist.songCount} songs</p>
              )}
              {setlist.songs.length > 0 && (
                <div class="mt-3 pt-3 border-t border-white/5">
                  <p class="text-white/75 text-xs mb-1">Setlist preview:</p>
                  <p class="text-white/80 text-sm">
                    {setlist.songs.slice(0, 5).map(s => s.title).join(' · ')}
                    {setlist.songs.length > 5 ? ` · +${setlist.songs.length - 5} more` : ''}
                  </p>
                </div>
              )}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Events on This Day -->
  {onThisDayEvents.length > 0 && (
    <section class="mb-12">
      <div class="glass-panel p-6 md:p-8">
        <h2 class="text-2xl text-white mb-6 gothic-heading">Events on {dateString}</h2>
        <div class="space-y-4">
          {onThisDayEvents.map(event => (
            <div class="p-4 rounded-lg bg-white/[0.03] cure-rose-border">
              <div class="flex items-center justify-between mb-2">
                <h3 class="text-white font-medium">{event.title}</h3>
                <span class="text-primary font-bold">{event.year}</span>
              </div>
              {event.description && (
                <p class="text-white/85 text-sm">{event.description}</p>
              )}
              <span class={`inline-block mt-2 text-xs px-2 py-0.5 rounded-full ${
                event.type === 'release' ? 'bg-green-500/15 text-green-400' :
                event.type === 'tour' ? 'bg-blue-500/15 text-blue-400' :
                event.type === 'award' ? 'bg-yellow-500/15 text-yellow-400' :
                event.type === 'member_change' ? 'bg-purple-500/15 text-purple-400' :
                'bg-white/10 text-white/80'
              }`}>{event.type.replace('_', ' ')}</span>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Nothing happened message -->
  {onThisDaySetlists.length === 0 && onThisDayEvents.length === 0 && (
    <section class="mb-12">
      <div class="glass-panel p-8 text-center">
        <p class="text-white/80 text-lg mb-2">No recorded events on {dateString}</p>
        <p class="text-white/75 text-sm">Check back tomorrow or explore this month's history below</p>
      </div>
    </section>
  )}


  <!-- This Month in History -->
  {thisMonthEvents.length > 0 && (
    <section class="mb-12">
      <div class="glass-panel p-6 md:p-8">
        <h2 class="text-2xl text-white mb-6 gothic-heading">{monthName} in Cure History</h2>
        <div class="relative">
          <div class="absolute left-4 top-0 bottom-0 w-px bg-white/10"></div>
          <div class="space-y-4">
            {thisMonthEvents.slice(0, 15).map(event => (
              <div class="flex gap-6 items-start relative pl-10">
                <div class="absolute left-0 w-8 h-8 rounded-full bg-white/10 border border-white/15 flex items-center justify-center z-10">
                  <span class="text-primary font-bold text-xs">{new Date(event.date).getDate()}</span>
                </div>
                <div class="glass-stat p-3 flex-1">
                  <div class="flex items-center justify-between">
                    <h3 class="text-white text-sm font-medium">{event.title}</h3>
                    <span class="text-white/80 text-xs">{event.year}</span>
                  </div>
                  {event.description && (
                    <p class="text-white/80 text-xs mt-1">{event.description}</p>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- This Month's Shows -->
  {thisMonthSetlists.length > 0 && (
    <section class="mb-12">
      <div class="glass-panel p-6 md:p-8">
        <h2 class="text-2xl text-white mb-6 gothic-heading">Shows in {monthName} (All Years)</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          {thisMonthSetlists.slice(0, 20).map(setlist => (
            <a href={`/setlists/${setlist.slug}`} class="flex items-center justify-between p-3 rounded-lg bg-white/[0.03] hover:bg-white/[0.06] transition-colors">
              <div class="min-w-0">
                <p class="text-white truncate text-sm">{setlist.venue}</p>
                <p class="text-white/80 text-xs">{setlist.location}</p>
              </div>
              <div class="text-right shrink-0 ml-3">
                <p class="text-primary text-sm font-bold">{setlist.formattedDate}</p>
              </div>
            </a>
          ))}
        </div>
        {thisMonthSetlists.length > 20 && (
          <p class="text-white/75 text-sm text-center mt-4">
            +{thisMonthSetlists.length - 20} more shows in {monthName}
          </p>
        )}
      </div>
    </section>
  )}

  <div class="text-center">
    <a href="/" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-white/10 border border-primary/40 text-white hover:bg-primary/30 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
      Back to Home
    </a>
  </div>
</MainLayout>
