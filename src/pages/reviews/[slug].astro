---
import { editable, copyText, copyAttr, copySource } from '../../lib/visual-editing';
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import EditorialArticle from '../../components/editorial/EditorialArticle.astro';
import Tag from '../../components/ui/Tag.astro';
import { getReviewBySlug, listReviews } from '../../lib/directus';
import { jsonLd } from '../../lib/seo';
import { asset } from '../../lib/assets';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/reviews');

const review = await getReviewBySlug(slug);
if (!review) return new Response('Not found', { status: 404 });

const reviews = await listReviews();
const currentIndex = reviews.findIndex((item) => item.id === review.id);
const related = [reviews[currentIndex - 1], reviews[currentIndex + 1]].filter(Boolean);
const reviewUrl = new URL(`/reviews/${review.slug}`, Astro.site ?? Astro.url).toString();
const reviewSchema = {
  '@context': 'https://schema.org',
  '@type': 'Review',
  name: review.title,
  url: reviewUrl,
  datePublished: review.published_date,
  author: { '@type': 'Person', name: review.author_name },
  reviewBody: (review.body || '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim(),
  reviewRating: review.score == null ? undefined : {
    '@type': 'Rating',
    ratingValue: review.score,
    bestRating: 10,
    worstRating: 0,
  },
  itemReviewed: {
    '@type': 'MusicAlbum',
    name: review.album.title,
    datePublished: review.album.release_date,
    image: asset(review.album.cover_art, 'og'),
    byArtist: { '@type': 'MusicGroup', name: 'The Cure' },
  },
};
---

<Layout editRecord={review}
  title={review.seo_title || `${review.title} · Reviews · Cureation`}
  description={review.seo_description || review.standfirst || undefined}
  ogImage={asset(review.album.cover_art, 'og')}
  ogType="article"
>
  <script type="application/ld+json" set:html={jsonLd(reviewSchema)}></script>
  <EditorialArticle record={review}
    kind="review"
    section="Reviews"
    sectionHref="/reviews"
    eyebrow="Album review"
    title={review.title}
    standfirst={review.standfirst}
    publishedDate={review.published_date}
    readingTime={review.reading_time}
    author={review.author_name}
    tags={[]}
    image={asset(review.album.cover_art, 'hero')}
    imageAlt={`${review.album.title} album cover`}
    score={review.score}
    bookmark={{ kind: 'review', id: review.id, href: `/reviews/${review.slug}` }}
    crumbs={[
      { ...copySource({"label":"pages_reviews__slug__data-062cf14dd1bd"}),  label: copyText("pages_reviews__slug__data-062cf14dd1bd", "Home"), href: '/' },
      { ...copySource({"label":"pages_reviews__slug__data-241be271307b"}),  label: copyText("pages_reviews__slug__data-241be271307b", "Reviews"), href: '/reviews' },
      { label: review.album.title },
    ]}
  >
    {review.body && <div data-directus={editable(review, ["body"])} set:html={review.body} />}

    {review.verdict && (
      <aside class="review-verdict">
        <span data-directus={copyAttr("pages_reviews_slug_78558351666e")} set:html={copyText("pages_reviews_slug_78558351666e", "Verdict")}></span>
        <p data-directus={editable(review, ["verdict"])}>{review.verdict}</p>
      </aside>
    )}

    <div  slot="rail">
      <section class="editorial-rail-card">
        <span data-directus={copyAttr("pages_reviews_slug_8ec74f9e247d")} set:html={copyText("pages_reviews_slug_8ec74f9e247d", "The record")} class="editorial-rail-label"></span>
        <ul class="editorial-rail-list">
          <li><span data-directus={copyAttr("pages_reviews_slug_10cd61808473")} set:html={copyText("pages_reviews_slug_10cd61808473", "Album")}></span><strong data-directus={editable(review.album, ["title"]) ?? editable(review, ["album"])}>{review.album.title}</strong></li>
          <li><span data-directus={copyAttr("pages_reviews_slug_13175c44cc3c")} set:html={copyText("pages_reviews_slug_13175c44cc3c", "Released")}></span><strong data-directus={editable(review.album, ["release_date"]) ?? editable(review, ["album"])}>{review.album.release_date || '–'}</strong></li>
          <li><span data-directus={copyAttr("pages_reviews_slug_743303d8d790")} set:html={copyText("pages_reviews_slug_743303d8d790", "Label")}></span><strong data-directus={editable(review.album, ["label"]) ?? editable(review, ["album"])}>{review.album.label || '–'}</strong></li>
          <li><span data-directus={copyAttr("pages_reviews_slug_617f58a87101")} set:html={copyText("pages_reviews_slug_617f58a87101", "Producer")}></span><strong data-directus={editable(review.album, ["producer"]) ?? editable(review, ["album"])}>{review.album.producer || '–'}</strong></li>
          <li><span data-directus={copyAttr("pages_reviews_slug_7483756985da")} set:html={copyText("pages_reviews_slug_7483756985da", "Tracks")}></span><strong data-directus={editable(review.album, ["track_count"]) ?? editable(review, ["album"])}>{review.album.track_count || '–'}</strong></li>
        </ul>
        <a class="editorial-rail-link" href={`/discography/${review.album.slug}`}>Open album archive <span>→</span></a>
      </section>

      {review.standout_tracks && review.standout_tracks.length > 0 && (
        <section class="editorial-rail-card">
          <span data-directus={copyAttr("pages_reviews_slug_709b5fed0d30")} set:html={copyText("pages_reviews_slug_709b5fed0d30", "Standout tracks")} class="editorial-rail-label"></span>
          <div data-directus={editable(review, ["standout_tracks"])} class="review-track-list">
            {review.standout_tracks.map((track, index) => (
              <div><span>{String(index + 1).padStart(2, '0')}</span><strong>{track}</strong></div>
            ))}
          </div>
        </section>
      )}
    </div>

    {related.length > 0 && (
      <div slot="footer">
        <div class="review-more__head">
          <div><span data-directus={copyAttr("pages_reviews_slug_d7d10c965c7a")} set:html={copyText("pages_reviews_slug_d7d10c965c7a", "Keep listening")} class="review-more__kicker"></span><h2 data-directus={copyAttr("pages_reviews_slug_fb64717b0f1a")} set:html={copyText("pages_reviews_slug_fb64717b0f1a", "More album reviews")}></h2></div>
          <Tag variant="accent">Complete archive</Tag>
        </div>
        <div class="review-more__grid">
          {related.map((item) => (
            <a class="review-more__card" href={`/reviews/${item.slug}`}>
              <img data-directus={editable(item.album, ["cover_art"]) ?? editable(item, ["album"])} src={asset(item.album.cover_art, 'thumb')} alt="" width="150" height="150" loading="lazy" decoding="async" />
              <span><small data-directus={editable(item.album, ["release_date"]) ?? editable(item, ["album","score"])}>{item.album.release_date?.slice(0, 4)} · {item.score}/10</small><strong data-directus={editable(item, ["title"])}>{item.title}</strong><b data-directus={copyAttr("pages_reviews_slug_87120b379835")} set:html={copyText("pages_reviews_slug_87120b379835", "Read review →")}></b></span>
            </a>
          ))}
        </div>
      </div>
    )}
  </EditorialArticle>
</Layout>

<style is:global>
  .review-verdict { position: relative; margin: 2.8em 0 0; padding: 28px clamp(24px, 4vw, 42px); border: 1px solid var(--rule-strong); background: color-mix(in srgb, var(--bg-2) 90%, var(--accent) 10%); overflow: hidden; }
  .review-verdict > span { color: var(--ink-2); font-family: var(--f-ui); font-size: var(--text-label); font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
  .review-verdict p { max-width: 46ch; margin: 12px 0 0; font-family: var(--f-display); font-size: clamp(24px, 3vw, 36px); font-style: italic; line-height: 1.22; }
  .review-verdict > strong { position: absolute; right: 24px; bottom: 22px; color: var(--accent-3); font-family: var(--f-display); font-size: 48px; font-style: italic; font-weight: 400; line-height: 1; }
  .review-verdict > strong small { color: var(--ink-2); font-family: var(--f-ui); font-size: var(--text-label); font-style: normal; letter-spacing: .08em; }
  .review-track-list { display: grid; }
  .review-track-list div { display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: 10px; padding: 10px 0; border-top: 1px solid var(--rule-2); }
  .review-track-list div:first-child { border-top: 0; padding-top: 0; }
  .review-track-list span { color: var(--accent-3); font-family: var(--f-ui); font-size: var(--text-label); }
  .review-track-list strong { font-family: var(--f-serif); font-size: var(--text-small); font-weight: 400; line-height: 1.35; }
  .review-more__head { display: flex; align-items: end; justify-content: space-between; gap: 24px; }
  .review-more__kicker { color: var(--accent-3); font-family: var(--f-ui); font-size: var(--text-label); letter-spacing: .1em; text-transform: uppercase; }
  .review-more__head h2 { margin: 8px 0 0; font-family: var(--f-display); font-size: clamp(32px, 4vw, 54px); font-style: italic; font-weight: 400; line-height: 1; }
  .review-more__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; margin-top: 28px; }
  .review-more__card { display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 20px; padding: 16px; border: 1px solid var(--rule); background: var(--bg-2); }
  .review-more__card:hover { border-color: var(--accent); }
  .review-more__card img { width: 112px; aspect-ratio: 1; object-fit: cover; }
  .review-more__card > span { display: flex; min-width: 0; flex-direction: column; align-items: flex-start; }
  .review-more__card small, .review-more__card b { color: var(--muted); font-family: var(--f-ui); font-size: var(--text-label); font-weight: 500; letter-spacing: .12em; text-transform: uppercase; }
  .review-more__card strong { margin-top: 8px; font-family: var(--f-display); font-size: 23px; font-style: italic; font-weight: 400; line-height: 1.05; }
  .review-more__card b { margin-top: auto; padding-top: 10px; color: var(--accent-3); }
  @media (max-width: 720px) {
    .review-more__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 460px) {
    .review-verdict p { margin-right: 0; }
    .review-verdict > strong { position: static; display: block; margin-top: 18px; }
    .review-more__card { grid-template-columns: 84px minmax(0, 1fr); gap: 15px; padding: 12px; }
    .review-more__card img { width: 84px; }
    .review-more__card strong { font-size: 20px; }
  }
</style>
