---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Tag from '../../components/ui/Tag.astro';
import { listReviews } from '../../lib/directus';
import { asset } from '../../lib/assets';

const reviews = await listReviews();
const lead = reviews.find((review) => review.featured) || reviews[0] || null;
const archive = lead ? reviews.filter((review) => review.id !== lead.id) : reviews;

const year = (date?: string | null) => date?.slice(0, 4) || '–';
const score = (value?: number | null) => value == null ? '–' : Number(value).toFixed(Number(value) % 1 ? 1 : 0);
---

<Layout
  title="Album Reviews · Cureation"
  description="Long-form reviews of every Cure studio album, from Three Imaginary Boys to Songs of a Lost World."
  ogImage={lead?.album.cover_art ? asset(lead.album.cover_art, 'og') : undefined}
>
  <PageHero
    section="Reviews"
    title="Reviews"
    deck="Fourteen studio albums. Fourteen close listens. Long-form criticism written for fans who know the songs and still want to hear them differently."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Reviews' }]}
    flush
  />

  {lead && (
    <section class="container review-lead" aria-labelledby="latest-review">
      <a class="review-lead__art" href={`/reviews/${lead.slug}`} aria-label={`Read ${lead.title}`}>
        <img src={asset(lead.album.cover_art, 'hero')} alt={`${lead.album.title} cover`} width="900" height="900" />
        <span class="review-lead__score"><strong>{score(lead.score)}</strong><small>/ 10</small></span>
      </a>
      <div class="review-lead__copy">
        <div class="review-kicker">Featured review · {year(lead.album.release_date)}</div>
        <h2 id="latest-review"><a href={`/reviews/${lead.slug}`}>{lead.title}</a></h2>
        {lead.standfirst && <p>{lead.standfirst}</p>}
        <div class="review-meta">
          <span>By {lead.author_name}</span>
          {lead.reading_time && <span>{lead.reading_time} min read</span>}
        </div>
        <a class="review-read" href={`/reviews/${lead.slug}`}>Read the full review <span aria-hidden="true">→</span></a>
      </div>
    </section>
  )}

  <section class="container review-archive" aria-labelledby="review-archive-title">
    <header class="review-archive__head">
      <div>
        <span class="review-kicker">Complete studio archive</span>
        <h2 id="review-archive-title">Every album reviewed</h2>
      </div>
      <Tag variant="accent">{reviews.length} reviews</Tag>
    </header>

    {archive.length > 0 ? (
      <div class="review-grid">
        {archive.map((review, index) => (
          <article class="review-card">
            <a class="review-card__art" href={`/reviews/${review.slug}`} aria-label={`Read ${review.title}`}>
              <img src={asset(review.album.cover_art, 'card')} alt={`${review.album.title} cover`} width="520" height="520" loading={index < 3 ? 'eager' : 'lazy'} decoding="async" />
              <span class="review-card__score">{score(review.score)}</span>
            </a>
            <div class="review-card__body">
              <div class="review-card__meta">{year(review.album.release_date)} · {review.reading_time || '–'} min</div>
              <h3><a href={`/reviews/${review.slug}`}>{review.title}</a></h3>
              {review.standfirst && <p>{review.standfirst}</p>}
              <a class="review-card__link" href={`/reviews/${review.slug}`}>Read review →</a>
            </div>
          </article>
        ))}
      </div>
    ) : !lead ? (
      <p class="muted">Reviews are being prepared.</p>
    ) : null}
  </section>
</Layout>

<style>
  .review-kicker { color: var(--accent-3); font-family: var(--f-mono); font-size: 9px; font-weight: 700; letter-spacing: .21em; text-transform: uppercase; }
  .review-lead { display: grid; grid-template-columns: minmax(280px, .8fr) minmax(0, 1.2fr); gap: clamp(38px, 7vw, 96px); align-items: center; padding-block: clamp(52px, 8vw, 112px); border-bottom: 1px solid var(--rule); }
  .review-lead__art { position: relative; display: block; max-width: 560px; border: 1px solid var(--rule-strong); box-shadow: 0 36px 90px rgba(0,0,0,.34); }
  .review-lead__art img { width: 100%; aspect-ratio: 1; object-fit: cover; transition: transform .5s ease, filter .5s ease; }
  .review-lead__art:hover img { filter: saturate(1.1); transform: scale(1.012); }
  .review-lead__score { position: absolute; right: -22px; bottom: -22px; display: grid; place-items: center; width: 104px; aspect-ratio: 1; border-radius: 50%; border: 1px solid color-mix(in srgb, var(--accent) 76%, white 12%); background: var(--accent); color: var(--accent-ink); box-shadow: 0 14px 36px rgba(0,0,0,.4); transform: rotate(-4deg); }
  .review-lead__score strong { align-self: end; font-family: var(--f-display); font-size: 46px; font-style: italic; font-weight: 400; line-height: .9; }
  .review-lead__score small { align-self: start; font-family: var(--f-mono); font-size: 9px; letter-spacing: .12em; }
  .review-lead__copy h2 { max-width: 13ch; margin: 14px 0 0; font-family: var(--f-display); font-size: clamp(40px, 5.4vw, 76px); font-style: italic; font-weight: 400; letter-spacing: -.03em; line-height: .98; text-wrap: balance; }
  .review-lead__copy h2 a { border: 0; }
  .review-lead__copy > p { max-width: 56ch; margin: 24px 0 0; color: var(--ink-2); font-family: var(--f-serif); font-size: clamp(18px, 1.8vw, 22px); font-style: italic; line-height: 1.55; }
  .review-meta { display: flex; flex-wrap: wrap; gap: 10px 22px; margin-top: 26px; color: var(--muted); font-family: var(--f-mono); font-size: 9px; letter-spacing: .14em; text-transform: uppercase; }
  .review-read { display: inline-flex; gap: 20px; margin-top: 30px; padding-bottom: 7px; color: var(--accent-3); font-family: var(--f-mono); font-size: 10px; letter-spacing: .16em; text-transform: uppercase; }
  .review-read span { transition: transform .18s ease; }
  .review-read:hover span { transform: translateX(5px); }
  .review-archive { padding-top: clamp(56px, 8vw, 112px); }
  .review-archive__head { display: flex; justify-content: space-between; align-items: end; gap: 24px; padding-bottom: 22px; border-bottom: 1px solid var(--rule); }
  .review-archive__head h2 { margin: 8px 0 0; font-family: var(--f-display); font-size: clamp(34px, 4vw, 56px); font-style: italic; font-weight: 400; line-height: 1; }
  .review-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 clamp(28px, 5vw, 72px); }
  .review-card { display: grid; grid-template-columns: minmax(120px, 200px) minmax(0, 1fr); gap: clamp(20px, 3vw, 34px); padding-block: clamp(32px, 4vw, 52px); border-bottom: 1px solid var(--rule); }
  .review-card__art { position: relative; align-self: start; display: block; overflow: visible; border: 1px solid var(--rule); }
  .review-card__art img { width: 100%; aspect-ratio: 1; object-fit: cover; filter: saturate(.92); transition: filter .3s ease, transform .3s ease; }
  .review-card__art:hover img { filter: saturate(1.12); transform: scale(1.018); }
  .review-card__score { position: absolute; right: -10px; bottom: -10px; display: grid; place-items: center; min-width: 50px; min-height: 50px; padding: 7px; border-radius: 50%; background: var(--accent); color: var(--accent-ink); font-family: var(--f-display); font-size: 22px; font-style: italic; box-shadow: 0 8px 20px rgba(0,0,0,.35); }
  .review-card__meta { color: var(--accent-3); font-family: var(--f-mono); font-size: 9px; letter-spacing: .14em; text-transform: uppercase; }
  .review-card h3 { margin: 10px 0 0; font-family: var(--f-display); font-size: clamp(25px, 2.5vw, 36px); font-style: italic; font-weight: 400; line-height: 1.05; text-wrap: balance; }
  .review-card h3 a { border: 0; }
  .review-card p { display: -webkit-box; margin: 13px 0 0; overflow: hidden; color: var(--muted); font-family: var(--f-serif); font-size: 14px; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
  .review-card__link { display: inline-block; margin-top: 18px; border: 0; color: var(--accent-3); font-family: var(--f-mono); font-size: 9px; letter-spacing: .13em; text-transform: uppercase; }

  @media (max-width: 980px) {
    .review-grid { grid-template-columns: 1fr; }
    .review-card { grid-template-columns: 170px minmax(0, 1fr); }
  }
  @media (max-width: 720px) {
    .review-lead { grid-template-columns: 1fr; gap: 44px; }
    .review-lead__art { width: min(84vw, 500px); justify-self: center; }
    .review-lead__copy h2 { max-width: 16ch; }
  }
  @media (max-width: 520px) {
    .review-lead { padding-top: 42px; }
    .review-lead__score { right: -12px; bottom: -16px; width: 86px; }
    .review-lead__score strong { font-size: 38px; }
    .review-archive__head { align-items: flex-start; }
    .review-card { grid-template-columns: 112px minmax(0, 1fr); gap: 20px; }
    .review-card h3 { font-size: 25px; }
    .review-card p { -webkit-line-clamp: 2; }
    .review-card__link { margin-top: 13px; }
  }
  @media (max-width: 380px) {
    .review-card { grid-template-columns: 92px minmax(0, 1fr); gap: 16px; }
    .review-card h3 { font-size: 22px; }
    .review-card p { display: none; }
    .review-card__score { right: -8px; bottom: -8px; min-width: 42px; min-height: 42px; font-size: 19px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .review-lead__art img, .review-card__art img, .review-read span { transition: none; }
  }
</style>
