---
import MainLayout from '../../../layouts/MainLayout.astro';
import WikiSidebar from '../../../components/sidebar/WikiSidebar.astro';
import PageFilter from '../../../components/PageFilter.astro';
import { getWikiMembers } from '../../../lib/directus';

const members = await getWikiMembers();

// Separate current and past members
const currentMembers = members.filter(m => m.isCurrentMember);
const pastMembers = members.filter(m => !m.isCurrentMember);
---

<MainLayout
  title="Band Members"
  description="Current and past members of The Cure"
  showSidebar={true}
  customSidebar={true}
>
  <Fragment slot="sidebar">
    <WikiSidebar
      currentMembers={currentMembers}
      pastMembers={pastMembers}
      activePage="/wiki/members"
    />
  </Fragment>

  {/* Breadcrumb */}
  <nav class="mb-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-white/80">
      <li><a href="/wiki" class="hover:text-white transition-colors">Wiki</a></li>
      <li aria-hidden="true">/</li>
      <li class="text-white">Band Members</li>
    </ol>
  </nav>

  {/* Hero */}
  <section class="mb-12">
    <div class="glass-panel overflow-hidden relative">
      <div class="absolute -top-20 -left-20 w-64 h-64 rounded-full bg-white/[0.06] blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-10 -right-10 w-48 h-48 rounded-full bg-accent/[0.06] blur-2xl pointer-events-none"></div>

      <div class="relative p-8 md:p-12">
        <h1 class="font-display text-5xl md:text-6xl lg:text-7xl text-white mb-4 text-glow">Band Members</h1>
        <p class="text-white/75 text-lg md:text-xl max-w-3xl leading-relaxed">
          The Cure has had many talented musicians throughout its history. Meet the current lineup
          and learn about past members who contributed to the band's legendary sound.
        </p>

        <div class="flex flex-wrap gap-8 mt-8 pt-6 border-t border-white/[0.08]">
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-white text-glow">{currentMembers.length}</span>
            <span class="text-white/85 text-base font-medium">Current Members</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-white text-glow">{pastMembers.length}</span>
            <span class="text-white/85 text-base font-medium">Past Members</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Search -->
  <section class="mb-8">
    <PageFilter id="members" placeholder="Search members..." />
  </section>

  {/* Current members */}
  {currentMembers.length > 0 && (
    <section class="mb-12">
      <h2 class="text-2xl text-white mb-6 flex items-center gap-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-6 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Current Members
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {currentMembers.map((member, index) => (
          <a
            href={`/wiki/members/${member.slug}`}
            class="group"
            style={`--index: ${index}`}
            data-filter-item
            data-filter-text={`${member.name} ${(Array.isArray(member.instruments) ? member.instruments.join(' ') : (member.instruments || ''))} ${member.tenure}`}
          >
            <div class="glass-card-hover overflow-hidden animate-fade-in">
              <div class="flex gap-4 p-5">
                {member.photo ? (
                  <img
                    src={member.photo}
                    alt={member.name}
                    class="w-24 h-24 rounded-xl object-cover shrink-0 border border-white/10 group-hover:border-white/20/40 transition-colors"
                  />
                ) : (
                  <div class="w-24 h-24 rounded-xl bg-white/10 shrink-0 flex items-center justify-center border border-white/10">
                    <span class="text-3xl text-primary font-medium">{member.name.charAt(0)}</span>
                  </div>
                )}
                <div class="flex-1 min-w-0">
                  <h3 class="font-heading text-xl text-white group-hover:text-white transition-colors">
                    {member.name}
                  </h3>
                  <p class="text-white/85 text-sm mt-1">
                    {Array.isArray(member.instruments) ? member.instruments.join(', ') : (member.instruments || '')}
                  </p>
                  <p class="text-white/80 text-sm mt-2">
                    {member.tenure}
                  </p>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  {/* Past members */}
  {pastMembers.length > 0 && (
    <section>
      <h2 class="text-2xl text-white mb-6 flex items-center gap-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-6 text-white/80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Past Members
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {pastMembers.map((member, index) => (
          <a
            href={`/wiki/members/${member.slug}`}
            class="group"
            style={`--index: ${index}`}
            data-filter-item
            data-filter-text={`${member.name} ${(Array.isArray(member.instruments) ? member.instruments.join(' ') : (member.instruments || ''))} ${member.tenure}`}
          >
            <div class="glass-card-hover overflow-hidden animate-fade-in">
              <div class="flex gap-4 p-5">
                {member.photo ? (
                  <img
                    src={member.photo}
                    alt={member.name}
                    class="w-20 h-20 rounded-xl object-cover shrink-0 border border-white/10 group-hover:border-white/30 transition-colors grayscale group-hover:grayscale-0"
                  />
                ) : (
                  <div class="w-20 h-20 rounded-xl bg-white/10 shrink-0 flex items-center justify-center border border-white/10">
                    <span class="text-2xl text-white/80 font-medium">{member.name.charAt(0)}</span>
                  </div>
                )}
                <div class="flex-1 min-w-0">
                  <h3 class="font-heading text-lg text-white group-hover:text-white transition-colors">
                    {member.name}
                  </h3>
                  <p class="text-white/80 text-sm mt-1">
                    {Array.isArray(member.instruments) ? member.instruments.join(', ') : (member.instruments || '')}
                  </p>
                  <p class="text-white/80 text-xs mt-2">
                    {member.tenure}
                  </p>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  {members.length === 0 && (
    <div class="glass-card p-12 text-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="size-16 text-white/20 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
      </svg>
      <p class="text-white/85">Member information coming soon.</p>
    </div>
  )}
</MainLayout>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fadeIn 0.5s ease forwards;
    animation-delay: calc(var(--index, 0) * 75ms);
    opacity: 0;
  }
</style>

