---
import MainLayout from '../../layouts/MainLayout.astro';
import WikiSidebar from '../../components/sidebar/WikiSidebar.astro';
import PageFilter from '../../components/PageFilter.astro';
import Timeline from '../../components/Timeline.astro';
import { getWikiArticles, getWikiMembers, getTimelineEvents } from '../../lib/directus';

// Fetch wiki data
const [articles, members, timelineEvents] = await Promise.all([
  getWikiArticles(),
  getWikiMembers(),
  getTimelineEvents()
]);

// Separate current and past members
const currentMembers = members.filter(m => m.isCurrentMember);
const pastMembers = members.filter(m => !m.isCurrentMember);

// Get featured/recent timeline events
const recentEvents = timelineEvents.slice(0, 5);
---

<MainLayout
  title="Wiki & History"
  description="The complete history of The Cure - band members, timeline, side projects, and more"
  showSidebar={true}
  customSidebar={true}
>
  <Fragment slot="sidebar">
    <WikiSidebar
      currentMembers={currentMembers}
      pastMembers={pastMembers}
      activePage="/wiki"
    />
  </Fragment>

  {/* Hero section (full width, in hero slot) */}
  <section class="mb-10" slot="hero">
    <div class="glass-panel overflow-hidden relative">
      <div class="absolute -top-20 -left-20 w-64 h-64 rounded-full bg-white/[0.06] blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-10 -right-10 w-48 h-48 rounded-full bg-accent/[0.06] blur-2xl pointer-events-none"></div>

      <div class="relative p-8 md:p-12">
        <h1 class="font-display text-5xl md:text-6xl lg:text-7xl text-white mb-4 text-glow">Wiki & History</h1>
        <p class="text-white/75 text-lg md:text-xl max-w-3xl leading-relaxed">
          Explore the complete history of The Cure — from their formation in 1976 to the present day.
          Discover band members, timeline events, equipment, and behind-the-scenes stories.
        </p>

        <div class="flex flex-wrap gap-8 mt-8 pt-6 border-t border-white/[0.08]">
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-white text-glow">{new Date().getFullYear() - 1976}</span>
            <span class="text-white/85 text-base font-medium">Years Active</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-white text-glow">{members.length}</span>
            <span class="text-white/85 text-base font-medium">Band Members</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-white text-glow">{timelineEvents.length}</span>
            <span class="text-white/85 text-base font-medium">Timeline Events</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-white text-glow">{articles.length}</span>
            <span class="text-white/85 text-base font-medium">Wiki Articles</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Search & Filters -->
  <section class="mb-8" slot="hero">
    <div class="mb-4">
      <PageFilter id="wiki" placeholder="Search wiki..." />
    </div>

    <!-- Type Tabs -->
    <nav class="overflow-x-auto scrollbar-hide">
      <div class="flex gap-2 min-w-max pb-2">
      <a href="/wiki" class="type-tab flex items-center gap-2 px-4 py-2.5 rounded-sm text-sm font-medium transition-all whitespace-nowrap tracking-wide active">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 6h16M4 10h16M4 14h16M4 18h16" />
        </svg>
        Overview
      </a>
      <a href="/wiki/members" class="type-tab flex items-center gap-2 px-4 py-2.5 rounded-sm text-sm font-medium transition-all whitespace-nowrap tracking-wide">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        Members
      </a>
      <a href="/wiki/gear" class="type-tab flex items-center gap-2 px-4 py-2.5 rounded-sm text-sm font-medium transition-all whitespace-nowrap tracking-wide">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
          <circle cx="12" cy="12" r="3" />
        </svg>
        Gear
      </a>
      <a href="/wiki/quotes" class="type-tab flex items-center gap-2 px-4 py-2.5 rounded-sm text-sm font-medium transition-all whitespace-nowrap tracking-wide">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
        </svg>
        Quotes
      </a>
    </div>
    </nav>
  </section>

  <!-- Quick Insights -->
  <section class="mb-8">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
      <div class="glass-tile p-4">
        <p class="text-white/50 text-[11px] uppercase tracking-[0.15em] mb-1">Current Members</p>
        <p class="text-2xl font-display text-white text-glow">{currentMembers.length}</p>
      </div>
      <div class="glass-tile p-4">
        <p class="text-white/50 text-[11px] uppercase tracking-[0.15em] mb-1">Past Members</p>
        <p class="text-2xl font-display text-white text-glow">{pastMembers.length}</p>
      </div>
      <div class="glass-tile p-4">
        <p class="text-white/50 text-[11px] uppercase tracking-[0.15em] mb-1">Timeline Events</p>
        <p class="text-2xl font-display text-white text-glow">{timelineEvents.length}</p>
      </div>
      <div class="glass-tile p-4">
        <p class="text-white/50 text-[11px] uppercase tracking-[0.15em] mb-1">Wiki Articles</p>
        <p class="text-2xl font-display text-white text-glow">{articles.length}</p>
      </div>
    </div>
  </section>

  {/* Current members */}
  {currentMembers.length > 0 && (
    <section class="mb-12">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl text-white section-header">Current Members</h2>
        <a href="/wiki/members" class="group text-sm text-white/80 hover:text-white transition-colors flex items-center gap-1.5">
          View all
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4 group-hover:translate-x-1 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {currentMembers.map(member => {
          const instruments = Array.isArray(member.instruments) ? member.instruments : [];
          return (
            <a href={`/wiki/members/${member.slug}`} class="member-card group block" data-filter-item data-filter-text={`${member.name} ${instruments.join(' ')} ${member.tenure}`}>
              <div class="glass-tile p-0 overflow-hidden h-full">
                <div class="flex items-start gap-4 p-5">
                  {/* Photo */}
                  <div class="shrink-0">
                    {member.photo ? (
                      <img
                        src={member.photo}
                        alt={member.name}
                        class="w-16 h-16 rounded-full object-cover border-2 border-white/10 group-hover:border-primary/40 transition-colors"
                      />
                    ) : (
                      <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center border-2 border-white/10 group-hover:border-primary/40 transition-colors">
                        <span class="text-xl text-primary font-display">{member.name.charAt(0)}</span>
                      </div>
                    )}
                  </div>
                  {/* Info */}
                  <div class="min-w-0 flex-1">
                    <h3 class="font-heading text-lg text-white group-hover:text-primary transition-colors leading-tight">
                      {member.name}
                    </h3>
                    {instruments.length > 0 && (
                      <p class="text-white/60 text-sm mt-1">{instruments.join(', ')}</p>
                    )}
                    <p class="text-white/40 text-xs mt-1.5">{member.tenure}</p>
                  </div>
                  {/* Arrow */}
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-primary/40 group-hover:text-primary group-hover:translate-x-0.5 transition-all shrink-0 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m9 18 6-6-6-6"/></svg>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  )}

  {/* Recent timeline */}
  <section>
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-2xl text-white section-header">Recent History</h2>
      <a href="/wiki/timeline" class="text-primary text-sm hover:underline">View full timeline →</a>
    </div>
    <Timeline events={recentEvents} />
  </section>
</MainLayout>

<style>
  .type-tab {
    color: rgba(255, 255, 255, 0.45);
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }
  .type-tab:hover {
    color: rgba(255, 255, 255, 0.85);
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.1);
  }
  .type-tab.active {
    background: rgba(var(--color-primary-rgb, 137, 176, 201), 0.12);
    color: var(--color-primary);
    border-color: rgba(var(--color-primary-rgb, 137, 176, 201), 0.25);
  }

  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
  .scrollbar-hide::-webkit-scrollbar { display: none; }
</style>
