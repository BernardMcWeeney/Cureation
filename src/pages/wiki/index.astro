---
import MainLayout from '../../layouts/MainLayout.astro';
import WikiSidebar from '../../components/sidebar/WikiSidebar.astro';
import Timeline from '../../components/Timeline.astro';
import { getWikiArticles, getWikiMembers, getTimelineEvents } from '../../lib/directus';

// Fetch wiki data
const [articles, members, timelineEvents] = await Promise.all([
  getWikiArticles(),
  getWikiMembers(),
  getTimelineEvents()
]);

// Separate current and past members
const currentMembers = members.filter(m => m.isCurrentMember);
const pastMembers = members.filter(m => !m.isCurrentMember);

// Get featured/recent timeline events
const recentEvents = timelineEvents.slice(0, 5);
---

<MainLayout
  title="Wiki & History"
  description="The complete history of The Cure - band members, timeline, side projects, and more"
  showSidebar={true}
  customSidebar={true}
>
  <Fragment slot="sidebar">
    <WikiSidebar
      currentMembers={currentMembers}
      pastMembers={pastMembers}
      activePage="/wiki"
    />
  </Fragment>

  {/* Hero section */}
  <section class="mb-12">
    <div class="glass-panel p-8 md:p-10">
      <h1 class="text-4xl md:text-5xl text-white mb-4 section-header">Wiki & History</h1>
      <p class="text-white/60 text-lg max-w-2xl mb-6 mt-6">
        Explore the complete history of The Cure - from their formation in 1976 to the present day.
        Discover band members, timeline events, equipment, and behind-the-scenes stories.
      </p>
      <div class="flex flex-wrap gap-4">
        <div class="glass-stat p-4 rounded-lg text-center">
          <p class="text-3xl font-bold text-primary">{new Date().getFullYear() - 1976}</p>
          <p class="text-sm text-white/50">Years Active</p>
        </div>
        <div class="glass-stat p-4 rounded-lg text-center">
          <p class="text-3xl font-bold text-primary">{members.length}</p>
          <p class="text-sm text-white/50">Band Members</p>
        </div>
        <div class="glass-stat p-4 rounded-lg text-center">
          <p class="text-3xl font-bold text-primary">{timelineEvents.length}</p>
          <p class="text-sm text-white/50">Timeline Events</p>
        </div>
        <div class="glass-stat p-4 rounded-lg text-center">
          <p class="text-3xl font-bold text-primary">{articles.length}</p>
          <p class="text-sm text-white/50">Wiki Articles</p>
        </div>
      </div>
    </div>
  </section>

  {/* Quick navigation */}
  <section class="mb-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <a href="/wiki/timeline" class="group">
        <div class="glass-elevated p-5 text-center h-full">
          <div class="p-3 rounded-xl bg-primary/20 w-fit mx-auto mb-3 group-hover:bg-primary/30 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="font-heading text-white group-hover:text-primary transition-colors">Timeline</h3>
          <p class="text-white/50 text-sm mt-1">Chronological history</p>
        </div>
      </a>

      <a href="/wiki/members" class="group">
        <div class="glass-elevated p-5 text-center h-full">
          <div class="p-3 rounded-xl bg-accent/20 w-fit mx-auto mb-3 group-hover:bg-accent/30 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
          </div>
          <h3 class="font-heading text-white group-hover:text-accent transition-colors">Members</h3>
          <p class="text-white/50 text-sm mt-1">Past & present</p>
        </div>
      </a>

      <a href="/wiki/side-projects" class="group">
        <div class="glass-elevated p-5 text-center h-full">
          <div class="p-3 rounded-xl bg-pink-500/20 w-fit mx-auto mb-3 group-hover:bg-pink-500/30 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-6 text-pink-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v12M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
            </svg>
          </div>
          <h3 class="font-heading text-white group-hover:text-pink-400 transition-colors">Side Projects</h3>
          <p class="text-white/50 text-sm mt-1">Related bands</p>
        </div>
      </a>

      <a href="/wiki/lore" class="group">
        <div class="glass-elevated p-5 text-center h-full">
          <div class="p-3 rounded-xl bg-amber-500/20 w-fit mx-auto mb-3 group-hover:bg-amber-500/30 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-6 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          <h3 class="font-heading text-white group-hover:text-amber-400 transition-colors">Lore & Trivia</h3>
          <p class="text-white/50 text-sm mt-1">Fun facts</p>
        </div>
      </a>
    </div>
  </section>

  {/* Current members */}
  {currentMembers.length > 0 && (
    <section class="mb-12">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl text-white section-header">Current Members</h2>
        <a href="/wiki/members" class="text-primary text-sm hover:underline">View all →</a>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {currentMembers.map(member => (
          <a href={`/wiki/members/${member.slug}`} class="group">
            <div class="glass-elevated p-4 text-center">
              {member.photo ? (
                <img
                  src={member.photo}
                  alt={member.name}
                  class="w-20 h-20 rounded-full object-cover mx-auto mb-3 border-2 border-white/10 group-hover:border-primary/40 transition-colors"
                />
              ) : (
                <div class="w-20 h-20 rounded-full bg-primary/20 mx-auto mb-3 flex items-center justify-center border-2 border-white/10">
                  <span class="text-2xl text-primary font-medium">{member.name.charAt(0)}</span>
                </div>
              )}
              <h3 class="font-heading text-white group-hover:text-primary transition-colors">
                {member.name}
              </h3>
              <p class="text-white/50 text-sm mt-1">{member.instruments.slice(0, 2).join(', ')}</p>
              <p class="text-white/40 text-xs mt-1">{member.tenure}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  {/* Recent timeline */}
  <section>
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-2xl text-white section-header">Recent History</h2>
      <a href="/wiki/timeline" class="text-primary text-sm hover:underline">View full timeline →</a>
    </div>
    <Timeline events={recentEvents} />
  </section>
</MainLayout>
