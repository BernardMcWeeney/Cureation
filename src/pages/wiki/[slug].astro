---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import Crumbs from '../../components/ui/Crumbs.astro';
import Tag from '../../components/ui/Tag.astro';
import ReadingProgress from '../../components/ui/ReadingProgress.astro';
import Bookmark from '../../components/ui/Bookmark.astro';
import { fetchRaw } from '../../lib/directus';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/wiki');

const rows: any[] = await fetchRaw('news', { limit: 1, 'filter[slug][_eq]': slug, fields: '*' }).catch(() => []);
const article = rows[0];
if (!article) return new Response('Not found', { status: 404 });

const tags: string[] = Array.isArray(article.tags) ? article.tags : [];
---
<Layout title={`${article.title} · Wiki · Cureation`}>
  <ReadingProgress target="article" />
  <div class="container" style="padding-top: clamp(24px, 3vw, 40px); display:flex; justify-content: space-between; align-items: center; gap: 1rem;">
    <Crumbs items={[
      { label: 'Home', href: '/' },
      { label: 'The wiki', href: '/wiki' },
      { label: article.title },
    ]} />
    <Bookmark kind="news" id={article.id} label={article.title} href={`/wiki/${article.slug}`} />
  </div>

  <article class="container" style="padding-block: clamp(24px, 4vw, 48px); max-width: 780px;">
    <div class="mono-sm muted">WIKI · {article.category?.toUpperCase() || 'REFERENCE'}</div>
    <div class="cluster" style="gap: .4rem; margin-top: .6rem;">
      {tags.slice(0, 4).map((t) => <Tag>{t.toUpperCase()}</Tag>)}
    </div>
    <h1 class="serif" style="font-size: clamp(40px, 6vw, 80px); line-height: .95; font-style: italic; font-weight: 400; margin: .4rem 0 0;">{article.title}</h1>
    {article.excerpt && <p style="font-family: var(--f-serif); font-size: 20px; line-height: 1.55; color: var(--ink-2); margin-top: 1rem;">{article.excerpt}</p>}
    <div class="mono-sm muted" style="margin-top: 1rem;">
      {article.published_date || '—'}
      {article.reading_time && <> · {article.reading_time} MIN READ</>}
      {article.author_name && <> · {article.author_name.toUpperCase()}</>}
    </div>

    {article.content && (
      <div class="prose" set:html={article.content} />
    )}
  </article>
</Layout>

<style>
  .prose { font-family: var(--f-serif); font-size: 18px; line-height: 1.75; color: var(--ink); margin-top: 2rem; }
  .prose :global(h2) { font-family: var(--f-display); font-style: italic; font-size: clamp(28px, 3vw, 40px); line-height: 1.1; margin: 2.4rem 0 1rem; letter-spacing: -.01em; }
  .prose :global(h3) { font-family: var(--f-display); font-style: italic; font-size: clamp(22px, 2.2vw, 30px); margin: 2rem 0 .8rem; }
  .prose :global(p) { margin: 1rem 0; }
  .prose :global(blockquote) { border-left: 2px solid var(--accent); padding: 0 0 0 1.2rem; font-style: italic; color: var(--ink-2); margin: 1.5rem 0; }
  .prose :global(a) { color: var(--accent-3); border-bottom: 1px solid var(--rule); }
  .prose :global(ul),
  .prose :global(ol) { padding-left: 1.4rem; margin: 1rem 0; }
</style>
