---
import { editable, copyText, copyAttr, copySource, copyTuple, copyTupleSource } from '../lib/visual-editing';
import Layout from '../layouts/Layout.astro';
import IssueSection from '../components/ui/IssueSection.astro';
import PageHero from '../components/ui/PageHero.astro';
import Select from '../components/ui/Select.astro';
import SearchField from '../components/ui/SearchField.astro';
import Pagination from '../components/ui/Pagination.astro';
import { listTours, listAlbums, listSetlists } from '../lib/directus';

const [tours, albums, setlists] = await Promise.all([
  listTours(),
  listAlbums(),
  listSetlists({ limit: -1 }),
]);
const albumsById = Object.fromEntries(albums.map((a) => [a.id, a]));

const totalShows = tours.reduce((n, t) => n + (t.total_shows || 0), 0);
const countriesSet = new Set(setlists.map((s) => s.country).filter(Boolean));

const decades: Record<string, { tours: Set<number>; shows: number }> = {};
const tourDecadesById = new Map<number, Set<string>>();
setlists.forEach((s) => {
  const y = s.date?.slice(0, 4);
  if (!y) return;
  const d = `${y.slice(0, 3)}0s`;
  if (!decades[d]) decades[d] = { tours: new Set(), shows: 0 };
  decades[d].shows += 1;
  if (s.tour) {
    decades[d].tours.add(s.tour);
    if (!tourDecadesById.has(s.tour)) tourDecadesById.set(s.tour, new Set());
    tourDecadesById.get(s.tour)!.add(d);
  }
});
const decadeEntries = Object.entries(decades).sort((a, b) => a[0].localeCompare(b[0]));

const facts: Array<[string, string]> = [
  copyTuple([copyText("pages_tours_tuple-09a809a586cc", "Tours"), String(tours.length)], {"0":"pages_tours_tuple-09a809a586cc"}),
  copyTuple([copyText("pages_tours_tuple-3233951d7b29", "Total shows"), totalShows.toLocaleString()], {"0":"pages_tours_tuple-3233951d7b29"}),
  copyTuple([copyText("pages_tours_tuple-6b75af4fc54b", "Countries visited"), String(countriesSet.size)], {"0":"pages_tours_tuple-6b75af4fc54b"}),
  copyTuple([copyText("pages_tours_tuple-0812db5058f7", "Decades active"), String(decadeEntries.length)], {"0":"pages_tours_tuple-0812db5058f7"}),
];
---
<Layout title="Tours · Cureation">
  <PageHero copyKeys={{"section":"pages_tours_dc42e033debc","title":"pages_tours_858d1f1fadb5","deck":"pages_tours_2040a8eb9760"}}
    section={copyText("pages_tours_dc42e033debc", "Touring")}
    title={copyText("pages_tours_858d1f1fadb5", "The tours")}

    crumbs={[{ ...copySource({"label":"pages_tours_data-d757dcd38106"}),  label: copyText("pages_tours_data-d757dcd38106", "Home"), href: '/' }, { ...copySource({"label":"pages_tours_data-bfb1826cb4ae"}),  label: copyText("pages_tours_data-bfb1826cb4ae", "Tours") }]}
    facts={facts.map((fact) => ({ ...copyTupleSource(fact, ["k", "v"]), k: fact[0], v: fact[1] }))}
    flush
  />

  <IssueSection title="Tours" hideHeader>
    <div class="table-controls" aria-label="Tour table filters">
      <div class="table-controls__grid">
        <Select
          name="decade"
          label="Decade"
          options={[{ value: 'all', label: 'All decades' }, ...decadeEntries.map(([d]) => ({ value: d, label: d }))]}
        />
        <Select
          name="sort"
          label="Sort"
          value="desc"
          options={[
            { value: 'desc', label: 'Newest first' },
            { value: 'asc', label: 'Oldest first' },
          ]}
        />
        <SearchField label="Search tours" placeholder="Tour, record..." />
      </div>
    </div>
    <div class="table-results-bar">
      <span data-match-count>{tours.length} tours</span>
      <span><span data-directus={copyAttr("pages_tours_6e35509ad16e")} set:html={copyText("pages_tours_6e35509ad16e", "All decades")} data-active-decade></span> · <span data-page-range aria-live="polite"></span></span>
    </div>
    <div class="table-wrap">
    <table class="data data--airy" data-tours-table>
      <thead><tr><th style="width:50px;">№</th><th data-directus={copyAttr("pages_tours_7f7fd41e4a4c")} set:html={copyText("pages_tours_7f7fd41e4a4c", "Start")} style="width:110px;"></th><th data-directus={copyAttr("pages_tours_04d527094faf")} set:html={copyText("pages_tours_04d527094faf", "Tour")}></th><th data-directus={copyAttr("pages_tours_6181b9e13af3")} set:html={copyText("pages_tours_6181b9e13af3", "Album")}></th><th data-directus={copyAttr("pages_tours_f45e1356c8e6")} set:html={copyText("pages_tours_f45e1356c8e6", "Shows")} class="num" style="text-align:right; width:80px;"></th></tr></thead>
      <tbody>
        {tours.slice().reverse().map((t, i) => {
          const album = t.associated_album ? albumsById[t.associated_album] : null;
          const y = t.start_date?.slice(0, 4) || '';
          const fallbackDecade = y ? `${y.slice(0, 3)}0s` : '';
          const tourDecades = Array.from(tourDecadesById.get(t.id) || new Set(fallbackDecade ? [fallbackDecade] : []));
          const search = `${t.name || ''} ${album?.title || ''}`.toLowerCase();
          return (
            <tr data-clickable data-decade={tourDecades.join('|')} data-search={search} data-start={t.start_date || ''} data-row-href={`/tours/${t.slug}`}>
              <td class="idx">{String(i + 1).padStart(2, '0')}</td>
              <td data-directus={editable(t, ["start_date"])} class="mono-sm" style="color: var(--ink);">{t.start_date || '–'}</td>
              <td><a data-directus={editable(t, ["name"])} href={`/tours/${encodeURIComponent(t.slug)}`} class="serif" style="font-size:20px; font-style:italic;">{t.name}</a></td>
              <td data-directus={editable(album, ["title"])} class="mono-sm" style="color: var(--ink-2);">{album ? album.title : '–'}</td>
              <td data-directus={editable(t, ["total_shows"])} class="num">{t.total_shows || '–'}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
    </div>
    <Pagination label="Tour archive pages" />
  </IssueSection>
</Layout>

<script>
  import { createTablePager } from '../lib/client-pagination';

  function wire() {
    const state: Record<string, string> = { decade: 'all', search: '', sort: 'desc' };
    const table = document.querySelector<HTMLElement>('[data-tours-table]');
    if (!table || table.dataset.filtersWired === 'true') return;
    table.dataset.filtersWired = 'true';
    const root = table.closest<HTMLElement>('.issue-section');
    const tbody = table.querySelector<HTMLElement>('tbody');
    const rows = Array.from(table.querySelectorAll<HTMLElement>('tbody tr'));
    if (!root || !tbody) return;
    const counter = root.querySelector<HTMLElement>('[data-match-count]');
    const activeDecade = root.querySelector<HTMLElement>('[data-active-decade]');
    const pager = createTablePager(root, rows, { pageSize: 50 });
    const apply = (resetPage = false) => {
      const sorted = rows.slice().sort((a, b) => {
        const da = a.getAttribute('data-start') || '';
        const db = b.getAttribute('data-start') || '';
        return state.sort === 'asc' ? da.localeCompare(db) : db.localeCompare(da);
      });
      sorted.forEach((row) => tbody.appendChild(row));

      const matches = sorted.filter((r) => {
        const decades = (r.getAttribute('data-decade') || '').split('|').filter(Boolean);
        const s = r.getAttribute('data-search') || '';
        return (state.decade === 'all' || decades.includes(state.decade)) && (!state.search || s.includes(state.search));
      });
      matches.forEach((row, index) => {
        const idx = row.querySelector<HTMLElement>('.idx');
        if (idx) idx.textContent = String(index + 1).padStart(2, '0');
      });
      pager.render(matches, { reset: resetPage });
      if (counter) counter.textContent = `${matches.length} tour${matches.length === 1 ? '' : 's'}`;
      if (activeDecade) activeDecade.textContent = state.decade === 'all' ? 'All decades' : state.decade;
    };
    root.querySelectorAll<HTMLSelectElement>('[data-filter-select]').forEach((sel) => {
      const key = sel.getAttribute('data-filter-select') || '';
      sel.addEventListener('change', () => {
        state[key] = sel.value || 'all';
        apply(true);
      });
    });
    const search = root.querySelector<HTMLInputElement>('[data-filter-search]');
    if (search) search.addEventListener('input', () => { state.search = search.value.trim().toLowerCase(); apply(true); });
    apply();
  }
  wire();
  document.addEventListener('astro:page-load', wire);
</script>
