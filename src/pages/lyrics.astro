---
import Layout from '../layouts/Layout.astro';
import IssueSection from '../components/ui/IssueSection.astro';
import PageHero from '../components/ui/PageHero.astro';
import Chip from '../components/ui/Chip.astro';
import Select from '../components/ui/Select.astro';
import SearchField from '../components/ui/SearchField.astro';
import Tag from '../components/ui/Tag.astro';
import { fetchRaw, getAllSongPlayCounts, getLyricOfDay, listAlbums } from '../lib/directus';
import { asset } from '../lib/assets';
import { normalizeStructuredLyrics } from '../lib/lyrics-helpers';

type LyricSong = {
  id: number;
  title: string;
  slug: string | null;
  album: number | null | { id?: number };
  track_number: number | null;
  duration: string | null;
  lyrics: string | null;
  lyrics_structured: any;
};

const [songs, albums, playCounts, lyricOfDay, singles] = await Promise.all([
  fetchRaw<LyricSong>('songs', {
    limit: -1,
    fields: 'id,title,slug,album,track_number,duration,lyrics,lyrics_structured',
    sort: 'title',
    'filter[slug][_nnull]': true,
  }),
  listAlbums(),
  getAllSongPlayCounts().catch(() => new Map<number, number>()),
  getLyricOfDay().catch(() => null),
  fetchRaw<any>('singles', {
    limit: -1,
    fields: '*',
    sort: 'release_date',
  }).catch(() => []),
]);
const albumsById = Object.fromEntries(albums.map((a) => [a.id, a]));
const albumsMap = new Map(albums.map((a) => [a.id, a]));

const lyricRows = songs
  .map((song: LyricSong) => {
    const albumId = typeof song.album === 'object' ? song.album?.id ?? null : song.album;
    const album = albumId ? albumsById[albumId] : null;
    const sections = normalizeStructuredLyrics(song.lyrics_structured, song.lyrics) || [];
    const lineCount = sections.reduce((total, section) => total + section.lines.length, 0);
    const firstChar = (song.title?.[0] || '').toUpperCase();
    return {
      ...song,
      albumId,
      album,
      sectionCount: sections.length,
      lineCount,
      plays: playCounts.get(song.id) ?? 0,
      letter: /^[A-Z]$/.test(firstChar) ? firstChar : '#',
    };
  })
  .filter((song) => song.slug && song.lineCount > 0)
  .sort((a, b) => (a.title || '').localeCompare(b.title || ''));

const letters = Array.from(new Set(lyricRows.map((s) => s.letter).filter(Boolean))).sort();
const lyricAlbumIds = new Set(lyricRows.map((s) => s.albumId).filter(Boolean));
const albumOptions = albums
  .filter((album) => lyricAlbumIds.has(album.id))
  .sort((a, b) => (a.release_date || '').localeCompare(b.release_date || ''));
const lineTotal = lyricRows.reduce((total, song) => total + song.lineCount, 0);
const today = new Date().toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' });

function fileId(value: any): string | null {
  if (!value) return null;
  if (typeof value === 'string') return value;
  if (typeof value === 'object') return value.id || value.filename_disk || null;
  return null;
}

function titleKey(value: string | null | undefined): string {
  return String(value || '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '');
}

function titleCase(value: string | null | undefined): string {
  return String(value || 'record')
    .replace(/[_-]/g, ' ')
    .replace(/\b\w/g, (char) => char.toUpperCase());
}

const lyricSong = lyricOfDay?.song || null;
const lyricAlbumId = lyricSong
  ? (typeof lyricSong.album === 'object' ? (lyricSong.album as any)?.id ?? null : lyricSong.album)
  : null;
const lyricAlbum = lyricAlbumId ? albumsMap.get(Number(lyricAlbumId)) : null;
const matchingSingles = lyricSong
  ? singles.filter((single: any) => {
      const singleAlbumId = typeof single.album === 'object' ? single.album?.id : single.album;
      return titleKey(single.title) === titleKey(lyricSong.title)
        && (!lyricAlbumId || !singleAlbumId || Number(singleAlbumId) === Number(lyricAlbumId));
    })
  : [];
const lyricSingle = matchingSingles[0] || null;
const lyricSingleArt = lyricSingle
  ? fileId(lyricSingle.cover_art) || fileId(lyricSingle.cover) || fileId(lyricSingle.artwork) || fileId(lyricSingle.image) || fileId(lyricSingle.image_file)
  : null;
const lyricArtId = lyricSingleArt || lyricAlbum?.cover_art || null;
const lyricArtSrc = lyricArtId ? asset(lyricArtId, 'card') : null;
const lyricReleaseTitle = lyricSingle?.title || lyricAlbum?.title || lyricSong?.title || 'Untitled';
const lyricReleaseKind = lyricSingle ? 'Single' : titleCase(lyricAlbum?.type);
const lyricReleaseDate = lyricSingle?.release_date || lyricAlbum?.release_date || null;
const lyricHref = lyricSong?.slug ? `/songs/${lyricSong.slug}` : lyricAlbum?.slug ? `/discography/${lyricAlbum.slug}` : '#';

const facts: Array<[string, string]> = [
  ['Songs in catalogue', String(songs.length)],
  ['Lyrics on file', String(lyricRows.length)],
  ['Lyric lines indexed', lineTotal.toLocaleString()],
  ['Records covered', String(albumOptions.length)],
];
---
<Layout title="Lyrics · Cureation">
  <PageHero
    section="Lyrics"
    title="Lyrics"
    deck="Every documented song lyric in the archive, grouped for scanning by title, record, or live history. Full lyrics and annotations live on each song page."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Lyrics' }]}
    facts={facts.map(([k, v]) => ({ k, v }))}
    flush
  />

  {lyricOfDay && lyricSong && (
    <section class="lyrics-feature">
      <div class="container">
        <div class="lyrics-feature__grid">
          <a class="lyrics-feature__art" href={lyricHref}>
            {lyricArtSrc ? (
              <img src={lyricArtSrc} alt={`${lyricReleaseTitle} artwork`} />
            ) : (
              <div class="placeholder lyrics-feature__placeholder">No artwork</div>
            )}
            <div class="cover-plate__corner cover-plate__corner--tl">
              <span>{lyricReleaseKind}</span>
            </div>
            <div class="cover-plate__corner cover-plate__corner--br">
              <span>{lyricReleaseDate?.slice(0, 4) || '—'}</span>
            </div>
          </a>
          <div class="lyrics-feature__body">
            <div class="mono-sm lyrics-feature__kind"><span class="pip pip--hot"></span>LYRIC OF THE DAY · {today.toUpperCase()}</div>
            <blockquote class="lyrics-feature__quote">
              <span class="lyrics-feature__mark">&ldquo;</span>{lyricOfDay.line}<span class="lyrics-feature__mark">&rdquo;</span>
            </blockquote>
            <a class="lyrics-feature__song serif" href={lyricHref}>{lyricSong.title}</a>
            <div class="mono-sm muted">
              {[lyricReleaseTitle, lyricReleaseDate?.slice(0, 4)].filter(Boolean).join(' · ').toUpperCase()}
            </div>
            <div class="cluster" style="gap:.4rem;">
              <Tag>{today.toUpperCase()}</Tag>
              {lyricReleaseKind && <span class="tag tag--cool">{lyricReleaseKind.toUpperCase()}</span>}
              {(lyricSong.times_played_live || 0) > 0 && <span class="tag tag--gold">{lyricSong.times_played_live.toLocaleString()} LIVE PLAYS</span>}
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <IssueSection kicker={`${lyricRows.length} songs`} title="Lyric index" meta="Filtered">
    <div class="table-controls" aria-label="Lyric table filters">
      <div class="table-controls__grid table-controls__grid--3">
        <Select
          name="record"
          label="Record"
          options={[{ value: 'all', label: 'All records' }, ...albumOptions.map((a: any) => ({ value: String(a.id), label: a.title }))]}
        />
        <Select
          name="sort"
          label="Sort"
          value="title"
          options={[
            { value: 'title', label: 'A-Z' },
            { value: 'record', label: 'Record sequence' },
            { value: 'plays', label: 'Most played' },
            { value: 'lines', label: 'Most lines' },
          ]}
        />
        <SearchField placeholder="Title..." />
      </div>
      {letters.length > 0 && (
        <div class="cluster lyrics-letters" data-letter-filters>
          <Chip active={true} class="l-chip" data-l="all">All</Chip>
          {letters.map((l) => <Chip class="l-chip" data-l={l}>{l}</Chip>)}
        </div>
      )}
    </div>
    <div class="table-results-bar">
      <span data-match-count>{lyricRows.length} songs</span>
    </div>
    <div class="table-wrap">
    <table class="data data--airy" data-lyric-table>
      <thead><tr><th style="width:50px;">№</th><th>Title</th><th>Record</th><th class="num" style="text-align:right; width:120px;">Lyrics</th><th class="num" style="text-align:right; width:100px;">Plays</th></tr></thead>
      <tbody>
        {lyricRows.map((s, i) => {
          const album = s.album;
          const albumYear = album?.release_date?.slice(0, 4);
          return (
            <tr
              data-clickable
              data-l={s.letter}
              data-record={s.albumId || ''}
              data-date={album?.release_date || '9999-99-99'}
              data-track={s.track_number || 999}
              data-title={(s.title || '').toLowerCase()}
              data-search={`${s.title || ''} ${album?.title || ''}`.toLowerCase()}
              data-plays={s.plays}
              data-lines={s.lineCount}
              onclick={s.slug ? `location.href='/songs/${s.slug}'` : undefined}
            >
              <td class="idx">{String(i + 1).padStart(3, '0')}</td>
              <td>
                <a href={`/songs/${s.slug}`} class="serif lyric-title">{s.title}</a>
                {s.duration && <div class="mono-sm muted lyric-sub">{s.duration}</div>}
              </td>
              <td>
                <span class="mono-sm lyric-record">{album?.title || '—'}</span>
                {albumYear && <div class="mono-sm muted lyric-sub">{albumYear}{s.track_number ? ` · track ${s.track_number}` : ''}</div>}
              </td>
              <td class="num">{s.lineCount.toLocaleString()} lines</td>
              <td class="num" style="color: var(--accent-3);">{s.plays.toLocaleString()}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
    </div>
    <div class="lyrics-empty mono-sm muted" data-empty hidden>No matching lyric pages.</div>
  </IssueSection>
</Layout>

<script>
  function wire() {
    const table = document.querySelector<HTMLElement>('[data-lyric-table]');
    if (!table || table.dataset.filtersWired === 'true') return;
    table.dataset.filtersWired = 'true';

    const state: Record<string, string> = { record: 'all', sort: 'title', search: '', letter: 'all' };
    const tbody = table.querySelector<HTMLElement>('tbody');
    const rows = Array.from(table.querySelectorAll<HTMLElement>('tbody tr'));
    const counter = document.querySelector<HTMLElement>('[data-match-count]');
    const empty = document.querySelector<HTMLElement>('[data-empty]');
    if (!tbody) return;

    const sortRows = () => {
      const sorted = [...rows].sort((a, b) => {
        if (state.sort === 'plays') return Number(b.dataset.plays || 0) - Number(a.dataset.plays || 0);
        if (state.sort === 'lines') return Number(b.dataset.lines || 0) - Number(a.dataset.lines || 0);
        if (state.sort === 'record') {
          return (a.dataset.date || '9999-99-99').localeCompare(b.dataset.date || '9999-99-99')
            || Number(a.dataset.track || 999) - Number(b.dataset.track || 999)
            || (a.dataset.title || '').localeCompare(b.dataset.title || '');
        }
        return (a.dataset.title || '').localeCompare(b.dataset.title || '');
      });
      sorted.forEach((row, index) => {
        tbody.appendChild(row);
        const idx = row.querySelector('.idx');
        if (idx) idx.textContent = String(index + 1).padStart(3, '0');
      });
    };

    const apply = () => {
      let matches = 0;
      rows.forEach((row) => {
        const record = row.dataset.record || '';
        const letter = row.dataset.l || '';
        const search = row.dataset.search || '';
        const ok =
          (state.record === 'all' || record === state.record)
          && (state.letter === 'all' || letter === state.letter)
          && (!state.search || search.includes(state.search));
        row.style.display = ok ? '' : 'none';
        if (ok) matches++;
      });
      if (counter) counter.textContent = `${matches} song${matches === 1 ? '' : 's'}`;
      if (empty) empty.hidden = matches > 0;
    };

    document.querySelectorAll<HTMLSelectElement>('[data-filter-select]').forEach((select) => {
      const key = select.getAttribute('data-filter-select') || '';
      select.addEventListener('change', () => {
        state[key] = select.value || 'all';
        if (key === 'sort') sortRows();
        apply();
      });
    });

    const search = document.querySelector<HTMLInputElement>('[data-filter-search]');
    if (search) search.addEventListener('input', () => {
      state.search = search.value.trim().toLowerCase();
      apply();
    });

    const chips = document.querySelectorAll<HTMLElement>('[data-letter-filters] .l-chip');
    chips.forEach((chip) => chip.addEventListener('click', () => {
      state.letter = chip.getAttribute('data-l') || 'all';
      chips.forEach((item) => {
        const active = item === chip;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
      apply();
    }));

    sortRows();
    apply();
  }
  wire();
  document.addEventListener('astro:page-load', wire);
</script>

<style>
  .lyrics-feature {
    padding: clamp(24px, 4vw, 52px) 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .lyrics-feature__grid {
    display: grid;
    grid-template-columns: minmax(240px, 380px) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
  }
  .lyrics-feature__art {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border: 1px solid var(--rule);
    background: var(--bg-2);
    color: inherit;
    text-decoration: none;
  }
  .lyrics-feature__art img,
  .lyrics-feature__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(.94) contrast(1.04);
    transition: transform .6s ease;
  }
  .lyrics-feature__art:hover img { transform: scale(1.03); }
  .lyrics-feature__kind {
    color: var(--accent-3);
    letter-spacing: .22em;
  }
  :root[data-theme='papers'] .lyrics-feature__kind { color: var(--accent); }
  .lyrics-feature__body {
    display: flex;
    flex-direction: column;
    gap: clamp(12px, 1.6vw, 20px);
    min-width: 0;
  }
  .lyrics-feature__quote {
    margin: 0;
    max-width: 12ch;
    color: var(--ink);
    font-family: var(--f-display);
    font-style: italic;
    font-size: clamp(42px, 6.2vw, 92px);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: .98;
    text-wrap: balance;
  }
  .lyrics-feature__mark {
    color: var(--accent-3);
    font-family: var(--f-display);
  }
  :root[data-theme='papers'] .lyrics-feature__mark { color: var(--accent); }
  .lyrics-feature__song {
    width: fit-content;
    border: 0;
    margin: 0;
    color: var(--ink);
    font-size: clamp(24px, 3vw, 36px);
    line-height: 1.05;
  }
  .lyrics-feature__song:hover { color: var(--accent-3); }
  :root[data-theme='papers'] .lyrics-feature__song:hover { color: var(--accent); }
  .lyrics-letters {
    gap: 6px;
    flex-wrap: wrap;
    margin-top: clamp(16px, 2vw, 24px);
  }
  .lyric-title {
    display: inline-block;
    border: 0;
    font-size: 19px;
    line-height: 1.25;
  }
  .lyric-record { color: var(--ink-2); }
  .lyric-sub {
    margin-top: .3rem;
    letter-spacing: .16em;
  }
  .lyrics-empty {
    padding-top: 1rem;
  }
  @media (max-width: 860px) {
    .lyrics-feature__grid { grid-template-columns: 1fr; }
    .lyrics-feature__art { max-width: 420px; }
  }
  @media (max-width: 560px) {
    .lyrics-feature__quote { max-width: none; font-size: clamp(36px, 12vw, 58px); }
  }
</style>
