---
import Layout from '../layouts/Layout.astro';
import IssueSection from '../components/ui/IssueSection.astro';
import Crumbs from '../components/ui/Crumbs.astro';
import Select from '../components/ui/Select.astro';
import { listSongs, listAlbums } from '../lib/directus';

const [songs, albums] = await Promise.all([listSongs(), listAlbums()]);
const albumsById = Object.fromEntries(albums.map((a) => [a.id, a]));

const totalPlays = songs.reduce((n, s) => n + (s.times_played_live || 0), 0);
const played = songs.filter((s) => (s.times_played_live || 0) > 0).length;
const albumOptions = Array.from(new Set(songs.map((s) => s.album).filter(Boolean)))
  .map((id) => albumsById[id as any])
  .filter(Boolean)
  .sort((a: any, b: any) => (a.release_date || '').localeCompare(b.release_date || ''));

const facts: Array<[string, string]> = [
  ['Songs on file', String(songs.length)],
  ['Played live', String(played)],
  ['Total live plays', totalPlays.toLocaleString()],
  ['Linked records', String(albumOptions.length)],
];
---
<Layout title="Songs · Cureation">
  <div class="container" style="padding-top: clamp(24px, 3vw, 40px);">
    <Crumbs items={[{ label: 'Home', href: '/' }, { label: 'Songs' }]} />
    <div class="stack" style="--gap: 1rem; margin-top: 1rem;">
      <div class="mono-sm muted">SECTION · SONGS</div>
      <h1 class="serif" style="font-size: clamp(48px, 7.5vw, 96px); line-height:.95; font-style: italic; margin: 0;">Songs</h1>
      <p class="deck" style="max-width: 62ch;">Every documented composition in the catalogue — with live-play counts, album links, and annotations.</p>
      <div class="facts">
        {facts.map(([k, v]) => (
          <div class="facts__item">
            <div class="facts__k">{k}</div>
            <div class="facts__v">{v}</div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <section class="container" style="padding: clamp(24px, 3vw, 32px) 0; border-top: 1px solid var(--rule);">
    <div class="filter-grid">
      <Select
        name="album"
        label="Record"
        options={[{ value: 'all', label: 'All records' }, ...albumOptions.map((a: any) => ({ value: String(a.id), label: a.title }))]}
      />
      <Select
        name="live"
        label="Live status"
        options={[
          { value: 'all', label: 'Any' },
          { value: 'played', label: 'Played live' },
          { value: 'unplayed', label: 'Never played' },
          { value: 'rare', label: 'Fewer than 10' },
          { value: 'common', label: '100+ plays' },
        ]}
      />
      <Select
        name="sort"
        label="Sort"
        value="title"
        options={[
          { value: 'title', label: 'A–Z' },
          { value: 'plays', label: 'Most played' },
          { value: 'date', label: 'Chronological' },
        ]}
      />
      <label class="select">
        <span class="select__label">Search</span>
        <span class="select__wrap">
          <input class="filter-search" type="search" placeholder="Title…" data-filter-search />
        </span>
      </label>
    </div>
  </section>

  <IssueSection kicker={`${songs.length} songs`} title="Catalogue" meta="Filtered">
    <div class="mono-sm muted" data-match-count style="margin-bottom:.8rem;">{songs.length} songs</div>
    <div class="table-wrap">
    <table class="data data--airy" data-songs-table>
      <thead><tr><th style="width:50px;">№</th><th>Title</th><th>Record</th><th class="num" style="text-align:right; width:80px;">Length</th><th class="num" style="text-align:right; width:100px;">Plays</th></tr></thead>
      <tbody>
        {songs.map((s, i) => {
          const album = s.album ? albumsById[s.album] : null;
          const plays = s.times_played_live || 0;
          const search = `${s.title || ''}`.toLowerCase();
          return (
            <tr data-clickable
                data-album={s.album || ''}
                data-plays={plays}
                data-date={album?.release_date || ''}
                data-title={(s.title || '').toLowerCase()}
                data-search={search}
                onclick={s.slug ? `location.href='/songs/${s.slug}'` : undefined}>
              <td class="idx">{String(i + 1).padStart(3, '0')}</td>
              <td><span class="serif" style="font-size:19px; font-style:italic; line-height:1.3;">{s.title}</span></td>
              <td class="mono-sm" style="color: var(--ink-2);">{album?.title || '—'}</td>
              <td class="num">{s.duration || '—'}</td>
              <td class="num" style="color: var(--accent-3);">{plays.toLocaleString()}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
    </div>
  </IssueSection>
</Layout>

<script>
  function wire() {
    const state: Record<string, string> = { album: 'all', live: 'all', sort: 'title', search: '' };
    const tbody = document.querySelector<HTMLElement>('[data-songs-table] tbody');
    const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-songs-table] tbody tr'));
    const counter = document.querySelector<HTMLElement>('[data-match-count]');
    if (!tbody) return;
    const sortRows = () => {
      const sorted = [...rows].sort((a, b) => {
        if (state.sort === 'plays') return Number(b.getAttribute('data-plays') || 0) - Number(a.getAttribute('data-plays') || 0);
        if (state.sort === 'date') return (a.getAttribute('data-date') || '').localeCompare(b.getAttribute('data-date') || '');
        return (a.getAttribute('data-title') || '').localeCompare(b.getAttribute('data-title') || '');
      });
      sorted.forEach((r, i) => {
        tbody.appendChild(r);
        const idx = r.querySelector('.idx');
        if (idx) idx.textContent = String(i + 1).padStart(3, '0');
      });
    };
    const apply = () => {
      let m = 0;
      rows.forEach((r) => {
        const a = r.getAttribute('data-album') || '';
        const p = Number(r.getAttribute('data-plays') || 0);
        const s = r.getAttribute('data-search') || '';
        const liveOk =
          state.live === 'all' ? true :
          state.live === 'played' ? p > 0 :
          state.live === 'unplayed' ? p === 0 :
          state.live === 'rare' ? p > 0 && p < 10 :
          state.live === 'common' ? p >= 100 : true;
        const ok = (state.album === 'all' || a === state.album) && liveOk && (!state.search || s.includes(state.search));
        r.style.display = ok ? '' : 'none';
        if (ok) m++;
      });
      if (counter) counter.textContent = `${m} songs`;
    };
    document.querySelectorAll<HTMLSelectElement>('[data-filter-select]').forEach((sel) => {
      const key = sel.getAttribute('data-filter-select') || '';
      sel.addEventListener('change', () => {
        state[key] = sel.value || 'all';
        if (key === 'sort') sortRows();
        apply();
      });
    });
    const search = document.querySelector<HTMLInputElement>('[data-filter-search]');
    if (search) search.addEventListener('input', () => { state.search = search.value.trim().toLowerCase(); apply(); });
    sortRows();
    apply();
  }
  wire();
  document.addEventListener('astro:page-load', wire);
</script>
