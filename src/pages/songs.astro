---
import { editable, copyText, copyAttr, copySource } from '../lib/visual-editing';
import Layout from '../layouts/Layout.astro';
import IssueSection from '../components/ui/IssueSection.astro';
import PageHero from '../components/ui/PageHero.astro';
import Select from '../components/ui/Select.astro';
import SearchField from '../components/ui/SearchField.astro';
import Pagination from '../components/ui/Pagination.astro';
import { listSongs, listAlbums } from '../lib/directus';

const [songs, albums] = await Promise.all([listSongs(), listAlbums()]);
const albumsById = Object.fromEntries(albums.map((a) => [a.id, a]));

const albumOptions = Array.from(new Set(songs.map((s) => s.album).filter(Boolean)))
  .map((id) => albumsById[id as any])
  .filter(Boolean)
  .sort((a: any, b: any) => (a.release_date || '').localeCompare(b.release_date || ''));

---
<Layout title="Songs · Cureation">
  <PageHero copyKeys={{"section":"pages_songs_8e591aea1e5f","title":"pages_songs_e9aa20e0c225","deck":"pages_songs_22db01c5a6c8"}}
    section={copyText("pages_songs_8e591aea1e5f", "Songs")}
    title={copyText("pages_songs_e9aa20e0c225", "Songs")}
    crumbs={[{ ...copySource({"label":"pages_songs_data-b7ba4b6af012"}),  label: copyText("pages_songs_data-b7ba4b6af012", "Home"), href: '/' }, { ...copySource({"label":"pages_songs_data-67f0772bf363"}),  label: copyText("pages_songs_data-67f0772bf363", "Songs") }]}
    flush
  />

  <IssueSection title="Songs" hideHeader>
    <div class="table-controls" aria-label="Song table filters">
      <div class="table-controls__grid table-controls__grid--4">
        <Select
          name="album"
          label="Album"
          options={[{ value: 'all', label: 'All records' }, ...albumOptions.map((a: any) => ({ value: String(a.id), label: a.title }))]}
        />
        <Select
          name="live"
          label="Live status"
          options={[
            { value: 'all', label: 'Any' },
            { value: 'played', label: 'Played live' },
            { value: 'unplayed', label: 'Never played' },
            { value: 'rare', label: 'Fewer than 10' },
            { value: 'common', label: '100+ plays' },
          ]}
        />
        <Select
          name="sort"
          label="Sort"
          value="title"
          options={[
            { value: 'title', label: 'A-Z' },
            { value: 'plays', label: 'Most played' },
            { value: 'date', label: 'Chronological' },
          ]}
        />
        <SearchField placeholder="Title..." />
      </div>
    </div>
    <div class="table-results-bar">
      <span data-match-count>{songs.length} songs</span>
      <span data-page-range aria-live="polite"></span>
    </div>
    <div class="table-wrap">
    <table class="data" data-songs-table>
      <thead><tr><th data-directus={copyAttr("pages_songs_84500ecdd40a")} set:html={copyText("pages_songs_84500ecdd40a", "Title")}></th><th data-directus={copyAttr("pages_songs_f115d11475fd")} set:html={copyText("pages_songs_f115d11475fd", "Album")}></th><th data-directus={copyAttr("pages_songs_bf34443a70ef")} set:html={copyText("pages_songs_bf34443a70ef", "Length")} class="num" style="text-align:right; width:80px;"></th><th data-directus={copyAttr("pages_songs_f89e673bb9f1")} set:html={copyText("pages_songs_f89e673bb9f1", "Plays")} class="num" style="text-align:right; width:100px;"></th></tr></thead>
      <tbody>
        {songs.map((s) => {
          const album = s.album ? albumsById[s.album] : null;
          const plays = s.times_played_live || 0;
          const search = `${s.title || ''}`.toLowerCase();
          return (
            <tr data-clickable
                data-album={s.album || ''}
                data-plays={plays}
                data-date={album?.release_date || ''}
                data-title={(s.title || '').toLowerCase()}
                data-search={search}
                data-row-href={s.slug ? `/songs/${s.slug}` : undefined}>
              <td><a data-directus={editable(s, ["title"])} href={s.slug ? `/songs/${s.slug}` : undefined}>{s.title}</a></td>
              <td data-directus={editable(album, ["title"])} class="mono-sm" style="color: var(--ink-2);">{album?.title || '–'}</td>
              <td data-directus={editable(s, ["duration"])} class="num">{s.duration || '–'}</td>
              <td class="num" style="color: var(--accent-3);">{plays.toLocaleString()}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
    </div>
    <Pagination label="Song catalogue pages" />
  </IssueSection>
</Layout>

<script>
  import { createTablePager } from '../lib/client-pagination';

  function wire() {
    const state: Record<string, string> = { album: 'all', live: 'all', sort: 'title', search: '' };
    const table = document.querySelector<HTMLElement>('[data-songs-table]');
    if (!table || table.dataset.filtersWired === 'true') return;
    table.dataset.filtersWired = 'true';
    const root = table.closest<HTMLElement>('.issue-section');
    const tbody = table.querySelector<HTMLElement>('tbody');
    const rows = Array.from(table.querySelectorAll<HTMLElement>('tbody tr'));
    if (!root || !tbody) return;
    const counter = root.querySelector<HTMLElement>('[data-match-count]');
    const pager = createTablePager(root, rows, { pageSize: 50 });
    let orderedRows = [...rows];
    const sortRows = () => {
      orderedRows = [...rows].sort((a, b) => {
        if (state.sort === 'plays') return Number(b.getAttribute('data-plays') || 0) - Number(a.getAttribute('data-plays') || 0);
        if (state.sort === 'date') return (a.getAttribute('data-date') || '').localeCompare(b.getAttribute('data-date') || '');
        return (a.getAttribute('data-title') || '').localeCompare(b.getAttribute('data-title') || '');
      });
      orderedRows.forEach((r) => {
        tbody.appendChild(r);
      });
    };
    const apply = (resetPage = false) => {
      const matches = orderedRows.filter((r) => {
        const a = r.getAttribute('data-album') || '';
        const p = Number(r.getAttribute('data-plays') || 0);
        const s = r.getAttribute('data-search') || '';
        const liveOk =
          state.live === 'all' ? true :
          state.live === 'played' ? p > 0 :
          state.live === 'unplayed' ? p === 0 :
          state.live === 'rare' ? p > 0 && p < 10 :
          state.live === 'common' ? p >= 100 : true;
        return (state.album === 'all' || a === state.album) && liveOk && (!state.search || s.includes(state.search));
      });
      pager.render(matches, { reset: resetPage });
      if (counter) counter.textContent = `${matches.length} song${matches.length === 1 ? '' : 's'}`;
    };
    root.querySelectorAll<HTMLSelectElement>('[data-filter-select]').forEach((sel) => {
      const key = sel.getAttribute('data-filter-select') || '';
      sel.addEventListener('change', () => {
        state[key] = sel.value || 'all';
        if (key === 'sort') sortRows();
        apply(true);
      });
    });
    const search = root.querySelector<HTMLInputElement>('[data-filter-search]');
    if (search) search.addEventListener('input', () => { state.search = search.value.trim().toLowerCase(); apply(true); });
    sortRows();
    apply();
  }
  wire();
  document.addEventListener('astro:page-load', wire);
</script>
