---
import MainLayout from '../../layouts/MainLayout.astro';
import PageFilter from '../../components/PageFilter.astro';
import { fetchAlbums, formatAlbum, fetchSingles, formatSingle } from '../../lib/directus';

const albums = await fetchAlbums();
const singles = await fetchSingles();

const formattedAlbums = albums.map(formatAlbum).sort((a, b) => {
  if (!a.year) return 1;
  if (!b.year) return -1;
  return parseInt(a.year) - parseInt(b.year);
});

// Singles with chart data
const singlesWithCharts = singles
  .filter(s => s.chart_position && s.chart_position.length > 0)
  .map(s => ({
    ...formatSingle(s),
    albumId: s.album,
    albumTitle: albums.find(a => a.id === s.album)?.title || 'Unknown',
  }))
  .sort((a, b) => {
    const bestA = Math.min(...a.chartPositions.map(p => p.chart_position));
    const bestB = Math.min(...b.chartPositions.map(p => p.chart_position));
    return bestA - bestB;
  });

// Studio albums timeline
const studioAlbums = formattedAlbums.filter(a => a.type === 'studio');

// Chart positions by country
const countryCharts: Record<string, { title: string; position: number }[]> = {};
singlesWithCharts.forEach(single => {
  single.chartPositions.forEach(pos => {
    const country = pos.country || 'Unknown';
    if (!countryCharts[country]) countryCharts[country] = [];
    countryCharts[country].push({ title: single.title, position: pos.chart_position });
  });
});

const sortedCountries = Object.entries(countryCharts)
  .sort(([, a], [, b]) => b.length - a.length);

// Key stats
const ukNumberOnes = singlesWithCharts.filter(s =>
  s.chartPositions.some(p => p.country === 'UK' && p.chart_position === 1)
);
const top10Hits = singlesWithCharts.filter(s =>
  s.chartPositions.some(p => p.chart_position <= 10)
);

// Tab definitions
const tabs = [
  { id: 'singles', label: 'Singles', icon: 'M9 19V6l12-3v12M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3' },
  { id: 'albums', label: 'Albums', icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10' },
  { id: 'countries', label: 'By Country', icon: 'M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
];
---

<MainLayout
  title="Charts"
  description="The Cure's chart history — UK, US, and worldwide chart positions for singles and albums."
  showSidebar={false}
  pageClass="bg-black"
>
  <!-- Hero Section -->
  <section class="mb-10">
    <div class="glass-panel overflow-hidden relative">
      <div class="absolute -top-20 -left-20 w-64 h-64 rounded-full bg-white/[0.06] blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-10 -right-10 w-48 h-48 rounded-full bg-accent/[0.06] blur-2xl pointer-events-none"></div>

      <div class="relative p-8 md:p-12">
        <h1 class="font-display text-5xl md:text-6xl lg:text-7xl text-white mb-4 text-glow">
          Charts
        </h1>
        <p class="text-white/75 text-lg md:text-xl max-w-3xl leading-relaxed">
          The Cure's chart journey — from post-punk obscurity to global hit-makers.
        </p>

        <div class="flex flex-wrap gap-8 mt-8 pt-6 border-t border-white/[0.08]">
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-white text-glow">{singlesWithCharts.length}</span>
            <span class="text-white/85 text-base font-medium">Charting Singles</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-white text-glow">{ukNumberOnes.length}</span>
            <span class="text-white/85 text-base font-medium">UK #1 Singles</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-white text-glow">{top10Hits.length}</span>
            <span class="text-white/85 text-base font-medium">Top 10 Hits</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-white text-glow">{sortedCountries.length}</span>
            <span class="text-white/85 text-base font-medium">Countries Charted</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Search & Filters -->
  <section class="mb-8">
    <div class="mb-4">
      <PageFilter id="charts" placeholder="Search charts..." />
    </div>

    <!-- Tab Navigation -->
    <nav class="overflow-x-auto scrollbar-hide">
      <div class="flex gap-2 min-w-max pb-2">
      {tabs.map((tab, i) => (
        <button
          class={`type-tab flex items-center gap-2 px-4 py-2.5 rounded-sm text-sm font-medium transition-all whitespace-nowrap tracking-wide ${i === 0 ? 'active' : ''}`}
          data-tab={tab.id}
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d={tab.icon} />
          </svg>
          {tab.label}
        </button>
      ))}
    </div>
    </nav>
  </section>

  <!-- Singles Panel -->
  <section id="panel-singles" class="tab-panel mb-12">
    <div class="glass-panel p-6 md:p-8">
      <h2 class="text-2xl text-white mb-6 section-header">Singles — Best Chart Positions</h2>
      {singlesWithCharts.length > 0 ? (
        <div class="space-y-3">
          {singlesWithCharts.map((single) => {
            const bestPosition = Math.min(...single.chartPositions.map(p => p.chart_position));
            return (
              <div class="flex items-center gap-4 p-4 rounded-lg bg-white/[0.03] hover:bg-white/[0.06] transition-colors" data-filter-item data-filter-text={`${single.title} ${single.albumTitle} ${single.releaseDate}`}>
                <div class={`w-12 h-12 rounded-lg flex items-center justify-center text-lg font-bold shrink-0 ${
                  bestPosition === 1 ? 'bg-yellow-500/20 text-yellow-400 ring-1 ring-yellow-500/30' :
                  bestPosition <= 5 ? 'bg-green-500/20 text-green-400' :
                  bestPosition <= 10 ? 'bg-blue-500/20 text-blue-400' :
                  bestPosition <= 20 ? 'bg-purple-500/20 text-purple-400' :
                  'bg-white/5 text-white/80'
                }`}>
                  #{bestPosition}
                </div>
                <div class="flex-1 min-w-0">
                  <h3 class="text-white font-medium truncate">{single.title}</h3>
                  <p class="text-white/80 text-xs mt-0.5">{single.releaseDate} · {single.albumTitle}</p>
                  <div class="flex flex-wrap gap-1.5 mt-2">
                    {single.chartPositions.map(pos => (
                      <span class={`text-xs px-2 py-0.5 rounded-full ${
                        pos.chart_position <= 5 ? 'bg-green-500/15 text-green-400 border border-green-500/20' :
                        pos.chart_position <= 10 ? 'bg-blue-500/15 text-blue-400 border border-blue-500/20' :
                        pos.chart_position <= 20 ? 'bg-purple-500/15 text-purple-400 border border-purple-500/20' :
                        'bg-white/5 text-white/80 border border-white/10'
                      }`}>
                        #{pos.chart_position} {pos.country}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      ) : (
        <div class="text-center py-12">
          <p class="text-white/80 text-lg mb-2">Chart data not yet available</p>
          <p class="text-white/75 text-sm">Chart positions will appear here once added to the database</p>
        </div>
      )}
    </div>
  </section>

  <!-- Albums Panel -->
  <section id="panel-albums" class="tab-panel mb-12 hidden">
    <div class="glass-panel p-6 md:p-8">
      <h2 class="text-2xl text-white mb-6 section-header">Studio Albums Timeline</h2>
      <div class="relative">
        <div class="absolute left-6 top-0 bottom-0 w-px bg-white/10"></div>
        <div class="space-y-6">
          {studioAlbums.map((album) => (
            <div class="flex gap-6 items-start relative" data-filter-item data-filter-text={`${album.title} ${album.year} ${album.releaseDate}`}>
              <div class="w-12 h-12 rounded-lg bg-white/10 border border-white/15 flex items-center justify-center shrink-0 z-10">
                <span class="text-primary font-bold text-sm">{album.year}</span>
              </div>
              <div class="glass-panel p-4 flex-1">
                <a href={`/discography/${album.slug}`} class="text-white font-medium hover:text-white transition-colors">
                  {album.title}
                </a>
                <p class="text-white/80 text-xs mt-1">{album.releaseDate} · {album.recordLabel}</p>
                {album.genreTags.length > 0 && (
                  <div class="flex flex-wrap gap-1 mt-2">
                    {album.genreTags.slice(0, 4).map(tag => (
                      <span class="text-xs px-2 py-0.5 rounded bg-white/5 text-white/80">{tag}</span>
                    ))}
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Countries Panel -->
  <section id="panel-countries" class="tab-panel mb-12 hidden">
    {sortedCountries.length > 0 ? (
      <div class="glass-panel p-6 md:p-8">
        <h2 class="text-2xl text-white mb-6 section-header">Chart Entries by Country</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {sortedCountries.map(([country, entries]) => (
            <div class="p-4 rounded-lg bg-white/[0.03]" data-filter-item data-filter-text={`${country} ${entries.map(e => e.title).join(' ')}`}>
              <div class="flex items-center justify-between mb-3">
                <h3 class="text-white font-medium">{country}</h3>
                <span class="text-primary font-bold">{entries.length} entries</span>
              </div>
              <div class="space-y-1">
                {entries.sort((a, b) => a.position - b.position).slice(0, 5).map(entry => (
                  <div class="flex items-center justify-between text-sm">
                    <span class="text-white/85 truncate">{entry.title}</span>
                    <span class={`shrink-0 ml-2 font-mono ${
                      entry.position <= 5 ? 'text-green-400' :
                      entry.position <= 10 ? 'text-blue-400' :
                      'text-white/80'
                    }`}>#{entry.position}</span>
                  </div>
                ))}
                {entries.length > 5 && (
                  <p class="text-white/75 text-xs mt-1">+{entries.length - 5} more</p>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    ) : (
      <div class="glass-panel p-12 text-center">
        <p class="text-white/80 text-lg mb-2">Country chart data not yet available</p>
        <p class="text-white/75 text-sm">Chart data by country will appear here once added</p>
      </div>
    )}
  </section>
</MainLayout>

<style>
  .type-tab {
    color: rgba(255, 255, 255, 0.45);
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }
  .type-tab:hover {
    color: rgba(255, 255, 255, 0.85);
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.1);
  }
  .type-tab.active {
    background: rgba(var(--color-primary-rgb, 137, 176, 201), 0.12);
    color: var(--color-primary);
    border-color: rgba(var(--color-primary-rgb, 137, 176, 201), 0.25);
  }

  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
  .scrollbar-hide::-webkit-scrollbar { display: none; }
</style>

<script is:inline>
  function initChartTabs() {
    const tabs = document.querySelectorAll('[data-tab]');
    const panels = document.querySelectorAll('.tab-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.tab;

        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');

        panels.forEach(panel => {
          panel.classList.toggle('hidden', panel.id !== `panel-${target}`);
        });
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initChartTabs);
  document.addEventListener('astro:page-load', initChartTabs);
</script>
