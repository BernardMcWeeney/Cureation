---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
---
<Layout title="Not found · Cureation">
  <section class="container" style="padding: clamp(60px, 10vw, 140px) 0; text-align: center;">
    <div class="kicker">Error 404</div>
    <h1 class="headline headline--xxl" style="margin: 1rem 0;">A missing page.</h1>
    <p class="deck" style="margin: 0 auto; max-width: 48ch;">
      This record isn't in the archive — either it hasn't been catalogued yet, or you've followed a dead link.
    </p>
    <div class="cluster" style="justify-content: center; margin-top: 2rem; gap: .6rem;">
      <Button href="/" variant="accent">Return home</Button>
      <Button href="/discography" variant="ghost">Browse discography</Button>
    </div>
  </section>
</Layout>
