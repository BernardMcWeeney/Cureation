---
import Layout from '../../layouts/Layout.astro';
import IssueSection from '../../components/ui/IssueSection.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Select from '../../components/ui/Select.astro';
import SearchField from '../../components/ui/SearchField.astro';
import { fetchRaw } from '../../lib/directus';

export const prerender = false;

const sources: any[] = await fetchRaw('sources', { limit: -1, sort: '-reliability,name' }).catch(() => []);

const sourceFilterParams = (coll: string, id: number) =>
  coll === 'setlists'
    ? { 'filter[source_id][_eq]': id }
    : { 'filter[source][_eq]': id };

const collectionCount = async (coll: string, id: number) => {
  try {
    const res: any[] = await fetchRaw(coll, { limit: -1, fields: 'id', ...sourceFilterParams(coll, id) });
    return res.length;
  } catch { return 0; }
};

const enriched = await Promise.all(sources.map(async (s) => {
  const [alb, sng, set, tur, mem, phs, nws, dyk, tml] = await Promise.all([
    collectionCount('discography', s.id),
    collectionCount('songs', s.id),
    collectionCount('setlists', s.id),
    collectionCount('tours', s.id),
    collectionCount('members', s.id),
    collectionCount('photos', s.id),
    collectionCount('news', s.id),
    collectionCount('did_you_know', s.id),
    collectionCount('timeline', s.id),
  ]);
  const total = alb + sng + set + tur + mem + phs + nws + dyk + tml;
  return { ...s, counts: { alb, sng, set, tur, mem, phs, nws, dyk, tml, total } };
}));

enriched.sort((a, b) => b.counts.total - a.counts.total);

const types = Array.from(new Set(sources.map((s) => s.type).filter(Boolean))).sort();
const totalRecords = enriched.reduce((n, e) => n + e.counts.total, 0);
---
<Layout title="Sources · Cureation">
  <PageHero
    section="Provenance"
    title="Sources"
    deck="Every claim traces back to something. This is the ledger of where the archive's facts came from — cited, counted, and ranked by reliability."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Sources' }]}
    facts={[
      { k: 'Sources on file', v: sources.length },
      { k: 'Records sourced', v: totalRecords.toLocaleString() },
      { k: 'Types', v: types.length },
      { k: 'Ranking', v: 'RELIABILITY' },
    ]}
    flush
  />

  <IssueSection kicker="Citations" title="The ledger" meta={`${enriched.length} sources`}>
    <div class="table-controls" aria-label="Sources table filters">
      <div class="table-controls__grid table-controls__grid--3">
        <Select
          name="type"
          label="Type"
          options={[{ value: 'all', label: 'All types' }, ...types.map((t) => ({ value: t!, label: String(t).toUpperCase() }))]}
        />
        <Select
          name="official"
          label="Status"
          options={[
            { value: 'all', label: 'Any status' },
            { value: 'yes', label: 'Official' },
            { value: 'no', label: 'Independent' },
          ]}
        />
        <SearchField placeholder="Name, author..." />
      </div>
    </div>
    <div class="table-results-bar">
      <span data-match-count>{enriched.length} sources</span>
    </div>
    <div class="table-wrap">
    <table class="data data--airy" data-sources-table>
      <thead><tr>
        <th style="width:50px;">№</th>
        <th>Source</th>
        <th>Type</th>
        <th>Author</th>
        <th class="num" style="text-align:right; width:90px;">Records</th>
        <th class="num" style="text-align:right; width:90px;">Reliability</th>
      </tr></thead>
      <tbody>
        {enriched.map((s, i) => (
          <tr data-clickable={s.url ? '' : undefined}
              data-type={s.type || ''}
              data-official={s.is_official ? 'yes' : 'no'}
              data-search={`${s.name || ''} ${s.author || ''} ${s.description || ''}`.toLowerCase()}
              onclick={s.url ? `window.open('${s.url}','_blank','noopener,noreferrer')` : undefined}>
            <td class="idx">{String(i + 1).padStart(2, '0')}</td>
            <td>
              <span class="serif" style="font-size:19px; font-style:italic; line-height:1.3;">{s.name}</span>
              {s.url && <span class="mono-sm" style="margin-left:.5rem; color: var(--accent-3);">↗</span>}
              {s.is_official && <span class="tag" style="margin-left:.5rem; font-size:9px; background: var(--accent-tint);">OFFICIAL</span>}
              {s.description && <div class="muted" style="font-family:var(--f-serif); font-size:14px; margin-top:.2rem; max-width: 60ch;">{s.description}</div>}
            </td>
            <td class="mono-sm muted">{(s.type || '—').toUpperCase()}</td>
            <td class="mono-sm muted">{s.author || '—'}</td>
            <td class="num" style="color: var(--accent-3);">{s.counts.total.toLocaleString()}</td>
            <td class="num">{s.reliability ?? '—'}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>
  </IssueSection>
</Layout>

<script>
  function wire() {
    const state: Record<string, string> = { type: 'all', official: 'all', search: '' };
    const table = document.querySelector<HTMLElement>('[data-sources-table]');
    if (!table || table.dataset.filtersWired === 'true') return;
    table.dataset.filtersWired = 'true';
    const rows = Array.from(table.querySelectorAll<HTMLElement>('tbody tr'));
    const counter = document.querySelector<HTMLElement>('[data-match-count]');
    const apply = () => {
      let m = 0;
      rows.forEach((r) => {
        const t = r.getAttribute('data-type') || '';
        const o = r.getAttribute('data-official') || '';
        const s = r.getAttribute('data-search') || '';
        const ok = (state.type === 'all' || t === state.type) &&
                   (state.official === 'all' || o === state.official) &&
                   (!state.search || s.includes(state.search));
        r.style.display = ok ? '' : 'none';
        if (ok) m++;
      });
      if (counter) counter.textContent = `${m} sources`;
    };
    document.querySelectorAll<HTMLSelectElement>('[data-filter-select]').forEach((sel) => {
      const key = sel.getAttribute('data-filter-select') || '';
      sel.addEventListener('change', () => { state[key] = sel.value || 'all'; apply(); });
    });
    const search = document.querySelector<HTMLInputElement>('[data-filter-search]');
    if (search) search.addEventListener('input', () => { state.search = search.value.trim().toLowerCase(); apply(); });
    apply();
  }
  wire();
  document.addEventListener('astro:page-load', wire);
</script>
