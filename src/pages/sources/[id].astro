---
import Layout from '../../layouts/Layout.astro';
import IssueSection from '../../components/ui/IssueSection.astro';
import Crumbs from '../../components/ui/Crumbs.astro';
import { fetchRaw } from '../../lib/directus';

export const prerender = false;

const { id } = Astro.params;
const sid = Number(id);
if (!sid) return Astro.redirect('/sources');

const [source]: any[] = await fetchRaw('sources', { limit: 1, filter: { id: { _eq: sid } } as any });
if (!source) return Astro.redirect('/sources');

const params = (coll: string, extra: Record<string, any> = {}) => ({
  limit: -1,
  filter: { source: { _eq: sid } } as any,
  ...extra,
});

const [albums, songs, setlists, tours, members, photos, news, albumPersonnel, dyk, timeline] = await Promise.all([
  fetchRaw('discography', { ...params('discography'), fields: 'id,title,slug,release_date,type', sort: '-release_date' }),
  fetchRaw('songs', { ...params('songs'), fields: 'id,title,slug,album', sort: 'title' }),
  fetchRaw('setlists', { ...params('setlists'), fields: 'id,slug,date,venue,city,country', sort: '-date' }),
  fetchRaw('tours', { ...params('tours'), fields: 'id,name,slug,start_date', sort: '-start_date' }),
  fetchRaw('members', { ...params('members'), fields: 'id,name,slug', sort: 'name' }),
  fetchRaw('photos', { ...params('photos'), fields: 'id,title,slug,date_taken', sort: '-date_taken' }),
  fetchRaw('news', { ...params('news'), fields: 'id,title,slug,published_date', sort: '-published_date' }),
  fetchRaw('album_personnel', { ...params('album_personnel'), fields: 'id,role,member_name,album_title', limit: -1 }).catch(() => []),
  fetchRaw('did_you_know', { ...params('did_you_know'), fields: 'id,title,content', limit: -1 }).catch(() => []),
  fetchRaw('timeline', { ...params('timeline'), fields: 'id,title,date,slug', sort: '-date' }).catch(() => []),
]);

const buckets: Array<[string, string, any[], (x: any) => string]> = [
  ['Records', '/discography', albums, (x) => `/discography/${x.slug}`],
  ['Songs', '/songs', songs, (x) => `/songs/${x.slug}`],
  ['Setlists', '/setlists', setlists, (x) => `/setlists/${x.slug}`],
  ['Tours', '/tours', tours, (x) => `/tours/${x.slug}`],
  ['Members', '/band', members, (x) => `/band/members/${x.slug}`],
  ['Photographs', '/photos', photos, (x) => `/photos/${x.slug || x.id}`],
  ['News', '/news', news, (x) => `/news/${x.slug}`],
  ['Album personnel', '/band', albumPersonnel, () => '#'],
  ['Did you know', '/curiosities', dyk, () => '#'],
  ['Timeline events', '/band/history', timeline, (x) => `/band/history#${x.slug || x.id}`],
];

const total = buckets.reduce((n, [, , arr]) => n + arr.length, 0);
---
<Layout title={`${source.name} · Sources · Cureation`}>
  <div class="container" style="padding-top: clamp(24px, 3vw, 40px);">
    <Crumbs items={[{ label: 'Home', href: '/' }, { label: 'Sources', href: '/sources' }, { label: source.name }]} />

    <section style="padding: clamp(20px, 3vw, 40px) 0;">
      <div class="mono-sm muted">SOURCE · {(source.type || '—').toUpperCase()}{source.is_official ? ' · OFFICIAL' : ''}</div>
      <h1 class="serif" style="font-size: clamp(44px, 7vw, 96px); line-height:.95; font-style: italic; margin: .4rem 0 .6rem;">{source.name}</h1>
      {source.description && <p class="deck" style="max-width: 62ch;">{source.description}</p>}
      <div class="facts" style="margin-top: 1rem;">
        <div class="facts__item"><div class="facts__k">Records drawn</div><div class="facts__v">{total.toLocaleString()}</div></div>
        <div class="facts__item"><div class="facts__k">Reliability</div><div class="facts__v">{source.reliability ?? '—'}</div></div>
        <div class="facts__item"><div class="facts__k">Author</div><div class="facts__v">{source.author || '—'}</div></div>
        <div class="facts__item"><div class="facts__k">Access</div><div class="facts__v">{source.url ? <a href={source.url} target="_blank" rel="noopener">Open →</a> : '—'}</div></div>
      </div>
    </section>
  </div>

  {buckets.filter(([, , arr]) => arr.length > 0).map(([label, href, arr, linker]) => (
    <IssueSection kicker={label} title={`${arr.length} ${label.toLowerCase()}`} href={href} meta="Sourced here">
      <table class="data data--airy">
        <thead><tr><th style="width:50px;">№</th><th>Title</th><th class="num" style="text-align:right; width:140px;">Date</th></tr></thead>
        <tbody>
          {arr.slice(0, 200).map((x: any, i: number) => (
            <tr data-clickable onclick={`location.href='${linker(x)}'`}>
              <td class="idx">{String(i + 1).padStart(2, '0')}</td>
              <td><span class="serif" style="font-size:18px; font-style:italic;">{x.title || x.name || x.venue || x.role || '—'}</span>
                {x.city && <span class="mono-sm muted" style="margin-left:.5rem;">{x.city}{x.country ? `, ${x.country}` : ''}</span>}
              </td>
              <td class="num mono-sm muted">{x.date || x.release_date || x.start_date || x.published_date || x.date_taken || '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </IssueSection>
  ))}
</Layout>
