---
// src/pages/lyrics/album.astro
import MainLayout from '../../layouts/MainLayout.astro';
import LyricsSidebar from '../../components/sidebar/LyricsSidebar.astro';

// Fetch albums data
const albumsResponse = await fetch('https://dash.cureation.net/items/discography');
const albumsData = await albumsResponse.json();

interface AlbumData {
  id: number;
  title: string;
  slug: string;
  coverImage: string;
  year: string;
  songIds: number[];
  songs?: SongData[];
}

interface SongData {
  id: number;
  title: string;
  duration: string;
  trackNumber: number;
  hasLyrics: boolean;
  slug: string;
}

const albums: AlbumData[] = albumsData.data.map((album: any) => ({
  id: album.id,
  title: album.title || 'Unknown Album',
  slug: album.slug || (album.title ? album.title.toLowerCase().replace(/[^\w\s]/gi, '').replace(/\s+/g, '-') : 'unknown-album'),
  coverImage: album.cover_art ? `https://dash.cureation.net/assets/${album.cover_art}` : '/images/placeholder-album.jpg',
  year: album.release_date ? new Date(album.release_date).getFullYear().toString() : '',
  songIds: album.songs || []
})).sort((a: AlbumData, b: AlbumData) => parseInt(b.year || '0') - parseInt(a.year || '0'));

// Fetch all songs
const songsResponse = await fetch('https://dash.cureation.net/items/songs');
const songsData = await songsResponse.json();
const songsMap: Record<number, SongData> = songsData.data
  .filter((song: any) => song.title)
  .reduce((acc: Record<number, SongData>, song: any) => {
    acc[song.id] = {
      id: song.id,
      title: song.title,
      duration: song.duration || '0:00',
      trackNumber: song.track_number,
      hasLyrics: !!song.lyrics,
      slug: song.title.toLowerCase().replace(/[^\w\s]/gi, '').replace(/\s+/g, '-')
    };
    return acc;
  }, {});

// Add songs to each album
albums.forEach((album: AlbumData) => {
  album.songs = album.songIds
    .map(id => songsMap[id])
    .filter((song): song is SongData => !!song)
    .sort((a, b) => a.trackNumber - b.trackNumber);
});

// Stats for the hero
const totalSongs = albums.reduce((sum, album) => sum + (album.songs?.length || 0), 0);
const albumsWithLyrics = albums.filter(album => album.songs?.some(song => song.hasLyrics)).length;
---

<MainLayout
  title="Lyrics by Album"
  description="Browse The Cure's lyrics organized by album - explore their musical journey through the decades."
  showSidebar={true}
  customSidebar={true}
  pageClass="bg-black"
>
<LyricsSidebar
  slot="sidebar"
  activeFilter="By Album"
  albums={albums.map(a => ({
    title: a.title,
    slug: a.slug,
    coverImage: a.coverImage,
    year: a.year
  }))}
/>

  <!-- Hero Section -->
  <section class="mb-12">
    <div class="glass-card-glow rounded-2xl overflow-hidden relative">
      <!-- Decorative gradient orbs -->
      <div class="absolute -top-20 -right-20 w-64 h-64 rounded-full bg-primary/20 blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-10 -left-10 w-40 h-40 rounded-full bg-accent/10 blur-2xl pointer-events-none"></div>

      <div class="relative p-8 md:p-12">
        <div class="flex items-center gap-3 mb-4">
          <span class="badge">Album Collection</span>
          <div class="divider-gradient flex-1 max-w-24"></div>
        </div>

        <h1 class="font-display text-6xl md:text-7xl lg:text-8xl text-white mb-4 text-glow">
          Browse by Album
        </h1>
        <p class="text-white/90 text-lg md:text-xl max-w-3xl leading-relaxed">
          Explore The Cure's discography and dive into the lyrics of your favorite albums. Each album showcases its complete tracklist with links to full lyrics.
        </p>

        <!-- Quick stats -->
        <div class="flex flex-wrap gap-8 mt-8 pt-6 border-t border-white/20">
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-primary text-glow">{albums.length}</span>
            <span class="text-white/80 text-base font-medium">Albums</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-primary text-glow">{totalSongs}</span>
            <span class="text-white/80 text-base font-medium">Total Songs</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-primary text-glow">{albumsWithLyrics}</span>
            <span class="text-white/80 text-base font-medium">With Lyrics</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Albums with Glassmorphic Backgrounds -->
  <section>
    <div class="space-y-16">
      {albums.map(album => (
        <div class="album-section" data-theme={album.slug}>
          <!-- Album card with art background -->
          <div class="album-glass-card rounded-2xl overflow-hidden mb-6">
            <!-- Background image layer -->
            <div class="album-bg-layer">
              <img
                src={album.coverImage}
                alt=""
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <div class="album-overlay-layer"></div>

            <!-- Content -->
            <div class="relative z-10 p-6 md:p-8">
              <div class="flex flex-col md:flex-row gap-6 md:gap-8 items-start">
                <!-- Album Cover -->
                <a href={`/discography/${album.slug}`} class="shrink-0 group">
                  <div class="w-40 md:w-48 aspect-square rounded-xl overflow-hidden ring-2 ring-white/20 group-hover:ring-primary/60 shadow-2xl transition-all duration-500">
                    <img
                      src={album.coverImage}
                      alt={`Album cover for ${album.title}`}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                  </div>
                </a>

                <!-- Album Info -->
                <div class="flex-1">
                  <span class="inline-block px-3 py-1 mb-3 text-sm font-medium rounded-full bg-primary/30 text-white border border-primary/40">{album.year}</span>
                  <a
                    href={`/discography/${album.slug}`}
                    class="block font-display text-4xl md:text-5xl text-white hover:text-primary transition-colors duration-300 mb-3 text-shadow-lg"
                  >
                    {album.title}
                  </a>
                  <p class="text-white/80 text-lg mb-4">{album.songs?.length || 0} tracks</p>

                  <a
                    href={`/discography/${album.slug}`}
                    class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-white/10 border border-white/20 text-white hover:bg-primary/20 hover:border-primary/40 transition-all duration-300"
                  >
                    <span>View Album Details</span>
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M5 12h14"></path>
                      <path d="m12 5 7 7-7 7"></path>
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- Album Tracks with Glassmorphism -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3 md:gap-4">
            {album.songs?.map(song => (
              <a
                href={`/lyrics/${song.slug}`}
                class="track-card group"
                style={`--track-bg: url(${album.coverImage})`}
              >
                <!-- Mini background -->
                <div class="absolute inset-0 z-0 overflow-hidden rounded-xl">
                  <div class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/50 to-black/30"></div>
                </div>

                <div class="relative z-10 p-4 flex items-center gap-4">
                  <!-- Track number -->
                  <div class="shrink-0 size-10 rounded-full bg-white/10 group-hover:bg-primary/30 flex items-center justify-center transition-all duration-300">
                    <span class="text-white/80 group-hover:text-white text-sm font-medium">{song.trackNumber}</span>
                  </div>

                  <!-- Song info -->
                  <div class="flex-1 min-w-0">
                    <h4 class="text-white font-semibold text-base truncate group-hover:text-primary transition-colors duration-300">{song.title}</h4>
                    <div class="flex items-center gap-2 mt-0.5">
                      <span class="text-white/60 text-sm">{song.duration}</span>
                      {song.hasLyrics && (
                        <span class="px-2 py-0.5 text-xs rounded-full bg-primary/30 text-primary border border-primary/40">Lyrics</span>
                      )}
                    </div>
                  </div>

                  <!-- Arrow -->
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-5 text-white/40 group-hover:text-primary group-hover:translate-x-1 transition-all duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14"></path>
                    <path d="m12 5 7 7-7 7"></path>
                  </svg>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</MainLayout>

<style>
  /* Album glass card with full art background */
  .album-glass-card {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .album-bg-layer {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .album-bg-layer img {
    filter: blur(20px) saturate(1.3);
    transform: scale(1.2);
    opacity: 0.5;
  }

  .album-overlay-layer {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(135deg, rgba(0, 0, 0, 0.85) 0%, rgba(0, 0, 0, 0.7) 50%, rgba(0, 0, 0, 0.6) 100%);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  /* Track card styling */
  .track-card {
    position: relative;
    overflow: hidden;
    border-radius: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .track-card:hover {
    border-color: rgba(var(--color-primary-rgb), 0.5);
    background: rgba(var(--color-primary-rgb), 0.1);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4),
                0 0 30px rgba(var(--color-primary-rgb), 0.15);
    transform: translateY(-2px);
  }

  .track-card:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* Text shadow for readability */
  .text-shadow-lg {
    text-shadow: 0 4px 8px rgba(0, 0, 0, 0.9),
                 0 2px 4px rgba(0, 0, 0, 0.8),
                 0 0 30px rgba(0, 0, 0, 0.7);
  }
</style>