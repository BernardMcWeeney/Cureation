---
// src/pages/lyrics/index.astro
import MainLayout from '../../layouts/MainLayout.astro';
import { ViewTransitions } from 'astro:transitions';

// Sidebar configuration
const sidebarItems = [
  { title: 'All Songs', path: '/lyrics' },
  { title: 'By Album', path: '/lyrics/album' },
  { title: 'Popular Songs', path: '/lyrics/popular' },
  { title: 'Search', path: '/lyrics/search' }
];

// Fetch albums data to link songs to their albums
const albumsResponse = await fetch('https://dash.cureation.net/items/discography');
const albumsData = await albumsResponse.json();
const albums = albumsData.data.reduce((acc, album) => {
  acc[album.id] = {
    title: album.title,
    slug: album.slug || album.title.toLowerCase().replace(/[^\w\s]/gi, '').replace(/\s+/g, '-'),
    cover_art: album.cover_art ? `https://dash.cureation.net/assets/${album.cover_art}` : '/images/placeholder-album.jpg',
    year: album.release_date ? new Date(album.release_date).getFullYear().toString() : ''
  };
  return acc;
}, {});

// Fetch all songs
const songsResponse = await fetch('https://dash.cureation.net/items/songs');
const songsData = await songsResponse.json();

// Format the songs data with album information
const songs = songsData.data.map(song => ({
  id: song.id,
  title: song.title,
  albumId: song.album,
  albumTitle: albums[song.album]?.title || 'Unknown Album',
  albumSlug: albums[song.album]?.slug || 'unknown',
  albumCover: albums[song.album]?.cover_art || '/images/placeholder-album.jpg',
  year: albums[song.album]?.year || '',
  duration: song.duration,
  hasLyrics: !!song.lyrics,
  lyrics: song.lyrics || '',
  slug: song.title.toLowerCase().replace(/[^\w\s]/gi, '').replace(/\s+/g, '-')
}));

// Get a random "Lyric of the Day" from songs with lyrics
const songsWithLyrics = songs.filter(song => song.hasLyrics);
const lyricOfTheDay = songsWithLyrics.length > 0 
  ? songsWithLyrics[Math.floor(Math.random() * songsWithLyrics.length)] 
  : null;

// Extract a short lyric snippet for display (first few lines, maximum 4)
let lyricSnippet = '';
if (lyricOfTheDay?.lyrics) {
  // Clean up the lyrics - remove section headers in brackets
  const cleanLyrics = lyricOfTheDay.lyrics.replace(/\[.*?\]/g, '').trim();
  
  // Get the first few lines (max 4 lines)
  const lines = cleanLyrics.split('\n').filter(line => line.trim() !== '');
  lyricSnippet = lines.slice(0, 4).join('\n');
  
  // Add ellipsis if we're truncating
  if (lines.length > 4) {
    lyricSnippet += '...';
  }
}

// Group songs by decade for a nice timeline display
const songsByDecade = songs.reduce((acc, song) => {
  if (!song.year) return acc;
  
  const decade = `${song.year.slice(0, 3)}0s`;
  if (!acc[decade]) acc[decade] = [];
  acc[decade].push(song);
  return acc;
}, {});

// Sort decades chronologically
const sortedDecades = Object.keys(songsByDecade).sort();
---

<MainLayout
  title="Song Lyrics"
  description="Explore The Cure's lyrics - find your favorite songs and discover the poetry behind the music."
  showSidebar={true}
  sidebarActiveItem="All Songs"
  sidebarItems={sidebarItems}
  pageClass="bg-black"
>
  <ViewTransitions />
  
  <!-- Hero Section -->
  <section class="mb-12">
    <div class="glass-card rounded-xl overflow-hidden border border-white/20">
      <div class="p-6 md:p-8">
        <h1 class="font-display text-5xl md:text-6xl text-white mb-4">The Cure Lyrics</h1>
        <p class="text-white/80 max-w-3xl mb-6">
          Discover the poetic genius behind The Cure's catalog - from early post-punk to atmospheric gothic rock and beyond.
        </p>
        
        <!-- Simple search form that redirects to the search page -->
        <form action="/lyrics/search" method="get" class="relative max-w-lg">
          <input 
            type="text" 
            name="q"
            placeholder="Search for lyrics or songs..." 
            class="w-full py-3 px-4 pl-10 rounded-lg backdrop-blur-md bg-black/20 border border-white/20 text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary/50"
          />
          <svg xmlns="http://www.w3.org/2000/svg" class="size-5 text-white/60 absolute left-3 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <button 
            type="submit" 
            class="absolute right-3 top-1/2 -translate-y-1/2 px-4 py-2 rounded-lg backdrop-blur-md bg-primary/20 border border-primary/30 text-white hover:bg-primary/30 transition-colors duration-300"
          >
            Search
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- Featured: Lyric of the Day - Full Album Art Background -->
  {lyricOfTheDay && (
    <section class="mb-12">
      <h2 class="font-display text-3xl text-primary mb-6">Lyric of the Day</h2>
      <div class="glass-card rounded-xl border border-white/20 overflow-hidden">
        <div class="relative h-auto min-h-80">
          <!-- Album art as background -->
          <div class="absolute inset-0 z-0">
            <img 
              src={lyricOfTheDay.albumCover} 
              alt={`Album cover for ${lyricOfTheDay.albumTitle}`} 
              class="w-full h-full object-cover"
            />
            <!-- Gradient overlay for readability -->
            <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/70 to-black/50"></div>
          </div>
          
          <!-- Content overlay -->
          <div class="relative z-10 p-6 md:p-8 backdrop-blur-sm">
            <div class="md:max-w-2xl">
              <div class="flex flex-col md:flex-row md:items-center gap-4 mb-6">
                <div class="size-20 md:size-24 flex-shrink-0 bg-black/30 p-1 rounded-lg">
                  <img 
                    src={lyricOfTheDay.albumCover} 
                    alt={`Album cover for ${lyricOfTheDay.albumTitle}`} 
                    class="size-full object-cover rounded"
                  />
                </div>
                <div>
                  <p class="text-white/70 text-sm">{lyricOfTheDay.albumTitle}, {lyricOfTheDay.year}</p>
                  <h3 class="font-display text-4xl md:text-5xl text-white mb-1">{lyricOfTheDay.title}</h3>
                </div>
              </div>
              
              {lyricSnippet && (
                <div class="my-6">
                  <p class="italic text-white/90 text-lg font-medium leading-relaxed whitespace-pre-line text-shadow-lg">
                    "{lyricSnippet}"
                  </p>
                </div>
              )}
              
              <a href={`/lyrics/${lyricOfTheDay.slug}`} class="mt-4 inline-flex items-center gap-2 px-6 py-3 rounded-lg backdrop-blur-md bg-primary/20 border border-primary/30 text-white hover:bg-primary/30 transition-colors duration-300">
                <span>View Full Lyrics</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14"></path>
                  <path d="m12 5 7 7-7 7"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Timeline/Decades View -->
  <section>
    <h2 class="font-display text-3xl text-primary mb-6">All Songs</h2>
    <div class="space-y-8">
      {sortedDecades.map(decade => (
        <div class="mb-8">
          <div class="flex items-center gap-4 mb-4">
            <h3 class="font-heading text-2xl text-white">{decade}</h3>
            <div class="flex-grow h-px bg-white/20"></div>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {songsByDecade[decade].map(song => (
              <a href={`/lyrics/${song.slug}`} class="glass-card rounded-lg p-4 border border-white/20 hover:border-white/30 backdrop-blur-md bg-black/20 hover:bg-black/30 transition-all duration-300 hover-lift">
                <div class="flex items-center gap-3">
                  <div class="size-12 flex-shrink-0">
                    <img 
                      src={song.albumCover} 
                      alt={`Album art for ${song.albumTitle}`}
                      class="size-full object-cover rounded-md"
                      loading="lazy"
                    />
                  </div>
                  <div>
                    <h4 class="text-white font-medium">{song.title}</h4>
                    <p class="text-white/60 text-sm">{song.albumTitle} ({song.year})</p>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</MainLayout>

<style>
  /* Lift effect on hover */
  .hover-lift {
    transition: transform 0.3s var(--ease-out);
  }
  
  .hover-lift:hover {
    transform: translateY(-4px);
  }
  
  /* Text shadow for better readability against album art */
  .text-shadow-lg {
    text-shadow: 
      0 4px 8px rgba(0, 0, 0, 0.75),
      0 0 30px rgba(0, 0, 0, 0.6);
  }
  
  /* Minimum height for lyric of day container */
  .min-h-80 {
    min-height: 20rem;
  }
</style>