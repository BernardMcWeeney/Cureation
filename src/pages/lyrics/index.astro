---
// src/pages/lyrics/index.astro
import MainLayout from '../../layouts/MainLayout.astro';
import LyricsSidebar from '../../components/sidebar/LyricsSidebar.astro';
import PageFilter from '../../components/PageFilter.astro';
import { ViewTransitions } from 'astro:transitions';
import { createSongSlug } from '../../lib/lyrics-helpers';

const DIRECTUS_URL = 'https://dash.cureation.net';

// Fetch albums data to link songs to their albums
const albumsResponse = await fetch(
  `${DIRECTUS_URL}/items/discography?limit=-1&fields=id,title,cover_art,release_date`
);
const albumsData = await albumsResponse.json();
const albums = (albumsData.data || []).reduce((acc: Record<string, any>, album: any) => {
  const albumKey = String(album.id);
  acc[albumKey] = {
    title: album.title || 'Unknown Album',
    slug: createSongSlug(album.title || 'unknown-album'),
    cover_art: album.cover_art ? `${DIRECTUS_URL}/assets/${album.cover_art}` : '/images/placeholder-album.jpg',
    year: album.release_date ? new Date(album.release_date).getFullYear().toString() : ''
  };
  return acc;
}, {});

// Fetch all songs
const songsResponse = await fetch(
  `${DIRECTUS_URL}/items/songs?limit=-1&fields=id,title,album,duration,lyrics`
);
const songsData = await songsResponse.json();

// Format the songs data with album information - filter out songs without titles
const songs = (songsData.data || [])
  .filter(song => song.title) // Only include songs that have titles
  .map(song => {
    const albumId = typeof song.album === 'object' && song.album ? song.album.id : song.album;
    const albumKey = albumId != null ? String(albumId) : '';
    return {
      id: song.id,
      title: song.title,
      albumId,
      albumTitle: albums[albumKey]?.title || 'Unknown Album',
      albumSlug: albums[albumKey]?.slug || 'unknown-album',
      albumCover: albums[albumKey]?.cover_art || '/images/placeholder-album.jpg',
      year: albums[albumKey]?.year || '',
      duration: song.duration || '0:00',
      hasLyrics: !!song.lyrics,
      lyrics: song.lyrics || '',
      slug: createSongSlug(song.title)
    };
  });

// Get a deterministic "Lyric of the Day" based on the current date
const songsWithLyrics = songs.filter((song: any) => song.hasLyrics);
function getSongOfTheDay() {
  if (songsWithLyrics.length === 0) return null;
  const today = new Date();
  const seed = today.getFullYear() * 10000 + (today.getMonth() + 1) * 100 + today.getDate();
  const index = seed % songsWithLyrics.length;
  return songsWithLyrics[index];
}
const lyricOfTheDay = getSongOfTheDay();

// Extract a short lyric snippet for display (first few lines, maximum 4)
let lyricSnippet = '';
if (lyricOfTheDay?.lyrics) {
  // Clean up the lyrics - remove section headers in brackets
  const cleanLyrics = lyricOfTheDay.lyrics.replace(/\[.*?\]/g, '').trim();
  
  // Get the first few lines (max 4 lines)
  const lines = cleanLyrics.split('\n').filter(line => line.trim() !== '');
  lyricSnippet = lines.slice(0, 4).join('\n');
  
  // Add ellipsis if we're truncating
  if (lines.length > 4) {
    lyricSnippet += '...';
  }
}

// Group songs by decade for a nice timeline display
const songsByDecade = songs.reduce((acc, song) => {
  const decade = song.year ? `${song.year.slice(0, 3)}0s` : 'Unknown';
  if (!acc[decade]) acc[decade] = [];
  acc[decade].push(song);
  return acc;
}, {});

// Sort decades chronologically
const sortedDecades = Object.keys(songsByDecade).sort((a, b) => {
  if (a === 'Unknown') return 1;
  if (b === 'Unknown') return -1;
  return parseInt(a, 10) - parseInt(b, 10);
});
---

<MainLayout
  title="Song Lyrics"
  description="Explore The Cure's lyrics - find your favorite songs and discover the poetry behind the music."
  showSidebar={true}
  customSidebar={true}
  pageClass="bg-black"
>
<LyricsSidebar
  slot="sidebar"
  activeFilter="All Songs"
  albums={Object.values(albums).map((a: any) => ({
    title: a.title,
    slug: a.slug,
    coverImage: a.cover_art,
    year: a.year
  })).sort((a: any, b: any) => parseInt(b.year || '0', 10) - parseInt(a.year || '0', 10))}
/>
  <ViewTransitions />

  <!-- Hero Section (full width, in hero slot) -->
  <section class="mb-10" slot="hero">
    <div class="glass-panel overflow-hidden relative">
      <div class="absolute -top-20 -left-20 w-64 h-64 rounded-full bg-primary/10 blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-10 -right-10 w-48 h-48 rounded-full bg-accent/[0.06] blur-2xl pointer-events-none"></div>

      <div class="relative p-8 md:p-12">
        <h1 class="font-display text-5xl md:text-6xl lg:text-7xl text-white mb-4 text-glow">
          Lyrics
        </h1>
        <p class="text-white/75 text-lg md:text-xl max-w-3xl leading-relaxed">
          Discover the poetic genius behind The Cure's catalog — from early post-punk to atmospheric gothic rock and beyond.
        </p>

        <div class="flex flex-wrap gap-8 mt-8 pt-6 border-t border-white/[0.08]">
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-primary text-glow">{songs.length}</span>
            <span class="text-white/60 text-base font-medium">Songs</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-primary text-glow">{songsWithLyrics.length}</span>
            <span class="text-white/60 text-base font-medium">With Lyrics</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-primary text-glow">{Object.keys(albums).length}</span>
            <span class="text-white/60 text-base font-medium">Albums</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Search & Filters -->
  <section class="mb-8" slot="hero">
    <div class="mb-4">
      <PageFilter id="lyrics" placeholder="Search songs, albums..." />
    </div>

    <!-- Type Tabs -->
    <nav class="overflow-x-auto scrollbar-hide">
      <div class="flex gap-2 min-w-max pb-2">
        <a href="/lyrics" class="type-tab flex items-center gap-2 px-4 py-2.5 rounded-sm text-sm font-medium transition-all whitespace-nowrap tracking-wide active">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          By Decade
        </a>
        <a href="/lyrics/album" class="type-tab flex items-center gap-2 px-4 py-2.5 rounded-sm text-sm font-medium transition-all whitespace-nowrap tracking-wide">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/>
          </svg>
          By Album
        </a>
        <a href="/lyrics/a-z" class="type-tab flex items-center gap-2 px-4 py-2.5 rounded-sm text-sm font-medium transition-all whitespace-nowrap tracking-wide">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 6h18M3 12h18M3 18h18"/>
          </svg>
          A-Z Index
        </a>
        <a href="/lyrics/search" class="type-tab flex items-center gap-2 px-4 py-2.5 rounded-sm text-sm font-medium transition-all whitespace-nowrap tracking-wide">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          Search
        </a>
        <button
          id="random-song-btn"
          class="type-tab flex items-center gap-2 px-4 py-2.5 rounded-sm text-sm font-medium transition-all whitespace-nowrap tracking-wide"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/>
          </svg>
          Random Song
        </button>
      </div>
    </nav>
  </section>

  <!-- Random song data for JS -->
  <script define:vars={{ songsWithLyricsSlugs: songsWithLyrics.map((s: any) => s.slug) }}>
    document.getElementById('random-song-btn')?.addEventListener('click', () => {
      const randomIndex = Math.floor(Math.random() * songsWithLyricsSlugs.length);
      const randomSlug = songsWithLyricsSlugs[randomIndex];
      window.location.href = `/lyrics/${randomSlug}`;
    });

  </script>

  <!-- Featured: Lyric of the Day - Full Album Art Background -->
  {lyricOfTheDay && (
    <section class="mb-16">
      <div class="flex items-center gap-4 mb-6">
        <h2 class="font-heading text-2xl text-primary">Lyric of the Day</h2>
        <div class="divider-gradient flex-1"></div>
      </div>

      <div class="glass-card-hover rounded-2xl overflow-hidden group">
        <div class="relative min-h-[400px]">
          <!-- Album art as background with enhanced overlay -->
          <div class="absolute inset-0 z-0">
            <img
              src={lyricOfTheDay.albumCover}
              alt={`Album cover for ${lyricOfTheDay.albumTitle}`}
              class="w-full h-full object-cover scale-105 group-hover:scale-110 transition-transform duration-700"
            />
            <!-- Multi-layer gradient overlay for depth -->
            <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/70 to-black/40"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
          </div>

          <!-- Content overlay -->
          <div class="relative z-10 p-8 md:p-12 h-full flex flex-col justify-end">
            <div class="md:max-w-2xl">
              <!-- Album info with enhanced styling -->
              <div class="flex flex-col md:flex-row md:items-end gap-6 mb-8">
                <div class="size-28 md:size-32 shrink-0 rounded-xl overflow-hidden shadow-2xl ring-1 ring-white/20 group-hover:ring-primary/40 transition-all duration-500">
                  <img
                    src={lyricOfTheDay.albumCover}
                    alt={`Album cover for ${lyricOfTheDay.albumTitle}`}
                    class="size-full object-cover"
                  />
                </div>
                <div>
                  <span class="badge-outline mb-2">{lyricOfTheDay.year}</span>
                  <p class="text-white/60 text-sm mb-1">{lyricOfTheDay.albumTitle}</p>
                  <h3 class="font-display text-5xl md:text-6xl text-white text-glow">{lyricOfTheDay.title}</h3>
                </div>
              </div>

              {lyricSnippet && (
                <div class="my-8 pl-6 border-l-2 border-primary/50">
                  <p class="italic text-white/80 text-xl md:text-2xl font-light leading-relaxed whitespace-pre-line">
                    "{lyricSnippet}"
                  </p>
                </div>
              )}

              <a href={`/lyrics/${lyricOfTheDay.slug}`} class="inline-flex items-center gap-3 px-8 py-4 rounded-xl bg-primary/20 border border-primary/40 text-white font-medium hover:bg-primary/30 hover:border-primary/60 hover:shadow-lg hover:shadow-primary/20 transition-all duration-300 group/btn">
                <span>View Full Lyrics</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="size-5 group-hover/btn:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14"></path>
                  <path d="m12 5 7 7-7 7"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Timeline/Decades View -->
  <section>
    <div class="flex items-center gap-4 mb-8">
      <h2 class="font-heading text-2xl text-primary">All Songs</h2>
      <div class="divider-gradient flex-1"></div>
    </div>

    <div class="space-y-12">
      {sortedDecades.map(decade => (
        <div class="decade-section" data-decade={decade} data-filter-group>
          <!-- Decade header with visual interest -->
          <div class="flex items-center gap-4 mb-8">
            <div class="flex items-baseline gap-4">
              <span class="font-display text-6xl text-primary text-glow">{decade}</span>
              <span class="px-3 py-1.5 text-sm font-medium rounded-full bg-primary/20 text-white border border-primary/30">{songsByDecade[decade].length} songs</span>
            </div>
            <div class="flex-1 h-px bg-gradient-to-r from-primary/50 to-transparent"></div>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
            {songsByDecade[decade].map(song => (
              <a
                href={`/lyrics/${song.slug}`}
                class="song-card group block"
                data-filter-item
                data-filter-text={`${song.title} ${song.albumTitle} ${song.year}`}
              >
                <div class="card-inner relative overflow-hidden h-full">
                  <!-- Album artwork -->
                  <div class="relative aspect-square overflow-hidden">
                    <img
                      src={song.albumCover}
                      alt={`Album art for ${song.albumTitle}`}
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent opacity-60 group-hover:opacity-80 transition-opacity duration-500"></div>
                    <div class="absolute inset-0 bg-gradient-to-br from-white/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                  </div>

                  <!-- Content overlay at bottom -->
                  <div class="absolute bottom-0 left-0 right-0 p-4">
                    <h4 class="font-display text-xl md:text-2xl text-white mb-1 group-hover:text-glow transition-all duration-300 text-shadow-strong">
                      {song.title}
                    </h4>
                    <span class="text-white/60 text-xs font-medium tracking-wider uppercase text-shadow">{song.albumTitle}</span>
                  </div>

                  <!-- Border frame -->
                  <div class="absolute inset-0 border border-white/[0.08] group-hover:border-primary/30 transition-colors duration-500 pointer-events-none"></div>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</MainLayout>

<style>
  /* Song card - matching AlbumCard/SetlistCard pattern */
  .song-card {
    --card-glow: rgba(var(--color-primary-rgb, 137, 176, 201), 0.3);
  }

  .song-card .card-inner {
    background: linear-gradient(
      145deg,
      rgba(var(--color-primary-rgb), 0.06) 0%,
      rgba(0, 0, 0, 0.6) 30%,
      rgba(0, 0, 0, 0.55) 100%
    );
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.5),
      inset 0 1px 0 rgba(255, 255, 255, 0.04);
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
                box-shadow 0.5s ease,
                background 0.5s ease;
  }

  .song-card:hover .card-inner {
    transform: translateY(-6px);
    background: linear-gradient(
      145deg,
      rgba(var(--color-primary-rgb), 0.1) 0%,
      rgba(0, 0, 0, 0.65) 30%,
      rgba(0, 0, 0, 0.6) 100%
    );
    box-shadow:
      0 20px 40px rgba(0, 0, 0, 0.6),
      0 0 50px var(--card-glow),
      0 4px 20px rgba(var(--color-primary-rgb), 0.15),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .song-card:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .song-card:hover h4 {
    text-shadow: 0 0 30px var(--card-glow),
                 0 3px 8px rgba(0, 0, 0, 0.9);
  }

  .text-shadow {
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8),
                 0 1px 2px rgba(0, 0, 0, 0.6);
  }

  .text-shadow-strong {
    text-shadow: 0 3px 8px rgba(0, 0, 0, 0.95),
                 0 2px 4px rgba(0, 0, 0, 0.9),
                 0 1px 2px rgba(0, 0, 0, 0.8);
  }

  .text-shadow-lg {
    text-shadow:
      0 4px 8px rgba(0, 0, 0, 0.9),
      0 2px 4px rgba(0, 0, 0, 0.8),
      0 0 30px rgba(0, 0, 0, 0.6);
  }

  /* Decade header styling */
  .decade-section h3 {
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
  }

  /* Tab styling - matching discography */
  .type-tab {
    color: rgba(255, 255, 255, 0.45);
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }
  .type-tab:hover {
    color: rgba(255, 255, 255, 0.85);
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.1);
  }
  .type-tab.active {
    background: rgba(var(--color-primary-rgb, 137, 176, 201), 0.12);
    color: var(--color-primary);
    border-color: rgba(var(--color-primary-rgb, 137, 176, 201), 0.25);
  }

  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
  .scrollbar-hide::-webkit-scrollbar { display: none; }
</style>
