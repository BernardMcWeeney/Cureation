---
// src/pages/lyrics/index.astro
import MainLayout from '../../layouts/MainLayout.astro';
import LyricsSidebar from '../../components/sidebar/LyricsSidebar.astro';
import { ViewTransitions } from 'astro:transitions';

// Fetch albums data to link songs to their albums
const albumsResponse = await fetch('https://dash.cureation.net/items/discography');
const albumsData = await albumsResponse.json();
const albums = albumsData.data.reduce((acc, album) => {
  acc[album.id] = {
    title: album.title || 'Unknown Album',
    slug: album.slug || (album.title ? album.title.toLowerCase().replace(/[^\w\s]/gi, '').replace(/\s+/g, '-') : 'unknown-album'),
    cover_art: album.cover_art ? `https://dash.cureation.net/assets/${album.cover_art}` : '/images/placeholder-album.jpg',
    year: album.release_date ? new Date(album.release_date).getFullYear().toString() : ''
  };
  return acc;
}, {});

// Fetch all songs
const songsResponse = await fetch('https://dash.cureation.net/items/songs');
const songsData = await songsResponse.json();

// Format the songs data with album information - filter out songs without titles
const songs = songsData.data
  .filter(song => song.title) // Only include songs that have titles
  .map(song => ({
    id: song.id,
    title: song.title,
    albumId: song.album,
    albumTitle: albums[song.album]?.title || 'Unknown Album',
    albumSlug: albums[song.album]?.slug || 'unknown',
    albumCover: albums[song.album]?.cover_art || '/images/placeholder-album.jpg',
    year: albums[song.album]?.year || '',
    duration: song.duration || '0:00',
    hasLyrics: !!song.lyrics,
    lyrics: song.lyrics || '',
    slug: song.title.toLowerCase().replace(/[^\w\s]/gi, '').replace(/\s+/g, '-')
  }));

// Get a deterministic "Lyric of the Day" based on the current date
const songsWithLyrics = songs.filter((song: any) => song.hasLyrics);
function getSongOfTheDay() {
  if (songsWithLyrics.length === 0) return null;
  const today = new Date();
  const seed = today.getFullYear() * 10000 + (today.getMonth() + 1) * 100 + today.getDate();
  const index = seed % songsWithLyrics.length;
  return songsWithLyrics[index];
}
const lyricOfTheDay = getSongOfTheDay();

// Extract a short lyric snippet for display (first few lines, maximum 4)
let lyricSnippet = '';
if (lyricOfTheDay?.lyrics) {
  // Clean up the lyrics - remove section headers in brackets
  const cleanLyrics = lyricOfTheDay.lyrics.replace(/\[.*?\]/g, '').trim();
  
  // Get the first few lines (max 4 lines)
  const lines = cleanLyrics.split('\n').filter(line => line.trim() !== '');
  lyricSnippet = lines.slice(0, 4).join('\n');
  
  // Add ellipsis if we're truncating
  if (lines.length > 4) {
    lyricSnippet += '...';
  }
}

// Group songs by decade for a nice timeline display
const songsByDecade = songs.reduce((acc, song) => {
  if (!song.year) return acc;
  
  const decade = `${song.year.slice(0, 3)}0s`;
  if (!acc[decade]) acc[decade] = [];
  acc[decade].push(song);
  return acc;
}, {});

// Sort decades chronologically
const sortedDecades = Object.keys(songsByDecade).sort();
---

<MainLayout
  title="Song Lyrics"
  description="Explore The Cure's lyrics - find your favorite songs and discover the poetry behind the music."
  showSidebar={true}
  customSidebar={true}
  pageClass="bg-black"
>
<LyricsSidebar
  slot="sidebar"
  activeFilter="All Songs"
  albums={Object.values(albums).map((a: any) => ({
    title: a.title,
    slug: a.slug,
    coverImage: a.cover_art,
    year: a.year
  })).sort((a: any, b: any) => parseInt(b.year) - parseInt(a.year))}
/>
  <ViewTransitions />
  
  <!-- Hero Section -->
  <section class="mb-16">
    <div class="glass-card-glow rounded-2xl overflow-hidden relative">
      <!-- Decorative gradient orb -->
      <div class="absolute -top-20 -right-20 w-64 h-64 rounded-full bg-primary/20 blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-10 -left-10 w-40 h-40 rounded-full bg-accent/10 blur-2xl pointer-events-none"></div>

      <div class="relative p-8 md:p-12">
        <div class="flex items-center gap-3 mb-4">
          <span class="badge">Lyrics Archive</span>
          <div class="divider-gradient flex-1 max-w-24"></div>
        </div>

        <h1 class="font-display text-6xl md:text-7xl lg:text-8xl text-white mb-4 text-glow">
          The Cure Lyrics
        </h1>
        <p class="text-white/90 text-lg md:text-xl max-w-2xl mb-8 leading-relaxed">
          Discover the poetic genius behind The Cure's catalog — from early post-punk to atmospheric gothic rock and beyond.
        </p>

        <!-- Enhanced search form -->
        <form action="/lyrics/search" method="get" class="relative max-w-xl group">
          <div class="absolute inset-0 rounded-xl bg-primary/10 blur-xl opacity-0 group-focus-within:opacity-100 transition-opacity duration-500"></div>
          <div class="relative flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white/40 absolute left-4 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              type="text"
              name="q"
              placeholder="Search for lyrics or songs..."
              class="w-full py-4 px-12 rounded-xl backdrop-blur-xl bg-white/5 border border-white/10 text-white placeholder-white/40 focus:outline-none focus:border-primary/50 focus:bg-white/10 transition-all duration-300"
            />
            <button
              type="submit"
              class="absolute right-2 px-5 py-2.5 rounded-lg bg-primary/30 border border-primary/40 text-white font-medium hover:bg-primary/50 hover:border-primary/60 transition-all duration-300 hover:shadow-lg hover:shadow-primary/20"
            >
              Search
            </button>
          </div>
        </form>

        <!-- Quick stats -->
        <div class="flex flex-wrap gap-8 mt-8 pt-6 border-t border-white/20">
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-primary text-glow">{songs.length}</span>
            <span class="text-white/80 text-base font-medium">Songs</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-primary text-glow">{songsWithLyrics.length}</span>
            <span class="text-white/80 text-base font-medium">With Lyrics</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-primary text-glow">{Object.keys(albums).length}</span>
            <span class="text-white/80 text-base font-medium">Albums</span>
          </div>
        </div>

        <!-- Quick Actions -->
        <div class="flex flex-wrap gap-4 mt-6">
          <a
            href="/lyrics/a-z"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white/10 border border-white/20 text-white hover:bg-primary/20 hover:border-primary/40 transition-all duration-300"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 6h18M3 12h18M3 18h18"/>
            </svg>
            <span class="font-medium">A-Z Index</span>
          </a>
          <a
            href="/lyrics/album"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white/10 border border-white/20 text-white hover:bg-primary/20 hover:border-primary/40 transition-all duration-300"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
            <span class="font-medium">By Album</span>
          </a>
          <button
            id="random-song-btn"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-primary/20 border border-primary/40 text-white hover:bg-primary/30 hover:border-primary/50 transition-all duration-300"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/>
            </svg>
            <span class="font-medium">Random Song</span>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Random song data for JS -->
  <script define:vars={{ songsWithLyricsSlugs: songsWithLyrics.map((s: any) => s.slug) }}>
    document.getElementById('random-song-btn')?.addEventListener('click', () => {
      const randomIndex = Math.floor(Math.random() * songsWithLyricsSlugs.length);
      const randomSlug = songsWithLyricsSlugs[randomIndex];
      window.location.href = `/lyrics/${randomSlug}`;
    });
  </script>

  <!-- Featured: Lyric of the Day - Full Album Art Background -->
  {lyricOfTheDay && (
    <section class="mb-16">
      <div class="flex items-center gap-4 mb-6">
        <h2 class="font-heading text-2xl text-primary">Lyric of the Day</h2>
        <div class="divider-gradient flex-1"></div>
      </div>

      <div class="glass-card-hover rounded-2xl overflow-hidden group">
        <div class="relative min-h-[400px]">
          <!-- Album art as background with enhanced overlay -->
          <div class="absolute inset-0 z-0">
            <img
              src={lyricOfTheDay.albumCover}
              alt={`Album cover for ${lyricOfTheDay.albumTitle}`}
              class="w-full h-full object-cover scale-105 group-hover:scale-110 transition-transform duration-700"
            />
            <!-- Multi-layer gradient overlay for depth -->
            <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/70 to-black/40"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
          </div>

          <!-- Content overlay -->
          <div class="relative z-10 p-8 md:p-12 h-full flex flex-col justify-end">
            <div class="md:max-w-2xl">
              <!-- Album info with enhanced styling -->
              <div class="flex flex-col md:flex-row md:items-end gap-6 mb-8">
                <div class="size-28 md:size-32 shrink-0 rounded-xl overflow-hidden shadow-2xl ring-1 ring-white/20 group-hover:ring-primary/40 transition-all duration-500">
                  <img
                    src={lyricOfTheDay.albumCover}
                    alt={`Album cover for ${lyricOfTheDay.albumTitle}`}
                    class="size-full object-cover"
                  />
                </div>
                <div>
                  <span class="badge-outline mb-2">{lyricOfTheDay.year}</span>
                  <p class="text-white/60 text-sm mb-1">{lyricOfTheDay.albumTitle}</p>
                  <h3 class="font-display text-5xl md:text-6xl text-white text-glow">{lyricOfTheDay.title}</h3>
                </div>
              </div>

              {lyricSnippet && (
                <div class="my-8 pl-6 border-l-2 border-primary/50">
                  <p class="italic text-white/80 text-xl md:text-2xl font-light leading-relaxed whitespace-pre-line">
                    "{lyricSnippet}"
                  </p>
                </div>
              )}

              <a href={`/lyrics/${lyricOfTheDay.slug}`} class="inline-flex items-center gap-3 px-8 py-4 rounded-xl bg-primary/20 border border-primary/40 text-white font-medium hover:bg-primary/30 hover:border-primary/60 hover:shadow-lg hover:shadow-primary/20 transition-all duration-300 group/btn">
                <span>View Full Lyrics</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="size-5 group-hover/btn:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14"></path>
                  <path d="m12 5 7 7-7 7"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Timeline/Decades View -->
  <section>
    <div class="flex items-center gap-4 mb-8">
      <h2 class="font-heading text-2xl text-primary">All Songs</h2>
      <div class="divider-gradient flex-1"></div>
    </div>

    <div class="space-y-12">
      {sortedDecades.map(decade => (
        <div class="decade-section" data-decade={decade}>
          <!-- Decade header with visual interest -->
          <div class="flex items-center gap-4 mb-8">
            <div class="flex items-baseline gap-4">
              <span class="font-display text-6xl text-primary text-glow">{decade}</span>
              <span class="px-3 py-1.5 text-sm font-medium rounded-full bg-primary/20 text-white border border-primary/30">{songsByDecade[decade].length} songs</span>
            </div>
            <div class="flex-1 h-px bg-gradient-to-r from-primary/50 to-transparent"></div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
            {songsByDecade[decade].map(song => (
              <a
                href={`/lyrics/${song.slug}`}
                class="song-card group"
                style={`--card-bg: url(${song.albumCover})`}
              >
                <!-- Album art background with blur -->
                <div class="absolute inset-0 z-0">
                  <img
                    src={song.albumCover}
                    alt=""
                    class="w-full h-full object-cover blur-sm scale-110 group-hover:scale-125 group-hover:blur-none transition-all duration-700"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/60 to-black/40 group-hover:from-black/70 group-hover:via-black/50 group-hover:to-black/30 transition-all duration-500"></div>
                </div>

                <!-- Content -->
                <div class="relative z-10 p-5 flex items-center gap-4">
                  <!-- Album art thumbnail -->
                  <div class="size-16 shrink-0 rounded-lg overflow-hidden ring-2 ring-white/20 group-hover:ring-primary/60 shadow-xl transition-all duration-300">
                    <img
                      src={song.albumCover}
                      alt={`Album art for ${song.albumTitle}`}
                      class="size-full object-cover"
                      loading="lazy"
                    />
                  </div>

                  <!-- Song info -->
                  <div class="flex-1 min-w-0">
                    <h4 class="text-white font-semibold text-lg truncate group-hover:text-primary transition-colors duration-300 text-shadow">{song.title}</h4>
                    <p class="text-white/70 text-sm truncate text-shadow">{song.albumTitle}</p>
                    {song.hasLyrics && (
                      <span class="inline-flex items-center gap-1 mt-1 px-2 py-0.5 text-xs rounded-full bg-primary/30 text-primary/90 border border-primary/40">
                        <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M9 18V5l12-2v13"></path>
                          <circle cx="6" cy="18" r="3"></circle>
                          <circle cx="18" cy="16" r="3"></circle>
                        </svg>
                        Lyrics
                      </span>
                    )}
                  </div>

                  <!-- Arrow indicator -->
                  <div class="shrink-0 size-10 rounded-full bg-white/10 group-hover:bg-primary/30 flex items-center justify-center transition-all duration-300">
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-5 text-white/60 group-hover:text-white group-hover:translate-x-0.5 transition-all duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</MainLayout>

<style>
  /* Song card with album art background */
  .song-card {
    position: relative;
    overflow: hidden;
    border-radius: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    min-height: 90px;
  }

  .song-card:hover {
    border-color: rgba(var(--color-primary-rgb), 0.5);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5),
                0 0 50px rgba(var(--color-primary-rgb), 0.15);
    transform: translateY(-4px) scale(1.01);
  }

  .song-card:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* Lift effect on hover */
  .hover-lift {
    transition: transform 0.3s var(--ease-out);
  }

  .hover-lift:hover {
    transform: translateY(-4px);
  }

  /* Text shadow for better readability against album art */
  .text-shadow {
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8),
                 0 1px 3px rgba(0, 0, 0, 0.6);
  }

  .text-shadow-lg {
    text-shadow:
      0 4px 8px rgba(0, 0, 0, 0.9),
      0 2px 4px rgba(0, 0, 0, 0.8),
      0 0 30px rgba(0, 0, 0, 0.6);
  }

  /* Minimum height for lyric of day container */
  .min-h-80 {
    min-height: 20rem;
  }

  /* Decade header styling */
  .decade-section h3 {
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
  }
</style>