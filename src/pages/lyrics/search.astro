---
// src/pages/lyrics/search.astro
import MainLayout from '../../layouts/MainLayout.astro';
import LyricsSidebar from '../../components/sidebar/LyricsSidebar.astro';
import SearchWidget from '../../components/Search.astro';
import { ClientRouter } from 'astro:transitions';
import { fetchAlbums, getAssetUrl, generateSlug } from '../../lib/directus';

// Get search query from URL (for display purposes)
const query = Astro.url.searchParams.get('q') || '';

// Fetch albums for sidebar
const rawAlbums = await fetchAlbums();
const albums = rawAlbums.map((album) => ({
  title: album.title || 'Unknown Album',
  slug: album.slug || generateSlug(album.title || 'unknown'),
  coverImage: getAssetUrl(album.cover_art),
  year: album.release_date ? new Date(album.release_date).getFullYear().toString() : ''
})).sort((a, b) => parseInt(b.year) - parseInt(a.year));
---

<MainLayout
  title={query ? `Search: ${query}` : 'Search Lyrics'}
  description="Search through The Cure's lyrics and discography"
  showSidebar={true}
  customSidebar={true}
  pageClass="bg-black"
>
<LyricsSidebar
  slot="sidebar"
  activeFilter="Search"
  albums={albums}
/>
  <ClientRouter />

  <section class="mb-12">
    <div class="glass-panel overflow-hidden relative">
      <div class="absolute -top-20 -left-20 w-64 h-64 rounded-full bg-white/[0.06] blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-10 -right-10 w-48 h-48 rounded-full bg-accent/[0.06] blur-2xl pointer-events-none"></div>

      <div class="relative p-8 md:p-12">
        <h1 class="font-display text-5xl md:text-6xl lg:text-7xl text-white mb-4 text-glow">
          Search
        </h1>
        <p class="text-white/75 text-lg md:text-xl max-w-3xl leading-relaxed mb-8">
          Search through The Cure's complete catalog — find songs, albums, and lyrics.
        </p>

        <!-- Pagefind Search -->
        <SearchWidget
          placeholder="Search lyrics, songs, albums..."
          showFilters={true}
          initialQuery={query}
        />
      </div>
    </div>
  </section>

  <!-- Quick Links -->
  <section>
    <h2 class="font-heading text-2xl text-primary mb-4">Browse by Category</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <a
        href="/lyrics"
        class="glass-card p-6 rounded-xl border border-white/20 hover:border-white/30 transition-all duration-300 group"
      >
        <h3 class="text-white font-medium text-lg group-hover:text-white transition-colors">
          All Songs
        </h3>
        <p class="text-white/85 text-sm mt-2">
          Browse all songs by decade
        </p>
      </a>
      <a
        href="/lyrics/album"
        class="glass-card p-6 rounded-xl border border-white/20 hover:border-white/30 transition-all duration-300 group"
      >
        <h3 class="text-white font-medium text-lg group-hover:text-white transition-colors">
          By Album
        </h3>
        <p class="text-white/85 text-sm mt-2">
          Explore songs organized by album
        </p>
      </a>
      <a
        href="/discography"
        class="glass-card p-6 rounded-xl border border-white/20 hover:border-white/30 transition-all duration-300 group"
      >
        <h3 class="text-white font-medium text-lg group-hover:text-white transition-colors">
          Discography
        </h3>
        <p class="text-white/85 text-sm mt-2">
          View all albums and releases
        </p>
      </a>
    </div>
  </section>
</MainLayout>
