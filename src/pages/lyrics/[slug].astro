---
import MainLayout from '../../layouts/MainLayout.astro';
import { createSongSlug, parseLyrics, type LyricSection } from '../../lib/lyrics-helpers';

interface SongData {
  id: number;
  title: string;
  trackNumber: number;
  duration: string;
  lyrics: LyricSection[] | null;
  hasLyrics: boolean;
  songMeaning: string | null;
  credits: string | null;
}

interface AlbumData {
  id: number | string;
  title: string;
  slug: string;
  coverImage: string;
  year: string;
  producer: string;
  tracks: { number: number; title: string; slug: string; duration: string }[];
}

interface Props {
  song: SongData;
  album: AlbumData;
  prevTrack: { title: string; slug: string } | null;
  nextTrack: { title: string; slug: string } | null;
}

export async function getStaticPaths() {
  const directusUrl = 'https://dash.cureation.net';
  const albumsResponse = await fetch(
    `${directusUrl}/items/discography?limit=-1&fields=id,title,cover_art,release_date,producer`
  );
  const albumsData = await albumsResponse.json();
  const albums: Record<string, any> = {};
  for (const album of albumsData.data || []) {
    const albumKey = String(album.id);
    albums[albumKey] = {
      id: album.id,
      title: album.title || 'Unknown Album',
      slug: createSongSlug(album.title || `album-${album.id}`),
      coverImage: album.cover_art ? `${directusUrl}/assets/${album.cover_art}` : '/images/placeholder-album.jpg',
      year: album.release_date ? new Date(album.release_date).getFullYear().toString() : '',
      producer: album.producer || 'Unknown',
    };
  }

  const songsResponse = await fetch(`${directusUrl}/items/songs?limit=-1`);
  const songsData = await songsResponse.json();
  const allSongs = songsData.data || [];

  // Group songs by album for tracklists
  const songsByAlbum: Record<string, any[]> = {};
  for (const song of allSongs.filter((s: any) => s.title)) {
    const albumId = typeof song.album === 'object' && song.album ? song.album.id : song.album;
    if (albumId == null) continue;
    const albumKey = String(albumId);
    if (!songsByAlbum[albumKey]) songsByAlbum[albumKey] = [];
    songsByAlbum[albumKey].push({
      number: song.track_number || 0,
      title: song.title,
      slug: createSongSlug(song.title),
      duration: song.duration || '0:00',
    });
  }
  for (const tracks of Object.values(songsByAlbum)) {
    tracks.sort((a: any, b: any) => a.number - b.number);
  }

  return allSongs
    .filter((song: any) => song.title)
    .map((song: any) => {
      const slug = createSongSlug(song.title);
      const albumId = typeof song.album === 'object' && song.album ? song.album.id : song.album;
      const albumKey = albumId != null ? String(albumId) : '';
      const album = albums[albumKey] || {
        id: albumId || 0,
        title: 'Unknown Album',
        slug: 'unknown-album',
        coverImage: '/images/placeholder-album.jpg',
        year: '',
        producer: 'Unknown',
      };
      const albumTracks = songsByAlbum[albumKey] || [];
      const lyrics = parseLyrics(song.lyrics, song.lyrics_structured);

      const currentIdx = albumTracks.findIndex((t: any) => t.slug === slug);
      const prevTrack = currentIdx > 0 ? albumTracks[currentIdx - 1] : null;
      const nextTrack = currentIdx < albumTracks.length - 1 ? albumTracks[currentIdx + 1] : null;

      return {
        params: { slug },
        props: {
          song: {
            id: song.id,
            title: song.title,
            trackNumber: song.track_number || 0,
            duration: song.duration || '0:00',
            lyrics,
            hasLyrics: !!lyrics && lyrics.length > 0,
            songMeaning: song.song_meaning || null,
            credits: song.credits || null,
          },
          album: { ...album, tracks: albumTracks },
          prevTrack,
          nextTrack,
        },
      };
    });
}

const { song, album, prevTrack, nextTrack } = Astro.props as Props;
const currentSlug = createSongSlug(song.title);

// Word count
const wordCount = song.lyrics
  ? song.lyrics.flatMap((s: LyricSection) => s.lines).join(' ').split(/\s+/).filter(Boolean).length
  : 0;
---

<MainLayout
  title={`${song.title} Lyrics - The Cure`}
  description={`Lyrics for ${song.title} by The Cure from ${album.title} (${album.year}).`}
  ogImage={album.coverImage}
  showSidebar={false}
  pageClass={`theme-${album.slug} song-page`}
  theme={album.slug}
>

  <!-- Breadcrumb -->
  <nav class="mb-8" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-white/60">
      <li><a href="/lyrics" class="hover:text-primary transition-colors">Lyrics</a></li>
      <li aria-hidden="true">/</li>
      <li>
        <a href={`/discography/${album.slug}`} class="hover:text-primary transition-colors">
          {album.title}
        </a>
      </li>
      <li aria-hidden="true">/</li>
      <li class="text-white truncate max-w-[200px]">{song.title}</li>
    </ol>
  </nav>

  <!-- Song Header -->
  <section class="mb-12">
    <div class="glass-panel overflow-hidden relative">
      <div class="absolute -top-20 -left-20 w-64 h-64 rounded-full bg-primary/10 blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-10 -right-10 w-48 h-48 rounded-full bg-accent/[0.06] blur-2xl pointer-events-none"></div>

      <div class="relative p-8 md:p-12">
        <div class="flex flex-col sm:flex-row gap-6 md:gap-8">
          <!-- Album Cover -->
          <a href={`/discography/${album.slug}`} class="shrink-0 group">
            <img
              src={album.coverImage}
              alt={`${album.title} cover`}
              class="w-32 md:w-40 aspect-square rounded-xl shadow-2xl object-cover group-hover:shadow-primary/20 transition-shadow duration-300"
            />
          </a>

          <!-- Song Info -->
          <div class="flex-1 min-w-0">
            <div class="flex flex-wrap items-center gap-2 mb-3">
              <span class="text-primary text-sm font-medium">Track {song.trackNumber}</span>
              <span class="text-white/30">·</span>
              <a href={`/discography/${album.slug}`} class="text-primary text-sm hover:opacity-80 transition-opacity">{album.title}</a>
            </div>

            <h1 class="font-display text-5xl md:text-6xl lg:text-7xl text-white mb-3 text-glow">
              {song.title}
            </h1>

            <p class="text-white/75 mb-6">The Cure · {album.year}</p>

            <!-- Stats -->
            <div class="flex flex-wrap gap-8 pt-6 border-t border-white/[0.08]">
              <div class="flex items-center gap-3">
                <span class="text-3xl font-display text-primary text-glow">{song.duration}</span>
                <span class="text-white/60 text-base font-medium">Duration</span>
              </div>
              {song.hasLyrics && (
                <div class="flex items-center gap-3">
                  <span class="text-3xl font-display text-primary text-glow">{wordCount}</span>
                  <span class="text-white/60 text-base font-medium">Words</span>
                </div>
              )}
              {song.credits && (
                <div class="flex items-center gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-white/60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                  <span class="text-white/60 text-base font-medium">{song.credits}</span>
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Lyrics -->
  {song.hasLyrics ? (
    <section class="mb-12" data-pagefind-body>
      <div class="glass-card rounded-2xl p-6 md:p-10 border border-white/20" data-pagefind-meta={`album:${album.title}`}>
        <h2 class="font-heading text-2xl text-primary mb-8">Lyrics</h2>

        {song.lyrics!.map((section: LyricSection) => (
          <div class="mb-8 last:mb-0">
            {section.label && (
              <p class="text-primary/70 text-sm uppercase tracking-wider mb-3 font-medium">[{section.label}]</p>
            )}
            {section.lines.map((line: string) => (
              <p class="text-white/85 text-lg leading-loose">{line}</p>
            ))}
          </div>
        ))}
      </div>
    </section>
  ) : (
    <section class="mb-12">
      <div class="glass-card rounded-2xl p-8 md:p-12 border border-white/20 text-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-12 text-white/20 mx-auto mb-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 18V5l12-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="18" cy="16" r="3" />
        </svg>
        <h2 class="font-heading text-2xl text-white mb-2">Lyrics Coming Soon</h2>
        <p class="text-white/70 max-w-md mx-auto">We're working on adding lyrics for this song. Check back later or explore other songs from {album.title}.</p>
      </div>
    </section>
  )}

  <!-- Song Meaning -->
  {song.songMeaning && (
    <section class="mb-12">
      <div class="glass-tile p-8 md:p-10">
        <h2 class="font-heading text-2xl text-primary mb-6">Meaning & Commentary</h2>
        <div class="prose prose-invert prose-lg max-w-none" set:html={song.songMeaning} />
      </div>
    </section>
  )}

  <!-- More from Album -->
  {album.tracks && album.tracks.length > 1 && (
    <section class="mb-12">
      <h2 class="font-heading text-2xl text-primary mb-6">More from {album.title}</h2>
      <div class="glass-card rounded-2xl p-4 md:p-6 border border-white/20">
        <ol class="space-y-1" aria-label={`More tracks from ${album.title}`}>
          {album.tracks
            .filter((track: any) => track.slug !== currentSlug)
            .slice(0, 10)
            .map((track: any) => (
              <li>
                <a href={`/lyrics/${track.slug}`} class="flex items-center gap-4 px-4 py-3 rounded-lg hover:bg-white/5 transition-colors group">
                  <span class="w-6 text-center text-white/60 text-sm tabular-nums">{track.number}</span>
                  <span class="flex-1 text-white group-hover:text-primary transition-colors">{track.title}</span>
                  <span class="text-white/60 text-sm tabular-nums">{track.duration}</span>
                </a>
              </li>
            ))}
        </ol>
      </div>
    </section>
  )}

  <!-- Prev/Next Navigation -->
  {(prevTrack || nextTrack) && (
    <section class="mb-12">
      <div class="flex flex-col sm:flex-row gap-4">
        {prevTrack ? (
          <a
            href={`/lyrics/${prevTrack.slug}`}
            class="flex-1 glass-card rounded-xl p-4 border border-white/20 hover:border-primary/40 transition-colors group"
          >
            <span class="text-white/70 text-sm">Previous Track</span>
            <div class="flex items-center gap-2 mt-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m15 18-6-6 6-6"></path>
              </svg>
              <span class="text-white group-hover:text-primary transition-colors truncate">{prevTrack.title}</span>
            </div>
          </a>
        ) : <div class="flex-1"></div>}

        {nextTrack ? (
          <a
            href={`/lyrics/${nextTrack.slug}`}
            class="flex-1 glass-card rounded-xl p-4 border border-white/20 hover:border-primary/40 transition-colors group text-right"
          >
            <span class="text-white/70 text-sm">Next Track</span>
            <div class="flex items-center justify-end gap-2 mt-1">
              <span class="text-white group-hover:text-primary transition-colors truncate">{nextTrack.title}</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m9 18 6-6-6-6"></path>
              </svg>
            </div>
          </a>
        ) : <div class="flex-1"></div>}
      </div>
    </section>
  )}

  <!-- Back to Album -->
  <div class="text-center">
    <a
      href={`/discography/${album.slug}`}
      class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-primary/20 border border-primary/40 text-white hover:bg-primary/30 transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m15 18-6-6 6-6"></path>
      </svg>
      Back to {album.title}
    </a>
  </div>

</MainLayout>
