    font-size: 1.1rem;
    font-style: italic;
    color: white;
    line-height: 1.6;
    padding: 1rem 1.25rem;
    margin: 0 0 1.25rem;
    background: rgba(var(--color-primary-rgb), 0.1);
    border-left: 3px solid var(--color-primary);
    border-radius: 0 0.5rem 0.5rem 0;
  }

  .meaning-text {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.8;
