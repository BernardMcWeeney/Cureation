---
// src/pages/lyrics/[slug].astro
import MainLayout from '../../layouts/MainLayout.astro';
import { ViewTransitions } from 'astro:transitions';

// Sidebar configuration
const sidebarItems = [
  { title: 'All Songs', path: '/lyrics' },
  { title: 'By Album', path: '/lyrics/album' },
  { title: 'Popular Songs', path: '/lyrics/popular' },
  { title: 'Search', path: '/lyrics/search' }
];

export async function getStaticPaths() {
  // Fetch albums data to link songs to their albums
  const albumsResponse = await fetch('https://dash.cureation.net/items/discography');
  const albumsData = await albumsResponse.json();
  const albums = albumsData.data.reduce((acc, album) => {
    acc[album.id] = {
      id: album.id,
      title: album.title,
      slug: album.slug || album.title.toLowerCase().replace(/[^\w\s]/gi, '').replace(/\s+/g, '-'),
      cover_art: album.cover_art ? `https://dash.cureation.net/assets/${album.cover_art}` : '/images/placeholder-album.jpg',
      year: album.release_date ? new Date(album.release_date).getFullYear().toString() : '',
      producer: album.producer || 'Unknown'
    };
    return acc;
  }, {});

  // Fetch all songs
  const songsResponse = await fetch('https://dash.cureation.net/items/songs');
  const songsData = await songsResponse.json();

  // Create paths for songs with formatted data
  return songsData.data.map(song => {
    const slug = song.title.toLowerCase().replace(/[^\w\s]/gi, '').replace(/\s+/g, '-');
    const album = albums[song.album] || {};
    
    // Format lyrics if they exist
    let formattedLyrics = null;
    if (song.lyrics) {
      // Convert line breaks to HTML and handle verse structure
      formattedLyrics = song.lyrics
        .split('\n\n')
        .map(verse => ({
          type: verse.match(/^\[(.*?)\]/) ? 'section' : 'verse',
          content: verse
        }));
    }
    
    // Format listen links
    const listenLinks = song.listen_links || [];
    
    return {
      params: { slug },
      props: {
        song: {
          id: song.id,
          title: song.title,
          trackNumber: song.track_number,
          duration: song.duration,
          lyrics: formattedLyrics,
          listenLinks: listenLinks,
          credits: song.credits,
          hasLyrics: !!song.lyrics
        },
        album: {
          id: album.id || 0,
          title: album.title || 'Unknown Album',
          slug: album.slug || 'unknown',
          coverImage: album.cover_art || '/images/placeholder-album.jpg',
          year: album.year || '',
          producer: album.producer || 'Unknown'
        }
      }
    };
  });
}

const { song, album } = Astro.props;

// Get platform icons for streaming links
const getPlatformIcon = (platform) => {
  const lowerPlatform = platform?.toLowerCase() || '';
  
  if (lowerPlatform.includes('youtube')) {
    return 'youtube';
  } else if (lowerPlatform.includes('spotify')) {
    return 'spotify';
  } else if (lowerPlatform.includes('apple')) {
    return 'apple';
  } else {
    return 'link';
  }
};

// Map platform names to icons
const platformIcons = {
  youtube: '<svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24" fill="currentColor"><path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/></svg>',
  spotify: '<svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>',
  apple: '<svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24" fill="currentColor"><path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zm3.472-3.922c.832-1.091 1.413-2.597 1.259-4.117-1.234.052-2.715.819-3.597 1.83-.791.896-1.488 2.297-1.3 3.675 1.375.104 2.786-.717 3.638-1.388z"/></svg>',
  link: '<svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>'
};
---

<MainLayout
  title={song.title}
  description={`Lyrics for ${song.title} by The Cure from the album ${album.title} (${album.year})`}
  ogImage={album.coverImage}
  showSidebar={true}
  sidebarActiveItem="All Songs"
  sidebarItems={sidebarItems}
  pageClass={`theme-${album.slug}`}
>
  <ViewTransitions />
  
  <!-- Album artwork background layer -->
  <div class="artwork-background">
    <div class="bg-overlay bg-black opacity-70"></div>
    <div class="album-artwork" style={`background-image: url(${album.coverImage})`}></div>
  </div>

  <div data-theme={album.slug} class="bg-transparent">
    <!-- Song Header -->
    <section class="mb-10">
      <div class="glass-card rounded-xl overflow-hidden border border-white/20">
        <div class="flex flex-col md:flex-row">
          <!-- Album Cover -->
          <a href={`/discography/${album.slug}`} class="md:w-1/3 relative aspect-square md:aspect-auto">
            <img 
              src={album.coverImage} 
              alt={`Album cover for ${album.title}`} 
              class="w-full h-full object-cover transition-all duration-300 hover:opacity-90"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent md:bg-gradient-to-r md:from-transparent md:to-black/80"></div>
          </a>
          
          <!-- Song Info -->
          <div class="p-6 md:w-2/3 relative backdrop-blur-lg bg-black/20">
            <div class="mb-2">
              <a href={`/discography/${album.slug}`} class="text-primary/80 hover:text-primary text-sm transition-colors">
                {album.title} ({album.year})
              </a>
            </div>
            <h1 class="font-display text-5xl md:text-6xl text-white mb-3">{song.title}</h1>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
              <div>
                <h3 class="text-white/60 text-sm">Track</h3>
                <p class="text-white">{song.trackNumber}</p>
              </div>
              <div>
                <h3 class="text-white/60 text-sm">Duration</h3>
                <p class="text-white">{song.duration}</p>
              </div>
              <div>
                <h3 class="text-white/60 text-sm">Producer</h3>
                <p class="text-white">{album.producer}</p>
              </div>
            </div>
            
            <!-- Listen Links -->
            {song.listenLinks && song.listenLinks.length > 0 && (
              <div class="mt-6">
                <h3 class="text-white/60 text-sm mb-2">Listen On</h3>
                <div class="flex flex-wrap gap-3">
                  {song.listenLinks.map(link => (
                    <a 
                      href={link.Link} 
                      target="_blank" 
                      rel="noopener noreferrer"
                      class="flex items-center gap-2 px-4 py-2 rounded-lg backdrop-blur-md bg-black/20 border border-white/20 text-white hover:bg-white/10 transition-colors duration-300"
                    >
                      <Fragment set:html={platformIcons[getPlatformIcon(link.Platform)]} />
                      <span>{link.Platform ? link.Platform.charAt(0).toUpperCase() + link.Platform.slice(1) : 'Official Site'}</span>
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    </section>
    
    <!-- Lyrics Section -->
    {song.hasLyrics ? (
      <section class="mb-12">
        <div class="glass-card rounded-xl p-6 md:p-8 border border-white/20 backdrop-blur-lg bg-black/10">
          <h2 class="font-heading text-3xl text-primary mb-6">Lyrics</h2>
          <div class="prose prose-lg prose-invert max-w-none">
            {song.lyrics.map(part => (
              <div class={`mb-6 ${part.type === 'section' ? 'text-primary' : 'text-white'}`}>
                {part.content.split('\n').map(line => (
                  <p class="mb-1">{line}</p>
                ))}
              </div>
            ))}
          </div>
        </div>
      </section>
    ) : (
      <section class="mb-12">
        <div class="glass-card rounded-xl p-6 border border-white/20 backdrop-blur-lg bg-black/10">
          <h2 class="font-heading text-3xl text-primary mb-4">Lyrics</h2>
          <p class="text-white/80">Lyrics are not available for this song yet.</p>
        </div>
      </section>
    )}
    
    <!-- Song Credits (if available) -->
    {song.credits && (
      <section class="mb-12">
        <div class="glass-card rounded-xl p-6 border border-white/20 backdrop-blur-lg bg-black/10">
          <h2 class="font-heading text-3xl text-primary mb-4">Credits</h2>
          <div class="prose prose-invert max-w-none">
            <p class="text-white">{song.credits}</p>
          </div>
        </div>
      </section>
    )}
    
    <!-- Back to Album Link -->
    <div class="mb-12">
      <a 
        href={`/discography/${album.slug}#tracks`} 
        class="inline-flex items-center gap-2 px-4 py-2 rounded-lg backdrop-blur-md bg-primary/20 border border-primary/30 text-white hover:bg-primary/30 transition-colors duration-300"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m15 18-6-6 6-6"></path>
        </svg>
        <span>Back to {album.title}</span>
      </a>
    </div>
  </div>
</MainLayout>

<style>
  /* Ensure the artwork background shows through all containers */
  .artwork-background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }
  
  /* Album artwork background */
  .album-artwork {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0.3;
    filter: blur(20px);
  }
  
  /* Enhance typography for lyrics display */
  .prose p {
    margin-bottom: 0.25rem;
  }
  
  :global([data-section-title]) {
    color: var(--color-primary);
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
</style>