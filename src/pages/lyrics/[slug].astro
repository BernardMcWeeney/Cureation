</style>

<script>
  // Initialize lyrics interactivity
  function initLyricsFeature() {
    // Tab switching
    const tabs = document.querySelectorAll('.lyrics-tab');
    const panels = document.querySelectorAll('.tab-content');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const targetId = tab.getAttribute('data-tab');

        // Update tabs
        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        // Update panels
        panels.forEach(panel => {
          panel.classList.remove('active');
        });
        const targetPanel = document.getElementById(`panel-${targetId}`);
        if (targetPanel) {
          targetPanel.classList.add('active');
        }
      });
    });

    // Meanings interactivity
    const meaningsDataEl = document.getElementById('meanings-data');
    if (!meaningsDataEl) return;

    let meanings = [];
    try {
      meanings = JSON.parse(meaningsDataEl.textContent || '[]');
    } catch (e) {
      console.error('Failed to parse meanings data:', e);
      return;
    }

    const interactiveLines = document.querySelectorAll('.lyric-line-interactive.has-meaning');
    const meaningPlaceholder = document.querySelector('.meaning-placeholder');
    const meaningActive = document.getElementById('meaning-active');
    const meaningLineNum = document.getElementById('meaning-line-num');
    const meaningLyric = document.getElementById('meaning-lyric');
    const meaningText = document.getElementById('meaning-text');
    const meaningContributor = document.getElementById('meaning-contributor');

    let currentActiveLine = null;

    interactiveLines.forEach(line => {
      line.addEventListener('click', () => {
        const lineText = line.getAttribute('data-line');
        const lineIndex = line.getAttribute('data-line-index');

        // Find matching meaning
        const meaning = meanings.find(m => m.line === lineText);
        if (!meaning) return;

        // Update active state
        if (currentActiveLine) {
          currentActiveLine.classList.remove('active');
        }
        line.classList.add('active');
        currentActiveLine = line;

        // Update meaning panel
        if (meaningPlaceholder) meaningPlaceholder.style.display = 'none';
        if (meaningActive) meaningActive.style.display = 'block';

        if (meaningLineNum) meaningLineNum.textContent = `Line ${parseInt(lineIndex) + 1}`;
        if (meaningLyric) meaningLyric.textContent = meaning.line;
        if (meaningText) meaningText.textContent = meaning.meaning;
        if (meaningContributor) meaningContributor.textContent = meaning.contributor || 'Community';

        // Scroll the meaning panel into view on mobile
        if (window.innerWidth < 768 && meaningActive) {
          meaningActive.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      });
    });
  }

  // Bind on page load and Astro transitions
  document.addEventListener('DOMContentLoaded', initLyricsFeature);
  document.addEventListener('astro:page-load', initLyricsFeature);
</script>
