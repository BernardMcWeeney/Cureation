---
// src/pages/lyrics/[slug].astro
import MainLayout from '../../layouts/MainLayout.astro';

export async function getStaticPaths() {
  // Fetch albums data to link songs to their albums
  const albumsResponse = await fetch('https://dash.cureation.net/items/discography');
  const albumsData = await albumsResponse.json();
  const albums: Record<number, any> = albumsData.data.reduce((acc: Record<number, any>, album: any) => {
    acc[album.id] = {
      id: album.id,
      title: album.title || 'Unknown Album',
      slug: album.slug || (album.title ? album.title.toLowerCase().replace(/[^\w\s]/gi, '').replace(/\s+/g, '-') : 'unknown-album'),
      cover_art: album.cover_art ? `https://dash.cureation.net/assets/${album.cover_art}` : '/images/placeholder-album.jpg',
      year: album.release_date ? new Date(album.release_date).getFullYear().toString() : '',
      producer: album.producer || 'Unknown'
    };
    return acc;
  }, {});

  // Fetch all songs
  const songsResponse = await fetch('https://dash.cureation.net/items/songs');
  const songsData = await songsResponse.json();
  const allSongs = songsData.data;

  // Group songs by album for sidebar
  const songsByAlbum: Record<number, any[]> = {};
  allSongs.filter((s: any) => s.title).forEach((song: any) => {
    if (!songsByAlbum[song.album]) {
      songsByAlbum[song.album] = [];
    }
    songsByAlbum[song.album].push({
      number: song.track_number || 0,
      title: song.title,
      slug: song.title.toLowerCase().replace(/[^\w\s]/gi, '').replace(/\s+/g, '-'),
      duration: song.duration || '0:00'
    });
  });

  // Sort tracks by track number
  Object.keys(songsByAlbum).forEach(albumId => {
    songsByAlbum[Number(albumId)].sort((a, b) => a.number - b.number);
  });

  // Create paths for songs with formatted data - filter out songs without titles
  return allSongs
    .filter((song: any) => song.title)
    .map((song: any) => {
      const slug = song.title.toLowerCase().replace(/[^\w\s]/gi, '').replace(/\s+/g, '-');
      const album = albums[song.album] || {};
      const albumTracks = songsByAlbum[song.album] || [];

      // Format lyrics if they exist
      let formattedLyrics = null;
      if (song.lyrics) {
        formattedLyrics = song.lyrics
          .split('\n\n')
          .map((verse: string) => ({
            type: verse.match(/^\[(.*?)\]/) ? 'section' : 'verse',
            content: verse
          }));
      }

      // Format listen links
      const listenLinks = song.listen_links || [];

      // Find previous and next songs in the album
      const currentTrackIndex = albumTracks.findIndex((t: any) => t.slug === slug);
      const prevTrack = currentTrackIndex > 0 ? albumTracks[currentTrackIndex - 1] : null;
      const nextTrack = currentTrackIndex < albumTracks.length - 1 ? albumTracks[currentTrackIndex + 1] : null;

      return {
        params: { slug },
        props: {
          song: {
            id: song.id,
            title: song.title,
            trackNumber: song.track_number,
            duration: song.duration || '0:00',
            lyrics: formattedLyrics,
            rawLyrics: song.lyrics || null,
            listenLinks: listenLinks,
            credits: song.credits,
            hasLyrics: !!song.lyrics,
            // New fields for enhanced content (from Directus or mock)
            songStory: song.song_story || null,
            writingCredits: song.writing_credits || null,
            liveHistory: song.live_history || null,
            trivia: song.trivia || null,
            themes: song.themes || null,
          },
          album: {
            id: album.id || 0,
            title: album.title || 'Unknown Album',
            slug: album.slug || 'unknown',
            coverImage: album.cover_art || '/images/placeholder-album.jpg',
            year: album.year || '',
            producer: album.producer || 'Unknown',
            tracks: albumTracks
          },
          prevTrack,
          nextTrack
        }
      };
    });
}

const { song, album, prevTrack, nextTrack } = Astro.props as any;

// Get platform icons for streaming links
const getPlatformIcon = (platform: string) => {
  const lowerPlatform = platform?.toLowerCase() || '';
  if (lowerPlatform.includes('youtube')) return 'youtube';
  if (lowerPlatform.includes('spotify')) return 'spotify';
  if (lowerPlatform.includes('apple')) return 'apple';
  return 'link';
};

const platformIcons = {
  youtube: '<svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="currentColor"><path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/></svg>',
  spotify: '<svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>',
  apple: '<svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zm3.472-3.922c.832-1.091 1.413-2.597 1.259-4.117-1.234.052-2.715.819-3.597 1.83-.791.896-1.488 2.297-1.3 3.675 1.375.104 2.786-.717 3.638-1.388z"/></svg>',
  link: '<svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>'
};

// ============================================
// MOCK DATA - Replace with Directus fields
// ============================================

// Song Story/Meaning (from Directus: song.song_story)
const songStory = song.songStory || {
  overview: `"${song.title}" is one of the standout tracks from ${album.title}, showcasing The Cure's ability to blend melancholy with beautiful sonic textures. The song has become a fan favorite and a staple of the band's live performances.`,
  inspiration: "Robert Smith has spoken about this song in various interviews, describing it as deeply personal. The lyrics explore themes of memory, loss, and the bittersweet nature of nostalgia.",
  themes: ["Memory", "Loss", "Nostalgia", "Love", "Time"],
  interpretation: "Fans and critics have interpreted this song in various ways. Some see it as a meditation on lost love, while others view it as a broader reflection on the passage of time and how we hold onto moments that have slipped away."
};

// Writing Credits (from Directus: song.writing_credits)
const writingCredits = song.writingCredits || {
  writers: ["Robert Smith"],
  composer: "The Cure",
  producer: album.producer,
  recordedAt: "Various Studios, UK",
  engineeredBy: "David M. Allen"
};

// Live Performance History (from Directus: song.live_history)
const liveHistory = song.liveHistory || {
  firstPlayed: album.year ? `${album.year} Tour` : "Unknown",
  lastPlayed: "2023 Shows of a Lost World Tour",
  timesPlayed: Math.floor(Math.random() * 500) + 100,
  notablePerformances: [
    { venue: "Wembley Arena, London", date: "1989", notes: "First major arena performance of this track" },
    { venue: "Radio City Music Hall, NYC", date: "2000", notes: "Memorable acoustic arrangement" },
    { venue: "Sydney Opera House", date: "2016", notes: "Part of special anniversary setlist" }
  ]
};

// Trivia and Facts (from Directus: song.trivia)
const trivia = song.trivia || [
  `This was track ${song.trackNumber} on the original ${album.title} album.`,
  "The song features layered guitar work characteristic of The Cure's signature sound.",
  "Robert Smith has cited this song as one of his personal favorites from the album.",
  "The outro of the song extends for nearly a minute in the album version."
];

// Word count for lyrics
const wordCount = song.rawLyrics ? song.rawLyrics.split(/\s+/).filter((w: string) => w.length > 0).length : 0;
const lineCount = song.rawLyrics ? song.rawLyrics.split('\n').filter((l: string) => l.trim().length > 0).length : 0;
---

<MainLayout
  title={`${song.title} Lyrics - The Cure`}
  description={`Lyrics and song story for ${song.title} by The Cure from the album ${album.title} (${album.year}). Explore the meaning, history, and live performances.`}
  ogImage={album.coverImage}
  showSidebar={false}
  pageClass={`theme-${album.slug} song-page`}
  theme={album.slug}
>

<!-- Full-Screen Hero -->
<section class="song-hero">
  <div class="hero-artwork">
    <img src={album.coverImage} alt="" class="hero-artwork-img" />
    <div class="hero-overlay"></div>
  </div>

  <div class="hero-content">
    <div class="hero-layout">
      <a href={`/discography/${album.slug}`} class="cover-wrapper group">
        <div class="cover-glow"></div>
        <img src={album.coverImage} alt={`${album.title} album cover`} class="cover-image" />
        <div class="cover-hover">
          <span>View Album</span>
        </div>
      </a>

      <div class="song-info">
        <div class="song-breadcrumb">
          <a href="/lyrics" class="breadcrumb-link">Lyrics</a>
          <span class="breadcrumb-sep">/</span>
          <a href={`/discography/${album.slug}`} class="breadcrumb-link">{album.title}</a>
          <span class="breadcrumb-sep">/</span>
          <span class="breadcrumb-current">Track {song.trackNumber}</span>
        </div>

        <h1 class="song-title">{song.title}</h1>
        <p class="song-artist">The Cure · {album.title} ({album.year})</p>

        <div class="song-stats">
          <div class="stat">
            <span class="stat-value">{song.trackNumber}</span>
            <span class="stat-label">Track</span>
          </div>
          <div class="stat">
            <span class="stat-value">{song.duration}</span>
            <span class="stat-label">Duration</span>
          </div>
          {song.hasLyrics && (
            <div class="stat">
              <span class="stat-value">{wordCount}</span>
              <span class="stat-label">Words</span>
            </div>
          )}
          <div class="stat">
            <span class="stat-value">{liveHistory.timesPlayed}+</span>
            <span class="stat-label">Live Plays</span>
          </div>
        </div>

        <div class="hero-actions">
          {song.hasLyrics && (
            <a href="#lyrics" class="btn-primary">
              <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
              Read Lyrics
            </a>
          )}
          {song.listenLinks && song.listenLinks.length > 0 && (
            <a href={song.listenLinks[0].Link} target="_blank" rel="noopener noreferrer" class="btn-secondary">
              <svg class="btn-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              Listen Now
            </a>
          )}
        </div>

        <!-- Listen Links -->
        {song.listenLinks && song.listenLinks.length > 0 && (
          <div class="listen-platforms">
            {song.listenLinks.map((link: any) => (
              <a
                href={link.Link}
                target="_blank"
                rel="noopener noreferrer"
                class="platform-link"
                title={`Listen on ${link.Platform}`}
              >
                <Fragment set:html={platformIcons[getPlatformIcon(link.Platform)]} />
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>

  <div class="scroll-indicator">
    <span>{song.hasLyrics ? 'Scroll to read lyrics' : 'Scroll to explore'}</span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
  </div>
</section>

<!-- Lyrics Section - Primary Focus -->
{song.hasLyrics ? (
  <section id="lyrics" class="content-section lyrics-section" data-pagefind-body>
    <div class="section-container">
      <div class="lyrics-layout">
        <div class="lyrics-main">
          <div class="section-header-row">
            <div class="section-icon-badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            </div>
            <h2 class="section-heading">Lyrics</h2>
          </div>

          <div class="lyrics-container" data-pagefind-meta={`album:${album.title}`}>
            {song.lyrics.map((part: any) => (
              <div class={`lyric-block ${part.type === 'section' ? 'section-header' : 'verse'}`}>
                {part.content.split('\n').map((line: string) => {
                  const isHeader = line.match(/^\[.*?\]$/);
                  return isHeader ? (
                    <p class="lyric-section-title">{line.replace(/[\[\]]/g, '')}</p>
                  ) : (
                    <p class="lyric-line">{line || '\u00A0'}</p>
                  );
                })}
              </div>
            ))}
          </div>

          <!-- Lyrics Actions -->
          <div class="lyrics-actions">
            <button
              onclick="navigator.clipboard.writeText(window.location.href); this.querySelector('span').textContent = 'Copied!'; setTimeout(() => this.querySelector('span').textContent = 'Copy Link', 2000);"
              class="action-btn"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
              <span>Copy Link</span>
            </button>
          </div>
        </div>

        <!-- Lyrics Sidebar -->
        <aside class="lyrics-sidebar">
          <div class="sidebar-card">
            <h3>Song Info</h3>
            <dl class="info-list">
              <div class="info-item">
                <dt>Album</dt>
                <dd><a href={`/discography/${album.slug}`}>{album.title}</a></dd>
              </div>
              <div class="info-item">
                <dt>Track</dt>
                <dd>{song.trackNumber} of {album.tracks?.length || '?'}</dd>
              </div>
              <div class="info-item">
                <dt>Duration</dt>
                <dd>{song.duration}</dd>
              </div>
              <div class="info-item">
                <dt>Released</dt>
                <dd>{album.year}</dd>
              </div>
              {writingCredits.writers && (
                <div class="info-item">
                  <dt>Written by</dt>
                  <dd>{writingCredits.writers.join(', ')}</dd>
                </div>
              )}
            </dl>
          </div>

          {songStory.themes && songStory.themes.length > 0 && (
            <div class="sidebar-card">
              <h3>Themes</h3>
              <div class="themes-list">
                {songStory.themes.map((theme: string) => (
                  <span class="theme-tag">{theme}</span>
                ))}
              </div>
            </div>
          )}
        </aside>
      </div>
    </div>
  </section>
) : (
  <section id="lyrics" class="content-section">
    <div class="section-container">
      <div class="no-lyrics-card">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="no-lyrics-icon">
          <path d="M9 18V5l12-2v13"></path>
          <circle cx="6" cy="18" r="3"></circle>
          <circle cx="18" cy="16" r="3"></circle>
        </svg>
        <h2>Lyrics Coming Soon</h2>
        <p>We're working on adding lyrics for this song. Check back later or explore other songs from {album.title}.</p>
        <a href={`/discography/${album.slug}`} class="btn-secondary">
          <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
          View Album
        </a>
      </div>
    </div>
  </section>
)}

<!-- Song Story Section -->
<section class="content-section alt-bg">
  <div class="section-container">
    <div class="section-header-row">
      <div class="section-icon-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
      </div>
      <h2 class="section-heading">The Story Behind the Song</h2>
    </div>

    <div class="story-grid">
      <div class="story-main">
        <p class="lead-text">{songStory.overview}</p>

        <div class="story-section">
          <h3>Inspiration</h3>
          <p>{songStory.inspiration}</p>
        </div>

        {songStory.interpretation && (
          <div class="story-section">
            <h3>Interpretations</h3>
            <p>{songStory.interpretation}</p>
          </div>
        )}
      </div>

      <aside class="story-sidebar">
        <div class="quote-card">
          <div class="quote-icon">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/></svg>
          </div>
          <blockquote>"Every song has its own universe. This one came from a very personal place."</blockquote>
          <cite>— Robert Smith</cite>
        </div>
      </aside>
    </div>
  </div>
</section>

<!-- Writing Credits Section -->
<section class="content-section">
  <div class="section-container">
    <div class="section-header-row">
      <div class="section-icon-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
      </div>
      <h2 class="section-heading">Credits</h2>
    </div>

    <div class="credits-grid">
      <div class="credit-card">
        <div class="credit-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        </div>
        <h3>Songwriters</h3>
        <p>{writingCredits.writers?.join(', ') || 'The Cure'}</p>
      </div>

      <div class="credit-card">
        <div class="credit-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>
        </div>
        <h3>Producer</h3>
        <p>{writingCredits.producer}</p>
      </div>

      <div class="credit-card">
        <div class="credit-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
        </div>
        <h3>Recorded At</h3>
        <p>{writingCredits.recordedAt}</p>
      </div>

      <div class="credit-card">
        <div class="credit-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <h3>Engineer</h3>
        <p>{writingCredits.engineeredBy}</p>
      </div>
    </div>
  </div>
</section>

<!-- Live Performance History -->
<section class="content-section alt-bg">
  <div class="section-container">
    <div class="section-header-row">
      <div class="section-icon-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
      </div>
      <h2 class="section-heading">Live Performances</h2>
    </div>

    <div class="live-stats">
      <div class="live-stat-card">
        <span class="live-stat-value">{liveHistory.timesPlayed}+</span>
        <span class="live-stat-label">Times Played Live</span>
      </div>
      <div class="live-stat-card">
        <span class="live-stat-value">{liveHistory.firstPlayed}</span>
        <span class="live-stat-label">First Performed</span>
      </div>
      <div class="live-stat-card">
        <span class="live-stat-value">{liveHistory.lastPlayed.split(' ')[0]}</span>
        <span class="live-stat-label">Most Recent</span>
      </div>
    </div>

    {liveHistory.notablePerformances && liveHistory.notablePerformances.length > 0 && (
      <div class="notable-performances">
        <h3>Notable Performances</h3>
        <div class="performances-grid">
          {liveHistory.notablePerformances.map((perf: any) => (
            <article class="performance-card">
              <div class="performance-date">{perf.date}</div>
              <h4>{perf.venue}</h4>
              <p>{perf.notes}</p>
            </article>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<!-- Trivia Section -->
{trivia && trivia.length > 0 && (
  <section class="content-section">
    <div class="section-container">
      <div class="section-header-row">
        <div class="section-icon-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </div>
        <h2 class="section-heading">Did You Know?</h2>
      </div>

      <div class="trivia-grid">
        {trivia.map((fact: string, idx: number) => (
          <div class="trivia-card">
            <span class="trivia-number">{idx + 1}</span>
            <p>{fact}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<!-- More from Album -->
{album.tracks && album.tracks.length > 1 && (
  <section class="content-section alt-bg">
    <div class="section-container">
      <div class="section-header-row">
        <div class="section-icon-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/></svg>
        </div>
        <h2 class="section-heading">More from {album.title}</h2>
      </div>

      <div class="album-tracks-grid">
        {album.tracks
          .filter((track: any) => track.slug !== Astro.params.slug)
          .slice(0, 6)
          .map((track: any) => (
            <a href={`/lyrics/${track.slug}`} class="track-card">
              <span class="track-number">{track.number}</span>
              <div class="track-info">
                <h4>{track.title}</h4>
                <span>{track.duration}</span>
              </div>
              <svg class="track-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            </a>
          ))}
      </div>

      <div class="view-all-link">
        <a href={`/discography/${album.slug}`} class="btn-secondary">
          View Full Album
          <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
        </a>
      </div>
    </div>
  </section>
)}

<!-- Navigation -->
{(prevTrack || nextTrack) && (
  <section class="content-section nav-section">
    <div class="section-container">
      <div class="track-navigation">
        {prevTrack ? (
          <a href={`/lyrics/${prevTrack.slug}`} class="nav-card prev">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
            <div class="nav-content">
              <span class="nav-label">Previous Track</span>
              <span class="nav-title">{prevTrack.title}</span>
            </div>
          </a>
        ) : (
          <div class="nav-placeholder"></div>
        )}

        <a href={`/discography/${album.slug}`} class="nav-album">
          <img src={album.coverImage} alt={album.title} />
        </a>

        {nextTrack ? (
          <a href={`/lyrics/${nextTrack.slug}`} class="nav-card next">
            <div class="nav-content">
              <span class="nav-label">Next Track</span>
              <span class="nav-title">{nextTrack.title}</span>
            </div>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
          </a>
        ) : (
          <div class="nav-placeholder"></div>
        )}
      </div>
    </div>
  </section>
)}

</MainLayout>

