---
import MainLayout from '../../layouts/MainLayout.astro';
import { getPhotos, getPhotoTours, fetchAlbums, formatAlbum } from '../../lib/directus';

// Fetch photos and filter options
const [photos, tours, albumsRaw] = await Promise.all([
  getPhotos(),
  getPhotoTours(),
  fetchAlbums()
]);

const albums = albumsRaw.map(formatAlbum);
const featuredPhotos = photos.filter(p => p.isFeatured);
---

<MainLayout
  title="Photo Gallery"
  description="Photos of The Cure through the years - live performances, studio sessions, and more"
>
  {/* Hero section */}
  <section class="mb-12">
    <div class="glass-panel overflow-hidden relative">
      <div class="absolute -top-20 -left-20 w-64 h-64 rounded-full bg-primary/10 blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-10 -right-10 w-48 h-48 rounded-full bg-accent/[0.06] blur-2xl pointer-events-none"></div>

      <div class="relative p-8 md:p-12">
        <h1 class="font-display text-5xl md:text-6xl lg:text-7xl text-white mb-4 text-glow">Photo Gallery</h1>
        <p class="text-white/75 text-lg md:text-xl max-w-3xl leading-relaxed">
          Visual history of The Cure through the decades — live performances, studio sessions,
          promotional shoots, and candid moments.
        </p>

        <div class="flex flex-wrap gap-8 mt-8 pt-6 border-t border-white/[0.08]">
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-primary text-glow">{photos.length}</span>
            <span class="text-white/60 text-base font-medium">Photos</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-primary text-glow">{tours.length}</span>
            <span class="text-white/60 text-base font-medium">Tours</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-primary text-glow">{albums.length}</span>
            <span class="text-white/60 text-base font-medium">Album Eras</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Filter tabs */}
  <section class="mb-8">
    <div class="flex flex-wrap gap-2">
      <button
        class="filter-btn active px-4 py-2 rounded-lg glass-button text-sm"
        data-filter="all"
      >
        All Photos
      </button>
      <button
        class="filter-btn px-4 py-2 rounded-lg glass-button text-sm"
        data-filter="live"
      >
        Live
      </button>
      <button
        class="filter-btn px-4 py-2 rounded-lg glass-button text-sm"
        data-filter="studio"
      >
        Studio
      </button>
      <button
        class="filter-btn px-4 py-2 rounded-lg glass-button text-sm"
        data-filter="promotional"
      >
        Promotional
      </button>
      <button
        class="filter-btn px-4 py-2 rounded-lg glass-button text-sm"
        data-filter="candid"
      >
        Candid
      </button>
    </div>
  </section>

  {/* Photo grid */}
  <section>
    {photos.length > 0 ? (
      <div class="photo-grid columns-1 sm:columns-2 lg:columns-3 xl:columns-4 gap-4">
        {photos.map((photo, index) => (
          <a
            href={`/gallery/photo/${photo.id}`}
            class="photo-card group block mb-4 break-inside-avoid"
            data-tags={photo.tags.join(',')}
            style={`--index: ${index}`}
          >
            <div class="relative overflow-hidden rounded-xl glass-tile animate-fade-in">
              <img
                src={photo.imageUrl}
                alt={photo.title}
                class="w-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
              />

              {/* Overlay */}
              <div class="absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                <div class="absolute bottom-0 left-0 right-0 p-4">
                  <h3 class="text-white font-medium text-sm line-clamp-1">{photo.title}</h3>
                  {photo.formattedDate && (
                    <p class="text-white/60 text-xs mt-1">{photo.formattedDate}</p>
                  )}
                </div>
              </div>

              {/* Featured badge */}
              {photo.isFeatured && (
                <div class="absolute top-3 right-3 p-1.5 rounded-full bg-yellow-500/20 backdrop-blur-md border border-yellow-500/40">
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-yellow-400 fill-yellow-400" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                  </svg>
                </div>
              )}

              {/* Tags */}
              {photo.tags.length > 0 && (
                <div class="absolute top-3 left-3 flex gap-1">
                  {photo.tags.slice(0, 2).map(tag => (
                    <span class="px-2 py-0.5 rounded-full bg-black/50 backdrop-blur-md border border-white/20 text-white/80 text-xs capitalize">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="glass-tile p-12 text-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-16 text-white/20 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <p class="text-white/60 mb-4">No photos available yet.</p>
        <p class="text-white/40 text-sm">Check back soon for gallery content.</p>
      </div>
    )}
  </section>

  {/* Browse by tour */}
  {tours.length > 0 && (
    <section class="mt-16">
      <h2 class="text-2xl text-white mb-6">Browse by Tour</h2>
      <div class="flex flex-wrap gap-2">
        {tours.map(tour => (
          <a
            href={`/gallery/tour/${tour.toLowerCase().replace(/\s+/g, '-')}`}
            class="px-4 py-2 rounded-lg glass-button text-sm text-white/70 hover:text-primary transition-colors"
          >
            {tour}
          </a>
        ))}
      </div>
    </section>
  )}
</MainLayout>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fadeIn 0.5s ease forwards;
    animation-delay: calc(var(--index, 0) * 50ms);
    opacity: 0;
  }

  .filter-btn.active {
    background: rgba(var(--color-primary-rgb), 0.2);
    border-color: rgba(var(--color-primary-rgb), 0.4);
    color: var(--color-primary);
  }

  .line-clamp-1 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
  }
</style>

<script>
  function initGalleryFilters() {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const photoCards = document.querySelectorAll('.photo-card');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        // Update active state
        filterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.getAttribute('data-filter');

        photoCards.forEach(card => {
          const tags = card.getAttribute('data-tags') || '';

          if (filter === 'all' || tags.includes(filter)) {
            (card as HTMLElement).style.display = 'block';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initGalleryFilters);
  document.addEventListener('astro:page-load', initGalleryFilters);
</script>
