---
import { editable, copyText, copyAttr, copySource, copyTuple } from '../lib/visual-editing';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/ui/PageHero.astro';
import { getRunningFigures } from '../lib/directus';
const fig = await getRunningFigures().catch(() => ({ albums: null, songs: null, setlists: null, venues: null, photos: null, members: null }));
const launched = 'February 2022';

const milestones: Array<[string, string, string]> = [
  copyTuple([copyText("pages_about_tuple-d696e5b7ddf5", "February 2022"), copyText("pages_about_tuple-4cfda863b5d9", "A fan page begins"), copyText("pages_about_tuple-9649a65ac666", "Cureation started as a fan page on Twitter, now X, sharing and collecting pieces of The Cure history.")], {"0":"pages_about_tuple-d696e5b7ddf5","1":"pages_about_tuple-4cfda863b5d9","2":"pages_about_tuple-9649a65ac666"}),
  copyTuple([copyText("pages_about_tuple-50be97d365c7", "Early versions"), copyText("pages_about_tuple-cadc399b097c", "Setlists and discography"), copyText("pages_about_tuple-b7ce74ce682a", "The site first grew around the core archive work: a setlist log and a discography log.")], {"0":"pages_about_tuple-50be97d365c7","1":"pages_about_tuple-cadc399b097c","2":"pages_about_tuple-b7ce74ce682a"}),
  copyTuple([copyText("pages_about_tuple-c21aa4f56a18", "Now"), copyText("pages_about_tuple-a96c35d4918f", "A connected archive"), copyText("pages_about_tuple-4524a8eb5f72", "The archive keeps expanding through linked data, editorial records, photos, venues, sources, and other details around the band.")], {"0":"pages_about_tuple-c21aa4f56a18","1":"pages_about_tuple-a96c35d4918f","2":"pages_about_tuple-4524a8eb5f72"}),
  copyTuple([copyText("pages_about_tuple-e4a6b59bf58d", "Always"), copyText("pages_about_tuple-c92dd93345d3", "Open to correction"), copyText("pages_about_tuple-17604624f70e", "Dates, credits, lineups, venues, and sources can be corrected as better evidence comes to light.")], {"0":"pages_about_tuple-e4a6b59bf58d","1":"pages_about_tuple-c92dd93345d3","2":"pages_about_tuple-17604624f70e"}),
];

const pillars: Array<[string, string]> = [
  copyTuple([copyText("pages_about_tuple-13fdb01dc38e", "Fan archive"), copyText("pages_about_tuple-ec16939637aa", "Cureation is dedicated to The Cure and built for people who want to explore the band in detail.")], {"0":"pages_about_tuple-13fdb01dc38e","1":"pages_about_tuple-ec16939637aa"}),
  copyTuple([copyText("pages_about_tuple-b8c97d50760b", "Verified where possible"), copyText("pages_about_tuple-1f57cf628f40", "The aim is to use primary verified sources wherever possible, supported by reliable secondary sources when needed.")], {"0":"pages_about_tuple-b8c97d50760b","1":"pages_about_tuple-1f57cf628f40"}),
  copyTuple([copyText("pages_about_tuple-d2f5ee385bbb", "Non-commercial"), copyText("pages_about_tuple-ceff345919a6", "Cureation is a one-person passion project, maintained without ads, affiliate links, or commercial backing.")], {"0":"pages_about_tuple-d2f5ee385bbb","1":"pages_about_tuple-ceff345919a6"}),
  copyTuple([copyText("pages_about_tuple-6be1d35f3b32", "Open corrections"), copyText("pages_about_tuple-8af98bbbd4ff", "If a date, lineup, venue, writer credit, or attribution is wrong, corrections are welcome and will be updated accordingly.")], {"0":"pages_about_tuple-6be1d35f3b32","1":"pages_about_tuple-8af98bbbd4ff"}),
];
---
<Layout title="About · Cureation">
  <PageHero copyKeys={{"section":"pages_about_442785eff4ff","title":"pages_about_674fc30e6d6a","deck":"pages_about_909b2f6331c2"}}
    section={copyText("pages_about_442785eff4ff", "Independent fan archive")}
    title={copyText("pages_about_674fc30e6d6a", "Welcome to Cureation.")}
    deck={copyText("pages_about_909b2f6331c2", "A one-person, non-commercial archive built to capture, connect and preserve as much of The Cure's history as possible.")}
    crumbs={[{ ...copySource({"label":"pages_about_data-a5b09f89a97d"}),  label: copyText("pages_about_data-a5b09f89a97d", "Home"), href: '/' }, { ...copySource({"label":"pages_about_data-01779f584efe"}),  label: copyText("pages_about_data-01779f584efe", "About") }]}
    facts={[
      { ...copySource({"k":"pages_about_data-9473d96e7c05"}),  k: copyText("pages_about_data-9473d96e7c05", "Founded"), v: launched },
      { ...copySource({"k":"pages_about_data-5d56c46fbf3f","v":"pages_about_data-ea83ab9b1148"}),  k: copyText("pages_about_data-5d56c46fbf3f", "Curated by"), v: copyText("pages_about_data-ea83ab9b1148", "Bernard Mcweeney") },
      { ...copySource({"k":"pages_about_data-01eaa608010f","v":"pages_about_data-623ed9193b8b"}),  k: copyText("pages_about_data-01eaa608010f", "Based in"), v: copyText("pages_about_data-623ed9193b8b", "Ireland") },
      { ...copySource({"k":"pages_about_data-a26d5354e5e5","v":"pages_about_data-8c35fee1f337"}),  k: copyText("pages_about_data-a26d5354e5e5", "Status"), v: copyText("pages_about_data-8c35fee1f337", "Independent") },
    ]}
  />

  <section class="about-section">
    <div class="container about-split">
      <header class="about-heading">
        <span data-directus={copyAttr("pages_about_3f4d6a530f51")} set:html={copyText("pages_about_3f4d6a530f51", "The project")}></span>
        <h2>The project</h2>
      </header>
      <div class="copy-block">
          <p data-directus={copyAttr("pages_about_3c3bfe356933")} set:html={copyText("pages_about_3c3bfe356933", "\n            The aim of Cureation is to become one source for all things The Cure: releases, songs, setlists, tours, venues, people, photographs, sources, and the many details that sit around the music.\n          ")}></p>
          <p data-directus={copyAttr("pages_about_30ad3bd83fd4")} set:html={copyText("pages_about_30ad3bd83fd4", "\n            Cureation is run by Bernard Mcweeney, based in Ireland. What started as a fan page on Twitter, now X, in February 2022 has grown into a strong foundation for a wider archive, website, and social media presence.\n          ")}></p>
          <p data-directus={copyAttr("pages_about_9007adacee84")} set:html={copyText("pages_about_9007adacee84", "\n            The archive exists because The Cure have a long history and a lot of data. The goal is to record as much of it as possible, and to do that with care.\n          ")}></p>
      </div>
    </div>
  </section>

  <section class="about-section about-section--soft">
    <div class="container">
      <header class="about-heading about-heading--row">
        <div><span data-directus={copyAttr("pages_about_c7361454d10d")} set:html={copyText("pages_about_c7361454d10d", "Mission")}></span><h2>How the archive is maintained</h2></div>
        <p data-directus={copyAttr("pages_about_d26d6d91d5e4")} set:html={copyText("pages_about_d26d6d91d5e4", "Every claim should lead back to evidence. Every mistake should be easy to correct.")}></p>
      </header>
      <div class="value-grid">
        {pillars.map((__copyRow5434, i) => { const [k, v] = __copyRow5434; return (
          <article class="value-card">
            <span>{String(i + 1).padStart(2, '0')}</span>
            <div><h3 data-directus={editable(__copyRow5434, ["0"])}>{k}</h3><p data-directus={editable(__copyRow5434, ["1"])}>{v}</p></div>
          </article>
        ); })}
      </div>
    </div>
  </section>

  <section class="about-figures">
    <div class="container">
      <div class="about-figures__head"><span data-directus={copyAttr("pages_about_a047b8a5b41d")} set:html={copyText("pages_about_a047b8a5b41d", "Running figures")}></span><small data-directus={copyAttr("pages_about_4c8ecd2cc0a9")} set:html={copyText("pages_about_4c8ecd2cc0a9", "As of today")}></small></div>
      <div data-directus={editable(fig, ["albums","songs","setlists","venues","photos","members"])} class="about-figures__grid">
        {[
          ['Studio records', fig.albums],
          ['Songs catalogued', fig.songs],
          ['Setlists on file', fig.setlists],
          ['Venues mapped', fig.venues],
          ['Archive photographs', fig.photos],
          ['Band members', fig.members],
        ].map((__copyRow6451) => { const [k, v] = __copyRow6451; return (
          <div><strong>{typeof v === 'number' ? v.toLocaleString() : 'Unavailable'}</strong><span data-directus={editable(__copyRow6451, ["0"])}>{k}</span></div>
        ); })}
      </div>
    </div>
  </section>

  <section class="about-section">
    <div class="container">
      <header class="about-heading"><span data-directus={copyAttr("pages_about_a67bca9b55a5")} set:html={copyText("pages_about_a67bca9b55a5", "A chronology of the project")}></span><h2>Project history</h2></header>
      <div class="milestone-grid">
      {milestones.map((__copyRow7072, i) => { const [date, title, body] = __copyRow7072; return (
        <article class="milestone-card">
          <span data-directus={editable(__copyRow7072, ["0"])}>{String(i + 1).padStart(2, '0')} · {date}</span>
          <h3 data-directus={editable(__copyRow7072, ["1"])}>{title}</h3>
          <p data-directus={editable(__copyRow7072, ["2"])}>{body}</p>
        </article>
      ); })}
      </div>
    </div>
  </section>

  <section class="about-section about-section--soft">
    <div class="container about-split">
      <header class="about-heading"><span data-directus={copyAttr("pages_about_20237f1b54c5")} set:html={copyText("pages_about_20237f1b54c5", "Technology")}></span><h2>Technology</h2></header>
      <div>
        <div class="technology-grid">
          <div><span data-directus={copyAttr("pages_about_b643bf90c4a3")} set:html={copyText("pages_about_b643bf90c4a3", "Curator")}></span><strong data-directus={copyAttr("pages_about_29d0d99e4f6f")} set:html={copyText("pages_about_29d0d99e4f6f", "Bernard Mcweeney")}></strong></div>
          <div><span data-directus={copyAttr("pages_about_4f3954ab5ce7")} set:html={copyText("pages_about_4f3954ab5ce7", "Backend")}></span><strong data-directus={copyAttr("pages_about_d5faf172d342")} set:html={copyText("pages_about_d5faf172d342", "Directus")}></strong></div>
          <div><span data-directus={copyAttr("pages_about_b8bccb82891f")} set:html={copyText("pages_about_b8bccb82891f", "Frontend")}></span><strong data-directus={copyAttr("pages_about_8b386f385dca")} set:html={copyText("pages_about_8b386f385dca", "Astro · Tailwind CSS")}></strong></div>
          <div><span data-directus={copyAttr("pages_about_d29672b5df8a")} set:html={copyText("pages_about_d29672b5df8a", "Hosting")}></span><strong data-directus={copyAttr("pages_about_86a88da1409b")} set:html={copyText("pages_about_86a88da1409b", "Cloudflare")}></strong></div>
        </div>
        <div class="copy-block technology-copy">
          <p data-directus={copyAttr("pages_about_8017b2206804")} set:html={copyText("pages_about_8017b2206804", "\n            Cureation uses open source software as much as possible. The backend is powered by Directus, an open source backend that gives the archive flexibility for data modelling and makes it easier to add and update records.\n          ")}></p>
          <p data-directus={copyAttr("pages_about_1fe0cd2245ef")} set:html={copyText("pages_about_1fe0cd2245ef", "\n            The frontend is built with Astro and Tailwind CSS. Astro is the frontend framework behind the website, while Tailwind CSS helps shape the design system and styling.\n          ")}></p>
        </div>
      </div>
    </div>
  </section>

  <section class="about-thanks">
    <div class="container">
      <span data-directus={copyAttr("pages_about_e8ee63387fca")} set:html={copyText("pages_about_e8ee63387fca", "A note of thanks")}></span>
      <blockquote data-directus={copyAttr("pages_about_5f09fed8d996")} set:html={copyText("pages_about_5f09fed8d996", "“This archive would be pointless without people who care about The Cure, find something useful here and know when a detail needs correcting.”")}></blockquote>
      <p data-directus={copyAttr("pages_about_157eda518560")} set:html={copyText("pages_about_157eda518560", "Thank you for reading, exploring and helping keep the record straight.")}></p>
    </div>
  </section>

</Layout>

<style>
  .about-section { padding-block: clamp(28px, 4vw, 48px); }
  .about-section--soft { background: var(--bg-2); }
  .about-split { display: grid; grid-template-columns: minmax(0, .82fr) minmax(360px, 1.18fr); gap: clamp(48px, 9vw, 140px); align-items: start; }
  .about-heading > span, .about-figures__head, .about-thanks > .container > span { color: var(--accent); font-family: var(--f-ui); font-size: var(--text-label); font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
  .about-heading h2 { margin: 10px 0 0; color: var(--ink); font-family: var(--f-display); font-size: clamp(28px, 3vw, 40px); font-weight: 400; letter-spacing: -.06em; line-height: 1.1; }
  .about-heading h2 :global(em) { color: var(--accent); font-weight: inherit; }
  .about-heading--row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, .42fr); gap: 48px; align-items: end; margin-bottom: clamp(42px, 6vw, 78px); }
  .about-heading--row > p { max-width: 36ch; margin: 0; color: var(--ink-2); font-size: var(--text-small); line-height: 1.6; }
  .copy-block { display: grid; gap: 1rem; max-width: 62ch; }
  .copy-block p { color: var(--ink-2); font-family: var(--f-serif); font-size: clamp(18px, 1.55vw, 22px); line-height: 1.68; margin: 0; }
  .value-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; background: var(--rule); }
  .value-card { position: relative; min-height: 330px; display: flex; flex-direction: column; padding: clamp(24px, 3vw, 42px); background: var(--bg); }
  .value-card::after { position: absolute; right: 0; bottom: 0; left: 0; height: 4px; content: ''; background: var(--accent); }
  .value-card > span, .milestone-card > span, .technology-grid span { color: var(--accent); font-family: var(--f-ui); font-size: var(--text-label); font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
  .value-card > div { margin-top: auto; }
  .value-card h3, .milestone-card h3 { margin: 0; color: var(--ink); font-family: var(--f-display); font-size: clamp(31px, 3vw, 45px); font-style: italic; font-weight: 400; line-height: .95; }
  .value-card p, .milestone-card p { margin: 15px 0 0; color: var(--ink-2); font-size: var(--text-small); line-height: 1.58; }
  .about-figures { padding-block: clamp(54px, 7vw, 92px); background: var(--accent); color: var(--accent-ink); }
  .about-figures__head { display: flex; justify-content: space-between; color: var(--accent-ink); }
  .about-figures__head small { font: inherit; }
  .about-figures__grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 18px; margin-top: clamp(30px, 4vw, 52px); }
  .about-figures__grid :global(strong) { display: block; font-family: var(--f-display); font-size: clamp(42px, 5vw, 76px); font-weight: 400; letter-spacing: -.05em; line-height: 1.1; }
  .about-figures__grid span { display: block; margin-top: 12px; font-family: var(--f-ui); font-size: var(--text-label); font-weight: 600; letter-spacing: .12em; line-height: 1.35; text-transform: uppercase; }
  .milestone-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(16px, 2vw, 28px); margin-top: clamp(44px, 6vw, 76px); }
  .milestone-card { min-height: 300px; padding: clamp(24px, 2.8vw, 38px); background: linear-gradient(145deg, var(--accent-tint), transparent 56%), var(--bg-2); }
  .milestone-card h3 { margin-top: clamp(54px, 6vw, 88px); }
  .technology-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .technology-grid > div { min-height: 126px; display: flex; flex-direction: column; justify-content: space-between; padding: 20px; background: var(--bg); }
  .technology-grid :global(strong) { color: var(--ink); font-family: var(--f-display); font-size: clamp(21px, 2vw, 29px); font-weight: 400; line-height: 1.1; }
  .technology-copy { margin-top: 32px; }
  .about-thanks { padding-block: clamp(90px, 12vw, 170px); background: radial-gradient(circle at 88% 20%, var(--accent-tint-2), transparent 30%), var(--bg); }
  .about-thanks blockquote { max-width: 19ch; margin: 24px 0; color: var(--ink); font-family: var(--f-display); font-size: clamp(42px, 6.5vw, 88px); font-style: italic; line-height: .94; }
  .about-thanks p { color: var(--ink-2); font-size: 18px; }
  @media (max-width: 1120px) { .value-grid, .milestone-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .about-figures__grid { grid-template-columns: repeat(3, 1fr); gap: 34px 18px; } }
  @media (max-width: 860px) { .about-split, .about-heading--row { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .value-grid, .milestone-grid, .technology-grid { grid-template-columns: 1fr; } .value-card, .milestone-card { min-height: 260px; } .about-figures__grid { grid-template-columns: repeat(2, 1fr); } }
</style>
