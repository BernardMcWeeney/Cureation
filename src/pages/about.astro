---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/ui/PageHero.astro';
import { getRunningFigures } from '../lib/directus';
const fig = await getRunningFigures().catch(() => ({ albums: 0, songs: 0, setlists: 0, venues: 0, photos: 0, members: 0 }));
const launched = 'February 2022';

const milestones: Array<[string, string, string]> = [
  ['February 2022', 'A fan page begins', 'Cureation started as a fan page on Twitter, now X, sharing and collecting pieces of The Cure history.'],
  ['Early versions', 'Setlists and discography', 'The site first grew around the core archive work: a setlist log and a discography log.'],
  ['Now', 'A connected archive', 'The archive keeps expanding through linked data, editorial records, photos, venues, sources, and other details around the band.'],
  ['Always', 'Open to correction', 'Dates, credits, lineups, venues, and sources can be corrected as better evidence comes to light.'],
];

const pillars: Array<[string, string]> = [
  ['Fan archive', 'Cureation is dedicated to The Cure and built for people who want to explore the band in detail.'],
  ['Verified where possible', 'The aim is to use primary verified sources wherever possible, supported by reliable secondary sources when needed.'],
  ['Non-commercial', 'Cureation is a one-person passion project, maintained without ads, affiliate links, or commercial backing.'],
  ['Open corrections', 'If a date, lineup, venue, writer credit, or attribution is wrong, corrections are welcome and will be updated accordingly.'],
];
---
<Layout title="About · Cureation">
  <PageHero
    section="Independent fan archive"
    title="Welcome to Cureation."
    deck="A one-person, non-commercial archive built to capture, connect and preserve as much of The Cure's history as possible."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'About' }]}
    facts={[
      { k: 'Founded', v: launched },
      { k: 'Curated by', v: 'Bernard Mcweeney' },
      { k: 'Based in', v: 'Ireland' },
      { k: 'Status', v: 'Independent' },
    ]}
  />

  <section class="about-section">
    <div class="container about-split">
      <header class="about-heading">
        <span>The project</span>
        <h2>One place for<br /><em>all of it.</em></h2>
      </header>
      <div class="copy-block">
          <p>
            The aim of Cureation is to become one source for all things The Cure: releases, songs, setlists, tours, venues, people, photographs, sources, and the many details that sit around the music.
          </p>
          <p>
            Cureation is run by Bernard Mcweeney, based in Ireland. What started as a fan page on Twitter, now X, in February 2022 has grown into a strong foundation for a wider archive, website, and social media presence.
          </p>
          <p>
            The archive exists because The Cure have a long history and a lot of data. The goal is to record as much of it as possible, and to do that with care.
          </p>
      </div>
    </div>
  </section>

  <section class="about-section about-section--soft">
    <div class="container">
      <header class="about-heading about-heading--row">
        <div><span>Mission</span><h2>Collected carefully.<br /><em>Corrected openly.</em></h2></div>
        <p>Every claim should lead back to evidence. Every mistake should be easy to correct.</p>
      </header>
      <div class="value-grid">
        {pillars.map(([k, v], i) => (
          <article class="value-card">
            <span>{String(i + 1).padStart(2, '0')}</span>
            <div><h3>{k}</h3><p>{v}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="about-figures">
    <div class="container">
      <div class="about-figures__head"><span>Running figures</span><small>As of today</small></div>
      <div class="about-figures__grid">
        {[
          ['Studio records', fig.albums],
          ['Songs catalogued', fig.songs],
          ['Setlists on file', fig.setlists],
          ['Venues mapped', fig.venues],
          ['Archive photographs', fig.photos],
          ['Band members', fig.members],
        ].map(([k, v]) => (
          <div><strong>{(v as number).toLocaleString()}</strong><span>{k}</span></div>
        ))}
      </div>
    </div>
  </section>

  <section class="about-section">
    <div class="container">
      <header class="about-heading"><span>A chronology of the project</span><h2>From fan page<br /><em>to living archive.</em></h2></header>
      <div class="milestone-grid">
      {milestones.map(([date, title, body], i) => (
        <article class="milestone-card">
          <span>{String(i + 1).padStart(2, '0')} · {date}</span>
          <h3>{title}</h3>
          <p>{body}</p>
        </article>
      ))}
      </div>
    </div>
  </section>

  <section class="about-section about-section--soft">
    <div class="container about-split">
      <header class="about-heading"><span>Technology</span><h2>Built for<br /><em>the long haul.</em></h2></header>
      <div>
        <div class="technology-grid">
          <div><span>Curator</span><strong>Bernard Mcweeney</strong></div>
          <div><span>Backend</span><strong>Directus</strong></div>
          <div><span>Frontend</span><strong>Astro · Tailwind CSS</strong></div>
          <div><span>Hosting</span><strong>Cloudflare</strong></div>
        </div>
        <div class="copy-block technology-copy">
          <p>
            Cureation uses open source software as much as possible. The backend is powered by Directus, an open source backend that gives the archive flexibility for data modelling and makes it easier to add and update records.
          </p>
          <p>
            The frontend is built with Astro and Tailwind CSS. Astro is the frontend framework behind the website, while Tailwind CSS helps shape the design system and styling.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="about-thanks">
    <div class="container">
      <span>A note of thanks</span>
      <blockquote>“This archive would be pointless without people who care about The Cure, find something useful here and know when a detail needs correcting.”</blockquote>
      <p>Thank you for reading, exploring and helping keep the record straight.</p>
    </div>
  </section>

</Layout>

<style>
  .about-section { padding-block: clamp(82px, 10vw, 148px); }
  .about-section--soft { background: var(--bg-2); }
  .about-split { display: grid; grid-template-columns: minmax(0, .82fr) minmax(360px, 1.18fr); gap: clamp(48px, 9vw, 140px); align-items: start; }
  .about-heading > span, .about-figures__head, .about-thanks > .container > span { color: var(--accent); font-family: var(--f-sans); font-size: 9px; font-weight: 800; letter-spacing: .2em; text-transform: uppercase; }
  .about-heading h2 { margin: 10px 0 0; color: var(--ink); font-family: var(--f-display); font-size: clamp(54px, 7.5vw, 102px); font-weight: 400; letter-spacing: -.06em; line-height: .8; }
  .about-heading h2 em { color: var(--accent); font-weight: inherit; }
  .about-heading--row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, .42fr); gap: 48px; align-items: end; margin-bottom: clamp(42px, 6vw, 78px); }
  .about-heading--row > p { max-width: 36ch; margin: 0; color: var(--ink-2); font-size: 17px; line-height: 1.6; }
  .copy-block { display: grid; gap: 1rem; max-width: 62ch; }
  .copy-block p { color: var(--ink-2); font-family: var(--f-serif); font-size: clamp(18px, 1.55vw, 22px); line-height: 1.68; margin: 0; }
  .value-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; background: var(--rule); }
  .value-card { position: relative; min-height: 330px; display: flex; flex-direction: column; padding: clamp(24px, 3vw, 42px); background: var(--bg); }
  .value-card::after { position: absolute; right: 0; bottom: 0; left: 0; height: 4px; content: ''; background: var(--accent); }
  .value-card > span, .milestone-card > span, .technology-grid span { color: var(--accent); font-family: var(--f-sans); font-size: 9px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  .value-card > div { margin-top: auto; }
  .value-card h3, .milestone-card h3 { margin: 0; color: var(--ink); font-family: var(--f-display); font-size: clamp(31px, 3vw, 45px); font-style: italic; font-weight: 400; line-height: .95; }
  .value-card p, .milestone-card p { margin: 15px 0 0; color: var(--ink-2); font-size: 15px; line-height: 1.58; }
  .about-figures { padding-block: clamp(54px, 7vw, 92px); background: var(--accent); color: var(--accent-ink); }
  .about-figures__head { display: flex; justify-content: space-between; color: var(--accent-ink); }
  .about-figures__head small { font: inherit; }
  .about-figures__grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 18px; margin-top: clamp(30px, 4vw, 52px); }
  .about-figures__grid strong { display: block; font-family: var(--f-display); font-size: clamp(42px, 5vw, 76px); font-weight: 400; letter-spacing: -.05em; line-height: .8; }
  .about-figures__grid span { display: block; margin-top: 12px; font-family: var(--f-sans); font-size: 8px; font-weight: 800; letter-spacing: .12em; line-height: 1.35; text-transform: uppercase; }
  .milestone-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(16px, 2vw, 28px); margin-top: clamp(44px, 6vw, 76px); }
  .milestone-card { min-height: 300px; padding: clamp(24px, 2.8vw, 38px); background: linear-gradient(145deg, var(--accent-tint), transparent 56%), var(--bg-2); }
  .milestone-card h3 { margin-top: clamp(54px, 6vw, 88px); }
  .technology-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .technology-grid > div { min-height: 126px; display: flex; flex-direction: column; justify-content: space-between; padding: 20px; background: var(--bg); }
  .technology-grid strong { color: var(--ink); font-family: var(--f-display); font-size: clamp(21px, 2vw, 29px); font-weight: 400; line-height: 1.1; }
  .technology-copy { margin-top: 32px; }
  .about-thanks { padding-block: clamp(90px, 12vw, 170px); background: radial-gradient(circle at 88% 20%, var(--accent-tint-2), transparent 30%), var(--bg); }
  .about-thanks blockquote { max-width: 19ch; margin: 24px 0; color: var(--ink); font-family: var(--f-display); font-size: clamp(42px, 6.5vw, 88px); font-style: italic; line-height: .94; }
  .about-thanks p { color: var(--ink-2); font-size: 18px; }
  @media (max-width: 1120px) { .value-grid, .milestone-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .about-figures__grid { grid-template-columns: repeat(3, 1fr); gap: 34px 18px; } }
  @media (max-width: 860px) { .about-split, .about-heading--row { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .value-grid, .milestone-grid, .technology-grid { grid-template-columns: 1fr; } .value-card, .milestone-card { min-height: 260px; } .about-figures__grid { grid-template-columns: repeat(2, 1fr); } }
</style>
