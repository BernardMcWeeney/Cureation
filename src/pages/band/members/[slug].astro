---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import Crumbs from '../../../components/ui/Crumbs.astro';
import Tag from '../../../components/ui/Tag.astro';
import Bookmark from '../../../components/ui/Bookmark.astro';
import {
  formatStintYears,
  getMemberBySlug,
  getMemberLiveStats,
  listMemberPhotos,
  memberActiveYears,
  memberLifespanLabel,
  memberPhoto,
  memberRoleLabel,
  memberStatusLabel,
  memberTenureLabel,
} from '../../../lib/directus';
import { asset } from '../../../lib/assets';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/band');

const member = await getMemberBySlug(slug);
if (!member) return new Response('Not found', { status: 404 });

const [photos, liveStats] = await Promise.all([
  listMemberPhotos(member, { limit: 9 }),
  getMemberLiveStats(member),
]);

const instruments = member.instruments ?? [];
const aliases = member.aliases ?? [];
const sideProjects = member.side_projects ?? [];
const stints = member.stints ?? [];
const portrait = memberPhoto(member);
const portraitSrc = portrait ? (String(portrait).startsWith('http') ? portrait : asset(portrait, 'hero')) : null;
const role = memberRoleLabel(member);
const tenure = memberTenureLabel(member);
const activeYears = memberActiveYears(member);
const lifeDates = memberLifespanLabel(member);
const statusLabel = memberStatusLabel(member);
const source = member.source && typeof member.source === 'object' ? member.source : null;
const sourceHref = member.source_url || source?.url || null;
const sourceName = source?.name || null;
const primaryTags = instruments.length > 0 ? instruments.slice(0, 4) : (role ? [role] : []);
const hasLifeNote = Boolean(member.birth_date || member.death_date || member.death_place);
const hasSourceNote = Boolean(sourceName || sourceHref);
const hasNotes = hasLifeNote || hasSourceNote || aliases.length > 0 || instruments.length > 0 || sideProjects.length > 0;
const maxYearCount = Math.max(1, ...liveStats.yearlyCounts.map((item) => item.count));
const recentYearCounts = liveStats.yearlyCounts.slice(-36);

const showPlace = (show: any) => [show.venue, show.city, show.country].filter(Boolean).join(' · ');
const showDate = (date: string | null) => date ? date.slice(0, 10) : 'Date to be filed';
const showHref = (show: any) => show?.slug ? `/setlists/${show.slug}` : undefined;
const showMeta = (show: any) => [show.tour_name, show.song_count ? `${show.song_count} songs` : null].filter(Boolean).join(' · ');
const photoSrc = (photo: any, preset: 'card' | 'hero' = 'card') =>
  photo.image_file ? asset(photo.image_file, preset) : photo.image_url;

const heroFacts = [
  { k: 'Tenure', v: tenure },
  { k: 'Documented shows', v: liveStats.tenureShowCount ? liveStats.tenureShowCount.toLocaleString() : 'To be filed' },
  { k: 'Countries', v: liveStats.countries ? liveStats.countries.toLocaleString() : '–' },
  { k: 'Active years', v: activeYears ? `${activeYears}` : '–' },
];
---
<Layout title={`${member.name} · The band · Cureation`} description={member.bio || `${member.name}, ${statusLabel.toLowerCase()} member of The Cure.`} ogImage={portrait && !String(portrait).startsWith('http') ? asset(portrait, 'og') : undefined}>
  <div class="container member-topbar">
    <Crumbs items={[
      { label: 'Home', href: '/' },
      { label: 'The band', href: '/band' },
      { label: member.name },
    ]} />
  </div>

  <section class="container member-head detail-anchor" id="member-overview">
    <div class="member-head__art">
      <figure class="portrait-plate">
        <div class="portrait-plate__corner portrait-plate__corner--tl">
          <span class="mono-sm muted">{statusLabel.toUpperCase()}</span>
        </div>
        <div class="portrait-plate__corner portrait-plate__corner--tr">
          <span class="mono-sm muted">{role || 'ROLE TBC'}</span>
        </div>
        {portraitSrc ? (
          <img src={portraitSrc} alt={member.name} />
        ) : (
          <div class="portrait-plate__fallback">{member.name.split(/\s+/).map((part) => part[0]).join('').slice(0, 2)}</div>
        )}
        <div class="portrait-plate__corner portrait-plate__corner--bl">
          <span class="mono-sm muted">{tenure}</span>
        </div>
      </figure>
    </div>

    <div class="member-head__body">
      <div class="member-head__utility">
        <div class="cluster" style="gap: .4rem;">
          <span class={`tag ${member.is_current_member ? 'tag--gold' : member.death_date ? 'tag--blood' : 'tag--cool'}`}>
            {statusLabel.toUpperCase()}
          </span>
          {primaryTags.map((instrument) => <Tag>{instrument.toUpperCase()}</Tag>)}
          {liveStats.tenureShowCount > 0 && <Tag variant="accent">{liveStats.tenureShowCount.toLocaleString()} SHOWS</Tag>}
        </div>
        <Bookmark kind="member" id={member.id} label={member.name} href={`/band/members/${member.slug}`} />
      </div>

      <h1 class="member-head__title serif">{member.name}</h1>
      <div class="mono-sm member-head__meta">
        {role || 'Role to be filed'} · {tenure}
        {lifeDates !== 'Life dates to be filed' && <> · {lifeDates}</>}
      </div>

      {member.bio && <p class="member-head__lede">{member.bio}</p>}

      {liveStats.firstShow && liveStats.lastShow && (
        <div class="archivist">
          <span class="mono-sm muted">Live archive:</span>
          documented setlists place {member.name} inside {liveStats.tenureShowCount.toLocaleString()} Cure show{liveStats.tenureShowCount === 1 ? '' : 's'} from {showDate(liveStats.firstShow.date)} to {showDate(liveStats.lastShow.date)}.
        </div>
      )}

      <div class="facts">
        {heroFacts.map((fact) => (
          <div class="facts__item">
            <div class="facts__k">{fact.k}</div>
            <div class="facts__v">{fact.v}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="container member-tabs-wrap">
    <div class="member-tabs" data-member-tabs role="tablist" aria-label="Member dossier">
      <button id="member-tab-live" class="member-tab is-active" type="button" role="tab" data-target="live" aria-controls="member-panel-live" aria-selected="true">
        Live record <span class="member-tab__count">{liveStats.tenureShowCount.toLocaleString()}</span>
      </button>
      <button id="member-tab-lineup" class="member-tab" type="button" role="tab" data-target="lineup" aria-controls="member-panel-lineup" aria-selected="false" tabindex="-1">
        Lineup history <span class="member-tab__count">{stints.length}</span>
      </button>
      {photos.length > 0 && (
        <button id="member-tab-photos" class="member-tab" type="button" role="tab" data-target="photos" aria-controls="member-panel-photos" aria-selected="false" tabindex="-1">
          Photo file <span class="member-tab__count">{photos.length}</span>
        </button>
      )}
      {hasNotes && (
        <button id="member-tab-notes" class="member-tab" type="button" role="tab" data-target="notes" aria-controls="member-panel-notes" aria-selected="false" tabindex="-1">
          Notes <span class="member-tab__count">·</span>
        </button>
      )}
    </div>
  </div>

  <section id="member-panel-live" class="container member-section detail-anchor" data-member-panel="live" role="tabpanel" aria-labelledby="member-tab-live">
    <div class="live-layout">
      <div class="live-stats">
        <div class="live-stat live-stat--primary">
          <span>Documented tenure-window shows</span>
          <strong>{liveStats.tenureShowCount ? liveStats.tenureShowCount.toLocaleString() : '–'}</strong>
          <p>Counted from dated setlists that fall inside the member stint windows.</p>
        </div>
        <div class="live-stat">
          <span>Lineup-tagged appearances</span>
          <strong>{liveStats.lineupTaggedCount ? liveStats.lineupTaggedCount.toLocaleString() : '–'}</strong>
        </div>
        <div class="live-stat">
          <span>Average set length</span>
          <strong>{liveStats.avgSongCount ? `${liveStats.avgSongCount} songs` : '–'}</strong>
        </div>
        <div class="live-stat">
          <span>Tours / countries</span>
          <strong>{liveStats.tours || '–'} / {liveStats.countries || '–'}</strong>
        </div>
      </div>

      <aside class="live-focus panel--bare">
        <div class="panel-head">
          <span>Archive markers</span>
          <span>Setlist archive</span>
        </div>
        <div class="marker-list">
          {liveStats.firstShow && (
            <a href={showHref(liveStats.firstShow)} class="marker-row">
              <span>First on file</span>
              <strong>{showDate(liveStats.firstShow.date)}</strong>
              <small>{showPlace(liveStats.firstShow)}</small>
            </a>
          )}
          {liveStats.lastShow && (
            <a href={showHref(liveStats.lastShow)} class="marker-row">
              <span>Latest on file</span>
              <strong>{showDate(liveStats.lastShow.date)}</strong>
              <small>{showPlace(liveStats.lastShow)}</small>
            </a>
          )}
          {liveStats.longestShow && (
            <a href={showHref(liveStats.longestShow)} class="marker-row">
              <span>Longest set</span>
              <strong>{liveStats.longestShow.song_count} songs</strong>
              <small>{showDate(liveStats.longestShow.date)} · {liveStats.longestShow.venue}</small>
            </a>
          )}
        </div>
      </aside>
    </div>

    {recentYearCounts.length > 0 && (
      <div class="year-board">
        <div class="member-section__intro">
          <div>
            <div class="mono muted">Year density</div>
            <h2 class="serif">Setlists across the tenure window</h2>
          </div>
          <div class="mono-sm muted">Latest {recentYearCounts.length} active years on file</div>
        </div>
        <div class="year-bars">
          {recentYearCounts.map((item) => (
            <div class="year-bar" title={`${item.year}: ${item.count} shows`}>
              <div class="year-bar__fill" style={`height: ${Math.max(4, (item.count / maxYearCount) * 100)}%;`}></div>
              <span>{String(item.year).slice(2)}</span>
            </div>
          ))}
        </div>
      </div>
    )}

    {liveStats.recentShows.length > 0 && (
      <div class="recent-shows">
        <div class="member-section__intro">
          <div>
            <div class="mono muted">Recent setlists</div>
            <h2 class="serif">Latest appearances in the archive</h2>
          </div>
          <a href="/setlists" class="mono-sm">Open setlists →</a>
        </div>
        <div class="show-list">
          {liveStats.recentShows.map((show, i) => (
            <a href={showHref(show)} class="show-row">
              <span class="idx">{String(i + 1).padStart(2, '0')}</span>
              <span>
                <strong>{show.venue || 'Venue to be filed'}</strong>
                <small>{showPlace(show)}</small>
              </span>
              <span class="show-row__date">{showDate(show.date)}</span>
              <span class="show-row__meta">{showMeta(show) || 'Setlist'}</span>
            </a>
          ))}
        </div>
      </div>
    )}
  </section>

  <section id="member-panel-lineup" class="container member-section detail-anchor" data-member-panel="lineup" role="tabpanel" aria-labelledby="member-tab-lineup" hidden>
    <div class="member-section__intro">
      <div>
        <div class="mono muted">Member stints</div>
        <h2 class="serif">Lineup history</h2>
      </div>
      <div class="mono-sm muted">{stints.length ? `${stints.length} stint${stints.length === 1 ? '' : 's'}` : 'No stints filed'}</div>
    </div>

    {stints.length > 0 ? (
      <ol class="stint-ledger">
        {stints.map((stint, i) => (
          <li class={stint.end_year === null ? 'is-active' : undefined}>
            <div class="stint-ledger__n">{String(stint.stint_number || i + 1).padStart(2, '0')}</div>
            <div>
              <div class="stint-ledger__years">{formatStintYears(stint)}</div>
              <h3 class="serif">{stint.role || 'Band member'}</h3>
              {stint.notes && <p>{stint.notes}</p>}
            </div>
            <div class="stint-ledger__flag">{stint.end_year === null ? 'Active' : 'Archive'}</div>
          </li>
        ))}
      </ol>
    ) : (
      <p class="empty-note">No linked member stints have been filed yet.</p>
    )}
  </section>

  {photos.length > 0 && (
    <section id="member-panel-photos" class="container member-section detail-anchor" data-member-panel="photos" role="tabpanel" aria-labelledby="member-tab-photos" hidden>
      <div class="member-section__intro">
        <div>
          <div class="mono muted">Photo file</div>
          <h2 class="serif">Contact sheet</h2>
        </div>
        <div class="mono-sm muted">Linked, searched, and tenure-window photos</div>
      </div>
      <div class="contact-sheet">
        {photos.map((photo) => (
          <figure>
            <img src={photoSrc(photo, 'card')} alt={photo.title || member.name} loading="lazy" />
            <figcaption>
              <span>{photo.title || 'Archive photograph'}</span>
              <small>{[photo.formatted_date, photo.photographer, photo.location].filter(Boolean).join(' · ') || 'Cureation photo archive'}</small>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  {hasNotes && (
    <section id="member-panel-notes" class="container member-section detail-anchor" data-member-panel="notes" role="tabpanel" aria-labelledby="member-tab-notes" hidden>
      <div class="member-section__intro">
        <div>
          <div class="mono muted">Archive notes</div>
          <h2 class="serif">Roles, aliases, sources</h2>
        </div>
      </div>
      <div class="notes-grid">
        {instruments.length > 0 && (
          <section>
            <div class="member-section__label">Instrument register</div>
            <ul class="tag-list">
              {instruments.map((instrument) => <li>{instrument}</li>)}
            </ul>
          </section>
        )}
        {aliases.length > 0 && (
          <section>
            <div class="member-section__label">Aliases</div>
            <ul class="tag-list">
              {aliases.map((alias) => <li>{alias}</li>)}
            </ul>
          </section>
        )}
        {hasLifeNote && (
          <section>
            <div class="member-section__label">Life dates</div>
            <p>{lifeDates}{member.death_place ? ` · ${member.death_place}` : ''}</p>
          </section>
        )}
        {sideProjects.length > 0 && (
          <section>
            <div class="member-section__label">Other work</div>
            <ul class="project-list">
              {sideProjects.map((project: any) => (
                <li>
                  <strong>{project.name || project.project || project}</strong>
                  {(project.role || project.years || project.start) && (
                    <span>{[project.role, project.years || project.start].filter(Boolean).join(' · ')}</span>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )}
        {hasSourceNote && (
          <section>
            <div class="member-section__label">Source note</div>
            <p>{sourceHref ? <a href={sourceHref} target="_blank" rel="noreferrer">{sourceName || 'Primary source'}</a> : sourceName}</p>
          </section>
        )}
      </div>
    </section>
  )}
</Layout>

<style>
  .member-topbar {
    padding-top: clamp(20px, 3vw, 34px);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .member-head {
    display: grid;
    grid-template-columns: minmax(0, 430px) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 56px);
    padding: clamp(18px, 3vw, 34px) var(--gutter) clamp(32px, 4vw, 58px);
    border-bottom: 1px solid var(--rule);
    max-width: var(--max-w);
    margin: 0 auto;
  }

  .portrait-plate {
    aspect-ratio: 4 / 5;
    background: var(--bg-3);
    border: 1px solid var(--rule);
    position: relative;
    margin: 0;
    overflow: hidden;
  }

  .portrait-plate img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(.92) contrast(1.05);
  }

  .portrait-plate__fallback {
    height: 100%;
    display: grid;
    place-items: center;
    color: var(--accent-3);
    font-family: var(--f-serif);
    font-size: 72px;
    font-style: italic;
    background:
      linear-gradient(135deg, transparent 0 49%, var(--rule-2) 49% 51%, transparent 51%),
      var(--bg-2);
  }

  .portrait-plate__corner {
    position: absolute;
    padding: 13px 14px;
    z-index: 1;
    pointer-events: none;
  }

  .portrait-plate__corner--tl { top: 0; left: 0; }
  .portrait-plate__corner--tr { top: 0; right: 0; text-align: right; }
  .portrait-plate__corner--bl { bottom: 0; left: 0; max-width: 100%; }

  .portrait-plate__corner > * {
    display: inline-block;
    max-width: min(320px, 72vw);
    padding: 4px 8px;
    background: color-mix(in oklab, var(--bg), transparent 12%);
    backdrop-filter: blur(6px);
  }

  .member-head__body {
    min-width: 0;
  }

  .member-head__utility {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .member-head__title {
    margin: 16px 0 0;
    color: var(--ink);
    font-size: 96px;
    line-height: .92;
    font-style: italic;
    font-weight: 500;
    letter-spacing: 0;
    overflow-wrap: anywhere;
  }

  .member-head__meta {
    color: var(--ink-2);
    margin-top: 12px;
  }

  .member-head__lede {
    max-width: 680px;
    margin: 24px 0 0;
    color: var(--ink-2);
    font-family: var(--f-serif);
    font-size: 19px;
    line-height: 1.65;
  }

  .archivist {
    margin-top: 18px;
    max-width: 680px;
    color: var(--muted);
    font-family: var(--f-serif);
    font-size: 14px;
    font-style: italic;
    line-height: 1.6;
  }

  .member-head__body .facts {
    margin-top: 28px;
  }

  .member-tabs-wrap {
    margin-top: clamp(20px, 2.4vw, 32px);
    padding-bottom: 0;
  }

  .member-tabs {
    position: relative;
    display: flex;
    overflow-x: auto;
    border: 1px solid var(--rule);
    background:
      radial-gradient(circle at 88% -20%, var(--violet-tint), transparent 44%),
      var(--bg-2);
    scrollbar-width: thin;
  }

  .member-tabs::before {
    position: absolute;
    z-index: 1;
    top: -1px;
    right: -1px;
    left: -1px;
    height: 4px;
    background: linear-gradient(90deg, var(--accent) 0 28%, var(--violet) 28% 54%, var(--cool) 54% 77%, var(--gold) 77% 100%);
    content: '';
    pointer-events: none;
  }

  .member-tab {
    --tab-tone: var(--accent);
    position: relative;
    flex: 1 0 auto;
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--muted);
    background: transparent;
    border: none;
    border-right: 1px solid var(--rule);
    padding: 18px 18px 15px;
    cursor: pointer;
    border-bottom: 3px solid transparent;
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    white-space: nowrap;
    transition: color .18s, border-color .18s, background-color .18s;
  }

  .member-tab:nth-child(2) { --tab-tone: var(--violet); }
  .member-tab:nth-child(3) { --tab-tone: var(--cool); }
  .member-tab:nth-child(4) { --tab-tone: var(--gold); }
  .member-tab:last-child { border-right: 0; }

  .member-tab:hover {
    color: var(--tab-tone);
  }

  .member-tab.is-active {
    color: var(--ink);
    border-bottom-color: var(--tab-tone);
    background: color-mix(in srgb, var(--tab-tone) 12%, transparent);
  }

  :root[data-theme='papers'] .member-tab.is-active {
    color: var(--tab-tone);
  }

  .member-tab__count {
    font-size: 10px;
    letter-spacing: .1em;
    opacity: .56;
  }

  .member-section {
    padding: clamp(32px, 5vw, 58px) var(--gutter);
    max-width: var(--max-w);
    margin: 0 auto;
  }

  .member-section__intro {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 24px;
  }

  .member-section__intro h2 {
    margin: 4px 0 0;
    font-size: 34px;
    font-style: italic;
    font-weight: 400;
    line-height: 1.05;
  }

  .member-section__label {
    margin-bottom: 14px;
    color: var(--muted);
    font-family: var(--f-mono);
    font-size: 10.5px;
    letter-spacing: .2em;
    text-transform: uppercase;
  }

  .live-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(260px, .8fr);
    gap: clamp(24px, 3vw, 48px);
  }

  .live-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .live-stat {
    min-height: 150px;
    padding: 18px;
    background: color-mix(in oklab, var(--bg-2), transparent 32%);
    border: 1px solid var(--rule-2);
  }

  .live-stat--primary {
    grid-row: span 2;
    min-height: 312px;
  }

  .live-stat span,
  .marker-row span,
  .stint-ledger__flag {
    display: block;
    color: var(--muted);
    font-family: var(--f-mono);
    font-size: 10px;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .live-stat strong {
    display: block;
    margin-top: 12px;
    color: var(--ink);
    font-family: var(--f-serif);
    font-size: 32px;
    font-style: italic;
    font-weight: 400;
    line-height: 1.05;
  }

  .live-stat--primary strong {
    font-size: 72px;
  }

  .live-stat p {
    max-width: 32ch;
    margin: 16px 0 0;
    color: var(--ink-2);
    font-family: var(--f-serif);
    font-size: 15px;
    line-height: 1.55;
  }

  .marker-list {
    padding: 8px 0;
  }

  .marker-row {
    display: block;
    padding: 13px 18px 15px;
    color: inherit;
    border: none;
    border-bottom: 1px solid var(--rule-2);
  }

  .marker-row:last-child {
    border-bottom: none;
  }

  .marker-row strong {
    display: block;
    margin-top: 6px;
    color: var(--ink);
    font-family: var(--f-serif);
    font-size: 24px;
    font-style: italic;
    font-weight: 400;
  }

  .marker-row small {
    display: block;
    margin-top: 5px;
    color: var(--ink-2);
    font-family: var(--f-serif);
    font-size: 14px;
    line-height: 1.4;
  }

  .year-board,
  .recent-shows {
    margin-top: clamp(34px, 5vw, 58px);
  }

  .year-bars {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18px, 1fr));
    gap: 4px;
    height: 220px;
    align-items: end;
