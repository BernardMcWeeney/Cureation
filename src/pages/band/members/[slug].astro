<script>
  function wireMemberTabs() {
    const tablist = document.querySelector<HTMLElement>('[data-member-tabs]');
    if (!tablist || tablist.dataset.wired === 'true') return;
    tablist.dataset.wired = 'true';
    const tabs = Array.from(tablist.querySelectorAll<HTMLButtonElement>('.member-tab'));
    const panels = document.querySelectorAll<HTMLElement>('[data-member-panel]');
    if (!tabs.length) return;

    const activate = (tab: HTMLButtonElement, moveFocus = false) => {
      const target = tab.getAttribute('data-target');
      tabs.forEach((item) => {
        const isActive = item === tab;
        item.classList.toggle('is-active', isActive);
        item.setAttribute('aria-selected', String(isActive));
        item.tabIndex = isActive ? 0 : -1;
      });
      panels.forEach((panel) => {
        panel.hidden = panel.getAttribute('data-member-panel') !== target;
      });
      tab.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });
      if (moveFocus) tab.focus();
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => activate(tab));
      tab.addEventListener('keydown', (event) => {
        const current = tabs.indexOf(tab);
        let next = current;
        if (event.key === 'ArrowRight') next = (current + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') next = (current - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault();
        activate(tabs[next], true);
      });
    });
  }

  wireMemberTabs();
  document.addEventListener('astro:page-load', wireMemberTabs);
</script>
