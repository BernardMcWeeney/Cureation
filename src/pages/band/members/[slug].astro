---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import Crumbs from '../../../components/ui/Crumbs.astro';
import Tag from '../../../components/ui/Tag.astro';
import Bookmark from '../../../components/ui/Bookmark.astro';
import { getMemberBySlug, listAlbums } from '../../../lib/directus';
import { asset } from '../../../lib/assets';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/band');
const member: any = await getMemberBySlug(slug);
if (!member) return new Response('Not found', { status: 404 });

const albums = await listAlbums();

const instruments: string[] = Array.isArray(member.instruments) ? member.instruments : [];
const aliases: string[] = Array.isArray(member.aliases) ? member.aliases : [];
const sideProjects: any[] = Array.isArray(member.side_projects) ? member.side_projects : [];

const facts: Array<[string, string]> = [
  ['Status', member.is_current_member ? 'Current member' : 'Former member'],
  ['Tenure', member.tenure || `${member.tenure_start || ''}–${member.tenure_end || 'present'}`],
  ['Instruments', instruments.slice(0, 4).join(', ') || '—'],
  ['Born', member.birth_date || '—'],
];
---
<Layout title={`${member.name} · The band · Cureation`} description={member.bio || `${member.name}, ${member.is_current_member ? 'current' : 'former'} member of The Cure.`} ogImage={member.photo_file && !String(member.photo_file).startsWith('http') ? asset(member.photo_file, 'og') : undefined}>
  <div class="container" style="padding-top: clamp(24px, 3vw, 40px); display:flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;">
    <Crumbs items={[
      { label: 'Home', href: '/' },
      { label: 'The band', href: '/band' },
      { label: member.name },
    ]} />
    <Bookmark kind="member" id={member.id} label={member.name} href={`/band/members/${member.slug}`} />
  </div>

  <section class="container dossier">
    <figure class="dossier__portrait">
      {member.photo_file ? (
        <img src={member.photo_file.startsWith('http') ? member.photo_file : asset(member.photo_file, 'hero')} alt={member.name} />
      ) : (
        <div class="placeholder" style="aspect-ratio: 3/4;">No portrait</div>
      )}
      <div class="cover-plate__corner cover-plate__corner--tl">
        <span>{member.is_current_member ? '· CURRENT ·' : '· ALUMNI ·'}</span>
      </div>
      <div class="cover-plate__corner cover-plate__corner--tr">
        <span>{instruments[0]?.toUpperCase() || 'MEMBER'}</span>
      </div>
      {member.birth_date && (
        <div class="cover-plate__corner cover-plate__corner--br">
          <span>b. {member.birth_date.slice(0, 4)}</span>
        </div>
      )}
    </figure>

    <div class="dossier__body stack" style="--gap: 1rem;">
      <div class="mono-sm muted">MEMBER · {member.tenure || '—'}</div>
      <div class="cluster" style="gap:.4rem;">
        {member.is_current_member
          ? <span class="tag tag--gold"><span class="pip pip--gold"></span>ACTIVE</span>
          : <span class="tag tag--cool">ALUMNI</span>}
        {instruments.slice(0, 3).map((i) => <Tag>{i.toUpperCase()}</Tag>)}
      </div>
      <h1 class="serif" style="font-size: clamp(44px, 7vw, 96px); line-height:.95; font-style: italic; font-weight: 400; margin: 0;">{member.name}</h1>
      {aliases.length > 0 && <div class="mono-sm" style="color: var(--accent-3);">AKA {aliases.join(' · ').toUpperCase()}</div>}
      {member.bio && <p style="font-family: var(--f-serif); font-size: 18px; line-height: 1.6; color: var(--ink-2); max-width: 58ch;">{member.bio}</p>}
      <div class="facts">
        {facts.map(([k, v]) => (
          <div class="facts__item">
            <div class="facts__k">{k}</div>
            <div class="facts__v">{v}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {instruments.length > 0 && (
    <section class="container" style="padding: clamp(24px, 4vw, 48px) 0;">
      <div class="panel-head" style="border: 1px solid var(--rule);">
        <span>Instruments on file</span>
        <span>{instruments.length} LISTED</span>
      </div>
      <ul class="inst-list">
        {instruments.map((i) => (
          <li class="serif" style="font-size: 18px; font-style: italic;">{i}</li>
        ))}
      </ul>
    </section>
  )}

  {sideProjects.length > 0 && (
    <section class="container" style="padding-bottom: clamp(24px, 4vw, 48px);">
      <div class="panel-head" style="border: 1px solid var(--rule);">
        <span>Side projects</span>
        <span>{sideProjects.length} LISTED</span>
      </div>
      <table class="data">
        <thead><tr><th style="width:50px;">№</th><th>Project</th><th>Role</th><th>Years</th></tr></thead>
        <tbody>
          {sideProjects.map((p: any, i: number) => (
            <tr>
              <td class="idx">{String(i + 1).padStart(2, '0')}</td>
              <td><span class="serif" style="font-size: 18px; font-style: italic;">{p.name || p.project || p}</span></td>
              <td class="mono-sm muted">{p.role || '—'}</td>
              <td class="mono-sm" style="color: var(--accent-3);">{p.years || p.start || '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  )}
</Layout>

<style>
  .inst-list { list-style: none; margin: 0; padding: 16px; background: var(--bg-2); border: 1px solid var(--rule); border-top: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; }
</style>