<script>
  function wireGearTabs() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('[data-gear-tabs] .gear-tab');
    const panels = document.querySelectorAll<HTMLElement>('[data-gear-panel]');
    if (!tabs.length) return;
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-target');
        tabs.forEach((item) => item.classList.toggle('is-active', item === tab));
        panels.forEach((panel) => {
          panel.hidden = panel.getAttribute('data-gear-panel') !== target;
        });
      });
    });
  }

  wireGearTabs();
  document.addEventListener('astro:page-load', wireGearTabs);
</script>
