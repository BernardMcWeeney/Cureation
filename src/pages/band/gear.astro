---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import Crumbs from '../../components/ui/Crumbs.astro';
import Tag from '../../components/ui/Tag.astro';
import {
  listGear,
  listMembers,
  memberGearFamilies,
  memberRoleLabel,
  memberTenureLabel,
  type Gear,
  type GearFamily,
  type Member,
} from '../../lib/directus';
import { asset } from '../../lib/assets';

const [gear, members] = await Promise.all([
  listGear().catch(() => []),
  listMembers().catch(() => []),
]);

type LinkSource = 'direct' | 'named' | 'role';
type GearLink = { member: Member; source: LinkSource; score: number };
type GearRow = {
  gear: Gear;
  index: number;
  family: GearFamily;
  label: string;
  range: string;
  rangeStart: number | null;
  rangeEnd: number | null;
  links: GearLink[];
};

const familyOrder: GearFamily[] = ['guitar', 'bass', 'keyboard', 'drums', 'voice', 'other'];
const familyLabels: Record<GearFamily, string> = {
  guitar: 'Guitars',
  bass: 'Bass',
  keyboard: 'Keyboards',
  drums: 'Drums',
  voice: 'Voice',
  other: 'Other',
};
const familyTone: Record<GearFamily, string> = {
  guitar: 'hot',
  bass: 'gold',
  keyboard: 'cool',
  drums: 'blood',
  voice: 'accent',
  other: 'default',
};

function norm(value: unknown): string {
  return String(value ?? '').trim().toLowerCase();
}

function titleCase(value: string): string {
  return value.replace(/[-_]/g, ' ').replace(/\b\w/g, (char) => char.toUpperCase());
}

function gearFamily(item: Gear): GearFamily {
  const text = norm([item.kind, item.category, item.name, item.description, item.notes].filter(Boolean).join(' '));
  if (/\b(six[- ]string bass|bass guitar|bass)\b/.test(text)) return 'bass';
  if (/\b(guitar|baritone|jazzmaster|schecter)\b/.test(text)) return 'guitar';
  if (/\b(keyboard|keyboards|synth|synthesizer|piano|organ|oberheim|roland)\b/.test(text)) return 'keyboard';
  if (/\b(drum|drums|percussion|kit)\b/.test(text)) return 'drums';
  if (/\b(vocal|vocals|voice|microphone)\b/.test(text)) return 'voice';
  return 'other';
}

function yearFromChunk(value: string | null, fallback: number | null): number | null {
  if (!value) return fallback;
  const decade = value.match(/(\d{4})s/);
  if (decade) return Number(decade[1]);
  const year = value.match(/(\d{4})/);
  return year ? Number(year[1]) : fallback;
}

function rangeStart(item: Gear): number | null {
  return yearFromChunk(item.era_range, null);
}

function rangeEnd(item: Gear): number | null {
  const text = norm(item.era_range);
  if (!text || text.includes('present')) return null;
  const years = text.match(/\d{4}s?|\d{4}/g) ?? [];
  return yearFromChunk(years[years.length - 1] || null, null);
}

function rangeLabel(item: Gear): string {
  return item.era_range || 'Era to be filed';
}

function overlapsStints(member: Member, start: number | null, end: number | null): boolean {
  const stints = member.stints ?? [];
  if (!stints.length || start === null) return true;
  const rangeEndYear = end ?? new Date().getUTCFullYear();
  return stints.some((stint) => {
    if (stint.start_year === null) return false;
    const stintEnd = stint.end_year ?? 9999;
    return stint.start_year <= rangeEndYear && stintEnd >= start;
  });
}

function usedByTokens(value: unknown): { ids: Set<number>; names: Set<string> } {
  const ids = new Set<number>();
  const names = new Set<string>();
  const values = Array.isArray(value) ? value : [value];
  for (const item of values) {
    if (!item) continue;
    if (typeof item === 'object') {
      const id = Number((item as any).id ?? (item as any).member ?? (item as any).member_id);
      if (Number.isFinite(id)) ids.add(id);
      const name = norm((item as any).name);
      if (name) names.add(name);
      continue;
    }
    const id = Number(item);
    if (Number.isFinite(id)) ids.add(id);
    const name = norm(item);
    if (name && !Number.isFinite(id)) names.add(name);
  }
  return { ids, names };
}

function linksForGear(item: Gear): GearLink[] {
  const family = gearFamily(item);
  const text = norm([item.name, item.description, item.notes, item.owner].filter(Boolean).join(' '));
  const direct = usedByTokens(item.used_by);
  const start = rangeStart(item);
  const end = rangeEnd(item);
  const links: GearLink[] = [];

  for (const member of members) {
    const memberName = norm(member.name);
    const families = member.gear_families ?? memberGearFamilies(member);
    const isDirect = direct.ids.has(member.id) || direct.names.has(memberName);
    const isNamed = memberName.length > 0 && text.includes(memberName);
    const isRoleMatch = families.includes(family) && overlapsStints(member, start, end);

    if (isDirect) links.push({ member, source: 'direct', score: 0 });
    else if (isNamed) links.push({ member, source: 'named', score: 1 });
    else if (isRoleMatch) links.push({ member, source: 'role', score: 2 });
  }

  const byId = new Map<number, GearLink>();
  for (const link of links) {
    const prev = byId.get(link.member.id);
    if (!prev || link.score < prev.score) byId.set(link.member.id, link);
  }

  return Array.from(byId.values()).sort((a, b) => {
    if (a.score !== b.score) return a.score - b.score;
    if (a.member.is_current_member !== b.member.is_current_member) return a.member.is_current_member ? -1 : 1;
    return a.member.name.localeCompare(b.member.name);
  });
}

const gearRows: GearRow[] = gear.map((item, index) => {
  const family = gearFamily(item);
  return {
    gear: item,
    index,
    family,
    label: familyLabels[family],
    range: rangeLabel(item),
    rangeStart: rangeStart(item),
    rangeEnd: rangeEnd(item),
    links: linksForGear(item),
  };
});

const categories = familyOrder
  .map((family) => ({
    family,
    label: familyLabels[family],
    rows: gearRows.filter((row) => row.family === family),
  }))
  .filter((category) => category.rows.length > 0);

const memberRows = members.map((member) => {
  const families = member.gear_families ?? memberGearFamilies(member);
  const matches = gearRows.filter((row) =>
    row.links.some((link) => link.member.id === member.id) ||
    families.includes(row.family)
  );
  return { member, families, matches };
});

const currentMemberRows = memberRows.filter((row) => row.member.is_current_member);
const linkedMemberCount = new Set(gearRows.flatMap((row) => row.links.map((link) => link.member.id))).size;
const namedLinkCount = gearRows.reduce((count, row) =>
  count + row.links.filter((link) => link.source !== 'role').length, 0);
const featured = gearRows.find((row) => row.gear.image) || gearRows[0] || null;
const maxCategoryCount = Math.max(1, ...categories.map((category) => category.rows.length));
const sourceLabel: Record<LinkSource, string> = {
  direct: 'Direct',
  named: 'Named',
  role: 'Role',
};
---
<Layout title="Instruments & equipment · The band · Cureation">
  <div class="container gear-topbar">
    <Crumbs items={[
      { label: 'Home', href: '/' },
      { label: 'The band', href: '/band' },
      { label: 'Gear' },
    ]} />
  </div>

  <section class="container gear-head">
    <div class="gear-head__art">
      <figure class="gear-plate">
        <div class="gear-plate__corner gear-plate__corner--tl">
          <span class="mono-sm muted">GEAR FILE · {gearRows.length || 'TBC'} ITEMS</span>
        </div>
        <div class="gear-plate__corner gear-plate__corner--tr">
          <span class="mono-sm muted">{categories.length || 'NO'} CATEGORIES</span>
        </div>
        {featured?.gear.image ? (
          <img src={asset(featured.gear.image, 'hero')} alt={featured.gear.name} />
        ) : (
          <div class="gear-rack" aria-hidden="true">
            <div class="gear-rack__strings">
              {Array.from({ length: 6 }).map((_, i) => <span style={`left: ${14 + i * 13}%;`}></span>)}
            </div>
            {categories.length > 0 ? categories.map((category, i) => (
              <div class={`gear-rack__module gear-rack__module--${category.family}`} style={`--delay: ${i};`}>
                <span>{category.label}</span>
                <strong>{String(category.rows.length).padStart(2, '0')}</strong>
              </div>
            )) : (
              <div class="gear-rack__module gear-rack__module--other">
                <span>Filed soon</span>
                <strong>00</strong>
              </div>
            )}
          </div>
        )}
        <div class="gear-plate__corner gear-plate__corner--bl">
          <span class="mono-sm muted">{featured ? featured.range.toUpperCase() : 'ARCHIVE IN PROGRESS'}</span>
        </div>
      </figure>
    </div>

    <div class="gear-head__body">
      <div class="cluster" style="gap: .4rem;">
        {categories.slice(0, 4).map((category) => (
          <Tag variant={familyTone[category.family] === 'accent' ? 'accent' : undefined}>
            {category.label.toUpperCase()}
          </Tag>
        ))}
      </div>

      <h1 class="gear-head__title serif">Instruments & equipment</h1>
      <div class="mono-sm gear-head__meta">
        Band file · instruments · stage equipment · member register
      </div>

      <p class="gear-head__lede">
        Guitars, basses, keyboards, drums and stage equipment, cross-referenced against the member instrument register where the collection does not yet carry a direct player link.
      </p>

      {namedLinkCount > 0 && (
        <div class="archivist">
          <span class="mono-sm muted">Archive note:</span>
          {namedLinkCount} player link{namedLinkCount === 1 ? '' : 's'} are named directly in gear records. Role-derived links use member instruments and documented tenure windows.
        </div>
      )}

      <div class="facts">
        <div class="facts__item"><div class="facts__k">On file</div><div class="facts__v">{gearRows.length || 'To be filed'}</div></div>
        <div class="facts__item"><div class="facts__k">Categories</div><div class="facts__v">{categories.length || '–'}</div></div>
        <div class="facts__item"><div class="facts__k">Member links</div><div class="facts__v">{linkedMemberCount || '–'}</div></div>
        <div class="facts__item"><div class="facts__k">Direct or named</div><div class="facts__v">{namedLinkCount || '–'}</div></div>
      </div>
    </div>
  </section>

  <div class="container gear-tabs-wrap">
    <div class="gear-tabs" data-gear-tabs role="tablist">
      <button class="gear-tab is-active" role="tab" data-target="overview">
        Overview <span class="gear-tab__count">{gearRows.length}</span>
      </button>
      <button class="gear-tab" role="tab" data-target="categories">
        Categories <span class="gear-tab__count">{categories.length}</span>
      </button>
      <button class="gear-tab" role="tab" data-target="members">
        Member register <span class="gear-tab__count">{members.length}</span>
      </button>
      <button class="gear-tab" role="tab" data-target="ledger">
        Ledger <span class="gear-tab__count">{gearRows.length}</span>
      </button>
    </div>
  </div>

  <section class="container gear-section" data-gear-panel="overview">
    {gearRows.length === 0 ? (
      <div class="empty-note">
        <div class="mono-sm muted">In progress</div>
        <h2 class="serif">Gear ledger</h2>
        <p>Collection is being populated. Check back as entries land.</p>
      </div>
    ) : (
      <div class="gear-layout">
        <div class="gear-stack">
          {gearRows.map((row) => (
            <article class={`gear-card${row.gear.image ? ' gear-card--image' : ''}`} id={row.gear.slug || row.gear.id}>
              <div class="gear-card__idx">{String(row.index + 1).padStart(2, '0')}</div>
              {row.gear.image && (
                <figure class="gear-card__image">
                  <img src={asset(row.gear.image, 'card')} alt={row.gear.name} loading="lazy" />
                </figure>
              )}
              <div class="gear-card__body">
                <div class="gear-card__top">
                  <div>
                    <div class="mono-sm muted">{row.label} · {row.range}</div>
                    <h2 class="serif">{row.gear.name}</h2>
                  </div>
                  <span class={`tag tag--${familyTone[row.family] === 'default' ? 'cool' : familyTone[row.family]}`}>
                    {row.family.toUpperCase()}
                  </span>
                </div>
                {(row.gear.description || row.gear.notes) && (
                  <p>{row.gear.description || row.gear.notes}</p>
                )}
                <div class="gear-card__links">
                  {row.links.length > 0 ? row.links.slice(0, 5).map((link) => (
                    <a href={`/band/members/${link.member.slug}`} class={`player-chip player-chip--${link.source}`}>
                      <span>{link.member.name}</span>
                      <small>{sourceLabel[link.source]}</small>
                    </a>
                  )) : (
                    <span class="player-chip player-chip--empty">Player link TBC</span>
                  )}
                </div>
                <div class="gear-card__meta">
                  <span>{row.gear.manufacturer || row.gear.model || titleCase(row.gear.kind || row.gear.category || row.family)}</span>
                  <span>{row.range}</span>
                  <span>{row.links.length ? `${row.links.length} member ${row.links.length === 1 ? 'link' : 'links'}` : 'Unlinked'}</span>
                </div>
              </div>
            </article>
          ))}
        </div>

        <aside class="gear-aside stack" style="--gap: 1.4rem;">
          <div class="panel--bare">
            <div class="panel-head">
              <span>Category mix</span>
              <span>{categories.length} groups</span>
            </div>
            <div class="family-meter">
              {categories.map((category) => (
                <div class="family-meter__row">
                  <div>
                    <span>{category.label}</span>
                    <small>{category.rows.map((row) => row.gear.name).join(' · ')}</small>
                  </div>
                  <strong>{category.rows.length}</strong>
                  <i style={`width: ${Math.max(12, (category.rows.length / maxCategoryCount) * 100)}%;`}></i>
                </div>
              ))}
            </div>
          </div>

          <div class="panel--bare">
            <div class="panel-head">
              <span>Current players</span>
              <span>{currentMemberRows.length}</span>
            </div>
            <div class="current-register">
              {currentMemberRows.map((row) => (
                <a href={`/band/members/${row.member.slug}`} class="current-register__row">
                  <span>
                    <strong>{row.member.name}</strong>
                    <small>{memberRoleLabel(row.member) || row.families.map((family) => familyLabels[family]).join(' / ')}</small>
                  </span>
                  <em>{row.matches.length}</em>
                </a>
              ))}
            </div>
          </div>

          <div class="panel--bare">
            <div class="panel-head">
              <span>Model quality</span>
              <span>{namedLinkCount ? 'mixed' : 'role-derived'}</span>
            </div>
            <div class="model-note">
              <p>Direct player links are shown first. When they are empty, the member instrument model fills the gap from roles, instruments, and active-year windows.</p>
            </div>
          </div>
        </aside>
      </div>
    )}
  </section>

  <section class="container gear-section" data-gear-panel="categories" hidden>
    <div class="gear-section__intro">
      <div>
        <div class="mono muted">Equipment families</div>
        <h2 class="serif">Filed by sound source</h2>
      </div>
      <div class="mono-sm muted">{categories.length} categories</div>
    </div>
    <div class="category-grid">
      {categories.map((category) => (
        <section class="category-block">
          <div class="category-block__head">
            <span>{category.label}</span>
            <strong>{category.rows.length}</strong>
          </div>
          <div class="category-block__items">
            {category.rows.map((row) => (
              <a href={`#${row.gear.slug || row.gear.id}`}>
                <span>{row.gear.name}</span>
                <small>{row.range}</small>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>

  <section class="container gear-section" data-gear-panel="members" hidden>
    <div class="gear-section__intro">
      <div>
        <div class="mono muted">Member data model</div>
        <h2 class="serif">Instrument register</h2>
      </div>
      <div class="mono-sm muted">{members.length} members</div>
    </div>
    <div class="member-register">
      {memberRows.map((row) => (
        <a href={`/band/members/${row.member.slug}`} class="member-gear-row">
          <span class="member-gear-row__status">{row.member.is_current_member ? 'Current' : 'Archive'}</span>
          <span class="member-gear-row__main">
            <strong>{row.member.name}</strong>
            <small>{memberTenureLabel(row.member)}</small>
          </span>
          <span class="member-gear-row__families">
            {row.families.map((family) => familyLabels[family]).join(' / ')}
          </span>
          <span class="member-gear-row__count">{row.matches.length}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="container gear-section" data-gear-panel="ledger" hidden>
    <div class="gear-section__intro">
      <div>
        <div class="mono muted">Archive ledger</div>
        <h2 class="serif">Every filed instrument</h2>
      </div>
      <div class="mono-sm muted">{gearRows.length} entries</div>
    </div>
    <div class="gear-ledger-wrap">
      <table class="data data--airy gear-ledger">
        <thead>
          <tr>
            <th class="gear-ledger__no">No.</th>
            <th>Item</th>
            <th class="gear-ledger__category">Category</th>
            <th class="gear-ledger__era">Era</th>
            <th class="gear-ledger__members">Member links</th>
          </tr>
        </thead>
        <tbody>
          {gearRows.map((row) => (
            <tr>
              <td class="idx" data-label="No.">{String(row.index + 1).padStart(2, '0')}</td>
              <td data-label="Item">
                <span class="serif" style="font-size: 18px;">{row.gear.name}</span>
                {(row.gear.description || row.gear.notes) && <div class="mono-sm muted gear-ledger-note">{row.gear.description || row.gear.notes}</div>}
              </td>
              <td class="mono-sm" data-label="Category">{row.label}</td>
              <td class="mono-sm muted" data-label="Era">{row.range}</td>
              <td class="mono-sm gear-ledger__links" data-label="Member links">
                <div class="gear-link-list">
                  {row.links.length ? row.links.slice(0, 6).map((link) => (
                    <a href={`/band/members/${link.member.slug}`} class={`gear-link-pill gear-link-pill--${link.source}`}>
                      {link.member.name}
                    </a>
                  )) : (
                    <span class="gear-link-pill gear-link-pill--empty">TBC</span>
                  )}
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Layout>

<style>
  .gear-topbar {
    padding-top: clamp(20px, 3vw, 34px);
  }

  .gear-head {
    display: grid;
    grid-template-columns: minmax(0, 430px) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 56px);
    padding: clamp(18px, 3vw, 34px) var(--gutter) clamp(32px, 4vw, 58px);
    border-bottom: 1px solid var(--rule);
    max-width: var(--max-w);
    margin: 0 auto;
  }

  .gear-plate {
    aspect-ratio: 4 / 5;
    position: relative;
    margin: 0;
    overflow: hidden;
    background: var(--bg-3);
    border: 1px solid var(--rule);
  }

  .gear-plate img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(.9) contrast(1.05);
  }

  .gear-plate__corner {
    position: absolute;
    z-index: 2;
    padding: 13px 14px;
    pointer-events: none;
  }

  .gear-plate__corner--tl { top: 0; left: 0; }
  .gear-plate__corner--tr { top: 0; right: 0; text-align: right; }
  .gear-plate__corner--bl { bottom: 0; left: 0; max-width: 100%; }

  .gear-plate__corner > * {
    display: inline-block;
    max-width: min(320px, 72vw);
    padding: 4px 8px;
    background: color-mix(in oklab, var(--bg), transparent 12%);
    backdrop-filter: blur(6px);
  }

  .gear-rack {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: repeat(5, 1fr);
    gap: 1px;
    padding: 72px 26px 56px;
    background:
      linear-gradient(90deg, transparent 0 48%, var(--rule-2) 48% 52%, transparent 52%),
      repeating-linear-gradient(0deg, var(--bg-3), var(--bg-3) 18px, var(--bg-2) 18px, var(--bg-2) 19px);
  }

  .gear-rack__strings span {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: color-mix(in oklab, var(--ink-2), transparent 78%);
  }

  .gear-rack__module {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 0;
    padding: 14px;
    border: 1px solid var(--rule);
    background: color-mix(in oklab, var(--bg), transparent 10%);
  }

  .gear-rack__module span {
    color: var(--ink-2);
    font-family: var(--f-mono);
    font-size: 10px;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  .gear-rack__module strong {
    color: var(--ink);
    font-family: var(--f-display);
    font-size: clamp(30px, 5vw, 54px);
    font-style: italic;
    font-weight: 400;
    line-height: 1;
  }

  .gear-rack__module--guitar { border-left-color: var(--hot); }
  .gear-rack__module--bass { border-left-color: var(--gold); }
  .gear-rack__module--keyboard { border-left-color: var(--cool); }
  .gear-rack__module--drums { border-left-color: var(--blood); }
  .gear-rack__module--voice,
  .gear-rack__module--other { border-left-color: var(--accent); }

  .gear-head__body {
    min-width: 0;
  }

  .gear-head__title {
    margin: 16px 0 0;
    color: var(--ink);
    font-size: clamp(54px, 9vw, 116px);
    line-height: .92;
    font-style: italic;
    font-weight: 500;
    letter-spacing: 0;
    overflow-wrap: anywhere;
  }

  .gear-head__meta {
    margin-top: 12px;
    color: var(--ink-2);
  }

  .gear-head__lede {
    max-width: 680px;
    margin: 24px 0 0;
    color: var(--ink-2);
    font-family: var(--f-serif);
    font-size: 19px;
    line-height: 1.65;
  }

  .archivist {
    margin-top: 18px;
    max-width: 680px;
    color: var(--muted);
    font-family: var(--f-serif);
    font-size: 14px;
    font-style: italic;
    line-height: 1.6;
  }

  .archivist .mono-sm {
    margin-right: .5em;
  }

  .gear-head__body .facts {
    margin-top: 28px;
  }

  .gear-tabs-wrap {
    margin-top: clamp(20px, 2.4vw, 32px);
    padding-bottom: 0;
  }

