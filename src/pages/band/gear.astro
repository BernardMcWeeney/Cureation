<script>
  function wireGearTabs() {
    const tablist = document.querySelector<HTMLElement>('[data-gear-tabs]');
    if (!tablist || tablist.dataset.wired === 'true') return;
    tablist.dataset.wired = 'true';
    const tabs = Array.from(tablist.querySelectorAll<HTMLButtonElement>('.gear-tab'));
    const panels = document.querySelectorAll<HTMLElement>('[data-gear-panel]');
    if (!tabs.length) return;

    const activate = (tab: HTMLButtonElement, moveFocus = false) => {
      const target = tab.getAttribute('data-target');
      tabs.forEach((item) => {
        const isActive = item === tab;
        item.classList.toggle('is-active', isActive);
        item.setAttribute('aria-selected', String(isActive));
        item.tabIndex = isActive ? 0 : -1;
      });
      panels.forEach((panel) => {
        panel.hidden = panel.getAttribute('data-gear-panel') !== target;
      });
      tab.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });
      if (moveFocus) tab.focus();
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => activate(tab));
      tab.addEventListener('keydown', (event) => {
        const current = tabs.indexOf(tab);
        let next = current;
        if (event.key === 'ArrowRight') next = (current + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') next = (current - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault();
        activate(tabs[next], true);
      });
    });

    const overviewTab = tabs.find((tab) => tab.dataset.target === 'overview');
    document.querySelectorAll<HTMLAnchorElement>('[data-gear-jump]').forEach((link) => {
      link.addEventListener('click', (event) => {
        const targetId = link.dataset.gearJump;
        const target = targetId ? document.getElementById(targetId) : null;
        if (!overviewTab || !target) return;
        event.preventDefault();
        activate(overviewTab);
        history.replaceState(null, '', `#${targetId}`);
        requestAnimationFrame(() => {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          target.focus({ preventScroll: true });
        });
      });
    });
  }

  wireGearTabs();
  document.addEventListener('astro:page-load', wireGearTabs);
</script>
