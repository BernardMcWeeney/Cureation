---
import { editable, copyText, copyAttr, copySource } from '../../lib/visual-editing';
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import Crumbs from '../../components/ui/Crumbs.astro';
import Tag from '../../components/ui/Tag.astro';
import {
  listGear,
  listMembers,
  memberGearFamilies,
  memberRoleLabel,
  memberTenureLabel,
  type Gear,
  type GearFamily,
  type Member,
} from '../../lib/directus';
import { asset } from '../../lib/assets';

const [gear, members] = await Promise.all([
  listGear().catch(() => []),
  listMembers().catch(() => []),
]);

type LinkSource = 'direct' | 'named' | 'role';
type GearLink = { member: Member; source: LinkSource; score: number };
type GearRow = {
  gear: Gear;
  index: number;
  family: GearFamily;
  label: string;
  range: string;
  rangeStart: number | null;
  rangeEnd: number | null;
  links: GearLink[];
};

const familyOrder: GearFamily[] = ['guitar', 'bass', 'keyboard', 'drums', 'voice', 'other'];
const familyLabels: Record<GearFamily, string> = {
  guitar: 'Guitars',
  bass: 'Bass',
  keyboard: 'Keyboards',
  drums: 'Drums',
  voice: 'Voice',
  other: 'Other',
};
const familyTone: Record<GearFamily, string> = {
  guitar: 'hot',
  bass: 'gold',
  keyboard: 'cool',
  drums: 'blood',
  voice: 'accent',
  other: 'default',
};

function norm(value: unknown): string {
  return String(value ?? '').trim().toLowerCase();
}

function titleCase(value: string): string {
  return value.replace(/[-_]/g, ' ').replace(/\b\w/g, (char) => char.toUpperCase());
}

function gearFamily(item: Gear): GearFamily {
  const text = norm([item.kind, item.category, item.name, item.description, item.notes].filter(Boolean).join(' '));
  if (/\b(six[- ]string bass|bass guitar|bass)\b/.test(text)) return 'bass';
  if (/\b(guitar|baritone|jazzmaster|schecter)\b/.test(text)) return 'guitar';
  if (/\b(keyboard|keyboards|synth|synthesizer|piano|organ|oberheim|roland)\b/.test(text)) return 'keyboard';
  if (/\b(drum|drums|percussion|kit)\b/.test(text)) return 'drums';
  if (/\b(vocal|vocals|voice|microphone)\b/.test(text)) return 'voice';
  return 'other';
}

function yearFromChunk(value: string | null, fallback: number | null): number | null {
  if (!value) return fallback;
  const decade = value.match(/(\d{4})s/);
  if (decade) return Number(decade[1]);
  const year = value.match(/(\d{4})/);
  return year ? Number(year[1]) : fallback;
}

function rangeStart(item: Gear): number | null {
  return yearFromChunk(item.era_range, null);
}

function rangeEnd(item: Gear): number | null {
  const text = norm(item.era_range);
  if (!text || text.includes('present')) return null;
  const years = text.match(/\d{4}s?|\d{4}/g) ?? [];
  return yearFromChunk(years[years.length - 1] || null, null);
}

function rangeLabel(item: Gear): string {
  return item.era_range || 'Era to be filed';
}

function overlapsStints(member: Member, start: number | null, end: number | null): boolean {
  const stints = member.stints ?? [];
  if (!stints.length || start === null) return true;
  const rangeEndYear = end ?? new Date().getUTCFullYear();
  return stints.some((stint) => {
    if (stint.start_year === null) return false;
    const stintEnd = stint.end_year ?? 9999;
    return stint.start_year <= rangeEndYear && stintEnd >= start;
  });
}

function usedByTokens(value: unknown): { ids: Set<number>; names: Set<string> } {
  const ids = new Set<number>();
  const names = new Set<string>();
  const values = Array.isArray(value) ? value : [value];
  for (const item of values) {
    if (!item) continue;
    if (typeof item === 'object') {
      const id = Number((item as any).id ?? (item as any).member ?? (item as any).member_id);
      if (Number.isFinite(id)) ids.add(id);
      const name = norm((item as any).name);
      if (name) names.add(name);
      continue;
    }
    const id = Number(item);
    if (Number.isFinite(id)) ids.add(id);
    const name = norm(item);
    if (name && !Number.isFinite(id)) names.add(name);
  }
  return { ids, names };
}

function linksForGear(item: Gear): GearLink[] {
  const family = gearFamily(item);
  const text = norm([item.name, item.description, item.notes, item.owner].filter(Boolean).join(' '));
  const direct = usedByTokens(item.used_by);
  const start = rangeStart(item);
  const end = rangeEnd(item);
  const links: GearLink[] = [];

  for (const member of members) {
    const memberName = norm(member.name);
    const families = member.gear_families ?? memberGearFamilies(member);
    const isDirect = direct.ids.has(member.id) || direct.names.has(memberName);
    const isNamed = memberName.length > 0 && text.includes(memberName);
    const isRoleMatch = families.includes(family) && overlapsStints(member, start, end);

    if (isDirect) links.push({ member, source: 'direct', score: 0 });
    else if (isNamed) links.push({ member, source: 'named', score: 1 });
    else if (isRoleMatch) links.push({ member, source: 'role', score: 2 });
  }

  const byId = new Map<number, GearLink>();
  for (const link of links) {
    const prev = byId.get(link.member.id);
    if (!prev || link.score < prev.score) byId.set(link.member.id, link);
  }

  return Array.from(byId.values()).sort((a, b) => {
    if (a.score !== b.score) return a.score - b.score;
    if (a.member.is_current_member !== b.member.is_current_member) return a.member.is_current_member ? -1 : 1;
    return a.member.name.localeCompare(b.member.name);
  });
}

const gearRows: GearRow[] = gear.map((item, index) => {
  const family = gearFamily(item);
  return {
    gear: item,
    index,
    family,
    label: familyLabels[family],
    range: rangeLabel(item),
    rangeStart: rangeStart(item),
    rangeEnd: rangeEnd(item),
    links: linksForGear(item),
  };
});

const categories = familyOrder
  .map((family) => ({
    family,
    label: familyLabels[family],
    rows: gearRows.filter((row) => row.family === family),
  }))
  .filter((category) => category.rows.length > 0);

const memberRows = members.map((member) => {
  const families = member.gear_families ?? memberGearFamilies(member);
  const matches = gearRows.filter((row) =>
    row.links.some((link) => link.member.id === member.id) ||
    families.includes(row.family)
  );
  return { member, families, matches };
});

const currentMemberRows = memberRows.filter((row) => row.member.is_current_member);
const linkedMemberCount = new Set(gearRows.flatMap((row) => row.links.map((link) => link.member.id))).size;
const namedLinkCount = gearRows.reduce((count, row) =>
  count + row.links.filter((link) => link.source !== 'role').length, 0);
const featured = gearRows.find((row) => row.gear.image) || gearRows[0] || null;
const maxCategoryCount = Math.max(1, ...categories.map((category) => category.rows.length));
const sourceLabel: Record<LinkSource, string> = {
  direct: 'Direct',
  named: 'Named',
  role: 'Role',
};
---
<Layout title="Instruments & equipment · The band · Cureation">
  <div class="container gear-topbar">
    <Crumbs items={[
      { ...copySource({"label":"pages_band_gear_data-4946dfc0e802"}),  label: copyText("pages_band_gear_data-4946dfc0e802", "Home"), href: '/' },
      { ...copySource({"label":"pages_band_gear_data-95a253e13d2c"}),  label: copyText("pages_band_gear_data-95a253e13d2c", "The band"), href: '/band' },
      { ...copySource({"label":"pages_band_gear_data-3dad3989624f"}),  label: copyText("pages_band_gear_data-3dad3989624f", "Equipment") },
    ]} />
  </div>

  <section id="gear-dossier" class="container detail-anchor" style="padding-block: 28px;">
    <h1 class="serif" style="font-size: clamp(40px, 6vw, 72px); line-height: 1.1; margin: 0;">Instruments &amp; equipment</h1>
  </section>

  <div class="container gear-tabs-wrap">
    <div class="gear-tabs" data-gear-tabs role="tablist" aria-label="Equipment">
      <button id="gear-tab-overview" class="gear-tab is-active" type="button" role="tab" data-target="overview" aria-controls="gear-panel-overview" aria-selected="true">
        Overview <span class="gear-tab__count">{gearRows.length}</span>
      </button>
      <button id="gear-tab-categories" class="gear-tab" type="button" role="tab" data-target="categories" aria-controls="gear-panel-categories" aria-selected="false" tabindex="-1">
        Categories <span class="gear-tab__count">{categories.length}</span>
      </button>
      <button id="gear-tab-members" class="gear-tab" type="button" role="tab" data-target="members" aria-controls="gear-panel-members" aria-selected="false" tabindex="-1">
        Member register <span class="gear-tab__count">{members.length}</span>
      </button>
      <button id="gear-tab-ledger" class="gear-tab" type="button" role="tab" data-target="ledger" aria-controls="gear-panel-ledger" aria-selected="false" tabindex="-1">
        Ledger <span class="gear-tab__count">{gearRows.length}</span>
      </button>
    </div>
  </div>

  <section id="gear-panel-overview" class="container gear-section detail-anchor" data-gear-panel="overview" role="tabpanel" aria-labelledby="gear-tab-overview">
    {gearRows.length === 0 ? (
      <div class="empty-note">
        <div class="mono-sm muted">In progress</div>
        <h2 data-directus={copyAttr("pages_band_gear_a719141856e3")} set:html={copyText("pages_band_gear_a719141856e3", "Gear ledger")} class="serif"></h2>
        <p data-directus={copyAttr("pages_band_gear_bbcceb91a11c")} set:html={copyText("pages_band_gear_bbcceb91a11c", "Collection is being populated. Check back as entries land.")}></p>
      </div>
    ) : (
      <div class="gear-layout archive-columns">
        <div class="gear-stack">
          {gearRows.map((row) => (
            <article  class={`gear-card detail-anchor${row.gear.image ? ' gear-card--image' : ''}`} id={row.gear.slug || row.gear.id} tabindex="-1">
              <div data-directus={editable(row, ["index"])} class="gear-card__idx">{String(row.index + 1).padStart(2, '0')}</div>
              {row.gear.image && (
                <figure class="gear-card__image">
                  <img data-directus={editable(row.gear, ["image"]) ?? editable(row, ["gear"])} src={asset(row.gear.image, 'card')} alt={row.gear.name} loading="lazy" />
                </figure>
              )}
              <div  class="gear-card__body">
                <div class="gear-card__top">
                  <div>
                    <div data-directus={editable(row, ["label","range"])} class="mono-sm muted">{row.label} · {row.range}</div>
                    <h2 data-directus={editable(row.gear, ["name"]) ?? editable(row, ["gear"])} class="serif">{row.gear.name}</h2>
                  </div>
                  <span data-directus={editable(row, ["family"])} class={`tag tag--${familyTone[row.family] === 'default' ? 'cool' : familyTone[row.family]}`}>
                    {row.family.toUpperCase()}
                  </span>
                </div>
                {(row.gear.description || row.gear.notes) && (
                  <p data-directus={editable(row.gear, ["description","notes"]) ?? editable(row, ["gear"])}>{row.gear.description || row.gear.notes}</p>
                )}
                <div  class="gear-card__links">
                  {row.links.length > 0 ? row.links.slice(0, 5).map((link) => (
                    <a href={`/band/members/${link.member.slug}`} class={`player-chip player-chip--${link.source}`}>
                      <span data-directus={editable(link.member, ["name"]) ?? editable(link, ["member"])}>{link.member.name}</span>
                      <small data-directus={editable(link, ["source"])}>{sourceLabel[link.source]}</small>
                    </a>
                  )) : (
                    <span data-directus={copyAttr("pages_band_gear_a35fa3afd488")} set:html={copyText("pages_band_gear_a35fa3afd488", "Player link TBC")} class="player-chip player-chip--empty"></span>
                  )}
                </div>
                <div class="gear-card__meta">
                  <span data-directus={editable(row.gear, ["manufacturer","model","kind","category"]) ?? editable(row, ["gear","family"])}>{row.gear.manufacturer || row.gear.model || titleCase(row.gear.kind || row.gear.category || row.family)}</span>
                  <span data-directus={editable(row, ["range"])}>{row.range}</span>
                  <span data-directus={editable(row, ["links"])}>{row.links.length ? `${row.links.length} member ${row.links.length === 1 ? 'link' : 'links'}` : 'Unlinked'}</span>
                </div>
              </div>
            </article>
          ))}
        </div>

        <aside class="gear-aside stack" style="--gap: 1.4rem;">
          <div class="panel--bare">
            <div class="panel-head">
              <span data-directus={copyAttr("pages_band_gear_661b3221782d")} set:html={copyText("pages_band_gear_661b3221782d", "Category mix")}></span>
              <span>{categories.length} groups</span>
            </div>
            <div class="family-meter">
              {categories.map((category) => (
                <div class="family-meter__row">
                  <div>
                    <span data-directus={editable(category, ["label"])}>{category.label}</span>
                    <small data-directus={editable(category, ["rows"])}>{category.rows.map((row) => row.gear.name).join(' · ')}</small>
                  </div>
                  <strong data-directus={editable(category, ["rows"])}>{category.rows.length}</strong>
                  <i style={`width: ${Math.max(12, (category.rows.length / maxCategoryCount) * 100)}%;`}></i>
                </div>
              ))}
            </div>
          </div>

          <div class="panel--bare">
            <div class="panel-head">
              <span data-directus={copyAttr("pages_band_gear_cb74917d203c")} set:html={copyText("pages_band_gear_cb74917d203c", "Current players")}></span>
              <span>{currentMemberRows.length}</span>
            </div>
            <div class="current-register">
              {currentMemberRows.map((row) => (
                <a href={`/band/members/${row.member.slug}`} class="current-register__row">
                  <span>
                    <strong data-directus={editable(row.member, ["name"]) ?? editable(row, ["member"])}>{row.member.name}</strong>
                    <small data-directus={editable(row, ["member","families"])}>{memberRoleLabel(row.member) || row.families.map((family) => familyLabels[family]).join(' / ')}</small>
                  </span>
                  <em data-directus={editable(row, ["matches"])}>{row.matches.length}</em>
                </a>
              ))}
            </div>
          </div>

          <div class="panel--bare">
            <div class="panel-head">
              <span data-directus={copyAttr("pages_band_gear_26c5d13d5230")} set:html={copyText("pages_band_gear_26c5d13d5230", "Model quality")}></span>
              <span>{namedLinkCount ? 'mixed' : 'role-derived'}</span>
            </div>
            <div class="model-note">
              <p data-directus={copyAttr("pages_band_gear_27d892035cbe")} set:html={copyText("pages_band_gear_27d892035cbe", "Direct player links are shown first. When they are empty, the member instrument model fills the gap from roles, instruments, and active-year windows.")}></p>
            </div>
          </div>
        </aside>
      </div>
    )}
  </section>

  <section id="gear-panel-categories" class="container gear-section detail-anchor" data-gear-panel="categories" role="tabpanel" aria-labelledby="gear-tab-categories" hidden>

    <div class="category-grid">
      {categories.map((category) => (
        <section class="category-block">
          <div class="category-block__head">
            <span data-directus={editable(category, ["label"])}>{category.label}</span>
            <strong data-directus={editable(category, ["rows"])}>{category.rows.length}</strong>
          </div>
          <div  class="category-block__items">
            {category.rows.map((row) => (
              <a href={`#${row.gear.slug || row.gear.id}`} data-gear-jump={row.gear.slug || row.gear.id}>
                <span data-directus={editable(row.gear, ["name"]) ?? editable(row, ["gear"])}>{row.gear.name}</span>
                <small data-directus={editable(row, ["range"])}>{row.range}</small>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>

  <section id="gear-panel-members" class="container gear-section detail-anchor" data-gear-panel="members" role="tabpanel" aria-labelledby="gear-tab-members" hidden>

    <div class="member-register">
      {memberRows.map((row) => (
        <a href={`/band/members/${row.member.slug}`} class="member-gear-row">
          <span data-directus={editable(row.member, ["is_current_member"]) ?? editable(row, ["member"])} class="member-gear-row__status">{row.member.is_current_member ? 'Current' : 'Archive'}</span>
          <span class="member-gear-row__main">
            <strong data-directus={editable(row.member, ["name"]) ?? editable(row, ["member"])}>{row.member.name}</strong>
            <small data-directus={editable(row, ["member"])}>{memberTenureLabel(row.member)}</small>
          </span>
          <span data-directus={editable(row, ["families"])} class="member-gear-row__families">
            {row.families.map((family) => familyLabels[family]).join(' / ')}
          </span>
          <span data-directus={editable(row, ["matches"])} class="member-gear-row__count">{row.matches.length}</span>
        </a>
      ))}
    </div>
  </section>

  <section id="gear-panel-ledger" class="container gear-section detail-anchor" data-gear-panel="ledger" role="tabpanel" aria-labelledby="gear-tab-ledger" hidden>

    <div class="gear-ledger-wrap">
      <table class="data data--airy gear-ledger">
        <thead>
          <tr>
            <th data-directus={copyAttr("pages_band_gear_ad654a9b16bf")} set:html={copyText("pages_band_gear_ad654a9b16bf", "No.")} class="gear-ledger__no"></th>
            <th data-directus={copyAttr("pages_band_gear_da74931c95d3")} set:html={copyText("pages_band_gear_da74931c95d3", "Item")}></th>
            <th data-directus={copyAttr("pages_band_gear_86f84454b1fc")} set:html={copyText("pages_band_gear_86f84454b1fc", "Category")} class="gear-ledger__category"></th>
            <th data-directus={copyAttr("pages_band_gear_890c12c43206")} set:html={copyText("pages_band_gear_890c12c43206", "Era")} class="gear-ledger__era"></th>
            <th data-directus={copyAttr("pages_band_gear_8adea4304aa3")} set:html={copyText("pages_band_gear_8adea4304aa3", "Member links")} class="gear-ledger__members"></th>
          </tr>
        </thead>
        <tbody>
          {gearRows.map((row) => (
            <tr>
              <td data-directus={editable(row, ["index"])} class="idx" data-label="No.">{String(row.index + 1).padStart(2, '0')}</td>
              <td  data-label="Item">
                <span data-directus={editable(row.gear, ["name"]) ?? editable(row, ["gear"])} class="serif" style="font-size: 18px;">{row.gear.name}</span>
                {(row.gear.description || row.gear.notes) && <div data-directus={editable(row.gear, ["description","notes"]) ?? editable(row, ["gear"])} class="mono-sm muted gear-ledger-note">{row.gear.description || row.gear.notes}</div>}
              </td>
              <td data-directus={editable(row, ["label"])} class="mono-sm" data-label="Category">{row.label}</td>
              <td data-directus={editable(row, ["range"])} class="mono-sm muted" data-label="Era">{row.range}</td>
              <td class="mono-sm gear-ledger__links" data-label="Member links">
                <div  class="gear-link-list">
                  {row.links.length ? row.links.slice(0, 6).map((link) => (
                    <a data-directus={editable(link.member, ["name"]) ?? editable(link, ["member"])} href={`/band/members/${link.member.slug}`} class={`gear-link-pill gear-link-pill--${link.source}`}>
                      {link.member.name}
                    </a>
                  )) : (
                    <span data-directus={copyAttr("pages_band_gear_dfa4c96f8e26")} set:html={copyText("pages_band_gear_dfa4c96f8e26", "TBC")} class="gear-link-pill gear-link-pill--empty"></span>
                  )}
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Layout>

<style>
  .gear-topbar {
    padding-top: clamp(20px, 3vw, 34px);
  }

  .gear-head {
    display: grid;
    grid-template-columns: minmax(0, 430px) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 56px);
    padding: clamp(18px, 3vw, 34px) var(--gutter) clamp(32px, 4vw, 58px);
    border-bottom: 1px solid var(--rule);
    max-width: var(--max-w);
    margin: 0 auto;
  }

  .gear-plate {
    aspect-ratio: 4 / 5;
    position: relative;
    margin: 0;
    overflow: hidden;
    background: var(--bg-3);
    border: 1px solid var(--rule);
  }

  .gear-plate img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(.9) contrast(1.05);
  }

  .gear-plate__corner {
    position: absolute;
    z-index: 2;
    padding: 13px 14px;
    pointer-events: none;
  }

  .gear-plate__corner--tl { top: 0; left: 0; }
  .gear-plate__corner--tr { top: 0; right: 0; text-align: right; }
  .gear-plate__corner--bl { bottom: 0; left: 0; max-width: 100%; }

  .gear-plate__corner > * {
    display: inline-block;
    max-width: min(320px, 72vw);
    padding: 4px 8px;
    background: color-mix(in oklab, var(--bg), transparent 12%);
    backdrop-filter: blur(6px);
  }

  .gear-rack {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: repeat(5, 1fr);
    gap: 1px;
    padding: 72px 26px 56px;
    background:
      linear-gradient(90deg, transparent 0 48%, var(--rule-2) 48% 52%, transparent 52%),
      repeating-linear-gradient(0deg, var(--bg-3), var(--bg-3) 18px, var(--bg-2) 18px, var(--bg-2) 19px);
  }

  .gear-rack__strings span {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: color-mix(in oklab, var(--ink-2), transparent 78%);
  }

  .gear-rack__module {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 0;
    padding: 14px;
    border: 1px solid var(--rule);
    background: color-mix(in oklab, var(--bg), transparent 10%);
  }

  .gear-rack__module span {
    color: var(--ink-2);
    font-family: var(--f-ui);
    font-size: var(--text-label);
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .gear-rack__module :global(strong) {
    color: var(--ink);
    font-family: var(--f-display);
    font-size: clamp(30px, 5vw, 54px);
    font-style: italic;
    font-weight: 400;
    line-height: 1;
  }

  .gear-rack__module--guitar { border-left-color: var(--hot); }
  .gear-rack__module--bass { border-left-color: var(--gold); }
  .gear-rack__module--keyboard { border-left-color: var(--cool); }
  .gear-rack__module--drums { border-left-color: var(--blood); }
