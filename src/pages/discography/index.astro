---
import MainLayout from '../../layouts/MainLayout.astro';
import AlbumCard from '../../components/AlbumCard.astro';
import GothicCobweb from '../../components/GothicCobweb.astro';
import GothicSwirls from '../../components/GothicSwirls.astro';
import { fetchAlbumsGroupedByType, getAlbumEra, eraMetadata } from '../../lib/directus';
import type { AlbumEra } from '../../types/directus';

// Fetch all albums grouped by type
const albumsByType = await fetchAlbumsGroupedByType();

// Define tab order and which types to show as primary tabs
const primaryTypes: { key: string; label: string; icon: string }[] = [
  { key: 'studio', label: 'Studio Albums', icon: 'M9 19V6l12-2v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3' },
  { key: 'compilation', label: 'Compilations', icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10' },
  { key: 'live', label: 'Live Albums', icon: 'M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z' },
  { key: 'deluxe', label: 'Deluxe Editions', icon: 'M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z' },
  { key: 'ep', label: 'EPs & Singles', icon: 'M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z' },
  { key: 'boxset', label: 'Box Sets', icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4' },
];

// Count totals
const allAlbums = Object.values(albumsByType).flat();
const totalReleases = allAlbums.length;

// Also prepare era-grouped view for studio albums
const studioAlbums = albumsByType['studio'] || [];
const studioByEra = studioAlbums.reduce((acc, album) => {
  const era = getAlbumEra(album.releaseDate !== 'Unknown' ? album.releaseDate : undefined);
  if (!acc[era]) acc[era] = [];
  acc[era].push(album);
  return acc;
}, {} as Record<AlbumEra, typeof studioAlbums>);

const eraOrder: AlbumEra[] = ['early', 'pop', 'classic', 'experimental', 'modern'];
const eraColors: Record<AlbumEra, { bg: string; border: string; text: string }> = {
  early: { bg: 'bg-violet-500/20', border: 'border-violet-500/30', text: 'text-violet-400' },
  pop: { bg: 'bg-pink-500/20', border: 'border-pink-500/30', text: 'text-pink-400' },
  classic: { bg: 'bg-blue-500/20', border: 'border-blue-500/30', text: 'text-blue-400' },
  experimental: { bg: 'bg-amber-500/20', border: 'border-amber-500/30', text: 'text-amber-400' },
  modern: { bg: 'bg-green-500/20', border: 'border-green-500/30', text: 'text-green-400' }
};
---

<MainLayout
  title="Discography"
  description="The complete discography of The Cure — studio albums, compilations, live albums, deluxe editions, EPs, box sets, and more."
  pageClass="bg-black"
>
  <!-- Hero Section with gothic styling -->
  <section class="mb-10">
    <div class="glass-panel overflow-hidden relative gothic-corners bg-cobweb">
      <GothicCobweb position="top-left" size="lg" opacity={0.1} />
      <GothicCobweb position="bottom-right" size="md" opacity={0.06} />
      <div class="absolute -top-20 -left-20 w-64 h-64 rounded-full bg-primary/10 blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-10 -right-10 w-48 h-48 rounded-full bg-accent/[0.06] blur-2xl pointer-events-none"></div>

      <div class="relative p-8 md:p-12">
        <div class="flex items-center gap-3 mb-4">
          <span class="badge">Complete Collection</span>
          <div class="divider-gradient flex-1 max-w-24"></div>
        </div>

        <h1 class="font-display text-5xl md:text-6xl lg:text-7xl text-white mb-4 text-glow" transition:animate="slide">
          Discography
        </h1>
        <p class="text-white/75 text-lg md:text-xl max-w-3xl leading-relaxed" transition:animate="fade">
          Every release from The Cure — spanning over four decades of studio albums, compilations, live recordings, deluxe editions, and more.
        </p>

        <div class="flex flex-wrap gap-8 mt-8 pt-6 border-t border-white/[0.08]">
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-primary text-glow">{totalReleases}</span>
            <span class="text-white/60 text-base font-medium">Releases</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-primary text-glow">{studioAlbums.length}</span>
            <span class="text-white/60 text-base font-medium">Studio Albums</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-3xl font-display text-primary text-glow">45+</span>
            <span class="text-white/60 text-base font-medium">Years</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Type Tabs -->
  <nav class="mb-10 overflow-x-auto scrollbar-hide">
    <div class="flex gap-2 min-w-max pb-2">
      {primaryTypes.map((tab, idx) => {
        const count = albumsByType[tab.key]?.length || 0;
        if (count === 0) return null;
        return (
          <button
            type="button"
            class={`type-tab flex items-center gap-2 px-4 py-2.5 rounded-sm text-sm font-medium transition-all whitespace-nowrap tracking-wide ${idx === 0 ? 'active' : ''}`}
            data-tab={tab.key}
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d={tab.icon} />
            </svg>
            {tab.label}
            <span class="tab-count px-1.5 py-0.5 rounded-sm text-xs">{count}</span>
          </button>
        );
      })}
    </div>
  </nav>

  <!-- Studio Albums Panel (default, with era grouping) -->
  <section id="panel-studio" class="type-panel">
    <!-- Sub-toggle: By Era vs Chronological -->
    <div class="flex items-center gap-3 mb-8">
      <div class="flex items-center gap-1 p-1 rounded-sm bg-black/40 border border-white/[0.08]">
        <button type="button" id="studio-era-btn" class="studio-view-btn px-3 py-1.5 rounded-sm text-xs font-medium tracking-wide transition-all active">By Era</button>
        <button type="button" id="studio-chrono-btn" class="studio-view-btn px-3 py-1.5 rounded-sm text-xs font-medium tracking-wide transition-all">Chronological</button>
      </div>
      <span class="text-sm text-white/35">{studioAlbums.length} studio albums</span>
    </div>

    <!-- Era View -->
    <div id="studio-era-view" class="space-y-14">
      {eraOrder.map(era => {
        const eraAlbums = studioByEra[era] || [];
        if (eraAlbums.length === 0) return null;
        const meta = eraMetadata[era];
        const colors = eraColors[era];

        return (
          <div class="era-section" data-era={era}>
            <div class="flex items-center gap-4 mb-6">
              <div class="flex items-center gap-3">
                <div class={`size-9 rounded-sm ${colors.bg} border ${colors.border} flex items-center justify-center`}>
                  <svg xmlns="http://www.w3.org/2000/svg" class={`size-4 ${colors.text}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="12" cy="12" r="10" /><circle cx="12" cy="12" r="3" />
                  </svg>
                </div>
                <div>
                  <h2 class={`font-heading text-xl md:text-2xl ${colors.text}`}>{meta.name}</h2>
                  <p class="text-white/45 text-xs tracking-wide">{meta.years} · {meta.description}</p>
                </div>
              </div>
              <div class="flex-1 h-px bg-gradient-to-r from-white/15 to-transparent"></div>
              <span class={`px-2.5 py-1 rounded-sm ${colors.bg} border ${colors.border} ${colors.text} text-xs font-medium tracking-wider`}>
                {eraAlbums.length}
              </span>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-5">
              {eraAlbums.map((album, index) => (
                <div style={`--index: ${index + 1}`}>
                  <AlbumCard
                    title={album.title}
                    coverImage={album.coverImage}
                    year={album.year}
                    slug={album.slug}
                    featured={album.featured}
                    id={album.id}
                    type="studio"
                  />
                </div>
              ))}
            </div>
          </div>
        );
      })}
    </div>

    <!-- Chronological View (hidden by default) -->
    <div id="studio-chrono-view" class="hidden">
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-5">
        {studioAlbums.map((album, index) => (
          <div style={`--index: ${index + 1}`}>
            <AlbumCard
              title={album.title}
              coverImage={album.coverImage}
              year={album.year}
              slug={album.slug}
              featured={album.featured}
              id={album.id}
              type="studio"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Other Type Panels -->
  {primaryTypes.slice(1).map(tab => {
    const typeAlbums = albumsByType[tab.key] || [];
    if (typeAlbums.length === 0) return null;

    return (
      <section id={`panel-${tab.key}`} class="type-panel hidden">
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-5">
          {typeAlbums.map((album, index) => (
            <div style={`--index: ${index + 1}`}>
              <AlbumCard
                title={album.title}
                coverImage={album.coverImage}
                year={album.year}
                slug={album.slug}
                featured={album.featured}
                id={album.id}
                type={tab.key as any}
              />
            </div>
          ))}
        </div>
      </section>
    );
  })}

  <GothicSwirls position="divider" class="mt-12" />

  <!-- Era Timeline (always visible at bottom) -->
  <section class="mt-16 pt-8 border-t border-white/[0.08]">
    <div class="gothic-heading mb-8">
      <h2 class="font-heading text-xl md:text-2xl text-primary tracking-wider">The Cure Through the Eras</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
      {eraOrder.map(era => {
        const meta = eraMetadata[era];
        const colors = eraColors[era];
        const count = studioByEra[era]?.length || 0;

        return (
          <button
            type="button"
            class={`era-quick-nav group p-4 rounded-sm ${colors.bg} border ${colors.border} hover:scale-105 transition-all duration-300 text-left gothic-corners`}
            data-target-era={era}
          >
            <p class={`font-heading text-lg ${colors.text}`}>{meta.name}</p>
            <p class="text-white/45 text-xs mb-2 tracking-wide">{meta.years}</p>
            <p class="text-white/60 text-sm">{count} albums</p>
          </button>
        );
      })}
    </div>
  </section>
</MainLayout>

<style>
  /* Tab styling - gothic squared */
  .type-tab {
    color: rgba(255, 255, 255, 0.45);
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }
  .type-tab:hover {
    color: rgba(255, 255, 255, 0.85);
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.1);
  }
  .type-tab.active {
    background: rgba(var(--color-primary-rgb, 137, 176, 201), 0.12);
    color: var(--color-primary);
    border-color: rgba(var(--color-primary-rgb, 137, 176, 201), 0.25);
  }
  .tab-count {
    background: rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.35);
  }
  .type-tab.active .tab-count {
    background: rgba(var(--color-primary-rgb, 137, 176, 201), 0.15);
    color: var(--color-primary);
  }

  /* Studio sub-toggle */
  .studio-view-btn {
    color: rgba(255, 255, 255, 0.45);
  }
  .studio-view-btn:hover {
    color: rgba(255, 255, 255, 0.8);
    background: rgba(255, 255, 255, 0.04);
  }
  .studio-view-btn.active {
    background: rgba(var(--color-primary-rgb, 137, 176, 201), 0.15);
    color: var(--color-primary);
  }

  /* Grid animations */
  .grid { --stagger-delay: 60ms; }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  :global(.grid > div) {
    animation: fadeIn 0.4s ease forwards;
    opacity: 0;
    animation-delay: calc(var(--stagger-delay) * var(--index, 1));
  }

  /* Hide scrollbar for tabs */
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
  .scrollbar-hide::-webkit-scrollbar { display: none; }
</style>

<script>
  function initDiscography() {
    // Type tab switching
    const tabs = document.querySelectorAll('.type-tab');
    const panels = document.querySelectorAll('.type-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-tab');
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        panels.forEach(p => p.classList.add('hidden'));
        const panel = document.getElementById(`panel-${target}`);
        if (panel) panel.classList.remove('hidden');
      });
    });

    // Studio album sub-views (era vs chronological)
    const eraBtn = document.getElementById('studio-era-btn');
    const chronoBtn = document.getElementById('studio-chrono-btn');
    const eraView = document.getElementById('studio-era-view');
    const chronoView = document.getElementById('studio-chrono-view');
    const studioViewBtns = document.querySelectorAll('.studio-view-btn');

    eraBtn?.addEventListener('click', () => {
      studioViewBtns.forEach(b => b.classList.remove('active'));
      eraBtn.classList.add('active');
      eraView?.classList.remove('hidden');
      chronoView?.classList.add('hidden');
    });

    chronoBtn?.addEventListener('click', () => {
      studioViewBtns.forEach(b => b.classList.remove('active'));
      chronoBtn.classList.add('active');
      chronoView?.classList.remove('hidden');
      eraView?.classList.add('hidden');
    });

    // Era quick navigation
    document.querySelectorAll('.era-quick-nav').forEach(btn => {
      btn.addEventListener('click', () => {
        const targetEra = btn.getAttribute('data-target-era');
        // Ensure studio tab + era view are active
        tabs.forEach(t => t.classList.remove('active'));
        document.querySelector('.type-tab[data-tab="studio"]')?.classList.add('active');
        panels.forEach(p => p.classList.add('hidden'));
        document.getElementById('panel-studio')?.classList.remove('hidden');
        studioViewBtns.forEach(b => b.classList.remove('active'));
        eraBtn?.classList.add('active');
        eraView?.classList.remove('hidden');
        chronoView?.classList.add('hidden');

        setTimeout(() => {
          const section = document.querySelector(`.era-section[data-era="${targetEra}"]`);
          section?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 100);
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initDiscography);
  document.addEventListener('astro:page-load', initDiscography);
</script>
