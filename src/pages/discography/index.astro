---
import Layout from '../../layouts/Layout.astro';
import AlbumCard from '../../components/album/AlbumCard.astro';
import IssueSection from '../../components/ui/IssueSection.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Select from '../../components/ui/Select.astro';
import SearchField from '../../components/ui/SearchField.astro';
import { listAlbums, listEras } from '../../lib/directus';

const [all, eras] = await Promise.all([listAlbums({ type: 'studio' }), listEras()]);
const erasById = Object.fromEntries(eras.map((e) => [e.id, e]));

const yearsSorted = all.map((a) => Number(a.release_date?.slice(0, 4))).filter(Boolean).sort();
const firstYear = yearsSorted[0];
const lastYear  = yearsSorted[yearsSorted.length - 1];
const erasInRange = new Set(all.map((a) => a.era_id).filter(Boolean)).size;

// Longest gap between studio releases — a real magazine "Did you know" stat.
const sorted = [...all].filter((a) => a.release_date).sort((a, b) => (a.release_date || '').localeCompare(b.release_date || ''));
let longestGap = { from: '', to: '', days: 0 };
for (let i = 1; i < sorted.length; i++) {
  const days = Math.round(
    (new Date(sorted[i].release_date!).getTime() - new Date(sorted[i - 1].release_date!).getTime()) / 86_400_000
  );
  if (days > longestGap.days) longestGap = { from: sorted[i - 1].title, to: sorted[i].title, days };
}
const longestGapYears = Math.round(longestGap.days / 365);

const tabs = [
  { href: '/discography',               label: 'Studio',       active: true },
  { href: '/discography/ep',            label: 'EPs',          active: false },
  { href: '/discography/compilations',  label: 'Compilations', active: false },
  { href: '/discography/singles',       label: 'Singles',      active: false },
];
---
<Layout title="Discography · Cureation">

  <PageHero
    section="Discography"
    title="The discography"
    deck="Every studio record, EP, compilation and single — chronologically arranged, annotated by era, and cross-referenced to the live archive."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Discography' }]}
    facts={[
      { k: 'Records', v: all.length },
      { k: 'First issue', v: firstYear ? String(firstYear) : '—' },
      { k: 'Latest issue', v: lastYear ? String(lastYear) : '—' },
      { k: 'Eras in range', v: erasInRange },
    ]}
    flush
  />

  <nav class="container disc-tabs" aria-label="Record type">
    {tabs.map((t) => (
      <a href={t.href} class={`disc-tabs__tab${t.active ? ' is-active' : ''}`} aria-current={t.active ? 'page' : undefined}>
        {t.label}
      </a>
    ))}
  </nav>

  <section class="container filter-strip">
    <div class="filter-grid filter-grid--3">
      <Select
        name="era"
        label="Era"
        options={[
          { value: 'all', label: 'All eras' },
          ...eras.map((e) => ({ value: e.id, label: e.short_name || e.name })),
        ]}
      />
      <Select
        name="sort"
        label="Sort"
        value="chron"
        options={[
          { value: 'chron', label: 'Chronological' },
          { value: 'rchron', label: 'Reverse chronological' },
          { value: 'alpha', label: 'A–Z' },
        ]}
      />
      <SearchField placeholder="Title, label, era…" />
    </div>
  </section>

  <IssueSection kicker="Cover plates" title="Records in sequence" meta={`${all.length} studio records`}>
    <div class="mono-sm muted" data-match-count style="margin-bottom:1.2rem; letter-spacing: .2em;">{all.length} records</div>
    <div class="records-grid" data-records>
      {all.map((a) => {
        const era = a.era_id ? erasById[a.era_id] : null;
        const year = a.release_date?.slice(0, 4) || '';
        return (
          <div class="record-wrap"
               data-era={a.era_id || ''}
               data-year={year}
               data-title={(a.title || '').toLowerCase()}
               data-search={`${a.title || ''} ${a.label || ''} ${era?.name || ''}`.toLowerCase()}>
            <AlbumCard album={a} size="lg" />
            {era && (
              <div class="record-wrap__era kicker">
                <span class="record-wrap__era-dot" style={`background: oklch(0.6 0.15 ${typeof era.hue === 'number' ? era.hue : 320});`}></span>
                {era.short_name || era.name}
              </div>
            )}
          </div>
        );
      })}
    </div>
  </IssueSection>

  {longestGap.days > 0 && (
    <section class="container disc-trivia">
      <div class="disc-trivia__inner">
        <div class="kicker disc-trivia__k">Did you know</div>
        <p class="disc-trivia__body">
          The longest gap between two studio records was <em>{longestGapYears} years</em> — between
          <a href="/discography" class="disc-trivia__link">{longestGap.from}</a> and
          <a href="/discography" class="disc-trivia__link">{longestGap.to}</a>.
        </p>
      </div>
    </section>
  )}

</Layout>

<style is:global>
  .records-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: clamp(28px, 3.2vw, 48px) clamp(20px, 2.4vw, 32px);
  }
  .record-wrap { display: flex; flex-direction: column; }
  .record-wrap__era {
    margin-top: .5rem;
    color: var(--accent-3);
    display: inline-flex; align-items: center; gap: 8px;
    letter-spacing: 0.22em;
  }
  :root[data-theme='papers'] .record-wrap__era { color: var(--accent); }
  .record-wrap__era-dot {
    width: 7px; height: 7px; border-radius: 50%;
    box-shadow: 0 0 6px currentColor;
  }

  /* Did-you-know trivia card */
  .disc-trivia { padding-bottom: clamp(48px, 6vw, 96px); }
  .disc-trivia__inner {
    border-top: 1px solid var(--rule-strong);
    padding: clamp(28px, 4vw, 56px) 0;
    max-width: 70ch;
    margin: 0 auto;
    text-align: center;
  }
  .disc-trivia__k { color: var(--accent-3); margin-bottom: 1rem; letter-spacing: 0.3em; }
  :root[data-theme='papers'] .disc-trivia__k { color: var(--accent); }
  .disc-trivia__body {
    font-family: var(--f-display); font-style: italic;
    font-size: clamp(22px, 2.6vw, 34px);
    line-height: 1.3; margin: 0; color: var(--ink-2);
    text-wrap: balance;
  }
  .disc-trivia__body em { color: var(--accent-3); font-style: italic; }
  :root[data-theme='papers'] .disc-trivia__body em { color: var(--accent); }
  .disc-trivia__link { color: var(--ink); border-bottom: 1px solid var(--rule); padding-bottom: 1px; }
  .disc-trivia__link:hover { color: var(--accent-3); border-color: var(--accent); }
  :root[data-theme='papers'] .disc-trivia__link:hover { color: var(--accent); }
</style>

<script>
  function wireDisc() {
    const records = Array.from(document.querySelectorAll<HTMLElement>('[data-records] .record-wrap'));
    if (!records.length) return;
    const recordsParent = records[0].parentElement;
    const counter = document.querySelector<HTMLElement>('[data-match-count]');
    const state = { era: 'all', sort: 'chron', search: '' };

    const matches = (el: HTMLElement) => {
      const era = el.getAttribute('data-era') || '';
      const s = el.getAttribute('data-search') || '';
      if (state.era !== 'all' && era !== state.era) return false;
      if (state.search && !s.includes(state.search)) return false;
      return true;
    };

    const cmp = (a: HTMLElement, b: HTMLElement) => {
      if (state.sort === 'alpha') {
        return (a.getAttribute('data-title') || '').localeCompare(b.getAttribute('data-title') || '');
      }
      const ay = a.getAttribute('data-year') || '';
      const by = b.getAttribute('data-year') || '';
      return state.sort === 'rchron' ? by.localeCompare(ay) : ay.localeCompare(by);
    };

    const apply = () => {
      if (!recordsParent) return;
      const sorted = [...records].sort(cmp);
      sorted.forEach((r) => recordsParent.appendChild(r));
      sorted.forEach((r) => { r.style.display = matches(r) ? '' : 'none'; });
      if (counter) {
        const matched = records.filter(matches).length;
        counter.textContent = `${matched} record${matched === 1 ? '' : 's'}`;
      }
    };

    document.querySelectorAll<HTMLSelectElement>('[data-filter-select]').forEach((sel) => {
      const key = sel.getAttribute('data-filter-select') || '';
      sel.addEventListener('change', () => { (state as any)[key] = sel.value; apply(); });
    });
    const search = document.querySelector<HTMLInputElement>('[data-filter-search]');
    if (search) search.addEventListener('input', () => { state.search = search.value.trim().toLowerCase(); apply(); });

    apply();
  }
  wireDisc();
  document.addEventListener('astro:page-load', wireDisc);
</script>
