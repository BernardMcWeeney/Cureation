---
import MainLayout from '../../layouts/MainLayout.astro';
import AlbumCard from '../../components/AlbumCard.astro';
import { ViewTransitions } from 'astro:transitions';

// Sidebar configuration
const sidebarItems = [
  { title: 'Studio Albums', path: '/discography' },
  { title: 'Live Albums', path: '/discography/live' },
  { title: 'Compilations', path: '/discography/compilations' },
  { title: 'Singles', path: '/discography/singles' },
  { title: 'B-sides', path: '/discography/b-sides' }
];

// Fetch album data from the CMS
const response = await fetch('https://dash.cureation.net/items/discography');
const albumData = await response.json();
const albums = albumData.data.map(album => ({
  id: album.id.toString(),
  title: album.title,
  year: album.release_date
    ? new Date(album.release_date).getFullYear().toString()
    : '',
  coverImage: album.cover_art
    ? `https://dash.cureation.net/assets/${album.cover_art}`
    : '/images/placeholder-album.jpg',
  slug: album.slug || (album.title ? album.title
    .toLowerCase()
    .replace(/[^\w\s]/gi, '')
    .replace(/\s+/g, '-') : 'unknown-album'),
  featured: album.featured || false
}));

const featuredAlbums = albums.filter(album => album.featured) || [];
const regularAlbums = albums.filter(album => !album.featured) || [];
---

<MainLayout
  title="Discography"
  description="Explore the complete discography of The Cure, from their debut album to their most recent releases."
  showSidebar={true}
  sidebarActiveItem="Studio Albums"
  sidebarItems={sidebarItems}
  pageClass="bg-black"
>
  <ViewTransitions />
  
  <section class="mb-12">
    <div class="mb-12">
      <h1 class="font-display text-5xl md:text-6xl text-white mb-4" transition:animate="slide">
        The Cure Discography
      </h1>
      <p class="text-white/80 max-w-3xl" transition:animate="fade">
        Explore the complete studio album collection of The Cure, spanning over four decades of musical innovation
        and artistic evolution. Click on any album to discover more details, tracklists, and stories behind the music.
      </p>
    </div>

    {featuredAlbums.length > 0 && (
      <div class="mb-12">
        <h2 class="font-display text-3xl text-primary mb-6" transition:animate="slide">Essential Albums</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {featuredAlbums.map(album => (
            <AlbumCard
              title={album.title}
              coverImage={album.coverImage}
              year={album.year}
              slug={album.slug}
              featured={true}
              id={album.id}
            />
          ))}
        </div>
      </div>
    )}

    <div>
      <h2 class="font-display text-4xl text-primary mb-6" transition:animate="slide">Studio Albums</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-6">
        {regularAlbums.map((album, index) => (
          <AlbumCard
            title={album.title}
            coverImage={album.coverImage}
            year={album.year}
            slug={album.slug}
            id={album.id}
            style={`--index: ${index + 1}`}
          />
        ))}
      </div>
    </div>
  </section>
</MainLayout>

<style>
  /* Album grid animations */
  .grid {
    --stagger-delay: 75ms;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  :global(.grid > a) {
    animation: fadeIn 0.5s ease forwards;
    opacity: 0;
    animation-delay: calc(var(--stagger-delay) * var(--index, 1));
  }
</style>