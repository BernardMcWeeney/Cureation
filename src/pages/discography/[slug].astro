---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import Crumbs from '../../components/ui/Crumbs.astro';
import Tag from '../../components/ui/Tag.astro';
import Button from '../../components/ui/Button.astro';
import Bookmark from '../../components/ui/Bookmark.astro';
import {
  getAlbumBySlug,
  listAlbumTrivia,
  listAlbumCharts,
  listEras,
  fetchRaw,
} from '../../lib/directus';
import { asset } from '../../lib/assets';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/discography');

const album = await getAlbumBySlug(slug);
if (!album) return new Response('Not found', { status: 404 });

const [trivia, charts, eras, variants] = await Promise.all([
  listAlbumTrivia(album.id),
  listAlbumCharts(album.id),
  listEras(),
  fetchRaw('cover_variants', {
    'filter[album][_eq]': album.id,
    fields: 'id,format,territory,catalog_number,release_year,label,image,notes,sort',
    sort: 'sort,release_year',
    limit: -1,
  }).catch(() => []) as Promise<any[]>,
]);

const songs = (album.songs || []).slice().sort((a, b) => (a.track_number || 0) - (b.track_number || 0));
const era = album.era || eras.find((e) => e.id === album.era_id) || null;

const totalSec = songs.reduce((n, s) => {
  if (!s.duration) return n;
  const parts = s.duration.split(':').map(Number);
  if (parts.length === 2) return n + (parts[0] || 0) * 60 + (parts[1] || 0);
  if (parts.length === 3) return n + (parts[0] || 0) * 3600 + (parts[1] || 0) * 60 + (parts[2] || 0);
  return n;
}, 0);
const h = Math.floor(totalSec / 3600);
const m = Math.floor((totalSec % 3600) / 60);
const s = totalSec % 60;
const runtime = h ? `${h}h ${m}m` : totalSec ? `${m}:${String(s).padStart(2, '0')}` : '—';

const year = album.release_date?.slice(0, 4) || '—';

const totalLivePlays = songs.reduce((n, s) => n + (s.times_played_live || 0), 0);
const maxPlays = Math.max(1, ...songs.map((s) => s.times_played_live || 0));

const albumOrdinalMap: Record<string, string> = {
  'three-imaginary-boys': '1st', 'seventeen-seconds': '2nd', 'faith': '3rd',
  'pornography': '4th', 'the-top': '5th', 'the-head-on-the-door': '6th',
  'kiss-me-kiss-me-kiss-me': '7th', 'disintegration': '8th', 'wish': '9th',
  'wild-mood-swings': '10th', 'bloodflowers': '11th', 'the-cure': '12th',
  '4-13-dream': '13th', 'songs-of-a-lost-world': '14th',
};
const ordinal = album.type === 'studio' && albumOrdinalMap[album.slug!] ? albumOrdinalMap[album.slug!] : null;

const externalLinks = [
  { label: 'Spotify', href: album.spotify_url },
  { label: 'Apple Music', href: album.apple_music_url },
  { label: 'Bandcamp', href: album.bandcamp_url },
  { label: 'Amazon', href: album.amazon_url },
  { label: 'Official Store', href: album.official_store_url },
].filter((l) => l.href);

const firstReceptionSentence = album.critical_reception
  ? album.critical_reception.split(/(?<=[\.\!\?])\s/)[0]?.trim().replace(/^["""]|["""]$/g, '')
  : null;

const singles = (album.singles || []).slice().sort((a, b) =>
  (a.release_date || '').localeCompare(b.release_date || '')
);

const featuredChartLine = (() => {
  if (charts && charts.length > 0) {
    const best = charts.reduce((a, b) => ((a.peak ?? 999) < (b.peak ?? 999) ? a : b));
    return `#${best.peak} ${best.territory}`;
  }
  return null;
})();

const facts: Array<[string, string]> = [
  ['Released', album.release_date || '—'],
  ['Label', album.label || '—'],
  ['Producer', album.producer?.split(/[\/,]/)[0]?.trim() || '—'],
  ['Catalog', album.catalog_number || '—'],
  ['Runtime', runtime],
  ['Tracks', String(album.track_count || songs.length || '—')],
  ['Era', era?.name || '—'],
  ['Peak', featuredChartLine || '—'],
];

function shortTitle(t: string) { return t.length > 12 ? t.slice(0, 11) + '…' : t; }
---
<Layout
  title={`${album.title} · Cureation`}
  description={album.description || undefined}
  ogImage={asset(album.cover_art, 'og')}
>

  <div class="container" style="padding-top: clamp(24px, 3vw, 40px); display:flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;">
    <Crumbs items={[
      { label: 'Home',        href: '/' },
      { label: 'Discography', href: '/discography' },
      ...(era ? [{ label: era.name, href: `/band/history#${era.slug}` }] : []),
      { label: album.title },
    ]} />
    <Bookmark kind="album" id={album.id} label={album.title} href={`/discography/${album.slug}`} />
  </div>

  <!-- HEADER -->
  <section class="container album-head">
    <div class="album-head__art">
      <figure class="cover-plate" style={`view-transition-name: album-${album.slug};`}>
        <div class="cover-plate__corner cover-plate__corner--tl">
          <span class="mono-sm muted">{album.type?.toUpperCase()} · {year}</span>
        </div>
        <div class="cover-plate__corner cover-plate__corner--tr">
          <span class="mono-sm muted">FIX · {album.catalog_number || '—'}</span>
        </div>
        {album.cover_art ? (
          <img src={asset(album.cover_art, 'card')} alt={`${album.title} cover`} />
        ) : (
          <div class="cover-plate__fallback" aria-hidden="true"></div>
        )}
        <div class="cover-plate__corner cover-plate__corner--bl">
          <span class="mono-sm muted">{album.label ? album.label.split(/[\/]/)[0].trim().toUpperCase() : '—'}</span>
        </div>
      </figure>
    </div>

    <div class="album-head__body">
      <div class="cluster" style="gap: .4rem;">
        {album.type && ordinal && <Tag>STUDIO · {ordinal.toUpperCase()}</Tag>}
        {album.type && !ordinal && <Tag>{album.type.toUpperCase()}</Tag>}
        {era?.short_name && <Tag>{era.short_name.toUpperCase()}</Tag>}
        {featuredChartLine && <Tag variant="accent">{featuredChartLine.toUpperCase()}</Tag>}
      </div>

      <h1 class="album-head__title serif" style={`view-transition-name: album-title-${album.slug};`}>
        {album.title}
      </h1>

      <div class="mono-sm" style="color: var(--ink-2); margin-top: 10px;">
        {year} · {runtime} · {songs.length || album.track_count || '—'} TRACKS
        {featuredChartLine && <> · {featuredChartLine.toUpperCase()}</>}
      </div>

      {album.description && (
        <p class="album-head__lede">{album.description}</p>
      )}

      {firstReceptionSentence && (
        <div class="voices">
          <div class="mono-sm muted" style="margin-bottom: 8px;">
            CRITICAL RECEPTION · ARCHIVE EXCERPT
          </div>
          <div class="voices__quote">"{firstReceptionSentence}"</div>
          <div class="mono-sm muted" style="margin-top: 8px;">— Press, {year}</div>
        </div>
      )}

      {album.background_text && (
        <div class="archivist">
          <span class="mono-sm muted" style="margin-right: .4em;">Archivist's note:</span>
          {album.background_text.split(/\n{2,}/)[0]}
        </div>
      )}

      <!-- QUICK FACTS -->
      <div class="facts">
        {facts.map(([k, v]) => (
          <div class="facts__item">
            <div class="facts__k">{k}</div>
            <div class="facts__v">{v}</div>
          </div>
        ))}
      </div>

      <div class="cluster" style="gap: .5rem; margin-top: 22px;">
        {totalLivePlays > 0 && (
          <Button href={`/setlists?album=${album.slug}`} variant="default">
            View {totalLivePlays.toLocaleString()} performances →
          </Button>
        )}
        {externalLinks.slice(0, 2).map((l) => (
          <Button href={l.href!} variant="ghost" target="_blank" rel="noopener">{l.label} →</Button>
        ))}
      </div>
    </div>
  </section>

  <!-- TABS -->
  <div class="container album-tabs-wrap">
    <div class="album-tabs" data-tabs role="tablist">
      <button class="album-tab is-active" role="tab" data-target="tracks">
        Tracklist <span class="album-tab__count">{songs.length}</span>
      </button>
      {(album.credits || album.producer) && (
        <button class="album-tab" role="tab" data-target="personnel">
          Personnel <span class="album-tab__count">·</span>
        </button>
      )}
      {trivia.length > 0 && (
        <button class="album-tab" role="tab" data-target="trivia">
          Trivia & sessions <span class="album-tab__count">{trivia.length}</span>
        </button>
      )}
      {(charts.length > 0 || singles.length > 0) && (
        <button class="album-tab" role="tab" data-target="charts">
          Charts & singles <span class="album-tab__count">{charts.length + singles.length}</span>
        </button>
      )}
      {totalLivePlays > 0 && (
        <button class="album-tab" role="tab" data-target="live">
          Live performances <span class="album-tab__count">{totalLivePlays.toLocaleString()}</span>
        </button>
      )}
      {variants.length > 0 && (
        <button class="album-tab" role="tab" data-target="variants">
          Pressings <span class="album-tab__count">{variants.length}</span>
        </button>
      )}
    </div>
  </div>

  <!-- TRACKS -->
  <section class="container album-section" data-panel="tracks">
    <div class="tracks-grid">
      <div>
        <table class="data">
          <thead>
            <tr>
              <th style="width: 36px;">#</th>
              <th>Title</th>
              <th>Notes</th>
              <th style="text-align: right; width: 90px;">Length</th>
              <th style="text-align: right; width: 90px;">Live</th>
            </tr>
          </thead>
          <tbody>
            {songs.map((song) => {
              const plays = song.times_played_live || 0;
              return (
                <tr
                  data-clickable
                  data-track-row
                  data-track-id={song.id}
                  data-track-n={song.track_number}
                  data-track-title={song.title}
                  data-track-slug={song.slug || ''}
                  data-track-dur={song.duration || ''}
                  data-track-plays={plays}
                  data-track-meaning={(song.song_meaning || '').slice(0, 260)}
                  onclick={song.slug ? `window.location='/songs/${song.slug}'` : ''}
                >
                  <td class="idx">{String(song.track_number ?? 0).padStart(2, '0')}</td>
                  <td><span class="serif" style="font-size: 18px;">{song.title}</span></td>
                  <td><span class="mono-sm muted">
                    {song.is_single ? 'SINGLE' : song.writer && song.writer.toLowerCase() !== 'robert smith' ? `CO-WRITTEN` : ''}
                  </span></td>
                  <td class="num">{song.duration || '—'}</td>
                  <td class="num" style="color: var(--accent-3);">{plays ? plays.toLocaleString() : '—'}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <aside class="stack" style="--gap: 18px;">
        <div class="panel--bare" data-focus>
          <div class="panel-head">
            <span>Track in focus</span>
            <span data-focus-label>HOVER TO PREVIEW</span>
          </div>
          <div style="padding: 18px;" data-focus-body>
            <div class="muted" style="font-size: 13px; font-family: var(--f-serif);">
              Hover any track for cross-references, a preview waveform, and the song's documented live-performance count.
            </div>
          </div>
        </div>

        <div class="panel--bare">
          <div class="panel-head">
            <span>Variants</span>
            <span>{(album.disc_count || 1) + (album.type === 'deluxe' ? 1 : 0)}</span>
          </div>
          <div>
            {[
              ['Original', `${songs.length || album.track_count || '—'} tracks`, runtime],
              album.disc_count && album.disc_count > 1 ? ['Multi-disc', `${album.disc_count} discs`, runtime] : null,
              album.type === 'deluxe' ? ['Deluxe edition', 'Expanded', '—'] : null,
            ].filter(Boolean).map((v, i, arr) => (
              <div style={`display: grid; grid-template-columns: 1fr auto auto; gap: 14px; padding: 10px 18px; border-bottom: ${i < arr.length - 1 ? '1px solid var(--rule-2)' : 'none'}; font-size: 13px;`}>
                <div>{(v as string[])[0]}</div>
                <div class="mono-sm muted">{(v as string[])[1]}</div>
                <div class="mono-sm">{(v as string[])[2]}</div>
              </div>
            ))}
          </div>
        </div>

        {externalLinks.length > 0 && (
          <div class="panel--bare">
            <div class="panel-head">
              <span>Listen</span>
              <span>{externalLinks.length}</span>
            </div>
            <div style="padding: 10px 0;">
              {externalLinks.map((l, i) => (
                <a
                  href={l.href!} target="_blank" rel="noopener"
                  style={`display: flex; justify-content: space-between; padding: 10px 18px; border-bottom: ${i < externalLinks.length - 1 ? '1px solid var(--rule-2)' : 'none'}; border-left: none; border-right: none; border-top: none; color: var(--ink); font-family: var(--f-serif); font-size: 15px;`}
                >
                  <span>{l.label}</span>
                  <span class="mono-sm muted">OPEN →</span>
                </a>
              ))}
            </div>
          </div>
        )}
      </aside>
    </div>
  </section>

  <!-- PERSONNEL -->
  {(album.credits || album.producer) && (
    <section class="container album-section" data-panel="personnel" hidden>
      <div class="personnel-grid">
        <div>
          <h3 class="serif" style="font-size: clamp(26px, 3vw, 36px); margin: 0 0 20px;">Credits</h3>
          {album.credits ? (
            <table class="data">
              <tbody>
                {album.credits.split(/\n+/).filter((l) => l.trim()).slice(0, 24).map((line) => {
                  const m = line.match(/^([^:]+?):\s*(.+)$/);
                  if (m) return (
                    <tr>
                      <td style="width: 220px;"><span class="serif" style="font-size: 16px;">{m[1].trim()}</span></td>
                      <td><span class="mono-sm muted">{m[2].trim()}</span></td>
                    </tr>
                  );
                  return (
                    <tr>
                      <td colspan="2"><span style="font-family: var(--f-serif); font-size: 15px; color: var(--ink-2);">{line}</span></td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          ) : (
            <p class="muted">Personnel not yet catalogued.</p>
          )}
        </div>
        <div>
          <h3 class="serif" style="font-size: clamp(26px, 3vw, 36px); margin: 0 0 20px;">Session intensity</h3>
          <p class="mono-sm muted" style="margin-bottom: 12px;">
            Heuristic · 16-week schematic based on release date.
          </p>
          <div class="session-grid">
            {Array.from({ length: 112 }).map((_, i) => {
              const active = [3,4,5,11,12,13,14,15,18,19,20,21,25,26,32,33,34,35,40,41,42,48,55,56,57,63,70,71,72,73,80,81,82,88,95,102,103,104].includes(i);
              const intense = [13,14,20,21,33,34,41,56,72,81,103].includes(i);
              return <div class={`session-cell ${intense ? 'is-intense' : active ? 'is-active' : ''}`}></div>;
            })}
          </div>
          <div style="display: flex; justify-content: space-between; margin-top: 10px;">
            <div class="mono-sm muted">WEEK 1</div>
            <div class="mono-sm muted">WEEK 16</div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- TRIVIA -->
  {trivia.length > 0 && (
    <section class="container album-section" data-panel="trivia" hidden>
      <div class="trivia-list">
        {trivia.map((t: any, i: number) => (
          <div class="trivia-row">
            <div class="mono" style="color: var(--accent-3);">№ {String(i + 1).padStart(2, '0')}</div>
            <div>
              <p class="serif" style="font-size: clamp(19px, 2vw, 24px); line-height: 1.45; margin: 0; color: var(--ink);">
                {t.fact}
              </p>
              {(t.category || t.is_verified) && (
                <div class="cluster mono-sm muted" style="margin-top: 8px; gap: 12px;">
                  {t.category && <span>{t.category.toUpperCase()}</span>}
                  {t.is_verified && <span style="color: var(--accent-3);">VERIFIED</span>}
                  {t.source_detail && <a href={t.source_detail} target="_blank" rel="noopener" style="border: none; color: var(--muted);">SOURCE →</a>}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- CHARTS & SINGLES -->
  {(charts.length > 0 || singles.length > 0) && (
    <section class="container album-section" data-panel="charts" hidden>
      <div class="charts-grid">
        {charts.length > 0 && (
          <div>
            <h3 class="serif" style="font-size: clamp(22px, 2.4vw, 30px); margin: 0 0 16px;">Chart peaks</h3>
            <table class="data">
              <thead>
                <tr><th>Territory</th><th style="text-align:right;">Peak</th><th style="text-align:right;">Weeks</th><th style="text-align:right;">Year</th></tr>
              </thead>
              <tbody>
                {charts.map((c: any) => (
                  <tr>
                    <td>{c.territory}</td>
                    <td class="num">{c.peak ? '#' + c.peak : '—'}</td>
                    <td class="num">{c.weeks ?? '—'}</td>
                    <td class="num">{c.year ?? '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        {singles.length > 0 && (
          <div>
            <h3 class="serif" style="font-size: clamp(22px, 2.4vw, 30px); margin: 0 0 16px;">Singles</h3>
            <table class="data">
              <thead>
                <tr><th>Title</th><th>Released</th><th style="text-align:right;">Peak</th></tr>
              </thead>
              <tbody>
                {singles.map((s) => {
                  const peaks = Array.isArray(s.chart_position)
                    ? s.chart_position.map((c: any) => Number(c.chart_position)).filter((n) => !isNaN(n))
                    : [];
                  const peak = peaks.length ? Math.min(...peaks) : null;
                  return (
                    <tr>
                      <td><span class="serif" style="font-size: 16px;">{s.title}</span></td>
                      <td class="mono-sm">{s.release_date?.slice(0, 7).toUpperCase() || '—'}</td>
                      <td class="num" style="color: var(--accent-3);">{peak !== null ? `#${peak}` : '—'}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- LIVE -->
  {totalLivePlays > 0 && (
    <section class="container album-section" data-panel="live" hidden>
      <div style="display: flex; align-items: baseline; gap: 16px; margin-bottom: 24px;">
        <div class="mono muted">Album tracks ranked by documented live performances</div>
        <div style="flex: 1; border-top: 1px solid var(--rule);"></div>
        <a href="/setlists" class="mono-sm" style="border: none; color: var(--accent-3);">OPEN SETLISTS →</a>
      </div>
      <div class="live-bars">
        {songs.map((song) => {
          const plays = song.times_played_live || 0;
          const pct = (plays / maxPlays) * 100;
          return (
            <a class="live-bar" href={song.slug ? `/songs/${song.slug}` : '#'}>
              <div class="live-bar__fill" style={`height: ${pct}%; background: ${plays > maxPlays * 0.6 ? 'var(--accent)' : 'var(--ink-2)'};`}></div>
              <div class="mono-sm live-bar__label">{shortTitle(song.title)}</div>
              <div class="mono-sm muted live-bar__count">{plays ? plays.toLocaleString() : '—'}</div>
            </a>
          );
        })}
      </div>
    </section>
  )}

  {variants.length > 0 && (
    <section class="container album-section" data-panel="variants" hidden>
      <div style="display: flex; align-items: baseline; gap: 16px; margin-bottom: 24px;">
        <div class="mono muted">Regional pressings & sleeve variants on file</div>
        <div style="flex: 1; border-top: 1px solid var(--rule);"></div>
        <div class="mono-sm muted">{variants.length} VARIANT{variants.length === 1 ? '' : 'S'}</div>
      </div>
      <div class="variants-grid">
        {variants.map((v: any) => (
          <figure class="variant">
            <div class="variant__img">
              {v.image
                ? <img src={asset(v.image, 'card')} alt={`${album.title} · ${v.territory || ''}`} loading="lazy" />
                : <div class="placeholder" style="aspect-ratio: 1/1;">No sleeve</div>}
              {v.format && <span class="variant__format mono-sm">{String(v.format).toUpperCase()}</span>}
            </div>
            <figcaption>
              <div class="serif variant__title">{v.territory || '—'}{v.release_year ? ` · ${v.release_year}` : ''}</div>
              {v.catalog_number && <div class="mono-sm muted">{v.catalog_number}{v.label ? ` · ${v.label}` : ''}</div>}
              {v.notes && <div class="variant__notes">{v.notes}</div>}
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

</Layout>

<style>
  /* Header grid */
  .album-head {
    display: grid;
    grid-template-columns: minmax(0, 440px) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 56px);
    padding: clamp(16px, 3vw, 32px) var(--gutter) clamp(32px, 4vw, 56px);
    border-bottom: 1px solid var(--rule);
    max-width: var(--max-w);
    margin: 0 auto;
  }
  @media (max-width: 900px) { .album-head { grid-template-columns: 1fr; } }

  /* Cover plate (magazine corners) */
  .cover-plate {
    aspect-ratio: 1 / 1;
    background: var(--bg-3);
    border: 1px solid var(--rule);
    position: relative;
    margin: 0;
    overflow: hidden;
  }
  .cover-plate img { width: 100%; height: 100%; object-fit: cover; filter: saturate(0.94) contrast(1.04); }
  .cover-plate__fallback { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
  .cover-plate__fallback::after { content: ''; width: 60px; height: 60px; border-radius: 50%; background: var(--accent); }
  .cover-plate__corner { position: absolute; padding: 14px 16px; pointer-events: none; }
  .cover-plate__corner--tl { top: 0; left: 0; }
  .cover-plate__corner--tr { top: 0; right: 0; }
  .cover-plate__corner--bl { bottom: 0; left: 0; }
  .cover-plate__corner > * {
    background: color-mix(in oklab, var(--bg), transparent 10%);
    padding: 4px 8px;
    backdrop-filter: blur(6px);
  }

  /* Head body */
  .album-head__title {
    font-weight: 500;
    font-size: clamp(56px, 11vw, 128px);
    line-height: 0.92;
    margin: 16px 0 0;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .album-head__lede {
    font-size: 17px; line-height: 1.6; color: var(--ink-2);
    max-width: 640px; margin: 22px 0 0;
  }
  .archivist {
    margin-top: 18px; font-size: 13px; line-height: 1.6;
    color: var(--muted); max-width: 640px; font-style: italic;
    font-family: var(--f-serif);
  }
  .album-head__body .facts { margin-top: 28px; }
  .album-head__body .voices { margin-top: 24px; }

  /* Tabs */
  .album-tabs-wrap { margin-top: clamp(20px, 2.4vw, 32px); padding-bottom: 0; }
  .album-tabs {
    display: flex; gap: 4px; flex-wrap: wrap;
    border-bottom: 1px solid var(--rule);
  }
  .album-tab {
    font-family: var(--f-mono); font-size: 11px; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--muted);
    background: transparent; border: none;
    padding: 12px 18px 14px; cursor: pointer;
    border-bottom: 2px solid transparent;
    transition: color .18s, border-color .18s;
    display: inline-flex; align-items: baseline; gap: 6px;
  }
  .album-tab:hover { color: var(--ink-2); }
  .album-tab.is-active { color: var(--accent-ink); border-bottom-color: var(--accent); }
  :root[data-theme='papers'] .album-tab.is-active { color: var(--accent); }
  .album-tab__count { font-size: 10px; opacity: 0.5; letter-spacing: 0.1em; }

  .album-section {
    padding: clamp(32px, 5vw, 56px) var(--gutter);
    max-width: var(--max-w); margin: 0 auto;
  }

  /* Tracks grid */
  .tracks-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(260px, 1fr);
    gap: clamp(24px, 3vw, 48px);
  }
  @media (max-width: 900px) { .tracks-grid { grid-template-columns: 1fr; } }

  /* Personnel */
  .personnel-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(24px, 3vw, 48px);
  }
  @media (max-width: 780px) { .personnel-grid { grid-template-columns: 1fr; } }

  .session-grid {
    display: grid; grid-template-columns: repeat(7, 1fr); gap: 3px;
  }
  .session-cell {
    aspect-ratio: 1 / 1;
    background: var(--bg-2);
    border: 1px solid var(--rule-2);
  }
  .session-cell.is-active { background: var(--ink-2); }
  .session-cell.is-intense { background: var(--accent); border-color: var(--accent); }

  /* Trivia */
  .trivia-list { max-width: 880px; }
  .trivia-row {
    display: grid; grid-template-columns: 90px 1fr;
    gap: 24px; padding: 24px 0;
    border-bottom: 1px solid var(--rule);
  }
  .trivia-row:first-child { border-top: 1px solid var(--rule); }

  /* Charts */
  .charts-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: clamp(24px, 3vw, 48px);
  }

  /* Live bars */
  .live-bars {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(58px, 1fr));
    gap: 4px;
    align-items: end;
    height: 260px;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 8px;
  }
  .live-bar {
    display: flex; flex-direction: column; align-items: stretch;
    text-align: center; border: none; color: var(--ink-2);
    height: 100%; justify-content: flex-end;
  }
  .live-bar:hover .live-bar__fill { background: var(--accent-3) !important; }
  .live-bar__fill { transition: background .2s; min-height: 2px; }
  .live-bar__label { font-size: 9px; margin-top: 6px; letter-spacing: 0.06em; }
  .live-bar__count { font-size: 9px; margin-top: 2px; color: var(--accent-3); }

  /* Variants */
  .variants-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: clamp(16px, 2vw, 28px); }
  .variant { margin: 0; }
  .variant__img { position: relative; aspect-ratio: 1/1; overflow: hidden; border: 1px solid var(--rule); background: var(--bg-2); }
  .variant__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .variant__format { position: absolute; top: 8px; left: 8px; background: var(--bg); padding: 3px 6px; border: 1px solid var(--rule); font-size: 9.5px; letter-spacing: .18em; }
  .variant__title { font-size: 18px; font-style: italic; margin-top: .5rem; }
  .variant__notes { font-family: var(--f-serif); font-size: 14px; color: var(--ink-2); line-height: 1.5; margin-top: .3rem; }
</style>

<script>
  function wireTabs() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('[data-tabs] .album-tab');
    const panels = document.querySelectorAll<HTMLElement>('[data-panel]');
    if (!tabs.length) return;
    tabs.forEach((t) => {
      t.addEventListener('click', () => {
        const target = t.getAttribute('data-target');
        tabs.forEach((x) => x.classList.toggle('is-active', x === t));
        panels.forEach((p) => {
          p.hidden = p.getAttribute('data-panel') !== target;
        });
      });
    });
  }
  function wireTrackFocus() {
    const focus = document.querySelector<HTMLElement>('[data-focus]');
    const focusLabel = document.querySelector<HTMLElement>('[data-focus-label]');
    const focusBody = document.querySelector<HTMLElement>('[data-focus-body]');
    const rows = document.querySelectorAll<HTMLElement>('[data-track-row]');
    if (!focus || !rows.length) return;
    rows.forEach((r) => {
      r.addEventListener('mouseenter', () => {
        const n = r.getAttribute('data-track-n') || '—';
        const title = r.getAttribute('data-track-title') || '';
        const dur = r.getAttribute('data-track-dur') || '';
        const plays = parseInt(r.getAttribute('data-track-plays') || '0', 10);
        const meaning = r.getAttribute('data-track-meaning') || '';
        if (focusLabel) focusLabel.textContent = `#${String(n).padStart(2, '0')}`;
        if (focusBody) focusBody.innerHTML = `
          <div class="serif" style="font-size: 28px; line-height: 1.1;">${title}</div>
          <div class="mono-sm muted" style="margin-top: 6px;">Track ${n} · ${dur || '—'}</div>
          ${meaning ? `<p style="margin-top: 14px; font-size: 14px; color: var(--ink-2); line-height: 1.55;">${meaning}${meaning.length >= 260 ? '…' : ''}</p>` : ''}
          ${plays ? `<p style="margin-top: 14px; font-size: 13px; color: var(--accent-3); font-family: var(--f-mono); letter-spacing: .14em;">${plays.toLocaleString()} DOCUMENTED PLAYS</p>` : ''}
          <div style="margin-top: 14px; height: 48px; display: flex; align-items: end; gap: 2px;">
            ${Array.from({length:64}).map((_,i)=>`<div style="flex:1;height:${15+Math.abs(Math.sin((i+(+n)*7)*0.4))*80}%;background:${i<32?'var(--ink-2)':'var(--muted-2)'};"></div>`).join('')}
          </div>
        `;
      });
    });
  }
  wireTabs(); wireTrackFocus();
  document.addEventListener('astro:page-load', () => { wireTabs(); wireTrackFocus(); });
</script>
