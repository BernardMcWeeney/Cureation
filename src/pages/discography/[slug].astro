---
import { editable, copyText, copyAttr, copySource, copyTuple } from '../../lib/visual-editing';
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import Crumbs from '../../components/ui/Crumbs.astro';
import Tag from '../../components/ui/Tag.astro';
import Button from '../../components/ui/Button.astro';
import Bookmark from '../../components/ui/Bookmark.astro';
import {
  getAlbumBySlug,
  listAlbumTrivia,
  listAlbumCharts,
  listEras,
  fetchRaw,
  getReviewByAlbum,
} from '../../lib/directus';
import { asset } from '../../lib/assets';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/discography');

const album = await getAlbumBySlug(slug);
if (!album) return new Response('Not found', { status: 404 });

const [trivia, charts, eras, variants, review] = await Promise.all([
  listAlbumTrivia(album.id),
  listAlbumCharts(album.id),
  listEras(),
  fetchRaw('cover_variants', {
    'filter[album][_eq]': album.id,
    fields: 'id,format,territory,catalog_number,release_year,label,image,notes,sort',
    sort: 'sort,release_year',
    limit: -1,
  }).catch(() => []) as Promise<any[]>,
  getReviewByAlbum(album.id),
]);

const songs = (album.songs || []).slice().sort((a, b) => (a.track_number || 0) - (b.track_number || 0));
const era = album.era || eras.find((e) => e.id === album.era_id) || null;

const totalSec = songs.reduce((n, s) => {
  if (!s.duration) return n;
  const parts = s.duration.split(':').map(Number);
  if (parts.length === 2) return n + (parts[0] || 0) * 60 + (parts[1] || 0);
  if (parts.length === 3) return n + (parts[0] || 0) * 3600 + (parts[1] || 0) * 60 + (parts[2] || 0);
  return n;
}, 0);
const h = Math.floor(totalSec / 3600);
const m = Math.floor((totalSec % 3600) / 60);
const s = totalSec % 60;
const runtime = h ? `${h}h ${m}m` : totalSec ? `${m}:${String(s).padStart(2, '0')}` : '–';


const totalLivePlays = songs.reduce((n, s) => n + (s.times_played_live || 0), 0);
const maxPlays = Math.max(1, ...songs.map((s) => s.times_played_live || 0));

const albumOrdinalMap: Record<string, string> = {
  'three-imaginary-boys': '1st', 'seventeen-seconds': '2nd', 'faith': '3rd',
  'pornography': '4th', 'the-top': '5th', 'the-head-on-the-door': '6th',
  'kiss-me-kiss-me-kiss-me': '7th', 'disintegration': '8th', 'wish': '9th',
  'wild-mood-swings': '10th', 'bloodflowers': '11th', 'the-cure': '12th',
  '4-13-dream': '13th', 'songs-of-a-lost-world': '14th',
};
const ordinal = album.type === 'studio' && albumOrdinalMap[album.slug!] ? albumOrdinalMap[album.slug!] : null;

const externalLinks = [
  { ...copySource({"label":"pages_discography__slug__data-5c9c9fdb2fbc"}),  label: copyText("pages_discography__slug__data-5c9c9fdb2fbc", "Spotify"), href: album.spotify_url },
  { ...copySource({"label":"pages_discography__slug__data-02efd1da69e0"}),  label: copyText("pages_discography__slug__data-02efd1da69e0", "Apple Music"), href: album.apple_music_url },
  { ...copySource({"label":"pages_discography__slug__data-36df878e7dc0"}),  label: copyText("pages_discography__slug__data-36df878e7dc0", "Bandcamp"), href: album.bandcamp_url },
  { ...copySource({"label":"pages_discography__slug__data-10ca2a944b47"}),  label: copyText("pages_discography__slug__data-10ca2a944b47", "Amazon"), href: album.amazon_url },
  { ...copySource({"label":"pages_discography__slug__data-2fe2bce8fc03"}),  label: copyText("pages_discography__slug__data-2fe2bce8fc03", "Official Store"), href: album.official_store_url },
].filter((l) => l.href);


const singles = (album.singles || []).slice().sort((a, b) =>
  (a.release_date || '').localeCompare(b.release_date || '')
);


const facts: Array<[string, string]> = [
  copyTuple([copyText("pages_discography__slug__tuple-725d3f092c12", "Released"), album.release_date || '–'], {"0":"pages_discography__slug__tuple-725d3f092c12"}),
  copyTuple([copyText("pages_discography__slug__tuple-9a20f1a58fae", "Label"), album.label || '–'], {"0":"pages_discography__slug__tuple-9a20f1a58fae"}),
  copyTuple([copyText("pages_discography__slug__tuple-c5c2b06e06d0", "Runtime"), runtime], {"0":"pages_discography__slug__tuple-c5c2b06e06d0"}),
  copyTuple([copyText("pages_discography__slug__tuple-43ca86df41d9", "Tracks"), String(album.track_count || songs.length || '–')], {"0":"pages_discography__slug__tuple-43ca86df41d9"}),
];

---
<Layout editRecord={album}
  title={`${album.title} · Cureation`}
  description={album.description || undefined}
  ogImage={asset(album.cover_art, 'og')}
>

  <div class="container" style="padding-top: clamp(24px, 3vw, 40px);">
    <Crumbs items={[
      { ...copySource({"label":"pages_discography__slug__data-6838272f3ab8"}),  label: copyText("pages_discography__slug__data-6838272f3ab8", "Home"),        href: '/' },
      { ...copySource({"label":"pages_discography__slug__data-a41c9de8a0e8"}),  label: copyText("pages_discography__slug__data-a41c9de8a0e8", "Discography"), href: '/discography' },
      { label: album.title },
    ]} />
  </div>

  <!-- HEADER -->
  <section id="album-dossier" class="container album-head detail-anchor">
    <div class="album-head__art">
      <figure  class="cover-plate" style={`view-transition-name: album-${album.slug};`}>
        {album.cover_art ? (
          <img data-directus={editable(album, ["cover_art"])} src={asset(album.cover_art, 'card')} alt={`${album.title} cover`} />
        ) : (
          <div class="cover-plate__fallback" aria-hidden="true"></div>
        )}
      </figure>
    </div>

    <div  class="album-head__body">
      <div class="album-head__utility">
        <div data-directus={editable(album, ["type"]) ?? editable(era, ["short_name"])} class="cluster" style="gap: .4rem;">
          {album.type && ordinal && <Tag>STUDIO · {ordinal.toUpperCase()}</Tag>}
          {album.type && !ordinal && <Tag>{album.type.toUpperCase()}</Tag>}
        </div>
        <Bookmark kind="album" id={album.id} label={album.title} href={`/discography/${album.slug}`} />
      </div>

      <h1 data-directus={editable(album, ["title"])} class="album-head__title serif" style={`view-transition-name: album-title-${album.slug};`}>
        {album.title}
      </h1>


      {album.description && (
        <p data-directus={editable(album, ["description"])} class="album-head__lede">{album.description}</p>
      )}

      <!-- QUICK FACTS -->
      <div class="facts">
        {facts.filter(([, value]) => value !== '–').map((__copyRow8474) => { const [k, v] = __copyRow8474; return (
          <div class="facts__item">
            <div data-directus={editable(__copyRow8474, ["0"])} class="facts__k">{k}</div>
            <div data-directus={editable(__copyRow8474, ["1"])} class="facts__v">{v}</div>
          </div>
        ); })}
      </div>

      <div class="cluster" style="gap: .5rem; margin-top: 22px;">
        {totalLivePlays > 0 && (
          <Button href="#album-panel-live" variant="ghost">
            Explore live performances →
          </Button>
        )}
      </div>
    </div>
  </section>

  <div class="container album-file">
    <div class="archive-columns">
      <div class="album-file__main">
<section id="album-panel-tracks" class="album-tracklist detail-anchor" data-panel="tracks">
    <h2 class="record-section-title">Tracklist</h2>
      <div>
        <table class="data">
          <thead>
            <tr>
              <th style="width: 36px;">#</th>
              <th data-directus={copyAttr("pages_discography_slug_1d03c6a90888")} set:html={copyText("pages_discography_slug_1d03c6a90888", "Title")}></th>
              <th data-directus={copyAttr("pages_discography_slug_aa9fbd2f5255")} set:html={copyText("pages_discography_slug_aa9fbd2f5255", "Notes")}></th>
              <th data-directus={copyAttr("pages_discography_slug_2b03d744648e")} set:html={copyText("pages_discography_slug_2b03d744648e", "Length")} style="text-align: right; width: 90px;"></th>
            </tr>
          </thead>
          <tbody>
            {songs.map((song) => {
              return (
                <tr
                  data-clickable
                  data-track-row
                  data-row-href={song.slug ? `/songs/${song.slug}` : undefined}
                >
                  <td data-directus={editable(song, ["track_number"])} class="idx">{String(song.track_number ?? 0).padStart(2, '0')}</td>
                  <td><a data-directus={editable(song, ["title"])} href={song.slug ? `/songs/${encodeURIComponent(song.slug)}` : undefined} class="serif" style="font-size: 18px;">{song.title}</a></td>
                  <td><span data-directus={editable(song, ["is_single","writer"])} class="mono-sm muted">
                    {song.is_single ? 'SINGLE' : song.writer && song.writer.toLowerCase() !== 'robert smith' ? `CO-WRITTEN` : ''}
                  </span></td>
                  <td data-directus={editable(song, ["duration"])} class="num">{song.duration || '–'}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
</section>
        <div class="album-archive" aria-label="More from the archive">
        {(trivia.length > 0) && <details id="album-panel-trivia" class="album-disclosure detail-anchor">
<summary><h2>Archive notes</h2><span aria-hidden="true">+</span></summary>
<div class="album-disclosure__body">
            <div class="trivia-list">
        {trivia.map((t: any, i: number) => (
          <div class="trivia-row">
            <div class="mono" style="color: var(--accent-3);">№ {String(i + 1).padStart(2, '0')}</div>
            <div >
              <p data-directus={editable(t, ["fact"])} class="serif" style="font-size: clamp(19px, 2vw, 24px); line-height: 1.45; margin: 0; color: var(--ink);">
                {t.fact}
              </p>
              {(t.category || t.is_verified) && (
                <div  class="cluster mono-sm muted" style="margin-top: 8px; gap: 12px;">
                  {t.category && <span data-directus={editable(t, ["category"])}>{t.category.toUpperCase()}</span>}
                  {t.is_verified && <span data-directus={copyAttr("pages_discography_slug_a754146c1ea8")} set:html={copyText("pages_discography_slug_a754146c1ea8", "VERIFIED")} style="color: var(--accent-3);"></span>}
                  {t.source_detail && <a data-directus={copyAttr("pages_discography_slug_60633641ceb9")} set:html={copyText("pages_discography_slug_60633641ceb9", "SOURCE →")} href={t.source_detail} target="_blank" rel="noopener" style="border: none; color: var(--muted);"></a>}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div></details>}
        {(charts.length > 0 || singles.length > 0) && <details id="album-panel-charts" class="album-disclosure detail-anchor">
<summary><h2>Charts &amp; singles</h2><span aria-hidden="true">+</span></summary>
<div class="album-disclosure__body">
            <div class="charts-grid">
        {charts.length > 0 && (
          <div>
            <h3 data-directus={copyAttr("pages_discography_slug_5b882d520756")} set:html={copyText("pages_discography_slug_5b882d520756", "Chart peaks")} class="serif" style="font-size: clamp(22px, 2.4vw, 30px); margin: 0 0 16px;"></h3>
            <table class="data">
              <thead>
                <tr><th data-directus={copyAttr("pages_discography_slug_5da37c195a03")} set:html={copyText("pages_discography_slug_5da37c195a03", "Territory")}></th><th data-directus={copyAttr("pages_discography_slug_50ffde7d7ab8")} set:html={copyText("pages_discography_slug_50ffde7d7ab8", "Peak")} style="text-align:right;"></th><th data-directus={copyAttr("pages_discography_slug_3ae37cf9aef0")} set:html={copyText("pages_discography_slug_3ae37cf9aef0", "Weeks")} style="text-align:right;"></th><th data-directus={copyAttr("pages_discography_slug_c3c5a6e70c68")} set:html={copyText("pages_discography_slug_c3c5a6e70c68", "Year")} style="text-align:right;"></th></tr>
              </thead>
              <tbody>
                {charts.map((c: any) => (
                  <tr>
                    <td data-directus={editable(c, ["territory"])}>{c.territory}</td>
                    <td data-directus={editable(c, ["peak"])} class="num">{c.peak ? '#' + c.peak : '–'}</td>
                    <td data-directus={editable(c, ["weeks"])} class="num">{c.weeks ?? '–'}</td>
                    <td data-directus={editable(c, ["year"])} class="num">{c.year ?? '–'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        {singles.length > 0 && (
          <div>
            <h3 data-directus={copyAttr("pages_discography_slug_fff528604f56")} set:html={copyText("pages_discography_slug_fff528604f56", "Singles")} class="serif" style="font-size: clamp(22px, 2.4vw, 30px); margin: 0 0 16px;"></h3>
            <table class="data">
              <thead>
                <tr><th data-directus={copyAttr("pages_discography_slug_c8535a5b6f5c")} set:html={copyText("pages_discography_slug_c8535a5b6f5c", "Title")}></th><th data-directus={copyAttr("pages_discography_slug_226f1cde4cfd")} set:html={copyText("pages_discography_slug_226f1cde4cfd", "Released")}></th><th data-directus={copyAttr("pages_discography_slug_77c166a99aa7")} set:html={copyText("pages_discography_slug_77c166a99aa7", "Peak")} style="text-align:right;"></th></tr>
              </thead>
              <tbody>
                {singles.map((s) => {
                  const peaks = Array.isArray(s.chart_position)
                    ? s.chart_position.map((c: any) => Number(c.chart_position)).filter((n) => !isNaN(n))
                    : [];
                  const peak = peaks.length ? Math.min(...peaks) : null;
                  return (
                    <tr>
                      <td><span data-directus={editable(s, ["title"])} class="serif" style="font-size: var(--text-small);">{s.title}</span></td>
                      <td data-directus={editable(s, ["release_date"])} class="mono-sm">{s.release_date?.slice(0, 7).toUpperCase() || '–'}</td>
                      <td class="num" style="color: var(--accent-3);">{peak !== null ? `#${peak}` : '–'}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </div></details>}
        {(totalLivePlays > 0) && <details id="album-panel-live" class="album-disclosure detail-anchor">
<summary><h2>Live performances</h2><span aria-hidden="true">+</span></summary>
<div class="album-disclosure__body">
            <div style="display: flex; align-items: baseline; gap: 16px; margin-bottom: 24px;">
        <div class="mono muted">Album tracks ranked by documented live performances</div>
        <div style="flex: 1; border-top: 1px solid var(--rule);"></div>
        <a data-directus={copyAttr("pages_discography_slug_826c278f1a6a")} set:html={copyText("pages_discography_slug_826c278f1a6a", "OPEN SETLISTS →")} href="/setlists" class="mono-sm" style="border: none; color: var(--accent-3);"></a>
      </div>
      <div class="live-bars">
        {songs.slice().sort((a, b) => (b.times_played_live || 0) - (a.times_played_live || 0)).map((song) => {
          const plays = song.times_played_live || 0;
          const pct = (plays / maxPlays) * 100;
          return (
            <a class="live-bar" href={song.slug ? `/songs/${song.slug}` : '#'}>
              <div data-directus={editable(song, ["title"])} class="live-bar__label">{song.title}</div>
              <div class="live-bar__track" aria-hidden="true"><div class="live-bar__fill" style={`width: ${pct}%;`}></div></div>
              <div class="mono-sm muted live-bar__count">{plays ? plays.toLocaleString() : '–'}</div>
            </a>
          );
        })}
      </div>
    </div></details>}
        {(variants.length > 0) && <details id="album-panel-variants" class="album-disclosure detail-anchor">
<summary><h2>Editions &amp; artwork</h2><span aria-hidden="true">+</span></summary>
<div class="album-disclosure__body">
      <div style="display: flex; align-items: baseline; gap: 16px; margin-bottom: 24px;">
        <div class="mono muted">Album editions and cover artwork</div>
        <div style="flex: 1; border-top: 1px solid var(--rule);"></div>
        <div class="mono-sm muted">{variants.length} VARIANT{variants.length === 1 ? '' : 'S'}</div>
      </div>
            <div class="variants-grid">
        {variants.map((v: any) => (
          <figure class="variant">
            <div  class="variant__img">
              {v.image
                ? <img data-directus={editable(v, ["image"])} src={asset(v.image, 'card')} alt={`${album.title} · ${v.territory || ''}`} loading="lazy" />
                : <div class="placeholder" style="aspect-ratio: 1/1;">No sleeve</div>}
              {v.format && <span data-directus={editable(v, ["format"])} class="variant__format mono-sm">{String(v.format).toUpperCase()}</span>}
            </div>
            <figcaption >
              <div data-directus={editable(v, ["territory","release_year"])} class="serif variant__title">{v.territory || '–'}{v.release_year ? ` · ${v.release_year}` : ''}</div>
              {v.catalog_number && <div data-directus={editable(v, ["catalog_number","label"])} class="mono-sm muted">{v.catalog_number}{v.label ? ` · ${v.label}` : ''}</div>}
              {v.notes && <div data-directus={editable(v, ["notes"])} class="variant__notes">{v.notes}</div>}
            </figcaption>
          </figure>
        ))}
      </div>
    </div></details>}
        </div>
      </div>
      <aside class="album-sidebar stack" aria-label="About this record">
        <section class="album-sidebar__card">
          <h2>Album details</h2>
          <dl class="album-sidebar__facts">
            {album.producer && <div><dt>Producer</dt><dd>{album.producer}</dd></div>}
            {album.catalog_number && <div><dt>Catalogue</dt><dd>{album.catalog_number}</dd></div>}
            {era?.name && <div><dt>Era</dt><dd>{era.name}</dd></div>}
          </dl>
          {review && <a class="album-sidebar__review" href={`/reviews/${review.slug}`}>Read our review <span>→</span></a>}
        </section>
        {(album.background_text || album.critical_reception) && <details id="album-story" class="album-disclosure detail-anchor">
<summary><h2>About the album</h2><span aria-hidden="true">+</span></summary>
<div class="album-disclosure__body">
        <div class="record-story">
      {album.background_text && <div data-directus={editable(album, ['background_text'])}>{album.background_text.split(/\n{2,}/).map((paragraph) => <p>{paragraph}</p>)}</div>}
      {album.critical_reception && <div data-directus={editable(album, ['critical_reception'])}><h3>Reception</h3><p>{album.critical_reception}</p></div>}
    </div>
  </div></details>}
        {(album.credits || album.producer) && <details id="album-panel-personnel" class="album-disclosure detail-anchor">
<summary><h2>Credits</h2><span aria-hidden="true">+</span></summary>
<div class="album-disclosure__body">
            {album.producer && !/produc/i.test(album.credits || '') && <p class="record-producer">Produced by {album.producer}</p>}
      <div class="personnel-grid">
        <div >
          {album.credits ? (
            <table class="data">
              <tbody>
                {album.credits.split(/\n+/).filter((l) => l.trim()).slice(0, 24).map((line) => {
                  const m = line.match(/^([^:]+?):\s*(.+)$/);
                  if (m) return (
                    <tr>
                      <td style="width: 220px;"><span data-directus={editable(m[1], ["trim"])} class="serif" style="font-size: var(--text-small);">{m[1].trim()}</span></td>
                      <td><span data-directus={editable(m[2], ["trim"])} class="mono-sm muted">{m[2].trim()}</span></td>
                    </tr>
                  );
                  return (
                    <tr>
                      <td colspan="2"><span style="font-family: var(--f-serif); font-size: var(--text-small); color: var(--ink-2);">{line}</span></td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          ) : (
            <p data-directus={copyAttr("pages_discography_slug_aafc3e312afb")} set:html={copyText("pages_discography_slug_aafc3e312afb", "Credits are not available yet.")} class="muted"></p>
          )}
        </div>

      </div>
    </div></details>}
        {externalLinks.length > 0 && (
          <div class="panel--bare">
            <div class="panel-head">
              <span data-directus={copyAttr("pages_discography_slug_b90cba95652f")} set:html={copyText("pages_discography_slug_b90cba95652f", "Listen")}></span>
              <span>{externalLinks.length}</span>
            </div>
            <div style="padding: 10px 0;">
              {externalLinks.map((l, i) => (
                <a
                  href={l.href!} target="_blank" rel="noopener"
                  style={`display: flex; justify-content: space-between; padding: 10px 18px; border-bottom: ${i < externalLinks.length - 1 ? '1px solid var(--rule-2)' : 'none'}; border-left: none; border-right: none; border-top: none; color: var(--ink); font-family: var(--f-serif); font-size: var(--text-small);`}
                >
                  <span data-directus={editable(l, ["label"])}>{l.label}</span>
                  <span data-directus={copyAttr("pages_discography_slug_a3bc522c0626")} set:html={copyText("pages_discography_slug_a3bc522c0626", "OPEN →")} class="mono-sm muted"></span>
                </a>
              ))}
            </div>
          </div>
        )}
      </aside>
    </div>
  </div>

</Layout>

<style>
  .album-file { padding-block: var(--content-space); }
  .album-file__main { min-width: 0; }
  .album-archive { margin-top: 28px; }
  .album-disclosure { border-top: 1px solid var(--rule); }
  .album-disclosure:last-child { border-bottom: 1px solid var(--rule); }
  .album-disclosure > summary { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 0; cursor: pointer; list-style: none; color: var(--ink); }
  .album-disclosure > summary::-webkit-details-marker { display: none; }
  .album-disclosure > summary h2 { margin: 0; font: 500 24px/1.2 var(--f-display); }
  .album-disclosure > summary > span { color: var(--accent); font: 22px var(--f-ui); }
  .album-disclosure[open] > summary > span { transform: rotate(45deg); }
  .album-disclosure__body { padding-bottom: 24px; }
  .album-sidebar > * + * { margin-top: 20px; }
  .album-sidebar__card { padding: 20px; border: 1px solid var(--rule); background: var(--bg-2); }
  .album-sidebar__card h2 { margin: 0 0 16px; font: 500 26px var(--f-display); }
  .album-sidebar__facts { margin: 0; }
  .album-sidebar__facts > div { margin-bottom: 14px; }
  .album-sidebar__facts dt { color: var(--muted); font: var(--text-label) var(--f-ui); margin-bottom: 4px; }
