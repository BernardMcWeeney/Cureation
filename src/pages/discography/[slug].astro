<script>
  function revealAlbumSection() {
    const id = decodeURIComponent(window.location.hash.slice(1));
    if (!id.startsWith('album-')) return;
    const target = document.getElementById(id);
    if (target instanceof HTMLDetailsElement) { target.open = true; requestAnimationFrame(() => target.scrollIntoView({ block: 'start' })); }
  }
  document.addEventListener('astro:page-load', revealAlbumSection);
  window.addEventListener('hashchange', revealAlbumSection);
  revealAlbumSection();
</script>
