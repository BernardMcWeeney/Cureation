---
import MainLayout from "../../layouts/MainLayout.astro";
import TrackList from "../../components/TrackList.astro";
import { ViewTransitions } from 'astro:transitions';

// Sidebar configuration
const sidebarItems = [
  { title: "Studio Albums", path: "/discography" },
  { title: "Live Albums", path: "/discography/live" },
  { title: "Compilations", path: "/discography/compilations" },
  { title: "Singles", path: "/discography/singles" },
  { title: "B-sides", path: "/discography/b-sides" }
];

export async function getStaticPaths() {
  try {
    // Fetch album data from the CMS
    const albumsResponse = await fetch('https://dash.cureation.net/items/discography');
    const albumsData = await albumsResponse.json();
    
    // Log the raw data to see what we're working with
    console.log('Albums data length:', albumsData.data?.length);
    console.log('First few albums:', albumsData.data?.slice(0, 3).map(a => ({ id: a.id, title: a.title, slug: a.slug })));
    
    // Fetch songs data
    const songsResponse = await fetch('https://dash.cureation.net/items/songs');
    const songsData = await songsResponse.json();
    
    // Fetch singles data
    const singlesResponse = await fetch('https://dash.cureation.net/items/singles');
    const singlesData = await singlesResponse.json();

    // Process and map the albums data
    const paths = await Promise.all(albumsData.data.map(async (album) => {
      // Create slug from title if not provided - add null checks
      let slug;
      if (album.slug) {
        slug = album.slug;
      } else if (album.title) {
        slug = album.title
          .toLowerCase()
          .replace(/[^\w\s]/gi, '')
          .replace(/\s+/g, '-');
      } else {
        console.warn('Album without title or slug:', album);
        slug = `album-${album.id}`;
      }
      
      // Log each album's slug generation
      console.log(`Album "${album.title}" -> slug: "${slug}"`);
      
      // Format album data
      const formattedAlbum = {
        id: album.id.toString(),
        title: album.title || 'Unknown Album',
        slug: slug,
        year: album.release_date ? new Date(album.release_date).getFullYear().toString() : '',
        coverImage: album.cover_art ? `https://dash.cureation.net/assets/${album.cover_art}` : '/images/placeholder-album.jpg',
        releaseDate: album.release_date ? new Date(album.release_date).toLocaleDateString('en-US', {
          month: 'long', day: 'numeric', year: 'numeric'
        }) : 'Unknown',
        recordLabel: album.label || 'Fiction',
        producer: album.producer || 'Unknown',
        description: album.description || 'No description available.',
        background: album.background_text || 'No background information available.',
        reception: album.critical_reception || 'No critical reception information available.',
        featured: album.featured || false
      };
      
      // Get songs for this album - add null checks
      const albumSongs = songsData.data
        .filter(song => song.album === album.id && song.title) // Filter out songs without titles
        .map(song => ({
          number: song.track_number,
          title: song.title || 'Unknown Track',
          duration: song.duration || '0:00',
          listen_link: song.listen_link
        }));
      formattedAlbum.tracks = albumSongs;
      
      // Get singles for this album
      const albumSingles = singlesData.data.filter(single => single.album === album.id).map(single => {
        return {
          title: single.title || 'Unknown Single',
          releaseDate: single.release_date ? new Date(single.release_date).toLocaleDateString('en-US', {
            month: 'long', day: 'numeric', year: 'numeric'
          }) : 'Unknown',
          chartPositions: single.chart_position || []
        };
      });
      formattedAlbum.singles = albumSingles;
      
      return formattedAlbum;
    }));
    
    // Log all generated slugs
    console.log('All generated album slugs:', paths.map(p => p.slug));
    
    // Get related albums for each album
    const finalPaths = paths.map(album => {
      const relatedAlbums = paths
        .filter(otherAlbum => otherAlbum.slug !== album.slug)
        .slice(0, 3);
        
      return {
        params: { slug: album.slug },
        props: { album, relatedAlbums }
      };
    });
    
    console.log('Final static paths:', finalPaths.map(p => p.params.slug));
    
    return finalPaths;
  } catch (error) {
    console.error('Error in getStaticPaths:', error);
    return [];
  }
}

const { album, relatedAlbums } = Astro.props;
---

<MainLayout 
  title={album.title}
  description={`Learn about The Cure's album ${album.title}, released in ${album.year}.`}
  ogImage={album.coverImage}
  showSidebar={true}
  sidebarActiveItem="Studio Albums"
  sidebarItems={sidebarItems}
  pageClass={`theme-${album.slug}`}
>
<ViewTransitions />

<!-- Album artwork background layer -->
<div class="artwork-background">
  <div class="bg-overlay bg-black opacity-70"></div>
  <div class="album-artwork" style={`background-image: url(${album.coverImage})`}></div>
</div>
<!-- Enforce pure black here so your glass-card blur never shows grey -->
<div data-theme={album.slug} class="bg-transparent">
  <!-- Album Hero Section -->
  <section class="relative">
    <div class="flex flex-col lg:flex-row gap-8 mb-12">
      <!-- Album Cover -->
      <div class="lg:w-2/5">
        <div class="glass-card overflow-hidden rounded-xl border border-white/20">
          <img 
            src={album.coverImage} 
            alt={`${album.title} album cover`} 
            class="w-full aspect-square object-cover"
            transition:name={`album-${album.id}`}
          />
        </div>
      </div>
      
      <!-- Album Info -->
      <div class="lg:w-3/5">
        <div class="glass-card rounded-xl p-6 border border-white/20 h-full backdrop-blur-lg bg-black/10">
          <h1 class="font-brand text-5xl md:text-6xl text-white mb-2">{album.title}</h1>
          <p class="text-2xl text-primary mb-6">{album.year}</p>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
            <div>
              <h3 class="text-white/60 text-sm">Release Date</h3>
              <p class="text-white">{album.releaseDate}</p>
            </div>
            <div>
              <h3 class="text-white/60 text-sm">Record Label</h3>
              <p class="text-white">{album.recordLabel}</p>
            </div>
            <div>
              <h3 class="text-white/60 text-sm">Producer</h3>
              <p class="text-white">{album.producer}</p>
            </div>
          </div>
          
          <div class="mb-6">
            <h3 class="text-white/60 text-sm mb-2">Description</h3>
            <p class="text-white">{album.description}</p>
          </div>
          
          <div class="flex flex-wrap gap-3 mt-6">
            <a href="#background" class="px-4 py-2 rounded-lg backdrop-blur-md bg-primary/20 border border-primary/30 text-white hover:bg-primary/30 transition-colors duration-300">Background</a>
            <a href="#tracks" class="px-4 py-2 rounded-lg backdrop-blur-md bg-black/20 border border-white/20 text-white hover:bg-white/10 transition-colors duration-300">Tracklist</a>
            <a href="#singles" class="px-4 py-2 rounded-lg backdrop-blur-md bg-black/20 border border-white/20 text-white hover:bg-white/10 transition-colors duration-300">Singles</a>
            <a href="#reception" class="px-4 py-2 rounded-lg backdrop-blur-md bg-black/20 border border-white/20 text-white hover:bg-white/10 transition-colors duration-300">Critical Reception</a>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Background Section -->
  <section id="background" class="mb-16">
    <div class="glass-card rounded-xl p-6 border border-white/20 backdrop-blur-lg bg-black/10">
      <h2 class="font-heading text-3xl text-primary mb-4">Background & Recording</h2>
      <div class="prose prose-invert max-w-none">
        <p class="text-white">{album.background}</p>
      </div>
    </div>
  </section>
  
  <!-- Tracklist Section -->
  <section id="tracks" class="mb-16">
    <div class="glass-card rounded-xl p-6 border border-white/20 backdrop-blur-lg bg-black/10">
      <h2 class="font-heading text-3xl text-primary mb-6">Tracklist</h2>
      <div class="overflow-hidden">
        <TrackList tracks={album.tracks} />
      </div>
    </div>
  </section>
  
  <!-- Singles Section with Individual Chart Position Bubbles -->
  {album.singles && album.singles.length > 0 && (
    <section id="singles" class="mb-16">
      <div class="glass-card rounded-xl p-6 border border-white/20 backdrop-blur-lg bg-black/10">
        <h2 class="font-heading text-3xl text-primary mb-6">Singles</h2>
        <ul class="space-y-6">
          {album.singles.map(single => (
            <li class="p-4 rounded-lg backdrop-blur-md bg-black/10 border border-white/10">
              <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 mb-3">
                <div>
                  <h3 class="text-xl text-white font-medium">{single.title}</h3>
                  <p class="text-white/70 text-sm">Released: {single.releaseDate}</p>
                </div>
              </div>
              
              {single.chartPositions && single.chartPositions.length > 0 && (
                <div class="flex flex-wrap gap-2 mt-3">
                  {single.chartPositions.map(chart => (
                    <div class="bg-primary/20 px-3 py-1 rounded-full text-sm text-white flex items-center">
                      <span class="font-medium mr-1">#{chart.chart_position}</span>
                      <span class="text-white/80">{chart.country}</span>
                    </div>
                  ))}
                </div>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
  
  <!-- Reception Section -->
  <section id="reception" class="mb-16">
    <div class="glass-card rounded-xl p-6 border border-white/20 backdrop-blur-lg bg-black/10">
      <h2 class="font-heading text-3xl text-primary mb-4">Critical Reception</h2>
      <div class="prose prose-invert max-w-none">
        <p class="text-white">{album.reception}</p>
      </div>
    </div>
  </section>
  
  <!-- Related Albums - Redesigned with overlay titles -->
  <section class="mb-16">
    <h2 class="font-heading text-3xl text-primary mb-6">You Might Also Like</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {relatedAlbums.map(relatedAlbum => (
        <a 
          href={`/discography/${relatedAlbum.slug}`} 
          class="glass-card overflow-hidden rounded-xl border border-white/20 backdrop-blur-lg bg-black/10 hover-lift group relative aspect-square"
        >
          <img 
            src={relatedAlbum.coverImage} 
            alt={`${relatedAlbum.title} album cover`} 
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
            transition:name={`album-${relatedAlbum.id}`}
          />
          <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/40 to-transparent flex flex-col justify-end p-4">
            <h3 class="text-white font-medium text-lg line-clamp-2 group-hover:text-primary transition-colors duration-300">{relatedAlbum.title}</h3>
            <p class="text-white/70 text-sm">{relatedAlbum.year}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</div>

<style>  
  /* Ensure the artwork background shows through all containers */
  .artwork-background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }
  
  /* Album artwork background */
  .album-artwork {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0.3;
    filter: blur(20px);
  }
  
  /* Hover lift effect */
  .hover-lift {
    transition: transform 0.3s var(--ease-out);
  }
  
  .hover-lift:hover {
    transform: translateY(-4px);
  }
</style>