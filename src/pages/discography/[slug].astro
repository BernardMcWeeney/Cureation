---
import MainLayout from "../../layouts/MainLayout.astro";
import TrackList from "../../components/TrackList.astro";

export async function getStaticPaths() {
  try {
    const albumsResponse = await fetch('https://dash.cureation.net/items/discography');
    const albumsData = await albumsResponse.json();

    const songsResponse = await fetch('https://dash.cureation.net/items/songs');
    const songsData = await songsResponse.json();

    const singlesResponse = await fetch('https://dash.cureation.net/items/singles');
    const singlesData = await singlesResponse.json();

    const paths = await Promise.all(albumsData.data.map(async (album) => {
      let slug = album.slug || (album.title ? album.title.toLowerCase().replace(/[^\w\s]/gi, '').replace(/\s+/g, '-') : `album-${album.id}`);

      const formattedAlbum = {
        id: album.id.toString(),
        title: album.title || 'Unknown Album',
        slug: slug,
        year: album.release_date ? new Date(album.release_date).getFullYear().toString() : '',
        coverImage: album.cover_art ? `https://dash.cureation.net/assets/${album.cover_art}` : '/images/placeholder-album.jpg',
        releaseDate: album.release_date ? new Date(album.release_date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) : 'Unknown',
        recordLabel: album.label || 'Fiction',
        producer: album.producer || 'Robert Smith & David M. Allen',
        description: album.description || '',
        background: album.background_text || '',
        reception: album.critical_reception || '',
        recordingStudios: album.recording_studios || 'Various Studios, UK',
        genre: album.genre || 'Alternative Rock, Post-Punk',
        // New fields for enhanced sections (from Directus or mock)
        recordingLocation: album.recording_location || null,
        recordingStory: album.recording_story || null,
        behindTheSound: album.behind_the_sound || null,
        bandLineup: album.band_lineup || null,
        musicVideos: album.music_videos || null,
        criticalQuotes: album.critical_quotes || null,
        galleryImages: album.gallery_images || null,
        instruments: album.instruments || null,
      };

      formattedAlbum.tracks = songsData.data
        .filter(song => song.album === album.id && song.title)
        .map(song => ({
          number: song.track_number,
          title: song.title,
          duration: song.duration || '0:00',
          listen_link: song.listen_link
        }));

      formattedAlbum.singles = singlesData.data
        .filter(single => single.album === album.id)
        .map(single => ({
          title: single.title || 'Unknown Single',
          releaseDate: single.release_date ? new Date(single.release_date).toLocaleDateString('en-US', { month: 'long', year: 'numeric' }) : '',
          chartPositions: single.chart_position || [],
          coverImage: single.cover_art ? `https://dash.cureation.net/assets/${single.cover_art}` : null
        }));

      return formattedAlbum;
    }));

    return paths.map(album => {
      const relatedAlbums = paths.filter(a => a.slug !== album.slug).slice(0, 4);
      return { params: { slug: album.slug }, props: { album, relatedAlbums } };
    });
  } catch (error) {
    console.error('Error in getStaticPaths:', error);
    return [];
  }
}

const { album, relatedAlbums } = Astro.props;

// Calculate duration
const totalDuration = album.tracks?.reduce((total, track) => {
  if (!track.duration) return total;
  const [mins, secs] = track.duration.split(':').map(Number);
  return total + mins + (secs / 60);
}, 0) || 0;
const hours = Math.floor(totalDuration / 60);
const mins = Math.round(totalDuration % 60);
const durationDisplay = hours > 0 ? `${hours}h ${mins}m` : `${mins} min`;

// ============================================
// MOCK DATA - Replace with Directus fields
// ============================================

// Recording Story (from Directus: album.recording_location, album.recording_story, album.behind_the_sound)
const recordingData = album.recordingLocation || {
  location: "Hookend Recording Studios in Checkendon, Oxfordshire, England",
  locationDescription: "The remote countryside location provided the perfect isolation for the band to create their darkest and most atmospheric work.",
  production: `Produced by ${album.producer}. The recording sessions spanned several months, with the band embracing a more expansive and layered sound.`,
  behindTheSound: "Robert Smith was going through a period of reflection and melancholy as he approached his 30th birthday. This emotional state heavily influenced the album's introspective and atmospheric nature. The band experimented with longer song structures, lush synthesizer textures, and dreamy guitar tones, creating a soundscape that would define gothic alternative rock for decades to come."
};

// Band Members for this album era (from Directus: album.band_lineup)
const bandMembers = album.bandLineup || [
  { name: "Robert Smith", role: "Vocals, Guitar, Keyboards", image: "https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=400&h=400&fit=crop" },
  { name: "Porl Thompson", role: "Guitar, Keyboards", image: "https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?w=400&h=400&fit=crop" },
  { name: "Simon Gallup", role: "Bass Guitar", image: "https://images.unsplash.com/photo-1514320291840-2e0a9bf2a9ae?w=400&h=400&fit=crop" },
  { name: "Boris Williams", role: "Drums, Percussion", image: "https://images.unsplash.com/photo-1524230659092-07f99a75c013?w=400&h=400&fit=crop" },
  { name: "Lol Tolhurst", role: "Keyboards", image: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&h=400&fit=crop" },
  { name: "Roger O'Donnell", role: "Keyboards", image: "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=400&h=400&fit=crop" }
];

// Music Videos (from Directus: album.music_videos)
const musicVideos = album.musicVideos || [
  {
    title: "Lullaby",
    year: album.year || "1989",
    director: "Tim Pope",
    description: "A surreal nightmare featuring giant spiders, this became one of The Cure's most iconic videos.",
    thumbnail: "https://images.unsplash.com/photo-1478737270239-2f02b77fc618?w=600&h=340&fit=crop",
    url: "#"
  },
  {
    title: "Lovesong",
    year: album.year || "1989",
    director: "Tim Pope",
    description: "Written by Robert Smith for his wife, this tender love song became a major hit.",
    thumbnail: "https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=600&h=340&fit=crop",
    url: "#"
  },
  {
    title: "Pictures of You",
    year: album.year || "1990",
    director: "Tim Pope",
    description: "A melancholic masterpiece featuring burning photographs and nostalgic imagery.",
    thumbnail: "https://images.unsplash.com/photo-1501386761578-eac5c94b800a?w=600&h=340&fit=crop",
    url: "#"
  }
];

// Critical Acclaim Quotes (from Directus: album.critical_quotes)
const criticalQuotes = album.criticalQuotes || [
  {
    quote: "A towering achievement in gothic rock, this is The Cure's masterpiece of atmospheric melancholy.",
    publication: "Rolling Stone",
    reviewer: "David Fricke",
    rating: 5
  },
  {
    quote: "Breathtakingly beautiful and devastatingly sad, this is The Cure at their most expansive and emotionally raw.",
    publication: "NME",
    reviewer: "Stuart Bailie",
    rating: 5
  },
  {
    quote: "An epic exploration of loss, longing, and despair that transformed alternative rock forever.",
    publication: "Pitchfork",
    reviewer: "Ryan Schreiber",
    rating: 5
  },
  {
    quote: "The Cure's crowning glory, a record of stunning emotional depth and sonic innovation.",
    publication: "AllMusic",
    reviewer: "Steve Huey",
    rating: 5
  }
];

// Gallery Images (from Directus: album.gallery_images)
const galleryImages = album.galleryImages || [
  { url: "https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=800&h=600&fit=crop", caption: "Studio session" },
  { url: "https://images.unsplash.com/photo-1514320291840-2e0a9bf2a9ae?w=800&h=600&fit=crop", caption: "Recording at Hookend" },
  { url: "https://images.unsplash.com/photo-1501386761578-eac5c94b800a?w=800&h=600&fit=crop", caption: "Live performance" },
  { url: "https://images.unsplash.com/photo-1478737270239-2f02b77fc618?w=800&h=600&fit=crop", caption: "Promotional shoot" },
  { url: "https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?w=800&h=600&fit=crop", caption: "Behind the scenes" },
  { url: "https://images.unsplash.com/photo-1524230659092-07f99a75c013?w=800&h=600&fit=crop", caption: "Album artwork session" }
];

// Instruments (from Directus: album.instruments)
const instruments = album.instruments || [
  { name: "Fender Jazzmaster", type: "Guitar", player: "Robert Smith", description: "The signature guitar tone throughout the album" },
  { name: "Fender Bass VI", type: "Bass", player: "Simon Gallup", description: "Providing the deep, melodic bass lines" },
  { name: "Roland Juno-60", type: "Synthesizer", player: "Roger O'Donnell", description: "Creating the lush atmospheric pads" },
  { name: "Oberheim OB-Xa", type: "Synthesizer", player: "Lol Tolhurst", description: "String and pad sounds" },
  { name: "Yamaha DX7", type: "Synthesizer", player: "Various", description: "Electric piano and bell tones" },
  { name: "Ludwig Drums", type: "Drums", player: "Boris Williams", description: "Powerful yet restrained drumming" }
];
---

<MainLayout
  title={album.title}
  description={`${album.title} by The Cure, released ${album.year}. ${album.description?.slice(0, 150) || ''}`}
  ogImage={album.coverImage}
  showSidebar={false}
  pageClass={`theme-${album.slug} album-page`}
  theme={album.slug}
>

<!-- Full-Screen Hero -->
<section class="album-hero">
  <div class="hero-artwork">
    <img src={album.coverImage} alt="" class="hero-artwork-img" />
    <div class="hero-overlay"></div>
  </div>

  <div class="hero-content">
    <div class="hero-layout">
      <div class="cover-wrapper">
        <div class="cover-glow"></div>
        <img src={album.coverImage} alt={`${album.title} album cover`} class="cover-image" transition:name={`album-${album.id}`} />
      </div>

      <div class="album-info">
        <p class="album-meta">{album.year} · Studio Album · {album.recordLabel}</p>
        <h1 class="album-title">{album.title}</h1>
        <p class="album-artist">The Cure</p>

        <div class="album-stats">
          <span>{album.tracks?.length || 0} songs</span>
          <span class="stat-dot"></span>
          <span>{durationDisplay}</span>
          {album.singles?.length > 0 && (
            <>
              <span class="stat-dot"></span>
              <span>{album.singles.length} singles</span>
            </>
          )}
        </div>

        <div class="hero-actions">
          <a href="#tracklist" class="btn-primary">
            <svg class="btn-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            View Tracklist
          </a>
          <a href="#about" class="btn-secondary">Learn More</a>
        </div>
      </div>
    </div>
  </div>

  <div class="scroll-indicator">
    <span>Scroll to explore</span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
  </div>
</section>

<!-- About Section -->
<section id="about" class="content-section">
  <div class="section-container">
    <div class="about-grid">
      <div class="about-main">
        <h2 class="section-heading">About the Album</h2>
        {album.description && <p class="lead-text">{album.description}</p>}
        {album.background && <div class="prose-content"><p>{album.background}</p></div>}
      </div>
      <aside class="about-sidebar">
        <div class="details-card">
          <h3>Details</h3>
          <dl class="details-list">
            <div class="detail-item"><dt>Released</dt><dd>{album.releaseDate}</dd></div>
            <div class="detail-item"><dt>Label</dt><dd>{album.recordLabel}</dd></div>
            <div class="detail-item"><dt>Producer</dt><dd>{album.producer}</dd></div>
            <div class="detail-item"><dt>Genre</dt><dd>{album.genre}</dd></div>
            <div class="detail-item"><dt>Studio</dt><dd>{album.recordingStudios}</dd></div>
          </dl>
        </div>
      </aside>
    </div>
  </div>
</section>

<!-- Recording Story Section -->
<section class="content-section alt-bg">
  <div class="section-container">
    <div class="section-header-row">
      <div class="section-icon-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
      </div>
      <h2 class="section-heading">The Recording Story</h2>
    </div>

    <div class="recording-grid">
      <div class="recording-main">
        <div class="recording-item">
          <div class="recording-item-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div>
            <h3>Location</h3>
            <p>Recorded at {recordingData.location}. {recordingData.locationDescription}</p>
          </div>
        </div>

        <div class="recording-item">
          <div class="recording-item-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>
          </div>
          <div>
            <h3>Production</h3>
            <p>{recordingData.production}</p>
          </div>
        </div>
      </div>

      <div class="recording-sidebar">
        <div class="behind-sound-card">
          <h3>Behind the Sound</h3>
          <p>{recordingData.behindTheSound}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Band Members Section -->
<section class="content-section">
  <div class="section-container">
    <div class="section-header-row">
      <div class="section-icon-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
      </div>
      <h2 class="section-heading">Band Members</h2>
    </div>

    <div class="members-scroll">
      {bandMembers.map(member => (
        <article class="member-card">
          <div class="member-image">
            <img src={member.image} alt={member.name} loading="lazy" />
          </div>
          <div class="member-info">
            <h3>{member.name}</h3>
            <p>{member.role}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- Tracklist Section -->
<section id="tracklist" class="content-section alt-bg">
  <div class="section-container">
    <div class="tracklist-header">
      <h2 class="section-heading">Tracklist</h2>
      <p class="section-subhead">{album.tracks?.length || 0} tracks · {durationDisplay}</p>
    </div>
    <div class="tracklist-wrapper">
      <TrackList tracks={album.tracks} />
    </div>
  </div>
</section>

<!-- Singles Section -->
{album.singles && album.singles.length > 0 && (
  <section class="content-section">
    <div class="section-container">
      <h2 class="section-heading">Singles</h2>
      <p class="section-subhead">{album.singles.length} singles released from this album</p>
      <div class="singles-grid">
        {album.singles.map((single, idx) => (
          <article class="single-card">
            <div class="single-artwork">
              <img src={single.coverImage || album.coverImage} alt={single.title} />
              <div class="single-number">{idx + 1}</div>
            </div>
            <div class="single-info">
              <h3>{single.title}</h3>
              <p>{single.releaseDate}</p>
              {single.chartPositions && single.chartPositions.length > 0 && (
                <div class="chart-positions">
                  {single.chartPositions.slice(0, 3).map(pos => (
                    <span class="chart-tag">#{pos.chart_position} {pos.country}</span>
                  ))}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<!-- Music Videos Section -->
<section class="content-section alt-bg">
  <div class="section-container">
    <div class="section-header-row">
      <div class="section-icon-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"/><line x1="7" y1="2" x2="7" y2="22"/><line x1="17" y1="2" x2="17" y2="22"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="2" y1="7" x2="7" y2="7"/><line x1="2" y1="17" x2="7" y2="17"/><line x1="17" y1="17" x2="22" y2="17"/><line x1="17" y1="7" x2="22" y2="7"/></svg>
      </div>
      <h2 class="section-heading">Music Videos</h2>
    </div>

    <div class="videos-grid">
      {musicVideos.map(video => (
        <a href={video.url} class="video-card" target="_blank" rel="noopener noreferrer">
          <div class="video-thumbnail">
            <img src={video.thumbnail} alt={video.title} loading="lazy" />
            <div class="video-play">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </div>
          </div>
          <div class="video-info">
            <div class="video-header">
              <h3>{video.title}</h3>
              <span class="video-year">{video.year}</span>
            </div>
            <p class="video-director">Directed by {video.director}</p>
            <p class="video-description">{video.description}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- Critical Acclaim Section -->
<section class="content-section">
  <div class="section-container">
    <div class="section-header-row">
      <div class="section-icon-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
      </div>
      <h2 class="section-heading">Critical Acclaim</h2>
    </div>

    <div class="quotes-grid">
      {criticalQuotes.map(quote => (
        <article class="quote-card">
          <div class="quote-icon">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/></svg>
          </div>
          <blockquote class="quote-text">{quote.quote}</blockquote>
          <div class="quote-footer">
            <div class="quote-source">
              <span class="quote-publication">{quote.publication}</span>
              <span class="quote-reviewer">{quote.reviewer}</span>
            </div>
            <div class="quote-rating">
              {[1,2,3,4,5].map(star => (
                <svg class={`star ${star <= quote.rating ? 'filled' : ''}`} viewBox="0 0 24 24" fill="currentColor">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                </svg>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- Album Era Gallery -->
<section class="content-section alt-bg">
  <div class="section-container">
    <div class="section-header-row">
      <div class="section-icon-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
      </div>
      <h2 class="section-heading">Album Era Gallery</h2>
    </div>

    <div class="gallery-grid">
      {galleryImages.map((image, idx) => (
        <div class={`gallery-item ${idx === 0 ? 'large' : ''}`}>
          <img src={image.url} alt={image.caption} loading="lazy" />
          <div class="gallery-caption">{image.caption}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Instruments Section -->
<section class="content-section">
  <div class="section-container">
    <div class="section-header-row">
      <div class="section-icon-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
      </div>
      <h2 class="section-heading">Instruments & Gear</h2>
    </div>

    <div class="instruments-grid">
      {instruments.map(instrument => (
        <article class="instrument-card">
          <div class="instrument-type">{instrument.type}</div>
          <h3 class="instrument-name">{instrument.name}</h3>
          <p class="instrument-player">Played by {instrument.player}</p>
          <p class="instrument-description">{instrument.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- More Albums -->
{relatedAlbums.length > 0 && (
  <section class="content-section alt-bg">
    <div class="section-container">
      <h2 class="section-heading">More Albums</h2>
      <p class="section-subhead">Explore more from The Cure's discography</p>
      <div class="albums-grid">
        {relatedAlbums.map(related => (
          <a href={`/discography/${related.slug}`} class="album-card">
            <div class="album-card-artwork">
              <img src={related.coverImage} alt={related.title} transition:name={`album-${related.id}`} />
            </div>
            <div class="album-card-info">
              <h3>{related.title}</h3>
              <p>{related.year}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

</MainLayout>

<style>
  /* ========================================
     ALBUM PAGE - ENHANCED STYLES
     ======================================== */

  /* Hero Section */
  .album-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: -5rem -1.5rem 0;
    padding: 6rem 1.5rem 4rem;
    overflow: hidden;
  }

  @media (min-width: 1024px) {
    .album-hero { margin: -5rem -2rem 0; padding: 6rem 2rem 4rem; }
  }

  .hero-artwork {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-artwork-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(40px) saturate(1.2);
    transform: scale(1.1);
    opacity: 0.6;
  }

  .hero-overlay {
    position: absolute;
