---
import Layout from '../../layouts/Layout.astro';
import AlbumCard from '../../components/album/AlbumCard.astro';
import IssueSection from '../../components/ui/IssueSection.astro';
import PageHero from '../../components/ui/PageHero.astro';
import { listAlbums } from '../../lib/directus';

const eps = await listAlbums({ type: 'ep' });
const yearsSorted = eps.map((a) => Number(a.release_date?.slice(0, 4))).filter(Boolean).sort();
const tabs = [
  { href: '/discography',              label: 'Studio',      active: false },
  { href: '/discography/ep',           label: 'EPs',         active: true  },
  { href: '/discography/compilations', label: 'Compilations',active: false },
  { href: '/discography/singles',      label: 'Singles',     active: false },
];
---
<Layout title="EPs · Discography · Cureation">
  <PageHero
    section="Extended plays"
    title="Extended plays"
    deck="Short-form releases and interstitial records — the missives between albums."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Discography', href: '/discography' }, { label: 'EPs' }]}
    facts={[
      { k: 'On file', v: eps.length },
      { k: 'First', v: yearsSorted[0] || '—' },
      { k: 'Latest', v: yearsSorted[yearsSorted.length - 1] || '—' },
    ]}
    flush
  />

  <nav class="container disc-tabs" aria-label="Record type">
    {tabs.map((t) => (
      <a href={t.href} class={`disc-tabs__tab${t.active ? ' is-active' : ''}`} aria-current={t.active ? 'page' : undefined}>
        {t.label}
      </a>
    ))}
  </nav>

  <IssueSection kicker="Cover plates" title="Sleeves" meta={`${eps.length} extended plays`}>
    {eps.length > 0 ? (
      <div class="records-grid">
        {eps.map((a) => <AlbumCard album={a} size="md" />)}
      </div>
    ) : (
      <p class="deck">No EPs catalogued yet.</p>
    )}
  </IssueSection>
</Layout>
