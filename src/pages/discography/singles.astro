---
import Layout from '../../layouts/Layout.astro';
import IssueSection from '../../components/ui/IssueSection.astro';
import Crumbs from '../../components/ui/Crumbs.astro';
import Chip from '../../components/ui/Chip.astro';
import { fetchRaw, listAlbums, type Single, type Album } from '../../lib/directus';

const [singles, albums] = await Promise.all([
  fetchRaw<Single>('singles', { limit: -1, fields: 'id,title,release_date,chart_position,album', sort: '-release_date' }),
  listAlbums(),
]);

const albumsById = Object.fromEntries(albums.map((a) => [a.id, a]));

const tabs = [
  { href: '/discography',              label: 'Studio',      active: false },
  { href: '/discography/ep',           label: 'EPs',         active: false },
  { href: '/discography/compilations', label: 'Compilations',active: false },
  { href: '/discography/singles',      label: 'Singles',     active: true  },
];

function peakChart(cp: any): string {
  if (!Array.isArray(cp) || cp.length === 0) return '—';
  const peaks = cp.map((c) => Number(c.chart_position)).filter((n) => !isNaN(n));
  if (!peaks.length) return '—';
  return '#' + Math.min(...peaks);
}

const charted = singles.filter((s: any) => peakChart(s.chart_position) !== '—').length;
const firstYear = singles.map((s: any) => Number(s.release_date?.slice(0, 4))).filter(Boolean).sort()[0];
const lastYear  = singles.map((s: any) => Number(s.release_date?.slice(0, 4))).filter(Boolean).sort().slice(-1)[0];

const facts: Array<[string, string]> = [
  ['Singles', String(singles.length)],
  ['Charted', String(charted)],
  ['First', firstYear ? String(firstYear) : '—'],
  ['Latest', lastYear ? String(lastYear) : '—'],
];
---
<Layout title="Singles · Discography · Cureation">
  <div class="container" style="padding-top: clamp(24px, 3vw, 40px);">
    <Crumbs items={[{ label: 'Home', href: '/' }, { label: 'Discography', href: '/discography' }, { label: 'Singles' }]} />
    <div class="stack" style="--gap: 1rem; margin-top: 1rem;">
      <div class="mono-sm muted">SECTION · SINGLES</div>
      <h1 class="serif" style="font-size: clamp(48px, 7.5vw, 96px); line-height:.95; font-style: italic; margin: 0;">Singles</h1>
      <p class="deck" style="max-width: 62ch;">Every standalone release, annotated with its charted position where the record exists.</p>
      <div class="facts">
        {facts.map(([k, v]) => (
          <div class="facts__item">
            <div class="facts__k">{k}</div>
            <div class="facts__v">{v}</div>
          </div>
        ))}
      </div>
      <div class="cluster" style="gap: 6px; flex-wrap: wrap;">
        {tabs.map((t) => <Chip href={t.href} active={t.active}>{t.label}</Chip>)}
      </div>
    </div>
  </div>

  <IssueSection kicker={`${singles.length} singles`} title="A singles chronology">
    <table class="data">
      <thead><tr><th style="width:80px;">Year</th><th>Title</th><th>Record</th><th class="num" style="text-align:right; width:80px;">Peak</th></tr></thead>
      <tbody>
        {singles.map((s: Single) => {
          const y = s.release_date?.slice(0, 4) || '—';
          const album = s.album ? (albumsById[s.album] as Album | undefined) : undefined;
          return (
            <tr data-clickable={album?.slug ? '' : undefined} onclick={album?.slug ? `location.href='/discography/${album.slug}'` : undefined}>
              <td class="mono-sm muted">{y}</td>
              <td><span class="serif" style="font-size:20px; font-style:italic;">{s.title}</span></td>
              <td class="mono-sm" style="color: var(--ink-2);">{album?.title || '—'}</td>
              <td class="num" style="color: var(--accent-3);">{peakChart(s.chart_position)}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </IssueSection>
</Layout>