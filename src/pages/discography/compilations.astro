---
import Layout from '../../layouts/Layout.astro';
import AlbumCard from '../../components/album/AlbumCard.astro';
import IssueSection from '../../components/ui/IssueSection.astro';
import PageHero from '../../components/ui/PageHero.astro';
import { listAlbums } from '../../lib/directus';

const comps = await listAlbums({ type: ['compilation', 'live', 'boxset', 'deluxe'] });
const yearsSorted = comps.map((a) => Number(a.release_date?.slice(0, 4))).filter(Boolean).sort();
const tabs = [
  { href: '/discography',              label: 'Studio',      active: false },
  { href: '/discography/ep',           label: 'EPs',         active: false },
  { href: '/discography/compilations', label: 'Compilations',active: true  },
  { href: '/discography/singles',      label: 'Singles',     active: false },
];
---
<Layout title="Compilations · Discography · Cureation">
  <PageHero
    section="Compilations & live"
    title="Compilations & live"
    deck="Anthologies, live records, deluxe reissues and boxsets — how the catalogue was repackaged across decades."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Discography', href: '/discography' }, { label: 'Compilations' }]}
    facts={[
      { k: 'On file', v: comps.length },
      { k: 'First', v: yearsSorted[0] || '—' },
      { k: 'Latest', v: yearsSorted[yearsSorted.length - 1] || '—' },
    ]}
    flush
  />

  <nav class="container disc-tabs" aria-label="Record type">
    {tabs.map((t) => (
      <a href={t.href} class={`disc-tabs__tab${t.active ? ' is-active' : ''}`} aria-current={t.active ? 'page' : undefined}>
        {t.label}
      </a>
    ))}
  </nav>

  <IssueSection kicker="Cover plates" title="Sleeves" meta={`${comps.length} releases`}>
    {comps.length > 0 ? (
      <div class="records-grid">
        {comps.map((a) => <AlbumCard album={a} size="md" />)}
      </div>
    ) : (
      <p class="deck">No compilations catalogued yet.</p>
    )}
  </IssueSection>
</Layout>
