---
import { editable, copyText, copySource } from '../lib/visual-editing';
import Layout from '../layouts/Layout.astro';
import IssueSection from '../components/ui/IssueSection.astro';
import PageHero from '../components/ui/PageHero.astro';
import Chip from '../components/ui/Chip.astro';
import { fetchRaw } from '../lib/directus';

const items: any[] = await fetchRaw('did_you_know', { limit: -1, sort: '-id' }).catch(() => []);
const categories = Array.from(new Set(items.map((i) => i.category).filter(Boolean))).sort();
---
<Layout title="Curiosities · Cureation">
  <PageHero copyKeys={{"section":"pages_curiosities_324a9a24f8b5","title":"pages_curiosities_45a31d30d7cd","deck":"pages_curiosities_840fa235f297"}}
    section={copyText("pages_curiosities_324a9a24f8b5", "Did you know")}
    title={copyText("pages_curiosities_45a31d30d7cd", "Trivia")}

    crumbs={[{ ...copySource({"label":"pages_curiosities_data-d4aa29dfe274"}),  label: copyText("pages_curiosities_data-d4aa29dfe274", "Home"), href: '/' }, { ...copySource({"label":"pages_curiosities_data-11ecfbfd8267"}),  label: copyText("pages_curiosities_data-11ecfbfd8267", "Trivia") }]}
    facts={[
      { ...copySource({"k":"pages_curiosities_data-cf0cfbdd7062"}),  k: copyText("pages_curiosities_data-cf0cfbdd7062", "On file"), v: items.length },
      { ...copySource({"k":"pages_curiosities_data-bd39b151fedb"}),  k: copyText("pages_curiosities_data-bd39b151fedb", "Categories"), v: categories.length },
    ]}
    flush
  >
    {categories.length > 0 && (
      <div class="cluster" style="gap:6px; flex-wrap:wrap; margin-top: clamp(20px, 3vw, 32px);" data-cat-filters>
        <Chip active={true} class="cat-chip" data-cat="all">All</Chip>
        {categories.map((c) => <Chip class="cat-chip" data-cat={c}>{c}</Chip>)}
      </div>
    )}
  </PageHero>

  <IssueSection title="Trivia">
    <div class="curios" data-curios>
      {items.map((it, i) => (
        <article class="curio" data-cat={it.category || ''}>
          <div class="curio__idx mono-sm">№ {String(i + 1).padStart(3, '0')}</div>
          <div>
            <div data-directus={editable(it, ["category"])} class="mono-sm muted" style="letter-spacing:.1em;">{(it.category || '–').toUpperCase()}</div>
            <div data-directus={editable(it, ["title"])} class="curio__title serif">{it.title || '–'}</div>
            <p data-directus={editable(it, ["content","body"])} class="curio__body">{it.content || it.body || ''}</p>
          </div>
        </article>
      ))}
    </div>
  </IssueSection>
</Layout>

<script>
  function wire() {
    const chips = document.querySelectorAll<HTMLElement>('[data-cat-filters] .cat-chip');
    const cards = document.querySelectorAll<HTMLElement>('[data-curios] .curio');
    chips.forEach((chip) => chip.addEventListener('click', () => {
      const c = chip.getAttribute('data-cat') || 'all';
      chips.forEach((x) => { x.classList.toggle('is-active', x === chip); x.setAttribute('aria-pressed', x === chip ? 'true' : 'false'); });
      cards.forEach((r) => { const rc = r.getAttribute('data-cat') || ''; r.style.display = c === 'all' || rc === c ? '' : 'none'; });
    }));
  }
  wire();
  document.addEventListener('astro:page-load', wire);
</script>

<style is:global>
  .curios { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0; border-top: 1px solid var(--rule); }
  @media (max-width: 780px) { .curios { grid-template-columns: 1fr; } }
  .curio { padding: clamp(20px, 3vw, 32px); border-bottom: 1px solid var(--rule); border-left: 1px solid var(--rule); display: grid; grid-template-columns: 52px 1fr; gap: 1rem; align-items: start; }
  .curio:nth-child(odd) { border-left: none; }
  .curio__idx { color: var(--accent-3); }
  .curio__title { font-size: clamp(20px, 2.2vw, 26px); font-style: italic; line-height: 1.15; margin: .2rem 0 .4rem; }
  .curio__body { font-family: var(--f-serif); font-size: var(--text-small); line-height: 1.6; color: var(--ink-2); margin: 0; max-width: 52ch; }
</style>
