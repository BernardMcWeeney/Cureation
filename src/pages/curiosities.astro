---
import Layout from '../layouts/Layout.astro';
import IssueSection from '../components/ui/IssueSection.astro';
import Crumbs from '../components/ui/Crumbs.astro';
import Chip from '../components/ui/Chip.astro';
import { fetchRaw } from '../lib/directus';

const items: any[] = await fetchRaw('did_you_know', { limit: -1, sort: '-id' }).catch(() => []);
const categories = Array.from(new Set(items.map((i) => i.category).filter(Boolean))).sort();
---
<Layout title="Curiosities · Cureation">
  <div class="container" style="padding-top: clamp(24px, 3vw, 40px);">
    <Crumbs items={[{ label: 'Home', href: '/' }, { label: 'Curiosities' }]} />
    <div class="stack" style="--gap: 1rem; margin-top: 1rem;">
      <div class="mono-sm muted">SECTION · DID YOU KNOW</div>
      <h1 class="serif" style="font-size: clamp(48px, 7.5vw, 96px); line-height:.95; font-style: italic; margin: 0;">Curiosities</h1>
      <p class="deck" style="max-width: 62ch;">Footnotes, trivia, and the minor observations — the marginalia that keep an archive honest about what it knows.</p>
      <div class="facts">
        <div class="facts__item"><div class="facts__k">On file</div><div class="facts__v">{items.length}</div></div>
        <div class="facts__item"><div class="facts__k">Categories</div><div class="facts__v">{categories.length}</div></div>
      </div>
      {categories.length > 0 && (
        <div class="cluster" style="gap:6px; flex-wrap:wrap;" data-cat-filters>
          <Chip active={true} class="cat-chip" data-cat="all">All</Chip>
          {categories.map((c) => <Chip class="cat-chip" data-cat={c}>{c}</Chip>)}
        </div>
      )}
    </div>
  </div>

  <IssueSection kicker="Marginalia" title="Annotations">
    <div class="curios" data-curios>
      {items.map((it, i) => (
        <article class="curio" data-cat={it.category || ''}>
          <div class="curio__idx mono-sm">№ {String(i + 1).padStart(3, '0')}</div>
          <div>
            <div class="mono-sm muted" style="letter-spacing:.18em;">{(it.category || '—').toUpperCase()}</div>
            <div class="curio__title serif">{it.title || '—'}</div>
            <p class="curio__body">{it.content || it.body || ''}</p>
          </div>
        </article>
      ))}
    </div>
  </IssueSection>
</Layout>

<script>
  function wire() {
    const chips = document.querySelectorAll<HTMLElement>('[data-cat-filters] .cat-chip');
    const cards = document.querySelectorAll<HTMLElement>('[data-curios] .curio');
    chips.forEach((chip) => chip.addEventListener('click', () => {
      const c = chip.getAttribute('data-cat') || 'all';
      chips.forEach((x) => { x.classList.toggle('is-active', x === chip); x.setAttribute('aria-pressed', x === chip ? 'true' : 'false'); });
      cards.forEach((r) => { const rc = r.getAttribute('data-cat') || ''; r.style.display = c === 'all' || rc === c ? '' : 'none'; });
    }));
  }
  wire();
  document.addEventListener('astro:page-load', wire);
</script>

<style is:global>
  .curios { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0; border-top: 1px solid var(--rule); }
  @media (max-width: 780px) { .curios { grid-template-columns: 1fr; } }
  .curio { padding: clamp(20px, 3vw, 32px); border-bottom: 1px solid var(--rule); border-left: 1px solid var(--rule); display: grid; grid-template-columns: 52px 1fr; gap: 1rem; align-items: start; }
  .curio:nth-child(odd) { border-left: none; }
  .curio__idx { color: var(--accent-3); }
  .curio__title { font-size: clamp(20px, 2.2vw, 26px); font-style: italic; line-height: 1.15; margin: .2rem 0 .4rem; }
  .curio__body { font-family: var(--f-serif); font-size: 16px; line-height: 1.6; color: var(--ink-2); margin: 0; max-width: 52ch; }
</style>
