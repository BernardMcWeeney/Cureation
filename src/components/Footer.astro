---
import siteConfig, { getFooterLinks } from '../config/site.config';
import VisitorCounter from './VisitorCounter.astro';

const currentYear = new Date().getFullYear();
const footerLinks = getFooterLinks();

// Build social links array from config
const socialLinks = [
  { name: 'X', url: siteConfig.social.twitter, icon: 'x' },
  { name: 'Bluesky', url: siteConfig.social.bluesky ? `https://bsky.app/profile/${siteConfig.social.bluesky}` : null, icon: 'bluesky' },
  { name: 'Instagram', url: siteConfig.social.instagram, icon: 'instagram' },
  { name: 'Facebook', url: siteConfig.social.facebook, icon: 'facebook' },
  { name: 'Threads', url: siteConfig.social.threads, icon: 'threads' },
  { name: 'YouTube', url: siteConfig.social.youtube, icon: 'youtube' },
].filter(s => s.url);
---

<footer class="relative mt-12 border-t border-white/[0.08] overflow-hidden">
  {/* Subtle gradient background */}
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-black/50 to-black pointer-events-none"></div>

  <div class="relative responsive-container">
    {/* Main footer content */}
    <div class="py-12 md:py-16">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-12">

        {/* Brand + Socials */}
        <div class="md:col-span-5">
          <a href="/" class="flex items-center gap-3 mb-5 group">
            <div class="w-10 h-10 bg-black/40 backdrop-blur-md border border-white/15 flex items-center justify-center">
              <img src="/logo.png" alt="Logo" class="w-6 h-6 object-contain" />
            </div>
            <h3 class="m-0 font-display text-4xl md:text-5xl text-primary group-hover:text-white/90 transition-colors duration-300">
              {siteConfig.logo.text}
            </h3>
          </a>

          <p class="text-white/70 text-sm leading-relaxed mb-6 max-w-sm">
            {siteConfig.description}
          </p>

          {/* Social icons - prominent row */}
          <div class="flex flex-wrap gap-2 mb-6">
            {socialLinks.map(social => (
              <a
                href={social.url!}
                target="_blank"
                rel="noopener noreferrer"
                class="social-icon-btn group/social"
                aria-label={`Follow us on ${social.name}`}
              >
                {social.icon === 'x' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-[18px]" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                  </svg>
                )}
                {social.icon === 'bluesky' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-[18px]" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.32 1.828 0 3.316 0 3.93c0 .614.335 5.261.555 6.025.717 2.48 3.275 3.32 5.631 3.05a9.2 9.2 0 0 0 .368-.052 9.2 9.2 0 0 1-.368.052c-3.252.427-6.15 1.4-2.623 4.95C6.846 21.22 9.2 22.588 12 17.76c2.8 4.828 5.058 3.46 8.437.195 3.527-3.55.629-4.523-2.623-4.95a9.2 9.2 0 0 1-.368-.052 9.2 9.2 0 0 0 .368.052c2.356.27 4.914-.57 5.631-3.05.22-.764.555-5.411.555-6.025 0-.614-.32-2.102-.902-2.365-.659-.299-1.664-.621-4.3 1.24C16.046 4.747 13.087 8.686 12 10.8" />
                  </svg>
                )}
                {social.icon === 'instagram' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                    <path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z" />
                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
                  </svg>
                )}
                {social.icon === 'facebook' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-[18px]" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
                  </svg>
                )}
                {social.icon === 'threads' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-[18px]" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.589 12c.027 3.086.718 5.496 2.057 7.164 1.43 1.783 3.631 2.698 6.54 2.717 2.623-.02 4.358-.631 5.8-2.045 1.647-1.613 1.618-3.593 1.09-4.798-.31-.71-.873-1.3-1.634-1.75-.192 1.352-.622 2.446-1.284 3.272-.886 1.102-2.14 1.704-3.73 1.79-1.202.065-2.361-.218-3.259-.801-1.063-.689-1.685-1.74-1.752-2.96-.065-1.182.408-2.256 1.33-3.022.88-.731 2.177-1.14 3.655-1.153.827-.008 1.587.063 2.282.175v2.04c-.625-.11-1.314-.17-2.067-.16-1.92.017-3.088.706-3.122 1.842-.023.768.576 1.506 1.663 1.506h.032c1.16-.063 2.543-.567 2.67-3.508l.012-.31.343.2c1.105.644 1.926 1.483 2.44 2.494.783 1.537.833 4.063-1.196 6.082-1.79 1.782-3.94 2.55-7.164 2.573z" />
                  </svg>
                )}
                {social.icon === 'youtube' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-[18px]" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
                  </svg>
                )}
                <span class="text-[11px] font-medium tracking-wide">{social.name}</span>
              </a>
            ))}
          </div>

          {/* Contact */}
          <div>
            <p class="text-white/50 text-[11px] uppercase tracking-[0.18em] mb-2">Contact</p>
            <div class="flex flex-wrap gap-x-4 gap-y-1">
              {Object.values(siteConfig.contact).map((item) => (
                <a
                  href={`mailto:${item.email}`}
                  class="text-white/60 hover:text-primary transition-colors duration-300 text-sm"
                >
                  {item.label}
                </a>
              ))}
            </div>
          </div>
        </div>

        {/* Navigation columns */}
        <div class="md:col-span-7">
          <div class="grid grid-cols-2 gap-8">
            {/* Explore */}
            <div>
              <h4 class="font-heading text-[11px] uppercase tracking-[0.2em] mb-5 text-primary/80">Explore</h4>
              <ul class="space-y-2.5">
                {footerLinks.explore.map((link) => (
                  <li>
                    <a
                      href={link.path}
                      class="text-white/60 hover:text-white transition-colors duration-300 flex items-center gap-2 text-sm"
                      target={link.external ? '_blank' : undefined}
                      rel={link.external ? 'noopener noreferrer' : undefined}
                    >
                      <span class="w-1 h-1 bg-primary/30 rotate-45 flex-shrink-0"></span>
                      {link.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>

            {/* Community */}
            <div>
              <h4 class="font-heading text-[11px] uppercase tracking-[0.2em] mb-5 text-primary/80">Community</h4>
              <ul class="space-y-2.5">
                {footerLinks.community.map((link) => (
                  <li>
                    <a
                      href={link.path}
                      class="text-white/60 hover:text-white transition-colors duration-300 flex items-center gap-2 text-sm"
                      target={link.external ? '_blank' : undefined}
                      rel={link.external ? 'noopener noreferrer' : undefined}
                    >
                      <span class="w-1 h-1 bg-primary/30 rotate-45 flex-shrink-0"></span>
                      {link.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* Bottom bar */}
    <div class="border-t border-white/[0.06] py-6">
      {/* Visitor counter */}
      <div class="flex justify-center mb-4">
        <VisitorCounter />
      </div>

      <div class="flex flex-col md:flex-row justify-between items-center gap-3 text-xs">
        <p class="text-white/50">
          &copy; {currentYear} {siteConfig.name}. All rights reserved.
        </p>

        <p class="text-white/40 text-center max-w-lg leading-relaxed">
          Cureation is a fan project not affiliated with The Cure or their representatives.
          All media remain property of their respective owners.
        </p>

        <div class="flex gap-5">
          {footerLinks.legal.map((link) => (
            <a
              href={link.path}
              class="text-white/50 hover:text-white transition-colors duration-300"
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
            >
              {link.name}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .social-icon-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.03);
    color: rgba(255, 255, 255, 0.55);
    transition: all 0.25s ease;
  }

  .social-icon-btn:hover {
    color: white;
    background: rgba(var(--color-primary-rgb, 137, 176, 201), 0.12);
    border-color: rgba(var(--color-primary-rgb, 137, 176, 201), 0.3);
    transform: translateY(-1px);
  }
</style>
