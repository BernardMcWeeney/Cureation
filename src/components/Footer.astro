---
import siteConfig, { getFooterLinks } from '../config/site.config';

const currentYear = new Date().getFullYear();
const footerLinks = getFooterLinks();
---

<footer class="relative mt-16 pt-8 bg-black/50 backdrop-blur-xl border-t border-white/[0.06]">
  <!-- Gothic ornamental top line -->
  <div class="absolute top-0 left-0 right-0 h-[1px]" style="background: linear-gradient(90deg, transparent 5%, rgba(var(--color-primary-rgb), 0.2) 30%, rgba(var(--color-primary-rgb), 0.35) 50%, rgba(var(--color-primary-rgb), 0.2) 70%, transparent 95%);"></div>

  <div class="responsive-container py-16">
    <!-- Gothic divider at top -->
    <div class="flex items-center justify-center gap-3 mb-12">
      <div class="h-[1px] flex-1 max-w-32 bg-gradient-to-r from-transparent to-primary/20"></div>
      <div class="w-1.5 h-1.5 bg-primary/30 rotate-45"></div>
      <div class="w-2 h-2 border border-primary/20 rotate-45"></div>
      <div class="w-1.5 h-1.5 bg-primary/30 rotate-45"></div>
      <div class="h-[1px] flex-1 max-w-32 bg-gradient-to-l from-transparent to-primary/20"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-12">
      <!-- Brand Section -->
      <div class="md:col-span-4 lg:col-span-5">
        <a href="/" class="flex items-center gap-3 mb-6 group">
          <div class="w-10 h-10 bg-black/40 backdrop-blur-md rounded-sm border border-white/15 flex items-center justify-center">
            <img
              src="/logo.png"
              alt="Logo"
              class="w-6 h-6 rounded-sm object-contain"
            />
          </div>
          <h3 class="m-0 font-display text-5xl text-primary group-hover:text-primary/80 transition-colors duration-300">
            {siteConfig.logo.text}
          </h3>
        </a>

        <div class="mb-6 max-w-md">
          <p class="text-white/70">{siteConfig.description}</p>
        </div>

        <div class="flex gap-4">
          {siteConfig.social.twitter && (
            <a
              href={siteConfig.social.twitter}
              target="_blank"
              rel="noopener noreferrer"
              class="p-3 rounded-sm border border-white/10 backdrop-blur-md bg-black/30 hover:bg-black/40 hover:border-primary/30 transition-all duration-300"
              aria-label="Twitter"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z" />
              </svg>
            </a>
          )}
        </div>
      </div>

      <!-- Navigation and Contact Links -->
      <div class="md:col-span-8 lg:col-span-7">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">
          <!-- Explore Links -->
          <div>
            <h4 class="font-heading text-sm uppercase tracking-[0.2em] mb-5 text-primary/80">Explore</h4>
            <ul class="space-y-3">
              {footerLinks.explore.map((link) => (
                <li>
                  <a
                    href={link.path}
                    class="text-white/60 hover:text-primary transition-colors duration-300 flex items-center gap-2 text-sm"
                    target={link.external ? '_blank' : undefined}
                    rel={link.external ? 'noopener noreferrer' : undefined}
                  >
                    <span class="w-1 h-1 bg-primary/30 rotate-45 flex-shrink-0"></span>
                    {link.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Community Links -->
          <div>
            <h4 class="font-heading text-sm uppercase tracking-[0.2em] mb-5 text-primary/80">Community</h4>
            <ul class="space-y-3">
              {footerLinks.community.map((link) => (
                <li>
                  <a
                    href={link.path}
                    class="text-white/60 hover:text-primary transition-colors duration-300 flex items-center gap-2 text-sm"
                    target={link.external ? '_blank' : undefined}
                    rel={link.external ? 'noopener noreferrer' : undefined}
                  >
                    <span class="w-1 h-1 bg-primary/30 rotate-45 flex-shrink-0"></span>
                    {link.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Contact Links -->
          <div>
            <h4 class="font-heading text-sm uppercase tracking-[0.2em] mb-5 text-primary/80">Contact</h4>
            <ul class="space-y-3">
              {Object.values(siteConfig.contact).map((item) => (
                <li>
                  <a
                    href={`mailto:${item.email}`}
                    class="text-white/60 hover:text-primary transition-colors duration-300 flex items-center gap-2 text-sm"
                  >
                    <span class="w-1 h-1 bg-primary/30 rotate-45 flex-shrink-0"></span>
                    {item.label}: {item.email}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Section with gothic divider -->
    <div class="mt-16">
      <div class="flex items-center justify-center gap-3 mb-8">
        <div class="h-[1px] flex-1 bg-gradient-to-r from-transparent to-white/[0.06]"></div>
        <div class="w-1 h-1 bg-white/10 rotate-45"></div>
        <div class="h-[1px] flex-1 bg-gradient-to-l from-transparent to-white/[0.06]"></div>
      </div>

      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-sm text-white/50">
          &copy; {currentYear} {siteConfig.name}. All rights reserved.
        </p>

        <p class="text-xs text-white/40 text-center max-w-lg">
          Cureation is a fan project not affiliated with The Cure or their representatives.
          All media remain property of their respective owners.
        </p>

        <div class="flex gap-6">
          {footerLinks.legal.map((link) => (
            <a
              href={link.path}
              class="text-xs text-white/50 hover:text-primary transition-colors duration-300"
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
            >
              {link.name}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</footer>
