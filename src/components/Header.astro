---
import siteConfig, { getNavigation } from '../config/site.config';

// Navigation items from config
const navItems = getNavigation();

// Get current path for active links
const currentPath = Astro.url.pathname;
---

<header class="fixed w-full z-50 backdrop-blur-lg bg-black/20 border-b border-white">
  <div class="responsive-container">
    <div class="flex items-center justify-between h-16 md:h-20">
      <!-- Logo -->
      <div>
        <a href="/" class="flex items-center gap-3 group">
          <!-- Updated logo container with the new logo.png -->
          <div class="w-10 h-10 bg-primary/20 backdrop-blur-md rounded-full border border-white/20 flex items-center justify-center">
            <img src="/logo.png" alt="Logo" class="w-6 h-6 rounded-full object-contain" />
          </div>
          <span class="font-display text-5xl text-primary group-hover:text-primary/80 transition-all duration-300">
            {siteConfig.logo.text}
          </span>
        </a>
      </div>
      
      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center">
        <ul class="flex items-center gap-6">
          {navItems.map(item => (
            <li>
              <a 
                href={item.path} 
                class={`px-4 py-2 relative rounded-lg transition-all duration-300
                  ${currentPath === item.path 
                    ? "text-primary font-medium" 
                    : "text-white hover:text-primary"}
                `}
              >
                <span>{item.name}</span>
                {currentPath === item.path && (
                  <span class="absolute bottom-0 left-1/2 -translate-x-1/2 w-1.5 h-1.5 bg-primary rounded-full"></span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      
      <!-- Right Side Controls -->
      <div class="flex items-center gap-4">
        <!-- Search Button -->
        <button class="w-10 h-10 flex items-center justify-center backdrop-blur-md bg-black/20 rounded-full border border-white/20 hover:text-primary hover:border-white/40 transition-all duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span class="sr-only">Search</span>
        </button>
        
        <!-- Theme Selector -->
        <div class="dropdown dropdown-end">
          <button 
            id="theme-menu-button"
            tabindex="0" 
            class="w-10 h-10 flex items-center justify-center backdrop-blur-md bg-black/20 rounded-full border border-white/20 hover:text-primary hover:border-white/40 transition-all duration-300"
            aria-label="Switch album theme"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
            </svg>
          </button>
          
          <div 
            tabindex="0" 
            class="dropdown-content z-[1] w-56 p-3 rounded-xl mt-2 backdrop-blur-xl bg-black/85 border border-white/15 shadow-xl"
          >
            <div class="text-sm text-white/90 px-2 py-1 font-medium">Album Themes</div>
            {siteConfig.availableThemes.map(theme => (
              <button 
                data-theme-value={theme.id}
                class="theme-item w-full text-left flex items-center justify-between hover:bg-white/10 rounded-lg p-2 my-1 text-white focus:outline-none focus:ring-1 focus:ring-white/20 transition-all duration-300"
              >
                <span>{theme.name}</span>
                <span class="text-xs text-white/70">{theme.year}</span>
              </button>
            ))}
          </div>
        </div>
        
        <!-- Mobile Menu Toggle -->
        <div class="md:hidden">
          <button 
            id="mobile-menu-toggle" 
            class="w-10 h-10 flex items-center justify-center backdrop-blur-md bg-black/20 rounded-full border border-white/20 hover:text-primary hover:border-white/40 transition-all duration-300"
            aria-label="Open main menu"
            aria-expanded="false"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  // Theme switcher functionality
  document.addEventListener('DOMContentLoaded', function() {
    // Initialize theme from localStorage or default from site config
    const savedTheme = localStorage.getItem('theme') || 'disintegration';
    document.documentElement.setAttribute('data-theme', savedTheme);
    
    // Set up event listeners for all theme buttons
    const setupThemeButtons = () => {
      const themeButtons = document.querySelectorAll('.theme-item');
      themeButtons.forEach(button => {
        button.addEventListener('click', () => {
          const theme = button.getAttribute('data-theme-value');
          if (theme) {
            document.documentElement.setAttribute('data-theme', theme);
            localStorage.setItem('theme', theme);
          }
        });
      });
    };
    
    setupThemeButtons();
  });
  
  // Re-initialize after Astro page transitions
  document.addEventListener('astro:page-load', function() {
    // Apply current theme after navigation
    const savedTheme = localStorage.getItem('theme') || 'disintegration';
    document.documentElement.setAttribute('data-theme', savedTheme);
    
    // Set up event listeners for all theme buttons after page transition
    const themeButtons = document.querySelectorAll('.theme-item');
    themeButtons.forEach(button => {
      button.addEventListener('click', () => {
        const theme = button.getAttribute('data-theme-value');
        if (theme) {
          document.documentElement.setAttribute('data-theme', theme);
          localStorage.setItem('theme', theme);
        }
      });
    });
  });
</script>
