---
// src/components/Header.astro

import siteConfig, { getNavigation } from '../config/site.config';

// Navigation items from config
const navItems = getNavigation();
// Current path for active links
const currentPath = Astro.url.pathname;
---

<header class="fixed w-full z-50 backdrop-blur-xl bg-black/40 border-b" style="border-image: linear-gradient(90deg, transparent, rgba(var(--color-primary-rgb), 0.3), transparent) 1;">
  <div class="responsive-container">
    <div class="flex items-center justify-between h-16 md:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-10 h-10 bg-white/10 backdrop-blur-md rounded-full border border-white/20 flex items-center justify-center">
          <img src="/logo.png" alt="Logo" class="w-6 h-6 rounded-full object-contain" />
        </div>
        <span class="font-display text-5xl text-primary group-hover:text-primary/80 transition-colors duration-300">
          {siteConfig.logo.text}
        </span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex">
        <ul class="flex items-center gap-6">
          {navItems.map(item => (
            <li>
              <a
                href={item.path}
                class={`px-4 py-2 relative rounded-lg transition-colors duration-300
                  ${currentPath === item.path 
                    ? 'text-primary font-medium' 
                    : 'text-white hover:text-primary'}
                `}
              >
                {item.name}
                {currentPath === item.path && (
                  <span class="absolute bottom-0 left-1/2 -translate-x-1/2 w-1.5 h-1.5 bg-primary rounded-full"></span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Controls -->
      <div class="flex items-center gap-4">
        <!-- Search -->
        <button
          id="search-button"
          class="text-primary w-10 h-10 flex items-center justify-center backdrop-blur-md bg-black/30 rounded-full border border-white/15 hover:border-primary/40 hover:bg-black/40 hover:shadow-[0_0_15px_rgba(var(--color-primary-rgb),0.3)] transition-all duration-300"
          aria-label="Open search"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span class="sr-only">Search</span>
        </button>

        <!-- Mobile Toggle -->
        <button
          id="mobile-menu-toggle"
          class="text-primary md:hidden w-10 h-10 flex items-center justify-center backdrop-blur-md bg-black/30 rounded-full border border-white/15 hover:border-primary/40 hover:bg-black/40 hover:shadow-[0_0_15px_rgba(var(--color-primary-rgb),0.3)] transition-all duration-300"
          aria-label="Open main menu"
          aria-expanded="false"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Search Overlay -->
<div
  id="search-overlay"
  class="hidden fixed inset-0 bg-black/85 backdrop-blur-md z-40 flex items-center justify-center p-4"
  role="dialog" aria-modal="true"
>
  <div class="relative w-full max-w-md">
    <button
      id="close-search"
      class="absolute top-2 right-2 text-white hover:text-white/80"
      aria-label="Close search"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    
    <!-- Fixed form element with proper method and action -->
    <form id="search-form" action="/lyrics/search" method="get">
      <input
        id="search-input"
        name="q"
        type="search"
        placeholder="Search..."
        class="w-full p-3 rounded-lg bg-white/10 backdrop-blur-lg text-white placeholder-white/50 border border-white/20 focus:ring-2 focus:ring-primary focus:border-primary/50"
      />
      <!-- Add a submit button for accessibility -->
      <button type="submit" class="sr-only">Search</button>
    </form>
  </div>
</div>

<!-- Mobile Nav -->
<nav
  id="mobile-menu"
  class="hidden fixed inset-0 bg-black/90 backdrop-blur-lg z-30 p-6 md:hidden"
>
  <ul class="flex flex-col gap-4">
    {navItems.map(item => (
      <li>
        <a
          href={item.path}
          class={`block px-4 py-2 rounded-lg transition-colors duration-300
            ${currentPath === item.path
              ? 'text-primary font-medium'
              : 'text-white hover:text-primary'}
          `}
        >
          {item.name}
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  function bindControls() {
    // ── Search Overlay Toggle ─────────────────────────
    const searchBtn = document.getElementById('search-button');
    const closeSearch = document.getElementById('close-search');
    const overlay = document.getElementById('search-overlay');
    const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
    const searchForm = document.getElementById('search-form');

    if (searchBtn && overlay && searchInput) {
      searchBtn.onclick = () => {
        overlay.classList.toggle('hidden');
        if (!overlay.classList.contains('hidden')) {
          searchInput.focus();
        }
      };
    }

    if (closeSearch && overlay) {
      closeSearch.onclick = () => overlay.classList.add('hidden');
      overlay.onclick = (e) => {
        if (e.target === overlay) {
          overlay.classList.add('hidden');
        }
      };
    }

    // Handle form submission
    if (searchForm && searchInput) {
      searchForm.addEventListener('submit', (e) => {
        const query = searchInput.value.trim();
        if (!query) {
          e.preventDefault();
        }
      });
    }

    // Handle escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && overlay && !overlay.classList.contains('hidden')) {
        overlay.classList.add('hidden');
      }
    });

    // ── Mobile Nav Toggle ────────────────────────────
    const mobileToggle = document.getElementById('mobile-menu-toggle');
    const mobileMenu   = document.getElementById('mobile-menu');

    if (mobileToggle && mobileMenu) {
      mobileToggle.onclick = () => {
        const isOpen = mobileToggle.getAttribute('aria-expanded') === 'true';
        mobileToggle.setAttribute('aria-expanded', String(!isOpen));
        mobileMenu.classList.toggle('hidden');
      };
    }
  }

  // bind on initial load
  document.addEventListener('DOMContentLoaded', bindControls);
  // re-bind after Astro client navigation
  document.addEventListener('astro:page-load', bindControls);
</script>