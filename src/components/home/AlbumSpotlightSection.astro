---
import type { Album } from '../../types/directus';
import siteConfig from '../../config/site.config';
import { mockAlbums } from '../../lib/mockData';
import {
  fetchAlbums,
  fetchSongs,
  formatAlbum,
  getSetlistsWithSongs,
} from '../../lib/directus';

interface Props {
  album?: Album | null;
  showHeader?: boolean;
}

const { album: propAlbum, showHeader = true } = Astro.props;

const featuredSlug = siteConfig.featured?.album || 'disintegration';
const directusAlbums = (await fetchAlbums()).map(formatAlbum);
const sortedStudioAlbums = directusAlbums
  .filter((album) => (album.type || 'studio') === 'studio')
  .sort((a, b) => parseInt(b.year || '0', 10) - parseInt(a.year || '0', 10));

const album: Album =
  propAlbum ||
  directusAlbums.find((candidate) => candidate.slug === featuredSlug) ||
  sortedStudioAlbums[0] ||
  mockAlbums.find((candidate) => candidate.slug === featuredSlug) ||
  mockAlbums[0];

const parsedReleaseYear = album.year ? parseInt(album.year, 10) : NaN;
const releaseYear = Number.isFinite(parsedReleaseYear) ? parsedReleaseYear : null;

const [songs, setlists] = await Promise.all([
  fetchSongs(),
  getSetlistsWithSongs(),
]);

const albumId = Number(album.id);
const albumSongTitles = new Set(
  songs
    .filter((song) => Number.isFinite(albumId) && song.album === albumId)
    .map((song) => song.title.toLowerCase().trim())
);

const albumSongPlayCounts = new Map<string, number>();
setlists.forEach((setlist) => {
  setlist.songs.forEach((song) => {
    const normalizedTitle = song.title.toLowerCase().trim();
    if (albumSongTitles.has(normalizedTitle)) {
      albumSongPlayCounts.set(song.title, (albumSongPlayCounts.get(song.title) || 0) + 1);
    }
  });
});

const topLiveSongs = Array.from(albumSongPlayCounts.entries())
  .map(([songTitle, totalPlays]) => ({ songTitle, totalPlays }))
  .sort((a, b) => b.totalPlays - a.totalPlays)
  .slice(0, 3);
const totalLivePlays = Array.from(albumSongPlayCounts.values()).reduce((total, count) => total + count, 0);

const latestAlbumSetlists = setlists
  .filter((setlist) =>
    setlist.songs.some((song) => {
      const normalizedTitle = song.title.toLowerCase().trim();
      return albumSongTitles.size > 0
        ? albumSongTitles.has(normalizedTitle)
        : topLiveSongs.some((liveSong) => liveSong.songTitle.toLowerCase().trim() === normalizedTitle);
    })
  )
  .slice(0, 2);

const albumTypeLabel = (() => {
  switch (album.type) {
    case 'studio': return 'Studio Album';
    case 'live': return 'Live Album';
    case 'compilation': return 'Compilation';
    case 'ep': return 'EP';
    default: return 'Release';
  }
})();
---

<div class="h-full">
  {showHeader && (
    <div class="flex items-center gap-4 mb-6">
      <h2 class="font-heading text-2xl text-primary">Album of the Month</h2>
      <div class="flex-1 h-px bg-gradient-to-r from-primary/30 to-transparent"></div>
    </div>
  )}

  <a href={`/discography/${album.slug}`} class="group block">
    <div class="glass-panel overflow-hidden">
      <!-- Desktop: side-by-side, art drives the height -->
      <div class="album-spotlight-grid">
        <!-- Square album artwork -->
        <div class="album-art-wrapper relative overflow-hidden">
          {album.coverImage ? (
            <img
              src={album.coverImage}
              alt={album.title}
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />
          ) : (
            <div class="absolute inset-0 w-full h-full bg-gradient-to-br from-primary/20 via-black to-accent/20"></div>
          )}

          <div class="absolute top-4 left-4 z-10">
            <div class="px-3 py-1 rounded-sm bg-primary/85 text-white text-xs font-medium uppercase tracking-wider">
              Featured
            </div>
          </div>
        </div>

        <!-- Details panel — constrained to artwork height on desktop -->
        <div class="p-5 lg:p-6 flex flex-col justify-between border-t lg:border-t-0 lg:border-l border-white/10 lg:overflow-hidden">
          <div>
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <span class="px-2 py-0.5 rounded-sm bg-white/10 border border-white/15 text-white/80 text-[11px] uppercase tracking-wider">
                {albumTypeLabel}
              </span>
              {releaseYear && (
                <span class="text-white/70 text-sm">{releaseYear}</span>
              )}
              {album.recordLabel && (
                <span class="text-white/55 text-sm">{album.recordLabel}</span>
              )}
            </div>

            <h3 class="font-heading text-2xl lg:text-3xl text-white mb-2 group-hover:text-primary transition-colors text-shadow">
              {album.title}
            </h3>

            <p class="text-white/75 mb-4 line-clamp-4 text-sm">
              {album.description || 'Explore this key chapter in The Cure archive.'}
            </p>

            <!-- Stats grid -->
            <div class="grid grid-cols-4 gap-2 mb-4">
              <div class="glass-stat p-2.5">
                <p class="text-white/45 text-[10px] uppercase tracking-[0.12em]">Tracks</p>
                <p class="text-white text-base font-medium">{album.trackCount || '-'}</p>
              </div>
              <div class="glass-stat p-2.5">
                <p class="text-white/45 text-[10px] uppercase tracking-[0.12em]">Live Plays</p>
                <p class="text-white text-base font-medium">{totalLivePlays || '-'}</p>
              </div>
              <div class="glass-stat p-2.5">
                <p class="text-white/45 text-[10px] uppercase tracking-[0.12em]">Top Songs</p>
                <p class="text-white text-base font-medium">{topLiveSongs.length || '-'}</p>
              </div>
              <div class="glass-stat p-2.5">
                <p class="text-white/45 text-[10px] uppercase tracking-[0.12em]">Shows</p>
                <p class="text-white text-base font-medium">{latestAlbumSetlists.length || '-'}</p>
              </div>
            </div>

            <!-- Live Staples + Recent Setlists side by side -->
            {(topLiveSongs.length > 0 || latestAlbumSetlists.length > 0) && (
              <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <div class="glass-inset p-3">
                  <p class="text-white/45 text-[10px] uppercase tracking-[0.14em] mb-1.5">Live Staples</p>
                  {topLiveSongs.length > 0 ? (
                    <div class="space-y-1.5">
                      {topLiveSongs.map((song) => (
                        <div class="flex items-center justify-between gap-2">
                          <p class="text-white text-xs leading-tight truncate">{song.songTitle}</p>
                          <span class="text-primary text-xs shrink-0">{song.totalPlays}x</span>
                        </div>
                      ))}
                    </div>
                  ) : (
                    <p class="text-white/50 text-xs">No live data yet.</p>
                  )}
                </div>

                <div class="glass-inset p-3">
                  <p class="text-white/45 text-[10px] uppercase tracking-[0.14em] mb-1.5">Recent Setlists</p>
                  {latestAlbumSetlists.length > 0 ? (
                    <div class="space-y-1.5">
                      {latestAlbumSetlists.map((setlist) => (
                        <div class="flex items-center justify-between gap-2">
                          <p class="text-white text-xs leading-tight truncate">{setlist.venue}</p>
                          <span class="text-white/60 text-[11px] shrink-0">{setlist.formattedDate}</span>
                        </div>
                      ))}
                    </div>
                  ) : (
                    <p class="text-white/50 text-xs">No matching setlists yet.</p>
                  )}
                </div>
              </div>
            )}

            <!-- Critical Reception -->
            {album.reception && (
              <div class="mt-3 border-l-2 border-primary/40 pl-3">
                <p class="text-white/45 text-[10px] uppercase tracking-[0.14em] mb-1">Critical Reception</p>
                <p class="text-white/65 text-xs italic line-clamp-3">{album.reception}</p>
              </div>
            )}
          </div>

          <div class="flex items-center gap-2 text-primary mt-4">
            <span class="font-medium text-sm">Explore album</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </a>
</div>

<style>
  .line-clamp-3,
  .line-clamp-4 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
  }

  .line-clamp-3 {
    -webkit-line-clamp: 3;
  }

  .line-clamp-4 {
    -webkit-line-clamp: 4;
  }

  /* Mobile: stack vertically, square art on top */
  .album-spotlight-grid {
    display: grid;
    grid-template-columns: 1fr;
  }

  .album-art-wrapper {
    aspect-ratio: 1 / 1;
    width: 100%;
  }

  /* Desktop: art on left drives the row height, details must fit within */
  @media (min-width: 1024px) {
    .album-spotlight-grid {
      grid-template-columns: 1fr 1fr;
    }

    .album-art-wrapper {
      aspect-ratio: 1 / 1;
      width: auto;
    }
  }
</style>
