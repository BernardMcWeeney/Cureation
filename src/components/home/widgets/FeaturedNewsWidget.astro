---
import type { NewsPost } from '../../../types/directus';
import { getCategoryColor } from '../../../config/categories.config';

interface Props {
  post: NewsPost;
}

const { post } = Astro.props;
const fallbackImage = '/images/placeholder-blog.jpg';
---

<a href={`/news/${post.slug}`} class="glass-tile group block span-2 overflow-hidden">
  <div class="relative h-full min-h-[200px] md:min-h-[240px]">
    {/* Background image */}
    <img
      src={post.featuredImage || fallbackImage}
      alt=""
      class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black via-black/60 to-black/20"></div>

    {/* Content overlay */}
    <div class="relative z-10 flex flex-col justify-end h-full p-5 md:p-6">
      <div class="flex items-center gap-2 mb-2">
        <span class="text-text-muted text-xs font-medium uppercase tracking-[0.12em]">Latest News</span>
        <span class={`px-2 py-0.5 text-xs font-medium border backdrop-blur-sm ${getCategoryColor(post.category)}`}>
          {post.category.charAt(0).toUpperCase() + post.category.slice(1)}
        </span>
      </div>

      <h3 class="font-heading text-xl md:text-2xl text-white mb-2 text-shadow-lg leading-tight line-clamp-2">
        {post.title}
      </h3>

      <p class="text-text-secondary text-sm mb-3 line-clamp-2 hidden md:block">
        {post.excerpt}
      </p>

      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2 text-text-muted text-xs">
          <time datetime={post.publishedDate}>{post.formattedDate}</time>
          {post.readingTime && (
            <>
              <span class="w-1 h-1 bg-white/20 rotate-45" aria-hidden="true"></span>
              <span>{post.readingTime} min read</span>
            </>
          )}
        </div>
        <div class="flex items-center gap-1.5 text-primary text-xs opacity-80 group-hover:opacity-100 transition-all">
          <span>Read</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>
          </svg>
        </div>
      </div>
    </div>
  </div>
</a>
