---
interface ShowEntry {
  venue: string;
  city: string;
  country: string;
  year: number;
}

interface Props {
  dateString: string;
  showCount: number;
  milestoneCount: number;
  shows: ShowEntry[];
  hasEntries: boolean;
  fallbackFact?: string;
}

const { dateString, showCount, milestoneCount, shows, hasEntries, fallbackFact } = Astro.props;
---

<a href="/on-this-day" class="glass-tile p-5 group block h-full min-h-[180px]">
  <div class="flex items-center gap-2 mb-3">
    <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
    </svg>
    <span class="text-text-muted text-xs font-medium uppercase tracking-[0.12em]">
      {hasEntries ? 'On This Day' : 'From the Archive'}
    </span>
  </div>

  <h3 class="font-heading text-lg md:text-xl text-white mb-3">{dateString}</h3>

  {hasEntries ? (
    <div>
      <div class="flex gap-4 mb-3">
        <div>
          <p class="text-xl font-display text-white">{showCount}</p>
          <p class="text-text-muted text-xs uppercase tracking-wider">Shows</p>
        </div>
        {milestoneCount > 0 && (
          <div>
            <p class="text-xl font-display text-purple-300">{milestoneCount}</p>
            <p class="text-text-muted text-xs uppercase tracking-wider">Milestones</p>
          </div>
        )}
      </div>

      {shows.length > 0 && (
        <div class="space-y-1.5">
          {shows.slice(0, 2).map(show => (
            <div class="flex items-center justify-between gap-2 py-1 border-b border-border-subtle last:border-b-0">
              <div class="min-w-0">
                <p class="text-text-secondary text-xs truncate">{show.venue}</p>
                <p class="text-text-muted text-xs truncate">{show.city}, {show.country}</p>
              </div>
              <span class="text-primary font-semibold text-sm shrink-0">{show.year}</span>
            </div>
          ))}
        </div>
      )}
    </div>
  ) : fallbackFact ? (
    <p class="text-text-secondary text-sm line-clamp-3">{fallbackFact}</p>
  ) : (
    <p class="text-text-muted text-sm">Explore the full archive of shows and history.</p>
  )}
</a>
