---
import type { RSSItem } from '../../../lib/rss';

interface Props {
  items: RSSItem[];
}

const { items } = Astro.props;
---

<div class="glass-tile p-5 h-full">
  <div class="flex items-center justify-between mb-4">
    <div class="flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-orange-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12.75 19.5v-.75a7.5 7.5 0 0 0-7.5-7.5H4.5m0-6.75h.75c7.87 0 14.25 6.38 14.25 14.25v.75M6 18.75a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
      </svg>
      <span class="text-text-muted text-xs font-medium uppercase tracking-[0.12em]">Official News</span>
    </div>
    <a
      href="https://www.thecure.com"
      target="_blank"
      rel="noopener noreferrer"
      class="text-orange-400 text-xs hover:text-white transition-colors"
    >
      thecure.com
    </a>
  </div>

  {items.length > 0 ? (
    <div class="space-y-3">
      {items.slice(0, 4).map((item) => (
        <a
          href={item.link}
          target="_blank"
          rel="noopener noreferrer"
          class="block p-2.5 bg-white/[0.03] border border-border-subtle hover:border-border-default hover:bg-white/[0.05] transition-all group"
        >
          <div class="flex items-start gap-3">
            {item.imageUrl && (
              <img
                src={item.imageUrl}
                alt=""
                class="size-12 object-cover shrink-0 border border-border-subtle"
                loading="lazy"
              />
            )}
            <div class="min-w-0">
              <h4 class="text-white text-sm font-medium line-clamp-2 group-hover:text-primary transition-colors">
                {item.title}
              </h4>
              <p class="text-text-muted text-xs mt-1">{item.formattedDate}</p>
            </div>
          </div>
        </a>
      ))}
    </div>
  ) : (
    <div>
      <p class="text-text-muted text-sm mb-2">Unable to load official news.</p>
      <a
        href="https://www.thecure.com"
        target="_blank"
        rel="noopener noreferrer"
        class="text-orange-400 text-xs hover:text-white transition-colors"
      >
        Visit thecure.com &rarr;
      </a>
    </div>
  )}
</div>
