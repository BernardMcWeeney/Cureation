---
import type { Poll } from '../../../types/directus';

interface Props {
  poll: Poll | null;
}

const { poll } = Astro.props;
const apiBase = import.meta.env.PUBLIC_DIRECTUS_URL || 'https://dash.cureation.net';
---

<div class="glass-tile p-5 h-full min-h-[180px]" data-poll-widget>
  <div class="flex items-center gap-2 mb-3">
    <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />
    </svg>
    <span class="text-text-muted text-xs font-medium uppercase tracking-[0.12em]">Community Poll</span>
  </div>

  {poll ? (
    <div data-poll-id={poll.id} data-api-base={apiBase}>
      <h3 class="text-white text-sm font-medium mb-3">{poll.question}</h3>

      {/* Voting state (shown before voting) */}
      <div class="poll-vote-options space-y-2">
        {poll.options.slice(0, 4).map((option) => (
          <button
            type="button"
            class="poll-option-btn w-full text-left px-3 py-2 border border-border-subtle hover:border-primary/40 hover:bg-primary/5 transition-all cursor-pointer"
            data-option-id={option.id}
          >
            <span class="text-text-secondary text-xs">{option.label}</span>
          </button>
        ))}
      </div>

      {/* Results state (shown after voting) */}
      <div class="poll-results hidden space-y-2">
        {poll.options.slice(0, 4).map((option) => (
          <div class="relative poll-result-bar" data-option-id={option.id}>
            <div
              class="absolute inset-0 bg-primary/15 transition-all duration-500 poll-bar-fill"
              style={`width: ${option.percentage || 0}%`}
            ></div>
            <div class="relative flex items-center justify-between px-3 py-2 border border-border-subtle">
              <span class="text-text-secondary text-xs truncate">{option.label}</span>
              <span class="text-text-muted text-xs shrink-0 ml-2 poll-pct">{option.percentage || 0}%</span>
            </div>
          </div>
        ))}
      </div>

      <p class="text-text-muted text-xs mt-3 poll-vote-count">
        {poll.totalVotes} vote{poll.totalVotes !== 1 ? 's' : ''}
      </p>
    </div>
  ) : (
    <div>
      <p class="text-text-muted text-sm mb-2">No active polls right now.</p>
      <a href="/community" class="text-primary text-xs hover:text-white transition-colors">
        Visit community &rarr;
      </a>
    </div>
  )}
</div>

<script>
  function initPollWidget() {
    document.querySelectorAll('[data-poll-widget]').forEach((widget) => {
      const pollContainer = widget.querySelector('[data-poll-id]') as HTMLElement;
      if (!pollContainer) return;

      const pollId = pollContainer.dataset.pollId;
      const apiBase = pollContainer.dataset.apiBase || 'https://dash.cureation.net';
      const voteSection = widget.querySelector('.poll-vote-options') as HTMLElement;
      const resultsSection = widget.querySelector('.poll-results') as HTMLElement;
      const voteCount = widget.querySelector('.poll-vote-count') as HTMLElement;
      const buttons = widget.querySelectorAll('.poll-option-btn');

      // Check if user has already voted
      const votedKey = `poll-voted-${pollId}`;
      if (localStorage.getItem(votedKey)) {
        voteSection?.classList.add('hidden');
        resultsSection?.classList.remove('hidden');
        return;
      }

      buttons.forEach((btn) => {
        btn.addEventListener('click', async () => {
          const optionId = (btn as HTMLElement).dataset.optionId;
          if (!optionId) return;

          // Disable all buttons
          buttons.forEach(b => {
            (b as HTMLButtonElement).disabled = true;
            b.classList.add('opacity-50');
          });

          // Highlight selected
          btn.classList.add('border-primary', 'bg-primary/10');
          btn.classList.remove('opacity-50');

          try {
            const res = await fetch(`${apiBase}/items/poll_options/${optionId}`, {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ vote_count: { _inc: 1 } }),
            });

            if (res.ok) {
              localStorage.setItem(votedKey, optionId);

              // Fetch updated poll data
              const pollRes = await fetch(`${apiBase}/items/poll_options?filter[poll][_eq]=${pollId}`);
              if (pollRes.ok) {
                const data = await pollRes.json();
                const options = data.data || [];
                const total = options.reduce((s: number, o: any) => s + (o.vote_count || 0), 0);

                // Update result bars
                options.forEach((opt: any) => {
                  const pct = total > 0 ? Math.round((opt.vote_count / total) * 100) : 0;
                  const bar = resultsSection?.querySelector(`[data-option-id="${opt.id}"]`);
                  if (bar) {
                    const fill = bar.querySelector('.poll-bar-fill') as HTMLElement;
                    const pctEl = bar.querySelector('.poll-pct');
                    if (fill) fill.style.width = `${pct}%`;
                    if (pctEl) pctEl.textContent = `${pct}%`;
                  }
                });

                if (voteCount) {
                  voteCount.textContent = `${total} vote${total !== 1 ? 's' : ''}`;
                }
              }

              // Switch to results view
              voteSection?.classList.add('hidden');
              resultsSection?.classList.remove('hidden');
            }
          } catch {
            // Re-enable on error
            buttons.forEach(b => {
              (b as HTMLButtonElement).disabled = false;
              b.classList.remove('opacity-50');
            });
            btn.classList.remove('border-primary', 'bg-primary/10');
          }
        });
      });
    });
  }

  initPollWidget();
  document.addEventListener('astro:page-load', initPollWidget);
</script>
