---
import type { SongWithAlbum } from '../../../types/directus';
import { generateSlug } from '../../../lib/directus';

interface Props {
  song: SongWithAlbum;
}

const { song } = Astro.props;
const songSlug = generateSlug(song.title);
---

<a href={`/lyrics/${songSlug}`} class="glass-tile group block overflow-hidden relative h-full min-h-[180px]">
  {/* Album art background */}
  {song.albumCover && (
    <>
      <img
        src={song.albumCover}
        alt=""
        class="absolute inset-0 w-full h-full object-cover opacity-30 transition-transform duration-700 group-hover:scale-110"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/70 to-black/40"></div>
    </>
  )}

  <div class="relative z-10 p-5 flex flex-col justify-between h-full">
    <div class="flex items-center gap-2 mb-3">
      <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 9l10.5-3m0 6.553v3.75a2.25 2.25 0 01-1.632 2.163l-1.32.377a1.803 1.803 0 11-.99-3.467l2.31-.66a2.25 2.25 0 001.632-2.163zm0 0V2.25L9 5.25v10.303m0 0v3.75a2.25 2.25 0 01-1.632 2.163l-1.32.377a1.803 1.803 0 01-.99-3.467l2.31-.66A2.25 2.25 0 009 15.553z" />
      </svg>
      <span class="text-text-muted text-xs font-medium uppercase tracking-[0.12em]">Song of the Day</span>
    </div>

    <div>
      <h3 class="font-heading text-xl md:text-2xl text-white mb-2 text-shadow-lg leading-tight group-hover:text-white transition-colors">
        {song.title}
      </h3>

      <div class="flex flex-wrap gap-1.5 mb-2">
        <span class="px-2 py-0.5 bg-black/50 backdrop-blur-sm border border-border-default text-xs text-text-secondary">
          {song.albumTitle}
        </span>
        {song.year && (
          <span class="px-2 py-0.5 bg-black/50 backdrop-blur-sm border border-border-default text-xs text-text-secondary">
            {song.year}
          </span>
        )}
      </div>

      <div class="flex items-center gap-1.5 text-primary text-xs opacity-80 group-hover:opacity-100 transition-all">
        <span>Read lyrics</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>
        </svg>
      </div>
    </div>
  </div>
</a>
