---
import type { NextConcert } from '../../../lib/directus';

interface Props {
  concert: NextConcert | null;
}

const { concert } = Astro.props;
---

<div class="glass-tile p-5 flex flex-col justify-between h-full min-h-[180px]">
  <div class="flex items-center gap-2 mb-3">
    <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
    </svg>
    <span class="text-text-muted text-xs font-medium uppercase tracking-[0.12em]">Next Concert</span>
  </div>

  {concert ? (
    <div>
      <div
        class="concert-countdown mb-3"
        data-concert-date={concert.date}
      >
        <div class="flex gap-3">
          <div class="text-center">
            <p class="text-2xl md:text-3xl font-display text-white countdown-days">--</p>
            <p class="text-text-muted text-xs uppercase tracking-wider">Days</p>
          </div>
          <div class="text-center">
            <p class="text-2xl md:text-3xl font-display text-white countdown-hours">--</p>
            <p class="text-text-muted text-xs uppercase tracking-wider">Hrs</p>
          </div>
          <div class="text-center">
            <p class="text-2xl md:text-3xl font-display text-white countdown-mins">--</p>
            <p class="text-text-muted text-xs uppercase tracking-wider">Min</p>
          </div>
        </div>
      </div>

      <div class="space-y-1">
        <p class="text-white text-sm font-medium">{concert.venue}</p>
        <p class="text-text-muted text-xs">{concert.city}{concert.country ? `, ${concert.country}` : ''}</p>
        {concert.tourName && (
          <p class="text-primary/80 text-xs">{concert.tourName}</p>
        )}
      </div>
    </div>
  ) : (
    <div>
      <p class="text-text-secondary text-sm mb-2">No upcoming concerts announced</p>
      <a href="/setlists" class="text-primary text-xs hover:text-white transition-colors">
        Browse past setlists &rarr;
      </a>
    </div>
  )}
</div>

<script>
  function initCountdowns() {
    document.querySelectorAll('.concert-countdown').forEach((el) => {
      const dateStr = (el as HTMLElement).dataset.concertDate;
      if (!dateStr) return;

      const target = new Date(dateStr + 'T20:00:00').getTime();
      const daysEl = el.querySelector('.countdown-days');
      const hoursEl = el.querySelector('.countdown-hours');
      const minsEl = el.querySelector('.countdown-mins');

      function update() {
        const now = Date.now();
        const diff = target - now;

        if (diff <= 0) {
          if (daysEl) daysEl.textContent = '0';
          if (hoursEl) hoursEl.textContent = '0';
          if (minsEl) minsEl.textContent = '0';
          return;
        }

        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));

        if (daysEl) daysEl.textContent = String(days);
        if (hoursEl) hoursEl.textContent = String(hours);
        if (minsEl) minsEl.textContent = String(mins);
      }

      update();
      setInterval(update, 60000);
    });
  }

  initCountdowns();
  document.addEventListener('astro:page-load', initCountdowns);
</script>
