---
import type { DidYouKnow } from '../../../types/directus';

interface Props {
  fact: DidYouKnow | null;
}

const { fact } = Astro.props;
---

<div class="glass-tile p-5 flex flex-col h-full min-h-[180px]">
  <div class="flex items-center gap-2 mb-3">
    <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-yellow-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 0 0 1.5-.189m-1.5.189a6.01 6.01 0 0 1-1.5-.189m3.75 7.478a12.06 12.06 0 0 1-4.5 0m3.75 2.383a14.406 14.406 0 0 1-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 1 0-7.517 0c.85.493 1.509 1.333 1.509 2.316V18" />
    </svg>
    <span class="text-text-muted text-xs font-medium uppercase tracking-[0.12em]">Did You Know?</span>
  </div>

  {fact ? (
    <div class="flex-1 flex flex-col">
      <p class="text-text-secondary text-sm leading-relaxed flex-1">
        {fact.fact}
      </p>
      {fact.category && (
        <div class="mt-3">
          <span class="px-2 py-0.5 bg-yellow-400/10 border border-yellow-400/20 text-yellow-400/80 text-xs">
            {fact.category}
          </span>
        </div>
      )}
    </div>
  ) : (
    <p class="text-text-muted text-sm italic">
      Check back later for a fun fact about The Cure.
    </p>
  )}
</div>
