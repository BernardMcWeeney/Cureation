---
import type { Album } from '../../../types/directus';

interface Props {
  album: Album | null;
}

const { album } = Astro.props;
---

{album ? (
  <a href={`/discography/${album.slug}`} class="glass-tile group block overflow-hidden relative h-full min-h-[180px]">
    {/* Album art background */}
    {album.coverImage && (
      <>
        <img
          src={album.coverImage}
          alt=""
          class="absolute inset-0 w-full h-full object-cover opacity-40 transition-transform duration-700 group-hover:scale-110"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/60 to-black/30"></div>
      </>
    )}

    <div class="relative z-10 p-5 flex flex-col justify-between h-full">
      <div class="flex items-center gap-2 mb-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v12M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z" />
        </svg>
        <span class="text-text-muted text-xs font-medium uppercase tracking-[0.12em]">Album of the Month</span>
      </div>

      <div>
        <h3 class="font-heading text-xl md:text-2xl text-white mb-1 text-shadow-lg leading-tight group-hover:text-white transition-colors">
          {album.title}
        </h3>

        <div class="flex items-center gap-2 mb-2">
          {album.year && (
            <span class="text-text-secondary text-xs">{album.year}</span>
          )}
          {album.trackCount && (
            <>
              <span class="text-white/20 text-xs">·</span>
              <span class="text-text-muted text-xs">{album.trackCount} tracks</span>
            </>
          )}
        </div>

        {album.description && (
          <p class="text-text-secondary text-xs leading-relaxed line-clamp-2 mb-3">
            {album.description}
          </p>
        )}

        <div class="flex items-center gap-1.5 text-primary text-xs opacity-80 group-hover:opacity-100 transition-all">
          <span>Explore album</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>
          </svg>
        </div>
      </div>
    </div>
  </a>
) : (
  <div class="glass-tile p-5 min-h-[180px]">
    <div class="flex items-center gap-2 mb-3">
      <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v12M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z" />
      </svg>
      <span class="text-text-muted text-xs font-medium uppercase tracking-[0.12em]">Album of the Month</span>
    </div>
    <p class="text-text-muted text-sm">Check back soon for this month's featured album.</p>
  </div>
)}
