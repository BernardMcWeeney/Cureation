---
import type { Photo } from '../../../types/directus';

interface Props {
  photo: Photo | null;
}

const { photo } = Astro.props;
---

{photo ? (
  <a href="/gallery" class="glass-tile group block overflow-hidden relative h-full min-h-[180px]">
    <img
      src={photo.imageUrl}
      alt={photo.title || 'Photo of the Day'}
      class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>

    <div class="relative z-10 flex flex-col justify-between h-full p-5">
      <div class="flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909M18 3.75H6A2.25 2.25 0 0 0 3.75 6v12A2.25 2.25 0 0 0 6 20.25h12A2.25 2.25 0 0 0 20.25 18V6A2.25 2.25 0 0 0 18 3.75ZM18 8.25a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z" />
        </svg>
        <span class="text-text-muted text-xs font-medium uppercase tracking-[0.12em]">Photo of the Day</span>
      </div>

      <div class="mt-auto">
        {photo.title && (
          <p class="text-white text-sm text-shadow line-clamp-2 mb-1">{photo.title}</p>
        )}
        {photo.tour && (
          <p class="text-text-muted text-xs">{photo.tour}</p>
        )}
      </div>
    </div>
  </a>
) : (
  <div class="glass-tile p-5 min-h-[180px]">
    <div class="flex items-center gap-2 mb-3">
      <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909M18 3.75H6A2.25 2.25 0 0 0 3.75 6v12A2.25 2.25 0 0 0 6 20.25h12A2.25 2.25 0 0 0 20.25 18V6A2.25 2.25 0 0 0 18 3.75Z" />
      </svg>
      <span class="text-text-muted text-xs font-medium uppercase tracking-[0.12em]">Photo of the Day</span>
    </div>
    <p class="text-text-muted text-sm">No photo available today.</p>
  </div>
)}
