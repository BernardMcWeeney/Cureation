---
import siteConfig from '../../config/site.config';
---

<section class="py-16">
  <div class="responsive-container">
    <div class="flex flex-col lg:flex-row gap-6">
      <!-- About Card -->
      <div class="flex-1">
        <div class="glass-tile p-8 h-full gothic-corners">
          <div class="flex items-center gap-3 mb-6">
            <div class="p-2 rounded-sm bg-primary/20 backdrop-blur-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h2 class="font-heading text-2xl text-white">About Cureation</h2>
          </div>

          <p class="text-white/65 mb-4 leading-relaxed">
            {siteConfig.description}
          </p>
          <p class="text-white/55 mb-6 leading-relaxed">
            Our mission is to preserve and celebrate the legacy of The Cure through comprehensive documentation, community engagement, and a passion for their enduring music.
          </p>

          <div class="flex flex-wrap gap-3">
            <a
              href="/about"
              class="px-4 py-2 rounded-sm bg-white/[0.06] border border-white/15 text-white hover:border-primary/30 hover:text-primary transition-all text-sm"
            >
              Learn More
            </a>
            <a
              href="/about#contribute"
              class="px-4 py-2 rounded-sm bg-white/[0.06] border border-white/15 text-white hover:border-primary/30 hover:text-primary transition-all text-sm"
            >
              Contribute
            </a>
          </div>
        </div>
      </div>

      <!-- Support Card -->
      <div class="lg:w-80">
        <div class="glass-tile p-8 h-full gothic-corners">
          <div class="flex items-center gap-3 mb-6">
            <div class="p-2 rounded-sm bg-pink-500/20 backdrop-blur-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-6 text-pink-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
            </div>
            <h2 class="font-heading text-xl text-white">Support Us</h2>
          </div>

          <p class="text-white/55 mb-6 text-sm leading-relaxed">
            Help us keep the archive growing. Your support helps maintain servers, add new features, and expand our collection.
          </p>

          <a
            href="/support"
            class="block w-full px-4 py-3 rounded-sm bg-gradient-to-r from-pink-500/20 to-primary/20 border border-pink-500/30 text-white text-center font-medium hover:from-pink-500/30 hover:to-primary/30 transition-all"
          >
            Support the Project
          </a>

          <div class="mt-6 pt-6 border-t border-white/[0.06]">
            <p class="text-white/35 text-xs text-center">
              100% of contributions go to project costs
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
