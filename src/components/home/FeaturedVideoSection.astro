---
import { getFeaturedVideos } from '../../lib/directus';

let video = null;
try {
  const videos = await getFeaturedVideos();
  video = videos[0] || null;
} catch {}
---

{video && (
  <section class="py-16 relative overflow-hidden">
    <div class="responsive-container relative z-10">
      <div class="flex items-center justify-between mb-8">
        <div class="flex items-center gap-3">
          <span class="px-3 py-1 text-[11px] uppercase tracking-[0.16em] text-primary bg-primary/10 border border-primary/[0.35]">
            Featured Video
          </span>
          <div class="divider-gradient flex-1"></div>
        </div>
        <a href="/videos" class="text-sm text-white/50 hover:text-primary transition-colors flex items-center gap-1">
          All videos
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </a>
      </div>

      <div class="glass-panel overflow-hidden">
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-0">
          <!-- Video Embed -->
          <div class="lg:col-span-3 relative aspect-video">
            {video.embedId ? (
              <iframe
                src={`https://www.youtube.com/embed/${video.embedId}`}
                class="absolute inset-0 w-full h-full"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                loading="lazy"
              ></iframe>
            ) : video.thumbnailUrl ? (
              <a href={video.videoUrl} target="_blank" rel="noopener noreferrer" class="block relative w-full h-full group">
                <img src={video.thumbnailUrl} alt={video.title} class="w-full h-full object-cover" />
                <div class="absolute inset-0 flex items-center justify-center bg-black/40 group-hover:bg-black/30 transition-colors">
                  <svg class="size-16 text-white drop-shadow-lg" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                </div>
              </a>
            ) : null}
          </div>

          <!-- Video Info -->
          <div class="lg:col-span-2 p-6 md:p-8 flex flex-col">
            <div class="flex items-center gap-2 mb-3">
              <span class="px-2 py-0.5 text-[10px] uppercase tracking-wider bg-white/[0.06] border border-white/10 text-white/50 rounded-sm">
                {video.type.replace('_', ' ')}
              </span>
              {video.formattedDate && (
                <span class="text-xs text-white/40">{video.formattedDate}</span>
              )}
            </div>

            <h3 class="font-heading text-xl text-white mb-3">{video.title}</h3>

            {video.description && (
              <p class="text-white/60 text-sm leading-relaxed flex-1 line-clamp-4">{video.description}</p>
            )}

            {video.director && (
              <p class="text-white/40 text-xs mt-3">Directed by {video.director}</p>
            )}

            <div class="mt-4 pt-4 border-t border-white/[0.06]">
              <a
                href="/videos"
                class="inline-flex items-center gap-2 text-sm text-primary hover:text-primary/80 transition-colors"
              >
                Browse all videos
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .line-clamp-4 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
  }
</style>
