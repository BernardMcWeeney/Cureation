---
import type { NewsPost, SongWithAlbum, Photo } from '../../types/directus';
import type { Setlist } from '../../lib/directus';
import {
  getMockSongOfTheDay,
  getMockLatestSetlist,
  getMockPhotoOfTheDay,
  mockSongsWithAlbums,
  mockSetlists,
  mockPhotos,
  type MockSetlist
} from '../../lib/mockData';

interface Props {
  songOfTheDay: SongWithAlbum | null;
  latestSetlist: Setlist | MockSetlist | null;
  photoOfTheDay: Photo | null;
}

const {
  songOfTheDay: propSong,
  latestSetlist: propSetlist,
  photoOfTheDay: propPhoto
} = Astro.props;

// Always ensure we have data to display
const songOfTheDay: SongWithAlbum = propSong || getMockSongOfTheDay() || mockSongsWithAlbums[0];
const latestSetlist = propSetlist || getMockLatestSetlist() || mockSetlists[0];
const photoOfTheDay: Photo = propPhoto || getMockPhotoOfTheDay() || mockPhotos[0];

// Get first line of lyrics for preview
const lyricsSnippet = songOfTheDay?.lyrics?.[0]?.content?.split('\n')[0] || '';
---

<section class="py-16">
  <div class="responsive-container">
    <div class="flex items-center gap-4 mb-8">
      <h2 class="font-heading text-2xl text-primary">Daily Highlights</h2>
      <div class="flex-1 h-px bg-gradient-to-r from-primary/30 to-transparent"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Song of the Day -->
      <a
        href={`/lyrics/${songOfTheDay.albumSlug}/${songOfTheDay.title.toLowerCase().replace(/[^\w\s]/gi, '').replace(/\s+/g, '-')}`}
        class="group"
      >
        <div class="glass-panel h-full p-6 flex flex-col">
          <div class="flex items-center gap-3 mb-4">
            <div class="p-2 rounded-lg bg-primary/20">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v12M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
              </svg>
            </div>
            <span class="text-white/50 text-sm font-medium uppercase tracking-wider">Song of the Day</span>
          </div>

          <h3 class="font-heading text-xl text-white mb-1 group-hover:text-primary transition-colors duration-300 line-clamp-1">
            {songOfTheDay.title}
          </h3>
          <p class="text-white/60 text-sm mb-3">
            {songOfTheDay.albumTitle}
          </p>
          {lyricsSnippet && (
            <p class="text-white/40 text-sm italic line-clamp-2 flex-1">
              "{lyricsSnippet}..."
            </p>
          )}

          <div class="flex items-center gap-2 mt-4 text-primary text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            <span>Read lyrics</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </div>
        </div>
      </a>

      <!-- Latest Setlist -->
      <a
        href={`/setlists/${latestSetlist.slug}`}
        class="group"
      >
        <div class="glass-panel h-full p-6 flex flex-col">
          <div class="flex items-center gap-3 mb-4">
            <div class="p-2 rounded-lg bg-accent/20">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <span class="text-white/50 text-sm font-medium uppercase tracking-wider">Latest Setlist</span>
          </div>

          <h3 class="font-heading text-xl text-white mb-1 group-hover:text-accent transition-colors duration-300 line-clamp-1">
            {latestSetlist.venue}
          </h3>
          <p class="text-white/60 text-sm mb-1">
            {latestSetlist.location}
          </p>
          <p class="text-white/40 text-sm flex-1">
            <time datetime={latestSetlist.date}>{latestSetlist.formattedDate}</time>
          </p>
          <p class="text-white/50 text-sm mt-2">
            {latestSetlist.songCount} songs
          </p>

          <div class="flex items-center gap-2 mt-4 text-accent text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            <span>View setlist</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </div>
        </div>
      </a>

      <!-- Photo Preview -->
      <a
        href={`/gallery/photo/${photoOfTheDay.id}`}
        class="group"
      >
        <div class="glass-panel h-full overflow-hidden flex flex-col">
          <div class="relative aspect-[4/3] overflow-hidden">
            <img
              src={photoOfTheDay.imageUrl}
              alt={photoOfTheDay.title}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
            <div class="absolute top-3 left-3">
              <div class="flex items-center gap-2 px-2 py-1 rounded bg-black/50 backdrop-blur-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-pink-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <span class="text-white/80 text-xs uppercase tracking-wider">Photo of the Day</span>
              </div>
            </div>
          </div>
          <div class="p-4 flex-1 flex flex-col">
            <h3 class="font-heading text-lg text-white group-hover:text-pink-400 transition-colors line-clamp-1">
              {photoOfTheDay.title}
            </h3>
            {photoOfTheDay.formattedDate && (
              <p class="text-white/50 text-sm mt-1">{photoOfTheDay.formattedDate}</p>
            )}
          </div>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  .line-clamp-1 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
  }
  .line-clamp-2 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
</style>
