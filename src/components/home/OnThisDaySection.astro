---
import GothicCobweb from '../GothicCobweb.astro';
import { getSetlistsWithSongs, getTimelineEvents } from '../../lib/directus';

const today = new Date();
const currentMonth = today.getMonth() + 1;
const currentDay = today.getDate();
const dateString = today.toLocaleDateString('en-US', { month: 'long', day: 'numeric' });

const [setlists, events] = await Promise.all([
  getSetlistsWithSongs(),
  getTimelineEvents(),
]);

const uniqueShows = new Map<string, (typeof setlists)[number]>();
setlists
  .filter((setlist) => {
    if (!setlist.date) return false;
    const eventDate = new Date(setlist.date);
    return eventDate.getMonth() + 1 === currentMonth && eventDate.getDate() === currentDay;
  })
  .forEach((setlist) => {
    const key = `${setlist.year}-${setlist.venue}-${setlist.city}-${setlist.country}`.toLowerCase();
    const existing = uniqueShows.get(key);
    if (!existing || (setlist.songCount || 0) > (existing.songCount || 0)) {
      uniqueShows.set(key, setlist);
    }
  });

const todaySetlists = Array.from(uniqueShows.values()).sort((a, b) => b.year - a.year);

const uniqueEvents = new Map<string, (typeof events)[number]>();
events
  .filter((event) => {
    if (!event.date) return false;
    const eventDate = new Date(event.date);
    return eventDate.getMonth() + 1 === currentMonth && eventDate.getDate() === currentDay;
  })
  .forEach((event) => {
    const key = `${event.year}-${event.title}`.toLowerCase();
    if (!uniqueEvents.has(key)) uniqueEvents.set(key, event);
  });

const todayEvents = Array.from(uniqueEvents.values()).sort((a, b) => b.year - a.year);
const oldestYear = todaySetlists.length > 0 ? Math.min(...todaySetlists.map((setlist) => setlist.year)) : null;
const newestYear = todaySetlists.length > 0 ? Math.max(...todaySetlists.map((setlist) => setlist.year)) : null;
const yearSpan = oldestYear && newestYear
  ? oldestYear === newestYear
    ? `${oldestYear}`
    : `${oldestYear} - ${newestYear}`
  : 'No range yet';

const totalSongsLogged = todaySetlists.reduce(
  (total, setlist) => total + (setlist.songCount || setlist.songs.length),
  0
);

const songsOnDateMap = new Map<string, number>();
todaySetlists.forEach((setlist) => {
  setlist.songs.forEach((song) => {
    const title = song.title?.trim();
    if (!title) return;
    songsOnDateMap.set(title, (songsOnDateMap.get(title) || 0) + 1);
  });
});

const topSongsOnDate = Array.from(songsOnDateMap.entries())
  .map(([title, plays]) => ({ title, plays }))
  .sort((a, b) => b.plays - a.plays || a.title.localeCompare(b.title))
  .slice(0, 5);

const hasEntries = todaySetlists.length > 0 || todayEvents.length > 0;
---

<section class="py-16">
  <div class="responsive-container">
    <div class="gothic-heading mb-3">
      <h2 class="font-heading text-xl md:text-2xl text-primary tracking-wider">On This Day</h2>
    </div>
    <p class="text-white/55 text-sm mb-8 max-w-3xl">
      Directus-powered archive snapshots from {dateString}: documented shows, milestones, and recurring songs from this date.
    </p>

    <a href="/on-this-day" class="block group today-card-link">
      <div class="glass-panel today-card p-6 md:p-8 relative overflow-hidden bg-cobweb">
        <GothicCobweb position="top-right" size="md" opacity={0.08} />

        <div class="grid grid-cols-1 xl:grid-cols-[260px_1fr_360px] gap-4 md:gap-5">
          <div class="glass-inset p-5">
            <div class="flex items-center gap-3 mb-4">
              <div class="p-2 rounded-sm bg-primary/20">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
              <p class="text-white/70 text-sm uppercase tracking-[0.18em]">{dateString}</p>
            </div>

            <div class="space-y-3 text-sm">
              <div class="flex items-center justify-between border-b border-white/10 pb-2">
                <span class="text-white/55">Shows</span>
                <span class="text-primary font-semibold">{todaySetlists.length}</span>
              </div>
              <div class="flex items-center justify-between border-b border-white/10 pb-2">
                <span class="text-white/55">Milestones</span>
                <span class="text-purple-300 font-semibold">{todayEvents.length}</span>
              </div>
              <div class="flex items-center justify-between border-b border-white/10 pb-2">
                <span class="text-white/55">Songs logged</span>
                <span class="text-white/[0.85] font-medium">{totalSongsLogged}</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-white/55">Year span</span>
                <span class="text-white/80 font-medium">{yearSpan}</span>
              </div>
            </div>

          </div>

          <div class="glass-stat p-5 lg:p-6">
            <p class="text-white/45 text-xs uppercase tracking-[0.18em] mb-4">Shows</p>
            {todaySetlists.length > 0 ? (
              <div class="space-y-3">
                {todaySetlists.slice(0, 5).map((setlist) => (
                  <div class="flex items-start justify-between gap-4 pb-3 border-b border-white/[0.08] last:border-b-0 last:pb-0">
                    <div>
                      <p class="text-white text-base leading-tight">{setlist.venue}</p>
                      <p class="text-white/55 text-sm leading-tight">{setlist.city}, {setlist.country}</p>
                      <p class="text-white/40 text-xs mt-1">{setlist.songCount || setlist.songs.length} songs</p>
                    </div>
                    <span class="text-primary font-semibold text-2xl leading-none shrink-0">{setlist.year}</span>
                  </div>
                ))}
              </div>
            ) : (
              <p class="text-white/50 text-sm">No recorded shows for this date yet.</p>
            )}
          </div>

          <div class="glass-stat p-5 lg:p-6">
            <p class="text-white/45 text-xs uppercase tracking-[0.18em] mb-4">
              {todayEvents.length > 0 ? 'Milestones' : 'Most Played Songs'}
            </p>
            {todayEvents.length > 0 ? (
              <div class="space-y-3">
                {todayEvents.slice(0, 5).map((event) => (
                  <div class="flex items-start justify-between gap-4 pb-3 border-b border-white/[0.08] last:border-b-0 last:pb-0">
                    <div>
                      <p class="text-white text-sm leading-tight">{event.title}</p>
                      {event.type && (
                        <p class="text-white/45 text-xs capitalize leading-tight mt-1">{event.type.replace('_', ' ')}</p>
                      )}
                    </div>
                    <span class="text-purple-300 font-semibold text-lg leading-none shrink-0">{event.year}</span>
                  </div>
                ))}
              </div>
            ) : topSongsOnDate.length > 0 ? (
              <div class="space-y-3">
                {topSongsOnDate.map((song) => (
                  <div class="flex items-center justify-between gap-3 pb-3 border-b border-white/[0.08] last:border-b-0 last:pb-0">
                    <p class="text-white text-sm leading-tight">{song.title}</p>
                    <span class="text-primary font-semibold text-sm shrink-0">{song.plays}x</span>
                  </div>
                ))}
              </div>
            ) : (
              <p class="text-white/50 text-sm">No milestone or song-play history logged yet for this date.</p>
            )}
          </div>
        </div>

        <div class="flex items-center gap-2 mt-5 text-primary text-sm opacity-0 group-hover:opacity-100 transition-opacity">
          <span>{hasEntries ? 'Open full On This Day archive' : 'Open timeline archive and add entries'}</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </div>
      </div>
    </a>
  </div>
</section>
