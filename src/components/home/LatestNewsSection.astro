---
import type { NewsPost } from '../../types/directus';

import { getMockFeaturedNews, mockNewsPosts } from '../../lib/mockData';

interface Props {
  post: NewsPost | null;
}

const { post: propPost } = Astro.props;
const post: NewsPost = propPost || getMockFeaturedNews() || mockNewsPosts[0];

const categoryColors: Record<string, string> = {
  news: 'bg-blue-500/15 text-blue-300 border-blue-500/30',
  reviews: 'bg-green-500/15 text-green-300 border-green-500/30',
  interviews: 'bg-pink-500/15 text-pink-300 border-pink-500/30',
  rumors: 'bg-amber-500/15 text-amber-300 border-amber-500/30',
  editorials: 'bg-purple-500/15 text-purple-300 border-purple-500/30'
};
---

<section class="py-12">
  <div class="responsive-container">
    <div class="gothic-heading mb-6">
      <h2 class="font-heading text-xl md:text-2xl text-primary tracking-wider">Latest News</h2>
    </div>

    <a href={`/news/${post.slug}`} class="group block">
      <div class="glass-panel overflow-hidden relative bg-cobweb">
        <div class="absolute -top-24 -left-24 w-52 h-52 rounded-full bg-primary/10 blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-20 -right-20 w-44 h-44 rounded-full bg-accent/[0.08] blur-2xl pointer-events-none"></div>
        <div class="flex flex-col md:flex-row relative z-10">
          {/* Image */}
          <div class="md:w-2/5 relative aspect-[16/9] md:aspect-auto overflow-hidden">
            {post.featuredImage ? (
              <img
                src={post.featuredImage}
                alt=""
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
              />
            ) : (
              <div class="w-full h-full min-h-[200px] bg-gradient-to-br from-primary/15 via-black to-accent/10"></div>
            )}
            <div class="absolute inset-0 bg-gradient-to-r from-transparent to-black/70"></div>

            {/* Category badge */}
            <div class={`absolute top-4 left-4 px-3 py-1 rounded-sm text-xs font-medium border backdrop-blur-sm ${categoryColors[post.category] || 'bg-primary/15 text-primary border-primary/30'}`}>
              {post.category.charAt(0).toUpperCase() + post.category.slice(1)}
            </div>
          </div>

          {/* Content */}
          <div class="md:w-3/5 p-6 md:p-8 flex flex-col justify-center relative z-10">
            <h3 class="font-heading text-2xl md:text-3xl text-white mb-3 group-hover:text-primary transition-colors duration-300 text-shadow">
              {post.title}
            </h3>

            <p class="text-white/70 mb-4 line-clamp-2 text-shadow">
              {post.excerpt}
            </p>

            <div class="flex items-center justify-between mt-auto">
              <div class="flex items-center gap-3 text-white/50 text-sm">
                <time datetime={post.publishedDate}>{post.formattedDate}</time>
                <span class="w-1 h-1 bg-white/20 rotate-45" aria-hidden="true"></span>
                <span>{post.readingTime} min read</span>
              </div>

              <div class="flex items-center gap-2 text-primary opacity-0 group-hover:opacity-100 translate-x-2 group-hover:translate-x-0 transition-all duration-300">
                <span class="text-sm font-medium">Read More</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14"></path>
                  <path d="m12 5 7 7-7 7"></path>
                </svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    </a>
  </div>
</section>

<style>
  .line-clamp-2 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
</style>
