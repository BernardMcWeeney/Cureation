---
import type { NewsPost, SongWithAlbum, Album } from '../../types/directus';
import WelcomeSlide from './slides/WelcomeSlide.astro';
import NewsSlide from './slides/NewsSlide.astro';
import SongSlide from './slides/SongSlide.astro';
import OnThisDaySlide from './slides/OnThisDaySlide.astro';
import AlbumSlide from './slides/AlbumSlide.astro';

interface NavTile {
  title: string;
  path: string;
  icon: string;
}

interface ShowEntry {
  venue: string;
  city: string;
  country: string;
  year: number;
}

interface SlideDefinition {
  id: string;
  type: 'welcome' | 'news' | 'song' | 'on-this-day' | 'album';
  backgroundImage?: string;
  backgroundGradient?: string;
  label: string;
}

interface Props {
  slides: SlideDefinition[];
  welcomeData: { navigationTiles: NavTile[] };
  newsData?: { post: NewsPost };
  songData?: { song: SongWithAlbum };
  onThisDayData?: {
    dateString: string;
    showCount: number;
    milestoneCount: number;
    shows: ShowEntry[];
    hasEntries: boolean;
    fallbackFact?: string;
  };
  albumData?: { album: Album; albumTypeLabel: string };
}

const { slides, welcomeData, newsData, songData, onThisDayData, albumData } = Astro.props;
const slideCount = slides.length;
---

<div
  class="hero-slider-wrapper relative"
  role="region"
  aria-roledescription="carousel"
  aria-label="Featured content"
>
  <!-- Slides -->
  <div class="hero-slider" tabindex="0">
    {slides.map((slide, index) => (
      <div
        class="hero-slide"
        id={`slide-${slide.id}`}
        role="group"
        aria-roledescription="slide"
        aria-label={`Slide ${index + 1} of ${slideCount}: ${slide.label}`}
      >
        {/* Background image */}
        {slide.backgroundImage ? (
          <img
            src={slide.backgroundImage}
            alt=""
            class="hero-slide-bg"
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : undefined}
          />
        ) : (
          <div
            class="hero-slide-bg"
            style={slide.backgroundGradient ? `background: ${slide.backgroundGradient}` : 'background: linear-gradient(135deg, rgba(var(--color-primary-rgb), 0.15), #060608)'}
          />
        )}

        {/* Dark overlay */}
        <div class="hero-slide-overlay"></div>

        {/* Slide content */}
        <div class="hero-slide-content">
          {slide.type === 'welcome' && (
            <WelcomeSlide navigationTiles={welcomeData.navigationTiles} />
          )}
          {slide.type === 'news' && newsData && (
            <NewsSlide post={newsData.post} />
          )}
          {slide.type === 'song' && songData && (
            <SongSlide song={songData.song} />
          )}
          {slide.type === 'on-this-day' && onThisDayData && (
            <OnThisDaySlide
              dateString={onThisDayData.dateString}
              showCount={onThisDayData.showCount}
              milestoneCount={onThisDayData.milestoneCount}
              shows={onThisDayData.shows}
              hasEntries={onThisDayData.hasEntries}
              fallbackFact={onThisDayData.fallbackFact}
            />
          )}
          {slide.type === 'album' && albumData && (
            <AlbumSlide album={albumData.album} albumTypeLabel={albumData.albumTypeLabel} />
          )}
        </div>
      </div>
    ))}
  </div>

  {/* Controls: dots + pause */}
  <div class="hero-controls">
    <div class="hero-dots" role="tablist" aria-label="Slide navigation">
      {slides.map((slide, index) => (
        <button
          role="tab"
          aria-selected={index === 0 ? 'true' : 'false'}
          aria-controls={`slide-${slide.id}`}
          aria-label={`Go to slide ${index + 1}: ${slide.label}`}
          class:list={['hero-dot', { active: index === 0 }]}
          data-slide-index={index}
        />
      ))}
    </div>

    <button
      class="hero-pause-btn"
      aria-label="Pause slideshow"
      data-playing="true"
    >
      <svg class="pause-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <rect x="6" y="4" width="4" height="16" rx="1" />
        <rect x="14" y="4" width="4" height="16" rx="1" />
      </svg>
      <svg class="play-icon hidden" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <polygon points="6,4 20,12 6,20" />
      </svg>
    </button>
  </div>

  {/* Live region for screen readers */}
  <div class="sr-only" aria-live="polite" aria-atomic="true" id="slider-live-region"></div>
</div>

<style>
  .hero-slider-wrapper {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
  }

  .hero-slider {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    height: 100%;
    scrollbar-width: none;
    outline: none;
  }

  .hero-slider::-webkit-scrollbar {
    display: none;
  }

  .hero-slide {
    flex: 0 0 100%;
    width: 100%;
    scroll-snap-align: start;
    position: relative;
    overflow: hidden;
  }

  .hero-slide-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }

  .hero-slide-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0.1) 40%, rgba(0, 0, 0, 0.7) 100%),
      radial-gradient(ellipse at center, transparent 30%, rgba(0, 0, 0, 0.45) 100%);
    z-index: 1;
  }

  .hero-slide-content {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
  }

  /* Controls */
  .hero-controls {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .hero-dots {
    display: flex;
    gap: 0;
    align-items: center;
  }

  .hero-dot {
    position: relative;
    width: 44px;
    height: 44px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-dot::after {
    content: '';
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: all 0.3s ease;
  }

  .hero-dot.active::after {
    background: var(--color-primary);
    border-color: var(--color-primary);
    box-shadow: 0 0 12px rgba(var(--color-primary-rgb), 0.4);
  }

  .hero-pause-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: rgba(255, 255, 255, 0.6);
    background: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .hero-pause-btn:hover {
    color: white;
    background: rgba(0, 0, 0, 0.5);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .hero-pause-btn .hidden {
    display: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .hero-slider {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  function initHeroSlider() {
    const wrapper = document.querySelector('.hero-slider-wrapper');
    if (!wrapper) return;

    const slider = wrapper.querySelector('.hero-slider') as HTMLElement;
    const dots = wrapper.querySelectorAll('.hero-dot');
    const pauseBtn = wrapper.querySelector('.hero-pause-btn') as HTMLButtonElement;
    const pauseIcon = pauseBtn?.querySelector('.pause-icon') as HTMLElement;
    const playIcon = pauseBtn?.querySelector('.play-icon') as HTMLElement;
    const liveRegion = document.getElementById('slider-live-region');
    const slides = wrapper.querySelectorAll('.hero-slide');

    if (!slider || slides.length === 0) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ADVANCE_INTERVAL = 8000;
    const RESUME_DELAY = 15000;

    let currentIndex = 0;
    let isPlaying = !prefersReducedMotion;
    let autoAdvanceTimer: ReturnType<typeof setInterval> | null = null;
    let resumeTimer: ReturnType<typeof setTimeout> | null = null;

    function goToSlide(index: number) {
      const clampedIndex = Math.max(0, Math.min(index, slides.length - 1));
      slider.scrollTo({ left: clampedIndex * slider.clientWidth, behavior: prefersReducedMotion ? 'auto' : 'smooth' });
    }

    function updateActiveDot(index: number) {
      dots.forEach((dot, i) => {
        const isActive = i === index;
        dot.classList.toggle('active', isActive);
        dot.setAttribute('aria-selected', String(isActive));
      });
      currentIndex = index;

      if (liveRegion) {
        const slide = slides[index];
        const label = slide?.getAttribute('aria-label') || `Slide ${index + 1}`;
        liveRegion.textContent = label;
      }
    }

    function startAutoAdvance() {
      stopAutoAdvance();
      if (!isPlaying) return;
      autoAdvanceTimer = setInterval(() => {
        const nextIndex = (currentIndex + 1) % slides.length;
        goToSlide(nextIndex);
      }, ADVANCE_INTERVAL);
    }

    function stopAutoAdvance() {
      if (autoAdvanceTimer) {
        clearInterval(autoAdvanceTimer);
        autoAdvanceTimer = null;
      }
    }

    function pauseAndResumeLater() {
      stopAutoAdvance();
      if (resumeTimer) clearTimeout(resumeTimer);
      if (isPlaying) {
        resumeTimer = setTimeout(() => {
          startAutoAdvance();
        }, RESUME_DELAY);
      }
    }

    function togglePlayPause() {
      isPlaying = !isPlaying;
      if (pauseBtn) pauseBtn.dataset.playing = String(isPlaying);
      if (pauseBtn) pauseBtn.setAttribute('aria-label', isPlaying ? 'Pause slideshow' : 'Play slideshow');
      if (pauseIcon) pauseIcon.classList.toggle('hidden', !isPlaying);
      if (playIcon) playIcon.classList.toggle('hidden', isPlaying);

      if (isPlaying) {
        startAutoAdvance();
      } else {
        stopAutoAdvance();
        if (resumeTimer) { clearTimeout(resumeTimer); resumeTimer = null; }
      }
    }

    // IntersectionObserver to track which slide is visible
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const index = Array.from(slides).indexOf(entry.target as Element);
            if (index >= 0) updateActiveDot(index);
          }
        });
      },
      { root: slider, threshold: 0.5 }
    );
    slides.forEach((slide) => observer.observe(slide));

    // Dot clicks
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const index = parseInt((dot as HTMLElement).dataset.slideIndex || '0', 10);
        goToSlide(index);
        pauseAndResumeLater();
      });
    });

    // Pause button
    pauseBtn?.addEventListener('click', togglePlayPause);

    // Touch interaction pauses auto-advance temporarily
    slider.addEventListener('touchstart', pauseAndResumeLater, { passive: true });
    slider.addEventListener('mousedown', pauseAndResumeLater);

    // Keyboard navigation
    slider.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        goToSlide(currentIndex - 1);
        pauseAndResumeLater();
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        goToSlide((currentIndex + 1) % slides.length);
        pauseAndResumeLater();
      }
    });

    // Start
    if (isPlaying) startAutoAdvance();
  }

  initHeroSlider();
  document.addEventListener('astro:page-load', initHeroSlider);
</script>
