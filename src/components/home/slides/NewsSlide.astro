---
import type { NewsPost } from '../../../types/directus';
import { getCategoryColor } from '../../../config/categories.config';

interface Props {
  post: NewsPost;
}

const { post } = Astro.props;
---

<a href={`/news/${post.slug}`} class="flex flex-col items-start justify-end h-full w-full p-8 md:p-12 group">
  <div class="max-w-2xl">
    <div class="flex items-center gap-3 mb-4">
      <span class="text-text-muted text-xs font-medium uppercase tracking-[0.15em]">Latest News</span>
      <span class={`px-2.5 py-0.5 text-xs font-medium border backdrop-blur-sm ${getCategoryColor(post.category)}`}>
        {post.category.charAt(0).toUpperCase() + post.category.slice(1)}
      </span>
    </div>

    <h2 class="font-heading text-3xl md:text-4xl lg:text-5xl text-white mb-4 text-shadow-lg leading-tight">
      {post.title}
    </h2>

    <p class="text-text-secondary text-base md:text-lg mb-6 line-clamp-2 text-shadow max-w-xl">
      {post.excerpt}
    </p>

    <div class="flex items-center gap-4">
      <div class="flex items-center gap-3 text-text-muted text-sm">
        <time datetime={post.publishedDate}>{post.formattedDate}</time>
        <span class="w-1 h-1 bg-white/20 rotate-45" aria-hidden="true"></span>
        <span>{post.readingTime} min read</span>
      </div>

      <div class="flex items-center gap-2 text-primary opacity-80 group-hover:opacity-100 transition-all duration-300">
        <span class="text-sm font-medium">Read More</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>
        </svg>
      </div>
    </div>
  </div>
</a>
