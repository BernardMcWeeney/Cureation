---
import type { SongWithAlbum } from '../../../types/directus';
import { generateSlug } from '../../../lib/directus';

interface Props {
  song: SongWithAlbum;
}

const { song } = Astro.props;
const songSlug = generateSlug(song.title);
---

<a href={`/lyrics/${songSlug}`} class="flex flex-col items-start justify-end h-full w-full px-6 py-5 md:px-16 md:py-8 lg:px-24 group">
  <div class="max-w-xl">
    <span class="text-text-muted text-xs font-medium uppercase tracking-[0.15em] mb-2 block">Song of the Day</span>

    <h2 class="font-heading text-3xl md:text-4xl lg:text-5xl text-white mb-2 text-shadow-lg leading-tight">
      {song.title}
    </h2>

    <div class="flex flex-wrap gap-2 mb-3">
      <span class="px-2.5 py-0.5 bg-black/40 backdrop-blur-sm border border-border-default text-xs text-text-secondary text-shadow">
        {song.albumTitle}
      </span>
      {song.year && (
        <span class="px-2.5 py-0.5 bg-black/40 backdrop-blur-sm border border-border-default text-xs text-text-secondary text-shadow">
          {song.year}
        </span>
      )}
    </div>

    <div class="flex items-center gap-2 text-primary text-xs opacity-80 group-hover:opacity-100 transition-all duration-300">
      <span>Read lyrics</span>
      <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>
      </svg>
    </div>
  </div>
</a>
