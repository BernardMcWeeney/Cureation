---
import { getFeaturedPoll } from '../../lib/directus';

let poll = null;
try {
  poll = await getFeaturedPoll();
} catch {}

const hasImages = poll?.options?.some(o => o.imageUrl);
---

{poll && (
  <div class="glass-panel p-6 md:p-8 relative overflow-hidden">
    <div class="absolute -top-20 -left-20 w-48 h-48 rounded-full bg-primary/8 blur-3xl pointer-events-none"></div>

    <div class="flex items-center gap-3 mb-2">
      <span class="px-3 py-1 text-[11px] uppercase tracking-[0.16em] text-primary bg-primary/10 border border-primary/[0.35]">
        Fan Poll
      </span>
      <div class="divider-gradient flex-1"></div>
    </div>

    <h3 class="font-heading text-xl md:text-2xl text-white mb-6 text-center">{poll.question}</h3>

    {/* Album cover grid layout */}
    {hasImages ? (
      <div class="poll-options" data-poll-id={poll.id}>
        <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-7 gap-3">
          {poll.options.map(option => (
            <button
              class="poll-option group relative flex flex-col items-center text-center"
              data-option-id={option.id}
            >
              <div class="relative w-full aspect-square rounded-sm overflow-hidden border-2 border-transparent group-hover:border-primary/50 transition-all duration-300">
                {option.imageUrl ? (
                  <img
                    src={option.imageUrl}
                    alt={option.label}
                    class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full h-full bg-white/[0.04] flex items-center justify-center">
                    <span class="text-white/20 text-xs">{option.label[0]}</span>
                  </div>
                )}
                {/* Hover overlay with vote count */}
                <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                  <span class="text-white text-xs font-medium poll-count">{option.voteCount} votes</span>
                </div>
                {/* Selected indicator */}
                <div class="poll-selected absolute inset-0 border-2 border-primary bg-primary/20 hidden items-center justify-center">
                  <svg class="size-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
              </div>
              <span class="text-white/70 text-[11px] mt-2 leading-tight group-hover:text-white transition-colors line-clamp-2">{option.label}</span>
            </button>
          ))}
        </div>

        {/* Vote button */}
        <div class="mt-6 text-center">
          <button
            class="poll-submit-btn px-8 py-2.5 rounded-sm bg-primary/20 border border-primary/40 text-primary text-sm font-medium hover:bg-primary/30 transition-all duration-300 disabled:opacity-40 disabled:cursor-default"
            disabled
          >
            This is the best Cure album!
          </button>
        </div>
      </div>
    ) : (
      /* Fallback: bar chart layout for text-only polls */
      <div class="space-y-3 poll-options" data-poll-id={poll.id}>
        {poll.options.map(option => (
          <button
            class="poll-option w-full text-left group"
            data-option-id={option.id}
          >
            <div class="flex items-center justify-between mb-1">
              <span class="text-sm text-white/80 group-hover:text-white transition-colors">{option.label}</span>
              <span class="text-xs text-white/40 poll-count">{option.voteCount} votes</span>
            </div>
            <div class="h-2 bg-white/[0.06] rounded-full overflow-hidden">
              <div
                class="h-full bg-gradient-to-r from-primary/60 to-primary/40 rounded-full transition-all duration-500"
                style={`width: ${option.percentage}%`}
              ></div>
            </div>
            <span class="text-[10px] text-white/30">{option.percentage}%</span>
          </button>
        ))}
      </div>
    )}

    <div class="flex items-center justify-between mt-4 pt-3 border-t border-white/[0.06]">
      <span class="text-xs text-white/35">{poll.totalVotes.toLocaleString('en-US')} total votes</span>
      {poll.endDate && (
        <span class="text-xs text-white/35">Ends {poll.endDate}</span>
      )}
    </div>
  </div>
)}

<style>
  .line-clamp-2 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
</style>

<script>
  function setupPolls() {
    document.querySelectorAll('.poll-options').forEach(container => {
      let selectedId: string | null = null;
      const submitBtn = container.parentElement?.querySelector('.poll-submit-btn') as HTMLButtonElement | null;

      // Image grid mode
      container.querySelectorAll('.poll-option').forEach(btn => {
        btn.addEventListener('click', () => {
          if (btn.classList.contains('voted')) return;

          const optionId = btn.getAttribute('data-option-id');

          // If this is image grid mode (has submit button)
          if (submitBtn) {
            // Deselect all
            container.querySelectorAll('.poll-option').forEach(b => {
              b.querySelector('.poll-selected')?.classList.add('hidden');
              b.querySelector('.poll-selected')?.classList.remove('flex');
              (b as HTMLElement).querySelector('.aspect-square')?.classList.remove('border-primary/50');
            });

            // Select this one
            const selected = btn.querySelector('.poll-selected');
            if (selected) {
              selected.classList.remove('hidden');
              selected.classList.add('flex');
            }
            const imgWrap = btn.querySelector('.aspect-square');
            if (imgWrap) imgWrap.classList.add('border-primary/50');

            selectedId = optionId;
            submitBtn.disabled = false;
            submitBtn.classList.remove('disabled:opacity-40');
          } else {
            // Bar chart mode - vote immediately
            submitVote(optionId!, btn as HTMLElement, container as HTMLElement);
          }
        });
      });

      // Submit button click
      if (submitBtn) {
        submitBtn.addEventListener('click', async () => {
          if (!selectedId || submitBtn.disabled) return;
          const selectedBtn = container.querySelector(`[data-option-id="${selectedId}"]`) as HTMLElement;
          if (selectedBtn) {
            await submitVote(selectedId, selectedBtn, container as HTMLElement);
            submitBtn.textContent = 'Vote recorded!';
            submitBtn.disabled = true;
          }
        });
      }
    });

    async function submitVote(optionId: string, btn: HTMLElement, container: HTMLElement) {
      try {
        const res = await fetch(`https://dash.cureation.net/items/poll_options/${optionId}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ vote_count: { _inc: 1 } })
        });

        if (res.ok) {
          btn.classList.add('voted');
          const countEl = btn.querySelector('.poll-count');
          if (countEl) {
            const current = parseInt(countEl.textContent || '0');
            countEl.textContent = `${current + 1} votes`;
          }
          container.querySelectorAll('.poll-option').forEach(b => {
            (b as HTMLElement).style.pointerEvents = 'none';
          });
        }
      } catch {}
    }
  }
  setupPolls();
  document.addEventListener('astro:page-load', setupPolls);
</script>
