---
import type { NewsPost } from '../../types/directus';
import type { Setlist } from '../../lib/directus';
import type { SongWithAlbum } from '../../types/directus';
import {
  getMockSongOfTheDay,
  getMockLatestSetlist,
  getMockLatestReview,
  mockSongsWithAlbums,
  mockSetlists,
  mockNewsPosts,
  type MockSetlist
} from '../../lib/mockData';

interface Props {
  songOfTheDay: SongWithAlbum | null;
  latestSetlist: Setlist | MockSetlist | null;
  latestReview: NewsPost | null;
}

const {
  songOfTheDay: propSong,
  latestSetlist: propSetlist,
  latestReview: propReview
} = Astro.props;

// Always ensure we have data to display - never show empty states
const songOfTheDay: SongWithAlbum = propSong || getMockSongOfTheDay() || mockSongsWithAlbums[0];
const latestSetlist = propSetlist || getMockLatestSetlist() || mockSetlists[0];
const latestReview: NewsPost = propReview || getMockLatestReview() || mockNewsPosts.find(p => p.category === 'reviews') || mockNewsPosts[0];

// Get first line of lyrics for preview
const lyricsSnippet = songOfTheDay?.lyrics?.[0]?.content?.split('\n')[0] || '';
---

<section class="py-8">
  <div class="responsive-container">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {/* Song of the Day */}
      <a
        href={`/lyrics/${songOfTheDay.albumSlug}/${songOfTheDay.title.toLowerCase().replace(/[^\w\s]/gi, '').replace(/\s+/g, '-')}`}
        class="group"
      >
        <div class="glass-card-hover h-full p-6 flex flex-col">
          <div class="flex items-center gap-3 mb-4">
            <div class="p-2 rounded-lg bg-primary/20">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v12M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
              </svg>
            </div>
            <span class="text-white/50 text-sm font-medium uppercase tracking-wider">Song of the Day</span>
          </div>

          <h3 class="font-heading text-xl text-white mb-1 group-hover:text-primary transition-colors duration-300 line-clamp-1">
            {songOfTheDay.title}
          </h3>
          <p class="text-white/60 text-sm mb-3">
            {songOfTheDay.albumTitle}
          </p>
          {lyricsSnippet && (
            <p class="text-white/40 text-sm italic line-clamp-2 flex-1">
              "{lyricsSnippet}..."
            </p>
          )}

          <div class="flex items-center gap-2 mt-4 text-primary text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            <span>Read lyrics</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </div>
        </div>
      </a>

      {/* Latest Setlist */}
      <a
        href={`/setlists/${latestSetlist.slug}`}
        class="group"
      >
        <div class="glass-card-hover h-full p-6 flex flex-col">
          <div class="flex items-center gap-3 mb-4">
            <div class="p-2 rounded-lg bg-accent/20">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <span class="text-white/50 text-sm font-medium uppercase tracking-wider">Latest Setlist</span>
          </div>

          <h3 class="font-heading text-xl text-white mb-1 group-hover:text-accent transition-colors duration-300 line-clamp-1">
            {latestSetlist.venue}
          </h3>
          <p class="text-white/60 text-sm mb-1">
            {latestSetlist.location}
          </p>
          <p class="text-white/40 text-sm flex-1">
            <time datetime={latestSetlist.date}>{latestSetlist.formattedDate}</time>
          </p>
          <p class="text-white/50 text-sm mt-2">
            {latestSetlist.songCount} songs
          </p>

          <div class="flex items-center gap-2 mt-4 text-accent text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            <span>View setlist</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </div>
        </div>
      </a>

      {/* Latest Review */}
      <a
        href={`/news/${latestReview.slug}`}
        class="group"
      >
        <div class="glass-card-hover h-full p-6 flex flex-col">
          <div class="flex items-center gap-3 mb-4">
            <div class="p-2 rounded-lg bg-green-500/20">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-5 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
              </svg>
            </div>
            <span class="text-white/50 text-sm font-medium uppercase tracking-wider">Latest Review</span>
          </div>

          <h3 class="font-heading text-xl text-white mb-2 group-hover:text-green-400 transition-colors duration-300 line-clamp-2">
            {latestReview.title}
          </h3>
          {latestReview.rating && (
            <div class="flex items-center gap-1 mb-2">
              {Array.from({ length: 5 }).map((_, i) => (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class={`size-4 ${i < latestReview.rating! ? 'text-yellow-400 fill-yellow-400' : 'text-white/20'}`}
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                </svg>
              ))}
            </div>
          )}
          <p class="text-white/40 text-sm line-clamp-2 flex-1">
            {latestReview.excerpt}
          </p>

          <div class="flex items-center gap-2 mt-4 text-green-400 text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            <span>Read review</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </div>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  .line-clamp-1 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
  }
  .line-clamp-2 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
</style>
