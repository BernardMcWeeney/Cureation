---
import type { SongWithAlbum } from '../../types/directus';

interface Props {
  song: SongWithAlbum | null;
}

const { song } = Astro.props;

// Get first verse of lyrics for preview
const lyricsPreview = song?.lyrics?.[0]?.content?.split('\n').slice(0, 4).join('\n') || '';
---

<section class="py-8">
  <div class="responsive-container">
    {song ? (
      <a href={`/lyrics/${song.albumSlug}/${song.title.toLowerCase().replace(/[^\w\s]/gi, '').replace(/\s+/g, '-')}`} class="group block">
        <div
          class="song-card-glass p-6 md:p-8"
          style={`--card-bg-image: url(${song.albumCover})`}
        >
          <div class="flex flex-col md:flex-row gap-6 md:gap-8">
            {/* Album art */}
            <div class="shrink-0">
              <div class="w-32 h-32 md:w-40 md:h-40 rounded-xl overflow-hidden shadow-2xl group-hover:shadow-primary/20 transition-shadow duration-500">
                <img
                  src={song.albumCover}
                  alt={song.albumTitle}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                  loading="lazy"
                />
              </div>
            </div>

            {/* Content */}
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-2">
                <span class="badge text-xs">Song of the Day</span>
              </div>

              <h3 class="font-heading text-2xl md:text-3xl text-white mb-1 group-hover:text-glow transition-all duration-300">
                {song.title}
              </h3>

              <p class="text-white/60 text-sm mb-4">
                from <span class="text-primary">{song.albumTitle}</span> ({song.year})
              </p>

              {/* Lyrics preview */}
              {lyricsPreview && (
                <div class="relative">
                  <blockquote class="text-white/70 italic text-sm leading-relaxed border-l-2 border-primary/40 pl-4">
                    <pre class="font-sans whitespace-pre-wrap">{lyricsPreview}</pre>
                  </blockquote>
                  <div class="absolute bottom-0 left-0 right-0 h-8 bg-gradient-to-t from-black/80 to-transparent pointer-events-none"></div>
                </div>
              )}

              <div class="flex items-center gap-2 mt-4 text-primary opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                <span class="text-sm font-medium">Read full lyrics</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14"></path>
                  <path d="m12 5 7 7-7 7"></path>
                </svg>
              </div>
            </div>
          </div>
        </div>
      </a>
    ) : (
      <div class="glass-card p-8 text-center">
        <p class="text-white/60">No song of the day available.</p>
        <a href="/lyrics" class="inline-block mt-4 text-primary hover:underline">Browse all lyrics</a>
      </div>
    )}
  </div>
</section>
