---
import { getRandomFact } from '../../lib/directus';

let fact = null;
try {
  fact = await getRandomFact();
} catch {}
---

{fact && (
  <div class="glass-tile p-6 gothic-corners">
    <div class="flex items-center gap-3 mb-4">
      <div class="p-2 rounded-sm bg-amber-500/15 border border-amber-500/25">
        <svg class="size-4 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/>
          <path d="M9 18h6"/><path d="M10 22h4"/>
        </svg>
      </div>
      <span class="text-xs uppercase tracking-[0.16em] text-amber-400/80 font-medium">Did You Know?</span>
    </div>

    <p class="text-white/85 leading-relaxed">{fact.fact}</p>

    <div class="flex items-center gap-3 mt-4 pt-3 border-t border-white/[0.06]">
      {fact.category && (
        <span class="px-2 py-0.5 text-[10px] uppercase tracking-wider bg-white/[0.06] border border-white/10 text-white/40 rounded-sm">
          {fact.category}
        </span>
      )}
      {fact.sourceName && (
        <span class="text-[10px] text-white/30">via {fact.sourceName}</span>
      )}
    </div>
  </div>
)}
