---
interface Props {
  stats: {
    albums: number;
    songs: number;
    shows: number;
    countries: number;
  };
}

const { stats } = Astro.props;

const statItems = [
  { label: 'Albums', value: stats.albums, icon: '<svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v12M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z"/></svg>' },
  { label: 'Songs', value: stats.songs.toLocaleString('en-US'), icon: '<svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 9l10.5-3m0 6.553v3.75a2.25 2.25 0 01-1.632 2.163l-1.32.377a1.803 1.803 0 11-.99-3.467l2.31-.66a2.25 2.25 0 001.632-2.163zm0 0V2.25L9 5.25v10.303m0 0v3.75a2.25 2.25 0 01-1.632 2.163l-1.32.377a1.803 1.803 0 01-.99-3.467l2.31-.66A2.25 2.25 0 009 15.553z"/></svg>' },
  { label: 'Shows', value: stats.shows.toLocaleString('en-US'), icon: '<svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>' },
  { label: 'Countries', value: stats.countries, icon: '<svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418"/></svg>' },
];
---

<section class="py-12">
  <div class="responsive-container">
    <div class="glass-panel p-4 md:p-6">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        {/* Stats */}
        <div class="flex items-center gap-6 md:gap-8">
          {statItems.map(item => (
            <a href="/stats" class="group flex items-center gap-2.5 hover:text-white transition-colors">
              <span class="text-text-muted group-hover:text-primary transition-colors" set:html={item.icon} />
              <div>
                <p class="text-white text-lg font-display leading-none">{item.value}</p>
                <p class="text-text-muted text-xs uppercase tracking-wider">{item.label}</p>
              </div>
            </a>
          ))}
        </div>

        {/* Community links */}
        <div class="flex items-center gap-4">
          <a
            href="/about#contribute"
            class="px-4 py-2 border border-border-default text-text-secondary text-sm hover:border-primary/40 hover:text-white transition-all"
          >
            Contribute
          </a>
          <a
            href="/stats"
            class="px-4 py-2 bg-primary text-white text-sm font-medium hover:bg-primary/90 transition-colors"
          >
            Explore Stats
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
