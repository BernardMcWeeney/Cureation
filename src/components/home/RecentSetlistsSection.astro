---
import type { Setlist } from '../../lib/directus';
import { mockSetlists, type MockSetlist } from '../../lib/mockData';

interface Props {
  setlists?: (Setlist | MockSetlist)[];
}

const { setlists: propSetlists } = Astro.props;
const setlists = (propSetlists && propSetlists.length > 0 ? propSetlists : mockSetlists).slice(0, 3);

function getTourName(setlist: Setlist | MockSetlist): string {
  if ('tour' in setlist) return setlist.tour || '';
  if ('tourName' in setlist) return (setlist as any).tourName || '';
  return '';
}

function getSongs(setlist: Setlist | MockSetlist): string[] {
  if ('songs' in setlist && Array.isArray(setlist.songs)) {
    return setlist.songs.slice(0, 4).map((s: any) => s.title || s);
  }
  return [];
}
---

<section class="py-16">
  <div class="responsive-container">
    <div class="flex items-center justify-between mb-8">
      <div class="gothic-heading flex-1">
        <h2 class="font-heading text-xl md:text-2xl text-primary tracking-wider">Recent Shows</h2>
      </div>
      <a
        href="/setlists"
        class="group text-sm text-white/40 hover:text-primary transition-colors flex items-center gap-1.5 ml-4"
      >
        All setlists
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4 group-hover:translate-x-1 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {setlists.map((setlist, index) => {
        const tourName = getTourName(setlist);
        const songs = getSongs(setlist);
        const venueImage = 'venueImage' in setlist ? setlist.venueImage : undefined;

        return (
          <a href={`/setlists/${setlist.slug}`} class="group">
            <div
              class="glass-tile-image h-full p-6 flex flex-col min-h-[260px] gothic-corners"
              style={venueImage ? `--tile-bg-image: url('${venueImage}')` : ''}
            >
              <!-- Top meta row -->
              <div class="flex items-start justify-between gap-2 mb-auto">
                <span class="px-2.5 py-1 rounded-sm bg-black/50 backdrop-blur-sm text-white/70 text-xs font-medium text-shadow border border-white/10">
                  {setlist.formattedDate}
                </span>
                <span class="px-2.5 py-1 rounded-sm bg-primary/30 backdrop-blur-sm text-white/90 text-xs font-medium text-shadow border border-primary/20">
                  {setlist.songCount} songs
                </span>
              </div>

              <!-- Venue info -->
              <div class="mt-auto">
                <h3 class="font-heading text-xl text-white mb-1 group-hover:text-primary transition-colors duration-300 text-shadow-lg">
                  {setlist.venue}
                </h3>
                <p class="text-white/65 text-sm mb-1 text-shadow">{setlist.location}</p>
                {tourName && (
                  <p class="text-white/50 text-xs uppercase tracking-wider text-shadow">{tourName}</p>
                )}
              </div>

              <!-- Songs preview chips -->
              {songs.length > 0 && (
                <div class="mt-4 pt-3 border-t border-white/10">
                  <p class="text-white/40 text-xs uppercase tracking-widest mb-2 text-shadow">Played</p>
                  <div class="flex flex-wrap gap-1.5">
                    {songs.map((title: string) => (
                      <span class="px-2 py-0.5 rounded-sm bg-white/10 backdrop-blur-sm text-white/65 text-xs text-shadow">
                        {title}
                      </span>
                    ))}
                  </div>
                </div>
              )}

              <!-- Hover CTA -->
              <div class="flex items-center gap-1.5 mt-4 text-white/60 text-xs opacity-0 group-hover:opacity-100 transition-opacity duration-300 text-shadow">
                <span>View full setlist</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                </svg>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>
