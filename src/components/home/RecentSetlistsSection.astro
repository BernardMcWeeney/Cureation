---
import type { Setlist } from '../../lib/directus';
import { mockSetlists, type MockSetlist } from '../../lib/mockData';

interface Props {
  setlists?: (Setlist | MockSetlist)[];
}

const { setlists: propSetlists } = Astro.props;
const setlists = (propSetlists && propSetlists.length > 0 ? propSetlists : mockSetlists).slice(0, 10);

function getTourName(setlist: Setlist | MockSetlist): string {
  if ('tour' in setlist) return setlist.tour || '';
  if ('tourName' in setlist) return (setlist as any).tourName || '';
  return '';
}
---

<section class="py-16">
  <div class="responsive-container">
    <div class="flex items-center justify-between mb-8">
      <div class="gothic-heading flex-1">
        <h2 class="font-heading text-xl md:text-2xl text-primary tracking-wider">Recent Shows</h2>
      </div>
      <a
        href="/setlists"
        class="group text-sm text-white/40 hover:text-primary transition-colors flex items-center gap-1.5 ml-4"
      >
        All setlists
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4 group-hover:translate-x-1 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
        </svg>
      </a>
    </div>

    <!-- Scrollable strip -->
    <div class="relative">
      <div class="setlist-strip flex gap-3 overflow-x-auto pb-3 snap-x snap-mandatory">
        {setlists.map((setlist) => {
          const tourName = getTourName(setlist);
          const venueImage = 'venueImage' in setlist ? setlist.venueImage : undefined;

          return (
            <a
              href={`/setlists/${setlist.slug}`}
              class="group flex-none snap-start w-64 md:w-72"
            >
              <div
                class="glass-tile-image h-full p-5 flex flex-col min-h-[200px] rounded-sm ring-1 ring-white/[0.06] group-hover:ring-primary/40 transition-all duration-300"
                style={venueImage ? `--tile-bg-image: url('${venueImage}')` : ''}
              >
                <div class="flex items-start justify-between gap-2 mb-auto">
                  <span class="px-2 py-0.5 rounded-sm bg-black/50 backdrop-blur-sm text-white/70 text-xs font-medium text-shadow border border-white/10">
                    {setlist.formattedDate}
                  </span>
                  <span class="px-2 py-0.5 rounded-sm bg-primary/30 backdrop-blur-sm text-white/90 text-xs font-medium text-shadow border border-primary/20">
                    {setlist.songCount} songs
                  </span>
                </div>

                <div class="mt-auto">
                  <h3 class="font-heading text-lg text-white mb-1 group-hover:text-primary transition-colors duration-300 text-shadow-lg truncate">
                    {setlist.venue}
                  </h3>
                  <p class="text-white/65 text-sm text-shadow truncate">{setlist.location}</p>
                  {tourName && (
                    <p class="text-white/50 text-xs uppercase tracking-wider text-shadow mt-1 truncate">{tourName}</p>
                  )}
                </div>
              </div>
            </a>
          );
        })}
      </div>

      <!-- Right fade -->
      <div class="absolute top-0 right-0 bottom-3 w-20 bg-gradient-to-l from-[#050505] to-transparent pointer-events-none z-10"></div>
      <!-- Left fade -->
      <div class="absolute top-0 left-0 bottom-3 w-8 bg-gradient-to-r from-[#050505] to-transparent pointer-events-none z-10"></div>
    </div>
  </div>
</section>

<style>
  .setlist-strip {
    scrollbar-width: thin;
    scrollbar-color: rgba(var(--color-primary-rgb), 0.2) transparent;
  }
  .setlist-strip::-webkit-scrollbar {
    height: 3px;
  }
  .setlist-strip::-webkit-scrollbar-track {
    background: transparent;
  }
  .setlist-strip::-webkit-scrollbar-thumb {
    background: rgba(var(--color-primary-rgb), 0.2);
    border-radius: 2px;
  }
</style>
