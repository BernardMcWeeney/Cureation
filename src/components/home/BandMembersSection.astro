---
import type { WikiMember } from '../../types/directus';
import { mockMembers } from '../../lib/mockData';

interface Props {
  members?: WikiMember[];
}

const { members: propMembers } = Astro.props;
const members = (propMembers && propMembers.length > 0 ? propMembers : mockMembers).slice(0, 3);
---

<section class="py-16">
  <div class="responsive-container">
    <div class="flex items-center justify-between mb-8">
      <div class="flex items-center gap-4">
        <h2 class="font-heading text-2xl text-primary">The Band</h2>
        <div class="h-px w-20 bg-gradient-to-r from-primary/30 to-transparent"></div>
      </div>
      <a
        href="/wiki"
        class="group text-sm text-white/50 hover:text-primary transition-colors flex items-center gap-1.5"
      >
        Full wiki
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4 group-hover:translate-x-1 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {members.map((member) => (
        <a href={`/wiki/members/${member.slug}`} class="group">
          <div class="glass-panel p-6 h-full flex flex-col">
            <!-- Photo + info header -->
            <div class="flex items-start gap-4 mb-5">
              <div class="relative flex-none">
                <div class="w-16 h-16 rounded-full overflow-hidden ring-2 ring-white/15 group-hover:ring-primary/60 transition-all duration-400">
                  {member.photo ? (
                    <img
                      src={member.photo}
                      alt={member.name}
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                      loading="lazy"
                    />
                  ) : (
                    <div class="w-full h-full bg-gradient-to-br from-primary/30 to-accent/20 flex items-center justify-center">
                      <svg xmlns="http://www.w3.org/2000/svg" class="size-7 text-white/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                      </svg>
                    </div>
                  )}
                </div>
                {member.isCurrentMember && (
                  <div
                    class="absolute -bottom-0.5 -right-0.5 w-3.5 h-3.5 rounded-full bg-emerald-500 ring-2 ring-black"
                    title="Current member"
                  ></div>
                )}
              </div>

              <div class="flex-1 min-w-0">
                <h3 class="font-heading text-lg text-white group-hover:text-primary transition-colors duration-300 leading-tight truncate">
                  {member.name}
                </h3>
                <p class="text-primary/70 text-xs mt-0.5 truncate">
                  {member.instruments.join(' · ')}
                </p>
                <p class="text-white/35 text-xs mt-1">{member.tenure}</p>
              </div>
            </div>

            <!-- Bio -->
            <p class="text-white/65 text-sm flex-1 leading-relaxed member-bio">
              {member.bio}
            </p>

            <!-- Side projects -->
            {member.sideProjects && member.sideProjects.length > 0 && (
              <div class="mt-5 pt-4 border-t border-white/10">
                <p class="text-white/35 text-xs uppercase tracking-widest mb-2">Also known for</p>
                <div class="flex flex-wrap gap-1.5">
                  {member.sideProjects.slice(0, 3).map((project) => (
                    <span class="px-2 py-0.5 rounded-md bg-white/8 border border-white/10 text-white/55 text-xs">
                      {project}
                    </span>
                  ))}
                </div>
              </div>
            )}

            <!-- Hover arrow -->
            <div class="flex items-center gap-1.5 mt-4 text-primary/70 text-xs opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              <span>View profile</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .member-bio {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }
</style>
