---
import { getTimelineEvents } from '../../lib/directus';

let anniversaries: any[] = [];
try {
  const events = await getTimelineEvents();
  const now = new Date();
  const currentMonth = now.getMonth();
  const currentDay = now.getDate();

  anniversaries = events
    .map(event => {
      const eventDate = new Date(event.date);
      const eventMonth = eventDate.getMonth();
      const eventDay = eventDate.getDate();
      const yearsAgo = now.getFullYear() - eventDate.getFullYear();

      // Check if within next 30 days (wrapping around year end)
      const thisYearDate = new Date(now.getFullYear(), eventMonth, eventDay);
      const diffDays = Math.ceil((thisYearDate.getTime() - now.getTime()) / (1000 * 60 * 60 * 24));

      const isUpcoming = diffDays >= -1 && diffDays <= 30;

      return isUpcoming ? {
        ...event,
        yearsAgo,
        daysUntil: diffDays,
        isToday: diffDays >= -1 && diffDays <= 0,
        label: diffDays >= -1 && diffDays <= 0
          ? `${yearsAgo} years ago today`
          : diffDays <= 7
            ? `${yearsAgo} years ago this week`
            : `${yearsAgo} years ago on ${eventDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}`
      } : null;
    })
    .filter(Boolean)
    .sort((a, b) => a.daysUntil - b.daysUntil)
    .slice(0, 5);
} catch {}

const typeColors: Record<string, string> = {
  release: 'text-primary bg-primary/10 border-primary/25',
  tour: 'text-blue-400 bg-blue-400/10 border-blue-400/25',
  member_change: 'text-purple-400 bg-purple-400/10 border-purple-400/25',
  award: 'text-amber-400 bg-amber-400/10 border-amber-400/25',
  milestone: 'text-green-400 bg-green-400/10 border-green-400/25',
  other: 'text-white/60 bg-white/5 border-white/15',
};
---

{anniversaries.length > 0 && (
  <section class="py-16 relative overflow-hidden">
    <div class="responsive-container relative z-10">
      <div class="flex items-center gap-3 mb-8">
        <span class="px-3 py-1 text-[11px] uppercase tracking-[0.16em] text-primary bg-primary/10 border border-primary/[0.35]">
          Upcoming Anniversaries
        </span>
        <div class="divider-gradient flex-1"></div>
      </div>

      <div class="space-y-3">
        {anniversaries.map(ann => (
          <div class={`glass-tile p-4 flex items-center gap-4 ${ann.isToday ? 'ring-1 ring-primary/20' : ''}`}>
            <div class="shrink-0 w-12 h-12 rounded-sm bg-primary/10 border border-primary/20 flex items-center justify-center">
              <span class="font-display text-lg text-primary">{ann.yearsAgo}</span>
            </div>
            <div class="flex-1 min-w-0">
              <h4 class="text-white text-sm font-medium truncate">{ann.title}</h4>
              <p class="text-white/50 text-xs">{ann.label}</p>
            </div>
            <span class={`shrink-0 px-2 py-0.5 text-[10px] uppercase tracking-wider border rounded-sm ${typeColors[ann.type] || typeColors.other}`}>
              {ann.type.replace('_', ' ')}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>
)}
