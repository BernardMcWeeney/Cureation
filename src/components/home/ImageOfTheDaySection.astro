---
import type { Photo } from '../../types/directus';
import { getMockPhotoOfTheDay, mockPhotos } from '../../lib/mockData';

interface Props {
  photo: Photo | null;
}

const { photo: propPhoto } = Astro.props;
const photo: Photo = propPhoto || getMockPhotoOfTheDay() || mockPhotos[0];
---

<section class="py-12">
  <div class="responsive-container">
    <div class="gothic-heading mb-6">
      <h2 class="font-heading text-xl md:text-2xl text-primary tracking-wider">Image of the Day</h2>
    </div>

    <a href="/gallery" class="group block">
      <div class="glass-tile overflow-hidden gothic-corners">
        {/* Image container */}
        <div class="relative aspect-[21/9] md:aspect-[3/1] overflow-hidden">
          <img
            src={photo.imageUrl}
            alt={photo.title}
            class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
            loading="lazy"
          />

          {/* Gradient overlays */}
          <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent opacity-80"></div>
          <div class="absolute inset-0 bg-gradient-to-r from-black/30 via-transparent to-black/30 opacity-60"></div>
          <!-- Gothic vignette -->
          <div class="absolute inset-0" style="background: radial-gradient(ellipse at center, transparent 50%, rgba(0,0,0,0.4) 100%);"></div>

          {/* Content overlay */}
          <div class="absolute bottom-0 left-0 right-0 p-6 md:p-8">
            <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
              <div>
                <h3 class="font-heading text-xl md:text-2xl text-white mb-2 group-hover:text-glow transition-all duration-300 text-shadow-lg">
                  {photo.title}
                </h3>

                {photo.description && (
                  <p class="text-white/70 text-sm max-w-2xl line-clamp-2 mb-2 text-shadow">
                    {photo.description}
                  </p>
                )}

                <div class="flex flex-wrap items-center gap-3 text-white/50 text-sm text-shadow">
                  {photo.formattedDate && (
                    <span class="flex items-center gap-1">
                      <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                      <time datetime={photo.dateTaken}>{photo.formattedDate}</time>
                    </span>
                  )}
                  {photo.location && (
                    <span class="flex items-center gap-1">
                      <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                      </svg>
                      {photo.location}
                    </span>
                  )}
                  {photo.photographer && (
                    <span class="flex items-center gap-1">
                      <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                      </svg>
                      {photo.photographer}
                    </span>
                  )}
                </div>
              </div>

              <div class="flex items-center gap-2 text-primary opacity-0 group-hover:opacity-100 translate-x-2 group-hover:translate-x-0 transition-all duration-300">
                <span class="text-sm font-medium whitespace-nowrap">View in Gallery</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14"></path>
                  <path d="m12 5 7 7-7 7"></path>
                </svg>
              </div>
            </div>
          </div>

          {/* Tags */}
          {photo.tags && photo.tags.length > 0 && (
            <div class="absolute top-4 left-4 flex flex-wrap gap-2">
              {photo.tags.slice(0, 3).map(tag => (
                <span class="px-2 py-1 rounded-sm bg-black/60 backdrop-blur-md border border-white/15 text-white/80 text-xs capitalize">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </div>
      </div>
    </a>
  </div>
</section>

<style>
  .line-clamp-2 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
</style>
