---
interface Props {
  activeItem?: string;
  items?: Array<{ title: string; path: string }>;
}

const { activeItem, items } = Astro.props;
---

<aside class="sticky top-24 w-full">
  {/* Only render nav list if items are provided and non-empty */}
  {items && items.length > 0 && (
    <div class="backdrop-blur-xl bg-black/50 border border-border-default overflow-hidden mb-6">
      <div class="p-4 border-b border-border-subtle">
        <h2 class="font-heading text-lg text-primary">In This Section</h2>
      </div>
      <nav class="p-2">
        <ul class="space-y-1">
          {items.map(item => (
            <li>
              <a
                href={item.path}
                class:list={[
                  'block px-4 py-2 transition-all duration-300',
                  activeItem === item.title
                    ? 'bg-surface-overlay text-primary'
                    : 'text-text-secondary hover:bg-surface-overlay hover:text-white',
                ]}
              >
                {item.title}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  )}

  <div class="backdrop-blur-xl bg-black/50 border border-border-default p-4">
    <h3 class="font-heading text-lg text-primary mb-3">Filter by Era</h3>
    <div class="space-y-2">
      <button class="w-full text-left px-3 py-2 bg-black/40 hover:bg-black/50 border border-border-default hover:border-border-strong text-text-secondary hover:text-white transition-all duration-300">
        Early Years (1978-1982)
      </button>
      <button class="w-full text-left px-3 py-2 bg-black/40 hover:bg-black/50 border border-border-default hover:border-border-strong text-text-secondary hover:text-white transition-all duration-300">
        Golden Era (1983-1992)
      </button>
      <button class="w-full text-left px-3 py-2 bg-black/40 hover:bg-black/50 border border-border-default hover:border-border-strong text-text-secondary hover:text-white transition-all duration-300">
        Later Works (1993-2008)
      </button>
      <button class="w-full text-left px-3 py-2 bg-black/40 hover:bg-black/50 border border-border-default hover:border-border-strong text-text-secondary hover:text-white transition-all duration-300">
        Recent (2009-Present)
      </button>
    </div>
  </div>
</aside>
