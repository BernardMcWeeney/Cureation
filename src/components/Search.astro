---
// Pagefind Search Component
// This component integrates with Pagefind for client-side search

interface Props {
  placeholder?: string;
  showFilters?: boolean;
  initialQuery?: string;
}

const { placeholder = 'Search lyrics, songs, albums...', showFilters = true, initialQuery = '' } = Astro.props;
---

<div class="search-container">
  <div
    id="pagefind-search"
    class="pagefind-ui"
    data-placeholder={placeholder}
    data-initial-query={initialQuery}
  ></div>

  {showFilters && (
    <div class="search-filters mt-4 flex flex-wrap gap-2" id="search-filters">
      <button
        type="button"
        class="filter-btn active px-3 py-1.5 rounded-lg bg-black/50 border border-primary/40 text-white text-sm transition-all duration-300"
        data-filter="all"
      >
        All
      </button>
      <button
        type="button"
        class="filter-btn px-3 py-1.5 rounded-lg bg-black/40 border border-white/15 text-white/80 text-sm hover:bg-black/50 hover:border-white/15 transition-all duration-300"
        data-filter="song"
      >
        Songs
      </button>
      <button
        type="button"
        class="filter-btn px-3 py-1.5 rounded-lg bg-black/40 border border-white/15 text-white/80 text-sm hover:bg-black/50 hover:border-white/15 transition-all duration-300"
        data-filter="album"
      >
        Albums
      </button>
      <button
        type="button"
        class="filter-btn px-3 py-1.5 rounded-lg bg-black/40 border border-white/15 text-white/80 text-sm hover:bg-black/50 hover:border-white/15 transition-all duration-300"
        data-filter="lyrics"
      >
        Lyrics
      </button>
    </div>
  )}
</div>

<style is:global>
  /* Custom Pagefind UI Styling to match glass aesthetic */
  .pagefind-ui {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: var(--color-primary, #89b0c9);
    --pagefind-ui-text: #ffffff;
    --pagefind-ui-background: transparent;
    --pagefind-ui-border: rgba(255, 255, 255, 0.2);
    --pagefind-ui-tag: rgba(255, 255, 255, 0.1);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 0.75rem;
    --pagefind-ui-image-border-radius: 0.5rem;
    --pagefind-ui-image-box-ratio: 1;
    --pagefind-ui-font: inherit;
  }

  .pagefind-ui__search-input {
    background: rgba(0, 0, 0, 0.5) !important;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.12) !important;
    color: white !important;
    padding: 0.75rem 1rem !important;
    font-size: 1rem !important;
  }

  .pagefind-ui__search-input::placeholder {
    color: rgba(255, 255, 255, 0.5) !important;
  }

  .pagefind-ui__search-input:focus {
    border-color: var(--color-primary, #89b0c9) !important;
    box-shadow: 0 0 0 2px rgba(137, 176, 201, 0.2) !important;
    outline: none !important;
  }

  .pagefind-ui__search-clear {
    color: rgba(255, 255, 255, 0.6) !important;
  }

  .pagefind-ui__search-clear:hover {
    color: white !important;
  }

  .pagefind-ui__results-area {
    margin-top: 1.5rem;
  }

  .pagefind-ui__result {
    background: rgba(0, 0, 0, 0.5) !important;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.12) !important;
    border-radius: 0.75rem !important;
    padding: 1rem !important;
    margin-bottom: 0.75rem !important;
    transition: all 0.3s ease !important;
  }

  .pagefind-ui__result:hover {
    background: rgba(0, 0, 0, 0.55) !important;
    border-color: rgba(var(--color-primary-rgb), 0.4) !important;
    transform: translateY(-2px);
  }

  .pagefind-ui__result-link {
    color: white !important;
    text-decoration: none !important;
    font-weight: 500 !important;
  }

  .pagefind-ui__result-link:hover {
    color: var(--color-primary, #89b0c9) !important;
  }

  .pagefind-ui__result-title {
    font-size: 1.1rem !important;
    margin-bottom: 0.5rem !important;
  }

  .pagefind-ui__result-excerpt {
    color: rgba(255, 255, 255, 0.7) !important;
    font-size: 0.9rem !important;
    line-height: 1.5 !important;
  }

  .pagefind-ui__result-excerpt mark {
    background: rgba(137, 176, 201, 0.3) !important;
    color: white !important;
    padding: 0.1em 0.2em;
    border-radius: 0.25rem;
  }

  .pagefind-ui__result-image {
    border-radius: 0.5rem !important;
    object-fit: cover !important;
  }

  .pagefind-ui__result-tag {
    background: rgba(0, 0, 0, 0.4) !important;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
    color: rgba(255, 255, 255, 0.8) !important;
    border-radius: 9999px !important;
    padding: 0.25rem 0.75rem !important;
    font-size: 0.75rem !important;
  }

  .pagefind-ui__message {
    color: rgba(255, 255, 255, 0.6) !important;
    text-align: center;
    padding: 2rem;
  }

  .pagefind-ui__button {
    background: rgba(137, 176, 201, 0.2) !important;
    border: 1px solid rgba(137, 176, 201, 0.3) !important;
    color: white !important;
    border-radius: 0.5rem !important;
    padding: 0.5rem 1rem !important;
    transition: all 0.3s ease !important;
  }

  .pagefind-ui__button:hover {
    background: rgba(137, 176, 201, 0.3) !important;
  }

  /* Filter button active state */
  .filter-btn.active {
    background: rgba(0, 0, 0, 0.5);
    border-color: rgba(var(--color-primary-rgb, 137, 176, 201), 0.4);
    color: white;
  }
</style>

<script>
  const DIRECTUS_BASE = 'https://dash.cureation.net/items';

  function escapeHtml(value) {
    return (value || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function slugify(value) {
    return (value || '')
      .toLowerCase()
      .replace(/[^\w\s-]/g, '')
      .replace(/\s+/g, '-');
  }

  function renderFallbackForm(query = '') {
    return `
      <form action="/lyrics/search" method="get" class="mb-6">
        <div class="flex flex-col sm:flex-row gap-3">
          <input
            type="search"
            name="q"
            value="${escapeHtml(query)}"
            placeholder="Search songs, lyrics, albums..."
            class="w-full px-4 py-3 rounded-lg bg-black/50 border border-white/20 text-white placeholder-white/50 focus:outline-none focus:ring-1 focus:ring-primary/40"
            required
          />
          <button
            type="submit"
            class="px-5 py-3 rounded-lg bg-white/10 border border-primary/40 text-white hover:bg-primary/30 transition-colors"
          >
            Search
          </button>
        </div>
      </form>
    `;
  }

  function getInitialQuery(container) {
    const fromData = (container.dataset.initialQuery || '').trim();
    const fromUrl = new URLSearchParams(window.location.search).get('q') || '';
    return (fromData || fromUrl).trim();
  }

  async function renderDirectusFallback(container, query) {
    const trimmed = query.trim();
    if (!trimmed) {
      container.innerHTML = `
        ${renderFallbackForm('')}
        <div class="text-center py-8 text-white/85">
          <p class="text-lg mb-2">Type a search term to begin.</p>
          <p class="text-sm">Search checks songs and albums directly from Directus.</p>
        </div>
      `;
      return;
    }

    container.innerHTML = `${renderFallbackForm(trimmed)}
      <div class="text-center py-6 text-white/85">
        Searching for "${escapeHtml(trimmed)}"...
      </div>`;

    try {
      const [songsRes, albumsRes] = await Promise.all([
        fetch(`${DIRECTUS_BASE}/songs?limit=-1&fields=id,title,lyrics`),
        fetch(`${DIRECTUS_BASE}/discography?limit=-1&fields=id,title,slug,description`)
      ]);
      const songsData = await songsRes.json();
      const albumsData = await albumsRes.json();

      const q = trimmed.toLowerCase();

      const songResults = (songsData.data || [])
        .filter((song) => {
          const title = (song.title || '').toLowerCase();
          const lyrics = (song.lyrics || '').toLowerCase();
          return title.includes(q) || lyrics.includes(q);
        })
        .slice(0, 30)
        .map((song) => ({
          type: 'Song',
          title: song.title || 'Untitled Song',
          url: `/lyrics/${slugify(song.title || '')}`,
          excerpt: 'Matched in title or lyrics'
        }));

      const albumResults = (albumsData.data || [])
        .filter((album) => {
          const title = (album.title || '').toLowerCase();
          const description = (album.description || '').toLowerCase();
          return title.includes(q) || description.includes(q);
        })
        .slice(0, 20)
        .map((album) => ({
          type: 'Album',
          title: album.title || 'Untitled Album',
          url: `/discography/${album.slug || slugify(album.title || '')}`,
          excerpt: 'Matched in album details'
        }));

      const combined = [...songResults, ...albumResults];
      if (combined.length === 0) {
        container.innerHTML = `
          ${renderFallbackForm(trimmed)}
          <div class="text-center py-8 text-white/85">
            <p class="text-lg mb-2">No results found for "${escapeHtml(trimmed)}".</p>
            <p class="text-sm">Try a broader term.</p>
          </div>
        `;
        return;
      }

      const resultItems = combined.map((item) => `
        <article class="pagefind-ui__result">
          <div class="pagefind-ui__result-title">
            <a class="pagefind-ui__result-link" href="${escapeHtml(item.url)}">${escapeHtml(item.title)}</a>
          </div>
          <p class="pagefind-ui__result-excerpt">${escapeHtml(item.excerpt)}</p>
          <div class="mt-2">
            <span class="pagefind-ui__result-tag">${escapeHtml(item.type)}</span>
          </div>
        </article>
      `).join('');

      container.innerHTML = `
        ${renderFallbackForm(trimmed)}
        <div class="text-white/80 text-sm mb-4">${combined.length} fallback results for "${escapeHtml(trimmed)}"</div>
        <div class="pagefind-ui__results-area">${resultItems}</div>
      `;
    } catch (error) {
      container.innerHTML = `
        ${renderFallbackForm(trimmed)}
        <div class="text-center py-8 text-white/85">
          <p class="text-lg mb-2">Search is temporarily unavailable.</p>
          <p class="text-sm">Please try again in a moment.</p>
        </div>
      `;
    }
  }

  function detectResultType(resultEl) {
    const link = resultEl.querySelector('.pagefind-ui__result-link');
    const href = (link?.getAttribute('href') || '').toLowerCase();
    if (href.includes('/discography/')) return 'album';
    if (href.includes('/lyrics/')) return 'lyrics';
    if (href.includes('/songs/')) return 'song';
    return 'all';
  }

  function applyResultFilter(container, filter) {
    const resultNodes = container.querySelectorAll('.pagefind-ui__result');
    let visible = 0;

    resultNodes.forEach((node) => {
      const type = detectResultType(node);
      const shouldShow =
        filter === 'all' ||
        type === filter ||
        (filter === 'song' && type === 'lyrics') ||
        (filter === 'lyrics' && type === 'song');
      node.style.display = shouldShow ? '' : 'none';
      if (shouldShow) visible += 1;
    });

    let emptyNode = container.querySelector('.search-filter-empty');
    if (!emptyNode) {
      emptyNode = document.createElement('p');
      emptyNode.className = 'search-filter-empty text-white/85 text-center py-4 hidden';
      emptyNode.textContent = 'No results match this filter.';
      const resultsArea = container.querySelector('.pagefind-ui__results-area');
      resultsArea?.appendChild(emptyNode);
    }
    emptyNode.classList.toggle('hidden', visible > 0 || resultNodes.length === 0);
  }

  function triggerSearch(searchInput, query) {
    if (!searchInput || !query) return;
    searchInput.value = query;
    searchInput.dispatchEvent(new Event('input', { bubbles: true }));
  }

  async function initPagefind() {
    const container = document.getElementById('pagefind-search');
    if (!container) return;
    if (container.dataset.initialized === 'true') return;
    container.dataset.initialized = 'true';

    let activeFilter = 'all';
    const filterBtns = document.querySelectorAll('.filter-btn');

    function setActiveFilter(filter) {
      activeFilter = filter || 'all';
      filterBtns.forEach((btn) => {
        btn.classList.toggle('active', btn.getAttribute('data-filter') === activeFilter);
      });
      applyResultFilter(container, activeFilter);
    }

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter') || 'all';
        setActiveFilter(filter);
      });
    });
    setActiveFilter('all');

    try {
      // Check if pagefind files exist by trying to fetch them first
      const pagefindPath = '/_pagefind/pagefind.js';
      const checkResponse = await fetch(pagefindPath, { method: 'HEAD' });

      if (!checkResponse.ok) {
        throw new Error('Pagefind not built yet');
      }

      // Load Pagefind CSS dynamically
      if (!document.querySelector('link[href="/_pagefind/pagefind-ui.css"]')) {
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = '/_pagefind/pagefind-ui.css';
        document.head.appendChild(link);
      }

      // Use Function constructor to avoid Vite's static analysis
      const importPagefind = new Function('return import("/_pagefind/pagefind.js")');
      const importPagefindUI = new Function('return import("/_pagefind/pagefind-ui.js")');

      const pagefind = await importPagefind();
      await pagefind.options({
        excerptLength: 20,
        highlightParam: 'highlight'
      });

      const { PagefindUI } = await importPagefindUI();
      const placeholder = container.dataset.placeholder || 'Search...';

      new PagefindUI({
        element: '#pagefind-search',
        showImages: true,
        showEmptyFilters: false,
        resetStyles: false,
        translations: {
          placeholder: placeholder,
          zero_results: 'No results found for "[SEARCH_TERM]"',
          many_results: '[COUNT] results for "[SEARCH_TERM]"',
          one_result: '1 result for "[SEARCH_TERM]"',
          searching: 'Searching...'
        }
      });

      const initialQuery = getInitialQuery(container);

      setTimeout(() => {
        const searchInput = document.querySelector('.pagefind-ui__search-input');

        if (searchInput) {
          searchInput.addEventListener('input', () => {
            setTimeout(() => applyResultFilter(container, activeFilter), 30);
          });
          triggerSearch(searchInput, initialQuery);
        }
      }, 100);
    } catch (e) {
      await renderDirectusFallback(container, getInitialQuery(container));
      setActiveFilter(activeFilter);
    }
  }

  // Initialize on page load
  document.addEventListener('DOMContentLoaded', initPagefind);
  document.addEventListener('astro:page-load', initPagefind);
</script>
