---
// Gothic cobweb decoration component for corners
// Usage: <GothicCobweb position="top-left" /> or position="top-right" | "bottom-left" | "bottom-right"
interface Props {
  position?: 'top-left' | 'top-right' | 'bottom-left' | 'bottom-right';
  size?: 'sm' | 'md' | 'lg';
  opacity?: number;
}

const { position = 'top-left', size = 'md', opacity = 0.15 } = Astro.props;

const sizeMap = { sm: 80, md: 120, lg: 180 };
const svgSize = sizeMap[size];

const positionClasses: Record<string, string> = {
  'top-left': 'top-0 left-0',
  'top-right': 'top-0 right-0 -scale-x-100',
  'bottom-left': 'bottom-0 left-0 -scale-y-100',
  'bottom-right': 'bottom-0 right-0 -scale-x-100 -scale-y-100',
};
---

<div
  class={`absolute ${positionClasses[position]} pointer-events-none z-[2]`}
  style={`opacity: ${opacity}`}
>
  <svg
    width={svgSize}
    height={svgSize}
    viewBox="0 0 200 200"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="cobweb-svg"
  >
    <!-- Main radial threads from corner -->
    <path d="M0 0 L200 200" stroke="white" stroke-width="0.5" opacity="0.6" />
    <path d="M0 0 L200 100" stroke="white" stroke-width="0.5" opacity="0.5" />
    <path d="M0 0 L100 200" stroke="white" stroke-width="0.5" opacity="0.5" />
    <path d="M0 0 L200 50" stroke="white" stroke-width="0.4" opacity="0.4" />
    <path d="M0 0 L50 200" stroke="white" stroke-width="0.4" opacity="0.4" />
    <path d="M0 0 L200 150" stroke="white" stroke-width="0.4" opacity="0.35" />
    <path d="M0 0 L150 200" stroke="white" stroke-width="0.4" opacity="0.35" />
    <path d="M0 0 L200 25" stroke="white" stroke-width="0.3" opacity="0.3" />
    <path d="M0 0 L25 200" stroke="white" stroke-width="0.3" opacity="0.3" />

    <!-- Concentric web arcs - closer to corner -->
    <path d="M15 4 Q12 12 4 15" stroke="white" stroke-width="0.4" fill="none" opacity="0.5" />
    <path d="M30 8 Q22 22 8 30" stroke="white" stroke-width="0.4" fill="none" opacity="0.45" />
    <path d="M50 12 Q35 35 12 50" stroke="white" stroke-width="0.4" fill="none" opacity="0.4" />
    <path d="M75 18 Q50 50 18 75" stroke="white" stroke-width="0.4" fill="none" opacity="0.35" />
    <path d="M105 25 Q70 70 25 105" stroke="white" stroke-width="0.3" fill="none" opacity="0.3" />
    <path d="M140 32 Q90 90 32 140" stroke="white" stroke-width="0.3" fill="none" opacity="0.25" />
    <path d="M180 40 Q115 115 40 180" stroke="white" stroke-width="0.3" fill="none" opacity="0.2" />

    <!-- Small dew drops -->
    <circle cx="15" cy="15" r="1" fill="white" opacity="0.4" />
    <circle cx="35" cy="35" r="0.8" fill="white" opacity="0.3" />
    <circle cx="60" cy="30" r="0.7" fill="white" opacity="0.25" />
    <circle cx="30" cy="60" r="0.7" fill="white" opacity="0.25" />
    <circle cx="80" cy="45" r="0.6" fill="white" opacity="0.2" />
    <circle cx="45" cy="80" r="0.6" fill="white" opacity="0.2" />
  </svg>
</div>
