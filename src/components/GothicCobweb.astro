---
// Gothic cobweb decoration component for corners and standalone use
// Usage: <GothicCobweb position="top-left" /> or position="top-right" | "bottom-left" | "bottom-right"
// Variants: corner (clean), corner-frilly (messy/detailed), full (circular standalone)
interface Props {
  position?: 'top-left' | 'top-right' | 'bottom-left' | 'bottom-right';
  variant?: 'corner' | 'corner-frilly' | 'full';
  size?: 'sm' | 'md' | 'lg';
  opacity?: number;
}

const { position = 'top-left', variant = 'corner', size = 'md', opacity = 0.15 } = Astro.props;

const sizeMap = { sm: 100, md: 160, lg: 220 };
const svgSize = sizeMap[size];

// For corner variants, we use CSS transforms to mirror for right/bottom positions
const isRight = position === 'top-right' || position === 'bottom-right';
const isBottom = position === 'bottom-left' || position === 'bottom-right';

const positionClasses: Record<string, string> = {
  'top-left': 'top-0 left-0',
  'top-right': 'top-0 right-0',
  'bottom-left': 'bottom-0 left-0',
  'bottom-right': 'bottom-0 right-0',
};

const transforms: string[] = [];
if (isRight) transforms.push('scaleX(-1)');
if (isBottom) transforms.push('scaleY(-1)');
const transformStyle = transforms.length > 0 ? `transform: ${transforms.join(' ')};` : '';
---

<div
  class={`absolute ${positionClasses[position]} pointer-events-none z-[2]`}
  style={`opacity: ${opacity}; ${transformStyle}`}
>
  {variant === 'full' ? (
    <svg
      width={svgSize}
      height={svgSize}
      viewBox="-120 -120 240 240"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class="cobweb-svg"
      aria-label="Cobweb"
    >
      <g fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.95">
        <line x1="0" y1="0" x2="0" y2="-110" />
        <line x1="0" y1="0" x2="77.8" y2="-77.8" />
        <line x1="0" y1="0" x2="110" y2="0" />
        <line x1="0" y1="0" x2="77.8" y2="77.8" />
        <line x1="0" y1="0" x2="0" y2="110" />
        <line x1="0" y1="0" x2="-77.8" y2="77.8" />
        <line x1="0" y1="0" x2="-110" y2="0" />
        <line x1="0" y1="0" x2="-77.8" y2="-77.8" />
        <path d="M 0 -18 L 13 -13 L 18 0 L 13 13 L 0 18 L -13 13 L -18 0 L -13 -13 Z" />
        <path d="M 0 -36 L 26 -26 L 36 0 L 26 26 L 0 36 L -26 26 L -36 0 L -26 -26 Z" />
        <path d="M 0 -54 L 39 -39 L 54 0 L 39 39 L 0 54 L -39 39 L -54 0 L -39 -39 Z" />
        <path d="M 0 -72 L 52 -52 L 72 0 L 52 52 L 0 72 L -52 52 L -72 0 L -52 -52 Z" />
        <path d="M 0 -90 L 65 -65 L 90 0 L 65 65 L 0 90 L -65 65 L -90 0 L -65 -65 Z" />
        <path d="M 0 -108 L 78 -78 L 108 0 L 78 78 L 0 108 L -78 78 L -108 0 L -78 -78 Z" />
      </g>
    </svg>
  ) : variant === 'corner-frilly' ? (
    <svg
      width={svgSize}
      height={svgSize}
      viewBox="0 0 240 240"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class="cobweb-svg"
      aria-label="Cobweb corner frilly"
    >
      <g fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.95">
        <line x1="0" y1="0" x2="230" y2="0"/>
        <line x1="0" y1="0" x2="0" y2="230"/>
        <line x1="0" y1="0" x2="210" y2="70"/>
        <line x1="0" y1="0" x2="175" y2="125"/>
        <line x1="0" y1="0" x2="125" y2="175"/>
        <line x1="0" y1="0" x2="70" y2="210"/>
        <path d="M 35 0 A 35 35 0 0 1 0 35"/>
        <path d="M 60 0 A 60 60 0 0 1 0 62"/>
        <path d="M 88 0 A 88 88 0 0 1 0 92"/>
        <path d="M 118 0 A 118 118 0 0 1 0 126"/>
        <path d="M 150 0 A 150 150 0 0 1 0 160"/>
        <path d="M 184 0 A 184 184 0 0 1 0 196"/>
        <path d="M 60 0 L 48 20 L 30 45 L 0 62"/>
        <path d="M 118 0 L 90 35 L 60 70 L 0 126"/>
        <path d="M 184 0 L 120 55 L 80 105 L 0 196"/>
        <path d="M 92 24 C 85 35, 82 46, 86 60"/>
        <path d="M 86 60 C 90 72, 88 84, 78 96"/>
        <path d="M 58 92 C 66 104, 64 118, 52 130"/>
        <path d="M 150 38 C 142 52, 140 64, 146 80"/>
        <path d="M 146 80 C 152 98, 148 112, 132 126"/>
        <path d="M 38 150 C 52 146, 64 148, 78 156"/>
        <path d="M 78 156 C 94 166, 106 168, 122 164"/>
        <circle cx="60" cy="62" r="2" />
        <circle cx="90" cy="70" r="2" />
        <circle cx="120" cy="126" r="2" />
        <circle cx="70" cy="210" r="2" />
      </g>
    </svg>
  ) : (
    <svg
      width={svgSize}
      height={svgSize}
      viewBox="0 0 220 220"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class="cobweb-svg"
      aria-label="Cobweb corner"
    >
      <g fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.95">
        <line x1="0" y1="0" x2="210" y2="0"/>
        <line x1="0" y1="0" x2="0" y2="210"/>
        <line x1="0" y1="0" x2="180" y2="60"/>
        <line x1="0" y1="0" x2="150" y2="110"/>
        <line x1="0" y1="0" x2="110" y2="150"/>
        <line x1="0" y1="0" x2="60" y2="180"/>
        <path d="M 40 0 A 40 40 0 0 1 0 40"/>
        <path d="M 70 0 A 70 70 0 0 1 0 70"/>
        <path d="M 100 0 A 100 100 0 0 1 0 100"/>
        <path d="M 130 0 A 130 130 0 0 1 0 130"/>
        <path d="M 160 0 A 160 160 0 0 1 0 160"/>
        <path d="M 190 0 A 190 190 0 0 1 0 190"/>
        <path d="M 70 0 L 55 25 L 0 70"/>
        <path d="M 130 0 L 95 50 L 0 130"/>
        <path d="M 190 0 L 125 80 L 0 190"/>
      </g>
    </svg>
  )}
</div>
