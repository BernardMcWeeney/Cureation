---
interface Props {
  title: string;
  excerpt: string;
  slug: string;
  featuredImage?: string;
  category: string;
  publishedDate: string;
  formattedDate: string;
  readingTime?: number;
  featured?: boolean;
  authorName?: string;
}

const {
  title,
  excerpt,
  slug,
  featuredImage,
  category,
  publishedDate,
  formattedDate,
  readingTime,
  featured = false,
  authorName
} = Astro.props;

import { getCategoryColor } from '../config/categories.config';

const categoryClass = getCategoryColor(category.toLowerCase());
const fallbackImage = '/images/placeholder-blog.jpg';
---

<article class={`blog-card group ${featured ? 'featured' : ''}`}>
  <a
    href={`/blog/${slug}`}
    class="block h-full"
    aria-label={`Read article: ${title}`}
  >
    <div class="card-inner relative overflow-hidden h-full flex flex-col gothic-corners">
      <!-- Featured image -->
      <div class="relative aspect-[16/9] overflow-hidden">
        <img
          src={featuredImage || fallbackImage}
          alt=""
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          loading="lazy"
        />

        <!-- Gradient overlay -->
        <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent opacity-60 group-hover:opacity-80 transition-opacity duration-500"></div>

        <!-- Shine effect on hover -->
        <div class="absolute inset-0 bg-gradient-to-br from-white/10 via-transparent to-transparent opacity-80 group-hover:opacity-100 transition-opacity duration-500"></div>

        <!-- Category badge -->
        <div class={`absolute top-4 left-4 px-3 py-1 rounded-sm text-xs font-medium border ${categoryClass}`}>
          {category}
        </div>

        <!-- Reading time -->
        {readingTime && (
          <div class="absolute top-4 right-4 px-3 py-1 rounded-sm bg-black/60 backdrop-blur-lg border border-white/15 text-white/90 text-xs">
            {readingTime} min read
          </div>
        )}
      </div>

      <!-- Content -->
      <div class="flex-1 p-5 flex flex-col">
        <h3 class="font-heading text-xl md:text-2xl text-white mb-2 group-hover:text-white transition-colors duration-300 line-clamp-2">
          {title}
        </h3>

        <p class="text-white/85 text-sm mb-4 line-clamp-2 flex-1">
          {excerpt}
        </p>

        <div class="flex items-center justify-between mt-auto pt-4 border-t border-white/10">
          <div class="flex items-center gap-2">
            <time datetime={publishedDate} class="text-white/80 text-xs">
              {formattedDate}
            </time>
            {authorName && (
              <>
                <span class="text-white/20" aria-hidden="true">·</span>
                <span class="text-white/80 text-xs">{authorName}</span>
              </>
            )}
          </div>

          <div class="flex items-center gap-1.5 text-primary text-xs opacity-80 group-hover:opacity-100 transition-all duration-300">
            <span class="font-medium">Read</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </div>
        </div>
      </div>

      <!-- Border glow effect -->
      <div class="absolute inset-0 border border-white/10 group-hover:border-white/20/40 transition-colors duration-500 pointer-events-none"></div>
    </div>
  </a>
</article>

<style>
  .blog-card {
    --card-glow: rgba(var(--color-primary-rgb, 137, 176, 201), 0.4);
  }

  .card-inner {
    background: linear-gradient(
      145deg,
      rgba(var(--color-primary-rgb), 0.06) 0%,
      rgba(0, 0, 0, 0.55) 25%,
      rgba(0, 0, 0, 0.5) 100%
    );
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      inset 0 0 20px rgba(var(--color-primary-rgb), 0.03);
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
                box-shadow 0.5s ease,
                background 0.5s ease;
  }

  .blog-card:hover .card-inner {
    transform: translateY(-4px);
    background: linear-gradient(
      145deg,
      rgba(var(--color-primary-rgb), 0.1) 0%,
      rgba(0, 0, 0, 0.6) 25%,
      rgba(0, 0, 0, 0.55) 100%
    );
    box-shadow:
      0 20px 40px rgba(0, 0, 0, 0.5),
      0 0 60px var(--card-glow),
      0 4px 20px rgba(var(--color-primary-rgb), 0.15),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  /* Featured card styling */
  .blog-card.featured .card-inner {
    background: linear-gradient(
      145deg,
      rgba(var(--color-primary-rgb), 0.08) 0%,
      rgba(0, 0, 0, 0.6) 25%,
      rgba(0, 0, 0, 0.55) 100%
    );
    box-shadow:
      0 12px 40px rgba(0, 0, 0, 0.4),
      0 0 30px rgba(var(--color-primary-rgb), 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .blog-card.featured:hover .card-inner {
    box-shadow:
      0 24px 50px rgba(0, 0, 0, 0.5),
      0 0 80px var(--card-glow),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
  }
</style>
