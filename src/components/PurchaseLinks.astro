---
interface Props {
  spotifyUrl?: string;
  appleMusicUrl?: string;
  bandcampUrl?: string;
  amazonUrl?: string;
  officialStoreUrl?: string;
}

const { spotifyUrl, appleMusicUrl, bandcampUrl, amazonUrl, officialStoreUrl } = Astro.props;

const links = [
  { url: spotifyUrl, name: 'Spotify', color: '#1DB954', icon: 'spotify' },
  { url: appleMusicUrl, name: 'Apple Music', color: '#FC3C44', icon: 'apple' },
  { url: bandcampUrl, name: 'Bandcamp', color: '#1DA0C3', icon: 'bandcamp' },
  { url: amazonUrl, name: 'Amazon', color: '#FF9900', icon: 'amazon' },
  { url: officialStoreUrl, name: 'Official Store', color: '#FFFFFF', icon: 'store' },
].filter(l => l.url);

const hasLinks = links.length > 0;
---

{hasLinks && (
  <div class="glass-tile p-6">
    <h3 class="text-xs uppercase tracking-[0.16em] text-white/50 mb-4">Listen & Buy</h3>
    <div class="flex flex-wrap gap-3">
      {links.map(link => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-sm bg-white/[0.04] border border-white/10 text-white/80 hover:border-white/25 hover:bg-white/[0.08] transition-all duration-300 text-sm"
        >
          {link.icon === 'spotify' && (
            <svg class="size-4" style={`color: ${link.color}`} viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>
          )}
          {link.icon === 'apple' && (
            <svg class="size-4" style={`color: ${link.color}`} viewBox="0 0 24 24" fill="currentColor"><path d="M23.994 6.124a9.23 9.23 0 00-.24-2.19c-.317-1.31-1.062-2.31-2.18-3.043a5.022 5.022 0 00-1.877-.726 10.496 10.496 0 00-1.564-.15c-.04-.003-.083-.01-.124-.013H5.986c-.152.01-.303.017-.455.026-.747.043-1.49.123-2.193.4-1.336.53-2.3 1.452-2.865 2.78-.192.448-.292.925-.363 1.408-.056.392-.088.785-.1 1.18 0 .032-.007.062-.01.093v12.223c.01.14.017.283.027.424.05.815.154 1.624.497 2.373.65 1.42 1.738 2.353 3.234 2.802.42.127.856.187 1.297.228.468.043.937.065 1.407.066 3.69.004 7.378.002 11.066.002.39 0 .78-.01 1.17-.04.79-.06 1.57-.17 2.31-.5 1.42-.64 2.35-1.73 2.8-3.22.13-.42.19-.86.23-1.3.04-.47.06-.94.06-1.41V6.124zm-6.928 5.055v5.97c0 .497-.045.983-.218 1.45-.312.84-.945 1.354-1.815 1.573-.508.128-1.03.17-1.55.1-.96-.124-1.682-.66-2.045-1.57-.244-.608-.29-1.244-.103-1.878.273-.92.946-1.468 1.835-1.733.364-.108.74-.175 1.112-.24.38-.063.76-.126 1.13-.215.36-.087.543-.32.595-.684.013-.088.02-.178.02-.267V8.572c0-.145-.028-.272-.152-.37-.116-.092-.254-.1-.39-.074l-.06.015-5.7 1.29c-.095.022-.184.058-.19.174-.003.033-.01.064-.01.097v7.386c0 .492-.04.978-.207 1.446-.31.843-.94 1.36-1.812 1.58-.507.13-1.028.174-1.55.106-.963-.12-1.687-.655-2.054-1.564-.247-.61-.292-1.25-.104-1.885.275-.926.95-1.474 1.845-1.74.368-.11.748-.176 1.123-.243.376-.064.75-.128 1.118-.214.375-.088.553-.324.6-.7.008-.063.013-.128.013-.192V5.644c0-.395.108-.642.48-.76.056-.017.113-.032.17-.046L19.002 4.1c.237-.054.477-.1.72-.097.325.005.533.2.567.527.007.068.01.137.01.205v6.444h-.233z"/></svg>
          )}
          {link.icon === 'bandcamp' && (
            <svg class="size-4" style={`color: ${link.color}`} viewBox="0 0 24 24" fill="currentColor"><path d="M0 18.75l7.437-13.5H24l-7.438 13.5z"/></svg>
          )}
          {link.icon === 'amazon' && (
            <svg class="size-4" style={`color: ${link.color}`} viewBox="0 0 24 24" fill="currentColor"><path d="M.045 18.02c.072-.116.187-.124.348-.064 2.729 1.353 5.706 2.008 8.876 2.008 2.17 0 4.406-.41 6.676-1.29.076-.03.152-.063.228-.063.076 0 .151.015.227.063.151.076.212.197.151.348-.06.152-.182.272-.348.348-2.353.939-4.712 1.408-7.076 1.408-3.37 0-6.465-.772-9.276-2.317-.151-.076-.227-.197-.227-.348 0-.076.076-.152.152-.197l.269-.096zM23.004 17.27c-.152-.227-.348-.348-.697-.348-.227 0-.5.06-.818.152-1.97.575-3.483.863-4.545.863-.878 0-1.408-.227-1.56-.697-.076-.227-.038-.5.076-.818.038-.076.076-.152.076-.227 0-.152-.076-.227-.227-.227-.076 0-.152.038-.227.076-.818.575-1.257 1.257-1.257 2.008 0 .424.167.818.5 1.105.348.303.863.454 1.56.454 2.037 0 4.47-.621 7.3-1.863.076-.038.152-.076.227-.152.151-.076.227-.197.227-.348.036-.134-.037-.252-.108-.378l-.527.4z"/></svg>
          )}
          {link.icon === 'store' && (
            <svg class="size-4 text-white/60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"/><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"/><path d="M2 7h20"/></svg>
          )}
          {link.name}
        </a>
      ))}
    </div>
  </div>
)}
