---
// Album-themed decorative SVG elements inspired by The Cure's albums
// Subtle background decorations at very low opacity
interface Props {
  album: 'seventeen-seconds' | 'faith' | 'pornography' | 'disintegration';
  position?: 'left' | 'right' | 'background';
  opacity?: number;
}

const { album, position = 'background', opacity = 0.06 } = Astro.props;

const positionClasses: Record<string, string> = {
  left: 'absolute left-0 top-1/2 -translate-y-1/2 -translate-x-1/4',
  right: 'absolute right-0 top-1/2 -translate-y-1/2 translate-x-1/4',
  background: 'absolute inset-0 flex items-center justify-center',
};
---

<div class={`${positionClasses[position]} pointer-events-none z-0`} style={`opacity: ${opacity}`}>
  {album === 'seventeen-seconds' ? (
    <!-- Bare winter forest - 17 Seconds -->
    <svg width="400" height="300" viewBox="0 0 400 300" fill="none" xmlns="http://www.w3.org/2000/svg">
      <!-- Tree 1 - tall bare tree -->
      <line x1="80" y1="300" x2="80" y2="60" stroke="white" stroke-width="1.5" />
      <line x1="80" y1="120" x2="55" y2="80" stroke="white" stroke-width="0.8" />
      <line x1="55" y1="80" x2="42" y2="65" stroke="white" stroke-width="0.5" />
      <line x1="80" y1="140" x2="108" y2="100" stroke="white" stroke-width="0.8" />
      <line x1="108" y1="100" x2="118" y2="82" stroke="white" stroke-width="0.5" />
      <line x1="80" y1="180" x2="60" y2="150" stroke="white" stroke-width="0.6" />
      <line x1="80" y1="200" x2="100" y2="170" stroke="white" stroke-width="0.6" />
      <line x1="80" y1="90" x2="68" y2="70" stroke="white" stroke-width="0.6" />
      <line x1="80" y1="80" x2="95" y2="62" stroke="white" stroke-width="0.5" />

      <!-- Tree 2 - shorter, offset -->
      <line x1="180" y1="300" x2="180" y2="110" stroke="white" stroke-width="1.2" />
      <line x1="180" y1="160" x2="158" y2="130" stroke="white" stroke-width="0.7" />
      <line x1="158" y1="130" x2="148" y2="118" stroke="white" stroke-width="0.4" />
      <line x1="180" y1="180" x2="202" y2="148" stroke="white" stroke-width="0.7" />
      <line x1="180" y1="130" x2="195" y2="115" stroke="white" stroke-width="0.5" />
      <line x1="180" y1="140" x2="165" y2="120" stroke="white" stroke-width="0.5" />

      <!-- Tree 3 - distant, thinner -->
      <line x1="280" y1="300" x2="280" y2="90" stroke="white" stroke-width="1" />
      <line x1="280" y1="140" x2="262" y2="110" stroke="white" stroke-width="0.6" />
      <line x1="280" y1="160" x2="298" y2="130" stroke="white" stroke-width="0.6" />
      <line x1="280" y1="110" x2="270" y2="95" stroke="white" stroke-width="0.4" />
      <line x1="280" y1="120" x2="292" y2="100" stroke="white" stroke-width="0.4" />
      <line x1="280" y1="190" x2="268" y2="165" stroke="white" stroke-width="0.5" />

      <!-- Tree 4 - very distant background -->
      <line x1="340" y1="300" x2="340" y2="140" stroke="white" stroke-width="0.6" opacity="0.5" />
      <line x1="340" y1="180" x2="330" y2="162" stroke="white" stroke-width="0.4" opacity="0.4" />
      <line x1="340" y1="170" x2="350" y2="155" stroke="white" stroke-width="0.4" opacity="0.4" />

      <!-- Ground fog hint -->
      <line x1="0" y1="298" x2="400" y2="298" stroke="white" stroke-width="0.3" opacity="0.15" />
    </svg>
  ) : album === 'faith' ? (
    <!-- Ruined gothic church window - Faith -->
    <svg width="300" height="400" viewBox="0 0 300 400" fill="none" xmlns="http://www.w3.org/2000/svg">
      <!-- Gothic arch outline -->
      <path d="M80 380 L80 120 Q80 40, 150 40 Q220 40, 220 120 L220 380" stroke="white" stroke-width="1.5" fill="none" />
      <!-- Inner arch -->
      <path d="M100 380 L100 140 Q100 70, 150 70 Q200 70, 200 140 L200 380" stroke="white" stroke-width="0.8" fill="none" />
      <!-- Broken cross at top -->
      <line x1="150" y1="20" x2="150" y2="55" stroke="white" stroke-width="1" />
      <line x1="138" y1="32" x2="162" y2="32" stroke="white" stroke-width="1" />
      <!-- Crack/break in cross -->
      <line x1="150" y1="10" x2="148" y2="20" stroke="white" stroke-width="0.6" />
      <!-- Rose window circle -->
      <circle cx="150" cy="120" r="30" stroke="white" stroke-width="0.8" fill="none" />
      <circle cx="150" cy="120" r="18" stroke="white" stroke-width="0.5" fill="none" />
      <circle cx="150" cy="120" r="6" stroke="white" stroke-width="0.4" fill="none" />
      <!-- Rose window spokes -->
      <line x1="150" y1="90" x2="150" y2="102" stroke="white" stroke-width="0.4" />
      <line x1="150" y1="138" x2="150" y2="150" stroke="white" stroke-width="0.4" />
      <line x1="120" y1="120" x2="132" y2="120" stroke="white" stroke-width="0.4" />
      <line x1="168" y1="120" x2="180" y2="120" stroke="white" stroke-width="0.4" />
      <!-- Cracks in the wall -->
      <path d="M95 200 L105 215 L98 235" stroke="white" stroke-width="0.4" opacity="0.5" fill="none" />
      <path d="M210 180 L200 198 L205 220" stroke="white" stroke-width="0.4" opacity="0.5" fill="none" />
      <!-- Stone blocks hint -->
      <line x1="80" y1="200" x2="100" y2="200" stroke="white" stroke-width="0.3" opacity="0.3" />
      <line x1="200" y1="250" x2="220" y2="250" stroke="white" stroke-width="0.3" opacity="0.3" />
      <line x1="80" y1="300" x2="100" y2="300" stroke="white" stroke-width="0.3" opacity="0.3" />
    </svg>
  ) : album === 'pornography' ? (
    <!-- Thorny angular vines / shattered glass - Pornography -->
    <svg width="400" height="300" viewBox="0 0 400 300" fill="none" xmlns="http://www.w3.org/2000/svg">
      <!-- Shattered glass pattern -->
      <path d="M200 150 L240 80 L300 100" stroke="white" stroke-width="0.8" fill="none" />
      <path d="M200 150 L160 70 L100 90" stroke="white" stroke-width="0.8" fill="none" />
      <path d="M200 150 L250 200 L320 180" stroke="white" stroke-width="0.8" fill="none" />
      <path d="M200 150 L140 220 L80 200" stroke="white" stroke-width="0.8" fill="none" />
      <path d="M200 150 L200 60" stroke="white" stroke-width="0.6" fill="none" />
      <path d="M200 150 L200 250" stroke="white" stroke-width="0.6" fill="none" />
      <path d="M200 150 L300 150" stroke="white" stroke-width="0.6" fill="none" />
      <path d="M200 150 L100 150" stroke="white" stroke-width="0.6" fill="none" />
      <!-- Secondary fractures -->
      <path d="M240 80 L260 40" stroke="white" stroke-width="0.4" opacity="0.6" fill="none" />
      <path d="M160 70 L140 30" stroke="white" stroke-width="0.4" opacity="0.6" fill="none" />
      <path d="M250 200 L280 250" stroke="white" stroke-width="0.4" opacity="0.6" fill="none" />
      <path d="M140 220 L110 270" stroke="white" stroke-width="0.4" opacity="0.6" fill="none" />
      <!-- Thorny vine overlay -->
      <path d="M30 280 C80 260, 120 240, 160 260 C200 280, 240 220, 280 240 C320 260, 360 230, 380 250" stroke="white" stroke-width="0.6" fill="none" opacity="0.5" />
      <!-- Thorns -->
      <path d="M100 252 L95 242 L105 246" stroke="white" stroke-width="0.4" opacity="0.5" fill="none" />
      <path d="M180 268 L175 258 L185 262" stroke="white" stroke-width="0.4" opacity="0.5" fill="none" />
      <path d="M260 232 L255 222 L265 226" stroke="white" stroke-width="0.4" opacity="0.5" fill="none" />
      <path d="M340 242 L335 232 L345 236" stroke="white" stroke-width="0.4" opacity="0.5" fill="none" />
    </svg>
  ) : (
    <!-- Falling particles / dissolving shapes / rain - Disintegration -->
    <svg width="400" height="300" viewBox="0 0 400 300" fill="none" xmlns="http://www.w3.org/2000/svg">
      <!-- Rain-like vertical lines -->
      <line x1="50" y1="0" x2="50" y2="40" stroke="white" stroke-width="0.4" opacity="0.3" />
      <line x1="120" y1="20" x2="120" y2="80" stroke="white" stroke-width="0.3" opacity="0.25" />
      <line x1="180" y1="10" x2="180" y2="55" stroke="white" stroke-width="0.4" opacity="0.3" />
      <line x1="250" y1="30" x2="250" y2="90" stroke="white" stroke-width="0.3" opacity="0.2" />
      <line x1="310" y1="5" x2="310" y2="50" stroke="white" stroke-width="0.4" opacity="0.3" />
      <line x1="370" y1="25" x2="370" y2="65" stroke="white" stroke-width="0.3" opacity="0.25" />
      <line x1="80" y1="60" x2="80" y2="120" stroke="white" stroke-width="0.3" opacity="0.2" />
      <line x1="220" y1="50" x2="220" y2="100" stroke="white" stroke-width="0.3" opacity="0.2" />
      <line x1="350" y1="70" x2="350" y2="115" stroke="white" stroke-width="0.3" opacity="0.2" />
      <!-- Dissolving geometric shapes -->
      <rect x="160" y="100" width="40" height="40" stroke="white" stroke-width="0.5" opacity="0.3" fill="none" stroke-dasharray="4 3" />
      <rect x="165" y="105" width="30" height="30" stroke="white" stroke-width="0.3" opacity="0.2" fill="none" stroke-dasharray="2 4" />
      <!-- Scattered particles -->
      <circle cx="100" cy="180" r="1.5" fill="white" opacity="0.3" />
      <circle cx="140" cy="160" r="1" fill="white" opacity="0.25" />
      <circle cx="200" cy="200" r="2" fill="white" opacity="0.2" />
      <circle cx="260" cy="170" r="1" fill="white" opacity="0.3" />
      <circle cx="300" cy="190" r="1.5" fill="white" opacity="0.2" />
      <circle cx="80" cy="220" r="1" fill="white" opacity="0.15" />
      <circle cx="340" cy="210" r="1" fill="white" opacity="0.2" />
      <circle cx="160" cy="240" r="0.8" fill="white" opacity="0.15" />
      <circle cx="230" cy="250" r="1.2" fill="white" opacity="0.15" />
      <!-- Fading/dissolving lines -->
      <path d="M50 150 L90 148 L130 155 L170 145" stroke="white" stroke-width="0.3" opacity="0.2" fill="none" stroke-dasharray="6 4" />
      <path d="M230 160 L270 155 L310 165 L350 150" stroke="white" stroke-width="0.3" opacity="0.15" fill="none" stroke-dasharray="4 6" />
    </svg>
  )}
</div>
