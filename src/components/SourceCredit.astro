---
interface Props {
  sourceName?: string;
  sourceUrl?: string;
  imageCredit?: string;
}

const { sourceName, sourceUrl, imageCredit } = Astro.props;
const hasContent = sourceName || imageCredit;
---

{hasContent && (
  <div class="flex flex-wrap items-center gap-x-4 gap-y-1 pt-3 mt-4 border-t border-white/[0.06] text-xs text-white/35">
    {sourceName && (
      <span class="flex items-center gap-1.5">
        <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/>
        </svg>
        Source: {sourceUrl ? (
          <a href={sourceUrl} target="_blank" rel="noopener noreferrer" class="text-white/45 hover:text-primary/70 transition-colors underline decoration-white/15 underline-offset-2">
            {sourceName}
          </a>
        ) : (
          <span>{sourceName}</span>
        )}
      </span>
    )}
    {imageCredit && (
      <span class="flex items-center gap-1.5">
        <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
        </svg>
        Image: {imageCredit}
      </span>
    )}
  </div>
)}
