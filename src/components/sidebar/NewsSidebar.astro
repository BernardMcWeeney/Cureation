---
import type { NewsCategory, NewsPost } from '../../types/directus';

interface Props {
  categories: { name: string; slug: NewsCategory; count: number }[];
  activeCategory?: NewsCategory;
  recentPosts?: NewsPost[];
  totalPosts?: number;
}

const { categories, activeCategory, recentPosts = [], totalPosts = 0 } = Astro.props;

// Category icons
const categoryIcons: Record<string, string> = {
  news: `<svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" /></svg>`,
  reviews: `<svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" /></svg>`,
  interviews: `<svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" /></svg>`,
  rumors: `<svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
  editorials: `<svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>`
};
---

<div class="space-y-6">
  {/* Stats overview */}
  <div class="glass-surface p-5">
    <h3 class="text-lg font-heading text-white mb-4">News & Articles</h3>
    <div class="grid grid-cols-2 gap-4">
      <div class="glass-stat text-center p-3">
        <p class="text-2xl font-bold text-primary">{totalPosts}</p>
        <p class="text-xs text-white/50">Total Articles</p>
      </div>
      <div class="glass-stat text-center p-3">
        <p class="text-2xl font-bold text-primary">{categories.length}</p>
        <p class="text-xs text-white/50">Categories</p>
      </div>
    </div>
  </div>

  {/* Categories */}
  <div class="glass-surface p-5">
    <h3 class="text-lg font-heading text-white mb-4">Categories</h3>
    <nav aria-label="News categories">
      <ul class="space-y-1">
        <li>
          <a
            href="/news"
            class={`flex items-center gap-3 px-3 py-2 rounded-lg transition-all duration-300 ${
              !activeCategory
                ? 'bg-primary/20 text-primary border border-primary/40'
                : 'text-white/70 hover:text-white hover:bg-white/5'
            }`}
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
            </svg>
            <span class="flex-1">All Articles</span>
            <span class="text-xs text-white/40">{totalPosts}</span>
          </a>
        </li>
        {categories.map(cat => (
          <li>
            <a
              href={`/news/category/${cat.slug}`}
              class={`flex items-center gap-3 px-3 py-2 rounded-lg transition-all duration-300 ${
                activeCategory === cat.slug
                  ? 'bg-primary/20 text-primary border border-primary/40'
                  : 'text-white/70 hover:text-white hover:bg-white/5'
              }`}
            >
              <span set:html={categoryIcons[cat.slug] || categoryIcons.news} />
              <span class="flex-1">{cat.name}</span>
              <span class="text-xs text-white/40">{cat.count}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  {/* Recent posts */}
  {recentPosts.length > 0 && (
    <div class="glass-surface p-5">
      <h3 class="text-lg font-heading text-white mb-4">Recent Articles</h3>
      <ul class="space-y-4">
        {recentPosts.slice(0, 5).map(post => (
          <li>
            <a
              href={`/news/${post.slug}`}
              class="group block"
            >
              <div class="flex gap-3">
                {post.featuredImage && (
                  <div class="shrink-0 w-16 h-12 rounded-lg overflow-hidden">
                    <img
                      src={post.featuredImage}
                      alt=""
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                      loading="lazy"
                    />
                  </div>
                )}
                <div class="flex-1 min-w-0">
                  <h4 class="text-sm text-white/90 line-clamp-2 group-hover:text-primary transition-colors duration-300">
                    {post.title}
                  </h4>
                  <p class="text-xs text-white/40 mt-1">{post.formattedDate}</p>
                </div>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}

  {/* Subscribe CTA */}
  <div class="glass-elevated p-5 text-center">
    <h3 class="text-lg font-heading text-white mb-2">Stay Updated</h3>
    <p class="text-sm text-white/60 mb-4">Get the latest news delivered to your inbox.</p>
    <a
      href="/newsletter"
      class="glass-button inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm text-white hover:text-primary transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
      </svg>
      Subscribe
    </a>
  </div>
</div>

<style>
  .line-clamp-2 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
</style>
