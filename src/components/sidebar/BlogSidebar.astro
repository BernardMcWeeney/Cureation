---
// Sidebar for blog listing - category navigation with recent posts

interface RecentPost {
  title: string;
  slug: string;
  formattedDate: string;
  category: string;
}

interface Props {
  categories?: { name: string; slug: string; count: number }[];
  recentPosts?: RecentPost[];
  activeCategory?: string;
  totalPosts?: number;
}

const {
  categories = [],
  recentPosts = [],
  activeCategory,
  totalPosts = 0
} = Astro.props;

// Category colors for badges
const categoryColors: Record<string, string> = {
  news: 'text-blue-400',
  history: 'text-amber-400',
  analysis: 'text-purple-400',
  reviews: 'text-green-400',
  interviews: 'text-pink-400'
};
---

<aside class="sticky top-24 w-full space-y-6">
  <!-- Stats Overview -->
  <div class="backdrop-blur-xl bg-black/50 border border-white/12 rounded-xl p-4">
    <h2 class="font-heading text-xl text-primary mb-4">Blog</h2>
    <div class="text-center p-3 bg-black/40 border border-white/10 rounded-lg">
      <span class="block text-2xl font-display text-primary">{totalPosts}</span>
      <span class="text-xs text-white/50">Articles</span>
    </div>
  </div>

  <!-- Category Navigation -->
  {categories.length > 0 && (
    <div class="backdrop-blur-xl bg-black/50 border border-white/12 rounded-xl overflow-hidden">
      <div class="p-4 border-b border-white/10">
        <h3 class="font-heading text-xl text-primary">Categories</h3>
      </div>
      <nav class="p-2">
        <ul class="space-y-1">
          <li>
            <a
              href="/blog"
              class={`block px-4 py-2 rounded-lg transition-all duration-300 flex items-center justify-between ${
                !activeCategory
                  ? 'bg-primary/20 text-primary'
                  : 'text-white hover:bg-white/10 hover:text-primary'
              }`}
            >
              <span>All Posts</span>
              <span class="text-xs text-white/40">{totalPosts}</span>
            </a>
          </li>
          {categories.map((category) => (
            <li>
              <a
                href={`/blog/category/${category.slug}`}
                class={`block px-4 py-2 rounded-lg transition-all duration-300 flex items-center justify-between ${
                  activeCategory === category.slug
                    ? 'bg-primary/20 text-primary'
                    : 'text-white hover:bg-white/10 hover:text-primary'
                }`}
              >
                <span class="capitalize">{category.name}</span>
                <span class="text-xs text-white/40">{category.count}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  )}

  <!-- Recent Posts -->
  {recentPosts.length > 0 && (
    <div class="backdrop-blur-xl bg-black/50 border border-white/12 rounded-xl overflow-hidden">
      <div class="p-4 border-b border-white/10">
        <h3 class="font-heading text-xl text-primary">Recent Posts</h3>
      </div>
      <div class="p-3 space-y-3">
        {recentPosts.map((post) => (
          <a
            href={`/blog/${post.slug}`}
            class="block p-3 rounded-lg bg-black/40 hover:bg-black/50 border border-white/10 hover:border-primary/30 transition-all duration-300 group"
          >
            <h4 class="text-white text-sm group-hover:text-primary transition-colors line-clamp-2 mb-1">
              {post.title}
            </h4>
            <div class="flex items-center gap-2 text-xs">
              <span class={categoryColors[post.category.toLowerCase()] || 'text-primary'}>
                {post.category}
              </span>
              <span class="text-white/30">·</span>
              <span class="text-white/40">{post.formattedDate}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  )}

  <!-- Quick Links -->
  <div class="backdrop-blur-xl bg-black/50 border border-white/12 rounded-xl p-4">
    <h3 class="font-heading text-lg text-primary mb-3">Quick Links</h3>
    <div class="space-y-2">
      <a
        href="/discography"
        class="block px-3 py-2 rounded-lg bg-black/40 hover:bg-black/50 border border-white/10 hover:border-primary/30 text-white text-sm transition-all duration-300"
      >
        Browse Albums
      </a>
      <a
        href="/setlists"
        class="block px-3 py-2 rounded-lg bg-black/40 hover:bg-black/50 border border-white/10 hover:border-primary/30 text-white text-sm transition-all duration-300"
      >
        View Setlists
      </a>
      <a
        href="/lyrics"
        class="block px-3 py-2 rounded-lg bg-black/40 hover:bg-black/50 border border-white/10 hover:border-primary/30 text-white text-sm transition-all duration-300"
      >
        Browse Lyrics
      </a>
    </div>
  </div>
</aside>

<style>
  .line-clamp-2 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
</style>
