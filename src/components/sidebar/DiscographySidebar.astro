---
// Sidebar for discography listing pages - category navigation with functional era filters
import { eraMetadata } from '../../lib/directus';
import type { AlbumEra } from '../../types/directus';

interface Category {
  title: string;
  path: string;
  icon?: string;
}

interface Props {
  categories: Category[];
  activeCategory: string;
}

const { categories, activeCategory } = Astro.props;

// Era filters with colors
const eraFilters: { id: AlbumEra; name: string; years: string; color: string }[] = [
  { id: 'early', name: eraMetadata.early.name, years: eraMetadata.early.years, color: 'violet' },
  { id: 'pop', name: eraMetadata.pop.name, years: eraMetadata.pop.years, color: 'pink' },
  { id: 'classic', name: eraMetadata.classic.name, years: eraMetadata.classic.years, color: 'blue' },
  { id: 'experimental', name: eraMetadata.experimental.name, years: eraMetadata.experimental.years, color: 'amber' },
  { id: 'modern', name: eraMetadata.modern.name, years: eraMetadata.modern.years, color: 'green' }
];

// Category icons
const categoryIcons: Record<string, string> = {
  'Studio Albums': `<svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/></svg>`,
  'Live Albums': `<svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/></svg>`,
  'Compilations': `<svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>`,
  'Singles': `<svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v12M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/></svg>`,
  'B-sides': `<svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>`
};
---

<aside class="sticky top-24 w-full space-y-6">
  <!-- Category Navigation -->
  <div class="glass-surface rounded-xl overflow-hidden">
    <div class="px-4 py-3 border-b border-white/10">
      <h2 class="font-heading text-lg text-primary">Discography</h2>
    </div>
    <nav class="p-2">
      <ul class="space-y-1">
        {categories.map((category) => (
          <li>
            <a
              href={category.path}
              class={`flex items-center gap-3 px-4 py-2 rounded-lg transition-all duration-300 ${
                activeCategory === category.title
                  ? 'bg-white/10 text-primary'
                  : 'text-white hover:bg-white/10 hover:text-white'
              }`}
            >
              <span set:html={categoryIcons[category.title] || categoryIcons['Studio Albums']} />
              {category.title}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <!-- Era Filters -->
  <div class="glass-surface rounded-xl overflow-hidden">
    <div class="px-4 py-3 border-b border-white/10">
      <h3 class="font-heading text-lg text-primary">Filter by Era</h3>
    </div>
    <div class="p-3 space-y-2" id="era-filters">
      {eraFilters.map((era) => (
        <button
          type="button"
          data-era={era.id}
          class={`era-filter-btn w-full text-left px-3 py-2 bg-${era.color}-500/10 hover:bg-${era.color}-500/20 border border-${era.color}-500/20 hover:border-${era.color}-500/40 rounded-lg text-white transition-all duration-300 flex items-center justify-between group`}
        >
          <span class={`text-${era.color}-400 font-medium`}>{era.name}</span>
          <span class="text-xs text-white/80 group-hover:text-white/90">{era.years}</span>
        </button>
      ))}
      <button
        type="button"
        id="clear-era-filter"
        class="hidden w-full text-center px-3 py-2 bg-white/5 hover:bg-white/10 rounded-lg text-white/90 hover:text-white text-sm transition-all duration-300 mt-2"
      >
        Clear Filter
      </button>
    </div>
  </div>

  <!-- Album Stats -->
  <div class="glass-surface rounded-xl p-4">
    <h3 class="font-heading text-lg text-primary mb-3">Quick Stats</h3>
    <div class="space-y-2 text-sm">
      <div class="glass-stat p-2 rounded-lg flex justify-between">
        <span class="text-white/85">Years Active</span>
        <span class="text-white">1976 - Present</span>
      </div>
      <div class="glass-stat p-2 rounded-lg flex justify-between">
        <span class="text-white/85">Studio Albums</span>
        <span class="text-white">13</span>
      </div>
      <div class="glass-stat p-2 rounded-lg flex justify-between">
        <span class="text-white/85">Singles</span>
        <span class="text-white">40+</span>
      </div>
    </div>
  </div>

  <!-- Quick Links -->
  <div class="glass-surface rounded-xl p-4">
    <h3 class="font-heading text-lg text-primary mb-3">Related</h3>
    <div class="space-y-2">
      <a
        href="/lyrics"
        class="block px-3 py-2 rounded-lg glass-inset hover:bg-white/10 hover:border-white/15 text-white text-sm transition-all duration-300"
      >
        Browse Lyrics
      </a>
      <a
        href="/setlists"
        class="block px-3 py-2 rounded-lg glass-inset hover:bg-white/10 hover:border-white/15 text-white text-sm transition-all duration-300"
      >
        View Setlists
      </a>
      <a
        href="/stats"
        class="block px-3 py-2 rounded-lg glass-inset hover:bg-white/10 hover:border-white/15 text-white text-sm transition-all duration-300"
      >
        Statistics
      </a>
    </div>
  </div>
</aside>

<script>
  function initEraFilters() {
    const filterBtns = document.querySelectorAll('.era-filter-btn');
    const clearBtn = document.getElementById('clear-era-filter');
    const eraSections = document.querySelectorAll('.era-section');

    if (!filterBtns.length) return;

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const era = btn.getAttribute('data-era');

        // Update button states
        filterBtns.forEach((b) => b.classList.remove('ring-2', 'ring-primary'));
        btn.classList.add('ring-2', 'ring-primary');

        // Show clear button
        if (clearBtn) clearBtn.classList.remove('hidden');

        // Filter era sections
        eraSections.forEach((section) => {
          const sectionEra = section.getAttribute('data-era');
          if (sectionEra === era) {
            (section as HTMLElement).style.display = '';
            // Scroll to the section
            section.scrollIntoView({ behavior: 'smooth', block: 'start' });
          } else {
            (section as HTMLElement).style.display = 'none';
          }
        });

        // Also filter album cards for chronological view
        const albumCards = document.querySelectorAll('[data-album-era]');
        albumCards.forEach((card) => {
          const cardEra = card.getAttribute('data-album-era');
          if (cardEra === era) {
            (card as HTMLElement).style.display = '';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        // Reset button states
        filterBtns.forEach((b) => b.classList.remove('ring-2', 'ring-primary'));
        clearBtn.classList.add('hidden');

        // Show all era sections
        eraSections.forEach((section) => {
          (section as HTMLElement).style.display = '';
        });

        // Show all album cards
        const albumCards = document.querySelectorAll('[data-album-era]');
        albumCards.forEach((card) => {
          (card as HTMLElement).style.display = '';
        });
      });
    }
  }

  document.addEventListener('DOMContentLoaded', initEraFilters);
  document.addEventListener('astro:page-load', initEraFilters);
</script>
