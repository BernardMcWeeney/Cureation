---
// Sidebar for album detail pages - shows tracklist, album stats, related albums

interface Track {
  number: number;
  title: string;
  duration: string;
}

interface RelatedAlbum {
  title: string;
  slug: string;
  coverImage: string;
  year: string;
}

interface Props {
  album: {
    title: string;
    slug: string;
    coverImage: string;
    year: string;
  };
  tracks: Track[];
  relatedAlbums?: RelatedAlbum[];
}

const { album, tracks, relatedAlbums = [] } = Astro.props;

// Calculate total duration
const totalMinutes = tracks.reduce((acc, track) => {
  const parts = track.duration.split(':');
  const mins = parseInt(parts[0]) || 0;
  const secs = parseInt(parts[1]) || 0;
  return acc + mins + secs / 60;
}, 0);
const formattedDuration = `${Math.floor(totalMinutes)} min`;
---

<aside class="sticky top-24 w-full space-y-6">
  <!-- Album Stats -->
  <div class="glass-surface rounded-xl overflow-hidden">
    <div class="p-4 divider-theme border-b">
      <h2 class="font-heading text-xl text-primary">Album Info</h2>
    </div>
    <div class="p-4 grid grid-cols-2 gap-3 text-sm">
      <div class="glass-stat p-3 rounded-lg">
        <p class="text-white/60 text-xs">Tracks</p>
        <p class="text-white font-medium">{tracks.length}</p>
      </div>
      <div class="glass-stat p-3 rounded-lg">
        <p class="text-white/60 text-xs">Duration</p>
        <p class="text-white font-medium">{formattedDuration}</p>
      </div>
      <div class="glass-stat p-3 rounded-lg col-span-2">
        <p class="text-white/60 text-xs">Year</p>
        <p class="text-white font-medium">{album.year}</p>
      </div>
    </div>
  </div>

  <!-- Tracklist Navigation -->
  <div class="glass-surface rounded-xl overflow-hidden">
    <div class="p-4 divider-theme border-b">
      <h2 class="font-heading text-xl text-primary">Tracklist</h2>
    </div>
    <nav class="p-2 max-h-80 overflow-y-auto">
      <ul class="space-y-1">
        {tracks.map((track) => (
          <li>
            <a
              href={`/lyrics/${track.title.toLowerCase().replace(/[^\w\s]/gi, '').replace(/\s+/g, '-')}`}
              class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-white hover:bg-white/10 hover:text-primary transition-all duration-300"
            >
              <span class="text-white/50 w-5 text-right">{track.number}</span>
              <span class="flex-1 truncate">{track.title}</span>
              <span class="text-white/50 text-xs">{track.duration}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <!-- Related Albums -->
  {relatedAlbums.length > 0 && (
    <div class="glass-surface rounded-xl overflow-hidden">
      <div class="p-4 divider-theme border-b">
        <h2 class="font-heading text-xl text-primary">More Albums</h2>
      </div>
      <div class="p-3 space-y-2">
        {relatedAlbums.slice(0, 3).map((related) => (
          <a
            href={`/discography/${related.slug}`}
            class="flex items-center gap-3 p-2 rounded-lg hover:bg-white/10 transition-all duration-300 group"
          >
            <img
              src={related.coverImage}
              alt={related.title}
              class="w-10 h-10 rounded object-cover"
              loading="lazy"
            />
            <div class="flex-1 min-w-0">
              <p class="text-white text-sm truncate group-hover:text-primary transition-colors">{related.title}</p>
              <p class="text-white/50 text-xs">{related.year}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  )}
</aside>
