---
/**
 * Editorial search input — sibling to Select.astro.
 * Renders a labelled `<input type="search">` that matches the Select chrome
 * and wires into the page's filter script via [data-filter-search].
 */
interface Props {
  label?: string;
  placeholder?: string;
  name?: string;
  class?: string;
}
const { label = 'Search', placeholder = 'Search…', name = 'search', class: klass = '' } = Astro.props;
---
<label class={`select ${klass}`}>
  <span class="select__label">{label}</span>
  <span class="select__wrap">
    <input class="filter-search" type="search" name={name} placeholder={placeholder} data-filter-search />
  </span>
</label>
