---
interface Props {
  href?: string;
  active?: boolean;
  class?: string;
  [key: string]: any;
}
const { href, active = false, class: klass = '', ...attrs } = Astro.props;
const classes = ['chip', active ? 'is-active' : '', klass].filter(Boolean).join(' ');
---
{href ? (
  <a {...attrs} href={href} class={classes} aria-pressed={active ? 'true' : 'false'}><slot /></a>
) : (
  <button {...attrs} type="button" class={classes} aria-pressed={active ? 'true' : 'false'}><slot /></button>
)}

<style>
  a.chip { border-bottom-width: 1px; }
</style>
