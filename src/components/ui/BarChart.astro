---
interface Bar {
  label: string;
  sub?: string;
  value: number;
  href?: string;
}
interface Props {
  bars: Bar[];
  unit?: string;
  /** Maximum bars to render. Defaults to all. */
  limit?: number;
  /** Show numeric ranks. */
  showRank?: boolean;
}
const { bars, unit = '', limit, showRank = true } = Astro.props as Props;
const list = limit ? bars.slice(0, limit) : bars;
const max = Math.max(1, ...list.map(b => b.value));
---
<ol class="hbar" role="list">
  {list.map((b, i) => {
    const pct = (b.value / max) * 100;
    const Tag: any = b.href ? 'a' : 'div';
    return (
      <li class={`hbar__row${i < 3 ? ' hbar__row--top' : ''}`}>
        <Tag href={b.href} class="hbar__link">
          {showRank && <span class="hbar__rank mono-sm">{String(i + 1).padStart(2, '0')}</span>}
          <div class="hbar__body">
            <div class="hbar__head">
              <span class="hbar__label serif">{b.label}</span>
              {b.sub && <span class="hbar__sub mono-sm muted">{b.sub}</span>}
            </div>
            <div class="hbar__track" aria-hidden="true">
              <span class="hbar__fill" style={`width: ${pct}%`}></span>
            </div>
          </div>
          <span class="hbar__val mono">
            {b.value.toLocaleString()}{unit ? <span class="hbar__unit">{` ${unit}`}</span> : ''}
          </span>
        </Tag>
      </li>
    );
  })}
</ol>

<style>
  .hbar { display: grid; gap: 9px; list-style: none; margin: 0; padding: 0; }
  .hbar__row { min-width: 0; }
  .hbar__link {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(14px, 2vw, 24px);
    padding: clamp(13px, 1.6vw, 18px) clamp(13px, 1.6vw, 18px);
    background: color-mix(in srgb, var(--bg-2) 90%, var(--accent-tint));
    color: inherit;
    border: none;
    text-decoration: none;
    transition: color .18s;
  }
  .hbar__link:hover { color: var(--accent); background: var(--accent-tint); }
  :root[data-theme='papers'] .hbar__link:hover { color: var(--accent); }

  .hbar__rank {
    color: var(--muted);
    letter-spacing: 0.16em;
    text-align: right;
  }
  .hbar__row--top .hbar__rank { color: var(--accent-3); }
  :root[data-theme='papers'] .hbar__row--top .hbar__rank { color: var(--accent); }

  .hbar__body { min-width: 0; display: flex; flex-direction: column; gap: 8px; }
  .hbar__head {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 16px; flex-wrap: wrap;
  }
  .hbar__label {
    font-style: italic;
    font-size: clamp(17px, 1.6vw, 21px);
    line-height: 1.25;
    color: var(--ink);
  }
  .hbar__link:hover .hbar__label { color: var(--accent-3); }
  :root[data-theme='papers'] .hbar__link:hover .hbar__label { color: var(--accent); }
  .hbar__sub { letter-spacing: 0.16em; }

  .hbar__track {
    height: 4px;
    background: var(--rule-2);
    overflow: hidden;
    position: relative;
  }
  .hbar__fill {
    display: block; height: 100%;
    background: linear-gradient(to right, var(--accent-2), var(--accent));
    box-shadow: var(--glow);
    opacity: 0.78;
    transition: opacity .25s, box-shadow .25s;
  }
  .hbar__row--top .hbar__fill {
    background: linear-gradient(to right, var(--accent-2), var(--accent));
    opacity: 1;
  }
  .hbar__link:hover .hbar__fill { opacity: 1; box-shadow: 0 0 24px var(--accent); }

  .hbar__val {
    font-family: var(--f-mono);
    font-size: 13px;
    letter-spacing: 0.12em;
    color: var(--ink);
    text-align: right;
    font-variant-numeric: tabular-nums;
    min-width: 64px;
    align-self: center;
  }
  .hbar__unit { color: var(--muted); margin-left: 4px; }

  @media (max-width: 540px) {
    .hbar__link { grid-template-columns: 28px minmax(0, 1fr) auto; gap: 12px; }
    .hbar__label { font-size: 16px; }
  }
</style>
