---
interface Props {
  title: string;
  hideHeader?: boolean;
  kicker?: string;
  meta?: string;
  href?: string;
  id?: string;
}
const { title, kicker, meta, href, id, hideHeader = false } = Astro.props;
---
<section class="issue-section" id={id}>
  <div class="container">
    {!hideHeader && <header class="issue-section__head">
      <div class:list={['issue-section__intro', { 'issue-section__intro--solo': !kicker }]}>
        {kicker && <div class="kicker">{kicker}</div>}
        <h2 class="issue-section__title">
          {href ? <a href={href} style="border:none;">{title}</a> : title}
        </h2>
      </div>
      {meta && <div class="issue-section__meta">{meta}</div>}
    </header>}
    <slot />
  </div>
</section>
