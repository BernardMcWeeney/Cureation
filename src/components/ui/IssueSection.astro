---
interface Props {
  title: string;
  kicker?: string;
  meta?: string;
  href?: string;
  id?: string;
}
const { title, kicker, meta, href, id } = Astro.props;
---
<section class="issue-section" id={id}>
  <div class="container">
    <header class="issue-section__head">
      <div>
        {kicker && <div class="kicker" style="margin-bottom:.4rem">{kicker}</div>}
        <h2 class="issue-section__title">
          {href ? <a href={href} style="border:none;">{title}</a> : title}
        </h2>
      </div>
      {meta && <div class="issue-section__meta">{meta}</div>}
    </header>
    <slot />
  </div>
</section>
