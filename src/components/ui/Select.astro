---
/**
 * Editorial dropdown – styled native <select>.
 * Use for filters in place of chip grids when value list is long.
 */
interface Option { value: string; label: string; }
interface Props {
  label?: string;
  name: string;
  value?: string;
  options: Option[];
  class?: string;
  width?: string;
}
const { label, name, value = '', options, class: klass = '', width } = Astro.props;
---
<label class={`select ${klass}`} style={width ? `--select-w: ${width};` : undefined}>
  {label && <span class="select__label">{label}</span>}
  <span class="select__wrap">
    <select name={name} data-filter-select={name}>
      {options.map((o) => (
        <option value={o.value} selected={o.value === value}>{o.label}</option>
      ))}
    </select>
    <svg class="select__caret" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true">
      <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </span>
</label>
