---
import { editable, copyAttr } from '../../lib/visual-editing';
import Crumbs from './Crumbs.astro';

interface Crumb { label: string; href?: string; }
interface Fact { k: string; v: string | number; sub?: string }
interface Props {
  copyKeys?: { section?: string; title?: string; deck?: string };
  /** Section name shown in the small mono kicker (e.g. "Albums"). */
  section?: string;
  /** Big italic page title. Use the magazine voice, such as "Discography" or "The setlists". */
  title: string;
  /** Italic deck paragraph. */
  deck?: string;
  /** Breadcrumb items (Home → … → current). */
  crumbs?: Crumb[];
  /** Quick-fact strip rendered under the deck. */
  facts?: Fact[];
  /** Hide the bottom rule (when next section already provides one). */
  flush?: boolean;
}
const { section, title, deck, crumbs = [], facts = [], flush = false, copyKeys = {} } = Astro.props;
---
<section class={`page-hero${flush ? ' page-hero--flush' : ''}`} data-reflection={title.toUpperCase()}>
  <div class="container">
    <div class:list={["page-hero__mast", { "page-hero__mast--simple": !deck }]}>
      <div class="page-hero__headline">
        {crumbs.length > 0 && <Crumbs items={crumbs} />}
        <h1 data-directus={copyKeys.title ? copyAttr(copyKeys.title) : undefined} class="page-hero__title">{title}</h1>
      </div>
      {deck && <p data-directus={copyKeys.deck ? copyAttr(copyKeys.deck) : undefined} class="page-hero__deck deck">{deck}</p>}
    </div>
    {facts.length > 0 && (
      <dl class="page-hero__facts">
        {facts.map((f) => (
          <div class="page-hero__fact">
            <dt data-directus={editable(f, ["k"])} class="mono-sm">{f.k}</dt>
            <dd  class="page-hero__fact-v">
              {typeof f.v === 'number' ? f.v.toLocaleString() : f.v}
              {f.sub && <span data-directus={editable(f, ["sub"])} class="page-hero__fact-sub mono-sm muted">{f.sub}</span>}
            </dd>
          </div>
        ))}
      </dl>
    )}
    <slot />
  </div>
</section>

<style is:global>
  .page-hero {
    padding: 0;
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(circle at 88% 8%, var(--accent-tint-2), transparent 32%),
      linear-gradient(135deg, var(--violet-tint), transparent 44%),
      var(--bg);
  }
  .page-hero::after {
    content: attr(data-reflection);
    position: absolute;
    z-index: 0;
    right: -0.03em;
    bottom: -0.15em;
    pointer-events: none;
    color: var(--accent-tint);
    font-family: var(--f-ui);
    font-size: clamp(72px, 15vw, 220px);
    font-weight: 600;
    letter-spacing: -.08em;
    line-height: .8;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .page-hero > .container {
    position: relative;
    z-index: 1;
    padding-block: clamp(28px, 4vw, 48px);
  }
  .page-hero--flush > .container { padding-bottom: clamp(28px, 4vw, 48px); }
  .page-hero .crumbs {
    margin-bottom: clamp(14px, 1.8vw, 22px);
    color: var(--accent);
    font-size: var(--text-label);
    letter-spacing: .1em;
  }
  .page-hero .crumbs__list { gap: .72em; }
  .page-hero .crumbs a,
  .page-hero .crumbs [aria-current='page'] { color: var(--accent); }
  .page-hero .crumbs a:hover { color: var(--ink); }
  .page-hero .crumbs__item + .crumbs__item::before {
    margin-right: .72em;
    color: var(--accent);
    content: '·';
  }
  .page-hero__mast {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, .65fr);
    gap: clamp(34px, 7vw, 112px);
    align-items: end;
  }
  .page-hero__mast--simple { grid-template-columns: 1fr; }
  .page-hero__title {
    font-family: var(--f-display);
    font-style: normal;
    font-weight: 400;
    font-size: clamp(48px, 7vw, 88px);
    line-height: 1;
    letter-spacing: -0.065em;
    margin: 0;
    color: var(--ink);
    text-wrap: balance;
  }
  .page-hero__title em { color: var(--accent-3); font-style: italic; }
  :root[data-theme='papers'] .page-hero__title em { color: var(--accent); }

  .page-hero__deck {
    margin: 0;
    max-width: 42ch;
    padding-bottom: .35rem;
    color: var(--ink-2);
    font-size: clamp(18px, 1.55vw, 22px);
    line-height: 1.55;
  }

  .page-hero__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: clamp(16px, 3vw, 46px);
    margin: 24px 0 0;
    padding: 0;
    border-top: 1px solid var(--rule-strong);
  }
  .page-hero__fact {
    position: relative;
    padding: clamp(18px, 2.2vw, 28px) 0 0;
    min-width: 0;
  }
  .page-hero__fact::before { position: absolute; top: -1px; left: 0; width: 38px; height: 2px; content: ''; background: var(--accent); }
  .page-hero__fact dt {
    color: var(--muted);
    margin-bottom: 8px;
    letter-spacing: .1em;
  }
  .page-hero__fact-v {
    margin: 0;
    font-family: var(--f-display);
    font-style: normal;
    font-weight: 400;
    font-size: clamp(22px, 2.5vw, 30px);
    line-height: 1;
    letter-spacing: -0.015em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap;
  }
  :root[data-theme='papers'] .page-hero__fact-v { color: var(--accent); }
  .page-hero__fact-sub {
    font-style: normal;
    font-weight: 400;
    letter-spacing: .1em;
    color: var(--accent-3);
    font-size: var(--text-label);
  }
  :root[data-theme='papers'] .page-hero__fact-sub { color: var(--accent); }

  @media (max-width: 720px) {
    .page-hero__mast { grid-template-columns: 1fr; gap: 28px; }
    .page-hero__mast--simple { grid-template-columns: 1fr; }
  .page-hero__title { font-size: clamp(44px, 12vw, 72px); }
    .page-hero__facts { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 420px) {
    .page-hero__facts { grid-template-columns: 1fr; }
  }
</style>
