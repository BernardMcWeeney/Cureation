---
import type { AlbumType } from '../types/directus';

const typeLabels: Record<string, string> = {
  studio: 'Studio Album',
  live: 'Live Album',
  compilation: 'Compilation',
  ep: 'EP',
  single: 'Single',
  deluxe: 'Deluxe Edition',
  reissue: 'Reissue',
  boxset: 'Box Set',
  soundtrack: 'Soundtrack',
  remix: 'Remix Album',
};

interface Props {
  title: string;
  coverImage: string;
  year: string;
  slug: string;
  featured?: boolean;
  id?: string;
  type?: AlbumType;
}

const { title, coverImage, year, slug, featured = false, id, type = 'studio' } = Astro.props;
const typeLabel = typeLabels[type] || 'Album';
---

<a
  href={`/discography/${slug}`}
  class={`album-card group block ${featured ? 'featured' : ''}`}
  data-theme={slug}
>
  <div class="card-inner relative overflow-hidden h-full gothic-corners">
    <!-- Album artwork -->
    <div class="relative aspect-square overflow-hidden">
      <img
        src={coverImage}
        alt={`Cover art for ${title}`}
        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
        loading="lazy"
      />

      <!-- Gradient overlay -->
      <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent opacity-60 group-hover:opacity-80 transition-opacity duration-500"></div>

      <!-- Subtle shine -->
      <div class="absolute inset-0 bg-gradient-to-br from-white/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
    </div>

    <!-- Content overlay at bottom - year always bottom-right -->
    <div class="absolute bottom-0 left-0 right-0 p-4 md:p-5">
      <div class="flex items-end justify-between gap-2">
        <div class="flex-1 min-w-0">
          <h3 class="font-display text-3xl md:text-4xl text-white mb-1 group-hover:text-glow transition-all duration-300 text-shadow-strong truncate">
            {title}
          </h3>
          <span class="text-white/60 text-xs font-medium tracking-wider uppercase text-shadow">{typeLabel}</span>
        </div>

        <!-- Year badge - always bottom right -->
        <div class="flex-shrink-0 px-2.5 py-1 rounded-sm bg-black/60 backdrop-blur-lg border border-white/10 text-white/80 text-xs font-medium tracking-wider">
          {year}
        </div>
      </div>

      <!-- Explore arrow on hover -->
      <div class="flex items-center gap-2 text-primary opacity-0 group-hover:opacity-100 translate-x-2 group-hover:translate-x-0 transition-all duration-300 mt-2">
        <span class="text-xs font-medium tracking-wider uppercase">Explore</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </div>
    </div>

    <!-- Border frame -->
    <div class="absolute inset-0 border border-white/[0.08] group-hover:border-primary/30 transition-colors duration-500 pointer-events-none"></div>
  </div>
</a>

<style>
  .album-card {
    --card-glow: rgba(var(--color-primary-rgb, 137, 176, 201), 0.3);
  }

  .card-inner {
    background: linear-gradient(
      145deg,
      rgba(var(--color-primary-rgb), 0.06) 0%,
      rgba(0, 0, 0, 0.6) 30%,
      rgba(0, 0, 0, 0.55) 100%
    );
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.5),
      inset 0 1px 0 rgba(255, 255, 255, 0.04);
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
                box-shadow 0.5s ease,
                background 0.5s ease;
  }

  .album-card:hover .card-inner {
    transform: translateY(-6px);
    background: linear-gradient(
      145deg,
      rgba(var(--color-primary-rgb), 0.1) 0%,
      rgba(0, 0, 0, 0.65) 30%,
      rgba(0, 0, 0, 0.6) 100%
    );
    box-shadow:
      0 20px 40px rgba(0, 0, 0, 0.6),
      0 0 50px var(--card-glow),
      0 4px 20px rgba(var(--color-primary-rgb), 0.15),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .album-card.featured .card-inner {
    box-shadow:
      0 12px 40px rgba(0, 0, 0, 0.5),
      0 0 30px rgba(var(--color-primary-rgb), 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .album-card.featured:hover .card-inner {
    box-shadow:
      0 24px 50px rgba(0, 0, 0, 0.6),
      0 0 70px var(--card-glow),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  .text-shadow {
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8),
                 0 1px 2px rgba(0, 0, 0, 0.6);
  }

  .text-shadow-strong {
    text-shadow: 0 3px 8px rgba(0, 0, 0, 0.95),
                 0 2px 4px rgba(0, 0, 0, 0.9),
                 0 1px 2px rgba(0, 0, 0, 0.8);
  }

  .group:hover h3 {
    text-shadow: 0 0 30px var(--card-glow),
                 0 3px 8px rgba(0, 0, 0, 0.9);
  }
</style>
