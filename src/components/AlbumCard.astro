---
// Album Card Component - for discography page
interface Props {
  title: string;
  coverImage: string;
  year: string;
  slug: string;
  featured?: boolean;
}

const { title, coverImage, year, slug, featured = false } = Astro.props;
---

<a 
  href={`/discography/${slug}`}
  class={`group block ${featured ? 'col-span-1 md:col-span-2 row-span-1 md:row-span-2' : ''}`}
  data-theme={slug}
>
  <div class="glass-card relative overflow-hidden transition-all duration-300 hover-lift h-full rounded-xl">
    <div class="relative aspect-square overflow-hidden rounded-t-xl">
      <img 
        src={coverImage} 
        alt={`Cover art for ${title}`} 
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
      
      <!-- Gradient overlay -->
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent"></div>
    </div>
    
    <!-- Content section -->
    <div class="p-4 backdrop-blur-sm bg-black/30 rounded-b-xl">
      <h3 class="font-display text-3xl text-white mb-1">{title}</h3>
      <p class="text-white/70 text-sm">{year}</p>
      
      <div class="mt-3 flex items-center gap-2">
        <span class="text-xs text-white/60">View details</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </div>
    </div>
  </div>
</a>

<style>
  /* Card hover effect - theme-based glow */
  .glass-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    opacity: 0;
    box-shadow: 
      0 0 25px 0 color-mix(in oklab, var(--color-primary) 40%, transparent),
      0 0 15px 0 color-mix(in oklab, var(--color-primary) 20%, transparent);
    transition: opacity 0.3s ease;
    pointer-events: none;
    z-index: 1;
  }
  
  .glass-card:hover::after {
    opacity: 1;
  }
  
  /* Lift effect on hover */
  .hover-lift {
    transition: transform 0.3s var(--ease-out);
  }
  
  .hover-lift:hover {
    transform: translateY(-4px);
  }
</style>