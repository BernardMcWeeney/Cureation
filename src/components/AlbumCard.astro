---
interface Props {
  title: string;
  coverImage: string;
  year: string;
  slug: string;
  featured?: boolean;
  id?: string;
}

const { title, coverImage, year, slug, featured = false, id } = Astro.props;
---

<a
  href={`/discography/${slug}`}
  class={`album-card group block ${featured ? 'featured' : ''}`}
  data-theme={slug}
>
  <div class="card-inner relative overflow-hidden rounded-2xl h-full">
    <!-- Album artwork -->
    <div class="relative aspect-square overflow-hidden">
      <img
        src={coverImage}
        alt={`Cover art for ${title}`}
        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
        loading="lazy"
      />

      <!-- Multi-layer gradient overlay -->
      <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent opacity-60 group-hover:opacity-80 transition-opacity duration-500"></div>

      <!-- Shine effect on hover -->
      <div class="absolute inset-0 bg-gradient-to-br from-white/10 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

      <!-- Year badge -->
      <div class="absolute top-4 right-4 px-3 py-1 rounded-full bg-black/60 backdrop-blur-lg border border-white/15 text-white/90 text-xs font-medium">
        {year}
      </div>
    </div>

    <!-- Content overlay at bottom -->
    <div class="absolute bottom-0 left-0 right-0 p-5 md:p-6">
      <h3 class="font-display text-3xl md:text-4xl text-white mb-2 group-hover:text-glow transition-all duration-300 text-shadow-strong">
        {title}
      </h3>

      <div class="flex items-center justify-between">
        <span class="text-white/80 text-sm font-medium text-shadow">Studio Album</span>
        <div class="flex items-center gap-2 text-primary opacity-0 group-hover:opacity-100 translate-x-2 group-hover:translate-x-0 transition-all duration-300">
          <span class="text-sm font-semibold">Explore</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </div>
      </div>
    </div>

    <!-- Border glow effect -->
    <div class="absolute inset-0 rounded-2xl border border-white/10 group-hover:border-primary/40 transition-colors duration-500 pointer-events-none"></div>
  </div>
</a>

<style>
  .album-card {
    --card-glow: rgba(var(--color-primary-rgb, 137, 176, 201), 0.4);
  }

  .card-inner {
    background: linear-gradient(
      145deg,
      rgba(var(--color-primary-rgb), 0.08) 0%,
      rgba(0, 0, 0, 0.55) 30%,
      rgba(0, 0, 0, 0.5) 100%
    );
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      inset 0 0 30px rgba(var(--color-primary-rgb), 0.04);
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
                box-shadow 0.5s ease,
                background 0.5s ease;
  }

  .album-card:hover .card-inner {
    transform: translateY(-8px);
    background: linear-gradient(
      145deg,
      rgba(var(--color-primary-rgb), 0.12) 0%,
      rgba(0, 0, 0, 0.6) 30%,
      rgba(0, 0, 0, 0.55) 100%
    );
    box-shadow:
      0 20px 40px rgba(0, 0, 0, 0.5),
      0 0 60px var(--card-glow),
      inset 0 1px 0 rgba(255, 255, 255, 0.1),
      inset 0 0 40px rgba(var(--color-primary-rgb), 0.06);
  }

  /* Featured card styling */
  .album-card.featured .card-inner {
    background: linear-gradient(
      145deg,
      rgba(var(--color-primary-rgb), 0.1) 0%,
      rgba(0, 0, 0, 0.6) 30%,
      rgba(0, 0, 0, 0.55) 100%
    );
    box-shadow:
      0 12px 40px rgba(0, 0, 0, 0.4),
      0 0 40px rgba(var(--color-primary-rgb), 0.15),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .album-card.featured:hover .card-inner {
    box-shadow:
      0 24px 50px rgba(0, 0, 0, 0.5),
      0 0 80px var(--card-glow),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
  }

  /* Text shadow for accessibility */
  .text-shadow {
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8),
                 0 1px 2px rgba(0, 0, 0, 0.6);
  }

  .text-shadow-strong {
    text-shadow: 0 3px 8px rgba(0, 0, 0, 0.95),
                 0 2px 4px rgba(0, 0, 0, 0.9),
                 0 1px 2px rgba(0, 0, 0, 0.8);
  }

  /* Text glow on hover */
  .group:hover h3 {
    text-shadow: 0 0 30px var(--card-glow),
                 0 3px 8px rgba(0, 0, 0, 0.9);
  }
</style>
