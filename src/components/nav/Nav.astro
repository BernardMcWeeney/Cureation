---
const current = Astro.url.pathname;
const links: Array<{ href: string; label: string }> = [
  { href: '/discography', label: 'Discography' },
  { href: '/setlists',    label: 'Live' },
  { href: '/songs',       label: 'Songs' },
  { href: '/band',        label: 'Band' },
  { href: '/wiki',        label: 'Wiki' },
  { href: '/news',        label: 'News' },
  { href: '/photos',      label: 'Photos' },
  { href: '/stats',       label: 'Stats' },
];
function isActive(href: string) {
  if (href === '/') return current === '/';
  return current === href || current.startsWith(href + '/');
}
---
<header class="nav" data-sticky>
  <div class="container nav__row">
    <a href="/" class="nav__brand" aria-label="Cureation — home">
      <span class="nav__brand-mark" aria-hidden="true">C</span>
      <span class="nav__brand-name">Cureation</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {links.map((l) => (
        <a
          href={l.href}
          class={`nav__link ${isActive(l.href) ? 'is-active' : ''}`}
        >{l.label}</a>
      ))}
    </nav>

    <div class="nav__utility">
      <button class="nav__icon" data-search-open aria-label="Open search (⌘K)">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
        </svg>
      </button>
      <button class="nav__icon nav__icon--desk" data-theme-toggle aria-label="Toggle theme">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/>
        </svg>
      </button>
      <button class="nav__icon nav__menu" data-menu-open aria-label="Open menu" aria-expanded="false" aria-controls="site-menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 40;
    background: color-mix(in oklab, var(--bg), transparent 20%);
    backdrop-filter: saturate(140%) blur(10px);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid var(--rule);
  }
  .nav__row {
    display: flex; align-items: center; justify-content: space-between;
    gap: clamp(12px, 2vw, 24px); padding: 14px 0; min-height: 64px;
  }
  .nav__brand {
    display: inline-flex; align-items: center; gap: 10px;
    font-family: var(--f-display); font-style: italic; font-size: clamp(20px, 2.4vw, 24px);
    color: var(--ink); border: none; flex-shrink: 0;
  }
  .nav__brand-mark {
    display: inline-flex; align-items: center; justify-content: center;
    width: 30px; height: 30px; border: 1px solid var(--accent);
    color: var(--accent-3); background: var(--accent-tint-2);
    font-family: var(--f-display); font-style: italic; font-size: 18px;
    line-height: 1;
  }
  :root[data-theme='papers'] .nav__brand-mark { color: var(--accent); }
  .nav__brand-name { letter-spacing: 0.01em; }

  .nav__links {
    display: flex; gap: clamp(.9rem, 1.6vw, 1.6rem); align-items: center;
    flex: 1; justify-content: center;
  }
  .nav__link {
    font-family: var(--f-mono); font-size: 11px;
    letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--ink-2); border: none; padding: 6px 0;
    border-bottom: 1px solid transparent;
    white-space: nowrap;
    transition: color .18s, border-color .18s;
  }
  .nav__link:hover { color: var(--ink); border-bottom-color: var(--rule-strong); }
  .nav__link.is-active { color: var(--accent-3); border-bottom-color: var(--accent); }
  :root[data-theme='papers'] .nav__link.is-active { color: var(--accent); }

  .nav__utility { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
  .nav__icon {
    width: 40px; height: 40px; display: inline-flex; align-items: center;
    justify-content: center; background: transparent; color: var(--ink-2);
    border: 1px solid var(--rule); cursor: pointer; transition: all .18s;
  }
  .nav__icon:hover { color: var(--accent-3); border-color: var(--accent); background: transparent; }
  :root[data-theme='papers'] .nav__icon:hover { color: var(--accent); }
  .nav__icon:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .nav__menu { display: none; }

  /* Tablet + mobile: single menu button, hide inline links + desk-only icons */
  @media (max-width: 960px) {
    .nav__links { display: none; }
    .nav__icon--desk { display: none; }
    .nav__menu { display: inline-flex; }
  }
</style>
