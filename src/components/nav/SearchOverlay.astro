---
// ⌘K overlay. Queries /api/search.json?q= on keyup.
import { DIRECTUS_URL } from '../../lib/directus';
---
<script is:inline define:vars={{ DIRECTUS_URL }}>
  window.__CUREATION_DIRECTUS_URL = DIRECTUS_URL;
</script>
<div class="search" data-search hidden role="dialog" aria-modal="true" aria-label="Search">
  <div class="search__backdrop" data-search-close></div>
  <div class="search__panel container">
    <div class="search__head">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
      </svg>
      <input
        type="search"
        data-search-input
        placeholder="Search albums, songs, venues…"
        autocomplete="off"
      />
      <span class="kicker">ESC</span>
    </div>
    <div class="search__results" data-search-results>
      <p class="search__hint">Type to search across the archive.</p>
    </div>
  </div>
</div>

<style is:global>
  .search {
    position: fixed; inset: 0; z-index: 70;
    display: flex; flex-direction: column;
    padding-top: clamp(24px, 8vh, 120px);
  }
  .search[hidden] { display: none; }
  .search__backdrop {
    position: absolute; inset: 0;
    background: color-mix(in oklab, var(--bg), transparent 20%);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .search__panel {
    position: relative;
    background: var(--bg-2);
    border: 1px solid var(--rule);
    padding: 0;
    max-width: 720px;
    margin: 0 auto;
    box-shadow: var(--shadow-2);
    max-height: calc(100dvh - 48px);
    display: flex; flex-direction: column;
  }
  .search__head {
    display: flex; align-items: center; gap: 12px;
    padding: 14px 18px; border-bottom: 1px solid var(--rule);
    color: var(--ink-2);
  }
  .search__head input {
    flex: 1; background: transparent; border: none; outline: none;
    color: var(--ink); font-family: var(--f-serif); font-size: 18px;
    min-width: 0;
  }
  .search__head .kicker { flex-shrink: 0; }
  .search__results { padding: 12px 18px 18px; overflow-y: auto; -webkit-overflow-scrolling: touch; }
  .search__hint { color: var(--muted); font-family: var(--f-mono); font-size: 11px; letter-spacing: .18em; text-transform: uppercase; margin: 0; }
  .search__group { margin-top: 18px; }
  .search__group:first-child { margin-top: 0; }
  .search__group-title {
    font-family: var(--f-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: .24em;
    text-transform: uppercase;
    color: var(--accent-3);
    padding: 0 0 .4rem;
    margin: 0 0 .25rem;
    border-bottom: 1px solid var(--rule);
  }
  .search__result {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 12px;
    padding: 7px 0;
    border-bottom: 1px solid var(--rule-2);
    font-family: var(--f-serif);
    font-size: 15px;
    line-height: 1.25;
    color: var(--ink);
    text-decoration: none;
  }
  .search__result:last-child { border-bottom: 0; }
  .search__result:hover { color: var(--accent-3); }
  .search__result em { font-family: var(--f-display); font-style: italic; color: var(--accent-3); }
  .search__title {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .search__meta {
    flex: 0 0 auto;
    font-family: var(--f-mono);
    font-size: 10.5px;
    color: var(--muted);
    white-space: nowrap;
    text-transform: uppercase;
    letter-spacing: .12em;
  }
  .search__cover {
    flex: 0 0 32px;
    width: 32px;
    height: 32px;
    border-radius: 2px;
    object-fit: cover;
    background: var(--bg);
    border: 1px solid var(--rule);
    display: block;
  }
  .search__cover--empty { background: var(--bg); }

  .search__result--lyric { align-items: flex-start; padding: 9px 0; }
  .search__title--lyric {
    display: flex;
    flex-direction: column;
    gap: 2px;
    white-space: normal;
  }
  .search__snippet {
    font-style: italic;
    font-size: 14.5px;
    line-height: 1.3;
    color: var(--ink);
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
  }
  .search__sub {
    font-family: var(--f-mono);
    font-size: 10px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .search__result mark {
    background: var(--accent-tint);
    color: var(--accent-3);
    padding: 0 2px;
    border-radius: 1px;
  }

  .search__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
    margin-top: 4px;
  }
  .search__chip {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 8px 10px;
    border: 1px solid var(--rule);
    border-radius: 2px;
    text-decoration: none;
    color: var(--ink);
    min-width: 0;
    transition: border-color .18s, color .18s;
  }
  .search__chip:hover { border-color: var(--accent); color: var(--accent-3); }
  .search__chip-title {
    font-family: var(--f-serif);
    font-style: italic;
    font-size: 14px;
    line-height: 1.2;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .search__chip-meta {
    font-family: var(--f-mono);
    font-size: 10px;
    letter-spacing: .12em;
    color: var(--muted);
  }
  @media (max-width: 540px) {
    .search__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .search { padding-top: 0; }
    .search__panel { max-width: 100%; border-left: 0; border-right: 0; border-top: 0; max-height: 100dvh; height: 100dvh; }
    .search__head .kicker { display: none; }
  }
</style>

<script>
  type Results = {
    albums: Array<{ title: string; slug: string; type: string; cover_art: string | null }>;
    songs:  Array<{ title: string; slug: string; cover_art: string | null; album_title: string | null }>;
    lyrics: Array<{ title: string; slug: string; cover_art: string | null; album_title: string | null; snippet: string }>;
    setlists: Array<{ id: number; date: string | null; venue: string | null; venue_link: any }>;
    venues: Array<{ name: string; slug: string | null; city: string | null; country: string | null }>;
  };

  const directusUrl = (window as any).__CUREATION_DIRECTUS_URL || '';
  const cover = (id: string | null | undefined): string => id
    ? `${directusUrl}/assets/${id}?width=64&height=64&fit=cover&quality=70&format=auto`
    : '';
  const thumb = (id: string | null | undefined, alt = ''): string => id
    ? `<img class="search__cover" src="${cover(id)}" alt="${esc(alt)}" loading="lazy" />`
    : `<span class="search__cover search__cover--empty" aria-hidden="true"></span>`;
  const highlight = (text: string, query: string): string => {
    if (!query) return esc(text);
    const re = new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'ig');
    return esc(text).replace(re, '<mark>$1</mark>');
  };

  function wire() {
    const root = document.querySelector<HTMLElement>('[data-search]');
    if (!root) return;
    const input = root.querySelector<HTMLInputElement>('[data-search-input]');
    const results = root.querySelector<HTMLElement>('[data-search-results]');
    if (!input || !results) return;

    // Re-hide on every page-load so ClientRouter navigations never leave
    // the overlay stuck open.
    root.hidden = true;
    document.body.style.overflow = '';

    if ((root as any).__wired) return;
    (root as any).__wired = true;

    const closeOpenMenu = () => {
      document.querySelectorAll<HTMLElement>('[data-menu]').forEach((menu) => {
        menu.hidden = true;
      });
      document.querySelectorAll<HTMLElement>('[data-menu-open]').forEach((button) => {
        button.setAttribute('aria-expanded', 'false');
      });
    };

    const open = () => {
      closeOpenMenu();
      root.hidden = false;
      document.body.style.overflow = 'hidden';
      setTimeout(() => input.focus(), 0);
    };
    const close = () => {
      root.hidden = true;
      document.body.style.overflow = '';
      input.value = '';
      results.innerHTML = '<p class="search__hint">Type to search across the archive.</p>';
    };

    // Delegated handlers – resilient to DOM swaps.
    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement | null;
      if (!t) return;
      if (t.closest('[data-search-open]')) { e.preventDefault(); open(); return; }
      if (t.closest('[data-search-close]') && root.contains(t)) { e.preventDefault(); close(); return; }
    });

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        root.hidden ? open() : close();
      } else if (e.key === 'Escape' && !root.hidden) {
        close();
      }
    });

    let controller: AbortController | null = null;
    let timer: ReturnType<typeof setTimeout> | null = null;
    input.addEventListener('input', () => {
      const q = input.value.trim();
      if (timer) clearTimeout(timer);
      if (controller) controller.abort();
      if (!q) {
        results.innerHTML = '<p class="search__hint">Type to search across the archive.</p>';
        return;
      }
      timer = setTimeout(async () => {
        controller = new AbortController();
        try {
          const res = await fetch(`/api/search.json?q=${encodeURIComponent(q)}`, { signal: controller.signal });
          const data = (await res.json()) as Results;
          results.innerHTML = render(data, q);
        } catch (err) {
          if ((err as any).name !== 'AbortError') {
            results.innerHTML = '<p class="search__hint">Search failed. Try again.</p>';
          }
        }
      }, 180);
    });
  }

  function render(d: Results, q: string): string {
    const groups: string[] = [];
    if (d.albums?.length) {
      groups.push(`<div class="search__group">
        <div class="search__group-title">Records</div>
        ${d.albums.map((a) => `
          <a class="search__result" href="/discography/${a.slug}">
            ${thumb(a.cover_art, a.title)}
            <span class="search__title"><em>${esc(a.title)}</em></span>
            <span class="search__meta">${esc(a.type || '')}</span>
          </a>
        `).join('')}
      </div>`);
    }
    if (d.songs?.length) {
      groups.push(`<div class="search__group">
        <div class="search__group-title">Songs</div>
        ${d.songs.map((s) => `
          <a class="search__result" href="/songs/${s.slug}">
            ${thumb(s.cover_art, s.album_title || s.title)}
            <span class="search__title">${esc(s.title)}</span>
            <span class="search__meta">${esc(s.album_title || '')}</span>
          </a>
        `).join('')}
      </div>`);
    }
    if (d.lyrics?.length) {
      groups.push(`<div class="search__group">
        <div class="search__group-title">Lyrics</div>
        ${d.lyrics.map((l) => `
          <a class="search__result search__result--lyric" href="/songs/${l.slug}">
            ${thumb(l.cover_art, l.album_title || l.title)}
            <span class="search__title search__title--lyric">
              <span class="search__snippet">&ldquo;${highlight(l.snippet, q)}&rdquo;</span>
              <span class="search__sub">${esc(l.title)}${l.album_title ? ` · ${esc(l.album_title)}` : ''}</span>
            </span>
          </a>
        `).join('')}
      </div>`);
    }
    if (d.venues?.length) {
      groups.push(`<div class="search__group">
        <div class="search__group-title">Venues</div>
        ${d.venues.map((v) => `
          <a class="search__result" href="/venues/${v.slug || ''}">
            <span class="search__title">${esc(v.name)}</span>
            <span class="search__meta">${esc([v.city, v.country].filter(Boolean).join(', '))}</span>
          </a>
        `).join('')}
      </div>`);
    }
    if (d.setlists?.length) {
      groups.push(`<div class="search__group">
        <div class="search__group-title">Setlists</div>
        <div class="search__grid">
          ${d.setlists.map((s) => `
            <a class="search__chip" href="/setlists/${s.id}">
              <span class="search__chip-title">${esc(s.venue || 'Venue unknown')}</span>
              <span class="search__chip-meta">${esc(s.date || 'Undated')}</span>
            </a>
          `).join('')}
        </div>
      </div>`);
    }
    return groups.length ? groups.join('') : '<p class="search__hint">No results.</p>';
  }

  function esc(s: string | null | undefined): string {
    return String(s ?? '').replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c] as string));
  }

  wire();
  document.addEventListener('astro:page-load', wire);
</script>
