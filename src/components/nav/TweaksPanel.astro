---
const ACCENTS: Array<{ id: string; color: string; alt: string }> = [
  { id: 'disintegration',   color: '#7746B0', alt: 'Disintegration' },
  { id: 'wish',             color: '#B8354A', alt: 'Wish' },
  { id: 'pornography',      color: '#8C2638', alt: 'Pornography' },
  { id: 'faith',            color: '#3A4A6B', alt: 'Faith' },
  { id: 'head-on-the-door', color: '#A88344', alt: 'Head on the Door' },
  { id: 'bloodflowers',     color: '#A6462A', alt: 'Bloodflowers' },
];
---
<aside class="tweaks" data-tweaks hidden role="dialog" aria-label="Tweaks">
  <div class="tweaks__hd">
    <h4 class="tweaks__title">Tweaks</h4>
    <button class="tweaks__close" data-tweaks-close aria-label="Close tweaks">×</button>
  </div>

  <section class="tweaks__sec tweaks__sec--mode">
    <div class="tweaks__h">Mode</div>
    <div class="tweaks__toggle" data-tweaks-mode role="group" aria-label="Light or dark mode">
      <button class="tweaks__toggle-btn" data-mode="dark" aria-pressed="false">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/>
        </svg>
        <span>Dark</span>
      </button>
      <button class="tweaks__toggle-btn" data-mode="light" aria-pressed="false">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
        </svg>
        <span>Light</span>
      </button>
    </div>
  </section>

  <section class="tweaks__sec">
    <div class="tweaks__h">Accent</div>
    <div class="tweaks__accents">
      {ACCENTS.map((a) => (
        <button
          class="tweaks__accent"
          data-tweak="accent"
          data-value={a.id}
          data-color={a.color}
          aria-label={a.alt}
          title={a.alt}
        >
          <span class="tweaks__accent-sw" style={`background:${a.color}`} aria-hidden="true"></span>
          <span class="tweaks__accent-name">{a.alt}</span>
        </button>
      ))}
    </div>
  </section>

  <div class="tweaks__ft">
    <button class="chip" data-tweaks-reset>Reset</button>
    <span class="mono-sm muted">live · saves locally</span>
  </div>
</aside>

<style>
  .tweaks {
    position: fixed; bottom: 20px; right: 20px; z-index: 180;
    width: 300px; max-height: 86vh; overflow: auto;
    background: var(--surface); border: 1px solid var(--rule-strong);
    box-shadow: var(--shadow-2), var(--glow);
    padding: 16px 18px;
    font-family: var(--f-mono); font-size: 11px;
  }
  .tweaks[hidden] { display: none; }
  .tweaks__hd { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 14px; }
  .tweaks__title {
    margin: 0; font-family: var(--f-mono); font-weight: 500;
    font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--accent-3);
  }
  :root[data-theme='papers'] .tweaks__title { color: var(--accent); }
  .tweaks__close {
    border: 1px solid var(--rule); background: transparent;
    color: var(--ink-2); cursor: pointer;
    width: 28px; height: 28px; line-height: 1; font-size: 18px;
  }
  .tweaks__close:hover { color: var(--accent-3); border-color: var(--accent); }
  .tweaks__sec { padding-bottom: 12px; margin-bottom: 12px; border-bottom: 1px solid var(--rule); }
  .tweaks__sec:last-of-type { border-bottom: 0; }
  .tweaks__h {
    font-family: var(--f-mono); font-size: 9.5px; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--ink-2); margin-bottom: 8px;
  }
  .tweaks__toggle {
    display: grid; grid-template-columns: 1fr 1fr;
    border: 1px solid var(--rule);
    border-radius: 2px; overflow: hidden;
  }
  .tweaks__toggle-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    background: transparent; color: var(--ink-2);
    border: 0; padding: 10px 12px;
    font-family: var(--f-mono); font-size: 11px;
    letter-spacing: 0.18em; text-transform: uppercase;
    cursor: pointer; transition: background .18s, color .18s;
  }
  .tweaks__toggle-btn + .tweaks__toggle-btn { border-left: 1px solid var(--rule); }
  .tweaks__toggle-btn:hover { color: var(--ink); }
  .tweaks__toggle-btn[aria-pressed='true'] {
    background: var(--accent);
    color: var(--accent-ink);
  }
  :root[data-theme='papers'] .tweaks__toggle-btn[aria-pressed='true'] { color: var(--accent-ink); }

  .tweaks__accents {
    display: flex; flex-direction: column; gap: 2px;
  }
  .tweaks__accent {
    display: inline-flex; align-items: center; gap: 10px;
    background: transparent; border: 1px solid transparent;
    color: var(--ink-2); cursor: pointer;
    padding: 6px 8px; text-align: left;
    font-family: var(--f-mono); font-size: 10.5px;
    letter-spacing: 0.18em; text-transform: uppercase;
    transition: color .18s, border-color .18s, background .18s;
  }
  .tweaks__accent:hover { color: var(--ink); border-color: var(--rule); }
  .tweaks__accent[aria-pressed='true'] {
    color: var(--ink); border-color: var(--accent);
    background: var(--accent-tint);
  }
  .tweaks__accent-sw {
    width: 14px; height: 14px; border-radius: 50%; flex: 0 0 auto;
    border: 1px solid rgba(255,255,255,0.18);
  }
  :root[data-theme='papers'] .tweaks__accent-sw { border-color: rgba(0,0,0,0.2); }
  .tweaks__accent-name {
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .tweaks__ft { display: flex; justify-content: space-between; align-items: center; padding-top: 4px; }

  @media (max-width: 600px) {
    .tweaks {
      left: 12px;
      right: 12px;
      bottom: max(12px, env(safe-area-inset-bottom));
      width: auto;
      max-height: min(76vh, 560px);
    }
    .tweaks__ft {
      gap: 10px;
      flex-wrap: wrap;
    }
  }
</style>

<script>
  type Mode = 'dark' | 'light';
  type Tweaks = { mode: Mode; accent: string };
  type AccentTone = { accent: string; accent2: string; accent3: string; ink: string };
  type AccentPalette = { dark: AccentTone; light: AccentTone };

  const KEY = 'cureation:tweaks';
  const ACCENT_MAP: Record<string, AccentPalette> = {
    disintegration: {
      dark: { accent: '#7746B0', accent2: '#5A3389', accent3: '#B089E0', ink: '#F1E9F9' },
      light: { accent: '#4E2677', accent2: '#351753', accent3: '#6A3AA0', ink: '#F9F1DC' },
    },
    wish: {
      dark: { accent: '#B8354A', accent2: '#842839', accent3: '#E37A8A', ink: '#FFF1F3' },
      light: { accent: '#8F2638', accent2: '#5B1423', accent3: '#A9384C', ink: '#FFF4E8' },
    },
    pornography: {
      dark: { accent: '#8C2638', accent2: '#641B2B', accent3: '#D36A7E', ink: '#FDECEF' },
      light: { accent: '#711C2B', accent2: '#4B111C', accent3: '#942D41', ink: '#FFF4E8' },
    },
    faith: {
      dark: { accent: '#4D638E', accent2: '#2F3D5A', accent3: '#92A6D0', ink: '#EEF2FA' },
      light: { accent: '#2F405F', accent2: '#1F2A40', accent3: '#485D84', ink: '#F4F1E7' },
    },
    'head-on-the-door': {
      dark: { accent: '#A88344', accent2: '#73572B', accent3: '#DAB86E', ink: '#FFF8E7' },
      light: { accent: '#76551F', accent2: '#4C3511', accent3: '#8E682C', ink: '#FFF4E2' },
    },
    bloodflowers: {
      dark: { accent: '#A6462A', accent2: '#78311E', accent3: '#D8795F', ink: '#FFF1EA' },
      light: { accent: '#843518', accent2: '#57210D', accent3: '#A34A2B', ink: '#FFF3E5' },
    },
  };
  const DEFAULTS: Tweaks = { mode: 'dark', accent: 'disintegration' };

  function readTweaks(): Tweaks {
    try {
      const raw = localStorage.getItem(KEY);
      if (raw) {
        const parsed = JSON.parse(raw) as Partial<Tweaks> & { theme?: string };
        // Migrate legacy state: old `theme` field -> new `mode`.
        const mode: Mode = parsed.mode === 'light' || parsed.mode === 'dark'
          ? parsed.mode
          : parsed.theme === 'papers' ? 'light' : 'dark';
        const accent = parsed.accent && ACCENT_MAP[parsed.accent] ? parsed.accent : DEFAULTS.accent;
        return { mode, accent };
      }
    } catch (e) {}
    return { ...DEFAULTS };
  }

  function applyTweaks(t: Tweaks) {
    const html = document.documentElement;
    html.setAttribute('data-theme', t.mode === 'light' ? 'papers' : 'dark');
    // Hardcoded visual choices.
    html.setAttribute('data-display', 'cormorant');
    html.setAttribute('data-atmos', 'heavy');
    html.setAttribute('data-grain', 'off');
    html.setAttribute('data-density', 'balanced');
    html.setAttribute('data-headline', 'italic');
    const palette = ACCENT_MAP[t.accent] || ACCENT_MAP.disintegration;
    const tone = palette[t.mode === 'light' ? 'light' : 'dark'];
    html.style.setProperty('--accent', tone.accent);
    html.style.setProperty('--accent-2', tone.accent2);
    html.style.setProperty('--accent-3', tone.accent3);
    html.style.setProperty('--accent-ink', tone.ink);
    html.style.setProperty('--accent-tint', tone.accent + '1A');
    html.style.setProperty('--accent-tint-2', tone.accent + '33');
    html.style.setProperty('--glow', `0 0 ${t.mode === 'light' ? '32px' : '40px'} ${tone.accent}40`);
    try { localStorage.setItem(KEY, JSON.stringify(t)); } catch (e) {}
  }

  function paintPanel(t: Tweaks, panel: HTMLElement) {
    panel.querySelectorAll<HTMLElement>('[data-tweak="accent"]').forEach((el) => {
      const active = el.getAttribute('data-value') === t.accent;
      el.setAttribute('aria-pressed', active ? 'true' : 'false');
      el.classList.toggle('is-active', active);
    });
    panel.querySelectorAll<HTMLElement>('[data-mode]').forEach((el) => {
      const active = el.getAttribute('data-mode') === t.mode;
      el.setAttribute('aria-pressed', active ? 'true' : 'false');
    });
  }

  function wireTweaks() {
    const panel = document.querySelector<HTMLElement>('[data-tweaks]');
    if (!panel) return;
    let state = readTweaks();
    applyTweaks(state);
    paintPanel(state, panel);

    if ((panel as any).__wired) return;
    (panel as any).__wired = true;

    let lastOpener: HTMLElement | null = null;

    function setPanelOpen(open: boolean, opener?: HTMLElement) {
      panel.hidden = !open;
      if (opener) lastOpener = opener;
      document.querySelectorAll<HTMLElement>('[data-tweaks-toggle]').forEach((btn) => {
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
      if (!open) lastOpener?.focus();
    }

    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement | null;
      if (!t) return;
      const opener = t.closest<HTMLElement>('[data-tweaks-toggle]');
      if (opener) {
        e.preventDefault();
        setPanelOpen(panel.hidden, opener);
        return;
      }
      const closer = t.closest<HTMLElement>('[data-tweaks-close]');
      if (closer && panel.contains(closer)) { e.preventDefault(); setPanelOpen(false); return; }
      const reset = t.closest<HTMLElement>('[data-tweaks-reset]');
      if (reset && panel.contains(reset)) {
        state = { ...DEFAULTS };
        applyTweaks(state);
        paintPanel(state, panel);
        return;
      }
      const accent = t.closest<HTMLElement>('[data-tweak="accent"]');
      if (accent && panel.contains(accent)) {
        const val = accent.getAttribute('data-value');
        if (val && ACCENT_MAP[val]) {
          state.accent = val;
          applyTweaks(state);
          paintPanel(state, panel);
        }
      }
      const mode = t.closest<HTMLElement>('[data-mode]');
      if (mode && panel.contains(mode)) {
        const m = mode.getAttribute('data-mode') as Mode | null;
        if (m === 'light' || m === 'dark') {
          state.mode = m;
          applyTweaks(state);
          paintPanel(state, panel);
        }
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) setPanelOpen(false);
    });

    // Legacy theme-toggle button toggles dark/light through tweaks state.
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
      if ((btn as any).__tweaksWired) return;
      (btn as any).__tweaksWired = true;
      btn.addEventListener('click', () => {
        state.mode = state.mode === 'light' ? 'dark' : 'light';
        applyTweaks(state);
        paintPanel(state, panel);
      });
    });
  }
  wireTweaks();
  document.addEventListener('astro:page-load', wireTweaks);
</script>
