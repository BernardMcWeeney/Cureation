---
import { getRunningFigures } from '../../lib/directus';
const now = new Date();
const year = now.getFullYear();
const fig = await getRunningFigures().catch(() => ({ albums: 0, songs: 0, setlists: 0, venues: 0, photos: 0, members: 0 }));
const today = now.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).toUpperCase();
const toRoman = (n: number): string => {
  const map: Array<[number, string]> = [[1000,'M'],[900,'CM'],[500,'D'],[400,'CD'],[100,'C'],[90,'XC'],[50,'L'],[40,'XL'],[10,'X'],[9,'IX'],[5,'V'],[4,'IV'],[1,'I']];
  let out = '', r = n;
  for (const [v, s] of map) { while (r >= v) { out += s; r -= v; } }
  return out;
};
const volume = toRoman(Math.max(1, year - 2018));
const startOfYear = Date.UTC(year, 0, 0);
const issueNumber = Math.floor((Date.now() - startOfYear) / 86400000);
---
<footer class="foot">
  <div class="container">

    <div class="foot-rule">
      <span>Vol. {volume} · №{issueNumber}</span>
      <span class="hide-mobile">An editorial archive of The Cure</span>
      <span><span class="pip"></span>{fig.setlists.toLocaleString()} shows indexed</span>
    </div>

    <div class="foot-word"><em>Cureation</em></div>

    <div class="foot-rule" style="margin-bottom: clamp(28px, 4vw, 56px);">
      <span>Preserved with care</span>
      <span class="hide-mobile">Issued {today}</span>
      <span>Since 2019</span>
    </div>

    <div class="foot-cols">
      <div class="foot-col">
        <div class="mono-sm muted">Records</div>
        <ul>
          <li><a href="/discography">Discography</a></li>
          <li><a href="/discography/ep">EPs</a></li>
          <li><a href="/discography/singles">Singles</a></li>
          <li><a href="/discography/compilations">Compilations</a></li>
          <li><a href="/songs">All songs</a></li>
          <li><a href="/lyrics">Lyrics</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <div class="mono-sm muted">Live archive</div>
        <ul>
          <li><a href="/setlists">Setlists</a></li>
          <li><a href="/tours">Tours</a></li>
          <li><a href="/venues">Venues</a></li>
          <li><a href="/photos">Photographs</a></li>
          <li><a href="/videos">Videos</a></li>
          <li><a href="/on-this-day">On this day</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <div class="mono-sm muted">The band</div>
        <ul>
          <li><a href="/band">Members</a></li>
          <li><a href="/band/history">History</a></li>
          <li><a href="/band/gear">Gear</a></li>
          <li><a href="/band/quotes">Quotations</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <div class="mono-sm muted">Reading</div>
        <ul>
          <li><a href="/news">Dispatches</a></li>
          <li><a href="/wiki">The wiki</a></li>
          <li><a href="/stats">Stats</a></li>
          <li><a href="/curiosities">Curiosities</a></li>
          <li><a href="/community">Community</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <div class="mono-sm muted">The archive</div>
        <ul>
          <li><a href="/about">About</a></li>
          <li><a href="/sources">Sources</a></li>
          <li><a href="/colophon">Colophon</a></li>
          <li><a href="mailto:hello@cureation.net">Contact</a></li>
          <li><a href="https://bsky.app/profile/cureation.net" target="_blank" rel="noopener">Bluesky</a></li>
        </ul>
      </div>
    </div>

    <div class="foot-figures">
      {[
        ['Records', fig.albums],
        ['Songs', fig.songs],
        ['Setlists', fig.setlists],
        ['Venues', fig.venues],
        ['Photos', fig.photos],
        ['Members', fig.members],
      ].map(([k, v]) => (
        <div class="foot-figure">
          <div class="foot-figure__v">{(v as number).toLocaleString()}</div>
          <div class="foot-figure__k">{k}</div>
        </div>
      ))}
    </div>

    <div class="foot-base">
      <span class="mono-sm">© {year} CUREATION · UNOFFICIAL FAN ARCHIVE</span>
      <span class="mono-sm muted">Not affiliated with The Cure, Fiction Records, or Universal Music</span>
    </div>
  </div>
</footer>

<style is:global>
  .foot { border-top: 1px solid var(--ink); margin-top: clamp(48px, 7vw, 96px); padding: clamp(40px, 6vw, 80px) 0 clamp(24px, 3vw, 36px); background:
    radial-gradient(600px 300px at 50% 0%, var(--accent-tint), transparent 70%),
    var(--bg);
  }

  .foot-rule {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 16px; color: var(--muted);
    font-family: var(--f-mono); font-size: 10.5px; letter-spacing: 0.22em;
    text-transform: uppercase;
    padding: 10px 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule);
    margin-top: 12px;
  }
  .foot-rule:first-of-type { margin-top: 0; }
  .foot-rule span:nth-child(2) { flex: 1; text-align: center; }
  .foot-rule span:nth-child(3) { text-align: right; color: var(--accent-3); }
  .foot-rule .pip { background: var(--accent-3); box-shadow: 0 0 8px currentColor; }

  .foot-word {
    font-family: var(--f-display); font-style: italic; font-weight: 500;
    font-size: clamp(56px, 12vw, 180px); line-height: 0.9;
    text-align: center; letter-spacing: -0.02em;
    color: var(--bg-3, var(--rule)); opacity: .55;
    margin: 0.2em 0 0.1em;
  }

  .foot-cols {
    display: grid; grid-template-columns: repeat(5, 1fr);
    gap: clamp(16px, 2vw, 36px);
    border-top: 1px solid var(--rule);
    padding-top: clamp(24px, 3vw, 40px);
  }
  .foot-col ul { list-style: none; margin: .8rem 0 0; padding: 0; }
  .foot-col li + li { margin-top: .5rem; }
  .foot-col a { font-family: var(--f-serif); font-style: italic; font-size: 16px; color: var(--ink); border: none; line-height: 1.25; }
  .foot-col a:hover { color: var(--accent-3); }

  .foot-figures {
    display: grid; grid-template-columns: repeat(6, 1fr);
    gap: 1px; background: var(--rule);
    border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule);
    margin-top: clamp(28px, 4vw, 48px);
  }
  .foot-figure { background: var(--bg); padding: clamp(14px, 2vw, 22px) clamp(8px, 1.4vw, 16px); }
  .foot-figure__v { font-family: var(--f-display); font-style: italic; font-size: clamp(24px, 3vw, 40px); line-height: 1; color: var(--accent-ink); }
  .foot-figure__k { font-family: var(--f-mono); font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); margin-top: 6px; }

  .foot-base {
    display: flex; flex-wrap: wrap; gap: 1.4rem;
    justify-content: space-between; align-items: baseline;
    padding-top: clamp(24px, 3vw, 36px); margin-top: clamp(20px, 3vw, 28px);
    border-top: 1px solid var(--rule-2);
  }

  @media (max-width: 860px) { .foot-cols { grid-template-columns: repeat(2, 1fr); } .foot-figures { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 520px) { .foot-cols { grid-template-columns: 1fr; } }
</style>
