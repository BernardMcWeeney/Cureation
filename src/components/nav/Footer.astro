---
const year = new Date().getFullYear();

const primary = [
  ['/discography', 'Music'],
  ['/setlists', 'Live'],
  ['/band', 'Band'],
  ['/publication', 'Publication'],
];

const archive = [
  ['/news', 'News'],
  ['/songs', 'Songs'],
  ['/photos', 'Photos'],
  ['/wiki', 'Wiki'],
  ['/stats', 'Statistics'],
];
---
<footer class="foot">
  <div class="container foot__inner">
    <div class="foot__lead">
      <a href="/" class="foot__word">Cureation</a>
      <div class="foot__lead-copy">
        <p>An independent archive of The Cure. Preserved with care, built by fans.</p>
        <nav class="foot__social" aria-label="Cureation on social media">
          <a href="https://x.com/cureationx" target="_blank" rel="me noopener" aria-label="Cureation on X" title="X">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.24 2.25h3.31l-7.23 8.26 8.51 11.24h-6.66l-5.21-6.82-5.97 6.82H1.68l7.73-8.84L1.25 2.25h6.83l4.71 6.23 5.45-6.23Zm-1.16 17.52h1.83L7.08 4.13H5.11l11.97 15.64Z" /></svg>
            <span class="sr-only">X</span>
          </a>
          <a href="https://bsky.app/profile/cureation.bsky.social" target="_blank" rel="me noopener" aria-label="Cureation on Bluesky (@cureation.bsky.social)" title="Bluesky: @cureation.bsky.social">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 10.8c-1.09-2.11-4.05-6.05-6.8-8.06C2.56.81 1.55 1.14.89 1.44.13 1.78 0 2.93 0 3.61c0 .69.38 5.65.62 6.48.81 2.8 3.69 3.75 6.35 3.45-4.64.69-8.76 2.38-3.36 8.4 5.93 6.14 8.13-1.32 8.39-3 .26 1.68 2.46 9.14 8.39 3 5.4-6.02 1.28-7.71-3.36-8.4 2.66.3 5.54-.65 6.35-3.45.24-.83.62-5.79.62-6.48 0-.68-.13-1.83-.89-2.17-.66-.3-1.67-.63-4.31 1.3C16.05 4.75 13.09 8.69 12 10.8Z" /></svg>
            <span class="sr-only">Bluesky</span>
          </a>
          <a href="https://www.facebook.com/cureationx/" target="_blank" rel="me noopener" aria-label="Cureation on Facebook" title="Facebook">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 22v-9h3l.45-3.5H13.5V7.27c0-1.01.28-1.7 1.74-1.7H17.1V2.44c-.32-.04-1.43-.14-2.72-.14-2.69 0-4.53 1.64-4.53 4.66V9.5H6.8V13h3.05v9h3.65Z" /></svg>
            <span class="sr-only">Facebook</span>
          </a>
          <a href="https://www.instagram.com/cureationx/" target="_blank" rel="me noopener" aria-label="Cureation on Instagram" title="Instagram">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.5" cy="6.7" r="1.1" /></svg>
            <span class="sr-only">Instagram</span>
          </a>
          <a href="https://www.youtube.com/@cureation" target="_blank" rel="me noopener" aria-label="Cureation on YouTube" title="YouTube">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31.2 31.2 0 0 0 0 12a31.2 31.2 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31.2 31.2 0 0 0 24 12a31.2 31.2 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.3 3.6-6.3 3.6Z" clip-rule="evenodd" /></svg>
            <span class="sr-only">YouTube</span>
          </a>
        </nav>
      </div>
    </div>

    <nav class="foot__links" aria-label="Footer navigation">
      <div>
        <span>Explore</span>
        {primary.map(([href, label]) => <a href={href}>{label}</a>)}
      </div>
      <div>
        <span>Archive</span>
        {archive.map(([href, label]) => <a href={href}>{label}</a>)}
      </div>
      <div>
        <span>Elsewhere</span>
        <a href="/rss.xml">RSS</a>
        <a href="/about">About</a>
        <a href="mailto:hello@cureation.net">Contact</a>
      </div>
    </nav>

    <div class="foot__base">
      <span>© {year} Cureation</span>
      <span>Unofficial · not affiliated with The Cure</span>
    </div>
  </div>
</footer>

<style>
  .foot {
    margin-top: clamp(72px, 10vw, 144px);
    border-top: 1px solid var(--rule);
    background: var(--bg);
  }

  .foot__inner { padding-block: clamp(52px, 7vw, 92px) 28px; }

  .foot__lead {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(240px, .6fr);
    gap: 32px;
    align-items: end;
    padding-bottom: clamp(44px, 6vw, 72px);
    border-bottom: 1px solid var(--rule);
  }

  .foot__word {
    width: max-content;
    border: 0;
    color: var(--ink);
    font-family: var(--f-display);
    font-size: clamp(64px, 12vw, 154px);
    font-style: italic;
    letter-spacing: -.055em;
    line-height: .72;
  }

  .foot__lead p {
    max-width: 34ch;
    margin: 0;
    color: var(--muted);
    font-family: var(--f-serif);
    font-size: 16px;
    line-height: 1.6;
  }

  .foot__lead-copy { display: flex; flex-direction: column; align-items: flex-start; gap: 24px; }
  .foot__social { display: flex; flex-wrap: wrap; gap: 8px; }
  .foot__social a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--rule);
    border-radius: 50%;
    color: var(--ink-2);
    background: color-mix(in srgb, var(--bg-2) 88%, transparent);
    transition: color .18s ease, border-color .18s ease, background .18s ease, transform .18s ease;
  }
  .foot__social a:hover,
  .foot__social a:focus-visible {
    border-color: var(--accent);
    background: var(--accent-tint);
    color: var(--accent);
    transform: translateY(-2px);
  }
  .foot__social a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .foot__social svg { width: 18px; height: 18px; fill: currentColor; }

  .foot__links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    padding-block: 40px;
  }

  .foot__links div { display: flex; flex-direction: column; align-items: flex-start; gap: 9px; }

  .foot__links span,
  .foot__base {
    color: var(--muted-2);
    font-family: var(--f-sans);
    font-size: var(--micro);
    font-weight: 600;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .foot__links span { margin-bottom: 8px; color: var(--accent-3); }
  .foot__links a { border: 0; color: var(--ink-2); font-size: 16px; }
  .foot__links a:hover { color: var(--accent); }

  .foot__base {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
  }

  @media (max-width: 700px) {
    .foot__lead { grid-template-columns: 1fr; align-items: start; }
    .foot__word { font-size: clamp(58px, 21vw, 108px); }
    .foot__links { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .foot__base { flex-direction: column; }
    .foot__lead-copy { gap: 20px; }
    .foot__social a { width: 42px; height: 42px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .foot__social a { transition: none; }
    .foot__social a:hover, .foot__social a:focus-visible { transform: none; }
  }
</style>
