---
const current = Astro.url.pathname;
const calendarFeedUrl = new URL('/calendar.ics', Astro.site ?? Astro.url).toString();
const calendarSubscribeUrl = calendarFeedUrl.replace(/^https?:/, 'webcal:');
const sections: Array<{ title: string; links: Array<{ href: string; label: string }> }> = [
  { title: 'Music', links: [
    { href: '/discography', label: 'Discography' },
    { href: '/discography?type=studio', label: 'Albums' },
    { href: '/songs', label: 'Songs' },
    { href: '/lyrics', label: 'Lyrics' },
    { href: '/stats', label: 'Most performed' },
  ]},
  { title: 'Live', links: [
    { href: '/tours/2026-european-summer-shows', label: '2026 Summer Shows' },
    { href: '/setlists', label: 'Setlists' },
    { href: '/tours', label: 'Tours' },
    { href: '/venues', label: 'Venues' },
    { href: '/setlists/compare', label: 'Compare shows' },
    { href: '/on-this-day', label: 'On this day' },
    { href: calendarSubscribeUrl, label: 'Tour calendar feed' },
    { href: '/tours/map', label: 'World map' },
  ]},
  { title: 'Publication', links: [
    { href: '/publication', label: 'Publication' },
    { href: '/news', label: 'News' },
    { href: '/reviews', label: 'Reviews' },
    { href: '/wiki', label: 'Wiki' },
    { href: '/publication#editorials', label: 'Editorials' },
    { href: '/newsletter', label: 'Newsletter' },
    { href: '/publication/rss.xml', label: 'Publication RSS' },
    { href: '/news/rss.xml', label: 'News RSS' },
  ]},
  { title: 'Archive', links: [
    { href: '/wiki', label: 'All wiki pages' },
    { href: '/photos', label: 'Photographs' },
    { href: '/videos', label: 'Videos' },
    { href: '/band', label: 'Members' },
    { href: '/band/history', label: 'History' },
    { href: '/band/gear', label: 'Gear' },
    { href: '/stats', label: 'Stats' },
    { href: '/curiosities', label: 'Curiosities' },
    { href: '/my-archive', label: 'My archive' },
    { href: '/sources', label: 'Sources' },
    { href: '/about', label: 'About' },
  ]},
];
function isActive(href: string) {
  const path = href.split(/[?#]/)[0];
  return current === path || current.startsWith(path + '/');
}
---
<div class="menu" id="site-menu" data-menu hidden role="dialog" aria-modal="true" aria-label="Site menu">
  <div class="menu__scrim" data-menu-close aria-hidden="true"></div>
  <aside class="menu__panel">
    <header class="menu__head">
      <a href="/" class="menu__brand" aria-label="Cureation home">
        <span class="menu__brand-mark" aria-hidden="true">
          <img src="/logo-mark.webp" alt="" width="42" height="42" loading="eager" decoding="async" />
        </span>
        <span class="menu__brand-name">Cureation</span>
      </a>
      <div class="menu__actions">
        <button class="menu__icon menu__theme" type="button" data-theme-toggle aria-label="Switch to light mode" title="Switch to light mode">
          <svg class="menu__theme-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <circle cx="12" cy="12" r="3.5"/><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"/>
          </svg>
          <svg class="menu__theme-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M20.5 15.4A8.5 8.5 0 0 1 8.6 3.5a8.5 8.5 0 1 0 11.9 11.9Z"/>
          </svg>
        </button>
        <button class="menu__icon" data-menu-close aria-label="Close menu">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M6 6 18 18M18 6 6 18"/>
          </svg>
        </button>
      </div>
    </header>
    <div class="menu__search-wrap">
      <button class="menu__search" type="button" data-search-open aria-label="Search the archive">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
        </svg>
        <span>Search the archive</span>
      </button>
    </div>
    <div class="menu__body">
      {sections.map((sec) => (
        <details class="menu__section" open={sec.links.some((link) => isActive(link.href))}>
          <summary class="menu__section-toggle">
            <span class="menu__kicker">{sec.title}</span>
            <svg viewBox="0 0 12 8" width="12" height="8" aria-hidden="true"><path d="m1 1 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
          </summary>
          <ul class="menu__list">
            {sec.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  class={`menu__link ${isActive(l.href) ? 'is-active' : ''}`}
                >{l.label}</a>
              </li>
            ))}
          </ul>
        </details>
      ))}
    </div>
    <nav class="menu__social" aria-label="Cureation on social media">
      <span>Follow Cureation</span>
      <div>
        <a href="https://x.com/cureationx" target="_blank" rel="me noopener" aria-label="Cureation on X" title="X">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.24 2.25h3.31l-7.23 8.26 8.51 11.24h-6.66l-5.21-6.82-5.97 6.82H1.68l7.73-8.84L1.25 2.25h6.83l4.71 6.23 5.45-6.23Zm-1.16 17.52h1.83L7.08 4.13H5.11l11.97 15.64Z" /></svg>
        </a>
        <a href="https://bsky.app/profile/cureation.bsky.social" target="_blank" rel="me noopener" aria-label="Cureation on Bluesky" title="Bluesky">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 10.8c-1.09-2.11-4.05-6.05-6.8-8.06C2.56.81 1.55 1.14.89 1.44.13 1.78 0 2.93 0 3.61c0 .69.38 5.65.62 6.48.81 2.8 3.69 3.75 6.35 3.45-4.64.69-8.76 2.38-3.36 8.4 5.93 6.14 8.13-1.32 8.39-3 .26 1.68 2.46 9.14 8.39 3 5.4-6.02 1.28-7.71-3.36-8.4 2.66.3 5.54-.65 6.35-3.45.24-.83.62-5.79.62-6.48 0-.68-.13-1.83-.89-2.17-.66-.3-1.67-.63-4.31 1.3C16.05 4.75 13.09 8.69 12 10.8Z" /></svg>
        </a>
        <a href="https://www.facebook.com/cureationx/" target="_blank" rel="me noopener" aria-label="Cureation on Facebook" title="Facebook">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 22v-9h3l.45-3.5H13.5V7.27c0-1.01.28-1.7 1.74-1.7H17.1V2.44c-.32-.04-1.43-.14-2.72-.14-2.69 0-4.53 1.64-4.53 4.66V9.5H6.8V13h3.05v9h3.65Z" /></svg>
        </a>
        <a href="https://www.instagram.com/cureationx/" target="_blank" rel="me noopener" aria-label="Cureation on Instagram" title="Instagram">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.5" cy="6.7" r="1.1" /></svg>
        </a>
        <a href="https://www.youtube.com/@cureation" target="_blank" rel="me noopener" aria-label="Cureation on YouTube" title="YouTube">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31.2 31.2 0 0 0 0 12a31.2 31.2 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31.2 31.2 0 0 0 24 12a31.2 31.2 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.3 3.6-6.3 3.6Z" clip-rule="evenodd" /></svg>
        </a>
      </div>
    </nav>
  </aside>
</div>

<style>
  .menu {
    position: fixed; inset: 0; z-index: 60;
    display: flex; align-items: stretch; justify-content: flex-end;
  }
  .menu[hidden] { display: none; }
  .menu__scrim {
    position: absolute; inset: 0;
    background: color-mix(in oklab, var(--bg), transparent 20%);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    animation: menu-fade .2s ease;
  }
  @keyframes menu-fade { from { opacity: 0 } to { opacity: 1 } }

  .menu__panel {
    position: relative;
    width: min(440px, 100%);
    margin-left: auto;
    background: var(--bg);
    border-left: 1px solid var(--rule);
    box-shadow: var(--shadow-2);
    height: 100%;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    display: flex; flex-direction: column;
    animation: menu-slide .25s cubic-bezier(0.22, 0.8, 0.3, 1);
  }
  @keyframes menu-slide { from { transform: translateX(18px); opacity: .6 } to { transform: translateX(0); opacity: 1 } }

  .menu__head {
    position: sticky; top: 0;
    display: flex; align-items: center; justify-content: space-between;
    min-height: 62px;
    padding: 9px clamp(18px, 4vw, 28px);
    border-bottom: 1px solid var(--rule);
    background: color-mix(in oklab, var(--bg), transparent 6%);
    backdrop-filter: blur(6px);
    z-index: 1;
  }
  .menu__brand {
    display: inline-flex; align-items: center; gap: 11px;
    font-family: var(--f-display); font-style: italic; font-size: 25px;
    color: var(--ink); border: none;
  }
  .menu__brand-mark {
    display: inline-flex; align-items: center; justify-content: center;
    width: 42px; height: 42px; border: 1px solid var(--accent);
    color: var(--accent-3); background: var(--accent-tint-2);
    border-radius: 50%;
    overflow: hidden;
    flex: 0 0 auto;
  }
  .menu__brand-mark img { width: 100%; height: 100%; object-fit: cover; }
  :root[data-theme='papers'] .menu__brand-mark { color: var(--accent); }
  .menu__actions { display: flex; gap: 6px; }
  .menu__icon {
    width: 42px; height: 42px; display: inline-flex; align-items: center; justify-content: center;
    background: transparent; color: var(--ink-2); border: 1px solid var(--rule);
    cursor: pointer; transition: all .18s;
  }
  .menu__icon:hover { color: var(--accent); border-color: var(--accent); background: transparent; }
  .menu__theme-moon { display: none; }
  :global(html[data-theme='papers']) .menu__theme-sun { display: none; }
  :global(html[data-theme='papers']) .menu__theme-moon { display: block; }
  :root[data-theme='papers'] .menu__icon:hover { color: var(--accent); }

  .menu__search-wrap {
    padding: clamp(14px, 3.5vw, 22px) clamp(18px, 4vw, 28px) 0;
  }
  .menu__social { margin: auto clamp(18px, 4vw, 28px) max(24px, env(safe-area-inset-bottom)); padding: 14px; border: 1px solid var(--rule); background: var(--bg-2); }
  .menu__social > span { display: block; margin-bottom: 12px; color: var(--muted); font-family: var(--f-mono); font-size: var(--micro-sm); letter-spacing: .13em; text-transform: uppercase; }
  .menu__social > div { display: flex; flex-wrap: wrap; gap: 8px; }
  .menu__social a { width: 42px; height: 42px; display: grid; place-items: center; border: 1px solid var(--rule); border-radius: 50%; color: var(--ink-2); background: var(--bg); transition: color .18s ease, border-color .18s ease, background .18s ease; }
  .menu__social a:hover, .menu__social a:focus-visible { border-color: var(--accent); background: var(--accent-tint); color: var(--accent); }
  .menu__social a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .menu__social svg { width: 17px; height: 17px; fill: currentColor; }
  .menu__search {
    width: 100%;
    min-height: 48px;
    display: flex; align-items: center; gap: 12px;
    padding: 0 14px;
    background: var(--bg-2);
    border: 1px solid var(--rule);
    color: var(--muted);
    cursor: pointer;
    font-family: var(--f-mono);
    font-size: var(--micro);
    letter-spacing: 0.15em;
    text-align: left;
    text-transform: uppercase;
    transition: border-color .18s, color .18s, background .18s;
  }
  .menu__search span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .menu__search:hover,
  .menu__search:focus-visible {
    color: var(--accent);
    border-color: var(--accent);
    background: color-mix(in oklab, var(--bg-2), var(--accent-tint) 45%);
  }
  .menu__search:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .menu__body {
    padding: clamp(18px, 4vw, 28px) clamp(18px, 4vw, 28px) clamp(28px, 5vw, 40px);
    display: flex; flex-direction: column;
  }
  .menu__section {
    border-top: 1px solid var(--rule);
  }
  .menu__section:last-child { border-bottom: 1px solid var(--rule); }
  .menu__section-toggle {
    min-height: 58px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 0;
    color: var(--ink);
    cursor: pointer;
    list-style: none;
  }
  .menu__section-toggle::-webkit-details-marker { display: none; }
  .menu__section-toggle svg { color: var(--accent); transition: transform .18s ease; }
  .menu__section[open] .menu__section-toggle svg { transform: rotate(180deg); }

  .menu__kicker {
    font-family: var(--f-display); font-size: 28px; font-style: italic; font-weight: 500;
    letter-spacing: -.02em; color: var(--ink);
  }
  .menu__section[open] .menu__kicker { color: var(--accent); }
  .menu__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 16px; list-style: none; margin: 0; padding: 2px 0 18px; }
  .menu__link {
    display: block;
    min-height: 42px;
    padding: 11px 0 9px;
    border: none;
    border-bottom: 1px solid var(--rule-2);
    color: var(--ink-2);
    font-family: var(--f-sans);
    font-size: 11px;
    font-weight: 650;
    letter-spacing: .08em;
    line-height: 1.2;
    text-transform: uppercase;
  }
  .menu__link:hover { color: var(--accent); }
  .menu__link.is-active { color: var(--accent); }

  @media (max-width: 520px) {
    .menu__panel { width: 100%; border-left: 0; }
    .menu__head {
      padding: 8px var(--gutter);
      min-height: 58px;
    }
    .menu__brand { gap: 11px; font-size: 22px; min-width: 0; }
    .menu__brand-mark { width: 36px; height: 36px; flex: 0 0 auto; }
    .menu__brand-name {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .menu__actions { gap: 5px; }
    .menu__icon { width: 40px; height: 40px; }
    .menu__search-wrap { padding: 12px var(--gutter) 0; }
    .menu__search { min-height: 46px; }
    .menu__body {
      padding: 16px var(--gutter) 26px;
    }
    .menu__social { margin-inline: var(--gutter); }
    .menu__kicker { font-size: 27px; }
    .menu__list { grid-template-columns: 1fr; }
    .menu__link { font-size: 11px; }
  }
  @media (prefers-reduced-motion: reduce) { .menu__section-toggle svg { transition: none; } }
</style>

<script>
  function wire() {
    const menu = document.querySelector<HTMLElement>('[data-menu]');
    if (!menu) return;
    // Always re-close on page-load so a navigation inside the menu leaves
    // a clean state (ClientRouter keeps the DOM, so stale open states persist).
    menu.hidden = true;
    document.body.style.overflow = '';

    if ((menu as any).__wired) return;
    (menu as any).__wired = true;

    let opener: HTMLElement | null = null;

    const open = (trigger?: HTMLElement) => {
      opener = trigger || null;
      menu.hidden = false;
      document.body.style.overflow = 'hidden';
      document.querySelectorAll<HTMLElement>('[data-menu-open]')
        .forEach(b => b.setAttribute('aria-expanded', 'true'));
      const focusable = menu.querySelector<HTMLElement>('a, button');
      focusable?.focus();
    };
    const close = () => {
      menu.hidden = true;
      document.body.style.overflow = '';
      document.querySelectorAll<HTMLElement>('[data-menu-open]')
        .forEach(b => b.setAttribute('aria-expanded', 'false'));
      opener?.focus();
    };

    // Delegate from document so handlers survive DOM swaps from ClientRouter.
    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement | null;
      if (!t) return;
      const opener = t.closest<HTMLElement>('[data-menu-open]');
      if (opener) { e.preventDefault(); open(opener); return; }
      const closer = t.closest<HTMLElement>('[data-menu-close]');
      if (closer && menu.contains(closer)) { e.preventDefault(); close(); return; }
      if (t.closest('.menu__link') && menu.contains(t)) { setTimeout(close, 0); }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) close();
    });
  }
  wire();
  document.addEventListener('astro:page-load', wire);
</script>
