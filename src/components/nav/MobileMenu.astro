---
const current = Astro.url.pathname;
const sections: Array<{ title: string; links: Array<{ href: string; label: string }> }> = [
  { title: 'Records', links: [
    { href: '/discography', label: 'Discography' },
    { href: '/discography/ep', label: 'EPs' },
    { href: '/discography/singles', label: 'Singles' },
    { href: '/discography/compilations', label: 'Compilations' },
    { href: '/songs', label: 'All songs' },
    { href: '/lyrics', label: 'Lyrics' },
  ]},
  { title: 'Live', links: [
    { href: '/setlists', label: 'Live archive' },
    { href: '/setlists/compare', label: 'Compare shows' },
    { href: '/tours', label: 'Tours' },
    { href: '/venues', label: 'Venues' },
    { href: '/venues/map', label: 'Venue map' },
    { href: '/on-this-day', label: 'On this day' },
  ]},
  { title: 'Media', links: [
    { href: '/photos', label: 'Photographs' },
    { href: '/videos', label: 'Videos' },
  ]},
  { title: 'The band', links: [
    { href: '/band', label: 'Members' },
    { href: '/band/history', label: 'History' },
    { href: '/band/gear', label: 'Gear' },
    { href: '/band/quotes', label: 'Quotations' },
  ]},
  { title: 'Dispatches', links: [
    { href: '/news', label: 'Dispatches' },
    { href: '/newsletter', label: 'Newsletter' },
    { href: '/rss.xml', label: 'RSS feed' },
    { href: '/wiki', label: 'The wiki' },
  ]},
  { title: 'Figures', links: [
    { href: '/stats', label: 'Stats' },
    { href: '/curiosities', label: 'Curiosities' },
  ]},
  { title: 'Archive', links: [
    { href: '/about', label: 'About' },
    { href: '/sources', label: 'Sources' },
    { href: '/community', label: 'Community' },
    { href: '/my-archive', label: 'My archive' },
    { href: '/calendar.ics', label: 'Tour dates (iCal)' },
  ]},
];
function isActive(href: string) {
  return current === href || current.startsWith(href + '/');
}
---
<div class="menu" id="site-menu" data-menu hidden role="dialog" aria-modal="true" aria-label="Site menu">
  <div class="menu__scrim" data-menu-close aria-hidden="true"></div>
  <aside class="menu__panel">
    <header class="menu__head">
      <a href="/" class="menu__brand" aria-label="Cureation — home">
        <span class="menu__brand-mark" aria-hidden="true">
          <img src="/logo.png" alt="" loading="eager" decoding="async" />
        </span>
        <span class="menu__brand-name">Cureation</span>
      </a>
      <div class="menu__actions">
        <button class="menu__icon" data-theme-toggle aria-label="Toggle theme">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/>
          </svg>
        </button>
        <button class="menu__icon" data-menu-close aria-label="Close menu">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M6 6 18 18M18 6 6 18"/>
          </svg>
        </button>
      </div>
    </header>
    <div class="menu__search-wrap">
      <button class="menu__search" type="button" data-search-open aria-label="Search the archive">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
        </svg>
        <span>Search the archive</span>
      </button>
    </div>
    <div class="menu__body">
      {sections.map((sec) => (
        <div class="menu__section">
          <div class="menu__kicker">{sec.title}</div>
          <ul class="menu__list">
            {sec.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  class={`menu__link ${isActive(l.href) ? 'is-active' : ''}`}
                >{l.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </aside>
</div>

<style>
  .menu {
    position: fixed; inset: 0; z-index: 60;
    display: flex; align-items: stretch; justify-content: flex-end;
  }
  .menu[hidden] { display: none; }
  .menu__scrim {
    position: absolute; inset: 0;
    background: color-mix(in oklab, var(--bg), transparent 20%);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    animation: menu-fade .2s ease;
  }
  @keyframes menu-fade { from { opacity: 0 } to { opacity: 1 } }

  .menu__panel {
    position: relative;
    width: min(440px, 100%);
    margin-left: auto;
    background: var(--bg);
    border-left: 1px solid var(--rule);
    box-shadow: var(--shadow-2);
    height: 100%;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    display: flex; flex-direction: column;
    animation: menu-slide .25s cubic-bezier(0.22, 0.8, 0.3, 1);
  }
  @keyframes menu-slide { from { transform: translateX(18px); opacity: .6 } to { transform: translateX(0); opacity: 1 } }

  .menu__head {
    position: sticky; top: 0;
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px clamp(18px, 4vw, 28px);
    border-bottom: 1px solid var(--rule);
    background: color-mix(in oklab, var(--bg), transparent 6%);
    backdrop-filter: blur(6px);
    z-index: 1;
  }
  .menu__brand {
    display: inline-flex; align-items: center; gap: 10px;
    font-family: var(--f-display); font-style: italic; font-size: 22px;
    color: var(--ink); border: none;
  }
  .menu__brand-mark {
    display: inline-flex; align-items: center; justify-content: center;
    width: 28px; height: 28px; border: 1px solid var(--accent);
    color: var(--accent-3); background: var(--accent-tint-2);
    border-radius: 50%;
    overflow: hidden;
    flex: 0 0 auto;
  }
  .menu__brand-mark img { width: 100%; height: 100%; object-fit: cover; }
  :root[data-theme='papers'] .menu__brand-mark { color: var(--accent); }
  .menu__actions { display: flex; gap: 6px; }
  .menu__icon {
    width: 36px; height: 36px; display: inline-flex; align-items: center; justify-content: center;
    background: transparent; color: var(--ink-2); border: 1px solid var(--rule);
    cursor: pointer; transition: all .18s;
  }
  .menu__icon:hover { color: var(--accent-3); border-color: var(--accent); background: transparent; }
  :root[data-theme='papers'] .menu__icon:hover { color: var(--accent); }

  .menu__search-wrap {
    padding: clamp(14px, 3.5vw, 22px) clamp(18px, 4vw, 28px) 0;
  }
  .menu__search {
    width: 100%;
    min-height: 48px;
    display: flex; align-items: center; gap: 12px;
    padding: 0 14px;
    background: var(--bg-2);
    border: 1px solid var(--rule);
    color: var(--muted);
    cursor: pointer;
    font-family: var(--f-mono);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-align: left;
    text-transform: uppercase;
    transition: border-color .18s, color .18s, background .18s;
  }
  .menu__search span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .menu__search:hover,
  .menu__search:focus-visible {
    color: var(--ink);
    border-color: var(--accent);
    background: color-mix(in oklab, var(--bg-2), var(--accent-tint) 45%);
  }
  .menu__search:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .menu__body {
    padding: clamp(18px, 4vw, 28px) clamp(18px, 4vw, 28px) clamp(32px, 6vw, 48px);
    display: flex; flex-direction: column; gap: clamp(18px, 3.2vw, 28px);
  }
  .menu__section {
    display: flex; flex-direction: column; gap: .4rem;
    padding-top: 12px; border-top: 1px solid var(--rule);
  }
  .menu__section:first-child { border-top: 0; padding-top: 0; }

  .menu__kicker {
    font-family: var(--f-mono); font-size: 10.5px; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--muted);
    margin-bottom: .2rem;
  }
  .menu__list { list-style: none; margin: 0; padding: 0; }
  .menu__list li + li { margin-top: .2rem; }
  .menu__link {
    display: block;
    font-family: var(--f-display); font-style: italic;
    font-size: clamp(22px, 5vw, 30px);
    line-height: 1.15;
    padding: .3rem 0;
    color: var(--ink);
    border: none;
    letter-spacing: 0;
  }
  .menu__link:hover { color: var(--accent-3); }
  .menu__link.is-active { color: var(--accent); }

  @media (max-width: 520px) {
    .menu__panel { width: 100%; border-left: 0; }
    .menu__head {
      padding: 10px var(--gutter);
      min-height: 58px;
    }
    .menu__brand { gap: 8px; font-size: 21px; min-width: 0; }
    .menu__brand-mark { width: 26px; height: 26px; font-size: 15px; flex: 0 0 auto; }
    .menu__brand-name {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .menu__actions { gap: 5px; }
    .menu__icon { width: 38px; height: 38px; }
    .menu__search-wrap { padding: 12px var(--gutter) 0; }
    .menu__search { min-height: 46px; }
    .menu__body {
      padding: 16px var(--gutter) max(28px, env(safe-area-inset-bottom));
      gap: 16px;
    }
    .menu__section { padding-top: 10px; }
    .menu__link {
      font-size: 24px;
      padding: .24rem 0;
    }
  }
  @media (max-width: 360px) {
    .menu__link { font-size: 22px; }
  }
</style>

<script>
  function wire() {
    const menu = document.querySelector<HTMLElement>('[data-menu]');
    if (!menu) return;
    // Always re-close on page-load so a navigation inside the menu leaves
    // a clean state (ClientRouter keeps the DOM, so stale open states persist).
    menu.hidden = true;
    document.body.style.overflow = '';

    if ((menu as any).__wired) return;
    (menu as any).__wired = true;

    let opener: HTMLElement | null = null;

    const open = (trigger?: HTMLElement) => {
      opener = trigger || null;
      menu.hidden = false;
      document.body.style.overflow = 'hidden';
      document.querySelectorAll<HTMLElement>('[data-menu-open]')
        .forEach(b => b.setAttribute('aria-expanded', 'true'));
      const focusable = menu.querySelector<HTMLElement>('a, button');
      focusable?.focus();
    };
    const close = () => {
      menu.hidden = true;
      document.body.style.overflow = '';
      document.querySelectorAll<HTMLElement>('[data-menu-open]')
        .forEach(b => b.setAttribute('aria-expanded', 'false'));
      opener?.focus();
    };

    // Delegate from document so handlers survive DOM swaps from ClientRouter.
    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement | null;
      if (!t) return;
      const opener = t.closest<HTMLElement>('[data-menu-open]');
      if (opener) { e.preventDefault(); open(opener); return; }
      const closer = t.closest<HTMLElement>('[data-menu-close]');
      if (closer && menu.contains(closer)) { e.preventDefault(); close(); return; }
      if (t.closest('.menu__link') && menu.contains(t)) { setTimeout(close, 0); }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) close();
    });
  }
  wire();
  document.addEventListener('astro:page-load', wire);
</script>
