---
// src/components/SearchEnhancer.astro
// This component loads the search enhancement script client-side only
---

<script>
  // This script enhances search forms with client-side validation and focus handling
  function enhanceSearchForms() {
    // Get all search forms on the page
    const searchForms = document.querySelectorAll('form[action*="search"]');
    
    searchForms.forEach(form => {
      const searchInput = form.querySelector('input[name="q"]');
      
      if (!searchInput) return;
      
      // Add input event to enable/disable submit button based on content
      const submitButton = form.querySelector('button[type="submit"]');
      if (submitButton) {
        // Initial state
        updateButtonState();
        
        // Update on input
        searchInput.addEventListener('input', updateButtonState);
        
        function updateButtonState() {
          const isEmpty = !searchInput.value.trim();
          submitButton.disabled = isEmpty;
          submitButton.classList.toggle('opacity-50', isEmpty);
          submitButton.classList.toggle('cursor-not-allowed', isEmpty);
        }
      }
      
      // Add form submission validation
      form.addEventListener('submit', (e) => {
        const query = searchInput.value.trim();
        if (!query) {
          e.preventDefault();
          // Give visual feedback that empty searches aren't allowed
          searchInput.classList.add('ring-2', 'ring-red-500');
          
          // Remove error styling after a moment
          setTimeout(() => {
            searchInput.classList.remove('ring-2', 'ring-red-500');
          }, 1000);
          
          // Focus the input
          searchInput.focus();
        }
      });
      
      // Automatically focus search input when visible in viewport
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            // Only auto-focus on dedicated search pages
            if (window.location.pathname.includes('/search')) {
              searchInput.focus();
            }
            observer.disconnect();
          }
        });
      });
      
      observer.observe(searchInput);
    });
  }
  
  // Run on initial load
  document.addEventListener('DOMContentLoaded', enhanceSearchForms);
  
  // Run after Astro page transitions
  document.addEventListener('astro:page-load', enhanceSearchForms);
</script>