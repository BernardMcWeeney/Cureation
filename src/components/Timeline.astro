---
import type { TimelineEvent } from '../types/directus';

interface Props {
  events: TimelineEvent[];
  limit?: number;
}

const { events, limit } = Astro.props;

const displayEvents = limit ? events.slice(0, limit) : events;

// Group events by decade
const eventsByDecade = displayEvents.reduce((acc, event) => {
  const decade = `${Math.floor(event.year / 10) * 10}s`;
  if (!acc[decade]) acc[decade] = [];
  acc[decade].push(event);
  return acc;
}, {} as Record<string, TimelineEvent[]>);

// Sort decades
const sortedDecades = Object.keys(eventsByDecade).sort((a, b) => parseInt(b) - parseInt(a));

// Event type icons and colors
const eventTypeStyles: Record<string, { icon: string; color: string }> = {
  release: {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v12M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" /></svg>`,
    color: 'bg-white/10 text-primary border-primary/40'
  },
  tour: {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
    color: 'bg-green-500/20 text-green-400 border-green-500/40'
  },
  member_change: {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>`,
    color: 'bg-amber-500/20 text-amber-400 border-amber-500/40'
  },
  award: {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" /></svg>`,
    color: 'bg-yellow-500/20 text-yellow-400 border-yellow-500/40'
  },
  milestone: {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" /></svg>`,
    color: 'bg-purple-500/20 text-purple-400 border-purple-500/40'
  },
  other: {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>`,
    color: 'bg-white/10 text-white/90 border-white/20'
  }
};
---

<div class="timeline-container">
  {sortedDecades.map(decade => (
    <div class="decade-section mb-12">
      <h3 class="text-2xl font-heading text-white mb-6 sticky top-20 bg-black/80 backdrop-blur-lg py-2 z-10">
        {decade}
      </h3>

      <div class="relative">
        {/* Timeline line */}
        <div class="absolute left-6 top-0 bottom-0 w-px bg-gradient-to-b from-primary/40 via-primary/20 to-transparent"></div>

        <ul class="space-y-6">
          {eventsByDecade[decade].map((event, index) => {
            const typeStyle = eventTypeStyles[event.type] || eventTypeStyles.other;
            return (
              <li class="relative pl-16" style={`--index: ${index}`}>
                {/* Timeline dot */}
                <div class={`absolute left-4 w-5 h-5 rounded-full border-2 ${typeStyle.color} flex items-center justify-center bg-black`}>
                  <div class="w-2 h-2 rounded-full bg-current"></div>
                </div>

                {/* Event card */}
                <div class="glass-card-hover p-5 animate-fade-in">
                  <div class="flex flex-col md:flex-row md:items-start gap-4">
                    {/* Event image */}
                    {event.image && (
                      <div class="shrink-0 w-full md:w-32 h-24 md:h-20 rounded-lg overflow-hidden">
                        <img
                          src={event.image}
                          alt=""
                          class="w-full h-full object-cover"
                          loading="lazy"
                        />
                      </div>
                    )}

                    <div class="flex-1 min-w-0">
                      {/* Date and type */}
                      <div class="flex flex-wrap items-center gap-2 mb-2">
                        <time datetime={event.date} class="text-sm text-white/85">
                          {event.formattedDate}
                        </time>
                        <span class={`px-2 py-0.5 rounded-full text-xs border ${typeStyle.color}`}>
                          {event.type.replace('_', ' ')}
                        </span>
                      </div>

                      {/* Title */}
                      <h4 class="font-heading text-lg text-white mb-2">
                        {event.title}
                      </h4>

                      {/* Description */}
                      {event.description && (
                        <p class="text-white/85 text-sm line-clamp-2">
                          {event.description}
                        </p>
                      )}

                      {/* Related links */}
                      {(event.relatedAlbum || event.relatedMember) && (
                        <div class="flex flex-wrap gap-2 mt-3">
                          {event.relatedAlbum && (
                            <a
                              href={`/discography/${event.relatedAlbum}`}
                              class="text-xs text-primary hover:underline"
                            >
                              View Album →
                            </a>
                          )}
                          {event.relatedMember && (
                            <a
                              href={`/wiki/members/${event.relatedMember}`}
                              class="text-xs text-primary hover:underline"
                            >
                              View Member →
                            </a>
                          )}
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  ))}

  {displayEvents.length === 0 && (
    <div class="glass-card p-12 text-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="size-16 text-white/20 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <p class="text-white/85">No timeline events available yet.</p>
    </div>
  )}
</div>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateX(-20px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .animate-fade-in {
    animation: fadeIn 0.5s ease forwards;
    animation-delay: calc(var(--index, 0) * 100ms);
    opacity: 0;
  }
</style>
