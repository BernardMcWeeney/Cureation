---
import { editable, copyText, copyAttr, copySource } from '../../lib/visual-editing';
import PageHero from '../ui/PageHero.astro';
import { asset } from '../../lib/assets';
import { listNews } from '../../lib/directus';

const entries: any[] = await listNews(-1).catch(() => []);
const editorialCategories = new Set(['editorial', 'editorials', 'feature', 'features', 'interview', 'interviews', 'review', 'reviews']);
const newsCategories = new Set(['news', 'rumor', 'rumors']);
const categoryOf = (entry: any) => String(entry.category || '').toLowerCase();
const latestNews = entries.filter((entry) => newsCategories.has(categoryOf(entry)));
const editorials = entries.filter((entry) => editorialCategories.has(categoryOf(entry)) || (entry.is_editorial && categoryOf(entry) !== 'wiki'));
const leadNews = latestNews[0] || null;
const newsCards = latestNews.slice(1, 4);
const newsArchive = latestNews.slice(4, 7);

const formatDate = (value?: string | null) => value
  ? new Date(`${value.slice(0, 10)}T12:00:00`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
  : 'Date to be confirmed';
const stripHtml = (value = '') => value.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
const entryHref = (entry: any) => entry.slug ? `/publication/${entry.slug}` : '/publication';
const fallbackImages = ['/The-Cure-Live-2.avif', '/thecure-troxyimage.jpg', '/images/albums/disintegration.jpg', '/images/albums/pornography.jpg'];
const entryImage = (entry: any, index = 0) => {
  if (entry.featured_image_file) return asset(entry.featured_image_file, 'hero');
  if (typeof entry.featured_image === 'string' && entry.featured_image.startsWith('http')) return entry.featured_image;
  return fallbackImages[index % fallbackImages.length];
};
const labelFor = (entry: any) => {
  const value = categoryOf(entry).replace(/s$/, '');
  return value ? value.charAt(0).toUpperCase() + value.slice(1) : 'Story';
};
---
<PageHero copyKeys={{"section":"components_editorial_PublicationIndex_914491c5b7d7","title":"components_editorial_PublicationIndex_05de9a61bc35","deck":"components_editorial_PublicationIndex_281112470a46"}}
  section={copyText("components_editorial_PublicationIndex_914491c5b7d7", "Articles")}
  title={copyText("components_editorial_PublicationIndex_05de9a61bc35", "Articles")}

  crumbs={[{ ...copySource({"label":"components_editorial_PublicationIndex_data-163424a93556"}),  label: copyText("components_editorial_PublicationIndex_data-163424a93556", "Home"), href: '/' }, { ...copySource({"label":"components_editorial_PublicationIndex_data-6dfe4a62d573"}),  label: copyText("components_editorial_PublicationIndex_data-6dfe4a62d573", "Articles") }]}
  flush
/>

<section class="publication-section publication-section--news" id="latest-news">
  <div class="container">
    <h2 class="archive-section-title">Latest news</h2>

    {leadNews ? (
      <>
        <a class="news-lead" href={entryHref(leadNews)}>
          <span class="news-lead__image">
            <img src={entryImage(leadNews)} alt="" width="1600" height="1000" loading="eager" decoding="async" />
            <small data-directus={copyAttr("components_editorial_PublicationIndex_4f6956bf2819")} set:html={copyText("components_editorial_PublicationIndex_4f6956bf2819", "Latest news")}></small>
          </span>
          <span  class="news-lead__copy">
            <span data-directus={editable(leadNews, ["published_date"])}>{labelFor(leadNews)} · {formatDate(leadNews.published_date)}</span>
            <strong data-directus={editable(leadNews, ["title"])}>{leadNews.title}</strong>
            {leadNews.excerpt && <p data-directus={editable(leadNews, ["excerpt"])}>{stripHtml(leadNews.excerpt)}</p>}
            <b data-directus={copyAttr("components_editorial_PublicationIndex_358d1a5d488e")} set:html={copyText("components_editorial_PublicationIndex_358d1a5d488e", "Read the report <i>→</i>")}></b>
          </span>
        </a>

        {newsCards.length > 0 && (
          <div class="news-card-grid">
            {newsCards.map((entry, index) => (
              <a  class="news-card" href={entryHref(entry)}>
                <span class="news-card__image"><img data-directus={editable(entry, ["featured_image_file", "featured_image"])} src={entryImage(entry, index + 1)} alt="" width="900" height="600" loading="lazy" decoding="async" /></span>
                <span data-directus={editable(entry, ["published_date"])} class="news-card__meta">{formatDate(entry.published_date)}</span>
                <strong data-directus={editable(entry, ["title"])}>{entry.title}</strong>
                {entry.excerpt && <p data-directus={editable(entry, ["excerpt"])}>{stripHtml(entry.excerpt)}</p>}
                <b data-directus={copyAttr("components_editorial_PublicationIndex_fba05c9d3863")} set:html={copyText("components_editorial_PublicationIndex_fba05c9d3863", "Read →")}></b>
              </a>
            ))}
          </div>
        )}

        {newsArchive.length > 0 && (
          <div class="news-index">
            <div class="news-index__head"><span data-directus={copyAttr("components_editorial_PublicationIndex_ca73cc8153a8")} set:html={copyText("components_editorial_PublicationIndex_ca73cc8153a8", "More news")}></span><a data-directus={copyAttr("components_editorial_PublicationIndex_5b5ec42f1447")} set:html={copyText("components_editorial_PublicationIndex_5b5ec42f1447", "All news →")} href="/news"></a></div>
            {newsArchive.map((entry, index) => (
              <a href={entryHref(entry)}>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <time data-directus={editable(entry, ["published_date"])} datetime={entry.published_date}>{formatDate(entry.published_date)}</time>
                <strong data-directus={editable(entry, ["title"])}>{entry.title}</strong>
                <b>↗</b>
              </a>
            ))}
          </div>
        )}
      </>
    ) : (
      <div class="publication-empty"><span data-directus={copyAttr("components_editorial_PublicationIndex_8454925abeeb")} set:html={copyText("components_editorial_PublicationIndex_8454925abeeb", "News")}></span><strong data-directus={copyAttr("components_editorial_PublicationIndex_ccd42b22bd4b")} set:html={copyText("components_editorial_PublicationIndex_ccd42b22bd4b", "No news yet.")}></strong><p data-directus={copyAttr("components_editorial_PublicationIndex_7ccab8a30ca2")} set:html={copyText("components_editorial_PublicationIndex_7ccab8a30ca2", "New updates will appear here.")}></p></div>
    )}
  </div>
</section>

<section class="publication-section publication-section--editorials" id="editorials">
  <div class="container">
    <h2 class="archive-section-title">Articles</h2>

    {editorials.length > 0 ? (
      <div class="editorial-grid">
        {editorials.map((entry, index) => (
          <a class:list={['editorial-card', { 'editorial-card--lead': index === 0 }]} href={entryHref(entry)}>
            <span class="editorial-card__image">
              <img data-directus={editable(entry, ["featured_image_file", "featured_image"])} src={entryImage(entry, index + 2)} alt="" width="1200" height="900" loading="lazy" decoding="async" />
              <small>{labelFor(entry)}</small>
            </span>
            <span  class="editorial-card__copy">
              <span data-directus={editable(entry, ["published_date","reading_time"])}>{formatDate(entry.published_date)}{entry.reading_time ? ` · ${entry.reading_time} min read` : ''}</span>
              <strong data-directus={editable(entry, ["title"])}>{entry.title}</strong>
              {entry.excerpt && <p data-directus={editable(entry, ["excerpt"])}>{stripHtml(entry.excerpt)}</p>}
              <b data-directus={copyAttr("components_editorial_PublicationIndex_5db49546a066")} set:html={copyText("components_editorial_PublicationIndex_5db49546a066", "Continue reading <i>→</i>")}></b>
            </span>
          </a>
        ))}
      </div>
    ) : (
      <div class="publication-empty"><span data-directus={copyAttr("components_editorial_PublicationIndex_51e604eef742")} set:html={copyText("components_editorial_PublicationIndex_51e604eef742", "Articles")}></span><strong data-directus={copyAttr("components_editorial_PublicationIndex_d2c5895384f2")} set:html={copyText("components_editorial_PublicationIndex_d2c5895384f2", "More articles are coming soon.")}></strong></div>
    )}
  </div>
</section>

<style>
  .archive-section-title { margin: 0 0 24px; font-family: var(--f-display); font-size: clamp(28px, 3vw, 40px); font-weight: 400; line-height: 1.1; }
  .publication-section { padding-block: clamp(28px, 4vw, 48px); scroll-margin-top: 80px; }
  .publication-section--editorials { background: var(--bg-2); }
  .publication-head__index small, .publication-head > div:nth-child(2) > p { color: var(--accent); font: 650 var(--micro-sm)/1.4 var(--f-ui); letter-spacing: .1em; text-transform: uppercase; }

  .news-lead { display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(360px, .88fr); min-height: 520px; border: 1px solid var(--rule-strong); background: var(--bg-2); color: inherit; }
  .news-lead__image { position: relative; min-height: 520px; overflow: hidden; }
  .news-lead__image img, .news-card__image img, .editorial-card__image img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.9) contrast(1.08); transition: transform .45s ease; }
  .news-lead__image::after, .editorial-card__image::after { position: absolute; inset: 0; content: ''; background: linear-gradient(0deg, rgba(0,0,0,.76), transparent 54%); }
  .news-lead__image small, .editorial-card__image small { position: absolute; z-index: 1; bottom: 18px; left: 18px; color: #fff; font: 700 var(--micro-sm)/1 var(--f-ui); letter-spacing: .1em; text-transform: uppercase; }
  .news-lead__copy { display: flex; flex-direction: column; align-items: flex-start; padding: clamp(28px, 4.5vw, 58px); }
  .news-lead__copy > span, .news-card__meta, .editorial-card__copy > span { color: var(--accent); font: 650 var(--micro-sm)/1.45 var(--f-ui); letter-spacing: .13em; text-transform: uppercase; }
  .news-lead__copy > :global(strong) { margin-top: 18px; font-family: var(--f-display); font-size: clamp(38px, 4.6vw, 62px); font-style: italic; font-weight: 500; letter-spacing: -.035em; line-height: .98; text-wrap: balance; }
  .news-lead__copy p { max-width: 46ch; margin: 24px 0 0; color: var(--ink-2); font-size: var(--text-small); line-height: 1.65; }
  .news-lead__copy :global(b), .editorial-card__copy :global(b) { margin-top: auto; padding-top: 28px; color: var(--ink); font: 700 var(--micro)/1 var(--f-ui); letter-spacing: .13em; text-transform: uppercase; }
  .news-lead__copy :global(b) :global(i), .editorial-card__copy :global(b) :global(i) { margin-left: 12px; color: var(--accent); font-style: normal; }
  .news-lead:hover img, .news-card:hover img, .editorial-card:hover img { transform: scale(1.025); }
  .news-lead:hover :global(strong), .news-card:hover :global(strong), .editorial-card:hover :global(strong) { color: var(--accent); }

  .news-card-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(18px, 2.4vw, 32px); margin-top: clamp(32px, 4vw, 56px); }
  .news-card { display: flex; min-width: 0; flex-direction: column; border: 0; color: inherit; }
  .news-card__image { height: clamp(210px, 22vw, 320px); overflow: hidden; background: var(--surface); }
  .news-card__meta { margin-top: 16px; }
  .news-card > :global(strong) { margin-top: 10px; font-family: var(--f-display); font-size: clamp(27px, 3vw, 39px); font-style: italic; font-weight: 500; line-height: 1; text-wrap: balance; }
  .news-card > p { display: -webkit-box; margin: 14px 0 0; overflow: hidden; color: var(--muted); font-size: var(--text-small); line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
  .news-card > :global(b) { margin-top: 18px; color: var(--accent); font: 650 var(--micro-sm)/1 var(--f-ui); letter-spacing: .12em; text-transform: uppercase; }

  .news-index { margin-top: clamp(52px, 7vw, 94px); border-top: 1px solid var(--rule-strong); }
  .news-index__head { display: flex; justify-content: space-between; gap: 20px; padding: 14px 0; border-bottom: 1px solid var(--rule); color: var(--muted); font: 650 var(--micro)/1.3 var(--f-ui); letter-spacing: .1em; text-transform: uppercase; }
  .news-index__head span { color: var(--accent); }
  .news-index__head a { border: 0; color: var(--accent); }
  .news-index > a { display: grid; grid-template-columns: 46px minmax(150px, .32fr) minmax(0, 1fr) auto; gap: clamp(14px, 2vw, 30px); align-items: baseline; padding: 18px 0; border: 0; border-bottom: 1px solid var(--rule); color: inherit; }
  .news-index > a > span, .news-index time { color: var(--muted); font: 550 var(--micro)/1.3 var(--f-ui); letter-spacing: .08em; text-transform: uppercase; }
  .news-index :global(strong) { font-family: var(--f-display); font-size: clamp(20px, 2vw, 28px); font-style: italic; font-weight: 500; line-height: 1.1; }
  .news-index :global(b) { color: var(--accent); font-weight: 500; }
  .news-index a:hover :global(strong) { color: var(--accent); }

  .editorial-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(20px, 3vw, 42px); }
  .editorial-card { min-width: 0; display: grid; grid-template-columns: minmax(180px, .72fr) minmax(0, 1.28fr); min-height: 330px; border: 1px solid var(--rule); background: var(--bg); color: inherit; }
  .editorial-card--lead { grid-column: 1 / -1; grid-template-columns: minmax(0, 1.12fr) minmax(360px, .88fr); min-height: 480px; }
  .editorial-card__image { position: relative; min-height: 100%; overflow: hidden; background: var(--surface); }
  .editorial-card__copy { display: flex; flex-direction: column; align-items: flex-start; padding: clamp(24px, 3vw, 42px); }
  .editorial-card__copy > :global(strong) { margin-top: 13px; font-family: var(--f-display); font-size: clamp(29px, 3.3vw, 45px); font-style: italic; font-weight: 500; line-height: 1; text-wrap: balance; }
  .editorial-card--lead .editorial-card__copy > :global(strong) { font-size: clamp(39px, 4.8vw, 64px); }
  .editorial-card__copy > p { display: -webkit-box; margin: 18px 0 0; overflow: hidden; color: var(--muted); font-size: var(--text-small); line-height: 1.6; -webkit-box-orient: vertical; -webkit-line-clamp: 4; }
  .publication-empty { min-height: 280px; display: flex; flex-direction: column; justify-content: flex-end; padding: clamp(28px, 4vw, 52px); border: 1px solid var(--rule); background: var(--bg-2); }
  .publication-empty > span { color: var(--accent); font: 650 var(--micro)/1 var(--f-ui); letter-spacing: .1em; text-transform: uppercase; }
  .publication-empty > :global(strong) { max-width: 18ch; margin-top: 18px; font-family: var(--f-display); font-size: clamp(35px, 4vw, 54px); font-style: italic; font-weight: 500; line-height: 1; }
  .publication-empty p { color: var(--muted); }

  @media (max-width: 980px) {
    .publication-head { grid-template-columns: 90px minmax(0, 1fr); }
    .publication-head > p { grid-column: 2; }
    .news-lead, .editorial-card--lead { grid-template-columns: 1fr; }
    .news-lead__image, .editorial-card--lead .editorial-card__image { min-height: min(64vw, 520px); }
    .news-lead__copy, .editorial-card--lead .editorial-card__copy { min-height: 390px; }
    .editorial-grid { grid-template-columns: 1fr; }
    .editorial-card--lead { grid-column: auto; }
  }
  @media (max-width: 760px) {
    .news-card-grid { grid-template-columns: 1fr; }
    .news-card { display: grid; grid-template-columns: minmax(120px, .42fr) minmax(0, .58fr); gap: 6px 18px; }
    .news-card__image { grid-row: 1 / span 5; height: 100%; min-height: 180px; }
    .news-card__meta { margin-top: 4px; }
    .news-index > a { grid-template-columns: 32px minmax(0, 1fr) auto; }
    .news-index time { grid-column: 2; grid-row: 2; }
    .news-index :global(strong) { grid-column: 2; grid-row: 1; }
    .news-index :global(b) { grid-column: 3; grid-row: 1 / span 2; }
  }
  @media (max-width: 560px) {
    .publication-head { grid-template-columns: 1fr; gap: 18px; }
    .publication-head__index { min-height: 0; flex-direction: row; align-items: baseline; }
    .publication-head > p { grid-column: 1; }
    .publication-head h2 { font-size: clamp(48px, 16vw, 72px); }
    .news-lead__image { min-height: 76vw; }
    .news-lead__copy { min-height: 400px; padding: 26px 22px; }
    .news-card { grid-template-columns: 1fr; }
    .news-card__image { grid-row: auto; min-height: 64vw; }
    .editorial-card { grid-template-columns: 1fr; }
    .editorial-card__image { min-height: 72vw; }
    .editorial-card__copy { min-height: 330px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .news-lead__image img, .news-card__image img, .editorial-card__image img { transition: none; }
  }
</style>
