---
import PageHero from '../ui/PageHero.astro';
import { asset } from '../../lib/assets';
import { listNews } from '../../lib/directus';

const entries: any[] = await listNews(-1).catch(() => []);
const newsCategories = new Set(['news', 'rumor', 'rumors']);
const latestNews = entries.filter((entry) => newsCategories.has(String(entry.category || '').toLowerCase()));
const lead = latestNews[0] || null;
const cards = latestNews.slice(1, 7);
const archive = latestNews.slice(7);

const formatDate = (value?: string | null) => value
  ? new Date(`${value.slice(0, 10)}T12:00:00`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
  : 'Date to be confirmed';
const stripHtml = (value = '') => value.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
const entryHref = (entry: any) => entry.slug ? `/publication/${entry.slug}` : '/news';
const fallbackImages = ['/The-Cure-Live-2.avif', '/thecure-troxyimage.jpg', '/images/albums/disintegration.jpg', '/images/albums/pornography.jpg'];
const entryImage = (entry: any, index = 0) => {
  if (entry.featured_image_file) return asset(entry.featured_image_file, 'hero');
  if (typeof entry.featured_image === 'string' && entry.featured_image.startsWith('http')) return entry.featured_image;
  return fallbackImages[index % fallbackImages.length];
};
---

<PageHero
  section="News"
  title="News"
  deck="Verified updates, announcements, performances and releases: the present tense of The Cure, filed newest first."
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Publication', href: '/publication' }, { label: 'News' }]}
  flush
/>

<section class="news-page">
  <div class="container">
    <header class="news-page__head">
      <div class="news-page__index"><span>01</span><small>News desk</small></div>
      <div><p>Latest news</p><h2>The Cure,<br /><em>right now.</em></h2></div>
      <p>Every verified dispatch has its own place here. Essays and criticism live in the <a href="/publication">Publication</a>; album criticism lives in <a href="/reviews">Reviews</a>.</p>
    </header>

    {lead ? (
      <>
        <a class="news-lead" href={entryHref(lead)}>
          <span class="news-lead__image">
            <img src={entryImage(lead)} alt="" width="1600" height="1000" loading="eager" decoding="async" />
            <small>Latest dispatch</small>
          </span>
          <span class="news-lead__copy">
            <span>{formatDate(lead.published_date)}</span>
            <strong>{lead.title}</strong>
            {lead.excerpt && <p>{stripHtml(lead.excerpt)}</p>}
            <b>Read the report <i>→</i></b>
          </span>
        </a>

        {cards.length > 0 && (
          <div class="news-grid">
            {cards.map((entry, index) => (
              <a class="news-card" href={entryHref(entry)}>
                <span class="news-card__image"><img src={entryImage(entry, index + 1)} alt="" width="900" height="600" loading="lazy" decoding="async" /></span>
                <span class="news-card__meta">{formatDate(entry.published_date)}</span>
                <strong>{entry.title}</strong>
                {entry.excerpt && <p>{stripHtml(entry.excerpt)}</p>}
                <b>Read →</b>
              </a>
            ))}
          </div>
        )}

        {archive.length > 0 && (
          <div class="news-ledger">
            <div class="news-ledger__head"><span>Earlier dispatches</span><small>{archive.length} entries</small></div>
            {archive.map((entry, index) => (
              <a href={entryHref(entry)}>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <time datetime={entry.published_date}>{formatDate(entry.published_date)}</time>
                <strong>{entry.title}</strong>
                <b>↗</b>
              </a>
            ))}
          </div>
        )}
      </>
    ) : (
      <div class="news-empty"><span>News desk</span><strong>The desk is quiet.</strong><p>New verified updates will appear here as they are filed.</p></div>
    )}
  </div>
</section>

<style>
  .news-page { padding-block: clamp(60px, 8vw, 112px); }
  .news-page__head { display: grid; grid-template-columns: minmax(108px, .2fr) minmax(0, 1fr) minmax(260px, .42fr); gap: clamp(24px, 4.5vw, 74px); align-items: end; margin-bottom: clamp(38px, 5vw, 68px); }
  .news-page__index { align-self: stretch; display: flex; flex-direction: column; justify-content: space-between; padding-top: 10px; border-top: 2px solid var(--accent); }
  .news-page__index span { color: var(--accent); font: 500 clamp(32px, 4vw, 54px)/.9 var(--f-display); }
  .news-page__index small, .news-page__head > div:nth-child(2) > p { color: var(--accent); font: 650 var(--micro-sm)/1.4 var(--f-mono); letter-spacing: .16em; text-transform: uppercase; }
  .news-page__head > div:nth-child(2) > p { margin: 0 0 9px; }
  .news-page__head h2 { margin: 0; font-family: var(--f-display); font-size: clamp(48px, 6.6vw, 88px); font-weight: 500; letter-spacing: -.045em; line-height: .8; }
  .news-page__head h2 em { color: var(--accent); font-weight: inherit; }
  .news-page__head > p { max-width: 39ch; margin: 0; color: var(--ink-2); font-size: 17px; line-height: 1.6; }
  .news-page__head > p a { color: var(--accent); }

  .news-lead { display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(360px, .88fr); min-height: 500px; border: 1px solid var(--rule-strong); background: var(--bg-2); color: inherit; }
  .news-lead__image { position: relative; min-height: 500px; overflow: hidden; }
  .news-lead__image img, .news-card__image img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.9) contrast(1.08); transition: transform .45s ease; }
  .news-lead__image::after { position: absolute; inset: 0; content: ''; background: linear-gradient(0deg, rgba(0,0,0,.76), transparent 54%); }
  .news-lead__image small { position: absolute; z-index: 1; bottom: 18px; left: 18px; color: #fff; font: 700 var(--micro-sm)/1 var(--f-mono); letter-spacing: .14em; text-transform: uppercase; }
  .news-lead__copy { display: flex; flex-direction: column; align-items: flex-start; padding: clamp(28px, 4.5vw, 58px); }
  .news-lead__copy > span, .news-card__meta { color: var(--accent); font: 650 var(--micro-sm)/1.45 var(--f-mono); letter-spacing: .13em; text-transform: uppercase; }
  .news-lead__copy > strong { margin-top: 18px; font-family: var(--f-display); font-size: clamp(38px, 4.6vw, 62px); font-style: italic; font-weight: 500; letter-spacing: -.035em; line-height: .98; text-wrap: balance; }
  .news-lead__copy p { max-width: 46ch; margin: 24px 0 0; color: var(--ink-2); font-size: 16px; line-height: 1.65; }
  .news-lead__copy b { margin-top: auto; padding-top: 28px; color: var(--ink); font: 700 var(--micro)/1 var(--f-mono); letter-spacing: .13em; text-transform: uppercase; }
  .news-lead__copy b i { margin-left: 12px; color: var(--accent); font-style: normal; }
  .news-lead:hover img, .news-card:hover img { transform: scale(1.025); }
  .news-lead:hover strong, .news-card:hover strong { color: var(--accent); }

  .news-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(22px, 3vw, 42px); margin-top: clamp(36px, 5vw, 68px); }
  .news-card { display: flex; min-width: 0; flex-direction: column; border: 0; color: inherit; }
  .news-card__image { height: clamp(210px, 22vw, 320px); overflow: hidden; background: var(--surface); }
  .news-card__meta { margin-top: 16px; }
  .news-card > strong { margin-top: 10px; font-family: var(--f-display); font-size: clamp(27px, 3vw, 39px); font-style: italic; font-weight: 500; line-height: 1; text-wrap: balance; }
  .news-card > p { display: -webkit-box; margin: 14px 0 0; overflow: hidden; color: var(--muted); font-size: 15px; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
  .news-card > b { margin-top: 18px; color: var(--accent); font: 650 var(--micro-sm)/1 var(--f-mono); letter-spacing: .12em; text-transform: uppercase; }

  .news-ledger { margin-top: clamp(52px, 7vw, 94px); border-top: 1px solid var(--rule-strong); }
  .news-ledger__head { display: flex; justify-content: space-between; gap: 20px; padding: 14px 0; border-bottom: 1px solid var(--rule); color: var(--muted); font: 650 var(--micro)/1.3 var(--f-mono); letter-spacing: .14em; text-transform: uppercase; }
  .news-ledger__head span { color: var(--accent); }
  .news-ledger > a { display: grid; grid-template-columns: 46px minmax(150px, .32fr) minmax(0, 1fr) auto; gap: clamp(14px, 2vw, 30px); align-items: baseline; padding: 18px 0; border: 0; border-bottom: 1px solid var(--rule); color: inherit; }
  .news-ledger > a > span, .news-ledger time { color: var(--muted); font: 550 var(--micro)/1.3 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; }
  .news-ledger strong { font-family: var(--f-display); font-size: clamp(20px, 2vw, 28px); font-style: italic; font-weight: 500; line-height: 1.1; }
  .news-ledger b { color: var(--accent); font-weight: 500; }
  .news-ledger a:hover strong { color: var(--accent); }
  .news-empty { min-height: 280px; display: flex; flex-direction: column; justify-content: flex-end; padding: clamp(28px, 4vw, 52px); border: 1px solid var(--rule); background: var(--bg-2); }
  .news-empty > span { color: var(--accent); font: 650 var(--micro)/1 var(--f-mono); letter-spacing: .14em; text-transform: uppercase; }
  .news-empty > strong { max-width: 18ch; margin-top: 18px; font-family: var(--f-display); font-size: clamp(35px, 4vw, 54px); font-style: italic; font-weight: 500; line-height: 1; }
  .news-empty p { color: var(--muted); }

  @media (max-width: 980px) {
    .news-page__head { grid-template-columns: 90px minmax(0, 1fr); }
    .news-page__head > p { grid-column: 2; }
    .news-lead { grid-template-columns: 1fr; }
    .news-lead__image { min-height: min(64vw, 500px); }
    .news-lead__copy { min-height: 390px; }
  }
  @media (max-width: 760px) {
    .news-grid { grid-template-columns: 1fr; }
    .news-card { display: grid; grid-template-columns: minmax(120px, .42fr) minmax(0, .58fr); gap: 6px 18px; }
    .news-card__image { grid-row: 1 / span 5; height: 100%; min-height: 180px; }
    .news-card__meta { margin-top: 4px; }
    .news-ledger > a { grid-template-columns: 32px minmax(0, 1fr) auto; }
    .news-ledger time { grid-column: 2; grid-row: 2; }
    .news-ledger strong { grid-column: 2; grid-row: 1; }
    .news-ledger b { grid-column: 3; grid-row: 1 / span 2; }
  }
  @media (max-width: 560px) {
    .news-page__head { grid-template-columns: 1fr; gap: 18px; }
    .news-page__index { min-height: 0; flex-direction: row; align-items: baseline; }
    .news-page__head > p { grid-column: 1; }
    .news-page__head h2 { font-size: clamp(48px, 16vw, 72px); }
    .news-lead__image { min-height: 76vw; }
    .news-lead__copy { min-height: 400px; padding: 26px 22px; }
    .news-card { grid-template-columns: 1fr; }
    .news-card__image { grid-row: auto; min-height: 64vw; }
  }
  @media (prefers-reduced-motion: reduce) {
    .news-lead__image img, .news-card__image img { transition: none; }
  }
</style>
