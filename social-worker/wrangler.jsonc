{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "cureation-automation",
  "main": "src/index.js",
  "compatibility_date": "2026-06-07",
  "triggers": {
    "crons": [
      "15 3 * * *",
      "30 6 * * *",
      "15 9 * * *",
      "45 * * * *"
    ]
  },
  "queues": {
    "producers": [
      {
        "binding": "SOCIAL_DRAFT_QUEUE",
        "queue": "cureation-social-draft-publish"
      }
    ],
    "consumers": [
      {
        "queue": "cureation-social-draft-publish",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 0
      }
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  }
}
